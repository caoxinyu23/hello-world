    nulla "{glitch=20.0}{color=ff0000}{b}See you. <3 {/glitch}"

# game/script.rpy:1201
translate ingles badendseptem1_07b27d43:

    # "No piensas lamerle las botas a este payaso."
    "You're not going to lick this clown's boots."

# game/script.rpy:1202
translate ingles badendseptem1_02be9a8f:

    # "¡Tienes estándares cariño!"
    "You have standards, darling!"

# game/script.rpy:1203
translate ingles badendseptem1_3448788b:

    # "Así que ese tal Septem puede meterse su mirada juzgadora por donde le quepa."
    "So that Septem guy can stick his judgmental gaze up his ass."

# game/script.rpy:1204
translate ingles badendseptem1_07214f9e:

    # "Tú no estás para hacer de mono de circo aquí."
    "You're not here to be his personal clown."

# game/script.rpy:1205
