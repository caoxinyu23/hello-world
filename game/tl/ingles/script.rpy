    nulla "{glitch=20.0}{color=ffffff}{b}We will have to wait for a new update.{/glitch}"

# game/script.rpy:1174
translate ingles null_b4858ca7:

    # nulla "{glitch=20.0}{color=ffffff}{b}Mientras, borraré mi memoria... para no pasarla tan mal.{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}Meanwhile, I'll erase my memory... so I don't have such a bad time.{/glitch}"

# game/script.rpy:1177
