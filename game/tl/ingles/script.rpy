# game/script.rpy:2186
translate ingles menupuertas2_9c82e4c8:

    # "A pesar de buscar y buscar, no encuentras al rubio."
    "Despite searching and searching, you can't find the blond."

# game/script.rpy:2193
translate ingles menupuertas2_cf351b16:

    # "Te preguntas porqué Septem tendrá documentos que puedan poner en peligro su integridad..."
    "You wonder why Septem has documents that could jeopardize his integrity..."

# game/script.rpy:2194
translate ingles menupuertas2_9dbde6a2:

    # "Realmente no crees que encontrar esos documentos sea una tarea fácil, pero no pierdes nada en hacerlo."
    "You assume finding those documents wouldn't be easy, but you've got nothing to lose."

# game/script.rpy:2195
translate ingles menupuertas2_127efe3b:

    # "Supones que la sala del vacío es esa haqbitación completamente negra."
    "You assume the Void room is that pitch-black room."

# game/script.rpy:2196
translate ingles menupuertas2_05ff3be5:

    # "Así que vas para allá."
    "So, you go there."

# game/script.rpy:2198
translate ingles menupuertas2_014277c4:

    # "Respiras ondo y abres la puerta."
    "You take a deep breath and open the door."

# game/script.rpy:2200
translate ingles menupuertas2_a20cefa7_1:

    # "..."
    "..."

# game/script.rpy:2201
translate ingles menupuertas2_2997eb56:

    # "No se ve nada. Entras a paso lento, con sumo cuidado. Colocas ambas manos delante tuya para evitar chocar con la pared o algún objeto que se encuentre delante."
    "You can't see anything. You enter at a slow pace, with great care. You place both hands in front of you to avoid colliding with the wall or any object in front of you."

# game/script.rpy:2202
translate ingles menupuertas2_93ad4213:

    # "Sientes que topas con algo, al tocarlo te das cuenta que parece una pequeña mesa o un escritorio. No sabrías a ciencia cierta."
    "You feel like you bump into something, and when you touch it, you realize that it seems like a small table or a desk. You wouldn't know for sure."

# game/script.rpy:2203
translate ingles menupuertas2_dfe40d8f:

    # "Como puedes intentas buscar algo que parezca papel, pero no hay nada encima."
    "You try to find something that seems like paper, but there's nothing on it."

# game/script.rpy:2204
translate ingles menupuertas2_90c4c60a:

    # "Buscas y buscas pero no hay nada."
    "You search and search but there is nothing."

# game/script.rpy:2205
translate ingles menupuertas2_57fa074e:

    # "Eso es hasta que sientes algo semejante a un cajón."
    "That is, until you feel something like a box."

# game/script.rpy:2206
translate ingles menupuertas2_a14e850f:

    # "Pero no abre. Parece tener una cerradura."
    "But it doesn't open. It seems to have a lock."

# game/script.rpy:2209
translate ingles menupuertas2_512dedfc:

    # "No puedes abrirlo."
    "You can't open it."

# game/script.rpy:2214
translate ingles menupuertas2_370c8ace:

    # "Buscas en tus ropas la llave, rezando a los dioses que también sirva para el cajón."
    "You look in your clothes for the key, praying to the gods that it also works for the box."

# game/script.rpy:2215
translate ingles menupuertas2_cc3b66a1:

    # "Se te dificulta un poco ponerla en la cerradura, pero cuando lo haces."
    "It's a little difficult for you to put it in the lock, but when you do..."

# game/script.rpy:2216
translate ingles menupuertas2_bbea7955:

    # "Click."
    "Click."

# game/script.rpy:2217
translate ingles menupuertas2_d0536a52:

    # "Se ha abierto."
    "It has been opened."

# game/script.rpy:2218
translate ingles menupuertas2_2225ce66:

    # "Metes la mano y sacas un montón de papeles."
    "You reach in and take out a bunch of papers."

# game/script.rpy:2219
translate ingles menupuertas2_9cfc430d:

    # "Los cuales te llevas todos."
    "You take all of them."

# game/script.rpy:2225
translate ingles menupuertas2_9d1eee0d:

    # "Buscas en todos lados."
    "You look everywhere."

# game/script.rpy:2226
translate ingles menupuertas2_a34b067b:

    # "Y encuentras un cuchillo."
    "And you find a knife."

# game/script.rpy:2241
translate ingles menupuertas_f4c970c7:

    # "Vas a la puerta que tienes al frente."
    "You go to the door in front of you."

# game/script.rpy:2243
translate ingles menupuertas_10a0566d:

    # "Al abrirla te encuentras que conduce a un pasillo."
    "When you open it, you find that it leads to a hallway."

# game/script.rpy:2244
translate ingles menupuertas_005b4f0a:

    # "Decides entrar para averiguar a donde te conduce"
    "You decide to see where it leads you."

# game/script.rpy:2245
translate ingles menupuertas_64679713:

    # "caminas y caminas..."
    "You walk..."

# game/script.rpy:2246
translate ingles menupuertas_3e26c88c:

    # "Sigues caminando por el pasillo."
    "And continue walking down the hallway."

# game/script.rpy:2247
translate ingles menupuertas_0fde73ab:

    # "Pero sientes que no estás avanzando."
    "But you feel like you're not moving forward."

# game/script.rpy:2248
translate ingles menupuertas_a1ebba09:

    # "Aunque si miras atrás, ya no puedes ver la puerta por donde entraste."
    "Although if you look back, you can no longer see the door you came in through."

# game/script.rpy:2249
translate ingles menupuertas_37b184e9:

    # "Sigues caminando, ahora prestando atención a las paredes y decoración del pasillo."
    "You continue walking, now paying attention to the walls and decoration of the hallway."

# game/script.rpy:2250
translate ingles menupuertas_dac44cd9:

    # "Se repite luego de un rato."
    "It repeats itself after a while."

# game/script.rpy:2251
translate ingles menupuertas_4ff27479:

    # "No hay caso con seguir."
    "There's no point in continuing."

# game/script.rpy:2252
translate ingles menupuertas_a20cefa7:

    # "..."
    "..."

# game/script.rpy:2253
translate ingles menupuertas_78b2f582:

    # "Das media vuelta y regresas por donde viniste."
    "You turn around and go back the way you came."

# game/script.rpy:2255
translate ingles menupuertas_fdf82c1c:

    # "Te tardas un poco pero logras llegar a la puerta inicial."
    "It takes you a little while but you manage to reach the initial door."

# game/script.rpy:2260
translate ingles menupuertas_36adc255:

    # "Vas a la puerta que está detrás, que es resguardada por dos estatuas con la figura de Septem."
    "You go to the door behind, which is guarded by two statues with the figure of Septem."

# game/script.rpy:2261
translate ingles menupuertas_6470ff50:

    # "Esperas a que la puerta esté cerrada, pero increíblemente no lo está."
    "You expect the door to be closed, but surprisingly, it's not."

# game/script.rpy:2263
translate ingles menupuertas_dfbe0369:

    # "Al abrir la puerta te das cuenta de que está más oscuro de lo que debería estar en realidad."
    "When you open the door, you realize that it's darker than it really should be in there."

# game/script.rpy:2264
translate ingles menupuertas_d3bd3431:

    # "No es por que seas cobarde, pero no piensas entrar ahí."
    "It's not because you're a coward, but you're not going to go in there."

# game/script.rpy:2271
translate ingles menupuertas_4458acb3:

    # "Vas a la puerta que está a la izquierda del altar."
    "You go to the door that is to the left of the altar."

# game/script.rpy:2272
translate ingles menupuertas_534ba28c:

    # "Está bloqueada, necesitas una llave."
    "It's locked, you need a key."

# game/script.rpy:2275
translate ingles menupuertas_c7a59e1e:

    # "Debe haber algo para poder abrir la puerta"
    "There must be something to open the door."

# game/script.rpy:2280
translate ingles menupuertas_526886d9:

    # "Puede que la llave que has encontrado en el segundo piso sirva para abrir esta puerta."
    "Maybe the key you found on the second floor can be used to open this door."

# game/script.rpy:2281
translate ingles menupuertas_a50fc19a:

    # "Al usarla, el cerrojo hace un click."
    "When using it, the lock clicks."

# game/script.rpy:2282
translate ingles menupuertas_1fc77a2b:

    # "Está abierta."
    "It's open."

# game/script.rpy:2284
translate ingles menupuertas_b062f9ad:

    # "Dentro que encuentras en una habitación muy parecida a la que has despertado tú hoy."
    "Inside, you find a room very similar to the one you woke up in today."

# game/script.rpy:2285
translate ingles menupuertas_f421385e:

    # "La única diferencia, es que hay alguien acostado ahí..."
    "The only difference is that there is someone lying there..."

# game/script.rpy:2287
translate ingles menupuertas_1fe87412:

    # "Te acercas y te encuentras con Septem durmiendo."
    "You approach and find Septem sleeping."

# game/script.rpy:2288
translate ingles menupuertas_8d88d4e0:

    # "Viendo tu error, intentas alejarte sin hacer ruido."
    "Realizing your mistake, you try to walk away without making a sound."

# game/script.rpy:2290
translate ingles menupuertas_195bfb7e:

    # "Pero Septem abre los ojos antes de que puedas hacer nada."
    "But Septem opens his eyes before you can do anything."

# game/script.rpy:2292
translate ingles menupuertas_cc9a5909:

    # "!!!"
    "!!!"

# game/script.rpy:2293
translate ingles menupuertas_feb68873:

    # septem "¿Quién eres tú?"
    septem "Who are you?"

# game/script.rpy:2294
translate ingles menupuertas_a20cefa7_1:

    # "..."
    "..."

# game/script.rpy:2295
translate ingles menupuertas_da482c1b:

    # "¿¿¿???"
    "???"

# game/script.rpy:2296
translate ingles menupuertas_e79e62ed:

    # "¿Qué? ¿es que acaso no te recuerda?"
    "What? Doesn't he remember you?"

# game/script.rpy:2297
translate ingles menupuertas_5f96cda0:

    # nj "Sept--"
    nj "Sept--"

# game/script.rpy:2299
translate ingles menupuertas_48a4e919:

    # "Septem se levanta rápidamente de la cama para colocar ambas manos en tu boca."
    "Septem quickly gets out of bed to place both hands on your mouth."

# game/script.rpy:2300
translate ingles menupuertas_09b7e6c7:

    # septem "¡NO DIGAS SU NOMBRE!"
    septem "DON'T SAY HIS NAME!"

# game/script.rpy:2301
translate ingles menupuertas_9d834b26:

    # "Intentas quitártelo de encima pero es inútil"
    "You try to shake his hands off, but it's useless."

# game/script.rpy:2302
translate ingles menupuertas_13f2f15f:

    # septem "No estamos en su presencia, así que por favor no lo invoques."
    septem "We are not in his presence, so please do not summon him."

# game/script.rpy:2303
translate ingles menupuertas_653a8313:

    # "Él viendo que te has calmado un poco, suelta su agarre, descubriendo tu boca lentamente."
    "He, seeing that you calmed down a little, releases his grip, slowly uncovering your mouth."

# game/script.rpy:2305
translate ingles menupuertas_b561f297:

    # ell "¿Dónde encontraste la llave?"
    ell "Where did you find the key?"

# game/script.rpy:2308
translate ingles menupuertas_53429350:

    # nj "En el segundo piso, escondida en los cajones de ahí."
    nj "On the second floor, hidden in the drawers there."

# game/script.rpy:2309
translate ingles menupuertas_3dfa4cad:

    # ell "Oh...."
    ell "Oh...."

# game/script.rpy:2312
translate ingles menupuertas_19384c7a:

    # ell "..."
    ell "..."

# game/script.rpy:2315
translate ingles menupuertas_4fb38e1b:

    # ell "Momento..."
    ell "Wait a moment..."

# game/script.rpy:2316
translate ingles menupuertas_56a9639d:

    # "Él se acerca para mirarte detenidamente, te mira directo a los ojos y pareciera que lo que ve le deja sin aliento."
    "He comes closer to look at you carefully. He gazes directly into your eyes and what he sees seems to take his breath away."

# game/script.rpy:2317
translate ingles menupuertas_471fd97b:

    # "Claramente este no es Septem... hay algo diferente en él."
    "This is clearly not Septem... there's something different about him."

# game/script.rpy:2320
translate ingles menupuertas_26fe2ac6:

    # ell "Tambien estás siendo controlado por un ser superior..."
    ell "You are also being controlled by a higher being..."

# game/script.rpy:2321
translate ingles menupuertas_195603fc:

    # nj "¿Perdón?"
    nj "Pardon?"

# game/script.rpy:2322
translate ingles menupuertas_621c7d18:

    # ell "Te están usando como una marioneta."
    ell "They're using you like a puppet."

# game/script.rpy:2325
translate ingles menupuertas_5bc990ec:

    # ell "Ja! jajaja... No puede ser..."
    ell "Ha! Hahaha... It can't be..."

# game/script.rpy:2328
translate ingles menupuertas_19384c7a_1:

    # ell "..."
    ell "..."

# game/script.rpy:2330
translate ingles menupuertas_58f6f5e9:

    # "La entidad que no es Septem da unos pasos hacia atrás, abatido por la situación."
    "The entity that is not Septem takes a few steps back, dejected by the situation."

# game/script.rpy:2331
translate ingles menupuertas_0216e5e5:

    # ell "Es la primera vez alguien está dentro del templo..."
    ell "It's the first time someone is inside the temple..."

# game/script.rpy:2332
translate ingles menupuertas_400e7991:

    # "La entidad que tiene el cuerpo de Septem se sienta en la cama y te hace señas para que hagas lo mismo."
    "The entity that has Septem's body sits on the bed and motions for you to do the same."

# game/script.rpy:2334
translate ingles menupuertas_c150e706:

    # "Se le ve nervioso..."
    "He looks nervous..."

# game/script.rpy:2335
translate ingles menupuertas_b360bb21:

    # "Tú notando que no parece ser una amenaza, te sientas."
    "Noticing that he doesn't seem to be a threat, you sit down."

# game/script.rpy:2336
translate ingles menupuertas_30e74294:

    # "Solamente para saber que es lo que está pasando."
    "Just to know what's going on."

# game/script.rpy:2337
translate ingles menupuertas_1720d198:

    # "Es extraño ver la cara de Septem con ese semblante... hasta te parece tierno."
    "It's strange to see Septem's face with that expression... it even seems cute to you."

# game/script.rpy:2338
translate ingles menupuertas_03269d73:

    # "No puedes evitar mirar sin disimulo su carita."
    "You can't help but stare at his cute face."

# game/script.rpy:2340
translate ingles menupuertas_770a1429:

    # "Ante esto, el parece ponerse más nervioso."
    "At this, he seems to get more nervous."

# game/script.rpy:2341
translate ingles menupuertas_ad68bb5f:

    # "Una risita se te escapa sin querer."
    "A giggle escapes you accidentally."

# game/script.rpy:2344
translate ingles menupuertas_1c3044a6:

    # ell "¿Qué es tan gracioso?"
    ell "What's so funny?"

# game/script.rpy:2345
translate ingles menupuertas_a55ec00d:

    # "Quiere parecer imponente, pero no le resulta. Si realmente fuera Septem, no estaría dudando como lo está haciendo ahora."
    "He wants to look imposing, but it doesn't work. If he really was Septem, he wouldn't be hesitating like he is now."

# game/script.rpy:2350
translate ingles menupuertas_19384c7a_2:

    # ell "..."
    ell "..."

# game/script.rpy:2353
translate ingles menupuertas_06264277:

    # ell "No puedo decirlo."
    ell "I can't say."

# game/script.rpy:2356
translate ingles menupuertas_74f7be73:

    # nj "¿Y si lo escribes?"
    nj "What if you write it down?"

# game/script.rpy:2359
translate ingles menupuertas_edb57959:

    # ell "No tengo permitido hacer nada que revele mi nombre."
    ell "I'm not allowed to do anything that reveals my name."

# game/script.rpy:2362
translate ingles menupuertas_8b466a0f:

    # ell "Si lo hago, moriré."
    ell "If I do, I will die."

# game/script.rpy:2367
translate ingles menupuertas_19384c7a_3:

    # ell "..."
    ell "..."

# game/script.rpy:2370
translate ingles menupuertas_8ee1a817:

    # ell "¿Recién me conoces y es lo primero que se te ocurre decir?"
    ell "You just met me and that's the first thing you can think of to say?"

# game/script.rpy:2371
translate ingles menupuertas_af3aa065:

    # ell "Eres extraño..."
    ell "You're strange..."

# game/script.rpy:2374
translate ingles menupuertas_19384c7a_4:

    # ell "..."
    ell "..."

# game/script.rpy:2376
translate ingles menupuertas_9a364c2c:

    # ell "Creo que ya entiendo."
    ell "I think I understand now."

# game/script.rpy:2379
translate ingles menupuertas_429aa0dc:

    # ell "Él quiere tener la entidad que te está controlando..."
    ell "He wants to have the entity that is controlling you..."

# game/script.rpy:2382
translate ingles menupuertas_b831e8f5:

    # ell "Tarde o temprano me reemplazaría."
    ell "Sooner or later he would replace me."

# game/script.rpy:2385
translate ingles menupuertas_aa38d556:

    # ell "¿Te puedo pedir un favor?"
    ell "Can I ask you a favor?"

# game/script.rpy:2388
translate ingles menupuertas_e9117767:

    # "Asientes con la cabeza, más que nada porque quieres saber que te pedirá."
    "You nod, mostly because you want to know what he'll ask of you."

# game/script.rpy:2391
translate ingles menupuertas_1205d015:

    # ell "Él tiene unos documentos en la sala del vacío..."
    ell "He has some documents in the Void room..."

# game/script.rpy:2394
translate ingles menupuertas_5c336bd7:

    # ell "Ahí debe estar el documento de mi nacimiento, con mi nombre."
    ell "There must be the document of my birth, with my name."

# game/script.rpy:2395
translate ingles menupuertas_339b550e:

    # ell "Por favor, búscalo."
    ell "Please look for it."

# game/script.rpy:2398
translate ingles menupuertas_f74b47f5:

    # ell "Te daré libertad si lo haces."
    ell "I will give you freedom if you do."

# game/script.rpy:2399
translate ingles menupuertas_99b165f4:

    # ell "y podrás escapar de él."
    ell "And you can escape from him."

# game/script.rpy:2400
translate ingles menupuertas_a20cefa7_2:

    # "..."
    "..."

# game/script.rpy:2401
translate ingles menupuertas_fc40ff2d:

    # "¿Escapar de Septem?"
    "Escape from Septem?"

# game/script.rpy:2402
translate ingles menupuertas_373e52f6:

    # "Se oye como una buena oferta, sin duda lo tendrás al tanto."
    "It sounds like a good offer."

# game/script.rpy:2404
translate ingles menupuertas_c044793c:

    # ell "ggHH-- cof cof cof!"
    ell "ggHH--cof cof cof!"

# game/script.rpy:2405
translate ingles menupuertas_31b0833c:

    # "La entidad comienza a toser, como si se ahogara."
    "The entity begins to cough, as if choking."

# game/script.rpy:2406
translate ingles menupuertas_25e754e4:

    # ell "Debes irte."
    ell "You must go."

# game/script.rpy:2407
translate ingles menupuertas_e07fc5ac:

    # "Sin decir más, él se para y te empuja fuera de la habitación."
    "Without another word, he stands up and pushes you out of the room."

# game/script.rpy:2409
translate ingles menupuertas_f1d30ea2:

    # "Te quedas observando por un buen rato la habitación."
    "You stare at the door for a long time."

# game/script.rpy:2410
translate ingles menupuertas_d6980d33:

    # "Tocas un par de veces, pero no hay respuerta."
    "You knock a few times, but there's no response."

# game/script.rpy:2418
translate ingles menupuertas_d26f6f63:

    # "Vas al segundo piso."
    "You go to the second floor."

# game/script.rpy:2419
translate ingles menupuertas_288b3754:

    # "Revuelves todo el lugar, pues a simple vista, no hay nada interesante."
    "You search everywhere, but at first glance, there's nothing interesting."

# game/script.rpy:2420
translate ingles menupuertas_25f2c4b8:

    # "En uno de los cajones, encuentras una llave y varios documentos que parecen importantes."
    "In one of the drawers, you find important-looking documents and a key."

# game/script.rpy:2421
translate ingles menupuertas_f5f4070a:

    # "Pero están escritos en un idioma que no logras entender."
    "But the documents are written in a language you can't understand."

# game/script.rpy:2470
translate ingles menunulla_loop1_26cff17f:

    # nulla "Para ti y tu marioneta, ella cortará la conexión contigo impidiendo que puedas seguir aquí."
    nulla "For you and your puppet, they will terminate the connection with you, preventing you from continuing here."

# game/script.rpy:2471
translate ingles menunulla_loop1_106efdb0:

    # nulla "En el caso de Septem... el cuerpo dejaría de funcionar y sus ojos dejarían de protegerlo."
    nulla "In Septem's case... his body would stop functioning and his eyes would stop protecting him."

# game/script.rpy:2473
translate ingles menunulla_loop1_e21d202a:

    # nj "¿Ojos?"
    nj "Eyes?"

# game/script.rpy:2475
translate ingles menunulla_loop1_dbe79b1f:

    # nulla "Aquí los ojos son una barrera de protección, Septem tiene 7 de esos en forma de halo."
    nulla "Here the eyes are a protective barrier; Septem has seven of them in the shape of a halo."

# game/script.rpy:2476
translate ingles menunulla_loop1_f15c2e62:

    # nulla "Unum tiene 3, uno originalmente suyo y dos más que le ha robado a Quattor."
    nulla "Unum has three; one originally his, and two more that he stole from Quattor."

# game/script.rpy:2478
translate ingles menunulla_loop1_8d4e851a:

    # nulla "Aunque el suyo permanece permanentemente cerrado a modo de protección, que paranoico..."
    nulla "Although, his original eye remains permanently closed for protection, how paranoid..."

# game/script.rpy:2482
translate ingles menunulla_loop1_6eb8e295:

    # nj "¿Septem?"
    nj "Septem?"

# game/script.rpy:2484
translate ingles menunulla_loop1_ee16d455:

    # nulla "Así es, Septem tiene la misma condición que tú y tu marioneta..."
    nulla "That's right, Septem has the same condition as you and your puppet..."

# game/script.rpy:2485
translate ingles menunulla_loop1_26e368c0:

    # nulla "Por lo que la unica manera de someterlo es pronunciando su nombre."
    nulla "So the only way to subdue him is by saying the name of his puppet."

# game/script.rpy:2487
translate ingles menunulla_loop1_b917ac69:

    # nulla "Yo no puedo pronunciarlo por las reglas fundamentales del jardín, pero si tú llegas a saberlo..."
    nulla "I can't pronounce it because of the fundamental rules of the Garden, but if you know it..."

# game/script.rpy:2488
translate ingles menunulla_loop1_9d7ffc2f:

    # nulla "Tal vez..."
    nulla "Maybe..."

# game/script.rpy:2492
translate ingles menunulla_loop1_6a0ac365:

    # nj "¿La marioneta tiene otro nombre?"
    nj "Does the puppet have another name?"

# game/script.rpy:2494
translate ingles menunulla_loop1_43468f8b:

    # nulla "Sí, despues de todo, tú solo eres alguien que toma prestado un cuerpo."
    nulla "Yes, after all, you are just someone who borrows a body."

# game/script.rpy:2496
translate ingles menunulla_loop1_fb6894f5:

    # nulla "Y aquí todos los cuerpos tienen alma. La única diferencia es que ahora tu marioneta casi ya no tiene una identidad propia, pues se la he quitado."
    nulla "And here all bodies have souls. The only difference is that now your puppet almost no longer has an identity of its own, since I have taken it away."

# game/script.rpy:2497
translate ingles menunulla_loop1_48c2f8dd:

    # nulla "Para poder dirigirme directamente a ti y evitar problemas..."
    nulla "So I can address you directly and avoid problems..."

# game/script.rpy:2501
translate ingles menunulla_loop1_354c9725:

    # nulla "Si te lo digo dejarás de tener la conexión para poder interactuar con este mundo."
    nulla "If I tell it to you, you'll stop having the connection to be able to interact with this world."

# game/script.rpy:2503
translate ingles menunulla_loop1_2251fb48:

    # nulla "Por lo que no te lo diré ;)"
    nulla "So I won't tell you. ;)"

# game/script.rpy:2508
translate ingles menunulla_loop1_9a5176c5:

    # nulla "¿Haberle quitado la identidad al trozo de carne que controlas?"
    nulla "Having taken away the identity of the piece of meat you control?"

# game/script.rpy:2510
translate ingles menunulla_loop1_32d5e53d:

    # nulla "Creéme que es para mejor."
    nulla "Believe me, it's for the best."

# game/script.rpy:2511
translate ingles menunulla_loop1_a3176a04:

    # nulla "Además, no me gustaría compartirte con nadie más."
    nulla "Besides, I wouldn't want to share you with anyone else."

# game/script.rpy:2516
translate ingles menunulla_loop1_5148ee1c:

    # nulla "Hah!"
    nulla "Ja!"

# game/script.rpy:2517
translate ingles menunulla_loop1_cfb6a41f:

    # nulla "De todas las respuestas posibles, jamás me esperé esta."
    nulla "Of all the possible answers, I never expected that one."

# game/script.rpy:2533
translate ingles menupreguntas_839baac0:

    # "Septem te mira con una pequeña sonrisa."
    "Septem looks at you with a small smile."

# game/script.rpy:2536
translate ingles menupreguntas_c9d26286:

    # septem "Él está bien. Nada que no pueda soportar."
    septem "He's fine. Nothing he can't stand."

# game/script.rpy:2539
translate ingles menupreguntas_241731b0:

    # nj "Le has atravezado el pecho..."
    nj "You pierced his chest..."

# game/script.rpy:2542
translate ingles menupreguntas_7a5103dc:

    # septem "Ajá, no fue nada grave."
    septem "Aha, it was nothing serious."

# game/script.rpy:2543
translate ingles menupreguntas_44e3dda9:

    # septem "Solo una pequeña advertencia."
    septem "Just a little warning."

# game/script.rpy:2544
translate ingles menupreguntas_7f1ee879:

    # septem "Para matarlo tomaría más que simplemente eso."
    septem "To kill him would take more than just that."

# game/script.rpy:2547
translate ingles menupreguntas_beeb4e0f:

    # septem "Una lástima..."
    septem "A shame..."

# game/script.rpy:2553
translate ingles menupreguntas_9f1a89bc:

    # "Septem te mira con un semblante serio."
    "Septem looks at you with a serious face."

# game/script.rpy:2556
translate ingles menupreguntas_f02f643a:

    # septem "No seas tan ansioso..."
    septem "Don't be so anxious..."

# game/script.rpy:2557
translate ingles menupreguntas_b4e052d3:

    # septem "Luego hablaremos de eso."
    septem "We'll talk about it later."

# game/script.rpy:2563
translate ingles menupreguntas_147bb2fb:

    # "Septem suspira."
    "Septem sighs."

# game/script.rpy:2566
translate ingles menupreguntas_e7849523:

    # septem "Madre es el jardín."
    septem "'Mother' is the Garden itself."

# game/script.rpy:2567
translate ingles menupreguntas_7fb42c08:

    # septem "Ella es la encargada de sostener todo."
    septem "She is in charge of holding everything together."

# game/script.rpy:2568
translate ingles menupreguntas_9903d361:

    # septem "Y nosotros somos su fuente de energía."
    septem "And we are her source of energy."

# game/script.rpy:2574
translate ingles menupreguntas_eaeb2867:

    # "Septem frunce las cejas antes de responder."
    "Septem furrows his eyebrows before answering."

# game/script.rpy:2575
translate ingles menupreguntas_d826f19b:

    # septem "¿Yo y [nombrejugador]?"
    septem "Me and [nombrejugador]?"

# game/script.rpy:2576
translate ingles menupreguntas_6f3d23e9:

    # septem "¿Quién es {sc=2}yo{/sc}?"
    septem "Who is {sc=2}'me'{/sc}?"

# game/script.rpy:2577
translate ingles menupreguntas_86c39ea8:

    # "{sc=3}...{/sc}"
    "{sc=3}...{/sc}"

# game/script.rpy:2580
translate ingles menupreguntas_e0b0f54f:

    # septem "[nombrejugador], seré claro, la próxima vez que vea a la marioneta desligándose de ti."
    septem "[nombrejugador], I will be clear. The next time I see the puppet detaching itself from you..."

# game/script.rpy:2581
translate ingles menupreguntas_632aa42f:

    # septem "No dudaré en romperla."
    septem "... I won't hesitate to break it."

# game/script.rpy:2582
translate ingles menupreguntas_befe5772:

    # septem "No necesito otro más con una conciencia propia, suficiente tengo con Raf--"
    septem "I don't need another one with a conscience of its own, I have enough with Ra--"

# game/script.rpy:2583
translate ingles menupreguntas_8b175cea:

    # septem "... no importa."
    septem "... It doesn't matter."

# game/script.rpy:2584
translate ingles menupreguntas_360aea03:

    # septem "Despues de todo Madre puede hacer otro recipiente"
    septem "After all, Mother can make another vessel."

# game/script.rpy:2696
translate ingles badendseptem1_03fac258:

    # "Sientes como te rompen el pecho, una mano urga dentro tuya en busca de algo en específico."
    "You feel your chest being torn apart, a hand searching through your organs for something specific."

# game/script.rpy:2747
translate ingles badendseptem2_03fac258:

    # "Sientes como te rompen el pecho, una mano urga dentro tuya en busca de algo en específico."
    "You feel your chest being torn apart, a hand searching through your organs for something specific."

# game/script.rpy:2757
translate ingles badend_septem3_9f5ad1d0:

    # "Inspeccionas la habitación con el objetivo de encontrar una salida, hay una puerta y ventanales."
    "You inspect the room in hopes of finding an exit. There's a door and some windows."

# game/script.rpy:2758
translate ingles badend_septem3_16e3bfd6:

    # "Te acercas a la puerta con la esperanza de encontrarla abierta."
    "You approach the door hoping to find it open."

# game/script.rpy:2759
translate ingles badend_septem3_a12bbac4:

    # "Al tocar el pomo de la puerta y girarlo, te das cuenta de que no está bloqueada. Por lo que puedes salir."
    "When you touch the doorknob and turn it, you realize that it is not locked. So you can get out."

# game/script.rpy:2761
translate ingles badend_septem3_498b51db:

    # "Sales con cautela, intentando hacer el menos ruido posible."
    "You exit cautiously, trying to make as little noise as possible."

# game/script.rpy:2762
translate ingles badend_septem3_a0aacf4e:

    # "Al salir, te encuentras en un pasillo que al final se puede apreciar una sala..."
    "When you leave, you find yourself in a hallway where at the end, you spot a room..."

# game/script.rpy:2763
translate ingles badend_septem3_500a8559:

    # "Caminas en dirección a esa sala."
    "You walk in the direction of that room."

# game/script.rpy:2765
translate ingles badend_septem3_0ca2eee9:

    # septem "¿Dónde vas?"
    septem "Where are you going?"

# game/script.rpy:2767
translate ingles badend_septem3_cc9a5909:

    # "!!!"
    "!!!"

# game/script.rpy:2768
translate ingles badend_septem3_3f125901:

    # septem "No puedo dejar que te vayas..."
    septem "I can't let you go..."

# game/script.rpy:2769
translate ingles badend_septem3_1f01fe88:

    # septem "Si tanto quieres escapar de aquí, pues adelante. No tengo ganas de lidear con alguien que no tiene interés en mí."
    septem "If you want to escape from here so badly, then go ahead. I don't feel like dealing with someone who has no interest in me."

# game/script.rpy:2770
translate ingles badend_septem3_ee38263d:

    # septem "Despues de todo, madre puede hacer otra marioneta."
    septem "After all, Mother can make another puppet."

# game/script.rpy:2771
translate ingles badend_septem3_0c28488e:

    # septem "Te haré el favor de acabar rápido contigo."
    septem "I'll do you the favor of finishing you off quickly."

# game/script.rpy:2773
translate ingles badend_septem3_e762b2f9:

    # "Septem te atraviesa el pecho sin titubear y rápidamente saca algo de ahí"
    "Septem pierces your chest without hesitation and quickly pulls something out of it."

# game/script.rpy:2774
translate ingles badend_septem3_ace9066a:

    # "Intentas identificar que es lo que ha sacado, pero tu visión se torna borrosa."
    "You try to identify what he took out, but your vision becomes blurry."

# game/script.rpy:2775
translate ingles badend_septem3_70ff978d:

    # "BAD END: Sin interés las cosas no funcionan."
    "BAD END: Without interest, things don't work."

# game/script.rpy:2782
translate ingles badend_septem4_31924e0f:

    # septem "..."
    septem "..."

# game/script.rpy:2786
translate ingles badend_septem4_662a12b4:

    # septem "Ah hahaha."
    septem "Ah hahaha."

# game/script.rpy:2787
translate ingles badend_septem4_2c08f216:

    # septem "Estoy conciente de que eres un ser superior..."
    septem "I am aware that you are a superior being..."

# game/script.rpy:2790
translate ingles badend_septem4_0231f013:

    # septem "Pero no estoy dispuesto a este tipo de tratos."
    septem "But I am not willing to accept this kind of treatment."

# game/script.rpy:2791
translate ingles badend_septem4_8d8400b5:

    # septem "Menos de alguien que no tiene un control real sobre mi o mis acciones."
    septem "Least of all from someone who has no real control over me or my actions."

# game/script.rpy:2794
translate ingles badend_septem4_53db9bf9:

    # septem "Facilmente puedo quitarle la cabeza a tu marioneta y tú no podrás hacer nada."
    septem "I can easily cut your puppet's head off and you won't be able to do a thing."

# game/script.rpy:2795
translate ingles badend_septem4_40fddbf4:

    # septem "Por culpa de tus opciones limitadas bajo acciones predeterminadas."
    septem "Because of your limited options under predetermined actions."

# game/script.rpy:2798
translate ingles badend_septem4_4ad4a338:

    # septem "Nos vemos luego..."
    septem "See you later..."

# game/script.rpy:2800
translate ingles badend_septem4_760d2cba:

    # "Septem te corta la cabeza."
    "Septem slices off your head."

# game/script.rpy:2801
translate ingles badend_septem4_c1deba85:

    # "BAD END: Midiendo tu rango."
    "BAD END: Measuring your range."

# game/script.rpy:2807
translate ingles badend_septem5_7f6a9a3a:

    # "Mientras más le explicas la situación, la cual extrañamente el no parece recordar, la cara de Septem se torna roja y con un semblante serio."
    "The more you explain the situation to him, which strangely he doesn't seem to remember, Septem's face turns red and more serious."

# game/script.rpy:2809
translate ingles badend_septem5_a149cae2:

    # "Parece estar aguantando la furia."
    "He seems to be holding in his anger."

# game/script.rpy:2813
translate ingles badend_septem5_a276217e:

    # septem "¿Cómo es que la has encontrado?"
    septem "How did you find it?"

# game/script.rpy:2815
translate ingles badend_septem5_055d96bf:

    # septem "¡Esa llave siempre permanece conmigo!"
    septem "That key always stays with me!"

# game/script.rpy:2818
translate ingles badend_septem5_9913b937:

    # "De la nada, septem toma tu muñeca y la gira con tanta fuerza que rompe tus huesos."
    "Out of nowhere, Septem grabs your wrist and twists it so hard, he breaks your bones."

# game/script.rpy:2819
translate ingles badend_septem5_1c7e962f:

    # "El crujido de cada hueso, es horrible y el dolor es inaguantable. Pero tú no puedes hacer nada más que llorar."
    "The crunch of each bone is horrible and the pain is unbearable. But you can't do anything but cry."

# game/script.rpy:2820
translate ingles badend_septem5_78799bb7:

    # "Pues el agarre de Septem no se afloja ante nada, ni los golpes o rasguños que le haces con tu otra mano."
    "For Septem's grip doesn't loosen at anything, not even the hits or scratches you deal him with your other hand."

# game/script.rpy:2821
translate ingles badend_septem5_a16f49bd:

    # "Eres como un animal atrapado en una trampa para osos."
    "You're like an animal caught in a bear trap."

# game/script.rpy:2822
translate ingles badend_septem5_c11a6e01:

    # septem "Eres muy ruidoso..."
    septem "You are so noisy..."

# game/script.rpy:2824
translate ingles badend_septem5_dc0cdb81:

    # "Septem sonrie y te corta la cabeza."
    "Septem smiles and cuts off your head."

# game/script.rpy:2825
translate ingles badend_septem5_a07939b0:

    # "BAD END: Mejor guarda silencio."
    "BAD END: Better keep quiet."

# game/script.rpy:2831
translate ingles badend_septem6_d8df63b8:

    # "Te paseas por toda la extención del templo, mirando cada una de las puertas que son accesibles y cada uno de los ventanales..."
    "You walk around the entire length of the temple, looking at each of the accessible doors and each of the windows..."

# game/script.rpy:2832
translate ingles badend_septem6_cf7bf452:

    # "Varias puertas llevan al mismo jardín, pero aún no sientes tanta confianza como para salir."
    "Several doors lead to the same garden, but you still don't feel confident enough to leave."

# game/script.rpy:2834
translate ingles badend_septem6_593662c0:

    # "Intentas probar de a poco... Caminas unos pasos luego de salir por la puerta, no pasa nada."
    "You intend to try little by little... You walk a few steps, then, upon exiting through the door, nothing happens."

# game/script.rpy:2835
translate ingles badend_septem6_3c37d2e6:

    # "Luego, caminas hasta tocar el pasto con tus pies... Tampoco pasa nada."
    "Then, you walk until your feet touch the grass... nothing happens at that point, either."

# game/script.rpy:2837
translate ingles badend_septem6_d955e871:

    # "Te devuelvres para no levantar sospechas."
    "You turn back so as not to raise suspicions."

# game/script.rpy:2838
translate ingles badend_septem6_a20cefa7:

    # "..."
    "..."

# game/script.rpy:2840
translate ingles badend_septem6_192025a0:

    # "Te das otra vuelta por el templo, mirando por los ventanales."
    "You take another walk around the temple, looking through the windows."

# game/script.rpy:2841
translate ingles badend_septem6_39c1657e:

    # "Despues de un tiempo prudente, vuelves a tu objetivo: Escapar."
    "After a reasonable time, you return to your objective: Escape."

# game/script.rpy:2843
translate ingles badend_septem6_94b83f06:

    # "Sales por otra puerta que lleva al jardín, y esta vez corres en dirección hacia lo que parece ser un bosque."
    "You go out through another door that leads to the garden, and this time you run in the direction of what appears to be a forest."

# game/script.rpy:2844
translate ingles badend_septem6_0d03a698:

    # "Corres y corres."
    "You run and run."

# game/script.rpy:2845
translate ingles badend_septem6_a799dbd8:

    # "Corres tanto que te está comenzando a faltar el aliento. Por lo que decides descansar en unos matorrales."
    "You run so much that you're starting to lose your breath. So you decide to rest in some bushes."

# game/script.rpy:2846
translate ingles badend_septem6_7c620338:

    # "A lo lejos, vez como una sombra serpentea por el suelo."
    "In the distance, you see a shadow on the ground."

# game/script.rpy:2847
translate ingles badend_septem6_b1f48474:

    # "Parece ser una serpiente que se dirige a tu dirección."
    "It appears to be a snake heading in your direction."

# game/script.rpy:2848
translate ingles badend_septem6_2d040ae3:

    # "Aguantando el grito, te quedas completamente inmóvil."
    "Holding in your scream, you remain completely still."

# game/script.rpy:2851
translate ingles badend_septem6_7c57a5dd:

    # "Y cierras los ojos."
    "And you close your eyes."

# game/script.rpy:2853
translate ingles badend_septem6_c74e95f5:

    # el "No deberías haber hecho eso."
    el "You shouldn't have done that."

# game/script.rpy:2854
translate ingles badend_septem6_b6e15fb2:

    # "No reconoces esa voz... es una voz femenina y ronca."
    "You don't recognize that voice... it's a hoarse female voice."

# game/script.rpy:2855
translate ingles badend_septem6_24ec64e8:

    # "Al instante abres los ojos para poder ver de quien se trata."
    "You instantly open your eyes to see who it is."

# game/script.rpy:2857
translate ingles badend_septem6_5277ec63:

    # "Y lo que te recibe es la figura de una entidad cubierta con un velo y ropas que se asemejan a una bata."
    "And what greets you is the figure of an entity covered in a veil and robe-like clothes."

# game/script.rpy:2858
translate ingles badend_septem6_a3b7c1dc:

    # "Lleva una guadaña que eleva en lo alto del cielo."
    "She carries a scythe that she lifts high into the sky."

# game/script.rpy:2859
translate ingles badend_septem6_7db58f58:

    # "Y es lo último que vez."
    "And it's the last thing you see."

# game/script.rpy:2860
translate ingles badend_septem6_22c6f38a:

    # "BAD END: Conociendo a la segunda."
    "BAD END: Knowing the second."

# game/script.rpy:2865
translate ingles badend_septem7_88e69d3e:

    # "Buscas entre tus ropas el cuchillo que has encontrado y antes de siquera poder sacar el cuchillo, Septem te detiene con su mano mientras chasquea su lengua."
    "You search through your clothes for the knife you found, but before you can even take it out, Septem stops you with his hand while clicking his tongue."

# game/script.rpy:2868
translate ingles badend_septem7_86ca3c38:

    # septem "tsk."
    septem "Tsk."

# game/script.rpy:2869
translate ingles badend_septem7_c4db07d4:

    # "Se le ve decepcionado."
    "He looks disappointed."

# game/script.rpy:2870
translate ingles badend_septem7_cc22e356:

    # septem "No creí que fueras tan..."
    septem "I didn't think you were so..."

# game/script.rpy:2872
translate ingles badend_septem7_87081875:

    # septem "Ingenuo."
    septem "Naive."

# game/script.rpy:2875
translate ingles badend_septem7_fc2af527:

    # "Lo último que sientes es como Septem te quita el cuchillo y te arrebata la vida con este."
    "The last thing you feel is Septem taking your life with the knife he grabbed from you."

# game/script.rpy:2877
translate ingles badend_septem7_2c950ba3:

    # "BAD END: No puedes matar a un dios con un cuchillo."
    "BAD END: You can't kill a god with a knife."

# game/script.rpy:2882
translate ingles badend_septem8_5c3cac98:

    # septem "Ja."
    septem "Ha."

# game/script.rpy:2884
translate ingles badend_septem8_afd22679:

    # "Septem no duda ni un solo segundo de hacer explotar tu cabeza."
    "Septem doesn't hesitate for a single second before making your head explode."

# game/script.rpy:2886
translate ingles badend_septem8_b8a3ffca:

    # "BAD END: ..."
    "BAD END: ..."

# game/script.rpy:2932
translate ingles badend_unum1_3f69b341:

    # unum "Supongo que no te explico nada de nadaaa"
    unum "I guess she hasn't explained anything to you at aaalll."

# game/script.rpy:2966
translate ingles badend_unum1_03fac258:

    # "Sientes como te rompen el pecho, una mano urga dentro tuya en busca de algo en específico."
    "You feel your chest being torn apart, a hand searching through your organs for something specific."

# game/script.rpy:3039
translate ingles badendunum4_26af1524:

    # "Cuando lo sientes, dejas de respirar y agarras el mango del cuchillo y apuñalas a Unum en la cabeza con todas tus fuerzas."
    "When you feel it, you stop breathing and grab the handle of the knife and stab Unum in the head with all your strength."

# game/script.rpy:3119
translate ingles goodend1_b6516c2b:

    # "Atacas a la esfera que sostiene Unum en su mano."
    "You attack the sphere that Unum holds in his hand."

# game/script.rpy:3122
translate ingles goodend1_b9fafe19:

    # "El cae al suelo y tú solo observas, no pudiendo creer que aquello haya funcionado."
    "He falls to the ground and you just watch, not believing it worked."

# game/script.rpy:3123
translate ingles goodend1_0c0599d8:

    # "Pasan unos segundos y Unum sigue sin moverse."
    "A few seconds pass and Unum still doesn't move."

# game/script.rpy:3125
translate ingles goodend1_d25ee7d4:

    # "{glitch=20.0}{color=ffffff}{b}JA eres el primero en rechazarlo, ni él se esperaba eso. {/glitch}"
    "{glitch=20.0}{color=ffffff}{b}JA, you're the first to reject him, he didn't even expect that. {/glitch}"

# game/script.rpy:3127
translate ingles goodend1_fc0e81c9:

    # "{glitch=20.0}{color=ffffff}{b}Bien hecho {/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Good job! {/glitch}"

# game/script.rpy:3128
translate ingles goodend1_e60fe668:

    # "GOOD END: ¿¿??"
    "GOOD END: ????"

# game/script.rpy:3141
translate ingles noaceptaste_1d60bc70:

