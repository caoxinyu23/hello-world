    septem "{sc=3.5}Where do you think you're going?{/sc}"

# game/script.rpy:1226
translate ingles badendseptem1_f3eb485e:

    # septem "{sc=2}Eres el primer regalo que se atreve a escapar de mí.{/sc}"
    septem "{sc=2}You are the first gift that dares to escape from me.{/sc}"

# game/script.rpy:1229
