# game/script.rpy:1495
translate ingles rutaunum_56db0056:

    # "Tú no entiendes por qué ha hecho eso, pero supones que efectivamente, Unum tiene pensado otra manera."
    "You don't understand why he did that, but you assume that indeed, Unum has another way in mind."

# game/script.rpy:1496
translate ingles rutaunum_aafb8db5:

    # unum "No te dolerá."
    unum "It won't hurt."

# game/script.rpy:1503
translate ingles rutaunum_46bca10f:

    # "Piensas que probablemente no estén pensando en lo mismo..."
    "You think you two are probably not thinking the same thing..."

# game/script.rpy:1513
translate ingles rutaunum_86762e2e_2:

    # "Unum atravieza su pecho con la mano de manera lenta."
    "Unum slowly runs his hand across his chest."

# game/script.rpy:1514
translate ingles rutaunum_9c739289_2:

    # "Y con delicadeza, la retira con algo brillante en su mano."
    "And, gently, he removes something shiny from it."

# game/script.rpy:1517
translate ingles rutaunum_3c8e6e74_2:

    # "Es una esfera transparente que gotea un líquido parecido al oro."
    "It is a transparent sphere dripping with a gold-like liquid."

# game/script.rpy:1521
translate ingles rutaunum_aafb8db5_1:

    # unum "No te dolerá."
    unum "It won't hurt."

# game/script.rpy:1538
translate ingles rutaunum_c835bc89:

    # "Dice Unum mientras aparece nuevamente en la habitación y se acomoda en la cama."
    "Unum says as he appears back in the room and settles into bed."

# game/script.rpy:1539
translate ingles rutaunum_f21af8bd:

    # "...Decides recostarte por un rato, y sin darte cuenta, cierras los ojos por un momento."
    "... You decide to lie down for a while, and without realizing it, you close your eyes for a moment."

# game/script.rpy:2431
translate ingles menupuertas_aba1507b:

    # "Te echas la llave a los bolsillos pues parece importante."
    "You slip the key into your pocket."

# game/script.rpy:2550
translate ingles menupreguntas_ded70acd:

    # nj "Le has atravesado el pecho..."
    nj "You pierced his chest..."

# game/script.rpy:2831
translate ingles badend_septem5_181c4a27:

    # "De la nada, Septem toma tu muñeca y la gira con tanta fuerza que rompe tus huesos."
    "Out of nowhere, Septem grabs your wrist and twists it so hard it breaks your bones."

# game/script.rpy:2832
translate ingles badend_septem5_7848dcd5:

    # "El crujido de cada hueso es horrible y el dolor es inaguantable. Pero tú no puedes hacer nada más que llorar."
    "The crunch of every bone is horrible and the pain is unbearable. But you can't do anything but cry."

# game/script.rpy:2888
translate ingles badend_septem7_559abdaf:

    # "Septem te quita el cuchillo de las manos."
    "Septem takes the knife from your hands."

# game/script.rpy:2889
translate ingles badend_septem7_3addcb37:

    # "y sonrie..."
    "And he smiles..."

# game/script.rpy:2892
translate ingles badend_septem7_ed463c06:

    # "Lo ultimo que ves es como Septem clava el cuchillo en tu cuerpo."
    "The last thing you witness is how Septem thrusts the knife into your body."

# game/script.rpy:2893
translate ingles badend_septem7_821e481a:

    # "Arrebatando tu vida con este."
    "Taking your life away."

# game/script.rpy:3062
translate ingles badendunum4_e6381b86:

    # "Observas como el cuchillo ha conectado perfectamente en la cabeza del pelirrojo, atravesando el craneo incluso."
    "You notice how the knife has landed perfectly on the redhead's head, even going through the skull."

# game/script.rpy:3150
translate ingles nogogogo_e4ced746:

    # nj "¿Estás seguro?"
    nj "You're sure?"

# game/script.rpy:3153
translate ingles nogogogo_930f3515:

    # unum "Sí, lo consulté con Sextam hace un tiempo..."
    unum "Yes, I consulted with Sextam a while ago..."

# game/script.rpy:3154
translate ingles nogogogo_93bf4716:

    # unum "Y ella dijo que no es peligroso, pues es solo un pequeño intercambio que combinará ambos genes para formar uno nuevo."
    unum "And she said it's not dangerous, because it's just a small exchange that will combine both genes to form a new one."

# game/script.rpy:3155
translate ingles nogogogo_ba87d5ca:

    # unum "Un semidiós, descendiente de un estandarte y un humano."
    unum "A demigod, descended from a Symbol and a human."

# game/script.rpy:3156
translate ingles nogogogo_cc82b027:

    # "Si bien las palabras de Unum te calman un poco, hay algo que te viene molestando desde el inicio."
    "Although Unum's words calm you down a little, there is something that has been bothering you from the beginning."

# game/script.rpy:3161
translate ingles nogogogo_30dc929b:

    # "Unum te mira extrañado."
    "Unum looks at you strangely."

# game/script.rpy:3162
translate ingles nogogogo_f194daed:

    # unum "¿Eso es cuando los humanos hembras llevan al bebé?"
    unum "Is that when female humans carry the baby?"

# game/script.rpy:3165
translate ingles nogogogo_dd79d41f:

    # "Tú asientes con la cabeza y Unum no hace más que reir."
    "You nod your head and Unum does nothing but laugh."

# game/script.rpy:3166
translate ingles nogogogo_4687709d:

    # unum "¡Eso no será un problema!"
    unum "That won't be a problem!"

# game/script.rpy:3167
translate ingles nogogogo_6d47c4eb:

    # unum "Seas capaz o incapaz biologicamente de llevar a una cría en tu cuerpo, no afectará pues no es necesario usarte como un horno."
    unum "Whether you're biologically capable of carrying a baby or not, it won't matter because there's no need to use you as an oven."

# game/script.rpy:3168
translate ingles nogogogo_6edeef47:

    # "¿Un horno???? ¿acaba de comparar el proceso del embarazo con cocinar en un horno? no sabes como tomártelo.... supones que lo dejarás pasar porque solo porque es una entidad totalmente diferente a los humanos."
    "An oven???? Did he just compare the pregnancy process to cooking in an oven? You don't know how to take that... you assume you'll just let it go because he's a totally different entity than humans."

# game/script.rpy:3174
translate ingles nogogogo_30dc929b_1:

    # "Unum te mira extrañado."
    "Unum looks at you strangely."

# game/script.rpy:3175
translate ingles nogogogo_f194daed_1:

    # unum "¿Eso es cuando los humanos hembras llevan al bebé?"
    unum "Is that when female humans carry the baby?"

# game/script.rpy:3178
translate ingles nogogogo_dd79d41f_1:

    # "Tú asientes con la cabeza y Unum no hace más que reir."
    "You nod your head and Unum does nothing but laugh."

# game/script.rpy:3179
translate ingles nogogogo_4687709d_1:

    # unum "¡Eso no será un problema!"
    unum "That won't be a problem!"

# game/script.rpy:3180
translate ingles nogogogo_cb1b4694:

    # unum "Seas capaz o incapaz biologicamente de llevar a una cría en tu cuerpo, no quiero tomar el riesgo de perderte."
    unum "Whether you're biologically capable of carrying a baby or not, it won't matter because there's no need to use you as an oven."

# game/script.rpy:3181
translate ingles nogogogo_11b7c89c:

    # unum "Ni menos hacerte pasar por ese proceso."
    unum "Not even through that process."

# game/script.rpy:3185
translate ingles nogogogo_296bf63e:

    # unum "Sextam me lo ha explicado, y..."
    unum "Sextam explained it to me, and..."

# game/script.rpy:3186
translate ingles nogogogo_b08527b5:

    # unum "Demora mucho..."
    unum "It takes a long time..."

# game/script.rpy:3189
translate ingles nogogogo_05a7797d:

    # unum "La cría será cultivada dentro de la nueva escencia que se formará."
    unum "The offspring will be cultivated within the new essence that will be formed."

# game/script.rpy:3190
translate ingles nogogogo_410d2477:

    # unum "No afectará ni tu cuerpo ni el mío."
    unum "It won't affect your body or mine."

# game/script.rpy:3192
translate ingles nogogogo_2fd60b8b:

    # "Luego de decir aquello Unum pregunta una vez más, y tú más tranquilo, aceptas nuevamente."
    "After saying that, Unum asks once more, and you, calmer, accept again."

# game/script.rpy:3193
translate ingles nogogogo_d66ff265:

    # "Con la misma delicadeza, Unum coloca la mano que tiene su esencia en tu pecho y ejerce presión."
    "With the same sense of delicacy, Unum places the hand holding his essence on your chest and applies pressure."

# game/script.rpy:3194
translate ingles nogogogo_0800ec04:

    # "El lugar donde te está presionando comienza a sentirse caliente, no al punto de quemar ni doler, pero caliente de todos modos."
    "The place where he's pressing on you starts to feel hot, not to the point of burning or pain, but hot nonetheless."

# game/script.rpy:3195
translate ingles nogogogo_7b40e4e0:

    # "Hasta que algo dentro de ti se abre, permitiendo a Unum atravesar tu pecho."
    "Until something inside you opens, allowing Unum to pass through your chest."

# game/script.rpy:3196
translate ingles nogogogo_baf324ce:

    # nj "Uhg..."
    nj "Uhg..."

# game/script.rpy:3197
translate ingles nogogogo_d64747fd:

    # unum "¿Te duele?"
    unum "Does it hurt?"

# game/script.rpy:3198
translate ingles nogogogo_5537d5df:

    # "Pregunta asustado e intenta quitar su mano pero tu lo detienes."
    "He asks, scared. He tries to remove his hand but you stop him."

# game/script.rpy:3199
translate ingles nogogogo_7a1f4146:

    # nj "No, pero se siente extraño."
    nj "No, but it feels strange."

# game/script.rpy:3200
translate ingles nogogogo_b04f89f9:

    # unum "Falta un poco, aguanta."
    unum "Just a little more, hang in there."

# game/script.rpy:3201
translate ingles nogogogo_a52e9fa9:

    # "Ambos se quedan quietos por un largo tiempo, y te preguntas cuanto tiempo más tiene que pasar para que el intercambio de esencias termine. Mientras, Unum se dedica a observar tus facciones con fascinación."
    "You both remain still for a long time, and you wonder how much longer it will take for the exchange of essences to end. Meanwhile, Unum observes your features with fascination."

# game/script.rpy:3202
translate ingles nogogogo_a20cefa7:

    # "..."
    "..."

# game/script.rpy:3203
translate ingles nogogogo_45a7c779:

    # "Hay un momento en que siente que tu pecho comienza a quemar, duele un poco pero te lo aguantas."
    "There is a moment when you feel like your chest starts to burn. It hurts a little, but you endure it."

# game/script.rpy:3204
translate ingles nogogogo_56a542b5:

    # unum "¡Listo!"
    unum "There, that's it!"

# game/script.rpy:3205
translate ingles nogogogo_2b4bd6bd:

    # "Unum retira su mano de tu cuerpo con la esencia que previamente era de un color parecido al oro, ahora ha tomado otro color. Unum la examina antes de dedicarte una sonrisa que muestra todos sus dientes."
    "Unum removes his hand from your body with the previously gold-like colored essence now taking on another color. Unum examines it before giving you a smile that shows all his teeth."

# game/script.rpy:3206
translate ingles nogogogo_3cb71e32:

    # "Con sumo cuidado él coloca la esencia en tus manos. En ese proceso extrae una gran parte de la esencia, formando dos. Una de color oro."
    "With great care, he places the essence in your hands, extracting a large part of it to form two. One gold."

# game/script.rpy:3207
translate ingles nogogogo_ebe12128:

    # "Y la que tienes en tus manos, de un bello color rojo."
    "And the one you have in your hands, a beautiful red color."

# game/script.rpy:3208
translate ingles nogogogo_74dcecde:

    # "La observas por un buen rato, y puedes notar como hay movimentos dentro de la esencia. Algo se está formando..."
    "Upon observing it for a long time, you notice how there's movements within the essence. Something is forming..."

# game/script.rpy:3209
translate ingles nogogogo_4d125d64:

    # "Unum por su parte, coloca su esencia en su pecho, guardándola."
    "Unum, for his part, places his essence back in his chest, guarding it."

# game/script.rpy:3210
translate ingles nogogogo_45d96069:

    # unum "Colocaré a la cría en un cuarto seguro."
    unum "I will place the baby in a safe room."

# game/script.rpy:3211
translate ingles nogogogo_3b40215e:

    # "Te avisa antes de tomarla de tus manos y llevarla fuera de la habitación."
    "He warns you before taking the 'baby' from your hands and carrying them out of the room."

# game/script.rpy:3212
translate ingles nogogogo_feda1863:

    # "... De cierta manera, sientes toda esta situación bizarra."
    "... In a way, you feel this whole situation is bizarre."

translate ingles strings:

    # game/script.rpy:3157
    old "Pero yo no puedo embarazarme"
    new "But I can't get pregnant."

    # game/script.rpy:3157
    old "Yo no... quiero embarazarme"
    new "I don't... want to get pregnant."

