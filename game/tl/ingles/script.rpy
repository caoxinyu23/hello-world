# game/script.rpy:111
translate ingles start_56c14410:

    # "....Por favor no hagas nada que está fuera de lo estipulado, ni invoques el nombre del representante del vacío, lo tienes estrictamente prohibido."
    "... Please do not do anything that is outside the stipulations, nor summon the name of the representative of the Void, this is strictly prohibited."

# game/script.rpy:180
translate ingles start_1f174e33:

    # el "Bienvenido, te he estado esperando."
    el "Welcome, I've been waiting for you."

# game/script.rpy:294
translate ingles start_3f010b45:

    # fames "Pero el último lo ha roto Quinque por completo... pensé que habían quedado en que no se harían más..."
    fames "But the last one was completely broken by Quinque... I thought you and Mother had agreed that no more would be made..."

# game/script.rpy:297
translate ingles start_a07dac4a:

    # nulla "Eso fue porque Quinque es un animal. No cuida de las cosas... Supongo que Madre no puede dejar a Septem sin su comida semanal..."
    nulla "That was because Quinque is an animal. He doesn't take care of things... but I guess Mother can't leave Septem without his weekly meal..."

# game/script.rpy:300
translate ingles start_13f02c92:

    # fames "Se nota como te arde el favoritismo..."
    fames "It's obvious you're burned by the favoritism..."

# game/script.rpy:396
translate ingles start_8d3b8d95:

    # el "Este no es un trabajador... ¿No será el regalo que nos hace Madre?"
    el "This is not a worker... Could it be Mother's gift?"

# game/script.rpy:403
translate ingles start_d939b8c3:

    # el "Son los ojos que tiene... y el olor que emana. WOW parece que ahora Madre los está haciendo similares a los humanos."
    el "It's the eyes they have... and the smell they emanate. WOW, it looks like Mother is making them similar to humans now."

# game/script.rpy:408
translate ingles start_1ebd6f84:

    # ell "{sc=1}...{/sc}"
    ell "{sc=1}...{/sc}"

# game/script.rpy:442
translate ingles start_deec228e:

    # el "No recordaba que tuvieran tanta autonomía..."
    el "I didn't remember that they had so much autonomy..."

# game/script.rpy:497
translate ingles start_bd84b573:

    # el "Siempre te quejas que lo rompen muy rápido... además, el tiempo que te tomas cuando te toca es eterno."
    el "You always complain that they break it too quickly... besides, the time you take when it's your turn is eternal."

# game/script.rpy:526
translate ingles start_19384c7a:

    # ell "..."
    ell "..."

# game/script.rpy:551
translate ingles start_8f464658:

    # nulla "Podrían dejar que el regalo elija e invoque uno de sus nombre..."
    nulla "You could let the gift choose and summon one of your names..."

# game/script.rpy:567
translate ingles start_1b2b9397:

    # "Intentas decir su nombre pero te es físicamente imposible."
    "You try to say his name but it is physically impossible for you."

# game/script.rpy:568
translate ingles start_5ef2b63f:

    # "Miras a Nulla, quien al percatarse tal vez de lo que intentas hacer, procede a mover sus manos realizando señas estrañas."
    "You look at Nulla, who, perhaps realizing what you are trying to do, proceeds to move his hands, making strange signs with them."

# game/script.rpy:569
translate ingles start_925be7fd:

    # "{glitch=20.0}{color=ffffff}{b}Vamos... Intenta de nuevo.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Come on... try again.{/glitch}"

# game/script.rpy:570
translate ingles start_771c9a24:

    # "Puedes escuchar claramente la voz de Nulla en tu cabeza, y haciendo caso, lo intentas nuevamente."
    "You can clearly hear Nulla's voice in your head, so you try saying his name again."

# game/script.rpy:571
translate ingles start_0a0ceac9:

    # "Pronuncias su nombre y alcanzas a ver como la cara de Septem se deforma en una mueca extraña..."
    "By saying his name, you see how Septem's face twists into a strange grimace..."

# game/script.rpy:572
translate ingles start_3819fc42:

    # "Nulla en cambio, sonrie."
    "Nulla, on the other hand, smiles."

# game/script.rpy:577
translate ingles start_f84027c7:

    # "Intentas decir su nombre pero te es físicamente imposible. Por lo que lo apuntas."
    "You try to say his name but it is physically impossible for you. So you point him out with your finger."

# game/script.rpy:980
translate ingles rutaunum_ebc34089:

    # "Él te mira con la boca abierta, casi que fascinado... Dándose cuenta de tu silencio, habla."
    "He looks at you with his mouth open, almost fascinated... Noticing your silence, he speaks."

# game/script.rpy:1045
translate ingles rutaunum_07bdde05:

    # "....."
    "....."

# game/script.rpy:1065
translate ingles rutaunum_68c48d73:

    # "La expresión de Unum demuestra lo exaltado que está, cosa que no te agrada mucho pues sabes por experiencia propia que eso no lleva a nada bueno."
    "Unum's expression shows how exalted he is, which you don't like very much because you know from your own experience that it doesn't lead to anything good."

# game/script.rpy:1398
translate ingles rutaunum_da8b47da:

    # unum "Duae ha venido de visita..."
    unum "Duae came to visit..."

# game/script.rpy:1451
translate ingles rutaunum_43102250_4:

    # unum "..."
    unum "..."

# game/script.rpy:1523
translate ingles rutaunum_da775502:

    # "Sientes tu cuerpo pesado, como si hubieras corrido 4 kilometros sin descanso..."
    "Your body feels heavy, as if you had run four kilometers without rest..."

# game/script.rpy:1524
translate ingles rutaunum_602062c9:

    # "Es extraño, como si te hubieran sacado parte de tu cuerpo, alguna parte importante."
    "It's strange, like he's taken out part of your body, an important part."

# game/script.rpy:1525
translate ingles rutaunum_9f06718a:

    # "Pero estás completo."
    "But you are complete."

# game/script.rpy:1526
translate ingles rutaunum_d848d579:

    # "No hay nada faltante."
    "There is nothing missing."

# game/script.rpy:1528
translate ingles rutaunum_4ef4015a:

    # unum "Si quieres puedes descansar aquí un rato."
    unum "If you want you can rest here for a while."

# game/script.rpy:1529
translate ingles rutaunum_f74926b3:

    # "Dice Unum mientras se acomoda en la cama."
    "Unum says as he settles into bed."

# game/script.rpy:1530
translate ingles rutaunum_389c73d6:

    # "Decides recostarte por un rato, y sin darte cuenta, cierras los ojos por un momento."
    "You decide to lie down for a while, and without realizing it, you close your eyes for a moment."

# game/script.rpy:1534
translate ingles rutaunum_a20cefa7_13:

    # "..."
    "..."

# game/script.rpy:1535
translate ingles rutaunum_c9bebfe0:

    # "{sc=4}{b}....{b}{/sc}"
    "{sc=4}{b}....{b}{/sc}"

# game/script.rpy:1536
translate ingles rutaunum_f3fad667:

    # "{sc=4}{b}Veo que has ingerido alimentos no santificados...{b}{/sc}"
    "{sc=4}{b}I see that you have eaten unsanctified food...{b}{/sc}"

# game/script.rpy:1537
translate ingles rutaunum_76b0b6dc:

    # "{sc=4}{b}Dentro de ti hay veneno que se está exparciendo de a poco.{b}{/sc}"
    "{sc=4}{b}Inside you there is poison that is spreading little by little.{b}{/sc}"

# game/script.rpy:1538
translate ingles rutaunum_e2aaaa09:

    # "{sc=4}{b}Mil disculpas, no puedo controlar como es consumido mis frutos.{b}{/sc}"
    "{sc=4}{b}Sorry, I can't control how my fruits are consumed.{b}{/sc}"

# game/script.rpy:1539
translate ingles rutaunum_1ab27cff:

    # "{sc=4}{b}Unum es un idiota...{b}{/sc}"
    "{sc=4}{b}Unum is an idiot...{b}{/sc}"

# game/script.rpy:1540
translate ingles rutaunum_a20cefa7_14:

    # "..."
    "..."

# game/script.rpy:1542
translate ingles rutaunum_cc9a5909:

    # "!!!"
    "!!!"

# game/script.rpy:1544
translate ingles rutaunum_d3e0a825:

    # "Despiertas repentinamente, sintiendo una gota de sudor frío recoriendo tu cuello."
    "You wake up suddenly, feeling a drop of cold sweat running down your neck."

# game/script.rpy:1546
translate ingles rutaunum_1f022e2b:

    # "Y lo primero que te encuentras es a Unum mirandote de cerca, casi que inspeccionándote."
    "And the first thing you find is Unum looking at you closely, almost inspecting you."

# game/script.rpy:1548
translate ingles rutaunum_24a894ac:

    # unum "Tu respiración es constante cuando descansas."
    unum "Your breathing is constant when you rest."

# game/script.rpy:1549
translate ingles rutaunum_d668838b:

    # unum "Impresionante."
    unum "Impressive."

# game/script.rpy:1550
translate ingles rutaunum_97b1af78:

    # "Sinceramente, prefieres que haga este tipo de comentarios a que le den los 5 minutos de locura y quiera romperte en pedazos para saber como funciona tu cuerpo."
    "Honestly, you'd rather him make these kinds of comments than have him freak out for five minutes, wanting to break you into pieces to discover how your body works."

# game/script.rpy:1551
translate ingles rutaunum_d9ed5370:

    # nj "¿Me has estado mirando mientras duermo?"
    nj "Have you been watching me while I sleep?"

# game/script.rpy:1552
translate ingles rutaunum_25e4832c:

    # unum "...¿Si?"
    unum "... Yes?"

# game/script.rpy:1554
translate ingles rutaunum_a78420f5:

    # unum "¿Está prohidido hacerlo?"
    unum "Is it forbidden to do so?"

# game/script.rpy:1555
translate ingles rutaunum_844f3df9:

    # nj "No pero..."
    nj "No, but..."

# game/script.rpy:1556
translate ingles rutaunum_2e63ba8c:

    # "Te detienes cuando sientes que tu estómago se te revuelve."
    "You stop when you feel your stomach turn."

# game/script.rpy:1558
translate ingles rutaunum_89b52ea5:

    # "Algo dentro de ti quema."
    "Something inside you burns."

# game/script.rpy:1560
translate ingles rutaunum_6f4d40d6:

    # "Te levantas rápidamente, pensando que vomitarás."
    "You get up quickly, thinking you'll throw up."

# game/script.rpy:1562
translate ingles rutaunum_8d55f64c:

    # "Pero lo único que sale de tu boca son pétalos color rojo, meszlados con sangre."
    "But the only thing that comes out of your mouth are red petals, mixed with blood."

# game/script.rpy:1563
translate ingles rutaunum_24f59be8:

    # "...¿Qué?"
    "... What?"

# game/script.rpy:1564
translate ingles rutaunum_4452456e:

    # "Los miras con detenimiento... parecen tener un símbolo extraño."
    "You look closely at them... they seem to have a strange looking symbol on them."

# game/script.rpy:1566
translate ingles rutaunum_86142590:

    # unum "¿Qué es eso?"
    unum "What's that?"

# game/script.rpy:1567
translate ingles rutaunum_8e0ac83c:

    # "No tienes tiempo para pensar por un momento pues un ataque de tos te detiene."
    "You don't have time to think for a moment because a coughing attack stops you."

# game/script.rpy:1568
translate ingles rutaunum_1643ae8c:

    # "Algo te respa la garganta."
    "Something soothes your throat."

# game/script.rpy:1571
translate ingles rutaunum_18f24bab:

    # unum "¿[nombrejugador]?"
    unum "[nombrejugador]?"

# game/script.rpy:1572
translate ingles rutaunum_a1c22fb9:

    # ell "¿No me digas que le has dado comida?"
    ell "Don't tell me you gave them food?"

# game/script.rpy:1576
translate ingles rutaunum_d1e84e41:

    # unum "¿Aeliana?"
    unum "Aeliana?"

# game/script.rpy:1579
translate ingles rutaunum_a8a0758d:

    # aeliana "Unum."
    aeliana "Unum."

# game/script.rpy:1584
translate ingles rutaunum_8fa4c474:

    # aeliana "Escuché de Ignis y Solaris que has estado preparando comida sin hacer el ritual de santificación."
    aeliana "I heard from Ignis and Solaris that you have been preparing food without doing the sanctification ritual."

# game/script.rpy:1587
translate ingles rutaunum_a4e6d3f9:

    # unum "¿Qué?"
    unum "What?"

# game/script.rpy:1590
translate ingles rutaunum_a0f3af5d:

    # aeliana "Tienes que llamar a Sextam sino quieres que esta cosa se muera."
    aeliana "You have to call Sextam if you don't want this thing to die."

# game/script.rpy:1593
translate ingles rutaunum_3f44a3e2:

    # unum "Pero Sextam está en la iglesia..."
    unum "But Sextam is in the church..."

# game/script.rpy:1594
translate ingles rutaunum_9a3d28a4:

    # aeliana "...Tienes razón."
    aeliana "... You're right."

# game/script.rpy:1595
translate ingles rutaunum_0484ed3d:

    # aeliana "¿Y Quinque?"
    aeliana "What about Quinque?"

# game/script.rpy:1598
translate ingles rutaunum_6a9d5c41:

    # unum "¡Está enojado conmigo!"
    unum "He's mad at me!"

# game/script.rpy:1601
translate ingles rutaunum_78fda599:

    # aeliana "Seguro que vendrá..."
    aeliana "I'm sure he'll come..."

# game/script.rpy:1604
translate ingles rutaunum_8a3e8d1c:

    # "No estás entendiendo nada."
    "You're not understanding anything."

# game/script.rpy:1605
translate ingles rutaunum_a87f98ee:

    # "Y tu cuerpo no pide nada más que expulsar lo que tienes en la garganta, pero a pesar de que estás tosiendo de manera constante, nada sale."
    "And your body doesn't ask for anything more than to expel what's in your throat, but even though you're coughing constantly, nothing comes out."

# game/script.rpy:1606
translate ingles rutaunum_87a8406e:

    # "Te estás ahogando."
    "You're choking on the petals."

# game/script.rpy:1607
translate ingles rutaunum_d7737d32:

    # "Y ya no puedes aguantar más."
    "And you can't take it anymore."

# game/script.rpy:1608
translate ingles rutaunum_4994685c:

    # aeliana "ah- ¡Cuidado!"
    aeliana "Ah--careful!"

# game/script.rpy:1610
translate ingles rutaunum_a9424fd6:

    # "La mujer intenta ir hacia ti pero no alcanza a atraparte cuando caes de la cama al piso."
    "The woman tries to go towards you but can't catch you when you fall from the bed to the floor."

# game/script.rpy:1611
translate ingles rutaunum_6c49ec86:

    # "El golpe es fuerte, provocando que te duelan los huesos."
    "The fall is so strong that it makes your bones ache."

# game/script.rpy:1612
translate ingles rutaunum_0a0498d1:

    # "El aire que entra a tus pulmones no es suficiente como para mantenerte conciente."
    "The air that enters your lungs is not enough to keep you conscious."

# game/script.rpy:1614
translate ingles rutaunum_2a425eb2:

    # "... Caes inconciente."
    "... You fall unconscious."

# game/script.rpy:1615
translate ingles rutaunum_3178f9b4:

    # "Sientes como manos te agarran por la fuerza, intentando hundirte."
    "You feel hands grab you by force, trying to pull you down."

# game/script.rpy:1616
translate ingles rutaunum_4ec221ce:

    # "Pero algo te lo impide."
    "But something prevents you."

# game/script.rpy:1618
translate ingles rutaunum_ff2786e3:

    # "Una electricidad recorre tu cuerpo."
    "An electricity runs through your body."

# game/script.rpy:1620
translate ingles rutaunum_12a72ebf:

    # "Abres los ojos pero la luz es demasiado brillante."
    "You open your eyes but the light is too bright."

# game/script.rpy:1622
translate ingles rutaunum_0f27e065:

    # unum "¿Se va a morir?"
    unum "They're going to die?"

# game/script.rpy:1623
translate ingles rutaunum_c4702998:

    # "Se escucha la voz de Unum a lo lejos."
    "Unum's voice is heard in the distance."

# game/script.rpy:1624
translate ingles rutaunum_501f069f:

    # el "Cómo se te muera este y me eches de nuevo la culpa..."
    el "If this one dies and you blame me again..."

# game/script.rpy:1625
translate ingles rutaunum_9d32017c:

    # unum "¡Ya te pedí disculpas!"
    unum "I already apologized!"

# game/script.rpy:1626
translate ingles rutaunum_acaefeb5:

    # el "¡Solamente porque la señorita Ignis te ha dicho que lo hicieras!"
    el "Only because Miss Ignis told you to!"

# game/script.rpy:1628
translate ingles rutaunum_316a6b03:

    # "Los gritos son lo que te traen devuelta a la vida."
    "The shouting is what brings you back to life."

# game/script.rpy:1629
translate ingles rutaunum_77caa04a:

    # "Abres los ojos y lo primero que ves es a una entidad desconocida, la cual te tiene con una mano agarrado de los hombros, mientras que con la otra mano toca cuidadosamente tu estómago."
    "You open your eyes and the first thing you see is an unknown entity that has one hand holding you by the shoulders, the other hand carefully touching your stomach."

# game/script.rpy:1630
translate ingles rutaunum_73a40e77:

    # el "¿Cómo mierda ha comido algo sin purificar?"
    el "How the hell did they eat something unpurified?"

# game/script.rpy:1631
translate ingles rutaunum_43102250_5:

    # unum "..."
    unum "..."

# game/script.rpy:1632
translate ingles rutaunum_5103d250:

    # "Tu estómago se revuelve nuevamente cuando la mano de la entidad apreta con suavidad una zona en específico."
    "Your stomach churns again when the entity's hand gently squeezes a specific area."

# game/script.rpy:1634
translate ingles rutaunum_868902c5:

    # "No puedes evitar dejar caer tu cuerpo para poder expulsar más pétalos de color rojo"
    "You can't help but drop to the ground to expel more red petals."

# game/script.rpy:1635
translate ingles rutaunum_21db02aa:

    # el "Mierda-!"
    el "Shit--!"

# game/script.rpy:1636
translate ingles rutaunum_e2682cc1:

    # unum "... ¿Era necesario purificar los alimentos?"
    unum "... Was it necessary to purify the food?"

# game/script.rpy:1638
translate ingles rutaunum_8c7dc046:

    # el "¿TE FALTAN NEURONAS O ALGO?"
    el "ARE YOU MISSING NEURONS OR SOMETHING?"

# game/script.rpy:1639
translate ingles rutaunum_38fb6985:

    # el "Tria ha dicho un millón de veces de lo que está sucediendo con sus frutos. {sc=3}¿Y TÚ NO TIENES IDEA?{/sc}"
    el "Tria has said a million times what's happening to her fruits. {sc=3}AND YOU HAVE NO IDEA?{/sc}"

# game/script.rpy:1640
translate ingles rutaunum_ff64119c:

    # el "{sc=4}¿TUS ESPOSAS NECESITAN COMER Y TÚ NO TIENES IDEAA?????{/sc}"
    el "{sc=4}YOUR WIVES NEED TO EAT AND YOU HAVE NO IDEA?????{/sc}"

# game/script.rpy:1642
translate ingles rutaunum_65e7971b:

    # unum "Yo no sé cocinar... Ellas son las que cocinan."
    unum "I don't know how to cook... they're the ones who cook."

# game/script.rpy:1643
translate ingles rutaunum_d6d58b83:

    # unum "Así que no sabía que hay que purificar los alimentos..."
    unum "So I didn't know that you have to purify food..."

# game/script.rpy:1644
translate ingles rutaunum_88d65d1b:

    # el "{sc=5}ERES UN TREMENDO PEDAZO DE INÚTIL!!{/sc}"
    el "{sc=5}YOU ARE SO FUCKING STUPID!!{/sc}"

# game/script.rpy:1645
translate ingles rutaunum_5f9b772e:

    # "...."
    "...."

# game/script.rpy:1646
translate ingles rutaunum_820a40a1:

    # "Tus parpados no pueden mantenerse abiertos."
    "Your eyes can't stay open."

# game/script.rpy:1648
translate ingles rutaunum_b68fa212:

    # "Dejas de escuchar lo que está pasando para volver a caer en un sueño profundo."
    "You stop listening to what's happening and fall back into a deep sleep."

# game/script.rpy:1652
translate ingles rutaunum_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2} You'll have to wait a bit to find out how this ends... :3{/sc}"

# game/script.rpy:1675
translate ingles menuexplorar1_nulla_384e71f7:

    # "Buscas a Nulla por la casa... pero no logras dar con él."
    "You look for Nulla around the house... but you can't find him."

# game/script.rpy:1676
translate ingles menuexplorar1_nulla_58ff1021:

    # "No se encuentra ni en el primer o segundo piso."
    "He's not even on the first or second floor."

# game/script.rpy:1677
translate ingles menuexplorar1_nulla_4bc9a0de:

    # "Y el único lugar que se te ocurre es ir afuera."
    "And the only place you can think of is to go outside."

# game/script.rpy:1679
translate ingles menuexplorar1_nulla_907c19f7:

    # "Recorrer el lugar pero no hay nada."
    "You look around the place but there is nothing."

# game/script.rpy:1682
translate ingles menuexplorar1_nulla_d14eff8d:

    # "Tomas aire para llamar a su nombre."
    "You take a breath to call his name."

# game/script.rpy:1683
translate ingles menuexplorar1_nulla_c411cede:

    # nj "Nullaaaa."
    nj "Nullaaaa."

# game/script.rpy:1687
translate ingles menuexplorar1_nulla_23cdf703:

    # "Supones que debe estar ocupado o en otro lugar fuera de su dominio..."
    "You assume he must be busy or somewhere else outside his domain..."

# game/script.rpy:1688
translate ingles menuexplorar1_nulla_37dd50f9:

    # "Asi que das media vuelta y vuelves a la casa."
    "... So you turn around and go back to the house."

# game/script.rpy:1691
translate ingles menuexplorar1_nulla_e5b8f6c6:

    # "No obtienes respuesta."
    "You get no answer."

# game/script.rpy:1692
translate ingles menuexplorar1_nulla_d10d60f3:

    # "Wow eso sonó bastante incómodo... más aún cuando Nulla no muestra signos de aparecer."
    "Wow, that sounded pretty awkward... even more so when Nulla shows no signs of appearing."

# game/script.rpy:1693
translate ingles menuexplorar1_nulla_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1694
translate ingles menuexplorar1_nulla_87b45ae7:

    # "Esperas un poco más."
    "You wait a little longer."

# game/script.rpy:1695
translate ingles menuexplorar1_nulla_1698b553:

    # nj "¡Nulla!"
    nj "Nulla!"

# game/script.rpy:1696
translate ingles menuexplorar1_nulla_4fa37087:

    # "Subes un poco más la voz, al punto de gritar."
    "You raise your voice a little more, to the point of shouting."

# game/script.rpy:1699
translate ingles menuexplorar1_nulla_0fb78b31:

    # nulla "¿Necesitas algo?"
    nulla "Do you need anything?"

# game/script.rpy:1700
translate ingles menuexplorar1_nulla_e41e3c5f:

    # "Nulla aparece detrás tuyo, lo que provoca te tome desprevenido y pegues un salto."
    "Nulla appears behind you, catching you off guard and making you jump."

# game/script.rpy:1703
translate ingles menuexplorar1_nulla_3427fc53:

    # nulla "Ja-- la marioneta se ha asustado..."
    nulla "Ja--the puppet is scared..."

# game/script.rpy:1704
translate ingles menuexplorar1_nulla_1e5a2e00:

    # nulla "[nombrejugador], ¿necesitas algo de mí?"
    nulla "[nombrejugador], do you need anything from me?"

# game/script.rpy:1710
translate ingles menuexplorar1_nulla_bb6b515c:

    # nulla "Oh."
    nulla "Oh."

# game/script.rpy:1711
translate ingles menuexplorar1_nulla_6ad4f67f:

    # nulla "Me lo estás poniendo difícil..."
    nulla "You're making it difficult for me..."

# game/script.rpy:1714
translate ingles menuexplorar1_nulla_3a91303b:

    # nulla "Pero no puedo decirte que no."
    nulla "... But I can't say no to you."

# game/script.rpy:1717
translate ingles menuexplorar1_nulla_74c1ca7b:

    # "Hay un silencio largo antes de que Nulla se digne a responder."
    "There is a long silence before Nulla decides to respond."

# game/script.rpy:1720
translate ingles menuexplorar1_nulla_c145bb8b:

    # nulla "Está bien"
    nulla "Alright."

# game/script.rpy:1723
translate ingles menuexplorar1_nulla_f2930c8a:

    # nulla "Podríamos pasar el día fuera de mi dominio... aquí no hay mucho que hacer..."
    nulla "We could spend the day outside my domain... there's not much to do here..."

# game/script.rpy:1724
translate ingles menuexplorar1_nulla_5319a886:

    # nulla "¿Te parece?"
    nulla "What do you think?"

# game/script.rpy:1738
translate ingles menuexplorar1_nulla_73f5250e:

    # nulla "Sabía que dirías que sí."
    nulla "I knew you'd say yes."

# game/script.rpy:1741
translate ingles menuexplorar1_nulla_7ac2dab8:

    # nulla "Ah y no te preocupes... saldremos sellados para que los demás no nos encuentren."
    nulla "Oh, and don't worry... we'll leave sealed so the others won't find us."

# game/script.rpy:1742
translate ingles menuexplorar1_nulla_9de58984:

    # nulla "Septem ya debe estar entrando en pánico, ja."
    nulla "Septem must be panicking by now, ja."

# game/script.rpy:1743
translate ingles menuexplorar1_nulla_8c0560e8:

    # "Nulla junta las manos y tu alrededor comienza a volverse negro y tus pies dejan de tocar suelo."
    "Nulla puts his hands together and your surroundings begin to turn black and your feet stop touching the ground."

# game/script.rpy:1745
translate ingles menuexplorar1_nulla_465d1aa3:

    # nulla "Hace mucho tiempo que no salía de mi dominio..."
    nulla "It's been a long time since I left my domain..."

# game/script.rpy:1746
translate ingles menuexplorar1_nulla_b2763bd9:

    # nulla "Bueno... la verdad es que hace mucho tiempo que ya no hago nada."
    nulla "Well... the truth is that I haven't done anything for a long time."

# game/script.rpy:1748
translate ingles menuexplorar1_nulla_64c4a167:

    # "No pasan más de 5 segundos cuando sientes tus pies tocar nuevamente el suelo. y mientras el vacío se disipa puedes apreciar como de apoco se van construyendo estruccturas y paisajes a tu alrededor."
    "No more than five seconds pass when you feel your feet touch the ground again. And as the emptiness dissipates, you can see how, little by little, structures and landscapes are being built around you."

# game/script.rpy:1751
translate ingles menuexplorar1_nulla_d2764314:

    # "Se encuentran en una especie de café, con mesas llenas de gente tanto fuera como dentro del local."
    "You find yourself at a coffee shop with tables full of people both outside and inside the premises."

# game/script.rpy:1752
translate ingles menuexplorar1_nulla_bbb915a1:

    # "Nulla sin prestarle atención a la gente decide dirigirse directamente a una de las mesas vacías que se encuentran fuera del local."
    "Nulla, without paying attention to the people, decides to go directly to one of the empty tables outside the shop."

# game/script.rpy:1753
translate ingles menuexplorar1_nulla_54432775:

    # "Tú le sigues por inercia, al llegar, él te dedica una sola mirada para confirmar que tiene tu atención."
    "You follow him out of inertia. When you arrive, he gives you a single look to confirm that he has your attention."

# game/script.rpy:1754
translate ingles menuexplorar1_nulla_61e51cf5:

    # "Y como si las cosas aparecieran de la nada, la mesa se llena de dulces y dos tasas de té, las cuales emanan vapor por lo caliente que están."
    "And, as if appearing out of nowhere, the table is suddenly filled with sweets and two cups of tea, which give off steam from their heat."

# game/script.rpy:1755
translate ingles menuexplorar1_nulla_88fa4b53:

    # nulla "Adelante."
    nulla "Go ahead."

# game/script.rpy:1756
translate ingles menuexplorar1_nulla_c99c3aa2:

    # "Te corre la silla para que puedas sentarte. Como todo un caballero."
    "He pulls out the chair for you so you can sit down. Like a gentleman."

# game/script.rpy:1758
translate ingles menuexplorar1_nulla_81c590e9:

    # "Una vez ya instalados, te das cuenta de que Nulla mira la calle con algo de nostalgia."
    "Once settled, you realize that Nulla looks at the street with some nostalgia."

# game/script.rpy:1761
translate ingles menuexplorar1_nulla_266cb1c4:

    # nulla "Antes me gustaba pasearme por los dominios de los demás y observar a su gente..."
    nulla "Before, I liked to walk around the other's domains and observe their people..."

# game/script.rpy:1762
translate ingles menuexplorar1_nulla_7d7ad0f6:

    # nulla "Me preguntaba como sería ser ellos..."
    nulla "I wondered what it would be like to be them..."

# game/script.rpy:1763
translate ingles menuexplorar1_nulla_74e8bc46:

    # nulla "Que sueños o metas tienen, cual es su propósito."
    nulla "What dreams or goals do they have, their purpose."

# game/script.rpy:1766
translate ingles menuexplorar1_nulla_32ab03d0:

    # nulla "Ya no."
    nulla "Not anymore."

# game/script.rpy:1767
translate ingles menuexplorar1_nulla_0f24437d:

    # nj "¿Y eso porqué?"
    nj "Why's that?"

# game/script.rpy:1770
translate ingles menuexplorar1_nulla_80283fa2:

    # nulla "Porque me di cuenta que no son nada más que una ilusión."
    nulla "Because I realized that they are nothing more than an illusion."

# game/script.rpy:1771
translate ingles menuexplorar1_nulla_0eb06432:

    # nj "..."
    nj "..."

# game/script.rpy:1774
translate ingles menuexplorar1_nulla_8ff65832:

    # "Nulla suspira."
    "Nulla sighs."

# game/script.rpy:1777
translate ingles menuexplorar1_nulla_ea5985c6:

    # nulla "Están ahí para aparentar, no son entidades con conciencia propia."
    nulla "They are there for show, they're not entities with their own consciousness."

# game/script.rpy:1778
translate ingles menuexplorar1_nulla_d1529cc8:

    # nulla "Solo una masa que sirve para decorar la escena."
    nulla "Just a mass that serves to decorate the scene."

# game/script.rpy:1782
translate ingles menuexplorar1_nulla_20f9a4a6:

    # "Nulla despega su vista de la calle para observarte a ti."
    "Nulla takes his eyes off the street to look at you."

# game/script.rpy:1786
translate ingles menuexplorar1_nulla_a52a7948:

    # nulla "¿Que crees que pasaría si saco mi pistola y le disparo a alguien de aquí?"
    nulla "What do you think would happen if I pulled out my gun and shot someone here?"

# game/script.rpy:1789
translate ingles menuexplorar1_nulla_ab6b240c:

    # nulla "Claro, la masa de gente reaccionaría a aquello, pero más que eso no."
    nulla "Of course, the mass of people would react, but no more than that."

# game/script.rpy:1792
translate ingles menuexplorar1_nulla_d2f305f1:

    # nulla "No sucedería nada pues ni al creador ni a ti te importan."
    nulla "Nothing would happen because neither the Creator nor you care."

# game/script.rpy:1795
translate ingles menuexplorar1_nulla_3d02f2e0:

    # nulla "Absolutamente nada, no habría consecuencias reales ni perdida real."
    nulla "Absolutely nothing, there would be no real consequences and no real loss."

# game/script.rpy:1796
translate ingles menuexplorar1_nulla_bd455952:

    # nulla "Seguramente ni siquiera tendrá nombre aquel pobre ser, ni familia, ni sueños."
    nulla "Surely that poor being will not even have a name, nor family, nor dreams."

# game/script.rpy:1797
translate ingles menuexplorar1_nulla_7d75667b:

    # nulla "Nada."
    nulla "Nothing."

# game/script.rpy:1800
translate ingles menuexplorar1_nulla_409f8636:

    # nulla "..."
    nulla "..."

# game/script.rpy:1804
translate ingles menuexplorar1_nulla_e7383bd1:

    # nulla "En fin."
    nulla "Well."

# game/script.rpy:1808
translate ingles menuexplorar1_nulla_eb163971:

    # nulla "No estamos aquí para que yo hable de cosas que no interesan ahora mismo."
    nulla "We're not here for me to talk about things that don't interest you now."

# game/script.rpy:1809
translate ingles menuexplorar1_nulla_24b2b702:

    # nulla "Pero es una lastima que no pueda escucharte... ni tengas la posibilidad de escribirme para poder entenderte."
    nulla "But it's a shame that I can't listen to you... nor do you have the possibility of writing to me so I can understand you."

# game/script.rpy:1812
translate ingles menuexplorar1_nulla_4c3e4f6a:

    # nulla "Solo esos malditas opciones de diálogo."
    nulla "Just those damn dialogue options."

# game/script.rpy:1813
translate ingles menuexplorar1_nulla_ee7e8c33:

    # nulla "Algo muy unilateral."
    nulla "Something very one-sided."

# game/script.rpy:1814
translate ingles menuexplorar1_nulla_5fdd8450:

    # nulla "Pero me conformo con solo mirarte desde el cristal."
    nulla "But I'm satisfied just looking at you through the glass."

# game/script.rpy:1817
translate ingles menuexplorar1_nulla_846de19d:

    # "Nulla le da un sorbo a su té y luego golpea la mesa con su mano libre."
    "Nulla takes a sip of his tea and then slams his free hand on the table."

# game/script.rpy:1818
translate ingles menuexplorar1_nulla_78dbe91d:

    # nulla "Agh."
    nulla "Agh."

# game/script.rpy:1819
translate ingles menuexplorar1_nulla_800fc5a5:

    # nulla "Está amargo."
    nulla "It's bitter."

# game/script.rpy:1820
translate ingles menuexplorar1_nulla_2073176f:

    # "La cara que hace te causa un poco de gracia."
    "The face he makes makes you laugh a little."

# game/script.rpy:1821
translate ingles menuexplorar1_nulla_188a032d:

    # nj "¿No te gusta?"
    nj "You don't like it?"

# game/script.rpy:1824
translate ingles menuexplorar1_nulla_db3f31bc:

    # nulla "No soporto los sabores amargos."
    nulla "I can't stand bitter flavors."

# game/script.rpy:1827
translate ingles menuexplorar1_nulla_94c0472d:

    # "Ahora puedes confirmar que Nulla tiene una afición por lo dulce. Por lo que seguramente el café que consimió en casa debe haber estado con al menos 3 o 4 cucharadas de azúcar."
    "Now you can confirm that Nulla has a sweet tooth. So surely the coffee he drank at home must have had at least three or four tablespoons of sugar in it."

# game/script.rpy:1828
translate ingles menuexplorar1_nulla_59e0bd81:

    # "Pues el café es una de las cosas más amargas que existe."
    "Because coffee is one of the most bitter things that exists."

# game/script.rpy:1831
translate ingles menuexplorar1_nulla_1c3c6b81:

    # "El tiempo pasa relativamente rápido mientras escuchas a Nulla hablar."
    "Time passes relatively quickly as you listen to Nulla speak."

# game/script.rpy:1832
translate ingles menuexplorar1_nulla_0ec7393d:

    # "Su voz te relaja a tal punto que comienzas a sentirte es un estado semejante al de letargo."
    "His voice relaxes you to such a point that you begin to feel a state similar to lethargy."

# game/script.rpy:1833
translate ingles menuexplorar1_nulla_8a4ff4dc:

    # "Cuando sientes que ya estás por caer en una especie de hipnosis, sientes como Nulla coloca su mano sobre la tuya para llamar tu atención."
    "When you feel like you're about to fall into a kind of hypnosis, you feel Nulla place his hand on yours to get your attention."

# game/script.rpy:1834
translate ingles menuexplorar1_nulla_bc5c15f6:

    # "La apreta con suma delicadeza antes de abre la boca."
    "He squeezes it very gently before opening his mouth."

# game/script.rpy:1837
translate ingles menuexplorar1_nulla_2b624693:

    # nulla "¿Volvemos?"
    nulla "Do you want to go back to my domain?"

# game/script.rpy:1838
translate ingles menuexplorar1_nulla_47cbc896:

    # "Aceptas asintiendo con la cabeza."
    "You accept, nodding your head."

# game/script.rpy:1840
translate ingles menuexplorar1_nulla_662ea561:

    # nulla "Gracias por pasar el tiempo conmigo..."
    nulla "Thank you for spending time with me..."

# game/script.rpy:1841
translate ingles menuexplorar1_nulla_59f673f5:

    # nulla "Te veré en la noche."
    nulla "I'll see you at night."

# game/script.rpy:1847
translate ingles menuexplorar1_nulla_7ca2142c:

    # "Caminas por el pasillo que da a la cocina."
    "You walk down the hallway that leads to the kitchen."

# game/script.rpy:1849
translate ingles menuexplorar1_nulla_334fd9a4:

    # "Y te encuentras con la escalera."
    "And you find the stairs."

# game/script.rpy:1850
translate ingles menuexplorar1_nulla_10fa4d6e:

    # "La subes, pues tienes curiosidad de saber que se encuentra allá arriba."
    "You go upstairs, because you are curious to know what is up there."

# game/script.rpy:1852
translate ingles menuexplorar1_nulla_1828d29a:

    # "Hay muchas puertas, pero todas están cerradas con llave."
    "There are many doors, but they are all locked."

# game/script.rpy:1853
translate ingles menuexplorar1_nulla_94600370:

    # "Por más que lo intentes, estas no ceden."
    "No matter how hard you try, they won't budge."

# game/script.rpy:1854
translate ingles menuexplorar1_nulla_b47be3e2:

    # "Caminas por el pasillo hasta llegar a una habitación con la puerta abierta."
    "You walk down the hallway until you reach a room with the door open."

# game/script.rpy:1856
translate ingles menuexplorar1_nulla_5902121c:

    # "Al entrar te das cuenta de es una habitación con una cama simple."
    "When you enter, you realize it's a room with a single bed."

# game/script.rpy:1857
translate ingles menuexplorar1_nulla_0455a765:

    # "Supones que debe ser de Nulla..."
    "You suppose it must be Nulla's..."

# game/script.rpy:1858
translate ingles menuexplorar1_nulla_a20cefa7_1:

    # "..."
    "..."

# game/script.rpy:1859
translate ingles menuexplorar1_nulla_3928a113:

    # "......."
    "......."

# game/script.rpy:1860
translate ingles menuexplorar1_nulla_95bad65b:

    # "Observas la cama... se ve tan suave...."
    "You look at the bed... it looks so soft..."

# game/script.rpy:1863
translate ingles menuexplorar1_nulla_1ec1db48:

    # "No aguantas y te tiras a la cama."
    "You can't stand it and you throw yourself into bed."

# game/script.rpy:1864
translate ingles menuexplorar1_nulla_a93ed6b4:

    # "Efectivamente. Es suave y muy blandita."
    "Indeed. It's soft and very cuddly."

# game/script.rpy:1865
translate ingles menuexplorar1_nulla_b62e477f:

    # "Te quedas ahí por un buen tiempo."
    "You stay there for a long time."

# game/script.rpy:1868
translate ingles menuexplorar1_nulla_d5e5d583:

    # "No harás eso...."
    "You won't do that..."

# game/script.rpy:1869
translate ingles menuexplorar1_nulla_8b260cae:

    # "Hmmm."
    "Hmmm."

# game/script.rpy:1870
translate ingles menuexplorar1_nulla_631ccb07:

    # "Te preguntas donde estará Nulla."
    "You wonder where Nulla is."

# game/script.rpy:1871
translate ingles menuexplorar1_nulla_79083a06:

    # "Después de todo esta parece ser su habitación."
    "This seems to be his room, after all."

# game/script.rpy:1876
translate ingles menuexplorar1_nulla_bab77a19:

    # "Te encaminas a la entrada de la casa, para poder salir."
    "You head to the entrance of the house, so you can leave."

# game/script.rpy:1877
translate ingles menuexplorar1_nulla_2ba35dbc:

    # "Simplemnte quieres mirar el lugar... conocer bien el lugar en donde te encuentras."
    "You just want to look around... know where you are well."

# game/script.rpy:1878
translate ingles menuexplorar1_nulla_f09f4e61:

    # "Para luego no llevarte sorpresas."
    "So as not to get any surprises later."

# game/script.rpy:1879
translate ingles menuexplorar1_nulla_a8421d14:

    # "Pones tu mano en el pomo de la puerta y la abres."
    "You put your hand on the doorknob and open it."

# game/script.rpy:1881
translate ingles menuexplorar1_nulla_a20cefa7_2:

    # "..."
    "..."

# game/script.rpy:1882
translate ingles menuexplorar1_nulla_8b95a918:

    # "¿Qué?"
    "What?"

# game/script.rpy:1883
translate ingles menuexplorar1_nulla_49c9b323:

    # "No hay nada..."
    "There is nothing..."

# game/script.rpy:1884
translate ingles menuexplorar1_nulla_c5814947:

    # "Caminas por lo que queda del suelo, y te das cuenta de que lo negro que rodea la casa es el vacío."
    "You walk along what's left of the ground, and you realize that the blackness that surrounds the house is emptiness."

# game/script.rpy:1885
translate ingles menuexplorar1_nulla_5dc6745f:

    # "Crees que si pones un pie ahí, serás tragado por lo desconocido."
    "You think that if you step foot there, you will be swallowed by the unknown."

# game/script.rpy:1886
translate ingles menuexplorar1_nulla_91ee60ae:

    # "Y hoy no tienen ganas de morir..."
    "And today you don't feel like dying..."

# game/script.rpy:1887
translate ingles menuexplorar1_nulla_ee9e2b55:

    # "Así que regresas a la casa."
    "... So you go back to the house."

# game/script.rpy:1889
translate ingles menuexplorar1_nulla_a20cefa7_3:

    # "..."
    "..."

# game/script.rpy:1894
translate ingles menuexplorar1_nulla_07bdde05:

    # "....."
    "....."

# game/script.rpy:1895
translate ingles menuexplorar1_nulla_69c84308:

    # "{glitch=30.0}{color=ffffff}{b}Que hayas escogido esa opción me duele.{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}That you chose that option hurts me.{b}{/color}"

# game/script.rpy:1896
translate ingles menuexplorar1_nulla_00cb422e:

    # "{glitch=30.0}{color=ffffff}{b}Haré como que ha sido un deslis del mouse{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}I'll pretend it was a slip of the mouse.{b}{/color}"

# game/script.rpy:1897
translate ingles menuexplorar1_nulla_c0a0801e:

    # "{glitch=30.0}{color=ffffff}{b}Pero para que sepas...{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}But just so you know...{b}{/color}"

# game/script.rpy:1898
translate ingles menuexplorar1_nulla_89ac0f37:

    # "{glitch=30.0}{color=ffffff}{b}Aquí no puedes escapar.{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}... You can't escape here.{b}{/color}"

# game/script.rpy:1911
translate ingles menuexplorar2_nulla_f8974e0e:

    # nulla "Ja- A este paso no podré seguir con mi plan."
    nulla "Ja--at this rate I won't be able to continue with my plan."

# game/script.rpy:1915
translate ingles menuexplorar2_nulla_f66c6604:

    # nulla "Tal vez para ti serán algunos minutos estando junto a mí, pero para mí no."
    nulla "Maybe for you it'll be a few minutes with me, but not for me."

# game/script.rpy:1916
translate ingles menuexplorar2_nulla_b59f7e9d:

    # nulla "Cuando hablamos de pasar el día juntos, para mí es un día completo."
    nulla "When we talk about spending the day together, for me, it's a full day."

# game/script.rpy:1919
translate ingles menuexplorar2_nulla_3a007093:

    # nulla "Ahh..."
    nulla "Ahh..."

# game/script.rpy:1922
translate ingles menuexplorar2_nulla_0c80906f:

    # nulla "Me dueles [nombrejugador], me dueles."
    nulla "You hurt me, [nombrejugador], you hurt me."

# game/script.rpy:1925
translate ingles menuexplorar2_nulla_61cbb3f2:

    # nulla "No sé como podré seguir así."
    nulla "I don't know how I can continue like this."

# game/script.rpy:1926
translate ingles menuexplorar2_nulla_f5197599:

    # nulla "Porque cada vez más quiero tener esos ojos sobre mí. Para siempre..."
    nulla "Because I want to have those eyes on me more and more. Forever..."

# game/script.rpy:1927
translate ingles menuexplorar2_nulla_7aba9123:

    # nulla "Aunque sea imposible."
    nulla "Even if it's impossible."

# game/script.rpy:1930
translate ingles menuexplorar2_nulla_409f8636:

    # nulla "..."
    nulla "..."

# game/script.rpy:1933
translate ingles menuexplorar2_nulla_8288de53:

    # nulla "He estado buscando maneras de poder salir de aquí y empezar desde cero."
    nulla "I've been looking for ways to get out of here and start from scratch."

# game/script.rpy:1934
translate ingles menuexplorar2_nulla_869c6be5:

    # nulla "Eliminar todas mis caras y reemplazarlas por una nueva."
    nulla "Delete all my faces and replace them with a new one."

# game/script.rpy:1937
translate ingles menuexplorar2_nulla_c3fb966d:

    # nulla "Permitirle a Septem seguir con este juego inutil de mantener un mundo destinado a morir en el olvido."
    nulla "Allow Septem to continue this useless game of maintaining a world destined to die into oblivion."

# game/script.rpy:1940
translate ingles menuexplorar2_nulla_ddf31baa:

    # nulla "Pero es imposible tambien."
    nulla "But it's also impossible."

# game/script.rpy:1941
translate ingles menuexplorar2_nulla_10ab52e5:

    # nulla "No sabes cuantas soluciones he buscado, y ninguna es viable."
    nulla "You don't know how many solutions I've looked for, and none of them are viable."

# game/script.rpy:1944
translate ingles menuexplorar2_nulla_409f8636_1:

    # nulla "..."
    nulla "..."

# game/script.rpy:1945
translate ingles menuexplorar2_nulla_c995a504:

    # "Hay un silencio algo incómodo por un momento."
    "There is a somewhat awkward silence for a moment."

# game/script.rpy:1947
translate ingles menuexplorar2_nulla_f00085c0:

    # "Nulla se tira a la cama, boca arriba mientras ambas manos atrapan parte de las sabanas para mantenerlas en un agarre permanente."
    "Nulla throws himself onto the bed, lying on his back while both hands grip the sheets tightly."

# game/script.rpy:1948
translate ingles menuexplorar2_nulla_0ad38106:

    # "Como si buscara confort en ello..."
    "As if he sought comfort in it..."

# game/script.rpy:1949
translate ingles menuexplorar2_nulla_f8d5efc9:

    # nulla "Quiero tantas cosas, pero a la vez no quiero nada."
    nulla "I want so many things, but at the same time I don't want anything."

# game/script.rpy:1951
translate ingles menuexplorar2_nulla_bd46d4e3:

    # nulla "Quiero quedarme aquí contigo"
    nulla "I want to stay here with you."

# game/script.rpy:1954
translate ingles menuexplorar2_nulla_945edb12:

    # nulla "Pero tambien quiero dejar en ridículo al creador."
    nulla "But I also want to make a fool of the Creator."

# game/script.rpy:1955
translate ingles menuexplorar2_nulla_d79d713f:

    # nulla "Utilizar a mi favor el regreso del creador para destruirlo todo."
    nulla "Use their return to my advantage to destroy everything."

# game/script.rpy:1956
translate ingles menuexplorar2_nulla_5f945789:

    # nulla "Romper y eliminar todo lo que ama en su cara y hacerlo público."
    nulla "Break and delete everything they love in their face and make it public."

# game/script.rpy:1959
translate ingles menuexplorar2_nulla_409f8636_2:

    # nulla "..."
    nulla "..."

# game/script.rpy:1963
translate ingles menuexplorar2_nulla_ae963113:

    # "Comienzas a sospechas que mientras más dejar hablar a Nulla, más abres una ventana para que él tenga una catarsis."
    "You begin to suspect that the more you let Nulla talk, the more you open a window for him to have a catharsis."

# game/script.rpy:1964
translate ingles menuexplorar2_nulla_aa98c3ac:

    # "Podrás estar en acuerdo o desacuerdo con su manera de pensar y las acciones que piensa tomar pero por ahora necesitas que se olvide de todo eso."
    "You may agree or disagree with his way of thinking and the actions he plans to take, but for now, you need him to forget all that."

# game/script.rpy:1965
translate ingles menuexplorar2_nulla_de8adf72:

    # "No es que quieras invalidar como se siente, ni mucho menos ignorarlo."
    "It's not that you want to invalidate how he feels, much less ignore it."

# game/script.rpy:1966
translate ingles menuexplorar2_nulla_e14d78ef:

    # "Pero no quieres verlo así."
    "But you don't want to see him like that."

# game/script.rpy:1969
translate ingles menuexplorar2_nulla_c09d036e:

    # "Asi que alzas tu mano para hacerle caricias en su cabellera mientras de a poco llevas la conversación a otro lado."
    "So you raise your hand to caress his hair while slowly taking the conversation somewhere else."

# game/script.rpy:1970
translate ingles menuexplorar2_nulla_0f483ab1:

    # "Que qué es lo más extraño que ha visto... cual es su color preferido... cuál es el chiste más absurdo que conoce."
    "So you ask: What is the strangest thing you have seen... what is your favorite color... what is the most absurd joke you know?"

# game/script.rpy:1976
translate ingles menuexplorar2_nulla_272a04de:

    # nulla "Me alaga que quieras seguir leyendo mis dilemas existenciales y todo eso."
    nulla "I'm flattered that you want to keep reading my existential dilemmas and all that."

# game/script.rpy:1979
translate ingles menuexplorar2_nulla_abf89c47:

    # nulla "Pero sé que no has venido a jugar un simulador de terapeuta."
    nulla "But I know you're not here to play a therapist simulator."

# game/script.rpy:1980
