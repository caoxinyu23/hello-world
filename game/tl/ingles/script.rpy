    # "Esa no es la voz de Nulla."
    "That's not Nulla's voice."

# game/script.rpy:3157
translate ingles badend_rutanulla_5f5ad07e:

    # "Miras rapidamente arriba para ver de quien se trata."
    "You quickly look up to see who it is."

# game/script.rpy:3159
translate ingles badend_rutanulla_21ffe4c2:

    # "Hay una mujer que está parada detrás tuyo, mirando con disgusto tu figura."
    "There is a woman standing behind you, looking with disgust at your figure."

# game/script.rpy:3161
translate ingles badend_rutanulla_a24f74d3:

    # "Y eso es lo último que tus ojos ven antes de que te rompan en pecho"
    "And that's the last thing your eyes see before the woman breaks your chest."

