translate ingles rutaunum_50cc6b6f:

    # septem "{sc=2}Wow, no creí que el regalo saldría en una sola pieza. Te felici---{/sc}"
    septem "{sc=2}Wow, I didn't think the gift would come out in one piece. Congrat--{/sc}"

# game/script.rpy:1026
translate ingles rutaunum_56c75a7b:

    # "Septem es interrumpido por Unum, quien se abalanza contra ti."
    "Septem is interrupted by Unum, who lunges at you."

# game/script.rpy:1028
translate ingles rutaunum_e8a89d1a:

    # "Si no fuera por la rapidez con que Unum te ha alcanzado, de seguro te habrías movido para evitarlo. Pero como tus reflejos son lentos comparado con Unum, te quedas como una piedra."
    "If it weren't for Unum's speed, you surely would've moved to avoid him. But since your reflexes are slower in comparison, you remain still as stone."

# game/script.rpy:1029
translate ingles rutaunum_8f01e4a6:

    # "Los brazos de Unum te envuelven y te quitan el aire de lo fuerte que te está apretando."
    "Unum's arms wrap around you, taking your breath away with how tightly he's squeezing you."

# game/script.rpy:1030
translate ingles rutaunum_d3ccb2cd:

    # septem "{sc=4}Qué mier-{/sc}"
    septem "{sc=4}What the--{/sc}"

# game/script.rpy:1031
translate ingles rutaunum_e907cff5:

    # "Repentinamente dejas de escuchar la voz de Septem y el sonido ambiental del comedor."
    "Suddenly, you stop hearing Septem's voice and the ambient noise of the dining room."

# game/script.rpy:1033
translate ingles rutaunum_a20cefa7_5:

    # "..."
    "..."

# game/script.rpy:1035
translate ingles rutaunum_ddfcac48:

    # "La sensación de unas manos acariciándote la cara, te invitan a dejar tu subconciente."
    "The sensation of hands stroking your face invites you to let go of your subconscious."

# game/script.rpy:1037
translate ingles rutaunum_c18fa391:

    # "Abres los ojos, pero la luz del lugar te lo impiden. Son molestas."
    "You try to open your eyes, but the light of the place is preventing you. It's bothersome."

# game/script.rpy:1039
translate ingles rutaunum_47806f74:

    # "... No sabes cuanto tiempo has estado inconciente."
    "... You don't know how long you've been unconscious."

# game/script.rpy:1040
translate ingles rutaunum_8eb8ef34:

    # "Sientes como las mismas manos te dan palmaditas en las mejillas, cada vez más fuertes con el pasar de los segundos."
    "You feel the same hands giving you gentle pats on the cheeks, each one getting rougher as the seconds pass."

# game/script.rpy:1042
translate ingles rutaunum_b3e6701c:

    # "Una lo suficientemente fuerte como para doler te hace gritar."
    "One strong enough to hurt makes you scream."

# game/script.rpy:1044
translate ingles rutaunum_09479f2c:

    # "Abres los ojos de golpe y lo primero que vez es a Unum con su risa estúpida."
    "You open your eyes abruptly, and the first thing you see is Unum with his stupid grin."

# game/script.rpy:1045
translate ingles rutaunum_ae03aafb:

    # nj "¡QUE PARES YA!"
    nj "STOP IT ALREADY!"

# game/script.rpy:1047
translate ingles rutaunum_6d2b2ea9:

    # "Gritas con tanto enojo que Unum para en seco y te mira con los ojos bien abiertos."
    "You scream with so much anger that Unum stops abruptly and looks at you with wide eyes."

# game/script.rpy:1049
translate ingles rutaunum_fa787e95:

    # unum "JAJAJAAJAJAJAJAJAJA- Tienes receptores de dolor"
    unum "HAHAHAAHAHAHAHAHAHA--you have pain receptors."

# game/script.rpy:1050
translate ingles rutaunum_b28ffe45:

    # unum "Excelente, parece ser que el olor que emanas está en lo correcto."
    unum "Excellent, it seems the smell you emit is correct."

# game/script.rpy:1051
translate ingles rutaunum_fa18006c:

    # unum "Perteneces a la raza humana."
    unum "You belong to the human race."

# game/script.rpy:1053
translate ingles rutaunum_2336ede8:

    # "La expresión de Umun demuestra lo exaltado que está, cosa que no te agrada mucho pues sabes por experiencia propia que eso no lleva a nada bueno."
    "Unum's expression shows how excited he is, which doesn't sit well with you since you know from experience that it doesn't lead to anything good."

# game/script.rpy:1054
translate ingles rutaunum_c19d12ec:

    # "Decides que es mejor no hacer que se exalte más de lo necesario, por lo que le ignoras para poder observar tu alrededor."
    "You decide it's better not to let him get more excited than necessary, so you ignore him to observe your surroundings."

# game/script.rpy:1055
translate ingles rutaunum_c7c0ea00:

    # "Te encuentras en una cama lo suficientemente amplia como para dos personas, en una habitación, que siendo sinceros, podría ser la de un rey."
    "You find yourself in a bed spacious enough for two people, in a room that, to be honest, could belong to a king."

# game/script.rpy:1056
translate ingles rutaunum_c1161107:

    # "Está tan imnaculado el lugar que no se ve real."
    "The place is so immaculate that it doesn't seem real."

# game/script.rpy:1058
translate ingles rutaunum_5c4387ae:

    # unum "¿Te gusta?"
    unum "You like it?"

# game/script.rpy:1059
translate ingles rutaunum_593611fd:

    # unum "Esta será tu propia habitación."
    unum "This will be your own room."

# game/script.rpy:1061
translate ingles rutaunum_bdfd29e4:

    # unum "Lo estuve pensando, y supongo que sería imposible dejarte en la residencia de mis esposas."
    unum "I was thinking about it, and I suppose it would be impossible to leave you in the residence of my wives."

# game/script.rpy:1062
translate ingles rutaunum_350a4c93:

    # unum "Te devorarían nada más pisar el lugar."
    unum "They would devour you as soon as you stepped foot in the place."

# game/script.rpy:1063
translate ingles rutaunum_a94cace7:

    # "¿Esposas? No solo una ¿¿¿¿¿sino que más????"
    "Wives? Not just one, but more????"

# game/script.rpy:1064
translate ingles rutaunum_3e6096f2:

    # "No puedes evitar sentir pena por las pobres mujeres que tienen de pareja a este niñato."
    "You can't help but feel pity for the poor women who have this brat as their partner."

# game/script.rpy:1065
translate ingles rutaunum_6efebb5b:

    # "Sientes que seguramente no les dedica el tiempo necesario a cada una de ellas."
    "You feel that he probably doesn't dedicate enough time to each of them."

# game/script.rpy:1066
translate ingles rutaunum_4094f22a:

    # unum "...Hablé con Septem, y Nulla le ha dicho que Madre hará otro regalo para que los demás puedan tener su parte."
    unum "... I spoke with Septem, and Nulla told him that Mother will make another gift so that everyone can have their share."

# game/script.rpy:1067
translate ingles rutaunum_cab5ce80:

    # unum "Eso significa que eres de mi propiedad ahora..."
    unum "That means you are my property now..."

# game/script.rpy:1069
translate ingles rutaunum_2645fcde:

    # unum "¡Primera vez que tengo a un humano vivo en mi dominio!"
    unum "This is the first time I have a living human in my domain!"

# game/script.rpy:1072
translate ingles rutaunum_c0a3e0b2:

    # nj "¿Por qué no pueden haber humanos vivos en tu dominio?"
    nj "Why can't there be living humans in your domain?"

# game/script.rpy:1074
translate ingles rutaunum_4444fef7:

    # "Unum analiza tu cara por un momento antes de contestar, como si meditara el tipo de información que te revelará."
    "Unum analyzes your face for a moment before answering, as if contemplating what kind of information he will reveal to you."

# game/script.rpy:1076
translate ingles rutaunum_395874eb:

    # unum "Nulla y Madre dicen que solamente pueden haber humanos para nuestro consumo."
    unum "Nulla and Mother say that there can only be humans for our consumption."

# game/script.rpy:1077
translate ingles rutaunum_f4ad71cd:

    # unum "Nulla se excusa con que no nos puede facilitar ninguno pues solamente podemos tener 6 humanos cada mes..."
    unum "Nulla excuses himself by saying he can't provide any since we can only have six humans each month..."

# game/script.rpy:1078
translate ingles rutaunum_769e15f0:

    # unum "No más que eso."
    unum "No more than that."

# game/script.rpy:1079
translate ingles rutaunum_c082b2b6:

    # unum "Por eso Madre hace un regalo cada domingo... como placebo, ya que la carne humana es vital para nuestra forma física pero muy adictiva."
    unum "That's why Mother makes a gift every Sunday... as a placebo, since human flesh is vital for our physical form but very addictive."

# game/script.rpy:1080
translate ingles rutaunum_af08df17:

    # "Tú eres el placebo."
    "You are the placebo."

# game/script.rpy:1082
translate ingles rutaunum_1002a256:

    # unum "Aunque es la primera vez que un regalo huele como un humano real."
    unum "Although it's the first time a gift smells like a real human."

# game/script.rpy:1086
translate ingles rutaunum_7d4dc94c:

    # nj "¿Quién es Madre?"
    nj "Who is Mother?"

# game/script.rpy:1088
translate ingles rutaunum_8ada403b:

    # unum "Ja... realmente madre no te ha hecho como a los demás."
    unum "Ha... Mother really hasn't made you like the others."

# game/script.rpy:1090
translate ingles rutaunum_315ba4ac:

    # unum "Hmmmmmm"
    unum "Hmmmmmm."

# game/script.rpy:1091
translate ingles rutaunum_a8dd5307:

    # "Unum medita antes de contestar"
    "Unum ponders before answering."

# game/script.rpy:1093
translate ingles rutaunum_7dcec3fb:

    # unum "Madre es la representación del jardín mismo, todo esto es Madre."
    unum "Mother is the embodiment of the Garden itself; all of this is Mother."

# game/script.rpy:1094
translate ingles rutaunum_cb6a9675:

    # unum "Madre cuida de nosotros y nosotros la mantenemos a con vida."
    unum "Mother takes care of us, and we keep her alive."

# game/script.rpy:1095
translate ingles rutaunum_0dc0ab0e:

    # "Supones que ahora entiendes algo más... es como una relación de mutualismo, ambas partes se benefician."
    "You suppose you now understand a bit more... it's like a mutualistic relationship, both parties benefit."

# game/script.rpy:1100
translate ingles rutaunum_71ae9ec0:

    # "Decides no preguntar nada más."
    "You decide not to ask anything else."
# game/script.rpy:1103
translate ingles rutaunum_7d4dc94c_1:

    # nj "¿Quién es Madre?"
    nj "Who is Mother?"

# game/script.rpy:1105
translate ingles rutaunum_4aec5633:

    # unum "Realmente Madre no te ha hecho como a los demás."
    unum "Ha... Mother really hasn't made you like the others."

# game/script.rpy:1107
translate ingles rutaunum_360934ba:

    # unum "Hmmmm"
    unum "Hmmmm."

# game/script.rpy:1108
translate ingles rutaunum_a8dd5307_1:

    # "Unum medita antes de contestar"
    "Unum ponders before answering."

# game/script.rpy:1110
translate ingles rutaunum_7dcec3fb_1:

    # unum "Madre es la representación del jardín mismo, todo esto es Madre."
    unum "Mother is the embodiment of the Garden itself; all of this is Mother."

# game/script.rpy:1111
translate ingles rutaunum_cb6a9675_1:

    # unum "Madre cuida de nosotros y nosotros la mantenemos a con vida."
    unum "Mother takes care of us, and we keep her alive."

# game/script.rpy:1112
translate ingles rutaunum_0dc0ab0e_1:

    # "Supones que ahora entiendes algo más... es como una relación de mutualismo, ambas partes se benefician."
    "You suppose you now understand a bit more... it's like a mutualistic relationship, both parties benefit."

# game/script.rpy:1116
translate ingles rutaunum_c0a3e0b2_1:

    # nj "¿Por qué no pueden haber humanos vivos en tu dominio?"
    nj "Why can't there be living humans in your domain?"

# game/script.rpy:1118
translate ingles rutaunum_4444fef7_1:

    # "Unum analiza tu cara por un momento antes de contestar, como si meditara el tipo de información que te revelará."
    "Unum analyzes your face for a moment before answering, as if contemplating what kind of information he will reveal to you."

# game/script.rpy:1120
translate ingles rutaunum_395874eb_1:

    # unum "Nulla y Madre dicen que solamente pueden haber humanos para nuestro consumo."
    unum "Nulla and Mother say that there can only be humans for our consumption."

# game/script.rpy:1121
translate ingles rutaunum_f4ad71cd_1:

    # unum "Nulla se excusa con que no nos puede facilitar ninguno pues solamente podemos tener 6 humanos cada mes..."
    unum "Nulla excuses himself by saying he can't provide any since we can only have six humans each month..."

# game/script.rpy:1122
translate ingles rutaunum_769e15f0_1:

    # unum "No más que eso."
    unum "No more than that."

# game/script.rpy:1123
translate ingles rutaunum_c082b2b6_1:

    # unum "Por eso Madre hace un regalo cada domingo... como placebo, ya que la carne humana es vital para nuestra forma física pero muy adictiva."
    unum "That's why Mother makes a gift every Sunday... as a placebo, since human flesh is vital for our physical form but very addictive."

# game/script.rpy:1124
translate ingles rutaunum_af08df17_1:

    # "Tú eres el placebo."
    "You are the placebo."

# game/script.rpy:1126
translate ingles rutaunum_5eee9d4c:

    # unum "Aunque es la primera vez que un regalo huele como un humano."
    unum "Although it's the first time a gift smells like a real human."

# game/script.rpy:1129
translate ingles rutaunum_71ae9ec0_1:

    # "Decides no preguntar nada más."
    "You decide not to ask anything else."

# game/script.rpy:1132
translate ingles rutaunum_99d48302:

    # "Decides no preguntar nada."
    "You decide not to ask anything."

# game/script.rpy:1135
translate ingles rutaunum_1ccdcd16:

    # unum "Bien, debes tener hambre. Leí por ahí que los humanos tienen horarios para comer, y que comen más de una vez al día."
    unum "Well, you must be hungry. I read somewhere that humans have meal times and eat more than once a day."

# game/script.rpy:1137
translate ingles rutaunum_0fd67f2a:

    # unum "Aunque Septem tambien lo hace todo el tiempo. Las veces que he estado en su dominio, él se sienta en la mesa en las mañanas, tardes y noches a comer."
    unum "Although, Septem also does it all the time. The times I was in his domain, he sat at the table in the mornings, afternoons, and nights to eat."

# game/script.rpy:1138
translate ingles rutaunum_6bb9206c:

    # unum "Le he preguntado porqué lo hace, pero siempre me dice que no me concierne."
    unum "I've asked him why he does it, but he always tells me it's none of my business."

# game/script.rpy:1139
translate ingles rutaunum_0ba85782:

    # unum "Nulla tambien lo hace a veces... tal vez esa sea la razón por la que son tan fuertes los dos..."
    unum "Nulla does it sometimes, too... maybe that's why both of them are so strong..."

# game/script.rpy:1141
translate ingles rutaunum_8bf45962:

    # unum "No lo necesito... pero puede que hasta yo lo intente ahora que estás aquí conmigo."
    unum "I don't need it... but maybe I'll even try it now that you're here with me."

# game/script.rpy:1143
translate ingles rutaunum_8b001930:

    # "Por alguna razón, se te hace algo tierno que te hable con tanta libertad, como a un viejo amigo... y el hecho de que haya estado leyendo información acerca de los humanos, te hace pensar... Quizás cuanto tiempo haya estado planeando tener uno..."
    "For some reason, it feels kind of endearing that he talks to you so freely, like an old friend... and the fact that he's been reading information about humans makes you wonder... how long he has been planning to have one..."

# game/script.rpy:1144
translate ingles rutaunum_d9be25c0:

    # "Te hace sentir como una mascota a la cual su dueño le habla luego de llegar a casa del trabajo."
    "It makes you feel like a pet that its owner talks to after getting home from work."

# game/script.rpy:1146
translate ingles rutaunum_fbf5efdc:

    # unum "Camina detrás de mí y no te separes, mis esposas les gusta venir a mi residencia para relajarse."
    unum "Walk behind me and don't get separated, my wives like to come to my residence to relax."

# game/script.rpy:1147
translate ingles rutaunum_cb2953fd:

    # "Escapar parece no ser opción por ahora... no quieres morir en el intento."
    "Escape seems not to be an option for now... you don't want to die trying."

# game/script.rpy:1148
translate ingles rutaunum_665e4126:

    # "Él se aleja de la cama en que estás y te espera en la puerta. Tú te levantas y así comienzas a seguir a Unum por los pasillos, caminas tan cerca de Unum que casi le pisas los talones."
    "He leaves the bed you're in and waits for you at the door. You get up and begin to follow Unum through the hallways. You walk so close to him that you're almost tripping on his heels."

# game/script.rpy:1150
translate ingles rutaunum_02bab982:

    # "Tardan en llegar al lugar deseado, siempre bajo un silencio que no es ni cómodo o incómodo."
    "You're slow to reach the desired place under a silence that is neither comfortable nor uncomfortable."

# game/script.rpy:1153
translate ingles rutaunum_074ab2c3:

    # unum "Cocina algo para dos. Puedes usar lo que gustes todo lo de aquí es comestible."
    unum "Cook something for two. You can use whatever you like, everything here is edible."

# game/script.rpy:1156
translate ingles rutaunum_9cb1f09c:

    # unum "Yo no sé cocinar."
    unum "I don't know how to cook."

# game/script.rpy:1159
translate ingles rutaunum_bbd113db:

    # unum "Te esperaré en el comedor."
    unum "I'll wait for you in the dining room."

# game/script.rpy:1161
translate ingles rutaunum_444c5027:

    # "Sin decir más, Unum desaparece de la cocina y te deja a solas."
    "Without another word, Unum disappears from the kitchen and leaves you alone."

# game/script.rpy:1162
translate ingles rutaunum_97982fa4:

    # "Miras tu alrededor mientras inspeccionas cada rincón del lugar, hay encimeras, despensas con alimentos y un refrigerador lleno de carne, frutas y verduras."
    "You look around as you inspect every corner of the place. There are cupboards, pantries filled with food, and a refrigerator full of meat, fruits, and vegetables."

# game/script.rpy:1163
translate ingles rutaunum_24890263:

    # "Te preguntas por qué tienen tanta comida si Unum ha dicho que no la necesita."
    "You wonder why there's so much food if Unum said he doesn't need it."

# game/script.rpy:1169
translate ingles rutaunum_a00a6cf1:

    # "Con algo de verguenza vas en dirección a la puerta por donde Unum se ha esfumado."
    "With some shame, you move towards the door Unum disappeared through."

# game/script.rpy:1171
translate ingles rutaunum_5efcff60:

    # "Te asomas con cuidado, buscándolo con la mirada."
    "You search carefully with your eyes."

# game/script.rpy:1172
translate ingles rutaunum_49ec680e:

    # "No hay nadie..."
    "There's no one..."

# game/script.rpy:1173
translate ingles rutaunum_e66608d5:

    # unum "¿Qué pasa?"
    unum "What's happening?"

# game/script.rpy:1176
translate ingles rutaunum_143cd781:

    # "Pregunta Unum apareciendo detrás tuyo. Tú saltas del susto que te ha causado pero te recompones rápido."
    "Unum asks, appearing behind you. You jump from the fright he caused you, but you compose yourself quickly."

# game/script.rpy:1177
translate ingles rutaunum_25c0ceb7:

    # nj "¿Hay algo en especial que quieras comer?"
    nj "Is there anything in particular you want to eat?"

# game/script.rpy:1180
translate ingles rutaunum_936f7eee:

    # "Unum te mira abatido, cómo si se esperara cualquier pregunta menos la que acaba de salir de tu boca."
    "Unum looks at you as if he expected any question except the one that just came out of your mouth."

# game/script.rpy:1181
translate ingles rutaunum_e43ef3ff:

    # unum "Ah..."
    unum "Ah..."

# game/script.rpy:1184
translate ingles rutaunum_36bd4cd9:

    # unum "Hmmmmm."
    unum "Hmmmmm."

# game/script.rpy:1185
translate ingles rutaunum_54270ebd:

    # unum "Nulla come unas cosas que son blanditas y esponjosas con un liquido color oro que le derrama encima."
    unum "Nulla eats some things that are soft and spongy with a gold-colored liquid spilled on them."

# game/script.rpy:1186
translate ingles rutaunum_ac8fcbe5:

    # unum "...Me gustaría probarlos"
    unum "... I would like to try them."

# game/script.rpy:1188
translate ingles rutaunum_b0519631:

    # "Se oye algo avergonzado de decirlo..."
    "He sounds a little embarrassed to say it..."

# game/script.rpy:1189
translate ingles rutaunum_3482890b:

    # "Okay, crees saber a lo que se refierte. Claramente son panqueques por la descripción dada."
    "Okay, you think you know what he's referring to. They're clearly pancakes from the description given."

# game/script.rpy:1192
translate ingles rutaunum_98adccd3:

    # "Comienzas a preparar los panqueques bajo la mirada curiosa de Unum, que mira con fascinación como haces la preparación. De vez en cuando te da la sensación de que tal vez quiere ayudar, pero decides ignorarlo."
    "You begin to prepare the pancakes under the curious gaze of Unum, who watches with fascination as you do the preparation. From time to time you get the feeling that maybe he wants to help, but you decide to ignore him."

# game/script.rpy:1195
translate ingles rutaunum_0a4f8b68:

    # "Revuelves la cocina en busca de ingredientes para cocinar algo simple."
    "You rummage through the kitchen, looking for ingredients to cook something simple."

# game/script.rpy:1196
translate ingles rutaunum_b6949083:

    # "Algo para saciar el hambre solamente."
    "Something to satisfy hunger."

# game/script.rpy:1197
translate ingles rutaunum_192de808:

    # "No tardas mucho en terminar."
    "It doesn't take long to finish."

# game/script.rpy:1200
translate ingles rutaunum_e176e665:

    # "Llevas los platos a la mesa y te das cuenta de que, a diferencia del resto del lugar, la mesa es pequeña y simple, donde solo caben 2 personas."
    "You take the plates to the table and realize that, unlike the rest of the place, the table is small and simple, where only two people can fit."

# game/script.rpy:1202
translate ingles rutaunum_591775a7:

    # "Te sientas una vez Unum ya tiene su plato al frente. Él no te espera para comenzar a comer, optando por tragar la comida nada más estar puesta en la mesa."
    "You sit down once Unum places the plate in front of you. He doesn't wait to start eating, opting to swallow the food as soon as it's put on the table."

# game/script.rpy:1203
translate ingles rutaunum_08247244:

    # "Lo devora todo muy rápido, impidiendo ver si le ha gustado o no, pues su expresión no refleja nada más que neutralidad... cómo si el sabor o la comida en sí no le interesara."
    "He devours everything very quickly, making it impossible to tell if he liked it or not, because his expression reflects nothing more than neutrality... as if the flavor or the food itself didn't interest him."

# game/script.rpy:1206
translate ingles rutaunum_af22e670:

    # unum "Gracias por la comida."
    unum "Thanks for the meal."

# game/script.rpy:1207
translate ingles rutaunum_f4328fe9:

    # "Es tu única respuesta.... dios, de verdad te habías esforzado."
    "And that's the only feedback you get... God, you really tried hard."

# game/script.rpy:1210
translate ingles rutaunum_6266d9f8:

    # "Suspirando, te resignas a comer tu plato. Cierras los ojos al llevarte el primer bocado a la boca."
    "Sighing, you resign yourself to eating what's on your plate. You close your eyes as you put the first bite into your mouth."

# game/script.rpy:1211
translate ingles rutaunum_59c55cae:

    # "Está rico."
    "It's delicious."

# game/script.rpy:1212
translate ingles rutaunum_172d98af:

    # "Comes lento y sin prisa. Bocado tras bocado, tomas pausas para respirar."
    "You eat slowly and without rushing. Bite after bite, you take pauses to breathe."

# game/script.rpy:1213
translate ingles rutaunum_8f730cd0:

    # "Pero algo no te deja en paz. La sensación de que te están observando te revuelve el estómago."
    "But something's nagging at you: The feeling of being watched makes your stomach turn."

# game/script.rpy:1215
translate ingles rutaunum_9288a38f:

    # "Tus ojos viajan por si solos al frente, donde Unum está sentado y confirmas tu sospecha, él te está mirando."
    "Your eyes travel to where Unum is sitting and you confirm your suspicion: He's looking at you."

# game/script.rpy:1217
translate ingles rutaunum_e3b33932:

    # unum "Es facinante..."
    unum "Fascinating..."

# game/script.rpy:1218
translate ingles rutaunum_cbdf70c2:

    # unum "Tu cuerpo cambia en todo momento, nunca está igual."
    unum "Your body changes all the time, it's never the same."
# game/script.rpy:1219
translate ingles rutaunum_ee36108c:

    # unum "Desde la respiración hasta el latido de tu corazón."
    unum "From your breathing to your heartbeat."

# game/script.rpy:1220
translate ingles rutaunum_8fa1b3dc:

    # "No te gusta para nada como te está mirando ni el tono de su voz."
    "You don't like the way he's looking at you or the tone of his voice at all."

# game/script.rpy:1221
translate ingles rutaunum_63982f5c:

    # nj "¿Que quieres decir?"
    nj "What do you mean?"

# game/script.rpy:1222
translate ingles rutaunum_3485d1f7:

    # unum "Quiero saber más..."
    unum "I want to know more..."

# game/script.rpy:1223
translate ingles rutaunum_9e68d588:

    # unum "Ahh--"
    unum "Ahh--"

# game/script.rpy:1225
translate ingles rutaunum_dc5d5cbe:

    # "Se escucha un estruendo, de sillas siendo tiradas al suelo."
    "You hear a crash of chairs being thrown to the floor."

# game/script.rpy:1227
translate ingles rutaunum_1e6437e9:

    # "No eres capaz de procesar lo que está pasando hasta que tu espalda impacta contra la pared y a Unum tomándote del cuello de tu ropa."
    "You're not able to process what's happening until your back hits the wall and Unum grabs you by the collar of your clothes."

# game/script.rpy:1228
translate ingles rutaunum_fd095234:

    # unum "NO SABES CUANTO TIEMPO HE ESPERADO PARA TENER ESTA OPORTUNIDAD."
    unum "YOU DON'T KNOW HOW LONG I HAVE WAITED FOR THIS OPPORTUNITY."

# game/script.rpy:1229
translate ingles rutaunum_5bb2ddf6:

    # unum "SI ATRAVIESO TU PECHO Y TE SACO ALGUNO DE TUS ORGANOS QUE NO SEA EL CORAZÓN O EL CEREBRO---"
    unum "IF I BREAK YOUR CHEST AND REMOVE ANY ORGAN OTHER THAN THE HEART OR THE BRAIN--"

# game/script.rpy:1230
translate ingles rutaunum_4a7d2f18:

    # unum "¿CÚANTO TARDARÁ TU CUERPO EN APAGARSE?"
    unum "HOW LONG WILL IT TAKE FOR YOUR BODY TO SHUT DOWN?"

# game/script.rpy:1231
translate ingles rutaunum_f13bbd2d:

    # unum "Y SI~ TE QUITO LA LENGUA ¿PODRÁS SEGUIR COMIENDO O SIQUIERA HABLAR?"
    unum "AND IF~ I REMOVE YOUR TONGUE, WILL YOU BE ABLE TO KEEP EATING OR EVEN SPEAK?"

# game/script.rpy:1232
translate ingles rutaunum_e3f31ecd:

    # unum "¿HMM?"
    unum "HMM?"

# game/script.rpy:1233
translate ingles rutaunum_c855b166:

    # unum "¿QUÉ NIVEL DE DAÑO TIENE QUE TENER TU CUERPO COMO PARA NO PODER REGENERARSE? ¿CÚAL ES EL LÍMITE?"
    unum "WHAT LEVEL OF DAMAGE DOES YOUR BODY HAVE TO HAVE IN ORDER TO NOT BE ABLE TO REGENERATE ITSELF? WHAT IS THE LIMIT?"

# game/script.rpy:1234
translate ingles rutaunum_20c889ac:

    # unum "¿HHMMM?"
    unum "HHMMM?"

# game/script.rpy:1235
translate ingles rutaunum_12608b9f:

    # "Tienes que hacer algo antes de que este loco te despedace."
    "You have to do something before this crazy man tears you apart."

# game/script.rpy:1238
translate ingles rutaunum_8e7c5f69:

    # "Te rehusas a dejarte matar."
    "You refuse to be killed."

# game/script.rpy:1239
translate ingles rutaunum_ea26c3c8:

    # "Y con lagrimas que peligran por salir de tus ojos, tus piernas comienzan a tirar patadas y tus brazos intentan alejar a Unum. Algunos golpes hacen contacto con el cuerpo del pelirrojo, pero él no se ve afectado con ello."
    "And with tears that threaten to leave your eyes, your legs begin to kick and your arms try to push Unum away. Some attempts make contact with the redhead's body, but he doesn't seem affected by them."

# game/script.rpy:1240
translate ingles rutaunum_80368e06:

    # "Como si no doliera en absoluto."
    "Like it didn't hurt at all."

# game/script.rpy:1242
translate ingles rutaunum_ad58483d:

    # "Uno de tus brazos apunta directo a su cara, pero Unum lo detiene sin dificultad alguna."
    "One of your arms aims directly at his face, but Unum stops it effortlessly."

# game/script.rpy:1245
translate ingles rutaunum_3daacea8:

    # "Intentas hablar para hacerlo entrar en razón.... le dices que hay más cosas interesantes que puede hacer un humano estando vivo."
    "You try to talk some sense into him... you tell him there are more interesting things a human can do while alive."

# game/script.rpy:1246
translate ingles rutaunum_a718aeba:

    # "Le dices tantas cosas de manera erratica que ni siquiera procesas que tipo de información o datos del cuerpo humano le estás soltando."
    "You tell him so many things erratically that you don't even process what type of information or data about the human body you are telling him."

# game/script.rpy:1247
translate ingles rutaunum_88ff8b12:

    # "Pero parece funcionar, pues Unum solo le mira con atención... ya no tiene esa expresión exaltada de antes."
    "But it seems to work, because Unum just looks at you attentively... he no longer has that exalted expression from before."

# game/script.rpy:1248
translate ingles rutaunum_6109b031:

    # "Sin previo aviso, Unum toma tu brazo con una extraña delicadeza"
    "Without warning, Unum takes your arm with an unusual sense of delicacy."

# game/script.rpy:1254
translate ingles rutaunum_eccd3a4c:

    # "Unum te mira completamente serio mientras tú te retuerces en su agarre por el extraño cambio de ambiente que hay."
    "Unum looks at you, completely serious as you squirm under his grip due to the strange shift in mood."

# game/script.rpy:1255
translate ingles rutaunum_4f7f8e0d:

    # "Su boca está peligrosamente cerca de tu brazo, tanto que puedes sentir el calor de sus labios rozar tu piel."
    "His mouth is dangerously close to your arm, so close that you can feel the heat of his lips brush against your skin."

# game/script.rpy:1256
translate ingles rutaunum_7d06c229:

    # "Te preparas mentalmente para que te arranque la extremidar con sus propios dientes.."
    "Unable to run or advance any further, you can only expect the worst."

# game/script.rpy:1258
translate ingles rutaunum_f5006d53:

    # unum "JAJAJAJAJAJA-"
    unum "HAHAHAHAHAA--"

# game/script.rpy:1259
translate ingles rutaunum_a20cefa7_6:

    # "..."
    "..."

# game/script.rpy:1260
translate ingles rutaunum_63027237:

    # unum "¡Desde aquí puedo sentir el latido de tu corazón! ¿¡Esto es lo que llaman pulso?!"
    unum "From here I can feel your heartbeat! Is this what they call a pulse?!"

# game/script.rpy:1261
translate ingles rutaunum_304ee1a3:

    # unum "IMPRESIONANTE-"
    unum "AWESOME--"

# game/script.rpy:1264
translate ingles rutaunum_f3c0047b:

    # unum "Aunque- uhg!"
    unum "Although--uhg!"

# game/script.rpy:1265
translate ingles rutaunum_d9342c09:

    # unum "No me gusta la sustancia que estás liberando ahora... uhggg está impregnada en todo tu cuerpo ahora."
    unum "I don't like the substance you're releasing... uhggg, it's all over your body now."

# game/script.rpy:1266
translate ingles rutaunum_34c0aa5b:

    # "Sin más, Unum te suelta y tú caes al suelo."
    "Just like that, Unum lets you go and you fall to the ground."

# game/script.rpy:1267
translate ingles rutaunum_9395a756:

    # "Te quedas ahí, sin mover un solo músculo mirando con terror Unum."
    "You remain there, not moving a single muscle, staring at Unum in terror."

# game/script.rpy:1270
translate ingles rutaunum_81ae1e0a:

    # unum "Ahora entiendo porque Nulla evita estresar a los humanos..."
    unum "Now I understand why Nulla avoids stressing humans..."

# game/script.rpy:1273
translate ingles rutaunum_a5b93388:

    # "Él pone ambas manos en su cadera y suspira."
    "He puts both hands on his hips and sighs."

# game/script.rpy:1274
translate ingles rutaunum_9d079793:

    # unum "uhg, lo siento [nombrejugador], no era mi intensión asustarte."
    unum "Uhg, sorry [nombrejugador], I didn't mean to scare you."

# game/script.rpy:1275
translate ingles rutaunum_c41b85fc:

    # unum "Es solo que al no haber comido en el hotel, tengo mucha hambre."
    unum "It's just that, not having eaten at the hotel, I'm really hungry."

# game/script.rpy:1276
translate ingles rutaunum_430f1743:

    # "No tiene que decirlo explicitamente para saber que se refiere a que no te ha podido comer allá en el hotel. Y supones que tampoco pudo comer el remplazo que Madre les dio a los demás, seguramente por quedarse aquí contigo."
    "He doesn't have to say it explicitly for you to know that he means he couldn't eat you at the hotel. And you assume that he couldn't eat the replacement that Mother gave to the others, either, probably because he was staying here with you."

# game/script.rpy:1277
translate ingles rutaunum_68030956:

    # unum "Llevo esperando más de una semana por el placebo... y faltan 14 días para el próximo festival de las velas."
    unum "I've been waiting more than a week for the placebo... and there are 14 days until the next candle festival."

# game/script.rpy:1280
translate ingles rutaunum_43102250_1:

    # unum "..."
    unum "..."

# game/script.rpy:1281
translate ingles rutaunum_b39a2c40:

    # nj "¿Aún tienes hambre? pero acabas de comer..."
    nj "Are you still hungry? But you just ate..."

# game/script.rpy:1282
translate ingles rutaunum_644e440d:

    # "Recién ha comido algo, ¿cómo es posible que tenga hambre?"
    "He just ate something, how could he be hungry?"

# game/script.rpy:1285
translate ingles rutaunum_9e57a91b:

    # unum "Ah- los alimentos que tengo no me quitan el hambre, ni me saben a nada."
    unum "Ah--the food I have doesn't take away my hunger, nor does it taste like anything."

# game/script.rpy:1288
translate ingles rutaunum_7e382976:

    # "Unum al ver que lo miras preguntando silenciosamente la razón del porqué tiene alimentos en su cocina, se aclara la garganta antes de responder con algo de pena."
    "Unum, noticing the way you were silently asking the reason why he has food in his kitchen, clears his throat before responding with some shame."

# game/script.rpy:1289
translate ingles rutaunum_658b6571:

    # unum "A mis esposas por el contrario... gustan de cocinar y a mi me gusta verlas hacerlo así que no me quejo."
    unum "My wives, on the other hand, like to cook and I like to watch them do it, so... I'm not complaining."

# game/script.rpy:1290
translate ingles rutaunum_fef63af6:

    # "Mientras Unum habla, tú intentas calmar tus nervios. Claramente la deidad que tienes al frente es inestable... o al menos se pone inestable cuando se exalta."
    "While Unum speaks, you try to calm your nerves. Clearly the deity in front of you is unstable... or at least he becomes so when exalted."

# game/script.rpy:1291
translate ingles rutaunum_00825cf0:

    # "Más no tienes otra opción que seguir y adaptarte para sobrevivir."
    "But you have no choice but to continue and adapt to survive."

# game/script.rpy:1292
translate ingles rutaunum_85c973aa:

    # "Ya que escapar no es opción a estas alturas."
    "Since escape is not an option at this point."

# game/script.rpy:1293
translate ingles rutaunum_6a4541b1:

    # "Aunque te gustaría saber cual es tu verdadero proposito aquí."
    "Although you would like to know what your true purpose here is."

# game/script.rpy:1294
translate ingles rutaunum_86ef9213:

    # nj "Acerca de convertirme en tu sujeto de pruebas..."
    nj "About becoming your test subject..."

# game/script.rpy:1297
translate ingles rutaunum_9ec2934d:

    # unum "Podemos hablar de eso mañana."
    unum "We can talk about it tomorrow."

# game/script.rpy:1298
translate ingles rutaunum_325dad7e:

    # nj "No"
    nj "No."

# game/script.rpy:1299
translate ingles rutaunum_2d8def15:

    # "Dices firme. Quieres saber si ser su sujeto de pruebas te permitirá sobrevivir a costa de tu sanidad fisica o mental."
    "You say firmly. You want to know if being his test subject will allow you to survive at the cost of your physical or mental health."

# game/script.rpy:1300
translate ingles rutaunum_19bb0b55:

    # "En ese caso... realmente prefires que te mate de una buena vez. Despues de todo, puedes volver a intentar sobrevivir con Septem... {glitch=20.0}{color=ffffff}{b}o Nulla{/glitch}"
    "In that case... you really prefer that he kills you once and for all. After all, you can try to survive again with Septem...{glitch=20.0}{color=ffffff}{b}or Nulla.{/glitch}"

# game/script.rpy:1301
translate ingles rutaunum_fb55e231:

    # nj "Si me convierto en tu sujeto de pruebas, necesito saber con antelación que pruebas harás."
    nj "If I become your test subject, I need to know in advance what tests you will do."
# game/script.rpy:1304
translate ingles rutaunum_4566e0de:

    # unum "Oh--ja- jajaja-"
    unum "Oh--ah-hahaha--"

# game/script.rpy:1307
translate ingles rutaunum_43102250_2:

    # unum "..."
    unum "..."

# game/script.rpy:1308
translate ingles rutaunum_3f42d1ee:

    # "Se le nota algo incómodo."
    "He seems uncomfortable."
# game/script.rpy:1311
translate ingles rutaunum_df7c5e84:

    # unum "he- He leído que los humanos pueden crear- uh... algo parecido a lo que hizo el creador, pero diferente..."
    unum "I--I read that humans can create--uh... something similar to what the Creator made, but different..."

# game/script.rpy:1314
translate ingles rutaunum_6eeb6918:

    # unum "Es algo progresivo, que no va desde la nada a un todo al instante."
    unum "It's something progressive, that doesn't go from nothing to everything instantly."

# game/script.rpy:1315
translate ingles rutaunum_661777bc:

    # "Intentas comprender a lo que se refiere pero no se te viene nada a la cabeza, pues su explicación es algo vaga."
    "You try to understand what he means but nothing comes to mind, because his explanation is somewhat vague."

# game/script.rpy:1318
translate ingles rutaunum_8e423115:

    # "Unum viendo tu silencio, corre la mirada. Y te das cuenta que tiene sus orejas rojas, dudas que sea de rabia."
    "Unum, noticing your silence, looks away and you realize that his ears are red. You doubt it's from rage."

# game/script.rpy:1321
translate ingles rutaunum_42e8993e:

    # unum "... Mañana hablamos."
    unum "... Let's talk tomorrow."

# game/script.rpy:1322
translate ingles rutaunum_79f02632:

    # unum "Cerraré la residencia para que nadie pueda entrar."
    unum "I'll close the residence so that no one can enter."

# game/script.rpy:1323
translate ingles rutaunum_fd9cbdf1:

    # unum "Eres libre de recorrer el lugar y hacer lo que se te plazca."
    unum "You are free to roam the place and do as you please."

# game/script.rpy:1325
translate ingles rutaunum_b7d51caa:

    # "Con eso Unum te deja, desapareciendo en el lugar."
    "With that, Unum leaves you, disappearing from sight."

# game/script.rpy:1326
translate ingles rutaunum_a20cefa7_7:

    # "..."
    "..."

# game/script.rpy:1335
translate ingles rutaunum_de307752:

    # "Decides que es hora de terminar por hoy, descansar en la habitación que Unum te dio no parece mala idea."
    "You decide it's time to call it a day, resting in the room Unum gave you doesn't seem like a bad idea."

# game/script.rpy:1337
translate ingles rutaunum_29d956ed:

    # "Mañana será un nuevo día."
    "Tomorrow will be a new day."

# game/script.rpy:1338
translate ingles rutaunum_3dae35f0:

    # "Te acuestas en la cama, e intentas conciliar el sueño."
    "You lie in bed, and try to fall asleep."

# game/script.rpy:1339
translate ingles rutaunum_277af272:

    # "Te cuesta un poco, pero al final lo logras."
    "It takes you a little, but in the end, you manage to fall asleep."

# game/script.rpy:1341
translate ingles rutaunum_a20cefa7_8:

    # "..."
    "..."

# game/script.rpy:1342
translate ingles rutaunum_1d98435d:

    # "... no sueñas nada"
    "... You don't dream about anything."

# game/script.rpy:1345
translate ingles rutaunum_46410e9b:

    # "Abres los ojos con pesadez, sientes que no has podido descansar nada."
    "Your eyes feel heavy when you open them; you feel like you haven't been able to rest at all."

# game/script.rpy:1346
translate ingles rutaunum_7e0280fa:

    # "Nada en absoluto."
    "Not at all."

# game/script.rpy:1347
translate ingles rutaunum_faa01c50:

    # unum "Por fin despiertas."
    unum "You're finally awake."

# game/script.rpy:1348
translate ingles rutaunum_2937ee6a:

    # "Su voz hace que tus ojos se enfoquen."
    "Your eyes focus upon hearing his voice."

# game/script.rpy:1350
translate ingles rutaunum_bd95d5a2:

    # "Y lo encuentras sentado en la orilla de la cama. Mirandote con los ojos bien abiertos."
    "And you find him sitting on the edge of the bed. Looking at you with wide eyes."

# game/script.rpy:1352
translate ingles rutaunum_894018ca:

    # unum "Te he hecho alimento de la mañana."
    unum "I have made you morning food."

# game/script.rpy:1353
translate ingles rutaunum_56950434:

    # "Con una sonrisa llena de dientes afilados, Unum te presenta una bandeja con fruta y una copia mal hecha de lo que preparaste ayer."
    "With a smile full of sharp teeth, Unum presents you with a tray of fruit and a poorly made copy of what you prepared yesterday."

# game/script.rpy:1354
translate ingles rutaunum_bb4cede2:

    # "Unum se ve orgulloso de mostrar el desayuno, pero-"
    "Unum looks proud to show off the breakfast, but--"

# game/script.rpy:1355
translate ingles rutaunum_057bcd4a:

    # "Mientras más miras lo que tiene entre las manos, más imperfecciones vez."
    "The more you look at what he has in his hands, the more imperfections you see."

# game/script.rpy:1356
translate ingles rutaunum_4ab71c02:

    # "Se nota que no tiene idea de como preparar comida."
    "You can tell he has no idea how to prepare food."

# game/script.rpy:1357
translate ingles rutaunum_d4c9a1e0:

    # "Unum te ofrece la bandeja y debes tomar una decisión"
    "Unum offers you the tray and you must make a decision."

# game/script.rpy:1360
translate ingles rutaunum_3ef5b13a:

    # "No te da el corazón para rechazarlo."
    "You don't have the heart to reject him."

# game/script.rpy:1361
translate ingles rutaunum_46eb9fb6:

    # "Con miedo te preparas para comer lo que tienes en la bandeja."
    "With fear, you prepare to eat what's on the tray."

# game/script.rpy:1362
translate ingles rutaunum_4f4cd7f9:

    # "La fruta claramente no sabrá mal... lo que ha cocinado Unum en cambio-"
    "The fruit clearly won't taste bad... what Unum cooked, however--"

# game/script.rpy:1363
translate ingles rutaunum_500d3c63:

    # "Independiente de como sepa o se vea, te lo vas a comer."
    "Regardless of how it tastes or looks, you're going to eat it."

# game/script.rpy:1365
translate ingles rutaunum_b3e53726:

    # "Intentas poner tu mejor cara al comer, pero el sabor de esta cosa te lo pone difícil."
    "You try to put on your best face while you eat, but the taste of the stuff makes it difficult."

# game/script.rpy:1366
translate ingles rutaunum_8d1c495e:

    # "Pero debes hacerlo pues Unum te mira con una sonrisa de oreja a oreja mientras comes."
    "But you have to, because Unum looks at you with a smile from ear to ear while you're eating."

# game/script.rpy:1367
translate ingles rutaunum_a20cefa7_9:

    # "..."
    "..."

# game/script.rpy:1370
translate ingles rutaunum_5a95fbcc:

    # "Le dices que no tienes hambre por ahora."
    "You tell him you're not hungry right now."

# game/script.rpy:1371
translate ingles rutaunum_a0e630ec:

    # unum "Pero debes comer en la mañana, tarde y noche."
    unum "But you have to eat in the morning, afternoon, and night."

# game/script.rpy:1372
translate ingles rutaunum_34003d63:

    # unum "Sin eso no puedes vivir."
    unum "You can't live without it."

# game/script.rpy:1373
translate ingles rutaunum_0fb655ec:

    # "¿Entonces Unum hace esto para mantenerte con vida? increíble."
    "So Unum does this to keep you alive? Unbelievable."

# game/script.rpy:1374
translate ingles rutaunum_e23fa166:

    # nj "No es necesario."
    nj "It's not that necessary."

# game/script.rpy:1376
translate ingles rutaunum_b60efd85:

    # unum "Oh-"
    unum "Oh--"

# game/script.rpy:1377
translate ingles rutaunum_ef63de29:

    # "Se oye decepcionado."
    "He sounds disappointed."

# game/script.rpy:1378
translate ingles rutaunum_a20cefa7_10:

    # "..."
    "..."

# game/script.rpy:1381
translate ingles rutaunum_7ed3ab6c:

    # "Se quedan en la habitación por unos minutos, Unum a los pies de la cama y tú mirando por la ventana con barrotes."
    "You remain in the room for a few minutes, Unum at the foot of the bed, and you looking through the barred window."

# game/script.rpy:1383
translate ingles rutaunum_0d57b7cc:

    # "Duae ha venido de visita..."
    "Duae visited..."

# game/script.rpy:1384
translate ingles rutaunum_514a1ef8:

    # "¿Quién mierda será Duae? no tienes idea, pero al parecer Unum no es capaz de guardar silencio por un periodo largo de tiempo."
    "Who the hell is Duae? You have no idea, but apparently Unum isn't capable of remaining silent for any stretch of time."

# game/script.rpy:1385
translate ingles rutaunum_717adebc:

    # "Y tiene la necesidad de explicarse cada que puede."
    "And he has the need to explain himself whenever he can."

# game/script.rpy:1386
translate ingles rutaunum_2c9193c3:

    # "Tampoco es de los que se guarda nada."
    "He's also not one to keep anything to himself."

# game/script.rpy:1388
translate ingles rutaunum_8893bdef:

    # unum "Me ha pasado las sobras del placebo que Madre llevó al hotel."
    unum "She passed me the leftover placebo that Mother brought to the hotel."

# game/script.rpy:1389
translate ingles rutaunum_9dd14ef6:

    # unum "Por ende podremos llevar a cabo el experimento sin problemas."
    unum "So, we'll be able to carry out the experiment without problems."

# game/script.rpy:1390
translate ingles rutaunum_b7b59e93:

    # nj "¿Cuál es el experimento?"
    nj "What is the experiment?"

# game/script.rpy:1391
translate ingles rutaunum_955a958e:

    # unum "Quiero crear un hibrido."
    unum "I want to create a hybrid."

# game/script.rpy:1392
translate ingles rutaunum_a20cefa7_11:

    # "..."
    "..."

# game/script.rpy:1393
translate ingles rutaunum_8b8ceb72:

    # "............"
    "............"

# game/script.rpy:1394
translate ingles rutaunum_e3620b91:

    # "......................................."
    "......................................."

# game/script.rpy:1395
translate ingles rutaunum_06121740:

    # "¡¿UN QUÉEEEEE?!"
    "A WHAAAATTTT?!"

# game/script.rpy:1397
translate ingles rutaunum_ef8c1bd5:

    # "LLegas a saltar de la cama por lo bizarro de la situación."
    "You jump out of bed from the sheer bizarreness of the situation."

# game/script.rpy:1399
translate ingles rutaunum_935783fa:

    # unum "He leído que los humanos pasan por un ciclo que los tiene en un constante cambio, y gracias a eso son capaces de engendrar descendientes."
    unum "I've read that humans go through a cycle that keeps them constantly changing, and thanks to that, they're able to produce offspring."

# game/script.rpy:1400
translate ingles rutaunum_38c52ad7:

    # unum "Que son seres que no son una copia exacta de ellos."
    unum "And the result are beings that are not an exact copy of them."

# game/script.rpy:1403
translate ingles rutaunum_dc14e84a:

    # unum "A diferencia de nosotros."
    unum "Unlike us."

# game/script.rpy:1404
translate ingles rutaunum_e989e9cf:

    # unum "No importa cuantas veces lo intente, nuestra composición no nos permite crear descendientes con los nuestros."
    unum "No matter how many times I try, our composition does not allow us to create descendants with our own."

# game/script.rpy:1405
translate ingles rutaunum_c43630b4:

    # unum "Entonces comencé a leer los documentos que tiene Septem de los humanos."
    unum "Then I started reading the documents that Septem has on humans."

# game/script.rpy:1408
translate ingles rutaunum_b025706e:

    # unum "Y... Existe data de un nacimiento ocurrido un domingo... "
    unum "And... there's data of a birth that occurred on a Sunday..."

# game/script.rpy:1409
translate ingles rutaunum_359857fe:

    # unum "Hijo de Septem y un humano."
    unum "Son of Septem and a human."

# game/script.rpy:1412
translate ingles rutaunum_06824711:

    # "Unum se acerca a ti para poder tomarte las manos y cubrirlas con las suyas, implorando por tu complicidad."
    "Unum approaches you so he can take your hands and cover them with his own, asking you to go along with it."

# game/script.rpy:1413
translate ingles rutaunum_51cfc99f:

    # "Tú no te lo puedes creer."
    "You can't believe it."

# game/script.rpy:1414
translate ingles rutaunum_1486ffc1:

    # unum "Si aceptas, juro que te cuidaré y vivirás con todas las comodidades posibles."
    unum "If you accept, I swear that I will take care of you and you will live with all possible comforts."

# game/script.rpy:1415
translate ingles rutaunum_2fcc4c16:

    # unum "Por favor..."
    unum "Please..."

# game/script.rpy:1427
translate ingles rutaunum_0eb06432:

    # nj "..."
    nj "..."

# game/script.rpy:1428
translate ingles rutaunum_a06a7990:

    # "No sabes en lo que te estás metiendo, tampoco tienes idea de como será el procedimiento..."
    "You don't know what you're getting into, you have no idea what the procedure will be like..."

# game/script.rpy:1429
translate ingles rutaunum_f03900eb:

    # "Pero bajo la promesa de que podrás vivir, harás lo que sea."
    "But under the promise that you can live, you will do anything."

# game/script.rpy:1430
translate ingles rutaunum_91d23260:

    # nj "Está bien. Hagámoslo."
    nj "Okay. Let's do it."

# game/script.rpy:1431
translate ingles rutaunum_43102250_3:

    # unum "..."
    unum "..."

# game/script.rpy:1434
translate ingles rutaunum_a0fb7115:

    # "Unum te mira con la boca abierta, procesando lo que acaba de salir de tu boca."
    "Unum looks at you with his mouth open, processing what just came out of your mouth."

# game/script.rpy:1435
translate ingles rutaunum_f64753f0:

    # "Y como si una ampolleta se encendiera dentro de su cabeza, Unum te toma de las mejillas y choca su boca con la tuya."
    "And as if a light bulb went off inside his head, Unum suddenly grabs your cheeks and crashes his mouth against yours."

# game/script.rpy:1438
translate ingles rutaunum_811af422:

    # "Sus manos comienzas a bajar paulatinamente por tu cuerpo, desde tus mejillas hasta tus caderas y muslos."
    "His hands begin to slowly move across your body from your cheeks down to your hips and thighs."

# game/script.rpy:1439
translate ingles rutaunum_c502be4b:

    # unum "Te amo"
    unum "I love you."

# game/script.rpy:1440
translate ingles rutaunum_7694b0e5:

    # "Wow, alto, alto alto! está yendo muy rápido, y no es por invalidad los sentimientos o palabras del pelirrojo, pero... no crees que lo diga en serio."
    "Wow, stop, stop, stop! He's going very fast, and not to invalidate the redhead's feelings or words, but... you don't think he means it."

# game/script.rpy:1441
translate ingles rutaunum_5284ab28:

    # "Es decir, a penas te conoce por unos días..."
    "He's only known you for a few days..."

# game/script.rpy:1442
translate ingles rutaunum_dab3d31a:

    # unum "Te he deseado desde que te vi en el hotel... te amo, te amo, te amoo mucho."
    unum "I've wanted you since I saw you at the hotel... I love you, I love you, I love you so much."

# game/script.rpy:1443
translate ingles rutaunum_53451d16:

    # "Joderrr, está loquito. Pero no nos hagamos los desentendidos... eso te gusta."
    "Damn, he's crazy. But... you like that."

# game/script.rpy:1444
translate ingles rutaunum_eb04a100:

    # "Luego, repentinamente Unum para."
    "Then suddenly Unum stops."

# game/script.rpy:1447
translate ingles rutaunum_cb1b286e:

    # unum "Ah-- Mierda..."
    unum "Ah--shit..."

# game/script.rpy:1448
translate ingles rutaunum_f6c44a99:

    # unum "Se me ha olvidado el consentimiento..."
    unum "I forgot about consent..."

# game/script.rpy:1449
translate ingles rutaunum_7f796bee:

    # unum "Creo que es algo importante para ustedes..."
    unum "I think it's something important for you humans..."

# game/script.rpy:1450
translate ingles rutaunum_cc477436:

    # "Efectivamente, es importante. Tienes que darle puntos por tener eso en cuenta."
    "Indeed, it is important. You have to give him points for keeping that in mind."

# game/script.rpy:1451
translate ingles rutaunum_767adca7:

    # unum "¿Podemos proceder?"
    unum "Can we proceed?"

# game/script.rpy:1455
translate ingles rutaunum_67cef4f9:

    # nj "Está bien."
    nj "Alright."

# game/script.rpy:1458
translate ingles rutaunum_86762e2e:

    # "Unum atravieza su pecho con la mano de manera lenta."
    "Unum slowly runs his hand across his chest."

# game/script.rpy:1459
translate ingles rutaunum_9c739289:

    # "Y con delicadeza, la retira con algo brillante en su mano."
    "And, gently, he removes something shiny from it."

# game/script.rpy:1462
translate ingles rutaunum_3c8e6e74:

    # "Es una esfera transparente que gotea un líquido parecido al oro."
    "It is a transparent sphere dripping with a gold-like liquid."

# game/script.rpy:1463
translate ingles rutaunum_84867374:

    # unum "Tengo que colocar esto dentro de tu pecho y luego retirarlo."
    unum "I have to place this inside your chest and then remove it."

# game/script.rpy:1464
translate ingles rutaunum_3a3d5324:

    # unum "Es mi esencia... así que debemos hacerlo con cuidado..."
    unum "It's my essence... so we must do it carefully..."

# game/script.rpy:1465
translate ingles rutaunum_f162ce9d:

    # "Dice sonriendo con ternura."
    "He says, smiling tenderly."

# game/script.rpy:1466
translate ingles rutaunum_b00d86a8:

    # "...Probablemente Unum no esté pensando en lo que tu estabas pensando, despues de todo, Unum no es humano..."
    "... Unum is probably not thinking what you were thinking. After all, Unum is not human..."

# game/script.rpy:1478
translate ingles rutaunum_409efbb7:

    # "Piensas que probablemente no estén pensando en lo mismo, despues de todo, Unum no es humano..."
    "You think you two probably aren't thinking the same thing. After all, Unum isn't human..."

# game/script.rpy:1479
translate ingles rutaunum_d3d6145a:

    # "Así que decides preguntar con algo de vergüenza."
    "So you decide to ask with some embarrassment."

# game/script.rpy:1480
translate ingles rutaunum_0184a7d8:

    # nj "¿Cómo lo haríamos?"
    nj "How would we do it?"

# game/script.rpy:1483
translate ingles rutaunum_4bd354b3:

    # unum "Ah! es muy facil."
    unum "Ah! It's very easy."

# game/script.rpy:1484
translate ingles rutaunum_18e9de01:

    # unum "Por lo que leí, Septem prefirió usar este modo..."
    unum "From what I read, Septem preferred to use this method..."

# game/script.rpy:1485
translate ingles rutaunum_2c7d51c0:

    # unum "Debo combinar tu alma con la mía."
    unum "I must combine your soul with mine."

# game/script.rpy:1488
translate ingles rutaunum_86762e2e_1:

    # "Unum atravieza su pecho con la mano de manera lenta."
    "Unum slowly runs his hand across his chest."

# game/script.rpy:1489
translate ingles rutaunum_9c739289_1:

    # "Y con delicadeza, la retira con algo brillante en su mano."
    "And, gently, he removes something shiny from it."

# game/script.rpy:1492
translate ingles rutaunum_3c8e6e74_1:

    # "Es una esfera transparente que gotea un líquido parecido al oro."
    "It is a transparent sphere dripping with a gold-like liquid."

# game/script.rpy:1493
translate ingles rutaunum_84867374_1:

    # unum "Tengo que colocar esto dentro de tu pecho y luego retirarlo."
    unum "I have to place this inside your chest and then remove it."

# game/script.rpy:1494
translate ingles rutaunum_3a3d5324_1:

    # unum "Es mi esencia... así que debemos hacerlo con cuidado..."
    unum "It's my essence... so we must do it carefully..."

# game/script.rpy:1495
translate ingles rutaunum_f162ce9d_1:

    # "Dice sonriendo con ternura."
    "He says, smiling tenderly."

# game/script.rpy:1508
translate ingles rutaunum_a20cefa7_12:

    # "..."
    "..."

# game/script.rpy:1509
translate ingles rutaunum_c05415b9:

    # unum "Iré a las termas, si deseas puedes acompañarme."
    unum "Iré a las termas, si deseas puedes acompañarme."

# game/script.rpy:1510
translate ingles rutaunum_45a0c129:

    # "El cansancio es demasiado, es como si te han robado toda la energía."
    "El cansancio es demasiado, es como si te han robado toda la energía."

# game/script.rpy:1511
translate ingles rutaunum_94602ddd:

    # "Pero ir a las termas no suena nada mal. Por lo que aceptas acompañarlo."
    "Pero ir a las termas no suena nada mal. Por lo que aceptas acompañarlo."

# game/script.rpy:1543
translate ingles menuexplorar_e588d89a:

    # "Recorres todos los pasillos que están disponibles en la residencia, las ventanas escasean y no posibilidad de salir por ahí, pues tienen rejas."
    "You walk through all the hallways that are available in the residence. There are few windows, but no possibility of going out of them, because they are barred."

# game/script.rpy:1544
translate ingles menuexplorar_e4c2323a:

    # "Los pasillos están llenos de pinturas que se enfocan en mostrar la figura humana y la cotinianidad de estos."
    "The hallways are full of paintings that focus on showing the human figure and their everyday life."

# game/script.rpy:1545
translate ingles menuexplorar_253a33d0:

    # "Si estuvieras en un museo, sería muy interesante... pero ahora no te causa más que incomodidad."
    "If you were in a museum, it would be very interesting... but now it just makes you uncomfortable."

# game/script.rpy:1546
translate ingles menuexplorar_1ba8fe11:

    # "Por lo que te centras mirar todo menos las pinturas."
    "So you focus on looking at everything but the paintings."

# game/script.rpy:1547
translate ingles menuexplorar_05ed436c:

    # "Por ejemplo las puertas."
    "For example, the doors."

# game/script.rpy:1548
translate ingles menuexplorar_7c2035a0:

    # "Muchas de las puertas están bloqueadas por lo que no puedes aventurarte más allá de los pasillos."
    "Many of the doors are blocked so you can't venture beyond the hallways."

# game/script.rpy:1552
translate ingles menuexplorar_956ca789:

    # "Gran parte de las habitaciones dentro de la residencia estan bloqueadas, no importa cuanto intentes, no puedes abrir sus puertas."
    "Many of the rooms inside the residence are locked. No matter how hard you try, you can't open their doors."

# game/script.rpy:1554
translate ingles menuexplorar_b776d751:

    # "Aunque hay algunas que están abiertas, pero no tienen nada interesante dentro."
    "Although there are some that are open, they don't have anything interesting inside."

# game/script.rpy:1555
translate ingles menuexplorar_4af542ba:

    # "Sientes que en algún momento llegas a la habitación donde se encuentra Unum, pues esta se ve diferente a las demás."
    "You feel that, at any moment, you'll reach the room where Unum is, but this one looks different from the others."

# game/script.rpy:1556
translate ingles menuexplorar_a87861c5:

    # "Pero al intentar abrirla, nada sucede."
    "But when you try to open it, nothing happens."

# game/script.rpy:1557
translate ingles menuexplorar_3dc53857:

    # "No puedes entrar."
    "You can't go in."

# game/script.rpy:1561
translate ingles menuexplorar_b24e3906:

    # "Ya tienes algo en mente que te podría servir para atacar a Unum."
    "You already have something in mind that could be used to attack Unum."

# game/script.rpy:1563
translate ingles menuexplorar_dfdd89a6:

    # "Vuelves a la cocina y revuelves todo el lugar en busca de algun cuchillo."
    "You go back to the kitchen and look around the place for knives."

# game/script.rpy:1564
translate ingles menuexplorar_9a627654:

    # "Una vez los encuentras, eliges el más grande y filoso."
    "Once you find them, you choose the biggest and sharpest one."

# game/script.rpy:1565
translate ingles menuexplorar_0d257bce:

    # "Y lo guardas dentro de tu ropa."
    "And you keep it inside your clothes."

# game/script.rpy:1566
translate ingles menuexplorar_dcb29fb7:

    # "Esperas que pueda servir contra Unum."
    "You hope it can work against Unum."

# game/script.rpy:1579
translate ingles badend_cena_83829e15:

    # "Sientes una presión en tu cuerpo y supones que es Nulla."
    "You feel a pressure on your body and you assume it's Nulla."

# game/script.rpy:1581
translate ingles badend_cena_22607b2b:

    # "De pronto, ellos aparecen en los puestos que estaban antes."
    "Suddenly, they appear in the positions they were before."

# game/script.rpy:1582
translate ingles badend_cena_e8f414ec:

    # "Nulla parado a un lado de la mesa y los otros sentados."
    "Nulla is standing on one side of the table and the others are seated."

# game/script.rpy:1583
translate ingles badend_cena_60923712:

    # "Nulla se ve decepcionado al preguntar por como ha ido. Y rápidamente entiende que no te han tomado como aprendíz."
    "Nulla looks disappointed when asking how it went. And quickly understands that they haven't taken you on as an apprentice."

# game/script.rpy:1584
translate ingles badend_cena_163dd202:

    # "Sacude la cabeza con lentitud mientras te mira."
    "He shakes his head slowly as he looks at you."

# game/script.rpy:1585
translate ingles badend_cena_c27df771:

    # "No pasa mucho tiempo cuando se siente un estruendo en la entrada del comedor."
    "It's not long before the sound of trumpets is heard at the entrance to the dining room."

# game/script.rpy:1586
translate ingles badend_cena_cfd67c8e:

    # "Los demás estandartes han llegado y todo se vuelve un caos donde el tiempo y el espacio se mezclan."
    "The other Symbols have arrived and everything becomes chaos where time and space mix."

# game/script.rpy:1587
translate ingles badend_cena_d46dfafb:

    # "Impidiéndote comprender muy bien lo que está pasando."
    "Preventing you from fully understanding what is happening."

# game/script.rpy:1588
translate ingles badend_cena_2beef371:

    # "Pero de algo estás seguro, y es que te están despedazando de poco a poco."
    "But you are sure of one thing, and that is that they are tearing you apart little by little."

# game/script.rpy:1589
translate ingles badend_cena_2368a133:

    # "Por alguna extraña razón no puedes dejar de sentirlo."
    "For some strange reason you can't help but feel it."

# game/script.rpy:1590
translate ingles badend_cena_e5eb9746:

    # "No se te permite dejar este mundo hasta que la última pieza de tu cuerpo sea devorada."
    "You are not allowed to leave this world until the last piece of your body is devoured."

# game/script.rpy:1591
translate ingles badend_cena_2dd96236:

    # "Dedos, brazos, piernas y pies son desgarrados de tu cuerpo. Para luego seguir con tus organos."
    "Fingers, arms, legs, and feet are torn from your body. Then your organs..."

# game/script.rpy:1592
translate ingles badend_cena_401414d1:

    # "Duele."
    "It hurts."

# game/script.rpy:1593
translate ingles badend_cena_f69763d6:

    # "Pero no puedes gritar."
    "But you can't scream."

# game/script.rpy:1594
translate ingles badend_cena_a8b2fabc:

    # "Quema."
    "It burns."

# game/script.rpy:1595
translate ingles badend_cena_abd83772:

    # "Pero no puedes llorar."
    "But you can't cry."

# game/script.rpy:1597
translate ingles badend_cena_b085243f:

    # "Luego tus ojos dejan de ver."
    "Then your eyes stop seeing."

# game/script.rpy:1598
translate ingles badend_cena_a468c199:

    # "Y lo unico que puedes hacer es escuchar y respirar con dificultad."
    "And all you can do is listen and breathe hard."

# game/script.rpy:1599
translate ingles badend_cena_9bbd6c0d:

    # "Escuchas risas y converzaciones que no puedes entender."
    "You hear laughter and conversations that you can't understand."

# game/script.rpy:1600
translate ingles badend_cena_4e70dad0:

    # "Al terminar, lo unico que sientes es como Nulla toca tu alma destrozada..."
    "When it's over, the only thing you feel is how Nulla touches your broken soul..."

# game/script.rpy:1601
translate ingles badend_cena_7f5cd682:

    # "{glitch=20.0}{color=ffffff}{b}Puedes intentar de nuevo si deseas.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}You can try again if you want.{/glitch}"

# game/script.rpy:1602
translate ingles badend_cena_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1603
translate ingles badend_cena_577accc0:

    # "BAD END: Devorado por los estandartes."
    "BAD END: Devoured by symbols."

# game/script.rpy:1819
translate ingles badendunum2_6edf6c96:

    # "Tú no le tienes miedo a este cabrón, menos si es tan iluso de pensar que no intentarás escapar si te deja sin supervisión."
    "You're not afraid of this bastard, especially if he's so delusional that he thinks you won't try to escape if left unsupervised."

# game/script.rpy:1820
translate ingles badendunum2_7bd9eb87:

    # "Pero no puede ser tan fácil, seguro debe tener algun modo de detectar lo que estás haciendo..."
    "But it can't be that easy, surely there must be some way to detect what you're doing..."

# game/script.rpy:1821
translate ingles badendunum2_92aea77f:

    # "Miras todas las posibles salidas, inspeccionas los pasillos que conectan con la cocina, pero no te aventuras más allá."
    "You look at all the possible exits and you inspect the hallways that connect to the kitchen, but you don't venture further."

# game/script.rpy:1822
translate ingles badendunum2_419db819:

    # "Para comprobarlo, intentas ir por donde se fue Unum, fingiendo que le buscas."
    "To prove it, you intend to go where Unum went, pretending that you're looking for him."

# game/script.rpy:1823
translate ingles badendunum2_9d584066:

    # "Pero no hay rastro de él..."
    "But there is no trace of him..."

# game/script.rpy:1824
translate ingles badendunum2_c77ac886:

    # "Te quedas ahí, pensando en lo que puedes hacer."
    "You stand there, thinking about what you can do."

# game/script.rpy:1825
translate ingles badendunum2_dfe7933a:

    # "Y es ahí cuando te das cuenta... más allá del comedor, hay una puerta semi-abierta."
    "And that's when you realize... beyond the dining room, there is a half-open door."

# game/script.rpy:1826
translate ingles badendunum2_34655382:

    # "Sin pensarlo y bajo la esperanza de que puede ser una salida, vas de forma sigilosa hasta ahí."
    "Without thinking about it and hoping that it could be a way out, you go there sneakily."

# game/script.rpy:1827
translate ingles badendunum2_5c980d4f:

    # "Con cuidado tomas la manilla para abrir la puerta por completo y observar que hay detrás de ella."
    "You carefully take the handle to open the door completely and observe what is behind it."

# game/script.rpy:1829
translate ingles badendunum2_410b4939:

    # "Es el jardín."
    "It's the garden."

# game/script.rpy:1830
translate ingles badendunum2_0e72ec1d:

    # "Estás afuera."
    "You're outside."

# game/script.rpy:1831
translate ingles badendunum2_09cfcef2:

    # "Sin esperar más sales corriendo lo más rápido que te permiten tus pies."
    "Without waiting any longer, you run as fast as your feet can carry you."

# game/script.rpy:1832
translate ingles badendunum2_2ccdb728:

    # "4 zancadas alcanzas a dar despues de cruzar la puerta cuando caes sintiendo un dolor punzante debajo de tus rodillas."
    "You manage to take just four strides after passing through the door before you fall, a sharp pain beneath your knees."

# game/script.rpy:1834
translate ingles badendunum2_b727ba73:

    # "Caes y te revuelcas en el pasto y si no fuera por tus brazos, seguramente tendrías toda la cara raspada."
    "You fall and roll in the grass and if it weren't for your arms, your face would probably be scratched up."

# game/script.rpy:1835
translate ingles badendunum2_333f7f75:

    # "Intentas pararte con urgencia pero el dolor es tanto que no puedes hacer más que arrastrarte."
    "You try to stand up urgently but the pain is so much that you can't do anything but crawl."

# game/script.rpy:1836
translate ingles badendunum2_fe283d4f:

    # "Levantas tu cabeza para entender porque tus piernas no responden."
    "You raise your head to understand why your legs don't respond."

# game/script.rpy:1837
translate ingles badendunum2_cc9a5909:

    # "!!!"
    "!!!"

# game/script.rpy:1838
translate ingles badendunum2_b7eaea6b:

    # "Con terror te das cuenta que tus piernas ya no están conectadas con tu cuerpo."
    "With terror, you realize that your legs are no longer connected to your body."

# game/script.rpy:1839
translate ingles badendunum2_04d6cfe5:

    # "Gritas hasta que tu garganta comienza a quemar."
    "You scream until your throat starts to burn."

# game/script.rpy:1841
translate ingles badendunum2_5ca547c5:

    # "Y unas risas femeninas se unen a tus gritos en un coro casi que angelical."
    "And feminine laughter joins your screams in an almost angelic chorus."

# game/script.rpy:1842
translate ingles badendunum2_07ec7a6d:

    # "Lo ultimo que ves es como varias manos te despedazan."
    "The last thing you see is how several hands are tearing you to pieces."

# game/script.rpy:1843
translate ingles badendunum2_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1845
translate ingles badendunum2_12548e44:

    # "BAD END: Conoces a las esposas de Unum."
    "BAD END: You know the wives of Unum."

# game/script.rpy:1851
translate ingles badendunum3_03966ba9:

    # "Lágrimas se acumulan en tus ojos por el panico que se empieza a formar en tu cuerpo."
    "Tears are gathering in your eyes from the panic that begins to form within you."

# game/script.rpy:1852
translate ingles badendunum3_974e4305:

    # "Como puedes le comandas a tu boca para que recite una súplica que pueda salvarte el pellejo."
    "As best you can, you force your mouth to recite a plea that can save your skin."

# game/script.rpy:1853
translate ingles badendunum3_4acb049c:

    # nj "¡Por favor no me hagas daño!"
    nj "Please don't hurt me!"

# game/script.rpy:1854
translate ingles badendunum3_9fe69e56:

    # unum "¿Oh?"
    unum "Oh?"

# game/script.rpy:1855
translate ingles badendunum3_f204e8ad:

    # "Unum te examina de cerca, centrado en tus ojos."
    "Unum examines you closely, focusing on your eyes."

# game/script.rpy:1856
translate ingles badendunum3_44343f17:

    # "Tú intentas calmarte pero te es imposible, y no puedes evitar sollozar mientras suplicas."
    "You try to calm down but it's impossible, and you can't help but sob while you beg."

# game/script.rpy:1857
translate ingles badendunum3_00a699b5:

    # "Una vez sale una, las demás le siguen en picada. Lágima tras lágrima salen de tus ojos para recorrer tus mejillas y luego caer en tu ropa y parte del brazo de Unum."
    "Once one comes out, the others follow in a tailspin. Tear after tear pours from your eyes, running down your cheeks and then falling onto your clothes and part of Unum's arm."

# game/script.rpy:1858
translate ingles badendunum3_16ab70b4:

    # "El pelirrojo observa el recorrido que hacen tus lágrimas, con una expresión que no puedes decifrar."
    "The redhead observes the path your tears take, with an expression that you cannot decipher."

# game/script.rpy:1859
translate ingles badendunum3_4fa986e3:

    # nj "Por favor, juro que- {sc=4}U G H ! {/sc}"
    nj "Please, I swear that--{sc=4}U G H ! {/sc}"

# game/script.rpy:1860
translate ingles badendunum3_264dc0d4:

    # "Una de las manos de Unum impacta en tu mandibula, sujetándola con fuerza."
    "One of Unum's hands hits your jaw, gripping it tightly."

# game/script.rpy:1861
translate ingles badendunum3_ec3fc108:

    # unum "¿QUÉ ES ESTO?"
    unum "WHAT IS THIS?"

# game/script.rpy:1862
translate ingles badendunum3_86a12dc4:

    # unum "JAJAJAJAJAJAJAJA- ¿ES LO QUE CREO QUE ES?"
    unum "HAHAHAHAHAHAHAHA--IS THAT WHAT I THINK IT IS?"

# game/script.rpy:1863
translate ingles badendunum3_a0f14e3f:

    # unum "DIOSSSS ES COMO SI PIDIERAS A GRITOS QUE TE DEVORE!"
    unum "GOD, IT'S LIKE YOU'RE SCREAMING FOR ME TO DEVOUR YOU!"

# game/script.rpy:1864
translate ingles badendunum3_7f4e4c8b:

    # unum "Ah~"
    unum "Ah~"

# game/script.rpy:1865
translate ingles badendunum3_6fc6044f:

    # unum "ESA CARAA QUE ESTÁS HACIENDO-"
    unum "THAT FACE YOU'RE MAKING--"

# game/script.rpy:1866
translate ingles badendunum3_873e50d6:

    # unum "NO AGUANTO MÁS."
    unum "I CAN'T TAKE IT ANYMORE."

# game/script.rpy:1867
translate ingles badendunum3_941dade3:

    # "Algo duro te atravieza el pecho y de a poco pierdes la conciencia."
    "Something hard pierces your chest and little by little you lose consciousness."

# game/script.rpy:1869
translate ingles badendunum3_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1870
translate ingles badendunum3_d1215cff:

    # "BAD END: Llorando no consigues nada."
    "BAD END: Crying doesn't achieve anything."

# game/script.rpy:1878
translate ingles badendunum4_950a2b2d:

    # "Palpando con tu mano, buscas el cuchillo que hay guardado debajo de tus ropas."
    "Feeling with your hand, you look for the knife that is kept under your clothes."

# game/script.rpy:1880
translate ingles badendunum4_abfe63ad:

    # "Cuando lo sientes dejas de respirar, agarras el mango del cuchillo y apuñalas a Unum en la cabeza con todas tus fuerzas."
    "When you feel it, you hold your breath, grab the handle of the knife, and stab Unum in the head with all your strength."

# game/script.rpy:1883
translate ingles badendunum4_718e8eeb:

    # "Él deja de moverse. Quedandose completamente quieto."
    "He stops moving. Going completely still."

# game/script.rpy:1884
translate ingles badendunum4_9c580472:

    # "Observas como el cuchillo ha conectado perfectamente en la cabeza del pelirrojo, atravezando el craneo incluso."
    "You notice how the knife has landed perfectly on the redhead's head, even going through the skull."

# game/script.rpy:1885
translate ingles badendunum4_8215776a:

    # "Unum sigue sin moverve, por lo que asumes que ha muerto."
    "Unum still doesn't move, so you assume he's dead."

# game/script.rpy:1886
translate ingles badendunum4_8afb4e19:

    # "Sueltas todo el aire que llevas en tus pulmones e intentas quitar el cuchillo del cuerpo sin vida de Unum."
    "You release all the breath you'd been holding and try to remove the knife from Unum's lifeless body."

# game/script.rpy:1887
translate ingles badendunum4_05c5f345:

    # "Está atascado..."
    "It's stuck..."

# game/script.rpy:1890
translate ingles badendunum4_c609bf58:

    # "Una mano cubre tu agarre del cuchillo, y jalandola con fuerza, extrae el objeto."
    "One hand covers your grip on the knife, and, pulling hard, extracts it."

# game/script.rpy:1893
translate ingles badendunum4_18256cfc:

    # unum "HMJA- JAJAJAJAJJAJAJA."
    unum "HMHA--HAHAHAHAHAHAHA."

# game/script.rpy:1894
translate ingles badendunum4_69d6d3b9:

    # "Ver a Unum vivo y sin rastro de rojo en el lugar de la herida, es una imagen chocante."
    "Seeing Unum alive and without a trace of red at the site of the wound is a shocking image."

# game/script.rpy:1895
translate ingles badendunum4_ff49fc7a:

    # "Más cuando, lo que emana del lugar donde ha impactado el cuchillo, sale un liquido dorado."
    "Even more so when what emanates from the place where the knife impacted is a golden liquid."

# game/script.rpy:1896
translate ingles badendunum4_540d1609:

    # unum "En serio pensaste que eso te iba a servir."
    unum "You really thought that was going to help you."

# game/script.rpy:1897
translate ingles badendunum4_82c11d8d:

    # unum "Patético."
    unum "Pathetic."

# game/script.rpy:1898
translate ingles badendunum4_3c9dccba:

    # "Con el mismo cuchillo, Unum decide acabarte sin titubear."
    "With the same knife, Unum decides to finish you without hesitation."

# game/script.rpy:1900
translate ingles badendunum4_fe2219bb:

    # "Impacta en el mismo lugar donde tu le has atacado."
    "It hits the same place where you attacked him, on the head."

# game/script.rpy:1901
translate ingles badendunum4_5e9a99c9:

    # "Pierdes la vida al instante."
    "You lose your life instantly."

# game/script.rpy:1902
translate ingles badendunum4_000597d6:

    # "BAD END: No juegues con cuchillos."
    "BAD END: Don't play with knives."

# game/script.rpy:1907
translate ingles badendunum5_42526f2e:

    # nj "No puedo."
    nj "I can't."

# game/script.rpy:1908
translate ingles badendunum5_b3e2ad9e:

    # "Dices lo más despacio posible, con miedo a como pueda reaccionar."
    "You say as quietly as possible, afraid of how he might react."

# game/script.rpy:1909
translate ingles badendunum5_e4424530:

    # "Pero no lo harás. Ni por que tu vida esté en juego."
    "But you won't do it. Not even because your life is at stake."

# game/script.rpy:1910
translate ingles badendunum5_5c426c30:

    # unum "Hmmm..."
    unum "Hmmm..."

# game/script.rpy:1911
translate ingles badendunum5_36ba12af:

    # "Sus manos sueltan las tuyas lentamente. Y por un momento, Unum tiene una expresión seria."
    "His hands release yours slowly. And for a moment, Unum has a serious expression."

# game/script.rpy:1912
translate ingles badendunum5_eba3a8a3:

    # unum "Está bien."
    unum "Alright."

# game/script.rpy:1913
translate ingles badendunum5_6a5d5a2f:

    # "No te lo puedes creer. ¿Ha resultado? ¿Realmente te dejará en paz?"
    "You can't believe it. Has it worked? Will he really leave you alone?"

# game/script.rpy:1914
translate ingles badendunum5_1e57bdbc:

    # "¿Podrás salir de aquí entonces?"
    "Will you be able to get out of here, then?"

# game/script.rpy:1915
translate ingles badendunum5_7b6d69bc:

    # unum "Veo que ya no tengo más razones para tenerte aquí."
    unum "I see I have no more reason to keep you here."

# game/script.rpy:1916
translate ingles badendunum5_826f0941:

    # unum "Y ya no tengo hambre..."
    unum "And I'm not hungry anymore..."

# game/script.rpy:1917
translate ingles badendunum5_43102250:

    # unum "..."
    unum "..."

# game/script.rpy:1918
translate ingles badendunum5_1ebbca95:

    # unum "Puedes irte."
    unum "You can go."

# game/script.rpy:1919
translate ingles badendunum5_97e76ac1:

    # "Unum te acompaña a la puerta principal, caminando delante de ti en todo momento... No se le ve molesto ni nada."
    "Unum walks you to the front door, staying in front of you the whole time... he doesn't seem upset or anything."

# game/script.rpy:1920
translate ingles badendunum5_27806813:

    # "Pero tampoco tiene esa actitud ligera que lleva trayendo desde que lo conociste."
    "But he also doesn't have that light attitude that he's had since you met him."

# game/script.rpy:1921
translate ingles badendunum5_e94f7f49:

    # "Es extraño verlo tan tranquilo."
    "It's strange to see him so calm."

# game/script.rpy:1922
translate ingles badendunum5_6600d32d:

    # "Te abre la puerta y te invita a salir."
    "He opens the door for you and invites you out."

# game/script.rpy:1923
translate ingles badendunum5_0e5f6aea:

    # "Algo está mal."
    "Something is wrong."

# game/script.rpy:1924
translate ingles badendunum5_b6915deb:

    # "Pero te aferras a creer que estás a pasos de tu libertad. Con la cabeza gacha pasar por el umbral de la puerta."
    "But you cling to the belief that you are steps away from your freedom. With your head down, you walk through the doorway."

# game/script.rpy:1925
translate ingles badendunum5_71669216:

    # "Y Unum cierra la puerta, sin decir nada."
    "And Unum closes the door, without saying anything."

# game/script.rpy:1927
translate ingles badendunum5_1c17102e:

    # "Ahora te encuentras afuera..."
    "Now you are outside..."

# game/script.rpy:1928
translate ingles badendunum5_7762234f:

    # "Aproximadamente alcanzas a dar 10 pasos despues de cruzar la puerta cuando caes sintiendo un dolor punzante debajo de tus rodillas."
    "You're about ten steps out the door when you fall, feeling a sharp pain beneath your knees."

# game/script.rpy:1930
translate ingles badendunum5_b727ba73:

    # "Caes y te revuelcas en el pasto y si no fuera por tus brazos, seguramente tendrías toda la cara raspada."
    "You fall and roll in the grass and if it weren't for your arms, your face would probably be scratched up."

# game/script.rpy:1931
translate ingles badendunum5_333f7f75:

    # "Intentas pararte con urgencia pero el dolor es tanto que no puedes hacer más que arrastrarte."
    "You try to stand up urgently but the pain is so much that you can't do anything but crawl."

# game/script.rpy:1932
translate ingles badendunum5_fe283d4f:

    # "Levantas tu cabeza para entender porque tus piernas no responden."
    "You raise your head to understand why your legs don't respond."

# game/script.rpy:1933
translate ingles badendunum5_cc9a5909:

    # "!!!"
    "!!!"

# game/script.rpy:1934
translate ingles badendunum5_b7eaea6b:

    # "Con terror te das cuenta que tus piernas ya no están conectadas con tu cuerpo."
    "With terror, you realize that your legs are no longer connected to your body."

# game/script.rpy:1935
translate ingles badendunum5_04d6cfe5:

    # "Gritas hasta que tu garganta comienza a quemar."
    "You scream until your throat starts to burn."

# game/script.rpy:1937
translate ingles badendunum5_5ca547c5:

    # "Y unas risas femeninas se unen a tus gritos en un coro casi que angelical."
    "And feminine laughter joins your screams in an almost angelic chorus."

# game/script.rpy:1938
translate ingles badendunum5_07ec7a6d:

    # "Lo ultimo que ves es como varias manos te despedazan."
    "The last thing you see is how several hands are tearing you to pieces."

# game/script.rpy:1939
translate ingles badendunum5_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1941
translate ingles badendunum5_a4677fae:

    # "BAD END: Unum te dejó morir."
    "BAD END: Unum let you die."

# game/script.rpy:1947
translate ingles goodend1_9f6fcbbe:

    # "Atacas a la esencia y puedes escapar."
    "You attack the essence and you can escape."

# game/script.rpy:1948
translate ingles goodend1_8cc3da29:

    # "GOODEND: La paciencia es tu mejor virtud."
    "GOOD END: Patience is your best virtue."

# game/script.rpy:1952
translate ingles nogogogo_517cb31c:

    # "Hacen intercambio de esencias"
    "Hacen intercambio de esencias"

# game/script.rpy:1955
translate ingles gogogo_bd8dc9af:

    # "Hacen el gogogo."
    "Hacen el gogogo."

