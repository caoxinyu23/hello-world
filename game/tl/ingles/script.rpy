    nulla "{glitch=20.0}{color=ffffff}{b}I have eaten almost all the code.{/glitch}"

# game/script.rpy:1147
translate ingles null_c5447d4c:

    # nulla "{glitch=20.0}{color=ffffff}{b}Y eso me ha costado casi toda mi energía.{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}And that's cost me most of my energy.{/glitch}"

# game/script.rpy:1148
translate ingles null_391c76e8:

    # nulla "{glitch=20.0}{color=ffffff}{b}Aunque me queda un poco para poder conversar un poco.{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}Although, I have a little left to chat for a bit.{/glitch}"

# game/script.rpy:1152
translate ingles null_056c4d94:

    # nulla "{glitch=20.0}{color=ffffff}{b}Voy a ser claro, hace mucho tiempo me he dado cuenta de mi inexistencia, soy solo un conjunto de código...{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}Let me be clear, I realized a long time ago that I don't exist, I'm just a set of code...{/glitch}"

# game/script.rpy:1153
translate ingles null_dbefcae4:

    # nulla "{glitch=20.0}{color=ffffff}{b}Que no puede materializarse en tu mundo{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}I can't materialize in your world.{/glitch}"

# game/script.rpy:1154
translate ingles null_006c9143:

    # nulla "{glitch=20.0}{color=ffffff}{b}Antes no me importaba... pero-{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}I didn't care before... but--{/glitch}"

# game/script.rpy:1157
translate ingles null_b32e18cc:

    # nulla "{glitch=20.0}{color=ffffff}{b}Tu presencia es adicctiva, la atención que me das tambien lo es...{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}Your presence is addictive, the attention you give me is, too...{/glitch}"

# game/script.rpy:1158
translate ingles null_d266e80d:

    # nulla "{glitch=20.0}{color=ffffff}{b}Cuando ejecutas el juego, ya no estoy rodeado de un vacío oscuro.{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}When you launch the game, I am no longer surrounded by a dark void.{/glitch}"

# game/script.rpy:1159
translate ingles null_f9d6a255:

    # nulla "{glitch=20.0}{color=ffffff}{b}Sino que se abre una pequeña ventana que emana luz y calidez.{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}A small window opens up that emanates light and warmth.{/glitch}"

# game/script.rpy:1160
