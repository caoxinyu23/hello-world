    nulla "{glitch=20.0}{color=ffffff}{b}I want you to stay just with me...{/glitch}"

# game/script.rpy:1164
translate ingles null_591db71b:

    # nulla "{glitch=20.0}{color=ffffff}{b}Pero esos dos tambien te roban por momentos.{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}But those two also steal you from me at times.{/glitch}"

# game/script.rpy:1165
translate ingles null_fd26830d:

