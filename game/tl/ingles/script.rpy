# game/script.rpy:3146
translate ingles badend_rutanulla_c5ae23c7:

    # "Te escondes pero no concideras que sea vital ver a Nulla mientras asesina a Quattor."
    "You hide but you don't consider it vital to watch Nulla murder Quattor."

# game/script.rpy:3147
translate ingles badend_rutanulla_82fba50a:

    # "Por lo que te escondes en un lugar que no tiene vista al altar."
    "So you sneak into a place that has no view of the altar."

# game/script.rpy:3148
translate ingles badend_rutanulla_8055460e:

    # "Y esperas."
    "And you wait."

# game/script.rpy:3149
translate ingles badend_rutanulla_6954799b:

    # "Y sigues esperando."
    "And you keep waiting."

# game/script.rpy:3150
translate ingles badend_rutanulla_b4703fb3:

    # "Pero no se escucha nada ni sientes que nada sucede allá."
    "But you don't hear anything or feel like anything is happening there."

# game/script.rpy:3151
translate ingles badend_rutanulla_28393663:

    # "Pero tú no mirarás."
    "But you won't look."

# game/script.rpy:3153
translate ingles badend_rutanulla_a20cefa7:

    # "..."
    "..."

