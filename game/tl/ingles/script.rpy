translate ingles null_8c56d910:

    # nulla "{glitch=20.0}{color=ffffff}{b}Me ha costado mucho meterme al codigo y cambiarlo.{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}It cost me a lot to get into the code and change it.{/glitch}"

# game/script.rpy:1142
translate ingles null_3b93574e:

    # nulla "{glitch=20.0}{color=ffffff}{b} Pero al final lo he podido hacer...{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b} But in the end, I was able to do it...{/glitch}"

# game/script.rpy:1145
translate ingles null_959379f4:

    # nulla "{glitch=20.0}{color=ffffff}{b}Lastima que no tengo mucha energía por ahora...{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}Too bad I don't have much energy right now...{/glitch}"

# game/script.rpy:1146
translate ingles null_71030bbb:

