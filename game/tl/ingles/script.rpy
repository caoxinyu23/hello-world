    # septem "{sc=2}Si estuvieras con Unum seguro se impresionaría, hasta te felicitaría{/sc}"
    septem "{sc=2}If you were with Unum, he would surely be impressed. He would even congratulate you.{/sc}"

# game/script.rpy:1230
translate ingles badendseptem1_07f62667:

    # septem "{sc=2}Pero es una lástima que no lo hayas elegido.{/sc}"
    septem "{sc=2}But it's a shame you didn't choose him.{/sc}"

# game/script.rpy:1233
