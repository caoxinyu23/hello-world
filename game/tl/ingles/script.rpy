translate ingles badendseptem1_fe570012:

    # "Dicho aquello, te preparas para correr a donde se ubican las escaleras, seguramente habrá una salida cerca."
    "Having said that, you prepare to run to where the stairs are located; surely there's an exit nearby."

# game/script.rpy:1214
translate ingles badendseptem1_651f6de2:

    # "Al intentar correr te das cuenta de que algo va mal"
    "When you try to run, you realize something's wrong."

# game/script.rpy:1215
translate ingles badendseptem1_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1216
translate ingles badendseptem1_dd10d184:

    # "No estás avanzando."
    "You are not moving forward."

# game/script.rpy:1217
translate ingles badendseptem1_04bebc19:

    # "Es como si corrieras en una caminadora invisible."
    "It's like you're running on an invisible treadmill."

# game/script.rpy:1220
translate ingles badendseptem1_31924e0f:

    # septem "..."
    septem "{sc=2}...{/sc}"

