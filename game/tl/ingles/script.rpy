# game/script.rpy:924
translate ingles rutaunum_989646bc:

    # "Unum espera un buen rato antes de hablar, decide comenzar a cortar el pedazo de carne que haz traido anteriormente."
    "Unum waits a long time before speaking, deciding to start cutting the piece of meat that you brought earlier."

# game/script.rpy:987
translate ingles rutaunum_3c476486:

    # "Unum espera un buen rato antes de comenzar a cortar el pedazo de carne que haz traido anteriormente, el cual seguramente ya ha de estar frío."
    "Unum waits a long time before starting to cut the piece of meat you brought earlier, which must surely already be cold."

# game/script.rpy:1158
translate ingles rutaunum_c498cdb0:

    # unum "Camina detrás de mí y no te separes, mis esposas les gusta venir a mi residencia para relajarse."
    unum "Walk behind me and don't stray, my wives like to come to my residence to relax."

# game/script.rpy:1577
translate ingles rutaunum_4791df49:

    # "Algo te raspa la garganta."
    "Something scratches your throat."

# game/script.rpy:1688
translate ingles menuexplorar1_nulla_6131593b:

    # "Recorres el lugar pero no hay nada."
    "You walk around but there's nothing."

# game/script.rpy:1895
translate ingles menuexplorar1_nulla_b62fd4bb:

    # "Y hoy no tienes ganas de morir..."
    "And today you don't feel like dying..."

# game/script.rpy:1905
translate ingles menuexplorar1_nulla_7116b3a0:

    # "{glitch=30.0}{color=ffffff}{b}Haré como que ha sido un desliz del mouse{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}I'll pretend it was a slip of the mouse.{b}{/color}"

# game/script.rpy:2050
translate ingles menuexplorar2_nulla_02e37a14:

    # "Nulla se escapa como el maldito cobarde que es."
    "Nulla runs away like the damn coward he is."

# game/script.rpy:2203
translate ingles menupuertas2_acdb7f6e:

    # "Supones que la sala del vacío es esa habitación completamente negra."
    "You assume the Void room is that pitch-black room."

# game/script.rpy:3241
translate ingles badend_rutanulla_7e04cb06:

    # "Hay una mujer que está parada detrás tuyo, mirando con disgusto tu figura."
    "There is a woman standing behind you, looking with disgust at your figure."

# TODO: Translation updated at 2024-09-22 17:16

# game/script.rpy:1047
translate ingles rutaunum_55f4557c:

    # "La sensación de unas manos acariciándote la cara, te invitan a dejar tu subconsciente."
    "The sensation of hands caressing your face invites you to leave your subconscious."

# game/script.rpy:1051
translate ingles rutaunum_d8bbff36:

    # "... No sabes cuanto tiempo has estado inconsciente."
    "... You don't know how long you've been unconscious."

# game/script.rpy:1621
translate ingles rutaunum_59b17607:

    # "El aire que entra a tus pulmones no es suficiente como para mantenerte consciente."
    "The air that enters your lungs is not enough to keep you conscious."

# game/script.rpy:1623
translate ingles rutaunum_1c3bd392:

    # "... Caes inconsciente."
    "... You fall unconscious."

# game/script.rpy:2799
translate ingles badend_septem4_1350a197:

    # septem "Estoy consciente de que eres un ser superior..."
    septem "I am aware that you are a higher being..."

# TODO: Translation updated at 2024-09-24 23:31

# game/script.rpy:188
translate ingles start_dcef8919:

    # el "Después de lo que pasó con el último, realmente espero que tú dures más tiempo."
    el "After what happened to the last one, I really hope you last longer."

# game/script.rpy:306
translate ingles start_9ac8c5b2:

    # fames "La única diferencia es que apesta a humano. Tal vez eso les guste a los 7."
    fames "The only difference is that it reeks of human. Maybe the seven of them will like that."

# game/script.rpy:336
translate ingles start_41b1ac09:

    # "también Fames te ha instruido que la comida deberá estar puesta en la mesa antes de que ellos lleguen."
    "Fames has also instructed you that the food must be set on the table before they arrive."

# game/script.rpy:337
translate ingles start_a84b98b1:

    # "Ahora te encuentras sin supervisión."
    "You are now unsupervised."

# game/script.rpy:578
translate ingles start_8ceee29f:

    # "Nulla se ve descolocado por tu elección. Pero rápidamente se dispone a contestar."
    "Nulla looks unsettled by your choice, but he quickly prepares a response."

# game/script.rpy:706
translate ingles respuesta6_14ae300d:

    # "La mirada de Nulla se vuelve vacía por un segundo para ser reemplazada rápidamente por unos ojos llenos de asombro."
    "Nulla's gaze turns blank for a second, only to be quickly replaced by eyes filled with wonder."

# game/script.rpy:856
translate ingles rutaunum_56f2707a:

    # "{sc=2}Bien, lo has hecho bien...{/sc}"
    "{sc=2}Well, you've done well...{/sc}"

# game/script.rpy:871
translate ingles rutaunum_91cbe79f:

    # "En cuestión de segundos dejas de ver a Septem y a Nulla, quedándote solamente con Unum en la mesa."
    "In a matter of seconds, Septem and Nulla disappear from sight, leaving you with only Unum at the table."

# game/script.rpy:974
translate ingles rutaunum_15e4e08b:

    # "Hablas hasta por los codos sin darte cuenta, piensas que es como si estuvieras hablando con un amigo que comparte tus extraños gustos."
    "You're talking a mile a minute without realizing it; you think it's like you're chatting with a friend who shares your strange tastes."

# game/script.rpy:976
translate ingles rutaunum_86472204:

    # "Llega un punto en que parloteas tanto, que piensas que se te va a enredar la lengua."
    "It reaches a point where you chatter so much that you think your tongue is going to get tangled."

# game/script.rpy:983
translate ingles rutaunum_b756e6fa:

    # "Si es que ya no lo has hecho."
    "If you haven't already done it."

# game/script.rpy:1068
translate ingles rutaunum_b391b3e7:

    # "Está tan inmaculado el lugar que no se ve real."
    "The place is so immaculate that it doesn't look real."

# game/script.rpy:1149
translate ingles rutaunum_c7359941:

    # unum "Aunque Septem también lo hace todo el tiempo. Las veces que he estado en su dominio, él se sienta en la mesa en las mañanas, tardes y noches a comer."
    unum "Although, Septem does it all the time, too. When I've been in his domain, he sits at the table in the mornings, afternoons, and nights to eat."

# game/script.rpy:1151
translate ingles rutaunum_74831caa:

    # unum "Nulla también lo hace a veces... tal vez esa sea la razón por la que son tan fuertes los dos..."
    unum "Nulla also does it sometimes... maybe that's why they are both so strong..."

# game/script.rpy:1202
translate ingles rutaunum_e6dff3dd:

    # "Okay, crees saber a lo que se refiere. Claramente son panqueques por la descripción dada."
    "Okay, you think you know what he's referring to. Clearly, it's pancakes based on the given description."

# game/script.rpy:1228
translate ingles rutaunum_3626f2e0:

    # unum "Es fascinante..."
    unum "It's fascinating..."

# game/script.rpy:1259
translate ingles rutaunum_61b7d2a7:

    # "Le dices tantas cosas de manera errática que ni siquiera procesas que tipo de información o datos del cuerpo humano le estás soltando."
    "You tell him so many things erratically that you don't even process what kind of information or data about the human body you're throwing at him."

# game/script.rpy:1269
translate ingles rutaunum_71534866:

    # "Te preparas mentalmente para que te arranque la extremidad con sus propios dientes.."
    "You mentally prepare yourself for him to tear off the limb with his own teeth..."

# game/script.rpy:1289
translate ingles rutaunum_cde5e9c0:

    # "No tiene que decirlo explícitamente para saber que se refiere a que no te ha podido comer allá en el hotel. Y supones que tampoco pudo comer el remplazo que Madre les dio a los demás, seguramente por quedarse aquí contigo."
    "He doesn't have to say it explicitly for you to know that he means he couldn't eat you in the hotel. And you assume that he couldn't eat the replacement that Mother gave to the others, probably because he was staying here with you."

# game/script.rpy:1308
translate ingles rutaunum_ab48979e:

    # "Aunque te gustaría saber cual es tu verdadero propósito aquí."
    "Although you would like to know what your true purpose is here."

# game/script.rpy:1315
translate ingles rutaunum_c1e4a1b5:

    # "En ese caso... realmente prefieres que te mate de una buena vez. Después de todo, puedes volver a intentar sobrevivir con Septem... {glitch=20.0}{color=ffffff}{b}o Nulla{/glitch}"
    "In that case... you really hope that he just kills you once and for all. Then you can try to survive again with Septem... {glitch=20.0}{color=ffffff}{b}or Nulla.{/glitch}"

# game/script.rpy:1365
translate ingles rutaunum_bf6f87cf:

    # "Y lo encuentras sentado en la orilla de la cama. Mirándote con los ojos bien abiertos."
    "And you find him sitting on the edge of the bed, staring at you with wide eyes."

# game/script.rpy:1486
translate ingles rutaunum_0e736271:

    # "...Probablemente Unum no esté pensando en lo que tu estabas pensando, después de todo, Unum no es humano..."
    "... Unum's probably not thinking what you were thinking; after all, Unum isn't human..."

# game/script.rpy:1546
translate ingles rutaunum_9f031e45:

    # "{sc=4}{b}Dentro de ti hay veneno que se está esparciendo de a poco.{b}{/sc}"
    "{sc=4}{b}Inside you, there's poison spreading little by little.{b}{/sc}"

# game/script.rpy:1553
translate ingles rutaunum_96714744:

    # "Despiertas repentinamente, sintiendo una gota de sudor frío recorriendo tu cuello."
    "You wake up suddenly, feeling a drop of cold sweat running down your neck."

# game/script.rpy:1555
translate ingles rutaunum_384981a8:

    # "Y lo primero que te encuentras es a Unum mirándote de cerca, casi que inspeccionándote."
    "And the first thing you see is Unum looking at you closely, almost inspecting you."

# game/script.rpy:1571
translate ingles rutaunum_46c95e4f:

    # "Pero lo único que sale de tu boca son pétalos color rojo, mezlados con sangre."
    "But the only thing that comes out of your mouth are red petals, mixed with blood."

# game/script.rpy:1638
translate ingles rutaunum_3f2aeed3:

    # "Abres los ojos y lo primero que ves es a una entidad desconocida, la cual te tiene con una mano agarrando de los hombros, mientras que con la otra mano toca cuidadosamente tu estómago."
    "You open your eyes and the first thing you see is an unknown entity that has one hand holding you by the shoulders, the other hand carefully touching your stomach."

# game/script.rpy:1641
translate ingles rutaunum_cb395708:

    # "Tu estómago se revuelve nuevamente cuando la mano de la entidad aprieta con suavidad una zona en específico."
    "Your stomach churns again as the entity's hand gently squeezes a specific area."

# game/script.rpy:1709
translate ingles menuexplorar1_nulla_0ad50b2c:

    # "Nulla aparece detrás tuyo, lo que provoca que te tome desprevenido y pegues un salto."
    "Nulla appears behind you, catching you off guard and making you jump."

# game/script.rpy:1757
translate ingles menuexplorar1_nulla_45e395ae:

    # "No pasan más de 5 segundos cuando sientes tus pies tocar nuevamente el suelo. Y mientras el vacío se disipa puedes apreciar como de apoco se van construyendo estruccturas y paisajes a tu alrededor."
    "Not more than five seconds pass when you feel your feet touch the ground again. And as the emptiness dissipates, you can see how structures and landscapes gradually start to form around you."

# game/script.rpy:1804
translate ingles menuexplorar1_nulla_c978a422:

    # nulla "Absolutamente nada, no habría consecuencias reales ni pérdida real."
    nulla "Absolutely nothing; there would be no real consequences or real loss."

# game/script.rpy:1821
translate ingles menuexplorar1_nulla_8d40d5e6:

    # nulla "Solo esas malditas opciones de diálogo."
    nulla "Just those damned dialogue options."

# game/script.rpy:1842
translate ingles menuexplorar1_nulla_f0a5fdb9:

    # "Cuando ya estás por caer en una especie de hipnosis, sientes como Nulla coloca su mano sobre la tuya para llamar tu atención."
    "When you're about to fall into a kind of hypnosis, you feel Nulla placing his hand over yours to get your attention."

# game/script.rpy:1843
translate ingles menuexplorar1_nulla_3494a918:

    # "La aprieta con suma delicadeza antes de abre la boca."
    "He squeezes it gently before opening his mouth."

# game/script.rpy:1886
translate ingles menuexplorar1_nulla_09578e5d:

    # "Simplemente quieres mirar el lugar... conocer bien el lugar en donde te encuentras."
    "You just want to look around... know where you are well."

# game/script.rpy:1949
translate ingles menuexplorar2_nulla_9580903f:

    # nulla "Pero es imposible también."
    nulla "But that's also impossible."

# game/script.rpy:1956
translate ingles menuexplorar2_nulla_286370bb:

    # "Nulla se tira a la cama, boca arriba mientras ambas manos atrapan parte de las sábanas para mantenerlas en un agarre permanente."
    "Nulla throws himself onto the bed, lying on his back while both hands grip the sheets tightly."

# game/script.rpy:1963
translate ingles menuexplorar2_nulla_2f7691a5:

    # nulla "Pero también quiero dejar en ridículo al creador."
    nulla "But I also want to make a fool of the Creator."

# game/script.rpy:1964
translate ingles menuexplorar2_nulla_edd7eafb:

    # nulla "Utilizar a mi favor su regreso para destruirlo todo."
    nulla "Use their return to my advantage to destroy everything."

# game/script.rpy:1972
translate ingles menuexplorar2_nulla_4ab62bf2:

    # "Comienzas a sospechar que mientras más dejar hablar a Nulla, más abres una ventana para que él tenga una catarsis."
    "You start to suspect that the more you let Nulla talk, the more you open a window for him to have a catharsis."

# game/script.rpy:2047
translate ingles menuexplorar2_nulla_9e2a39c3:

    # nulla "Bueno--- Si no lo haces tú, tendré que recurrir a medidas más drásticas."
    nulla "Well--if you don't do it, I'll have to resort to more drastic measures."

# game/script.rpy:2054
translate ingles menuexplorar2_nulla_2c371b7b:

    # "Pasa un tiempo en donde recorres la casa para pasar el rato."
    "Some time passes as you roam the house."

# game/script.rpy:2111
translate ingles menuexplorar2_nulla_42886d19:

    # "Realmente sientes curiosidad por el estado del dominio de Nulla y estarías mintiendo si dijieras que no te gustaría caminar por el vacío que lo rodea."
    "You really feel curious about the state of Nulla's domain, and you'd be lying if you said you wouldn't like to walk through the Void that surrounds it."

# game/script.rpy:2151
translate ingles menupuertas2_951256a2:

    # ell "¿Tienes los documentos?"
    ell "Do you have the documents?"

# game/script.rpy:2329
translate ingles menupuertas_24988fcc:

    # ell "también estás siendo controlado por un ser superior..."
    ell "You're also being controlled by a higher being..."

# game/script.rpy:2465
translate ingles menuexplorar_62207c52:

    # "Vuelves a la cocina y revuelves todo el lugar en busca de algún cuchillo."
    "You go back to the kitchen and look around the place for knives."

# game/script.rpy:2496
translate ingles menunulla_loop1_cbb21a3f:

    # nulla "Por lo que la única manera de someterlo es pronunciando su nombre."
    nulla "So the only way to subdue him is by pronouncing his name."

# game/script.rpy:2505
translate ingles menunulla_loop1_c64d79de:

    # nulla "Sí, después de todo, tú solo eres alguien que toma prestado un cuerpo."
    nulla "Yes, after all, you're just someone borrowing a body."

# game/script.rpy:2595
translate ingles menupreguntas_2bc74461:

    # septem "después de todo Madre puede hacer otro recipiente"
    septem "After all, Mother can make another vessel."

# game/script.rpy:2629
translate ingles badend_cena_e6e12dab:

    # "Y lo único que puedes hacer es escuchar y respirar con dificultad."
    "And all you can do is listen and breathe with difficulty."

# game/script.rpy:2632
translate ingles badend_cena_5474c6ce:

    # "Al terminar, lo único que sientes es como Nulla toca tu alma destrozada..."
    "When it's over, the only thing you feel is Nulla touching your shattered soul..."

# game/script.rpy:2675
translate ingles badendseptem1_0b1f17e3:

    # septem "{sc=2}La única regla aquí es respetar a tus rangos mayores.{/sc}"
    septem "{sc=2}The only rule here is to respect your superiors.{/sc}"

# game/script.rpy:2726
translate ingles badendseptem2_0b1f17e3:

    # septem "{sc=2}La única regla aquí es respetar a tus rangos mayores.{/sc}"
    septem "{sc=2}The only rule here is to respect your superiors.{/sc}"

# game/script.rpy:2781
translate ingles badend_septem3_13c35509:

    # septem "Después de todo, madre puede hacer otra marioneta."
    septem "After all, Mother can make another puppet."

# game/script.rpy:2854
translate ingles badend_septem6_6d2a5adf:

    # "después de un tiempo prudente, vuelves a tu objetivo: Escapar."
    "After a reasonable amount of time, you return to your goal: escaping."

# game/script.rpy:2993
translate ingles badendunum2_248a2aeb:

    # "Pero no puede ser tan fácil, seguro debe tener algún modo de detectar lo que estás haciendo..."
    "But it can't be that easy; he must have some way of detecting what you're doing..."

# game/script.rpy:3007
translate ingles badendunum2_60adbddb:

    # "4 zancadas alcanzas a dar después de cruzar la puerta cuando caes sintiendo un dolor punzante debajo de tus rodillas."
    "You manage to take four strides out the door when you fall, feeling a sharp pain beneath your knees."

# game/script.rpy:3026
translate ingles badendunum3_6781792b:

    # "Lágrimas se acumulan en tus ojos por el pánico que se empieza a formar en tu cuerpo."
    "Tears well up in your eyes and a panic begins to form inside you."

# game/script.rpy:3117
translate ingles badendunum5_f792e45a:

    # "Aproximadamente alcanzas a dar 10 pasos después de cruzar la puerta cuando caes sintiendo un dolor punzante debajo de tus rodillas."
    "You're about ten steps out the door when you fall, feeling a stabbing pain beneath your knees."

# game/script.rpy:3239
translate ingles badend_rutanulla_f1a47234:

    # "Miras rápidamente arriba para ver de quien se trata."
    "You quickly look up to see who it is."

translate ingles strings:

    # game/script.rpy:1249
    old "Entrar en pánico y suplicar por tu vida"
    new "Panic and beg for your life."

    # game/script.rpy:2136
    old "Buscar a la marioneta de Septem."
    new "Look for Septem's puppet."

    # game/script.rpy:2540
    old "¿Cómo sabes del vínculo que tenemos {sc=3}yo{/sc} y [nombrejugador]?"
    new "How do you know about the bond that {sc=3}me{/sc} and [nombrejugador] have?"

# TODO: Translation updated at 2024-09-29 12:05

translate ingles strings:

    # game/script.rpy:199
    old "Escribe tu nombre"
    new "Enter your name."

# TODO: Translation updated at 2025-02-22 21:37

# game/script.rpy:568
translate ingles start_4255c967:

    # "Miras a Nulla, quien al percatarse tal vez de lo que intentas hacer, procede a mover sus manos realizando señas extrañas."
    "You look at Nulla, who, perhaps realizing what you are trying to do, proceeds to move his hands making strange signs."

# TODO: Translation updated at 2025-02-23 19:20

translate ingles strings:

    # game/script.rpy:9
    old "tu"
    new "You"

# TODO: Translation updated at 2025-02-25 00:18

# game/script.rpy:2521
translate ingles menunulla_loop1_0f48a2ce:

    # nulla "créeme que es para mejor."
    nulla "Believe me, it's for the best."

# TODO: Translation updated at 2025-02-27 00:00

# game/script.rpy:95
translate ingles start_a8c0b9c1:

    # "... Nadie nace el día 7. El domingo, el domingo es un día sacro."
    "... No one is born on Sundays. Sundays are a sacred day."

# game/script.rpy:106
translate ingles start_1681a563:

    # "... algo que ya estás acostumbrado supongo."
    "... Something you're already used to, I guess."

# game/script.rpy:2074
translate ingles menuexplorar2_nulla_214f320c:

    # "{b} Las entidades de Duae son curiosas, todas se parecen, pero cada una tiene un propósito único e irremplazable... recuerdo como Duae se jactaba, en tiempos antiguos y más prósperos, de lo devotas y trabajadoras que eran sus estrellas {b}"
    "{b} The entities of Duae are curious. All of them look alike, but each one has a unique and irreplaceable purpose... I remember how she used to brag, in ancient and more prosperous times, about how devoted and hardworking her stars were.{b}"

# game/script.rpy:2080
translate ingles menuexplorar2_nulla_ca0604c5:

    # "{b}Espero que no me resientas por esta acción, pero si quiero borrar todo rastro del creador y tener un propósito que sea impuesto por mi conciencia... mío, y solo mío, tengo que hacer esto.{b}"
    "{b} I hope you do not resent me for this action, but if I want to erase all traces of the Creator and have a purpose that is imposed by my conscience... mine, and mine alone, I have to do this.{b}"

# TODO: Translation updated at 2025-02-27 00:07

translate ingles strings:

    # game/script.rpy:582
    old "Septem."
    new "Septem"

# TODO: Translation updated at 2025-10-05 02:57

# game/script.rpy:88
translate ingles start_cf22fdac:

    # "En el jardín existen 7 estandartes a los cuales se les debe rendir culto. Cada uno representa un concepto ligado a la creación del jardín."
    "In the Garden, there exists seven Symbols to which one must worship. Each one represents a concept linked to the creation of the Garden."

# game/script.rpy:375
translate ingles start_b3955afc:

    # "Ellos te miran, el rubio con corona ridícula te mira de manera expectante, mientras que el pelirrojo te sonríe de oreja a oreja."
    "They gaze at you; the blond with the ridiculous crown looks at you expectantly, while the redhead smiles at you from ear to ear."

# game/script.rpy:487
translate ingles start_f79b9e56:

    # "En cambio, opta por mirarte nuevamente, y cruzándose de brazos sentencia."
    "Instead, he chooses to look at you, and crossing his arms, he says:"

# game/script.rpy:572
translate ingles start_24706bee:

    # "Nulla en cambio, sonríe."
    "Nulla, on the other hand, smiles."

# game/script.rpy:686
translate ingles respuesta4_a1244dd9:

    # "Sin mucho esfuerzo te atraviesa tu caja torácica rompiendo huesos y órganos"
    "His hand pierces your rib cage easily, breaking your bones and organs."

# game/script.rpy:858
translate ingles rutaunum_ffcc3d73:

    # "{sc=2}deberás lograr que te tomen como aprendiz.{/sc}"
    "{sc=2}You must get yourself accepted as an apprentice.{/sc}"

# game/script.rpy:911
translate ingles rutaunum_e0cf9174:

    # "Con cautela te sientas al frente de Unum, quien te soníe de oreja a oreja, feliz de que le hayas hecho caso sin mucha protesta."
    "You sit down in front of Unum, who smiles at you from ear to ear, happy that you listened to him without much complaint."

# game/script.rpy:924
translate ingles rutaunum_23b4708c:

    # "Unum espera un buen rato antes de hablar, decide comenzar a cortar el pedazo de carne que has traído anteriormente."
    "Unum waits a long time before speaking, deciding to start cutting the piece of meat that you brought earlier."

# game/script.rpy:987
translate ingles rutaunum_b8b003be:

    # "Unum espera un buen rato antes de comenzar a cortar el pedazo de carne que has traído anteriormente, el cual seguramente ya ha de estar frío."
    "Unum waits a long time before starting to cut the piece of meat you brought earlier, which must surely already be cold."

# game/script.rpy:1242
translate ingles rutaunum_38103880:

    # unum "SI ATRAVIESO TU PECHO Y TE SACO ALGUNO DE TUS ÓRGANOS QUE NO SEA EL CORAZÓN O EL CEREBRO---"
    unum "IF I BREAK YOUR CHEST AND REMOVE ANY ORGAN OTHER THAN THE HEART OR THE BRAIN--"

# game/script.rpy:1251
translate ingles rutaunum_2bac2d06:

    # "Te rehúsas a dejarte matar."
    "You refuse to be killed."

# game/script.rpy:1478
translate ingles rutaunum_e719e854:

    # "Unum atraviesa su pecho con la mano de manera lenta."
    "Unum slowly runs his hand across his chest."

# game/script.rpy:1490
translate ingles rutaunum_e719e854_1:

    # "Unum atraviesa su pecho con la mano de manera lenta."
    "Unum slowly runs his hand across his chest."

# game/script.rpy:1513
translate ingles rutaunum_e719e854_2:

    # "Unum atraviesa su pecho con la mano de manera lenta."
    "Unum slowly runs his hand across his chest."

# game/script.rpy:1563
translate ingles rutaunum_a5d978a2:

    # unum "¿Está prohibido hacerlo?"
    unum "Is it forbidden to do so?"

# game/script.rpy:1571
translate ingles rutaunum_2a8d3ce1:

    # "Pero lo único que sale de tu boca son pétalos color rojo, mezclados con sangre."
    "But the only thing that comes out of your mouth are red petals, mixed with blood."

# game/script.rpy:1757
translate ingles menuexplorar1_nulla_8056d4f1:

    # "No pasan más de 5 segundos cuando sientes tus pies tocar nuevamente el suelo. Y mientras el vacío se disipa puedes apreciar como de apoco se van construyendo estructuras y paisajes a tu alrededor."
    "Not more than five seconds pass when you feel your feet touch the ground again. And as the emptiness dissipates, you can see how structures and landscapes gradually start to form around you."

# game/script.rpy:1795
translate ingles menuexplorar1_nulla_d76d8f35:

    # nulla "¿Qué crees que pasaría si saco mi pistola y le disparo a alguien de aquí?"
    nulla "What do you think would happen if I pulled out my gun and shot someone here?"

# game/script.rpy:1818
translate ingles menuexplorar1_nulla_bc07e511:

    # nulla "Pero es una lástima que no pueda escucharte... ni tengas la posibilidad de escribirme para poder entenderte."
    nulla "But it's a shame that I can't listen to you... nor do you have the possibility of writing to me so I can understand you."

# game/script.rpy:1946
translate ingles menuexplorar2_nulla_23fc2b95:

    # nulla "Permitirle a Septem seguir con este juego inútil de mantener un mundo destinado a morir en el olvido."
    nulla "Allow Septem to continue this useless game of maintaining a world destined to die into oblivion."

# game/script.rpy:2419
translate ingles menupuertas_5d5ebb58:

    # "Tocas un par de veces, pero no hay respuesta."
    "You knock a few times, but there's no response."

# game/script.rpy:2446
translate ingles menuexplorar_bb147534:

    # "Los pasillos están llenos de pinturas que se enfocan en mostrar la figura humana y la cotidianidad de estos."
    "The hallways are full of paintings that focus on showing the human figure and their everyday life."

# game/script.rpy:2454
translate ingles menuexplorar_2b4e09e8:

    # "Gran parte de las habitaciones dentro de la residencia están bloqueadas, no importa cuánto intentes, no puedes abrir sus puertas."
    "Many of the rooms inside the residence are locked. No matter how hard you try, you can't open their doors."

# game/script.rpy:2613
translate ingles badend_cena_999cd623:

    # "Nulla se ve decepcionado al preguntar por como ha ido. Y rápidamente entiende que no te han tomado como aprendiz."
    "Nulla looks disappointed when asking how it went. And quickly understands that they haven't taken you on as an apprentice."

# game/script.rpy:2622
translate ingles badend_cena_77d1ddae:

    # "Dedos, brazos, piernas y pies son desgarrados de tu cuerpo. Para luego seguir con tus órganos."
    "Fingers, arms, legs, and feet are torn from your body. Then your organs..."

# game/script.rpy:2707
translate ingles badendseptem1_807f2362:

    # "Sientes como te rompen el pecho, una mano hurga dentro tuya en busca de algo en específico."
    "You feel your chest being torn apart, a hand searching through your organs for something specific."

# game/script.rpy:2758
translate ingles badendseptem2_807f2362:

    # "Sientes como te rompen el pecho, una mano hurga dentro tuya en busca de algo en específico."
    "You feel your chest being torn apart, a hand searching through your organs for something specific."

# game/script.rpy:2837
translate ingles badend_septem5_4da4ab2c:

    # "Septem sonríe y te corta la cabeza."
    "Septem smiles and cuts off your head."

# game/script.rpy:2844
translate ingles badend_septem6_3d6ded76:

    # "Te paseas por toda la extensión del templo, mirando cada una de las puertas que son accesibles y cada uno de los ventanales..."
    "You walk around the entire length of the temple, looking at each of the accessible doors and each of the windows..."

# game/script.rpy:2879
translate ingles badend_septem7_2029860b:

    # "Buscas entre tus ropas el cuchillo que has encontrado y antes de siquiera poder sacar el cuchillo, Septem te detiene con su mano mientras chasquea su lengua."
    "You search through your clothes for the knife you found, but before you can even take it out, Septem stops you with his hand while clicking his tongue."

# game/script.rpy:2889
translate ingles badend_septem7_ac7c2d76:

    # "y sonríe..."
    "And he smiles..."

# game/script.rpy:2918
translate ingles badend_unum1_6105d832:

    # "Así que ese tal Unum puede meterse su fantasía extraña por donde le quepa."
    "So this Unum guy can take his strange fantasy and shove it up his ass."

# game/script.rpy:2942
translate ingles badend_unum1_095d17e1:

    # unum "¿De verdad creíste que podrías escapar de una zona sellada?"
    unum "Did you really think you could escape from a sealed area?"

# game/script.rpy:2956
translate ingles badend_unum1_d14ccdca:

    # unum "Soltar a una creación a la carnicería sin siquiera explicarle nada."
    unum "Releases her creation to the butcher shop without even explaining anything to it."

# game/script.rpy:2984
translate ingles badend_unum1_807f2362:

    # "Sientes como te rompen el pecho, una mano hurga dentro tuya en busca de algo en específico."
    "You feel your chest being torn apart, a hand searching through your organs for something specific."

# game/script.rpy:3032
translate ingles badendunum3_5d9e0daa:

    # "Una vez sale una, las demás le siguen en picada. Lágrima tras lágrima salen de tus ojos para recorrer tus mejillas y luego caer en tu ropa y parte del brazo de Unum."
    "Once one comes out, the others follow in a tailspin. Tear after tear pours from your eyes, running down your cheeks and then falling onto your clothes and part of Unum's arm."

# game/script.rpy:3037
translate ingles badendunum3_b65eb005:

    # "Una de las manos de Unum impacta en tu mandíbula, sujetándola con fuerza."
    "One of Unum's hands hits your jaw, gripping it tightly."

# game/script.rpy:3044
translate ingles badendunum3_3fe3cc6c:

    # "Algo duro te atraviesa el pecho y de a poco pierdes la conciencia."
    "Something hard pierces your chest and little by little you lose consciousness."

# game/script.rpy:3061
translate ingles badendunum4_f226619f:

    # "Él deja de moverse. Quedándose completamente quieto."
    "He stops moving. Going completely still."

# game/script.rpy:3062
translate ingles badendunum4_7918c839:

    # "Observas como el cuchillo ha conectado perfectamente en la cabeza del pelirrojo, atravesando el cráneo incluso."
    "You notice how the knife has landed perfectly on the redhead's head, even going through the skull."

# game/script.rpy:3063
translate ingles badendunum4_ca928cba:

    # "Unum sigue sin moverse, por lo que asumes que ha muerto."
    "Unum still doesn't move, so you assume he's dead."

# game/script.rpy:3069
translate ingles badendunum4_17613c83:

    # "Una mano cubre tu agarre del cuchillo, y jalándola con fuerza, extrae el objeto."
    "One hand covers your grip on the knife, and, pulling hard, extracts it."

# game/script.rpy:3079
translate ingles badendunum4_8839559f:

    # "Impacta en el mismo lugar donde tú le has atacado."
    "It hits the same place where you attacked him, on the head."

# game/script.rpy:3167
translate ingles nogogogo_3e6a63e4:

    # unum "Seas capaz o incapaz biológicamente de llevar a una cría en tu cuerpo, no afectará pues no es necesario usarte como un horno."
    unum "Whether you're biologically capable of carrying a baby or not, it won't matter because there's no need to use you as an oven."

# game/script.rpy:3180
translate ingles nogogogo_2488b6d9:

    # unum "Seas capaz o incapaz biológicamente de llevar a una cría en tu cuerpo, no quiero tomar el riesgo de perderte."
    unum "Whether you're biologically capable of carrying a baby or not, I don't want to take the risk of losing you."


# game/script.rpy:3198
translate ingles nogogogo_ab774325:

    # "Pregunta asustado e intenta quitar su mano, pero tú lo detienes."
    "He asks, scared. He tries to remove his hand but you stop him."

translate ingles strings:

    # game/script.rpy:875
    old ">Sentarte e intentar que te tome de aprendiz."
    new "Obey and sit down."

# TODO: Translation updated at 2025-10-10 23:05

# game/script.rpy:2445
translate ingles menuexplorar_c2f1b906:

    # "Recorres todos los pasillos que están disponibles en la residencia, las ventanas escasean y no hay posibilidad de salir por ahí, pues tienen rejas."
    "You walk through all the hallways that are available in the residence. There are few windows, but no possibility of going out of them, because they are barred."

# TODO: Translation updated at 2026-10-18 18:06

# game/script.rpy:1985
translate ingles menuexplorar2_nulla_a52b7bd0:

    # nulla "Me halaga que quieras seguir leyendo mis dilemas existenciales y todo eso."
    nulla "I'm flattered that you want to keep reading my existential dilemmas and all that."

# game/script.rpy:3189
translate ingles nogogogo_ce5115a1:

    # unum "La cría será cultivada dentro de la nueva esencia que se formará."
    unum "The offspring will be cultivated within the new essence that will be formed."

