    # game/rutas/pantallas.rpy:1122
    old "Nulla, tenemos que irnos."
    new "Nulla, we have to go."

    # game/rutas/pantallas.rpy:1206
    old "¿Dónde está Nulla?"
    new "Where is Nulla?"

    # game/rutas/pantallas.rpy:1206
    old "¿Quién te crees para hablarme así?"
