    # septem "..."
    septem "..."

# game/rutas/pantallas.rpy:674
translate ingles humanos_8235e8a2:

    # "Hay solo una estrella en esta esfera..."
    "There's only one star in this sphere..."

# game/rutas/pantallas.rpy:675
translate ingles humanos_fd19acb3:

    # "No brilla tanto como las demás, y tiene un pulso lento."
    "It doesn't shine as brightly as the others, and its pulse is slow."

# game/rutas/pantallas.rpy:676
translate ingles humanos_cc2dee24:

    # "Se ve fatal."
    "It looks terrible."

# game/rutas/pantallas.rpy:677
translate ingles humanos_44946446:

    # "Y Septem no dice nada, solo la mira en silencio. Con una expresión que parece querer romperse en pedazos."
    "And Septem says nothing... just stares at it in silence, his expression on the verge of breaking apart."

# game/rutas/pantallas.rpy:678
translate ingles humanos_6f5847c4:

    # "Es pena."
    "It's sorrow."

# game/rutas/pantallas.rpy:685
translate ingles septimo_e4453a77:

    # "Este es el dominio de Septem, si te fijas bien, no hay rastro alguno de súbditos."
