    septem "You're enjoying this more than I thought..."

# game/rutas/pantallas.rpy:483
translate ingles ala_9729cd83:

    # septem "Agradece que ahora mismo estoy cumpliendo mi palabra y estamos probando tus manos..."
    septem "Be grateful that I'm keeping my word and letting you test your hands right now..."

# game/rutas/pantallas.rpy:484
translate ingles ala_96f05303:

    # septem "Si no fuera por eso, no tendrías el derecho de tocarme."
    septem "If it weren't for that, you wouldn't have the right to touch me."

# game/rutas/pantallas.rpy:485
