# game/rutas/pantallas.rpy:686
translate ingles septimo_1fcbd51c:

    # "Solamente tu alma y la de Septem se encuentran dentro del dominio."
    "Only your soul and Septem's exist within this space."

# game/rutas/pantallas.rpy:687
