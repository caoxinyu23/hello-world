    # septem "..."
    septem "..."

# game/rutas/pantallas.rpy:563
translate ingles pez_06925d42:

    # "Septem mira los peces en silencio."
    "Septem watches the fish in silence."

# game/rutas/pantallas.rpy:564
translate ingles pez_4bd31a71:

    # septem "Me gustaría tener más cosas en mi jardín..."
    septem "I wish I had more things in my garden..."

# game/rutas/pantallas.rpy:565
translate ingles pez_22c82db2:

    # septem "Entidades vivas... no simplemente energía."
    septem "Living beings... not just energy."

# game/rutas/pantallas.rpy:566
translate ingles pez_29f30d2b:

    # "No comenta nada después de eso. Ambos observan las pequeñas figuras de energía en silencio."
    "He doesn't say anything after that. You both watch the little energy figures in silence."

# game/rutas/pantallas.rpy:572
translate ingles place_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/pantallas.rpy:573
translate ingles place_8145a900:

    # septem "En otra ocasión iremos allá."
    septem "We'll go there another time."

# game/rutas/pantallas.rpy:574
translate ingles place_dfd35f84:

    # septem "Hoy no..."
    septem "Not today..."

# game/rutas/pantallas.rpy:575
translate ingles place_25d78c10:

    # septem "No quiero ir allá hoy..."
    septem "I don't want to go there today..."

# game/rutas/pantallas.rpy:581
translate ingles cuerpo_adc11a4a:

    # "Septem toma aire, soltando todo el estrés acumulado."
    "Septem takes a deep breath, releasing all the tension he'd been holding."

# game/rutas/pantallas.rpy:582
translate ingles cuerpo_626b6814:

    # septem "Ya me encuentro mejor"
    septem "I feel better now."

# game/rutas/pantallas.rpy:583
translate ingles cuerpo_41d7164e:

    # septem "¿Quieres volver al templo?"
    septem "Do you want to go back to the temple?"


# game/rutas/pantallas.rpy:586
translate ingles cuerpo_cd037468:

    # septem "Okay..."
    septem "Alright..."

# game/rutas/pantallas.rpy:597
translate ingles interactuar3_05312b73:

    # "Septem junta ambas manos y recita unas palabras en latín."
    "Septem clasps both hands together and recites a few words in Latin."

# game/rutas/pantallas.rpy:599
translate ingles interactuar3_43a7f616:

    # "Al terminas su cántico ambos se transportan a un lugar puro, manchado solamente por ustedes dos."
    "When his chant ends, both of you are transported to a pure place, stained only by your presence."

# game/rutas/pantallas.rpy:600
translate ingles interactuar3_265dc507:

    # septem "Venir aquí siempre me calma."
    septem "Coming here always calms me."

# game/rutas/pantallas.rpy:601
translate ingles interactuar3_0bc6d2a4:

    # "Dice al aire, no esperando a obtener una respuesta tuya, Septem hace una señal con las manos."
    "He says it into the air, not expecting a reply. Then, Septem gestures with his hands."

# game/rutas/pantallas.rpy:602
translate ingles interactuar3_4baf1bd2:

    # "Una esfera del tamaño de una pelota comienzan a emerger del suelo, levitando hasta estar al frente de tu campo de visión."
    "A sphere, the size of a ball, begins to rise from the ground, levitating until it hovers before your eyes."

# game/rutas/pantallas.rpy:603
translate ingles interactuar3_82e04db9:

    # "A esa se le suman dos, luego tres. Hasta tener 8 esferas rodeando tu espacio y el de Septem."
    "Then another appears, and another, until eight spheres surround the space you share with Septem."

# game/rutas/pantallas.rpy:604
translate ingles interactuar3_6f6195f8:

    # septem "Puedes tocarlas si deseas."
    septem "You may touch them, if you wish."

# game/rutas/pantallas.rpy:615
translate ingles sol_a726d244:

    # septem "Ese es el dominio del Sol, Unum ahora mismo está en la residencia de sus 'esposas'."
    septem "That's the Sun's domain. Unum is currently at the residence of his 'wives.'"

# game/rutas/pantallas.rpy:616
translate ingles sol_252914d7:

    # "Septem apunta a la estrella de ocho puntas de color rojo, la cual está al lado de tres estrellas más pequeñas."
    "Septem points toward the red, eight-pointed star beside three smaller ones."

# game/rutas/pantallas.rpy:617
translate ingles sol_32b8840f:

    # septem "El resto---"
    septem "The rest--"

# game/rutas/pantallas.rpy:618
translate ingles sol_fbffe205:

    # "Septem mueve su dedo a las otras estrellas que se reparten en el resto de la esfera, son un montón."
    "Septem moves his finger across the other stars scattered throughout the sphere. There are many."

# game/rutas/pantallas.rpy:619
translate ingles sol_eafeb89c:

    # septem "Son sus súbditos."
    septem "They are his subjects."

# game/rutas/pantallas.rpy:625
translate ingles estrella_0196bb8c:

    # septem "Aquí reside Duae..."
    septem "Here resides Duae..."

# game/rutas/pantallas.rpy:626
translate ingles estrella_0f7c3ab4:

    # septem "Siempre está trabajando, entrenando a sus estrellas."
    septem "She's always working, training her stars."

# game/rutas/pantallas.rpy:627
translate ingles estrella_e6b3c6b1:

    # septem "Ahí está ella."
    septem "There she is."

# game/rutas/pantallas.rpy:628
translate ingles estrella_8d2b6878:

    # "Septem guia tu mano con la suya, en búsqueda de Duae. Te das cuenta de que ella es la estrella de ocho puntas más grande de la zona."
    "Septem guides your hand with his, leading it toward Duae. You realize she's the largest eight-pointed star in the area."

# game/rutas/pantallas.rpy:629
translate ingles estrella_605fd595:

    # septem "Es uno de los pocos dominios que aún no presenta problemas."
    septem "It's one of the few domains that hasn't shown any signs of trouble."

# game/rutas/pantallas.rpy:630
translate ingles estrella_0f47939e:

    # septem "Y todo el mérito lo tiene ella."
    septem "All thanks to her."

# game/rutas/pantallas.rpy:636
translate ingles luna_b19ee29a:

    # septem "Este es Quattor..."
    septem "This one is Quattor..."

# game/rutas/pantallas.rpy:637
translate ingles luna_955e3284:

    # septem "Es uno de los dominios más bellos."
    septem "It's one of the most beautiful domains."

# game/rutas/pantallas.rpy:643
translate ingles planta_a56650ae:

    # septem "Es un dominio muerto."
    septem "It's a dead domain."

# game/rutas/pantallas.rpy:644
translate ingles planta_35c0248a:

    # septem "No queda mucho de él.."
    septem "There's not much left of it..."

# game/rutas/pantallas.rpy:645
translate ingles planta_88cc6d90:

    # septem "Y Tria no puede hacer nada hasta que el Jardín mejore."
    septem "And Tria can't do anything until the Garden heals."

# game/rutas/pantallas.rpy:646
translate ingles planta_c526478d:

    # septem "Hemos hablado, y luego de mucho buscar, Tria asumió que la maldición es autoimpuesta."
    septem "We've talked, and after much searching, Tria came to the conclusion that the curse is self-inflicted."

# game/rutas/pantallas.rpy:647
translate ingles planta_1daf35bf:

    # septem "La maldición seguirá hasta que ella sane."
    septem "It will remain until she heals."

# game/rutas/pantallas.rpy:651
translate ingles planta_e83233af:

    # "Septem te observa en silencio antes de contestar."
    "Septem watches you in silence before answering."

# game/rutas/pantallas.rpy:652
translate ingles planta_7ed130df:

    # septem "Todo fruto producido en el Jardín contiene un veneno y le pertenece a Tria."
    septem "Every fruit born from the Garden carries poison and belongs to Tria."

# game/rutas/pantallas.rpy:653
translate ingles planta_e7b702c1:

    # septem "No pueden ser comidos a menos que rompas su sello."
    septem "They can't be eaten unless you break their seal."

# game/rutas/pantallas.rpy:654
translate ingles planta_a20cefa7:

    # "..."
    "..."

# game/rutas/pantallas.rpy:655
translate ingles planta_69f73bf9:

    # "Sientes un poco de pena por la situación. Supones que ella no puede controlar su pena o rabia, entonces su estado emocional afecta a su dominio de esta manera."
    "You feel a bit of sorrow for her situation. You assume she can't control her grief or anger, so her emotional state shapes her domain this way."

# game/rutas/pantallas.rpy:656
translate ingles planta_709fa0cd:

    # "Que complicado. Ahora ves que el Jardín no tiene un solo problema."
    "How complicated. Now you see the Garden doesn't have a single problem."

# game/rutas/pantallas.rpy:657
translate ingles planta_0b7fb937:

    # "Sino que es un cúmulo de cosas que se entrelazan y afectan tanto a nivel micro como macro."
    "Rather, it's a web of many things--intertwined, and affecting everything from the smallest to the grandest scale."

# game/rutas/pantallas.rpy:658
translate ingles planta_bd97b024:

    # "El Jardín es como si de un cuerpo enfermo se tratase, del cual sus partes vitales hacen lo que pueden para mantenerlo con vida... agonizando."
    "The Garden feels like a sick body, its vital parts doing all they can to keep it alive... barely."

# game/rutas/pantallas.rpy:659
translate ingles planta_cd03b3e7:

    # "Pero esa defensa no es suficiente. Necesitan ayuda de un agente externo."
    "But that defense isn't enough. The Garden needs help from an external agent."

# game/rutas/pantallas.rpy:660
translate ingles planta_7301c83a:

    # "Una medicina, una píldora que les de lo justo y necesario para volver a retomar sus funciones."
    "A medicine: A pill that grants it just enough of what they need to resume its function."

# game/rutas/pantallas.rpy:665
translate ingles animales_e7e8987a:

    # "En esta esfera, hay dos estrellas de ocho puntas."
    "In this sphere, there are two eight-pointed stars."

# game/rutas/pantallas.rpy:666
translate ingles animales_f4874508:

    # septem "A Quinque le hace falta ayuda... por eso Tria pasa la mayor parte del tiempo ahí."
    septem "Quinque needs help... that's why Tria spends most of her time there."

# game/rutas/pantallas.rpy:667
translate ingles animales_3d3db5f4:

    # septem "Cada vez que vengo, lo veo sanando a algún animal."
    septem "Every time I visit, I see him healing some animal."

# game/rutas/pantallas.rpy:668
translate ingles animales_a1d62cf5:

    # septem "La maldición de Tria no se detendrá."
    septem "Tria's curse won't stop."

# game/rutas/pantallas.rpy:673
