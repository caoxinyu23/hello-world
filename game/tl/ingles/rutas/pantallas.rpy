    # game/rutas/pantallas.rpy:536
    old "Comprendo."
    new "I see."

    # game/rutas/pantallas.rpy:536
    old "¿No te gustaría intentalo ahora?"
    new "Wouldn't you like to try it now?"

    # game/rutas/pantallas.rpy:648
    old "¿Qué maldición?"
    new "What curse?"

    # game/rutas/pantallas.rpy:688
    old "¿Dónde está Rafael?"
    new "Where is your puppet?"

    # game/rutas/pantallas.rpy:695
    old "Sí..."
    new "Yes..."

    # game/rutas/pantallas.rpy:695
    old "Wait..."
    new "Wait..."

    # game/rutas/pantallas.rpy:710
    old "¿Qué? ¡no!"
    new "What? No!"


    # game/rutas/pantallas.rpy:743
    old "Quiero ver otras opciones..."
    new "I want to see other options..."

    # game/rutas/pantallas.rpy:975
    old "Ya no quiero esto."
    new "I don't want this anymore."

    # game/rutas/pantallas.rpy:1023
    old "¿Qué es este lugar?"
    new "What is this place?"

    # game/rutas/pantallas.rpy:1036
    old "¿Qué sientes cuando hago click en el ícono?"
    new "What do you feel when I click on the icon?"

    # game/rutas/pantallas.rpy:1036
    old "Quiero quedarme aquí, contigo."
    new "I want to stay here, with you."

    # game/rutas/pantallas.rpy:1057
    old "Me gusta estar contigo."
    new "I like being with you."

    # game/rutas/pantallas.rpy:1057
    old "Llévame a tu ruta."
    new "Take me to your route."

    # game/rutas/pantallas.rpy:1057
    old "Quiero quedarme aquí."
    new "I want to stay here."

    # game/rutas/pantallas.rpy:1057
    old "Volver..."
