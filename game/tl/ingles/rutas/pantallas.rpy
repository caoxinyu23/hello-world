    old "Decir que no es lo que él piensa."
    new "Tell him it's not what he thinks."

    # game/rutas/pantallas.rpy:1992
    old "Llevame a tu ruta"
    new "Take me to your route."

    # game/rutas/pantallas.rpy:1996
    old "Quiero pasar el tiempo contigo."
