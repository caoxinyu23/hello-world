# game/rutas/pantallas.rpy:1050
translate ingles septem_icono_b7899885:

    # septem "Tienes que volver, salvador mío."
    septem "You have to come back, my savior."

# game/rutas/pantallas.rpy:1172
translate ingles memorias_neo_7eecc8cd:

    # "Ves cómo Nulla es engullido por la masa negra. Su cuerpo pierde la forma y se consume por completo."
    "You watch as Nulla is swallowed by the black mass. His body loses its shape and is completely consumed."

# game/rutas/pantallas.rpy:1223
translate ingles memorias_neo_b2feabf6:

    # neo "Pero si te quedai' puedo entretenerte un rato mientras hago lo que necesito hacer."
    neo "But if you stick around, I can keep you entertained while I do what I gotta do."

# game/rutas/pantallas.rpy:1233
translate ingles memorias_neo_5b84d528:

    # "Esperas a que Neo te explique pero él solo sonríe."
    "You wait for Neo to explain, but he just smiles."

# game/rutas/pantallas.rpy:1262
translate ingles memorias_neo_480453ef:

    # "Neo acomoda su corbata, tomándose un buen tiempo en hacerlo. Es como si realmente no le importa lo más mínimo lo que está pasando."
    "Neo adjusts his tie, taking his sweet time doing so. It's as if he genuinely couldn't care less about what's happening."

# game/rutas/pantallas.rpy:1767
translate ingles interactuar6_3a01de78:

    # "Creo que puedes tocarme ahora..."
    "I think you can touch me now..."

# game/rutas/pantallas.rpy:1782
translate ingles boca_e55d0abe:

    # septem "¿Mi boca?"
    septem "My mouth?"

# game/rutas/pantallas.rpy:1783
translate ingles boca_f5d33edc:

    # "Septem arquea las cejas. Hay un tono meloso que sale junto a su pregunta, uno el cual no es completamente sincero, como si estuviera jugando contigo."
    "Septem raises his eyebrows. There's a syrupy sweetness to his question, one that doesn't sound entirely sincere, as though he's playing with you."

# game/rutas/pantallas.rpy:1784
translate ingles boca_71cdc569:

    # "Se acerca un poco más a ti, hundiendo la cama en el proceso. Tan cerca que sientes el calor de su cuerpo."
    "He moves a little closer to you, making the mattress sink beneath his weight. Close enough for you to feel the warmth of his body."

# game/rutas/pantallas.rpy:1785
translate ingles boca_6d306874:

    # septem "¿Qué es lo que podrías querer de mi boca?"
    septem "What could you possibly want from my mouth?"

# game/rutas/pantallas.rpy:1786
translate ingles boca_70143052:

    # "Se toca los labios con las yemas de sus dedos, acariciando lentamente la zona."
    "He touches his lips with his fingertips, slowly caressing them."

# game/rutas/pantallas.rpy:1787
translate ingles boca_17b6b39f:

    # septem "¿Hmm?"
    septem "Hmm?"

# game/rutas/pantallas.rpy:1788
translate ingles boca_e0414740:

    # "Su pregunta es todo menos inocente. Septem finge ingenuidad para ponerte en una posición donde debas explicar tus deseos."
    "His question is anything but innocent. Septem feigns naivety to put you in a position where you have to explain your desires."

# game/rutas/pantallas.rpy:1789
translate ingles boca_b5710fc0:

    # "Aunque con su actuar no deja entrar ningún tipo de duda con sus intenciones, o hacia dónde quiere llegar con esto. A pesar de estar jugando al tonto y obtener una respuesta clara por parte tuya."
    "Yet his behavior leaves no doubt about his intentions or where he wants this to lead... even as he plays dumb, trying to get a clear answer out of you."

# game/rutas/pantallas.rpy:1790
translate ingles boca_44413773:

    # "Te espera por unos segundos antes de interrumpir nuevamente. No pudiendo evitar provocarte un poquito más, mientras su sonrisa no hace más que crecer."
    "He waits a few seconds before interrupting again, unable to resist teasing you a little more as his smile only grows wider."

# game/rutas/pantallas.rpy:1791
translate ingles boca_ea0dd373:

    # septem "Sé que lo has estado esperando."
    septem "I know you've been waiting for it."

# game/rutas/pantallas.rpy:1792
translate ingles boca_20095416:

    # septem "¿O he malinterpretado todo?"
    septem "Or have I misunderstood everything?"

# game/rutas/pantallas.rpy:1793
translate ingles boca_64710233:

    # septem "¿Qué es lo que quieres?"
    septem "What is it that you want?"

# game/rutas/pantallas.rpy:1800
translate ingles boca_0f5341b8:

    # "Se lo dices, lo suficientemente fuerte como para que él pueda escuchar."
    "You tell him, loudly enough for him to hear."

# game/rutas/pantallas.rpy:1801
translate ingles boca_6b561671:

    # septem "¿Qué has dicho?"
    septem "What did you say?"

# game/rutas/pantallas.rpy:1802
translate ingles boca_bc3c17a6:

    # septem "¿Puedes repetirlo?"
    septem "Could you repeat that?"

# game/rutas/pantallas.rpy:1806
translate ingles boca_71a387c7:

    # "Lo repites una vez más, un poco más alto para asegurarte que Septem no vuelva a tomarte el pelo."
    "You repeat yourself, a little louder to make sure Septem can't tease you again."

# game/rutas/pantallas.rpy:1807
translate ingles boca_e7a056a2:

    # septem "Hmmm."
    septem "Hmmm."

# game/rutas/pantallas.rpy:1810
translate ingles boca_672d6e07:

    # "Complacido con tus palabras, las comisuras de sus labios dibujan una sonrisa triunfante."
    "Pleased with your words, the corners of his lips curl into a triumphant smile."

# game/rutas/pantallas.rpy:1815
translate ingles boca_0175da75:

    # "Septem ríe, gozando con tu frustración."
    "Septem laughs, delighting in your frustration."

# game/rutas/pantallas.rpy:1819
translate ingles boca_bf571c33:

    # "Antes de que puedas enojarte por como Septem te está tratando, él termina de eliminar el espacio que hay entre ustedes."
    "Before you can get angry at the way Septem is treating you, he closes the remaining distance between you."

# game/rutas/pantallas.rpy:1820
translate ingles boca_b5e4a5be:

    # "Una de sus manos toca tu muslo, deslizándose hasta tu cintura, marcando un ritmo lento. Su mano te centra, tranquiliza y conecta con su imponente presencia."
    "One of his hands touches your thigh, slowly sliding up to your waist. His touch grounds you, soothes you, and connects you to his imposing presence."

# game/rutas/pantallas.rpy:1821
translate ingles boca_fec10881:

    # "Es un plácido toque que anuncia la llegada de un próximo beso."
    "It's a gentle, soothing touch that promises a kiss to come."

# game/rutas/pantallas.rpy:1822
translate ingles boca_9f9e0c9c:

    # "Septem te espera, dejando que seas tú quien comience, haciéndose de rogar por ti, sin borrar esa sonrisa petulante que lleva puesta desde que le has hecho saber tus deseos."
    "Septem waits for you, letting you be the one to make the first move. He's playing hard to get with that smug smirk on his face, the one he's been wearing ever since you made your desires known."

# game/rutas/pantallas.rpy:1824
translate ingles boca_7ba81aa7:

    # "Cierras los ojos y eres tú quien busca cerrar el contacto."
    "You close your eyes and take it upon yourself to close the distance."

# game/rutas/pantallas.rpy:1825
translate ingles boca_ef771046:

    # "Su beso es suave, seguido por otros más, lentos y cuidadosos, temiendo a no sobrepasarse y tomar de más."
    "His kiss is gentle, followed by several more; slow and careful, as though he's afraid of going too far and taking more than he should."

# game/rutas/pantallas.rpy:1826
translate ingles boca_169a674c:

    # "Pero le es dicífil."
    "But he finds it difficult."

# game/rutas/pantallas.rpy:1827
translate ingles boca_93e84186:

    # "Septem no es la deidad más correcta, ni la más recta. Jamás lo fue. Por lo que con un suspiro de tu parte, en medio del beso, lo toma para profundizar el beso."
    "Septem isn't the most proper or virtuous of deities. He never was. So when a sigh escapes your lips in the middle of the kiss, he takes it as an opportunity to deepen it."

# game/rutas/pantallas.rpy:1828
translate ingles boca_1f36cf1f:

    # "Hambriento de tu boca, te devora con una insistencia desbordante, como si quisiera dominar todo tu ser."
    "Hungry for your mouth, he devours you with overwhelming insistence, as though he wants to dominate your entire being."

# game/rutas/pantallas.rpy:1829
translate ingles boca_010abfd0:

    # "Sus manos buscan el calor de tu cuerpo, esperando a tener un contacto más cercano de lo que ya tiene. Quiere más, al punto de que temes a que te desgarre la carne en el proceso."
    "His hands seek the warmth of your body, yearning for an even closer contact than he already has. He wants more--so much more that you fear he might tear your flesh apart in the process."

# game/rutas/pantallas.rpy:1830
translate ingles boca_fad70b1f:

    # "Hay un pensamiento fugaz que pasa por tu mente; que sus dientes no solo busquen tus labios o lengua de forma temporal, y decidan romper la tierna carne de tu cara como trofeo personal."
    "A fleeting thought crosses your mind: His teeth might not settle for your lips or tongue, but instead decide to tear through the tender flesh of your face as a personal trophy."

# game/rutas/pantallas.rpy:1831
translate ingles boca_6e714cc4:

    # "El solo pensarlo, hace que te retuerzas, sin saber si te aterra o te ilusiona."
    "The mere thought makes you squirm, unsure whether it terrifies or excites you."

# game/rutas/pantallas.rpy:1832
translate ingles boca_069d3b8d:

    # "La única respuesta clara es que todo es intoxicante, llegando a nublarte el juicio. Su calor, su olor e incluso su corazón, todo lo que te rodea es Septem."
    "The only thing you know for certain is that it's all intoxicating, enough to cloud your judgment... his warmth, his scent, even his heartbeat. Everything surrounding you is Septem."

# game/rutas/pantallas.rpy:1833
translate ingles boca_6604c825:

    # "Cuando quedas sin aire, Septem se aleja, mordiendo tu labio en el proceso."
    "When you run out of breath, Septem pulls away, tugging on your lip with his teeth in the process."

# game/rutas/pantallas.rpy:1837
translate ingles boca_a20cefa7:

    # "..."
    "..."

# game/rutas/pantallas.rpy:1843
translate ingles boca_a0751253:

    # "Tragas saliva y sientes el sabor metálico en tu lengua."
    "You swallow and taste something metallic on your tongue."

# game/rutas/pantallas.rpy:1844
translate ingles boca_c4ba30f2:

    # septem "No debí darte tantas características humanas..."
    septem "I shouldn't have given you so many human traits..."

# game/rutas/pantallas.rpy:1845
translate ingles boca_ad3c6fd0:

    # "Sus dedos atrapan tus mejillas, provocando que sus labios se abran y muestren el interior de tu boca."
    "His fingers force your lips apart, exposing the inside of your mouth."

# game/rutas/pantallas.rpy:1846
translate ingles boca_94d55c7a:

    # "Septem observa la zona, teniendo control total de tu mandíbula para moverla de lado a lado."
    "Septem examines the area, taking complete control of your jaw as he moves it from side to side."

# game/rutas/pantallas.rpy:1847
translate ingles boca_168b1299:

    # "Buscando cualquier daño, solo es encuentra con una pequeña herida en el interior de tu labio inferior."
    "Searching for any damage, he finds only a small wound on the inside of your lower lip."

# game/rutas/pantallas.rpy:1848
translate ingles boca_153682f0:

    # septem "Lo bueno es que puedo reconstruir cualquier parte de tu cuerpo si me llego a emocionar de más."
    septem "The good thing is that I can reconstruct any part of your body if I get a little too carried away."

# game/rutas/pantallas.rpy:1849
translate ingles boca_c2a73d1c:

    # "Septem sonríe con picardía."
    "Septem smiles mischievously."

# game/rutas/pantallas.rpy:1850
translate ingles boca_db8cbe90:

    # "Luego suspira."
    "Then he sighs."

# game/rutas/pantallas.rpy:1856
translate ingles boca_a8dda79b:

    # septem "¿Feliz?"
    septem "Happy?"

# game/rutas/pantallas.rpy:1857
translate ingles boca_10c2dcfd:

    # septem "¿Será que con solo un beso Mi Creador ha quedado satisfecho?"
    septem "Could it be that a single kiss was enough to satisfy My Creator?"

# game/rutas/pantallas.rpy:1865
translate ingles boca_f5e91222:

    # "Septem ríe."
    "Septem laughs."

# game/rutas/pantallas.rpy:1866
translate ingles boca_3ce41e49:

    # septem "Lo suponía."
    septem "I thought so."

# game/rutas/pantallas.rpy:1872
translate ingles boca_a20cefa7_1:

    # "..."
    "..."

# game/rutas/pantallas.rpy:1873
translate ingles boca_0afab7d6:

    # septem "¿Y qué es lo que quieres entonces?..."
    septem "Then what is it that you want...?"

# game/rutas/pantallas.rpy:1874
translate ingles boca_1e97c822:

    # septem "Mi boca está para complacerte... ya sea con palabras o --- cualquier cosa que estimes conveniente."
    septem "My mouth is here to please you... whether with words or--anything else you see fit."

# game/rutas/pantallas.rpy:1875
translate ingles boca_60685f7b:

    # septem "Supongo que me he equivocado."
    septem "I suppose I was mistaken."

# game/rutas/pantallas.rpy:1876
translate ingles boca_31540dc9:

    # septem "Mil disculpas."
    septem "My sincerest apologies."

# game/rutas/pantallas.rpy:1877
translate ingles boca_b71f58e7:

    # "Septem se aleja un poco, dándote espacio personal y un respiro."
    "Septem moves back a little, giving you some personal space and room to breathe."

# game/rutas/pantallas.rpy:1880
translate ingles boca_00ceb5e9:

    # septem "No más."
    septem "No more."

# game/rutas/pantallas.rpy:1881
translate ingles boca_fb13d6f2:

    # septem "¿Entendido?"
    septem "Understood?"

# game/rutas/pantallas.rpy:1887
translate ingles mano_558dac1b:

    # "Tomas su mano. Es cálida."
    "You take his hand. It's warm."

# game/rutas/pantallas.rpy:1889
translate ingles mano_099aa8ca:

    # "Por un tiempo, Septem te permite sostener y entrelazar sus dedos con los tuyos. Posando su mirada en el punto donde ambos conectan."
    "For a while, Septem allows you to hold his hand and intertwine his fingers with yours. His gaze settles on the place where your hands meet."

# game/rutas/pantallas.rpy:1890
translate ingles mano_24f6aeee:

    # "Se siente algo íntimo."
    "It feels somewhat intimate."

# game/rutas/pantallas.rpy:1891
translate ingles mano_3a6aa048:

    # septem "Estas manos jamás puedan ser una representación perfecta de las tuyas."
    septem "These hands could never be a perfect representation of yours."

# game/rutas/pantallas.rpy:1892
translate ingles mano_94ec9e0d:

    # septem "Al menos esto es lo más cercano que tengo de tenerte conmigo."
    septem "At least this is the closest I can come to having you here with me."

# game/rutas/pantallas.rpy:1893
translate ingles mano_47e20634:

    # septem "Con eso me contento."
    septem "I'm content with that."

# game/rutas/pantallas.rpy:1894
translate ingles mano_5bc72adf:

    # septem "Tu presencia es más que suficiente, Mi Creador."
    septem "Your presence is more than enough, My Creator."

# game/rutas/pantallas.rpy:1900
translate ingles ojito_d6965b15:

    # septem "Prefiero mi halo original... pero-"
    septem "I prefer my original halo... but---"

# game/rutas/pantallas.rpy:1901
translate ingles ojito_871819c2:

    # septem "Con esto será más fácil cumplir con la petición de Madre."
    septem "This will make it easier to fulfill Mother's request."

# game/rutas/pantallas.rpy:1902
translate ingles ojito_b11d77d1:

    # septem "Puedo forzarlos a cerrarse para siempre."
    septem "I can force them to close forever."

# game/rutas/pantallas.rpy:1903
translate ingles ojito_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/pantallas.rpy:1904
translate ingles ojito_2f87dac6:

    # septem "Si eso es lo que deseas, Mi Creador."
    septem "If that is what you desire, My Creator."

# game/rutas/pantallas.rpy:1909
translate ingles corazon_15a4b039:

    # septem "¿Quieres mi corazón?"
    septem "Do you want my heart?"

# game/rutas/pantallas.rpy:1910
translate ingles corazon_97b15435:

    # "Uh..."
    "Uh..."

