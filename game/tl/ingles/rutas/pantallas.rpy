    # game/rutas/pantallas.rpy:1406
    old "Tus alas..."
    new "Your wings..."

    # game/rutas/pantallas.rpy:1406
    old "Ese broche..."
    new "That brooch..."

    # game/rutas/pantallas.rpy:1476
    old "¿Padre?..."
    new "Father?..."

    # game/rutas/pantallas.rpy:1485
    old "Quedarme."
    new "Stay."

    # game/rutas/pantallas.rpy:1485
    old "Irme."
