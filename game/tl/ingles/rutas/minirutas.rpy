    # centered "¿Qué haces aquí?...."
    centered "What are you doing here...?"

# game/rutas/minirutas.rpy:722
translate ingles rutaneo_3c3288cf:

    # centered "Ah- lo viste..."
    centered "Ah--you saw it..."

# game/rutas/minirutas.rpy:723
translate ingles rutaneo_c7525693:

    # centered "Uhg..."
    centered "Uhg..."

# game/rutas/minirutas.rpy:728
translate ingles rutaneo_d2341e78:

    # centered "Eh- supongo que así nació todo."
    centered "Eh--I guess that's how it all began."

# game/rutas/minirutas.rpy:729
translate ingles rutaneo_96cbcec8:

    # centered "Bravoooo---"
    centered "Bravoooo..."

# game/rutas/minirutas.rpy:730
translate ingles rutaneo_8ab00a3b:

    # "Escupe cada sílaba con asco, fingiendo falsa alegría."
    "He spits out each syllable with disgust, feigning enthusiasm."

# game/rutas/minirutas.rpy:731
translate ingles rutaneo_1862e6f7:

    # centered "Encontramos el origen del mal de Nulla~"
    centered "We found the source of Nulla's affliction~"

# game/rutas/minirutas.rpy:732
translate ingles rutaneo_9f626e09:

    # centered "Yujuu----"
    centered "Yippee----"

# game/rutas/minirutas.rpy:733
translate ingles rutaneo_da4d4f87:

    # extend "----------uhg."
    extend "----------uhg."

# game/rutas/minirutas.rpy:735
translate ingles rutaneo_819e986a:

    # neo "El muy hijo de las re-mil putas ni siquiera me dio nada."
    neo "Ese hijo de las re-mil putas didn't even give me anything."

# game/rutas/minirutas.rpy:736
translate ingles rutaneo_985c06de:

    # neo "Solo me hizo dudar de mi todo."
    neo "Just made me question everything about myself."

# game/rutas/minirutas.rpy:737
translate ingles rutaneo_783550ef:

    # neo "Terminé yendo con Grimal, él me dijo que ella me lo diría..."
    neo "I ended up going to Grimal. He told me she'd tell me..."

# game/rutas/minirutas.rpy:740
translate ingles rutaneo_7e8a5ab8:

    # neo "Fui un estúpido."
    neo "I was an idiot."

# game/rutas/minirutas.rpy:741
