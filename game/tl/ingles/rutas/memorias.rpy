# game/rutas/memorias.rpy:196
translate ingles memoriasnulla_2b51553b:

    # "Otros eran un poco más lúgubres y penosos, llenos de detalles pero sin habitantes."
    "Others were gloomier, filled with details but completely uninhabited."

# game/rutas/memorias.rpy:197
translate ingles memoriasnulla_9c1e1e56:

    # "Los demás eran solo bocetos... nada le servía."
    "The rest were just sketches... nothing was useful."

# game/rutas/memorias.rpy:199
translate ingles memoriasnulla_89000676:

