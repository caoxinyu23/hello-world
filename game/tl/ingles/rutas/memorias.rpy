translate ingles memoriasnulla_5ef75397:

    # "Llegan a una mesa que tiene un montón de fruta. Pero eso no es lo que te llama la atenció, no... lo que captura tus ojos son 3 pares de alas que envuelven tu visión, tapando toda la luz que el cielo tiene para ofrecer."
    "You reach a table full of fruit. But that's not what catches your attention, no... what captures your gaze are three pairs of wings surrounding your vision, blocking out all the light the sky has to offer."

# game/rutas/memorias.rpy:255
translate ingles memoriasnulla_5e74ae57:

    # r "¡Hermano! ¿Te parece si tenemos un combate?"
    r "Brother! How about we have a match?"

# game/rutas/memorias.rpy:256
translate ingles memoriasnulla_57ae800d:

    # r "Zadkiel me ha dicho que hoy tienes el día libre, ¡oh!"
    r "Zadkiel told me you have the day off today, oh!"

# game/rutas/memorias.rpy:257
translate ingles memoriasnulla_6b1cbd47:

    # "Rafael posa su mirada en tus ojos mientra suelta su florete."
    "Rafael locks eyes with you as he lowers his rapier."

# game/rutas/memorias.rpy:258
translate ingles memoriasnulla_37409baa:

    # r "¿Has traído un prototipo al banquete?"
    r "Did you bring a prototype to the banquet?"

# game/rutas/memorias.rpy:260
translate ingles memoriasnulla_bb0412b7:

    # "Las alas de Michael dejan de rodearte para que Rafael pueda inspeccionarte. Coloca sus manos en tus mejillas y las masajea no creyendo lo que ve."
    "Michael's wings withdraw from around you so Rafael can take a closer look. He places his hands on your cheeks and massages them, unable to believe what he's seeing."

# game/rutas/memorias.rpy:262
translate ingles memoriasnulla_a09c53d6:

    # r "¿Lo podemos tocar?"
    r "Can we touch it?"

# game/rutas/memorias.rpy:264
translate ingles memoriasnulla_27b578bf:

    # m "Nuestro Señor lo ha traído, para la inauguración del mundo."
    m "Our Lord has brought them for the world's inauguration."

# game/rutas/memorias.rpy:268
translate ingles memoriasnulla_3875d311:

    # z "Supongo que quiere que tengamos contacto con uno antes inaugurar el mundo."
    z "I suppose He wants us to interact with one before inaugurating the world."

# game/rutas/memorias.rpy:269
translate ingles memoriasnulla_270996ad:

    # m "Puede ser..."
    m "Could be..."

# game/rutas/memorias.rpy:272
translate ingles memoriasnulla_a756127e:

    # z "Aún falta para el banquete, ¿qué planeas hacer con el humano mientras?"
    z "There's still time before the banquet. What do you plan to do with the human until then?"

# game/rutas/memorias.rpy:273
translate ingles memoriasnulla_8f3d0d9f:

    # m "El Señor no me ha dado instrucciones."
    m "The Lord has given me no instructions."

# game/rutas/memorias.rpy:276
translate ingles memoriasnulla_eb478055:

    # r "Yo puedo ocuparme de él mientras tú descansas, Michael."
    r "I can take care of them while you rest, Michael."

# game/rutas/memorias.rpy:279
translate ingles memoriasnulla_548ce025:

    # z "Yo me voy, tengo cosas que hacer."
    z "I'm leaving, I have things to do."

# game/rutas/memorias.rpy:281
translate ingles memoriasnulla_a749e486:

    # "Supones que Zadkiel no tiene interés en cuidarte..."
    "You assume Zadkiel has no interest in looking after you..."

# game/rutas/memorias.rpy:282
translate ingles memoriasnulla_442f380b:

    # m "¿Qué dices?"
    m "What do you say?"

# game/rutas/memorias.rpy:283
translate ingles memoriasnulla_65469551:

    # "Michael se vuelve hacia ti con una sonrisa serena, irradiando calma en todo momento."
    "Michael turns to you with a serene smile, radiating calm at all times."

# game/rutas/memorias.rpy:284
translate ingles memoriasnulla_b329612a:

    # m "¿Quieres ir con Rafael?"
    m "Do you want to go with Rafael?"

# game/rutas/memorias.rpy:287
translate ingles memoriasnulla_d0a1d5fa:

    # m "Jaja-- Okay okay."
    m "Haha--okay, okay."

# game/rutas/memorias.rpy:288
translate ingles memoriasnulla_4a9aa1ed:

    # m "Rafael, ve a entrenar mientras, yo iré contigo luego de un rato."
    m "Rafael, go train for now. I'll join you in a bit."

# game/rutas/memorias.rpy:291
translate ingles memoriasnulla_6e078bcf:

    # r "¡Si señor!"
    r "Yes, sir!"

# game/rutas/memorias.rpy:293
translate ingles memoriasnulla_592aca46:

    # "Michael te lleva al lago, y mientras observa el agua moverse, él te habla de sus días."
    "Michael takes you to the lake, and as he watches the water ripple, he tells you about his days."

# game/rutas/memorias.rpy:294
translate ingles memoriasnulla_7fa1c8d7:

    # "Su voz es serena, calmada y tiene un efecto embriagador sobre ti. hace que lo quieras seguir escuchando."
    "His voice is serene, calm, and has a mesmerizing effect on you. It makes you want to keep listening."

# game/rutas/memorias.rpy:295
translate ingles memoriasnulla_793abce2:

    # "Hasta que Michael calla por un prolongado tiempo."
    "Until Michael falls silent for a long moment."

# game/rutas/memorias.rpy:297
translate ingles memoriasnulla_703a2d48:

    # m "...¿Eres de otro mundo cierto?"
    m "... You're from another world, aren't you?"

# game/rutas/memorias.rpy:298
translate ingles memoriasnulla_a20cefa7:

    # "..."
    "..."

# game/rutas/memorias.rpy:301
translate ingles memoriasnulla_7b87214b:

    # "Al confirmarle su sospecha, Michael pierde su sonrisa."
    "Upon confirming his suspicion, Michael loses his smile."

# game/rutas/memorias.rpy:302
translate ingles memoriasnulla_41baa8e6:

    # "Para reemplazarla con una expresión de decepción."
    "... Replacing it with an expression of disappointment."

# game/rutas/memorias.rpy:304
translate ingles memoriasnulla_273d7c08:

    # m "Ya veo..."
    m "I see..."

# game/rutas/memorias.rpy:307
translate ingles memoriasnulla_72346a43:

    # m "Mis disculpas... pensé--"
    m "My apologies... I thought--"

# game/rutas/memorias.rpy:309
translate ingles memoriasnulla_c5f7e398:

    # m "No, no es nada."
    m "No, it's nothing."

# game/rutas/memorias.rpy:313
translate ingles memoriasnulla_4173a109:

    # m "Hmmm..."
    m "Hmmm..."

# game/rutas/memorias.rpy:314
translate ingles memoriasnulla_4c1abd2a:

    # "Supones que Michael puede inferir la respuesta a partir de tu silencio."
    "You assume that Michael can infer the answer from your silence."

# game/rutas/memorias.rpy:316
translate ingles memoriasnulla_10fd488d:

    # "Pasan el resto del día conversando de trivialidades y te das cuenta de que la compañía de Michael trae a tu ser mucha tranquilidad."
    "The rest of the day is spent in trivial conversation, and you realize that Michael's company brings you great tranquility."

# game/rutas/memorias.rpy:319
translate ingles memoriasnulla_6ed29a53:

    # m "Okay, necesito que estén aquí para el anochecer."
    m "Okay, I need you here by dusk."

# game/rutas/memorias.rpy:320
translate ingles memoriasnulla_f9de7d22:

    # m "No tarden, no quiero que el señor tenga que esperar por ustedes..."
    m "Don't take too long; I don't want the Lord to have to wait for you..."

# game/rutas/memorias.rpy:321
translate ingles memoriasnulla_2cc036cb:

    # r "¡Entendido!"
    r "Understood!"

# game/rutas/memorias.rpy:323
translate ingles memoriasnulla_4f299a40:

    # "Rafael te lleva a una colina cercana, desde aquí puedes ver el resto del lugar. Es una isla flotante, rodeadas por nubes."
    "Rafael takes you to a nearby hill, from where you can see the entire area. It's a floating island, surrounded by clouds."

# game/rutas/memorias.rpy:324
translate ingles memoriasnulla_a025e6f7:

    # "El paisaje es hermoso."
    "The scenery is beautiful."

# game/rutas/memorias.rpy:325
translate ingles memoriasnulla_20debede:

    # "Rafael pregunta por tu fisiología, y con cada pregunta parecen salir otras dos más."
    "Rafael inquires about your physiology, and with each question, two more seem to arise."

# game/rutas/memorias.rpy:326
translate ingles memoriasnulla_8ea73bfe:

    # "Es curioso y no tiene reparos en mostras esa curiosidad."
    "He's curious and doesn't hesitate in showing it."

# game/rutas/memorias.rpy:328
translate ingles memoriasnulla_041e66a7:

    # "Mientras más preguntas, más te dan ganas de preguntar a ti también. Y sus alas, que parecen ser más suaves de lo que aparentan, no ayudan."
    "The more questions he asks, the more you feel compelled to ask your own. And his wings, which appear softer than they seem, don't help."

# game/rutas/memorias.rpy:329
translate ingles memoriasnulla_3abaa1e0:

    # r "Oh!, puedes tocar mis alas si deseas"
    r "Oh! You can touch my wings if you wish."

# game/rutas/memorias.rpy:330
translate ingles memoriasnulla_3da6ecb4:

    # "Rafael se ha dado cuenta de tus deseos."
    "Rafael noticed your desires."

# game/rutas/memorias.rpy:331
translate ingles memoriasnulla_3642137b:

    # "Así qué accedes con un poco de verguenza de haber sido atrapado."
    "So you agree, a bit embarrassed at being caught."

# game/rutas/memorias.rpy:332
translate ingles memoriasnulla_40ae477d:

    # "Pasan el resto del día conversando de trivialidades y te das cuenta de que Rafael es un ser muy emocional y sensible."
    "The rest of the day is spent in trivial conversation, and you realize that Rafael is a very emotional and sensitive being."

# game/rutas/memorias.rpy:337
translate ingles memoriasnulla_7f105d29:

    # m "¿Nulla?"
    m "Nulla?"

# game/rutas/memorias.rpy:338
translate ingles memoriasnulla_32689209:

    # m "...No tengo registros de nadie llamado así..."
    m "... I have no records of anyone by that name..."

# game/rutas/memorias.rpy:339
translate ingles memoriasnulla_143cd3ee:

    # r "¿Será otro prototipo?"
    r "Could it be another prototype?"

# game/rutas/memorias.rpy:340
translate ingles memoriasnulla_270996ad_1:

    # m "Puede ser..."
    m "It could be..."

# game/rutas/memorias.rpy:341
translate ingles memoriasnulla_d2fd5a22:

    # "Pasan el resto del día conversando de trivialidades con ambos guardianes."
    "The rest of the day passes in trivial conversation with both guardians."

# game/rutas/memorias.rpy:344
translate ingles memoriasnulla_85cfaca2:

    # "Cuando cae la noche, el lugar de encuentro está vacío... Solo estás tú, Rafael y Michael. No hay rastro de nadie más."
    "When night falls, the meeting place is empty... it's just you, Rafael, and Michael. There's no sign of anyone else."

# game/rutas/memorias.rpy:346
translate ingles memoriasnulla_9f2ea475:

    # "Los minutos pasan. 15 tal vez más, hasta que en la distancia un estruendo rompe el silencio."
    "Minutes pass--maybe fifteen or so--until a distant crash shatters the silence."

# game/rutas/memorias.rpy:348
translate ingles memoriasnulla_fa620d0f:

    # "Michael levanta la cabeza de inmediato, alerta. Sus alas se despliegan con rapidez y su florete se materializa en su mano."
    "Michael immediately lifts his head, alert. His wings spread quickly, and his rapier materializes in his hand."

# game/rutas/memorias.rpy:349
translate ingles memoriasnulla_d8398386:

    # m "Rafael, ve a buscar a los demás."
    m "Rafael, go fetch the others."

# game/rutas/memorias.rpy:350
translate ingles memoriasnulla_dd80f267:

    # "Te mira con preocupación antes de hablar."
    "He looks at you with concern before speaking."

# game/rutas/memorias.rpy:351
translate ingles memoriasnulla_ce44e453:

    # m "Tú quédate aquí. Esta es una zona segura."
    m "You stay here. This is a safe zone."

# game/rutas/memorias.rpy:353
translate ingles memoriasnulla_066aa992:

    # "Haces caso sin protestar."
    "You obey without protest."

# game/rutas/memorias.rpy:354
translate ingles memoriasnulla_1eccfc94:

    # "Al menos por un tiempo."
    "At least for a while."

# game/rutas/memorias.rpy:355
translate ingles memoriasnulla_8f75b919:

    # "Pero cuando sientes que han tardado demasiado, la inquietud te carcome y te comanda a moverte. Decides salir en busca de alguno de los guardianes."
    "But when you feel they've taken too long, unease gnaws at you and compels you to move. You decide to go in search of one of the guardians."

# game/rutas/memorias.rpy:356
translate ingles memoriasnulla_30fd8220:

    # "Avanzas a paso lento, hasta que algo capta tu atención."
    "You move forward slowly, until something catches your attention."

# game/rutas/memorias.rpy:358
translate ingles memoriasnulla_3f5c08a9:

    # "El vacío."
    "The Void."

# game/rutas/memorias.rpy:359
translate ingles memoriasnulla_c722f68b:

    # "Hay rastros del vacío en este lugar."
    "There are traces of the Void in this place."

# game/rutas/memorias.rpy:360
translate ingles memoriasnulla_09f45afe:

    # "Nulla está cerca."
    "Nulla is nearby."

# game/rutas/memorias.rpy:361
translate ingles memoriasnulla_400bd3bb:

    # "Sin dudarlo, corres, siguiendo las partículas suspendidas en el aire como si fueran un rastro que te invita a encontrar a Nulla."
    "Without hesitation, you run, following the particles suspended in the air as if they were a trail inviting you to find Nulla."

# game/rutas/memorias.rpy:362
translate ingles memoriasnulla_37aa0828:

    # "Y entonces lo ves..."
    "And then you see him..."

# game/rutas/memorias.rpy:364
translate ingles memoriasnulla_de1a7c9e:

    # "Nulla, con una pierna apoyada sobre un cuerpo inmóvil. Su mirada perdida en él, como si esperara una reacción, como si estuviera listo para atacar de nuevo al ver un posible movimiento en el cuerpo ya mutilado"
    "Nulla, with one leg resting on an immobile body. His gaze fixed on it, as if waiting for a reaction, as if he were ready to attack again at the slightest movement in the already mutilated body."

# game/rutas/memorias.rpy:365
translate ingles memoriasnulla_2575b3bf:

    # "Gritas su nombre con tanta fuerza que crees que se te va a dañar la garganta."
    "You shout his name with such force that you believe it's going to damage your throat."

# game/rutas/memorias.rpy:367
translate ingles memoriasnulla_906afa8d:

    # "El sonido de su nombre es suficiente para que el dueño del vacío fije su mirada en ti."
    "The sound of his name is enough to fix the gaze of the Void owner on you."

# game/rutas/memorias.rpy:368
translate ingles memoriasnulla_185ea369:

    # "Tus piernas actúan de manera automática. Corres hacia él con los brazos casi abiertos, dispuesto a envolverlo en un abrazo."
    "Your legs act automatically. You run towards him with almost open arms, ready to wrap him in a hug."

# game/rutas/memorias.rpy:370
translate ingles memoriasnulla_cacbd614:

    # "Sin embargo, Nulla se hunde en la oscuridad y reaparece frente a ti, emergiendo desde el suelo."
    "However, Nulla sinks into the darkness and reappears before you, emerging from the ground."

# game/rutas/memorias.rpy:373
translate ingles memoriasnulla_e32c835a:

    # "No hay tiempo para procesarlo. De repente, estás en el suelo, un dolor punzante atravesando tu mandíbula y tu pecho."
    "There's no time to process it. Suddenly, you're on the ground, a sharp pain piercing your jaw and chest."

# game/rutas/memorias.rpy:374
translate ingles memoriasnulla_82807850:

    # "Nulla está sobre ti. Sus manos aprietan tu cuello con fuerza mientras grita."
    "Nulla is on top of you. His hands squeeze your neck tightly as he screams."

# game/rutas/memorias.rpy:375
translate ingles memoriasnulla_11a98a7e:

    # "Intentas explicarle que eres tú, pero es inútil"
    "You try to explain that it's you, but it's futile."

# game/rutas/memorias.rpy:376
translate ingles memoriasnulla_c3dd644b:

    # creador "No te escucha... Lo que ves ahora son mis memorias."
    creador "He's not listening to you... what you see now are my memories."

# game/rutas/memorias.rpy:378
translate ingles memoriasnulla_9ea58f57:

    # nulla "¡Eres un hijo de puta! ¡Escoria de mierda!"
    nulla "You're a son of a bitch! You shitty scum!"

# game/rutas/memorias.rpy:379
translate ingles memoriasnulla_81f9b619:

    # nulla "¡Sigues haciendo lo mismo una y otra vez!"
    nulla "You keep doing the same thing over and over again!"

# game/rutas/memorias.rpy:380
translate ingles memoriasnulla_cdf76d3b:

    # nulla "Nunca estás conforme con nada. No te tomas nada en serio. Juegas con la vida de los que creas."
    nulla "You're never satisfied with anything. You don't take anything seriously. You toy with the lives of those you create."

# game/rutas/memorias.rpy:381
translate ingles memoriasnulla_ee454ac7:

    # nulla "¡PERO NO ERES NADA! SOLO UNA TRISTE REPRESENTACIÓN, UNA MARIONETA, EL PERRO DEL 'JEFE'."
    nulla "BUT YOU'RE NOTHING! JUST A PATHETIC REPRESENTATION; A PUPPET; THE 'BOSS'S' LAPDOG!"

# game/rutas/memorias.rpy:382
translate ingles memoriasnulla_3c7654e2:

    # nulla "¡NO ERES MÁS QUE UN PERSONAJE FICTICIO EN EL PLANO SUPERIOR!"
    nulla "YOU ARE NOTHING MORE THAN A FICTIONAL CHARACTER ON THE UPPER PLANE!"

# game/rutas/memorias.rpy:383
translate ingles memoriasnulla_bf5a560f:

    # nulla "Y eso te jode, ¿verdad?"
    nulla "And that pisses you off, doesn't it?"

# game/rutas/memorias.rpy:384
translate ingles memoriasnulla_1478cda5:

    # "Nulla agarra tus manos y comienza a tirar con fuerza de ella."
    "Nulla grabs your hands and begins to pull them forcefully."

# game/rutas/memorias.rpy:386
translate ingles memoriasnulla_1fd1416e:

    # "Descarrando lentamente tus brazos. Duele."
    "Slowly wrenching your arms aside. It hurts."

# game/rutas/memorias.rpy:387
translate ingles memoriasnulla_e8df9b3d:

    # "Pero no puedes hacer nada."
    "But you can't do anything."

# game/rutas/memorias.rpy:388
translate ingles memoriasnulla_d371673b:

    # "Ni siquiera llorar."
    "Not even cry."

# game/rutas/memorias.rpy:389
translate ingles memoriasnulla_d6458676:

    # "Pues este cuerpo no es tuyo."
    "Because this body is not yours."

# game/rutas/memorias.rpy:390
translate ingles memoriasnulla_ae291e84:

    # nulla "Te voy a arrastrar al limbo conmigo."
    nulla "I'm going to drag you into limbo with me."

# game/rutas/memorias.rpy:391
translate ingles memoriasnulla_af704ca7:

    # nulla "Para que sientas lo mismo que les haces a tus creaciones."
    nulla "So that you feel what you do to your creations."

# game/rutas/memorias.rpy:392
translate ingles memoriasnulla_9ee6fafe:

    # nulla "Incluso has encarcelado a Madre."
    nulla "You've even imprisoned Mother."

# game/rutas/memorias.rpy:393
translate ingles memoriasnulla_f5559b3d:

    # nulla "No te voy a matar..."
    nulla "I'm not going to kill you..."

# game/rutas/memorias.rpy:394
translate ingles memoriasnulla_875b6632:

    # nulla "No te dejaré descansar."
    nulla "I won't let you rest."

# game/rutas/memorias.rpy:395
translate ingles memoriasnulla_2e323b80:

    # nulla "No eres nadie sin tus brazos que te ayudan a hacer tus mierdas de creaciones."
    nulla "You are nothing without your arms that help you make your shitty creations."

# game/rutas/memorias.rpy:396
translate ingles memoriasnulla_40b037ae:

    # nulla "No vas a poder escapar."
    nulla "You won't be able to escape."

# game/rutas/memorias.rpy:398
translate ingles memoriasnulla_80a0f75b:

    # "Nulla está desgarrando el otro brazo cuando un cuerpo grande y oscuro choca contra él."
    "Nulla is tearing off your other arm when a large, dark body collides with him."

# game/rutas/memorias.rpy:404
translate ingles memoriasnulla_e4550b01:

    # "Es un monstruo alado que muerde el brazo de Nulla y como si le hiciera pagar por lo que te ha echo, intenta arrancarlo. Pero Nulla es más rápido y agarra una de las alas que se encuentran en la cabeza de la criatura y sin remordimientos jala de ella hasta arrancarla de la criatura."
    "It's a winged monster that bites off Nulla's arm and, as if making him pay for what he has done to you, tries to tear it off. But Nulla is faster and grabs one of the wings on the creature's head, mercilessly yanking it until he rips it away."

# game/rutas/memorias.rpy:405
translate ingles memoriasnulla_b7e215ef:

    # creador "JAJAJAJAJA ¡¿En serio lo matarás?!"
    creador "HAHAHAHAHA! Are you really going to kill him?!"

# game/rutas/memorias.rpy:407
translate ingles memoriasnulla_e8d02358:

    # "Nulla te mira incrédulo. Como si presentiera que algo no está bien."
    "Nulla looks at you in disbelief, as if sensing that something is not right."

# game/rutas/memorias.rpy:408
translate ingles memoriasnulla_3a9efac6:

    # "Tu cuerpo se mueve solo, con el brazo que te queda, haces unas señas, invocando 3 pares de manos a tu alrededor..."
    "Your body moves on its own; with your remaining arm, you gesture, summoning three pairs of hands around you..."

# game/rutas/memorias.rpy:409
translate ingles memoriasnulla_a4072091:

    # "Una de ellas atraviesa el cuerpo de la criatura, sacándole algo de su pecho, parece ser su corazón. Mientras que el resto le arranca las alas."
    "One of them pierces the creature's body, extracting something from its chest--what appears to be its heart--while the others tear off its wings."

# game/rutas/memorias.rpy:410
translate ingles memoriasnulla_5fcfcbe9:

    # "Luego de ello tu cuerpo desaparece."
    "After that, your body vanishes."

# game/rutas/memorias.rpy:411
translate ingles memoriasnulla_442c2824:

    # creador "Puedes utilizar el cuerpo de tu amigo para que Septem lo use y lo cure."
    creador "You can utilize your friend's body so that Septem heal and use it."

# game/rutas/memorias.rpy:412
translate ingles memoriasnulla_bc630bad:

    # creador "Sino morirá."
    creador "Otherwise, it will die."

# game/rutas/memorias.rpy:415
translate ingles memoriasnulla_4f3ba1bd:

    # "El cuerpo de la criatura cae al suelo derrepente, como si perdiera la conciencia y comienza a cambiar su forma."
    "The creature's body suddenly collapses to the ground, as if losing consciousness, and begins to change its shape."

# game/rutas/memorias.rpy:416
translate ingles memoriasnulla_918c6c86:

    # "Es Rafael."
    "It's Rafael."

# game/rutas/memorias.rpy:417
translate ingles memoriasnulla_b25653bd:

    # "_____________________"
    "_____________________"

# game/rutas/memorias.rpy:421
translate ingles memoriasnulla_163d9151:

    # creador "Bien... Espero que te haya gustado este pequeño intermediario."
    creador "Well... I hope you enjoyed this little interlude."

# game/rutas/memorias.rpy:423
translate ingles memoriasnulla_1b96d0c1:

    # creador "Piensalo como.... una escena eliminada, la cual Nulla no te querrá mostrar."
    creador "Think of it as... a deleted scene that Nulla wouldn't want to show you."

