    # "Así que, sin decir nada, caminas hacia atrás."
    "So, without saying anything, you walk backwards."

# game/rutas/labelsact2.rpy:187
translate ingles badend_septem9_678768ae:

    # "Llegas al pasillo."
    "You reach the hallway."

# game/rutas/labelsact2.rpy:189
translate ingles badend_septem9_c354ce8a:

    # septem "Te he dicho que pases."
    septem "I told you to enter."

# game/rutas/labelsact2.rpy:191
translate ingles badend_septem9_09901bd4:

    # septem "Hoy no estoy para juegos. No voy a aceptar este comportamiento."
    septem "I'm not in the mood for games. I won't accept this behavior."

# game/rutas/labelsact2.rpy:192
translate ingles badend_septem9_36b762d5:

    # septem "Tu desobedencia ya no es divertida."
    septem "Your disobedience is no longer fun."

# game/rutas/labelsact2.rpy:193
translate ingles badend_septem9_a4b9f2c7:

    # septem "Si realmente te tomas esto en serio, volverás."
    septem "If you really take this seriously, you'll come back."

# game/rutas/labelsact2.rpy:194
translate ingles badend_septem9_0f8f0003:

    # "Septem te agarra por la garganta y comienza a apretar sin cuidado."
    "Septem grabs you by the throat and starts squeezing carelessly."

# game/rutas/labelsact2.rpy:195
translate ingles badend_septem9_3756aa30:

    # "Quitandote el aire de a poco, el sonrie."
    "Gradually cutting off your air, he smiles."

# game/rutas/labelsact2.rpy:196
translate ingles badend_septem9_b8a3ffca:

    # "BAD END: ..."
    "BAD END: ..."

# game/rutas/labelsact2.rpy:202
translate ingles badendexplosion_20371e77:

    # "No colocas las manos, no te piensas quemar."
    "You don't put your hands down, you don't plan to burn yourself."

# game/rutas/labelsact2.rpy:205
translate ingles badendexplosion_1756ebe2:

    # "'Que lo haga Unum'.... es tu último pensamiento antes de escuchar un estruendo... como una explosión."
    "'Let Unum do it'... is your last thought before hearing a rumble... like an explosion."

# game/rutas/labelsact2.rpy:206
translate ingles badendexplosion_f0e18c9f:

    # "BAD END: Explosión."
    "BAD END: Explosion."

# game/rutas/labelsact2.rpy:210
translate ingles badendseptemjardin_3e363d17:

    # "Es ahora o nunca."
    "It's now or never."

# game/rutas/labelsact2.rpy:211
translate ingles badendseptemjardin_9411d2d9:

    # "Ahora nadie te está vigilando, estás practicamente a unos cuantos metros de tu libertar."
    "No one is watching you now, you're practically just a few meters away from your freedom."

# game/rutas/labelsact2.rpy:212
translate ingles badendseptemjardin_f48b7669:

    # "Que importa los posibles problemas que tengas allá afuera por ser un humano. ¡Lo que importa es que eres libre!"
    "Who cares about the possible problems you might face out there for being a human. What matters is that you're free!"

# game/rutas/labelsact2.rpy:215
translate ingles badendseptemjardin_c8aabd87:

    # septem "Realmente eres imbécil..."
    septem "You really are an idiot..."

# game/rutas/labelsact2.rpy:216
translate ingles badendseptemjardin_760d2cba:

    # "Septem te corta la cabeza."
    "Septem cuts off your head."

# game/rutas/labelsact2.rpy:217
translate ingles badendseptemjardin_02519825:

    # "BAD END: A metros de tu libertad."
    "BAD END: Meters from your freedom."

