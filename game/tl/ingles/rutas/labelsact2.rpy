# game/rutas/labelsact2.rpy:531

translate ingles s_preguntas_act3_c918a73f:

    # septem "Puedo hacerle un corazón que funcione... pero necesito arreglar el Jardín antes de hacerlo despertar."
    septem "I can make him a working heart... but I need to fix the Garden before I wake him up."

# game/rutas/labelsact2.rpy:532
translate ingles s_preguntas_act3_d6b5d5d7:

    # septem "No quiero traerlo de vuelta a un mundo que no está listo aún."
    septem "I don't want to bring him back to a world that isn't ready yet."

# game/rutas/labelsact2.rpy:537
translate ingles s_preguntas_act3_e1de277f:

    # septem "Sí..."
    septem "Yes..."

# game/rutas/labelsact2.rpy:538
translate ingles s_preguntas_act3_3c09c18a:

    # septem "Yo también."
    septem "Me too."

# game/rutas/labelsact2.rpy:542
translate ingles s_preguntas_act3_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/labelsact2.rpy:545
translate ingles s_preguntas_act3_63542b8f:

    # septem "No lo creo."
    septem "I don't think so."

# game/rutas/labelsact2.rpy:548
translate ingles s_preguntas_act3_efc155c6:

    # "Baja la mirada, incapaz de darte la cara."
    "He lowers his gaze, unable to face you."

# game/rutas/labelsact2.rpy:549
translate ingles s_preguntas_act3_9c7b9714:

    # septem "Los humanos deben ir con los humanos..."
    septem "Humans belong with humans..."

# game/rutas/labelsact2.rpy:550
translate ingles s_preguntas_act3_e9094642:

    # septem "Él perderá todos sus rangos una vez que se desligue completamente de mí."
    septem "He'll lose all his ranks once he's completely severed his ties with me."

# game/rutas/labelsact2.rpy:551
translate ingles s_preguntas_act3_93499e05:

    # septem "Vivirá como ellos, y morirá como ellos..."
    septem "He'll live like them, and die like them..."

# game/rutas/labelsact2.rpy:553
translate ingles s_preguntas_act3_07bdde05:

    # "....."
    "....."

# game/rutas/labelsact2.rpy:559
translate ingles s_preguntas_act3_a1767bc3:

    # "Le preguntas por cómo se encuentra. Y cuando él te mira con cara de no entender tu pregunta del todo te explicas diciendo que quieres saber como se siente emocionalmente."
    "You ask him how he's doing. When he looks at you as if he doesn't quite understand your question, you clarify that you want to know how he's feeling emotionally."

# game/rutas/labelsact2.rpy:560
translate ingles s_preguntas_act3_cba3260c:

    # "Que quieres saber si hay algo que le preocupa o algo que quiera compartir contigo para sentirse más liberado. Evitas decir que lo has sentido en tus sueños, para no ponerlo de malas o hacerlo sentir pequeño y expuesto."
    "You want to know if there's anything troubling him, or anything he'd like to share with you to feel a little more relieved. You avoid mentioning that you've sensed him in your dreams, not wanting to upset him or make him feel small and exposed."

# game/rutas/labelsact2.rpy:561
translate ingles s_preguntas_act3_b97ed780:

    # "Septem frunce el ceño como primera respuesta, sin saber cómo tomarse tu curiosidad, y bebe un poco de su copa antes de responder."
    "Septem's first response is to furrow his brow, unsure what to make of your curiosity. He takes a small sip from his glass before answering."

# game/rutas/labelsact2.rpy:562
translate ingles s_preguntas_act3_75cd6f78:

    # "Al terminar de dar su trago, se aclara la garganta."
    "After finishing, he clears his throat."

# game/rutas/labelsact2.rpy:565
translate ingles s_preguntas_act3_b2675d58:

    # septem "Estoy bien."
    septem "I'm fine."

# game/rutas/labelsact2.rpy:568
translate ingles s_preguntas_act3_0dbe6153:

    # "Es lo único que te ofrece. Tú sabes que hay más que solo esa respuesta vaga y ensayada, pero no sabes cómo hacerlo escupir todo lo que le persigue en su cabeza."
    "That's all he offers you. You know there's more to it than that vague, rehearsed answer, but you don't know how to make him spit out everything that's been haunting him."

# game/rutas/labelsact2.rpy:569
translate ingles s_preguntas_act3_1b179571:

    # "Así que aplicas el silencio, esperando que aquello haga que Septem quiera rellenarlo con más palabras."
    "So you resort to silence, hoping it'll make Septem want to fill it with more words."

# game/rutas/labelsact2.rpy:570
translate ingles s_preguntas_act3_a20cefa7:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:571
translate ingles s_preguntas_act3_2b1b0c41:

    # "....?"
    "....?"

# game/rutas/labelsact2.rpy:572
translate ingles s_preguntas_act3_2cb775c4:

    # "No funciona. Septem no tiene el más mínimo sentido de la incomodidad o presión social en rellenar el silencio incómodo con palabras."
    "It doesn't work. Septem has absolutely no sense of the awkwardness or social pressure that comes with filling an uncomfortable silence with words."

# game/rutas/labelsact2.rpy:573
translate ingles s_preguntas_act3_bc7611fb:

    # "Hasta tiene el descaro de sonreír levemente, a sabiendas de que no obtendrás lo que buscas."
    "He even has the nerve to smile faintly, knowing you won't get what you're looking for."

# game/rutas/labelsact2.rpy:576
translate ingles s_preguntas_act3_98b08b34:

    # "Septem sigue bebiendo de su copa sin darle importancia al silencio que lo acompaña."
    "Septem keeps drinking from his glass, paying no mind to the silence that hangs around him."

# game/rutas/labelsact2.rpy:577
translate ingles s_preguntas_act3_6c9a5586:

    # "Es mejor así, te consuelas mentalmente."
    "It's better this way, you reassure yourself."

# game/rutas/labelsact2.rpy:580
translate ingles s_preguntas_act3_1c40fee6:

    # "Sabes que es riesgoso, pero él jamás te ha dicho que no sigas preguntando. ¡Además se está burlando de ti con esa sonrisa que tiene pegada a los labios!"
    "You know it's risky, but he's never told you to stop asking questions. Besides, he's making fun of you with that smile plastered across his face!"

# game/rutas/labelsact2.rpy:581
translate ingles s_preguntas_act3_7b8c5ddc:

    # "Se está haciendo él de rogar, no tienes suficientes pruebas, más que esa maldita sonrisa, pero tampoco dudas."
    "He's playing hard to get. You don't have enough proof beyond that damn smile, but you have no doubts either."

# game/rutas/labelsact2.rpy:582
translate ingles s_preguntas_act3_7b2a7b70:

    # "Así qué lo cuestionas, formulando preguntas para hacerlo hablar más."
    "So you question him, coming up with more questions to get him talking."

# game/rutas/labelsact2.rpy:585
translate ingles s_preguntas_act3_dc1173b9:

    # septem "¿Realmente te intesesa saber?"
    septem "Do you really want to know?"

# game/rutas/labelsact2.rpy:588
translate ingles s_preguntas_act3_ebf17076:

    # "Tú respondes que sí, que si no te interesará ni siquiera le preguntarías nuevamente. Eso gana una expresión de sorpresa por parte de Septem."
    "You tell him yes, that if you weren't interested, you wouldn't even be asking him again. That earns you a surprised look from Septem."

# game/rutas/labelsact2.rpy:591
translate ingles s_preguntas_act3_6a403d42:

    # septem "Tengo algunas dudas de lo que está por venir..."
    septem "I have some doubts about what's to come..."

# game/rutas/labelsact2.rpy:592
translate ingles s_preguntas_act3_9b3fb368:

    # septem "Los cambios no me gustan... romper las reglas tampoco..."
    septem "I don't like change... or breaking the rules..."

# game/rutas/labelsact2.rpy:593
translate ingles s_preguntas_act3_092082ba:

    # septem "Hoy haremos todo lo que me disgusta."
    septem "Today, we'll be doing everything I dislike."

# game/rutas/labelsact2.rpy:594
translate ingles s_preguntas_act3_a074c99c:

    # septem "Pero hay que hacerlo."
    septem "But it has to be done."

# game/rutas/labelsact2.rpy:595
translate ingles s_preguntas_act3_a20cefa7_1:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:600
translate ingles s_preguntas_act3_691e9d98:

    # septem "¿Qué quieres saber?"
    septem "What do you want to know?"

# game/rutas/labelsact2.rpy:605
translate ingles s_preguntas_act3_7e3160ee:

    # septem "Es la única parte que no se puede cambiar."
    septem "It's the only part that cannot be changed."

# game/rutas/labelsact2.rpy:606
translate ingles s_preguntas_act3_a4d59210:

    # septem "Toda la energía que compartes conmigo se acumula ahí."
    septem "All the energy you share with me accumulates there."

# game/rutas/labelsact2.rpy:609
translate ingles s_preguntas_act3_31924e0f_1:

    # septem "..."
    septem "..."

# game/rutas/labelsact2.rpy:610
translate ingles s_preguntas_act3_a0bc95a4:

    # "Septem siente la duda invadir tus pensamientos."
    "Septem senses doubt creeping into your thoughts."

# game/rutas/labelsact2.rpy:613
translate ingles s_preguntas_act3_5ba39205:

    # septem "Puedo ver evitar que la energía no se manifieste así... cambiarlo."
    septem "I can prevent the energy from manifesting this way... change it."

# game/rutas/labelsact2.rpy:614
translate ingles s_preguntas_act3_0679a286:

    # septem "No hay problema en eso, pero---"
    septem "There's no problem with that, but--"

# game/rutas/labelsact2.rpy:617
translate ingles s_preguntas_act3_51a21212:

    # septem "Con estas manos que tienes es más fácil identificarte como mío."
    septem "With those hands of yours, it's easier to recognize you as mine."

# game/rutas/labelsact2.rpy:620
translate ingles s_preguntas_act3_dc6f96e6:

    # septem "No habrá humano o Dios que dude de nuestra unión."
    septem "There won't be a human or God who doubts our bond."

# game/rutas/labelsact2.rpy:625
translate ingles s_preguntas_act3_cff623c0:

    # septem "Eres inmortal hasta que yo deje de permitirlo."
    septem "You're immortal until I decide otherwise."

# game/rutas/labelsact2.rpy:628
translate ingles s_preguntas_act3_3a44b081:

    # "Septem sonríe con ternura, ignorando lo brutal de sus propias palabras."
    "Septem smiles tenderly, oblivious to the brutality of his own words."

# game/rutas/labelsact2.rpy:629
translate ingles s_preguntas_act3_12bace56:

    # "Pasan los segundos, y nada. Septem no se retracta o termina su comentario con algún chiste liviano..."
    "Seconds pass, and nothing. Septem doesn't take back his words or follow up his comment with some lighthearted joke..."

# game/rutas/labelsact2.rpy:632
translate ingles s_preguntas_act3_ec0e18a2:

    # septem "No te preocupes, [nombrejugador], no pienso hacer eso."
    septem "Don't worry, [nombrejugador], I have no intention of doing that."

# game/rutas/labelsact2.rpy:635
translate ingles s_preguntas_act3_3583cf90:

    # septem "Eres vital para mí. Jamás dejaría que tu cuerpo vasija muera."
    septem "You're vital to me. I would never allow your vessel body to die."

# game/rutas/labelsact2.rpy:636
translate ingles s_preguntas_act3_1c15829e:

    # septem "Aunque---"
    septem "Although--"

# game/rutas/labelsact2.rpy:637
translate ingles s_preguntas_act3_6c0f8ee9:

    # septem "Si llega el momento en que te hartes de este cuerpo, podría fabricar otro con el que te sientas más cómodo."
    septem "If the time comes when you grow tired of this body, I could make another one you'd feel more comfortable in."

# game/rutas/labelsact2.rpy:642
translate ingles s_preguntas_act3_3e1cab2a:

    # septem "Mhhm---"
    septem "Mhhm--"

# game/rutas/labelsact2.rpy:643
translate ingles s_preguntas_act3_624c9b73:

    # "Septem suelta una risa que no logra escapar de sus labios, los cuales mantiene sellados."
    "Septem lets out a laugh that never quite escapes his tightly closed lips."

# game/rutas/labelsact2.rpy:646
translate ingles s_preguntas_act3_3eb74883:

    # septem "Te recomiendo seguir la dieta y las rutinas de un cuerpo mortal..."
    septem "I recommend following the diet and routines of a mortal body..."

# game/rutas/labelsact2.rpy:647
translate ingles s_preguntas_act3_84ad2c4c:

    # septem "Eres inmortal, pero sigues atado a lo mundano de la vida humana."
    septem "You're immortal, but you're still bound to the mundane aspects of human life."

# game/rutas/labelsact2.rpy:650
translate ingles s_preguntas_act3_c8e322b1:

    # septem "Sentirás hambre y sueño. Sufrirás si no sacias tu sed."
    septem "You'll feel hunger and fatigue. You'll suffer if you don't quench your thirst."

# game/rutas/labelsact2.rpy:651
translate ingles s_preguntas_act3_45784221:

    # septem "Pero no podrás morir de ello."
    septem "But you won't be able to die from any of it."

# game/rutas/labelsact2.rpy:652
translate ingles s_preguntas_act3_ffec716e:

    # "Su sonrisa es inquietante. Algo en sus ojos brilla con una chispa que solo puedes llamarla placer."
    "His smile is unsettling. Something in his eyes glimmers with a spark you can only describe as 'pleasure.'"

# game/rutas/labelsact2.rpy:653
translate ingles s_preguntas_act3_acfe4ace:

    # "Septem disfruta de esto."
    "Septem is enjoying this."

# game/rutas/labelsact2.rpy:654
translate ingles s_preguntas_act3_5f9b772e:

    # "...."
    "...."

# game/rutas/labelsact2.rpy:670
translate ingles act3_explorar_septem_35e2380c:

    # "Sales directo al jardín por un poco de aire fresco."
    "You head straight into the garden for some fresh air."

# game/rutas/labelsact2.rpy:671
translate ingles act3_explorar_septem_236d02d6:

    # "Temes que las telas de tu túnica se ensucien por lo que te quedas cerca de la entrada del templo, donde no hay tierra o pasto."
    "You're afraid of getting the fabric of your robe dirty, so you stay near the temple entrance, where there's no dirt or grass."

# game/rutas/labelsact2.rpy:672
translate ingles act3_explorar_septem_bfaa1b70:

    # "El solo pensar que te puedes tropezar en la tierra o manchar las telas que cuelgan de tu cuerpo te genera estrés. No te gustaría presentarte ante todo el Jardín con tu ropa manchada o rota."
    "Just thinking about tripping on the ground or staining the fabric draped around your body makes you anxious. You wouldn't want to appear before the entire Garden with your clothes stained or torn."

# game/rutas/labelsact2.rpy:673
translate ingles act3_explorar_septem_805828bb:

    # "Las primeras impresiones importan, más cuando eres una figura importante."
    "First impressions matter, especially when you're an important figure."

# game/rutas/labelsact2.rpy:674
translate ingles act3_explorar_septem_6c2bd8a8:

    # "Aunque, si bien Septem podría darte otro conjunto, quieres demostrarle que tú puedes ser elegante y cuidadoso también."
    "Although Septem could give you another outfit, you want to show him that you can be elegant and careful too."

# game/rutas/labelsact2.rpy:675
translate ingles act3_explorar_septem_8494b197:

    # "Manchar estas ropas sería como fallar en ello."
    "Staining these clothes would feel like failing at that."

# game/rutas/labelsact2.rpy:676
translate ingles act3_explorar_septem_a20cefa7:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:678
translate ingles act3_explorar_septem_187b71ed:

    # "Respiras hondo, cerrando los ojos y canalizando tranquilidad. La obtienes con el sonido de la brisa del lugar, junto con el correr del agua."
    "You take a deep breath, closing your eyes and trying to find some peace. You find it in the sound of the breeze drifting through the place, accompanied by the flowing water."

# game/rutas/labelsact2.rpy:680
translate ingles act3_explorar_septem_6287bc31:

    # "Al abrir los ojos, tu mirada cae en las columnas de piedra que están más allá de la cerca de árboles."
    "When you open your eyes, your gaze falls upon the stone columns beyond the line of trees."

# game/rutas/labelsact2.rpy:681
translate ingles act3_explorar_septem_589df666:

    # "Quieres ir allí y descubrir que es lo que esconde... recuerdas que Septem no quiso ir a ese lugar cuando lo señalaste."
    "You want to go there and discover what it hides... you remember that Septem refused to go there when you pointed it out."

# game/rutas/labelsact2.rpy:682
translate ingles act3_explorar_septem_602e2dd6:

    # "Hum, luego de la ceremonia le preguntarás si te acompaña allá."
    "Hmm, after the ceremony, you'll ask him to accompany you there."

# game/rutas/labelsact2.rpy:683
translate ingles act3_explorar_septem_5f9b772e:

    # "...."
    "...."

# game/rutas/labelsact2.rpy:691
translate ingles act3_explorar_septem_7cb4654c:

    # "Caminas por los pasillos del templo. Al ser una distancia larga entre cada pasillo, tiendes a tropezar con las telas de tu túnica que se enredan en tus pies."
    "You walk through the temple's corridors. With such long distances between each hallway, you keep tripping over the fabric of your robe as it tangles around your feet."

# game/rutas/labelsact2.rpy:692
translate ingles act3_explorar_septem_1fb851a5:

    # "Es algo que no puedes evitar. No estás acostumbrado a caminar largas distancias con ropaje que toca y se desliza por el suelo con cada paso que das."
    "It's something you can't avoid. You're not used to walking long distances in clothing that touches and drags along the floor with every step you take."

# game/rutas/labelsact2.rpy:693
translate ingles act3_explorar_septem_ed53687d:

    # "Tu caminata es poco productiva, los pasillos no tienen nada nuevo que agregar. Nada nuevo que mirar o conocer."
    "Your walk proves rather unproductive. The corridors have nothing new to offer. Nothing new to see or discover."

# game/rutas/labelsact2.rpy:697
translate ingles act3_explorar_septem_5d01a471:

    # "Estás por desistir tu exploración en los pasillos cuando sientes que algo te llama. No es una voz como tal..."
    "You're about to give up exploring the corridors when you feel something calling to you. It's not exactly a voice..."

# game/rutas/labelsact2.rpy:698
translate ingles act3_explorar_septem_f0d33376:

    # "Es una sensación que llama a todo tu cuerpo a ponerse alerta y a prestar atención a lo que te rodea. Como si te tiraran de la manga de tu túnica, pidiendo que pares y escuches."
    "It's a sensation that urges your entire body to become alert and pay attention to your surroundings. As though someone were tugging at the sleeve of your robe, asking you to stop and listen."

# game/rutas/labelsact2.rpy:699
translate ingles act3_explorar_septem_a20cefa7_1:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:702
translate ingles act3_explorar_septem_64d64646:

    # centered "{glitch=30.0}{color=ffffff}{b}[nombrejugador]...{b}{/color}"
    centered "{glitch=30.0}{color=ffffff}{b}[nombrejugador]...{b}{/color}"

# game/rutas/labelsact2.rpy:703
translate ingles act3_explorar_septem_b1114440:

    # "¿¡!?"
    "!?"

# game/rutas/labelsact2.rpy:706
translate ingles act3_explorar_septem_1436e2f0:

    # "Tu nombre ha sido llamado por una voz que reconoces muy bien..."
    "Your name has been called by a voice you know all too well..."

# game/rutas/labelsact2.rpy:707
translate ingles act3_explorar_septem_a20cefa7_2:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:710
translate ingles act3_explorar_septem_64d64646_1:

    # centered "{glitch=30.0}{color=ffffff}{b}[nombrejugador]...{b}{/color}"
    centered "{glitch=30.0}{color=ffffff}{b}[nombrejugador]...{b}{/color}"

# game/rutas/labelsact2.rpy:713
translate ingles act3_explorar_septem_49978d0c:

    # "Esperas por un largo tiempo para que te diga otra cosa, pero eso no sucede, e incluso, su voz se siente más lejana."
    "You wait a long time for the voice to say something else, but it never does. In fact, it seems even farther away."

# game/rutas/labelsact2.rpy:714
translate ingles act3_explorar_septem_7c69a248:

    # "No quieres perder esa voz, no quieres dejar que él se vaya. Después de todo, tú mismo has dicho que lo necesitabas."
    "You don't want to lose that voice, you don't want to let him go. After all, you yourself said you needed him."

# game/rutas/labelsact2.rpy:715
translate ingles act3_explorar_septem_fc1e3505:

    # "Nulla..."
    "Nulla..."

# game/rutas/labelsact2.rpy:718
translate ingles act3_explorar_septem_8433967e:

    # "Sí..."
    "Yes..."

# game/rutas/labelsact2.rpy:720
translate ingles act3_explorar_septem_1d6a6ebe:

    # "Necesitas a tu marioneta... y probablemente él sepa que le ha pasado. Te rehusar a creer que ha muerto. Debe estar por ahí, junto con el dueño del vacío."
    "You need your puppet... and he probably knows what happened to it. You refuse to believe it's dead. It must be somewhere out there, along with the owner of the void."

# game/rutas/labelsact2.rpy:722
translate ingles act3_explorar_septem_366aad6e:

    # "Serás algo lento, pero tonto no eres. Nulla te está llamando y necesitas encontrarlo."
    "You may be a little slow, but you're not stupid. Nulla is calling you, and you need to find him."

# game/rutas/labelsact2.rpy:723
translate ingles act3_explorar_septem_44bc645a:

    # "Caminas siguiendo su llamado."
    "You walk, following his call."

# game/rutas/labelsact2.rpy:724
translate ingles act3_explorar_septem_af7ed50c:

    # "En ciertas ocasiones lo sientes cerca, para luego darte cuenta de que mientras más caminas, más te alejas."
    "Sometimes you feel him nearby, only to realize that the farther you walk, the farther away his presence becomes."

# game/rutas/labelsact2.rpy:725
translate ingles act3_explorar_septem_ed908e39:

    # "Es como jugar al juego del 'Frío o Caliente', solo que más difícil porque las pistas no están tan claras y dependes solo de una voz que se esfuma cuando cometes un error."
    "It's like playing 'Hot or Cold,' only harder because the clues aren't as clear, and you have nothing to rely on but a voice that fades away whenever you make a mistake."

# game/rutas/labelsact2.rpy:729
translate ingles act3_explorar_septem_b2b3d35a:

    # "Te toma un tiempo para llegar a tu destino... es una puerta entreabierta a la que entras sin chistar."
    "It takes you a while to reach your destination... a half-open door that you enter without hesitation."

# game/rutas/labelsact2.rpy:733
translate ingles act3_explorar_septem_6e924f44:

    # "Hay algo dentro del cuarto... algo que se mueve como si respirase y que no debería estar ahí."
    "There's something inside the room... something that moves as though it's breathing, something that shouldn't be there."

# game/rutas/labelsact2.rpy:734
translate ingles act3_explorar_septem_90b56f74:

    # "El pánico te agarra de los pies y te obliga a salir de la habitación sin siquiera procesar que es lo que acabas de ver."
    "Panic seizes you by the feet and drives you to flee the room before you can even process what you've just seen."

# game/rutas/labelsact2.rpy:735
translate ingles act3_explorar_septem_3b6fd595:

    # "Pero, tus pies se anclan en el suelo, atrapándote en el lugar. No importa cuanto te muevas o luches por liberarte, no hay caso. No tienes como salir de aquí."
    "But your feet become rooted to the floor, trapping you in place. No matter how much you move or struggle to break free, it's useless. There's no way out of here."

# game/rutas/labelsact2.rpy:736
translate ingles act3_explorar_septem_fac7cdd2:

    # el "[nombrejugador]..."
    el "[nombrejugador]..."

# game/rutas/labelsact2.rpy:737
translate ingles act3_explorar_septem_d982d752:

    # "La masa extraña te llama y lloriquea."
    "The strange mass calls out to you, whimpering."

# game/rutas/labelsact2.rpy:738
translate ingles act3_explorar_septem_e470bad8:

    # "Su voz es una horripilante combinación entre la voz de Nulla y tuya, pero sin llegar a ser una copia exacta de ellas."
    "Its voice is a horrifying combination of Nulla's voice and your own, without being an exact copy of either."

# game/rutas/labelsact2.rpy:739
translate ingles act3_explorar_septem_33e54c77:

    # "Al mirarla con detención te das cuenta de que reconoces lo que representa. Lo has vivido, lo has tocado, has pasado tiempo con ello."
    "When you look at it closely, you realize you recognize what it represents. You've experienced it, touched it, spent time with it."

# game/rutas/labelsact2.rpy:740
translate ingles act3_explorar_septem_0a11efdf:

    # "Es tu marioneta... o lo que queda de ella."
    "It's your puppet... or what's left of it."

# game/rutas/labelsact2.rpy:741
translate ingles act3_explorar_septem_7e878e94:

    # "Sus quejidos son como los de un bebé. Tiene miedo y necesita de ti."
    "Its whimpers are like those of a baby. It's scared, and it needs you."

# game/rutas/labelsact2.rpy:742
translate ingles act3_explorar_septem_34f77f99:

    # "Necesita que la tomes."
    "It needs you to hold it."

# game/rutas/labelsact2.rpy:747
translate ingles act3_explorar_septem_1cbd20cd:

    # "La tomas."
    "You take hold of it."

# game/rutas/labelsact2.rpy:748
translate ingles act3_explorar_septem_6460eca0:

    # "La masa se pega a ti. Te atrapa, envolviendo sus tentáculos."
    "The mass clings to you. It traps you, wrapping its tentacles around you."

# game/rutas/labelsact2.rpy:753
translate ingles act3_explorar_septem_4fa8780a:

    # "Te retuerces para escapar, con todas tus fuerzas."
    "You twist and struggle to escape with all your strength."

# game/rutas/labelsact2.rpy:754
translate ingles act3_explorar_septem_87cec586:

    # "La masa parece avanzar, buscándote, buscando tocarte."
    "The mass seems to move forward, searching for you, trying to touch you."

# game/rutas/labelsact2.rpy:755
translate ingles act3_explorar_septem_4a3221af:

    # "Comienzas a lloriquear, aterrado de lo que te pueda hacer esta cosa."
    "You begin to whimper, terrified of what this thing might do to you."

# game/rutas/labelsact2.rpy:756
translate ingles act3_explorar_septem_077e1e91:

    # "Solo unos centímetros más y aquello te comerá... o peor, tomará control de ti."
    "Just a few more centimeters and that thing will devour you... or worse, take control of you."

# game/rutas/labelsact2.rpy:758
translate ingles act3_explorar_septem_fe9e0926:

    # septem "Con que aquí estaba..."
    septem "So this is where it was..."

# game/rutas/labelsact2.rpy:759
translate ingles act3_explorar_septem_4317a0cc:

    # "La voz de Septem se instala en el lugar, imponente y tranquila. Suelta un largo suspiro antes de continuar."
    "Septem's voice fills the room, commanding yet calm. He lets out a long sigh before continuing."

# game/rutas/labelsact2.rpy:760
translate ingles act3_explorar_septem_9c804da4:

    # septem "Reconozco que me demoré porque quería ver que hacías."
    septem "I admit I took my time because I wanted to see what you would do."

# game/rutas/labelsact2.rpy:761
translate ingles act3_explorar_septem_89edb59e:

    # septem "Me disculpo si te aterraste."
    septem "I apologize if I frightened you."

# game/rutas/labelsact2.rpy:768
translate ingles act3_explorar_septem_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/labelsact2.rpy:769
translate ingles act3_explorar_septem_51462b9c:

    # septem "Bien. Es momento que salga de aquí."
    septem "Good. It's time for you to leave this place."

# game/rutas/labelsact2.rpy:770
translate ingles act3_explorar_septem_ae9395b1:

    # septem "Ya he eliminado a esa abominación."
    septem "I've already eliminated that abomination."

# game/rutas/labelsact2.rpy:773
translate ingles act3_explorar_septem_104f5a8e:

    # septem "Ah no, no, no. Es peligroso."
    septem "Ah, no, no, no. It's dangerous."

# game/rutas/labelsact2.rpy:774
translate ingles act3_explorar_septem_072e1e1b:

    # septem "Y no me voy a arriesgar más."
    septem "And I'm not taking any more risks."

# game/rutas/labelsact2.rpy:777
translate ingles act3_explorar_septem_b0035e32:

    # septem "No entrarás más ahí..."
    septem "You won't go in there again..."

# game/rutas/labelsact2.rpy:778
translate ingles act3_explorar_septem_54231ee1:

    # septem "Ve a pasar el tiempo en otro lugar."
    septem "Go spend your time somewhere else."

# game/rutas/labelsact2.rpy:779
translate ingles act3_explorar_septem_29a330b6:

    # septem "Si te aburres, ven conmigo."
    septem "If you get bored, come see me."

# game/rutas/labelsact2.rpy:786
translate ingles act3_explorar_septem_002fcd97:

    # "Recorres los pasillos una vez más... ya no encuentras la puerta que da a la habitación con el cuarto oscuro..."
    "You wander through the corridors once more... but you can no longer find the door leading to the dark room..."

# game/rutas/labelsact2.rpy:787
translate ingles act3_explorar_septem_fa959bff:

    # "Extraño... ¿Será que Septem la ha bloqueado de alguna manera?"
    "Strange... could Septem have blocked it somehow?"

# game/rutas/labelsact2.rpy:793
translate ingles act3_explorar_septem_5f9b772e_1:

    # "...."
    "...."

# game/rutas/labelsact2.rpy:800
translate ingles act3_explorar_septem_a20cefa7_3:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:804
translate ingles act3_explorar_septem_040c52df:

    # "Caminas hasta llegar a la puerta que aísla a Rafael del resto del templo."
    "You walk until you reach the door that separates Rafael from the rest of the temple."

# game/rutas/labelsact2.rpy:808
translate ingles act3_explorar_septem_1bdbb080:

    # "Entras sin restricción aparente: la puerta está desbloqueada, no hay fuerza invisible que te impida entrar en la habitación, y el lugar te recibe con una cálida energía."
    "You enter without any apparent restrictions: The door is unlocked, there's no invisible force preventing you from entering the room, and the place welcomes you with a warm energy."

# game/rutas/labelsact2.rpy:809
translate ingles act3_explorar_septem_3071ee5f:

    # "En la cama está Rafael. Te acercas a paso lento, con miedo a despertarlo."
    "Rafael is lying on the bed. You approach slowly, afraid of waking him."

# game/rutas/labelsact2.rpy:810
translate ingles act3_explorar_septem_21be97c1:

    # "Sabes que es imposible, pero no puedes evitar en pensar que estás infringiendo en alguna regla que Septem ha dictaminado sin informarte."
    "You know that's impossible, but you can't help thinking that you're breaking some rule Septem has established without telling you."

# game/rutas/labelsact2.rpy:814
translate ingles act3_explorar_septem_ddbd2073:

    # "Te quedas a un costado de la cama. Sabes lo suficiente de espacio personal y comportamiento social básico como para no subirte a la cama e invadir su espacio personal."
    "You stay beside the bed. You know enough about personal space and basic social etiquette not to climb onto the bed and invade his personal space."

# game/rutas/labelsact2.rpy:815
translate ingles act3_explorar_septem_f35d111c:

    # "Lo observas un buen rato."
    "You watch him for quite a while."

# game/rutas/labelsact2.rpy:816
translate ingles act3_explorar_septem_06ee9755:

    # "Te da pena verlo sin reaccionar, a sabiendas de que no está dormido ni muerto. Su estado es incierto, a lo único que podrías asimilarlo es a un estado de pausa donde lo único que hace su cuerpo es respirar."
    "It saddens you to see him so unresponsive, knowing that he's neither asleep nor dead. His condition is uncertain. The closest thing you can compare it to is a state of suspension, where all his body does is breathe."

# game/rutas/labelsact2.rpy:817
translate ingles act3_explorar_septem_7d298c0f:

    # "No hay existencia de micro-movimientos que pasan en el sueño o expresiones de dolor."
    "There are none of the tiny movements that occur during sleep, nor any expressions of pain."

# game/rutas/labelsact2.rpy:818
translate ingles act3_explorar_septem_a5aef67f:

    # "Te quedas para acompañar a esta alma atrapada en un cuerpo que no responde. Desconoces si puede oír lo que pasa a su alrededor, por lo que no te atreves a hablarle."
    "You stay to keep this soul trapped in an unresponsive body company. You don't know if he can hear what's happening around him, so you don't dare speak to him."

# game/rutas/labelsact2.rpy:819
translate ingles act3_explorar_septem_1742f7b2:

    # "Los minutos pasan...."
    "The minutes pass..."

# game/rutas/labelsact2.rpy:820
translate ingles act3_explorar_septem_fbf09984:

    # "Cuando crees que ha sido suficiente, abandonas el lugar."
    "When you feel you've stayed long enough, you leave."

# game/rutas/labelsact2.rpy:822
translate ingles act3_explorar_septem_bac690d1:

    # "Te preguntas cuando podrás ver a Rafael activo y con un cuerpo que solo le pertenezca a él."
    "You wonder when you'll get to see Rafael moving again, with a body that belongs to him alone."

# game/rutas/labelsact2.rpy:827
translate ingles act3_explorar_septem_ab3e3246:

    # "Quieres verlo y si Septem necesita más tiempo solo, ya que te lo diría. Jamás te prohibió ir a visitarlo a la biblioteca."
    "You want to see him, and if Septem needs more time alone, he'll tell you. He never forbade you from visiting him in the library."

# game/rutas/labelsact2.rpy:828
translate ingles act3_explorar_septem_2f52215c:

    # "Además, quieres mostrarle cómo te queda el conjunto de ropa que él te ha elegido."
    "Besides, you want to show him how the outfit he chose for you looks on you."

# game/rutas/labelsact2.rpy:829
translate ingles act3_explorar_septem_36541f91:

    # "Entonces, es {b}muy{b} necesario que lo veas antes de que sea el mediodía, ya que necesitas su opinión."
    "So, it's very important that you see him before the gathering because you need his opinion."

# game/rutas/labelsact2.rpy:833
translate ingles act3_explorar_septem_48d22b29:

    # "Subes las escaleras cuidando tus pasos. Mirando donde caen tus pies en cada escalón. Se te dificulta un poco por lo largo de la túnica, que te impide ver dónde aterriza cada pie."
    "You climb the stairs carefully, watching where you place your feet on each step. It's a little difficult because your robe is so long that you can't see where your feet land."

# game/rutas/labelsact2.rpy:834
translate ingles act3_explorar_septem_b69f52cb:

    # "Cuando llegas al último escalón, celebras en silencio tu logro. Estas ropas no fueron hechas para moverse como uno lo hace cotidianamente. Posiblemente fueron hechas para sentarse y verse bonito."
    "When you reach the final step, you silently celebrate your accomplishment. These clothes weren't made for moving around the way one normally does. They were probably made for sitting still and looking pretty."

# game/rutas/labelsact2.rpy:835
translate ingles act3_explorar_septem_008c6aaa:

    # "Como una muñeca de mostrador... bien cuidada y destinada solamente a ser observada desde el cristal. Una belleza perpetua que no alcanza a tener un propósito más grande que aquello."
    "Like a doll in a display case... well cared for and meant only to be admired through the glass. A perpetual beauty with no greater purpose than that."

# game/rutas/labelsact2.rpy:836
translate ingles act3_explorar_septem_bfd22da7:

    # "Huh..."
    "Huh..."

# game/rutas/labelsact2.rpy:837
translate ingles act3_explorar_septem_1e4334bc:

    # "Decides dejar ese pensamiento fuera de tu cabeza. No vale la pena ocasionar una jaqueca con pensar en todas posibilidades que no puedes controlar por ahora..."
    "You decide to push that thought out of your head. It's not worth giving yourself a headache thinking about all the possibilities you can't control right now..."

# game/rutas/labelsact2.rpy:841
translate ingles act3_explorar_septem_df1bbf97:

    # "Te detienes en frente de la entrada de la biblioteca."
    "You stop in front of the library entrance."

# game/rutas/labelsact2.rpy:842
translate ingles act3_explorar_septem_89623bdc:

    # "Te cuestionas si debes entrar... tal vez Septem quiera tener un momento sin tu presencia."
    "You wonder whether you should go inside... perhaps Septem wants a moment without you around."

# game/rutas/labelsact2.rpy:843
translate ingles act3_explorar_septem_afa7d5bd:

    # "La puerta es la única barrera que hay entre tú y él. Solo tienes que levantar la mano y llamar a la puerta."
    "The door is the only barrier between you and him. All you have to do is raise your hand and knock."

# game/rutas/labelsact2.rpy:844
translate ingles act3_explorar_septem_94db336b:

    # "Te preparas para tocar la puerta, pero la voz de Septem te hace pausar."
    "You prepare to knock, but Septem's voice makes you pause."

# game/rutas/labelsact2.rpy:845
translate ingles act3_explorar_septem_a6942ec7:

    # septem "Pasa."
    septem "Come in."

# game/rutas/labelsact2.rpy:846
translate ingles act3_explorar_septem_af69cf18:

    # "Tu estómago da un vuelco al escuchar su voz. Si bien es un comando, tú no tienes la obligación de cumplirlo bajo obligaciones de reglas que aún no entiendes."
    "Your stomach twists at the sound of his voice. Although it's a command, you're not obligated to obey it under the rules you still don't understand."

# game/rutas/labelsact2.rpy:847
translate ingles act3_explorar_septem_4ff0cd05:

    # "No ha dicho tu nombre, por lo que eres libre de tomar la decisión de si pasar o no."
    "He hasn't said your name, so you're free to decide whether to enter or not."

# game/rutas/labelsact2.rpy:848
translate ingles act3_explorar_septem_287fee54:

    # "Te preguntas que pasaría si no lo haces."
    "You wonder what would happen if you didn't."

# game/rutas/labelsact2.rpy:851
translate ingles act3_explorar_septem_8ff0443a:

    # septem "¿Has cambiado de opinión?"
    septem "Have you changed your mind?"

# game/rutas/labelsact2.rpy:852
translate ingles act3_explorar_septem_912b1f5f:

    # septem "Parecías muy decidido a venir antes de llegar aquí."
    septem "You seemed quite determined to come here before you arrived."

# game/rutas/labelsact2.rpy:853
translate ingles act3_explorar_septem_fc2fbe90:

    # "Septem solo ríe, divertido con tu cambio tan repentino en tu actitud... su risa casi se siente como una burla por su parte."
    "Septem simply laughs, amused by your sudden change in attitude... his laughter almost feels like he's mocking you."

# game/rutas/labelsact2.rpy:854
translate ingles act3_explorar_septem_01d06a44:

    # septem "Recuerda de que tenemos que salir al mediodía."
    septem "Remember, we have to leave at noon."

# game/rutas/labelsact2.rpy:855
translate ingles act3_explorar_septem_2097e277:

    # septem "No te vayas tan lejos. Este lugar es más grande de lo que crees."
    septem "Don't wander too far. This place is bigger than you think."

# game/rutas/labelsact2.rpy:863
translate ingles act3_explorar_septem_dedcd9f9:

    # "La puerta se abre antes de que puedas tocar el pomo y empujar."
    "The door opens before you can turn the handle and push."

# game/rutas/labelsact2.rpy:864
translate ingles act3_explorar_septem_45b079f9:

    # "Dentro de la biblioteca, Septem se encuentra al frente del ventanal, devolviéndote la mirada. Sus manos yacen entrelazadas detrás de su espalda, con una postura anormalmente recta."
    "Inside the library, Septem stands in front of the large window, returning your gaze. His hands are clasped behind his back, his posture unnaturally straight."

# game/rutas/labelsact2.rpy:865
translate ingles act3_explorar_septem_018264be:

    # "Te esperabas encontrarlo sentado en su escritorio, leyendo algo con el semblante serio, tal vez con las cejas fruncidas y una pequeña mueca en tu boca."
    "You expected to find him sitting at his desk, reading something with a serious expression, perhaps with his brows furrowed and a slight grimace on his lips."

# game/rutas/labelsact2.rpy:866
translate ingles act3_explorar_septem_43710aac:

    # "Verlo ahí te confirma que debe haber estado mirando por la ventana antes de que entraras."
    "Seeing him there confirms that he must have been looking out the window before you entered."

# game/rutas/labelsact2.rpy:867
translate ingles act3_explorar_septem_e11b6472:

    # septem "Ven, siéntate."
    septem "Come, sit down."

# game/rutas/labelsact2.rpy:871
translate ingles act3_explorar_septem_f7a86a75:

    # "Rompe el silencio luego de ver que te has quedado pasmado en la puerta, sin saber que hacer. Septem corre la silla del escritorio, donde él se sienta, ofreciendo el lugar para ti."
    "He breaks the silence after noticing that you've frozen in the doorway, unsure of what to do. Septem pulls out the desk chair where he usually sits, offering you his seat."

# game/rutas/labelsact2.rpy:872
translate ingles act3_explorar_septem_5784d075:

    # "Avanzas y te sientas con cuidado en la silla."
    "You approach and carefully sit down in the chair."

# game/rutas/labelsact2.rpy:875
translate ingles act3_explorar_septem_3ab76f72:

    # septem "Te queda bien."
    septem "It suits you."

# game/rutas/labelsact2.rpy:880
translate ingles act3_explorar_septem_7aef4df7:

    # "Cuando le miras para entender a que se refiere, Septem agrega señalando con la mano en tu dirección."
    "When you look at him, trying to understand what he means, Septem adds, gesturing toward you with his hand."

# game/rutas/labelsact2.rpy:885
translate ingles act3_explorar_septem_19fbb461:

    # septem "Tus vestimentas."
    septem "Your attire."

# game/rutas/labelsact2.rpy:888
translate ingles act3_explorar_septem_1bdd86c1:

    # "Oh... sientes tu cara enrojecer..."
    "Oh... you feel your face turning red..."

# game/rutas/labelsact2.rpy:889
translate ingles act3_explorar_septem_14af9c47:

    # "Te encojes en la silla, no sabiendo que hacer con el cumplido que te ha hecho Septem. Te obligas a decir un 'gracias' que suena ahogado, delatando tu nerviosismo."
    "You shrink into your chair, uncertain of what to do with Septem's compliment. You force yourself to say a muffled 'thank you,' betraying your nervousness."

# game/rutas/labelsact2.rpy:890
translate ingles act3_explorar_septem_0e16ac8c:

    # "Septem se acerca un poco más a ti, invadiendo tu espacio personal por un segundo, antes de retomar la distancia previa con una de tus mangas en la mano."
    "Septem moves a little closer, invading your personal space for a moment before stepping back to his previous distance, holding one of your sleeves in his hand."

# game/rutas/labelsact2.rpy:894
translate ingles act3_explorar_septem_fb4e1281:

    # septem "Las mangas se han ensuciado un poco."
    septem "The sleeves have gotten a little dirty."

# game/rutas/labelsact2.rpy:895
translate ingles act3_explorar_septem_f6c44922:

    # "Dice él examinando la tela. Pasa sus dedos por cada hebra que compone la manga, acariciando con suavidad."
    "He says, examining the fabric. He runs his fingers over each thread that makes up the sleeve, gently caressing it."

# game/rutas/labelsact2.rpy:900
translate ingles act3_explorar_septem_e264e1a7:

    # septem "Al parecer las hice muy largas para ti."
    septem "It seems I made them too long for you."

# game/rutas/labelsact2.rpy:901
translate ingles act3_explorar_septem_64b3fcc6:

    # "Sientes su enojo subir por tu tráquea."
    "You feel his anger rising through your throat."

# game/rutas/labelsact2.rpy:902
translate ingles act3_explorar_septem_ac05027a:

    # septem "Las arrastras al caminar."
    septem "You drag them along the ground when you walk."

# game/rutas/labelsact2.rpy:907
translate ingles act3_explorar_septem_266f67c0:

    # "Las mangas se han ensuciado porque son en extremo largas, claro. No es tu culpa, pero parte de ti espera que Septem te dé un sermón por ensuciar las ropas que te ha cedido, como mínimo."
    "The sleeves have gotten dirty because they're extremely long, of course. It's not your fault, but part of you expects Septem to at least lecture you for dirtying the clothes he's given you."

# game/rutas/labelsact2.rpy:908
translate ingles act3_explorar_septem_1e08577f:

    # "No lo puedes evitar. Más cuando sientes como su enojo bombea por tu sangre."
    "You can't help it. Especially when you feel his anger pumping through your veins."

# game/rutas/labelsact2.rpy:909
translate ingles act3_explorar_septem_5927d8c5:

    # "Él es muy severo con su juicio y expectativas con el resto de las entidades que interactúa... y tú no puedes ser la excepción..."
    "He's very strict in his judgments and expectations of the other entities he interacts with... and you can't be the exception..."

# game/rutas/labelsact2.rpy:913
translate ingles act3_explorar_septem_66e736f8:

    # "El tirón en tu manga hace que cierres los ojos con fuerza."
    "The tug on your sleeve makes you squeeze your eyes shut."

# game/rutas/labelsact2.rpy:914
translate ingles act3_explorar_septem_31924e0f_1:

    # septem "..."
    septem "..."

# game/rutas/labelsact2.rpy:915
translate ingles act3_explorar_septem_3a474e4b:

    # septem "Listo."
    septem "There."

# game/rutas/labelsact2.rpy:916
translate ingles act3_explorar_septem_2437573e:

    # "Al no sentir nada en tu cuerpo parecido al dolor, abres tus ojos."
    "When you feel nothing resembling pain in your body, you open your eyes."

# game/rutas/labelsact2.rpy:920
translate ingles act3_explorar_septem_d6a28860:

    # "Lo primero vez es la mano de Septem con la mitad de tu manga, perfectamente cortada."
    "The first thing you see is Septem's hand holding half of your sleeve, perfectly cut."

# game/rutas/labelsact2.rpy:924
translate ingles act3_explorar_septem_6af7dc8e:

    # septem "Ese error no volverá a cometerse."
    septem "That mistake won't be made again."

# game/rutas/labelsact2.rpy:929
translate ingles act3_explorar_septem_fe74f763:

    # septem "Tus próximas vestimentas no tendrán esa falla, mi salvador."
    septem "Your next outfit won't have that flaw, my savior."

# game/rutas/labelsact2.rpy:934
translate ingles act3_explorar_septem_a0cf66eb:

    # "Ah..."
    "Ah..."

# game/rutas/labelsact2.rpy:935
translate ingles act3_explorar_septem_6b623f95:

    # "El enojo que estabas sintiendo era por su error... no el tuyo."
    "The anger you were feeling was because of his mistake... not yours."

# game/rutas/labelsact2.rpy:936
translate ingles act3_explorar_septem_f0d26964:

    # "No sabes si eso es malo y bueno..."
    "You don't know whether that's a good or a bad thing..."

# game/rutas/labelsact2.rpy:940
translate ingles act3_explorar_septem_167b29d2:

    # "Pasas el tiempo junto con Septem en la biblioteca. Él te trae un libro que deja en el escritorio. Es grande, de esos que hacen un ruido seco y fuerte cuando los dejas caer en la mesa."
    "You spend some time with Septem in the library. He brings you a book and sets it on the desk. It's large, the kind that makes a loud, heavy thud when dropped onto a table."

# game/rutas/labelsact2.rpy:941
translate ingles act3_explorar_septem_147cab8b:

    # "Mientras miras el libro, Septem opta por quedarse erguido detrás de tu silla."
    "While you look at the book, Septem chooses to remain standing upright behind your chair."

# game/rutas/labelsact2.rpy:942
translate ingles act3_explorar_septem_f68868e0:

    # septem "Un líder competente debe saber el idioma de su gente."
    septem "A competent leader must know the language of their people."

# game/rutas/labelsact2.rpy:943
translate ingles act3_explorar_septem_d48efa62:

    # "Escuchas su voz detrás se tu oreja, tan cerca que los vellos de tus brazos se erizan al percibir su aliento cerca de tu cuello."
    "You hear his voice just behind your ear, so close that the hairs on your arms stand on end when you feel his breath near your neck."

# game/rutas/labelsact2.rpy:944
translate ingles act3_explorar_septem_0984a5ff:

    # "No puedes evitar girar tu cabeza para comprobar la distancia que existe entre tú y él."
    "You can't help turning your head to see just how much distance there is between you and him."

# game/rutas/labelsact2.rpy:948
translate ingles act3_explorar_septem_7b99523a:

    # "Un pedazo de alma sale por tu boca cuando te encuentras con su cara a centímetros de ti, asomándose por tu hombro derecho."
    "A piece of your soul practically escapes through your mouth when you find his face just inches from yours, peering over your right shoulder."

# game/rutas/labelsact2.rpy:949
translate ingles act3_explorar_septem_69dad36c:

    # "Septem te sostiene la mirada, sin reacción aparente, y continúa."
    "Septem holds your gaze without any apparent reaction and continues."

# game/rutas/labelsact2.rpy:952
translate ingles act3_explorar_septem_5d7d7187:

    # septem "Quien dirige la palabra, debe saber leerla y hablarla."
    septem "One who commands through words must know how to read and speak them."

# game/rutas/labelsact2.rpy:953
translate ingles act3_explorar_septem_d41a1db6:

    # septem "La lengua madre del Jardín es el latín."
    septem "The native language of the Garden is Latin."

# game/rutas/labelsact2.rpy:954
translate ingles act3_explorar_septem_ddc3a000:

    # septem "Tú la usarás para invocar y comandar."
    septem "You will use it to summon and command."

# game/rutas/labelsact2.rpy:959
translate ingles act3_explorar_septem_84189069:

    # "Una de sus manos se desliza por tu brazo hasta llegar a tu cuello. Sin apretar su agarre, su dedo índice marca y traza la arteria que se encuentra al lado izquierdo."
    "One of his hands slides along your arm until it reaches your neck. Without tightening his grip, his index finger traces the artery on the left side."

# game/rutas/labelsact2.rpy:960
translate ingles act3_explorar_septem_165eaf04:

    # "Lo hace lento, buscando el bombeo de la sangre que llevan tus venas. Al tragar saliva, Septem siente el movimiento de tu garganta, y aprieta el agarre un poco más, escapándosele un suspiro..."
    "He does it slowly, searching for the pulse of blood flowing through your veins. When you swallow, Septem feels the movement of your throat and tightens his grip a little, letting out a sigh..."

# game/rutas/labelsact2.rpy:961
translate ingles act3_explorar_septem_74745db3:

    # "Ahora te es imposible ignorar como sus dedos se clavan en tu piel."
    "Now it's impossible to ignore the way his fingers dig into your skin."

# game/rutas/labelsact2.rpy:962
translate ingles act3_explorar_septem_c4fe784a:

    # septem "El tono al nombrar las palabras tiene que ser exacto. Un solo flaqueo en el, rompe la invocación."
    septem "The tone used to pronounce the words must be exact. A single falter will break the invocation."

# game/rutas/labelsact2.rpy:963
translate ingles act3_explorar_septem_a20cefa7_4:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:964
translate ingles act3_explorar_septem_69eeeb14:

    # septem "Abre el libro en la página veinticuatro."
    septem "Open the book to page twenty-four."

# game/rutas/labelsact2.rpy:967
translate ingles act3_explorar_septem_68fddb73:

    # "Lo haces como puedes. Tu cabeza está en todos lados menos en la finalidad de la tarea y estás más que seguro que nada de lo que hagas o aprendas se quedará realmente contigo después de esto."
    "You do your best. Your mind is everywhere except on the purpose of the task, and you're more than certain that none of what you do or learn will really stay with you after this."
    
# game/rutas/labelsact2.rpy:968
translate ingles act3_explorar_septem_c9ddb221:

    # "Hay un montón de sensaciones y sentimientos que se ebullen en tu cuerpo, pero el miedo no es una de ellas."
    "There are countless sensations and emotions bubbling inside your body, but fear isn't one of them."

# game/rutas/labelsact2.rpy:969
translate ingles act3_explorar_septem_64aa035b:

    # "Y Septem lo sabe."
    "And Septem knows it."

# game/rutas/labelsact2.rpy:970
translate ingles act3_explorar_septem_687a63aa:

    # septem "No te distraigas."
    septem "Don't get distracted."

# game/rutas/labelsact2.rpy:971
translate ingles act3_explorar_septem_42d8dbf7:

    # "Su llamado de atención no hace más que quieras maldecirlo por ponerte en esta situación."
    "His reprimand only makes you want to curse him for putting you in this situation."

# game/rutas/labelsact2.rpy:977
translate ingles act3_explorar_septem_439922c1:

    # septem "Lo primero que debemos saber antes de hacer una invocación es a quien te refieres."
    septem "The first thing we need to know before performing an invocation is whom you're referring to."

# game/rutas/labelsact2.rpy:978
translate ingles act3_explorar_septem_a6db342a:

    # septem "Sea un tú, un yo o un nosotros."
    septem "Whether it's a you, an I, or a we."

# game/rutas/labelsact2.rpy:979
translate ingles act3_explorar_septem_c5838158:

    # "Con la mano disponible, Septem te muestra donde salen esas palabras y te hace repetirlas en latín. Cuando detecta que tu voz se rompe o flaquea, sus dedos ayudan apretando o soltando tu garganta para dejar salir la voz justo como él quiere."
    "With his free hand, Septem shows you where those words appear and makes you repeat them in Latin. Whenever he notices your voice breaking or faltering, his fingers help by tightening or loosening their grip on your throat, making your voice come out exactly as he wants."

# game/rutas/labelsact2.rpy:980
translate ingles act3_explorar_septem_e0f9d97b:

    # "Así que para eso ha puesto su mano ahí..."
    "So that's why he put his hand there..."

# game/rutas/labelsact2.rpy:981
translate ingles act3_explorar_septem_8ca3fdaf:

    # septem "Cuando pedimos algo que solo te involucre a ti, debes decir---"
    septem "When requesting something that involves only yourself, you must say--"

# game/rutas/labelsact2.rpy:982
translate ingles act3_explorar_septem_25f8068f:

    # "Su cuerpo se acerca más al tuyo, rozando tu hombro con su pecho, tomando la oportunidad de colocar su boca directamente en tu oído. Resguardando sus palabras solo para ti, como si alguien más pudiese escuchar y robarte esas palabras de ti."
    "His body moves closer to yours, his chest brushing against your shoulder as he takes the opportunity to bring his mouth directly to your ear. Keeping his words just for you, as though someone else might overhear them and steal those words from you."

# game/rutas/labelsact2.rpy:983
translate ingles act3_explorar_septem_8374cf11:

    # septem "{i}Sub potestate quae mihi conceditur ego faciam...{i} \n {size=*0.6}Bajo el poder que me confiere, yo hare.{/size}"
    septem "{i}Sub potestate quae mihi conceditur ego faciam...{/i} \n {size=*0.6}By the power bestowed upon me, I shall do...{/size}"

# game/rutas/labelsact2.rpy:984
translate ingles act3_explorar_septem_0745cac8:

    # "Las palabras que salen de su boca son desconocidas, pero las entiendes de alguna manera. El problema reside en poder imitar su vocalización..."
    "The words coming from his mouth are unfamiliar, but somehow you understand them. The problem lies in being able to imitate his pronunciation..."

# game/rutas/labelsact2.rpy:985
translate ingles act3_explorar_septem_884244f6:

    # "Dudas que lo puedas hacer a la primera, sin tropezar con la lengua al soltar todas las palabras en una frase."
    "You doubt you'll be able to do it on your first try without stumbling over your tongue while getting all those words out in a single sentence."

# game/rutas/labelsact2.rpy:986
translate ingles act3_explorar_septem_1f205ceb:

    # septem "Repite."
    septem "Repeat."

# game/rutas/labelsact2.rpy:987
translate ingles act3_explorar_septem_8374cf11_1:

    # septem "{i}Sub potestate quae mihi conceditur ego faciam...{i} \n {size=*0.6}Bajo el poder que me confiere, yo hare.{/size}"
    septem "{i}Sub potestate quae mihi conceditur ego faciam...{/i} \n {size=*0.6}By the power bestowed upon me, I shall do...{/size}"

# game/rutas/labelsact2.rpy:991
translate ingles act3_explorar_septem_8e2c6cdd:

    # "Lo intentas una vez, sin lograrlo del todo. Dos veces, te ahogas con tu propia saliva... que Humillante. A la tercera, ya tienes a Septem apretando tu garganta para sacar correctamente las vibraciones de cada comando."
    "You try once, without quite getting it right. Twice, and you choke on your own saliva... how humiliating. By the third attempt, Septem is already squeezing your throat to make you produce the correct vibrations for each command."

# game/rutas/labelsact2.rpy:992
translate ingles act3_explorar_septem_3ffcdc11:

    # "Él es estricto y serio, pero cuando ve que te frustras y refunfuñas como un gato enojado, no puede evitar soltar una pequeña risa que oculta con la mano."
    "He's strict and serious, but when he sees you getting frustrated and grumbling like an angry cat, he can't help letting out a little laugh, which he hides behind his hand."

# game/rutas/labelsact2.rpy:993
translate ingles act3_explorar_septem_142cf103:

    # "Intentas nuevamente. Ahora la lengua la tienes suelta de tanto pronunciar cada palabra, lo te permite sacarlas de tu boca con más fluidez"
    "You try again. Your tongue has loosened up from pronouncing each word so many times, allowing you to say them more fluently."

# game/rutas/labelsact2.rpy:994
translate ingles act3_explorar_septem_7468a116:

    # "Tu avance no pasa desapercibido. Septem se encarga de reconocerlo cada vez que lo haces bien o cuando vas por buen camino."
    "Your progress doesn't go unnoticed. Septem makes sure to acknowledge it whenever you get something right or are on the right track."

# game/rutas/labelsact2.rpy:995
translate ingles act3_explorar_septem_d0ef6769:

    # "Se ríe cuando fallas, pero no es una risa burlona. No. Es una risa que late con ternura al verte intentarlo, y desborda orgullo al ver progreso en tu pronunciación."
    "He laughs when you make mistakes, but it isn't mocking laughter. No. It's laughter filled with tenderness as he watches you try, overflowing with pride when he sees your pronunciation improve."

# game/rutas/labelsact2.rpy:996
translate ingles act3_explorar_septem_a54f1628:

    # "Cuando por fin lo logras, Septem te felicita, enfatizando lo perfecto que ha salido."
    "When you finally succeed, Septem congratulates you, emphasizing how perfectly you did."

# game/rutas/labelsact2.rpy:997
translate ingles act3_explorar_septem_6e36546a:

    # "Septem es un buen maestro."
    "Septem is a good teacher."

# game/rutas/labelsact2.rpy:1001
translate ingles act3_explorar_septem_bbe140b7:

    # septem "Para pedir algo que involucre a un otro, un {i}tú{i}, debes decir---"
    septem "To request something involving another person, a {i}you{/i}, you must say--"

# game/rutas/labelsact2.rpy:1002
translate ingles act3_explorar_septem_d9282ca6:

    # septem "{i}Sub potestate quae mihi conceditur, tu facies...{i} \n {size=*0.6}Bajo el poder que me confiere, tú harás.{/size}"
    septem "{i}Sub potestate quae mihi conceditur, tu facies...{/i} \n {size=*0.6}By the power bestowed upon me, you shall do...{/size}"

# game/rutas/labelsact2.rpy:1003
translate ingles act3_explorar_septem_84197a25:

    # "Habiendo pronunciado el anterior comando, te es más fácil sacar este. Lo único que cambia son las palabras del final."
    "Having pronounced the previous command, you find this one easier to say. The only difference is in the words at the end."

# game/rutas/labelsact2.rpy:1004
translate ingles act3_explorar_septem_0161b45e:

    # septem "Y para un nosotros, sería---"
    septem "And for a we, it would be--"

# game/rutas/labelsact2.rpy:1005
translate ingles act3_explorar_septem_74648207:

    # septem "{i}Sub potestate quae mihi conceditur, nos faciemu... {i} \n {size=*0.6}Bajo el poder que me confiere, nosotros haremos...{/size}"
    septem "{i}Sub potestate quae mihi conceditur, nos faciemu... {/i} \n {size=*0.6}By the power bestowed upon me, we shall do...{/size}"

# game/rutas/labelsact2.rpy:1009
translate ingles act3_explorar_septem_dc61691d:

    # "Ya lo tienes dominado. No necesitas la guía de Septem con sus dedos o pausas para pedir que él te lo repita porque tú lo has olvidado."
    "You've already mastered it. You no longer need Septem to guide you with his fingers or pause to ask him to repeat something you've forgotten."

# game/rutas/labelsact2.rpy:1010
translate ingles act3_explorar_septem_3d2c81bf:

    # "Ya lo manejas, por lo que Septem te deja descansar."
    "You've got the hang of it now, so Septem lets you rest."

# game/rutas/labelsact2.rpy:1011
translate ingles act3_explorar_septem_9630a409:

    # "Eventually, you begin to wonder whether you should stay here or go out and see what else there is to discover."
    "Eventually, you begin to wonder whether you should stay here or go out and see what else there is to discover."

# game/rutas/labelsact2.rpy:1015
translate ingles act3_explorar_septem_2e716117:

    # "Te despides de Septem, excusándote, diciendo que quieres seguir explorando el templo."
    "You say goodbye to Septem, excusing yourself by saying you want to continue exploring the temple."

# game/rutas/labelsact2.rpy:1016
translate ingles act3_explorar_septem_8d8cbbe1:

    # "Él te desea suerte."
    "He wishes you luck."

# game/rutas/labelsact2.rpy:1020
translate ingles act3_explorar_septem_73c1b6c5:

    # "Quedarte con Septem no suena mal. Te gusta pasar el tiempo con él."
    "Staying with Septem doesn't sound bad. You enjoy spending time with him."

# game/rutas/labelsact2.rpy:1021
translate ingles act3_explorar_septem_fac649fb:

    # "El tiempo pasa y cuenta no te das cuando Septem te comenta que ya es hora. Te espera para que tú te levantes de su silla y camina junto contigo a la entrada del templo."
    "Time passes without you even noticing, until Septem tells you it's time. He waits for you to get up from his chair and walks with you to the temple entrance."

# game/rutas/labelsact2.rpy:1026
translate ingles act3_explorar_septem_a3424ce1:

    # "No queda otra que esperar..."
    "There's nothing left to do but wait..."

# game/rutas/labelsact2.rpy:1027
translate ingles act3_explorar_septem_0e2d87c9:

    # "Sabes que de mediodía cuando la voz de Septem te llama por tu nombre, haciendo que todo tu cuerpo se enderece."
    "You know it's noon when Septem's voice calls your name, making your entire body straighten up."

# game/rutas/labelsact2.rpy:1028
translate ingles act3_explorar_septem_4354b283:

    # "No esperas mucho para apreciar como su cuerpo se materializa frente de ti. Con esa apariencia tan refinada y gloriosa que no permite la aparición alguna imperfección."
    "It doesn't take long for his body to materialize before you. With that refined, glorious appearance of his, one that allows no trace of imperfection."

# game/rutas/labelsact2.rpy:1029
translate ingles act3_explorar_septem_24a15800:

    # "Septem te pide que camines con él hasta la entrada del templo. Te espera cuando nota que vas atrás, siempre intentando ir a la par tus pasos."
    "Septem asks you to walk with him to the temple entrance. He waits whenever he notices you're falling behind, always trying to match your pace."

# game/rutas/labelsact2.rpy:1038
translate ingles explorar_unum_act3_87651cf1:

    # "Sabes que Noor se ha ido al patio, lo conoces tan bien que no te cabe duda de ello."
    "You know Noor has gone out to the courtyard. You know him so well that you have no doubt about it."

# game/rutas/labelsact2.rpy:1039
translate ingles explorar_unum_act3_21baa8a5:

    # "Así que vas en su búsqueda."
    "So you go looking for him."

# game/rutas/labelsact2.rpy:1042
translate ingles explorar_unum_act3_428bfbd8:

    # "Apenas sales de la residencia, y ya lo divisas a lo lejos."
    "You've barely stepped outside the residence when you spot him in the distance."

# game/rutas/labelsact2.rpy:1043
translate ingles explorar_unum_act3_9d24b5ed:

    # "Se encuentra acostado en el suelo, dormitando con ambos brazos encima de su estómago, en posición de descanso. Su cola barre el suelo en un serpenteo constante, buscando cada roce."
    "He's lying on the ground, dozing with both arms resting on his stomach. His tail sweeps across the ground in a constant serpentine motion, seeking every bit of contact."

# game/rutas/labelsact2.rpy:1045
translate ingles explorar_unum_act3_c23ceeea:

    # "Se le ve tan agusto que decides no molestarlo con acercarte. Por lo que lo miras de lejos."
    "He looks so comfortable that you decide not to disturb him by approaching. Instead, you watch him from a distance."

# game/rutas/labelsact2.rpy:1047
translate ingles explorar_unum_act3_10525044:

    # "Él nota tu presencia, su mirada te lo confirma."
    "He notices your presence. The look in his eyes confirms it."

# game/rutas/labelsact2.rpy:1048
translate ingles explorar_unum_act3_1aeedfd2:

    # noor "Ven."
    noor "Come."

# game/rutas/labelsact2.rpy:1049
translate ingles explorar_unum_act3_0cd2f2bc:

    # "Te pide, palpando el suelo."
    "He asks, patting the ground."

# game/rutas/labelsact2.rpy:1050
translate ingles explorar_unum_act3_6713caef:

    # "Vas sin apuro, aunque desearías ir corriendo para saltar en sus brazos y acurrucarte con tu bebé."
    "You approach without rushing, although you wish you could run over, jump into his arms, and cuddle with your baby."

# game/rutas/labelsact2.rpy:1051
translate ingles explorar_unum_act3_db59fc65:

    # "Pero te aguantas... Noor ya está grande, no quiere ser tratado como un bebé."
    "But you restrain yourself... Noor is a big boy now. He doesn't want to be treated like a baby."

# game/rutas/labelsact2.rpy:1052
translate ingles explorar_unum_act3_a20cefa7:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:1053
translate ingles explorar_unum_act3_e1998f9e:

    # "Te recuestas como puedes a su lado. Copias la misma pose que tiene, mirando al cielo con las manos descansando encima del vientre."
    "You lie down beside him as best you can. You copy his posture, gazing up at the sky with your hands resting on your stomach."

# game/rutas/labelsact2.rpy:1056
translate ingles explorar_unum_act3_ca3bf1a7:

    # "Escuchar su respiración te llena de calma, es tan natural que olvidas que a tu lado tienes a un semidios. No es artificial y vacía como la de Unum, tiene pausas que denotan vida, exalaciones que transmiten una canción llena de vida."
    "Listening to his breathing fills you with peace. It's so natural that you forget there's a demigod lying beside you. It isn't artificial and hollow like Unum's. It has pauses that reveal life, exhalations that carry a song full of life."

# game/rutas/labelsact2.rpy:1057
translate ingles explorar_unum_act3_450902ba:

    # "La entidad que tienes aquí a tu lado, es más humano que dios. Un niño con sueños y deseos, que pide a gritos ser contenido por un adulto competente."
    "The entity lying here beside you is more human than god. A child with dreams and desires, crying out for the comfort and guidance of a capable adult."

# game/rutas/labelsact2.rpy:1058
translate ingles explorar_unum_act3_38434217:

    # "Tú quieres ser aquel quien lo contenga y cuide del resto de este mundo, al menos por el tiempo que le queda para desarrollarse."
    "You want to be the one who comforts him and protects him from the rest of this world, at least for as long as he still needs to grow."

# game/rutas/labelsact2.rpy:1059
translate ingles explorar_unum_act3_a20cefa7_1:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:1060
translate ingles explorar_unum_act3_d057a113:

    # "Pasas el tiempo mirando el cielo, en compañía silenciosa de tu hijo. Disfrutando el momento junto con él."
    "You spend your time gazing at the sky, enjoying the quiet company of your son; simply enjoying the moment with him."

# game/rutas/labelsact2.rpy:1061
translate ingles explorar_unum_act3_e08bd723:

    # "Cuando te percatas de que Noor se ha dormido, te levantas. Le miras por un tiempo antes de decidir si despertarlo o no."
    "When you realize Noor has fallen asleep, you get up. You watch him for a while before deciding whether to wake him."

# game/rutas/labelsact2.rpy:1064
translate ingles explorar_unum_act3_6298a972:

    # "Es mejor dejarle este tiempo para que descanse, se lo merece."
    "It's better to let him have this time to rest. He deserves it."

# game/rutas/labelsact2.rpy:1069
translate ingles explorar_unum_act3_d9c059c1:

    # "Ir a ver lo que Shams está haciendo junto a Ignis no es mala idea, tienes un poco de curiosidad acerca de las habilidades culinaria de la mayor de los gemelos."
    "Going to see what Shams is doing with Ignis isn't a bad idea. You're a little curious about the older twin's culinary skills."

# game/rutas/labelsact2.rpy:1071
translate ingles explorar_unum_act3_2e9a7c6e:

    # "No te sorprende ver a tu hija rezongar cuando erra en las notas más altas o difíciles del cantido, pero aun así es divertido de ver."
    "You're not surprised to see your daughter grumbling whenever she gets the higher or more difficult notes of the chant wrong, but it's still amusing to watch."

# game/rutas/labelsact2.rpy:1072
translate ingles explorar_unum_act3_bddf2de8:

    # "Finge un llanto que pone a Ignis de pelos de punta, haciendo que la mujer que siempre parece tan compuesta, alce la voz y demande orden en la cocina."
    "She pretends to cry, getting on Ignis's nerves and making the woman who always seems so composed raise her voice and demand order in the kitchen."

# game/rutas/labelsact2.rpy:1073
translate ingles explorar_unum_act3_32726770:

    # "Le advierte a Shams que si no deja de llorar, no continuará la lección."
    "She warns Shams that if she doesn't stop crying, she won't continue the lesson."

# game/rutas/labelsact2.rpy:1074
translate ingles explorar_unum_act3_bec334e1:

    # "Eso le basta a la chiquilla para cesar todo llanto y enderece la compostura, sin antes pedir perdón."
    "That's enough to make the little girl stop crying and straighten up, but not before apologizing."

# game/rutas/labelsact2.rpy:1075
translate ingles explorar_unum_act3_349f451d:

    # "Ignis, por lo bajo, se lamenta el parecido que tiene la niña con Unum."
    "Under her breath, Ignis laments how much the girl resembles Unum."

# game/rutas/labelsact2.rpy:1080
translate ingles explorar_unum_act3_4c504a0d:

    # "La residencia de las esposas de Unum es totalmente diferente a la de Unum; no hay pinturas que rozan lo grotesco, o habitaciones amuebladas que intenten simular un hogar típico del mundo real."
    "The residence of Unum's wives is completely different from Unum's own; there are no paintings bordering on the grotesque, nor furnished rooms attempting to imitate a typical home from the real world."

# game/rutas/labelsact2.rpy:1081
translate ingles explorar_unum_act3_5d41a8fc:

    # "Todo aquí tiene un propósito. No existen decoraciones para embellecer la casa, ni menos muebles que puedan servir como comodidades para sentarse a descansar o dormir."
    "Everything here serves a purpose. There are no decorations to beautify the house, much less furniture that might offer the comfort of sitting down to rest or sleep."

# game/rutas/labelsact2.rpy:1083
translate ingles explorar_unum_act3_00ef646b:

    # "Es chocante como la residencia no presenta nada de lo que debería existir en un hogar. Lo único remotamente humano es la cocina -la cual es una copia de la que tiene Unum- y una mesa para comer."
    "It's shocking how the residence lacks everything that should exist in a home. The only remotely human things are the kitchen--which is a copy of Unum's--and a dining table."

# game/rutas/labelsact2.rpy:1085
translate ingles explorar_unum_act3_55c644d1:

    # "El resto, es solo espacio muerto, habitaciones vacías o lugares a los cuales físicamente no puedes acceder por falta de suelo."
    "The rest is nothing but dead space, empty rooms, or places you physically cannot reach because there's no floor."

# game/rutas/labelsact2.rpy:1086
translate ingles explorar_unum_act3_a20cefa7_2:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:1087
translate ingles explorar_unum_act3_3697839c:

    # "Da miedo."
    "It's frightening."

# game/rutas/labelsact2.rpy:1110
translate ingles explorar_nulla_act3_9aa8b63c:

    # "Llevas a Nulla de la mano por la casa, dirigiéndolo a su habitación."
    "You lead Nulla by the hand through the house, guiding him toward his room."

# game/rutas/labelsact2.rpy:1114
translate ingles explorar_nulla_act3_3b926bee:

    # "Nulla es quien te abre la puerta, dejando que pases primero con un gesto de su mano."
    "Nulla opens the door for you, gesturing for you to enter first."

# game/rutas/labelsact2.rpy:1115
translate ingles explorar_nulla_act3_bdbb0a05:

    # "El escritorio está esperándote junto con la hoja en donde has escrito tu pequeño mensaje."
    "The desk awaits you, along with the sheet of paper where you've written your little message."

# game/rutas/labelsact2.rpy:1116
translate ingles explorar_nulla_act3_2e12685c:

    # "Sin vacilación en tus movimientos, le entregas la hoja a Nulla para que sea él quien lo lea."
    "Without a moment's hesitation, you hand the paper to Nulla for him to read."

# game/rutas/labelsact2.rpy:1117
translate ingles explorar_nulla_act3_2d9897de:

    # "Nulla se hace el sorprendido. Sospechas que, al menos, se ha aguantado las ganas de no leer el contenido..."
    "Nulla pretends to be surprised. You suspect that, at the very least, he's been holding back the urge to read its contents..."

# game/rutas/labelsact2.rpy:1121
translate ingles explorar_nulla_act3_3c160677:

    # "Nulla lee tu mensaje en voz alta luego de sentarse en su cama."
    "Nulla reads your message aloud after sitting down on his bed."

# game/rutas/labelsact2.rpy:1122
translate ingles explorar_nulla_act3_a38a6a88:

    # nulla "[mensaje_guardado]"
    nulla "[mensaje_guardado]"

# game/rutas/labelsact2.rpy:1124
translate ingles explorar_nulla_act3_a20cefa7:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:1128
translate ingles explorar_nulla_act3_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/labelsact2.rpy:1129
translate ingles explorar_nulla_act3_df6a1a43:

    # nulla "[nombrejugador], corazón."
    nulla "[nombrejugador], corazón."

# game/rutas/labelsact2.rpy:1133
translate ingles explorar_nulla_act3_9e4ed399:

    # nulla "Pfff--"
    nulla "Pfff--"

# game/rutas/labelsact2.rpy:1134
translate ingles explorar_nulla_act3_e26e3116:

    # "Nulla suelta aire, que se traduce en una risa mal formada. Una que intenta contener, asustado de que se malinterprete su intención. Se le ve nervioso, no sabiendo cómo reaccionar."
    "Nulla lets out a breath that turns into an awkward laugh. One he tries to suppress, afraid that his intentions might be misunderstood. He looks nervous, unsure of how to react."

# game/rutas/labelsact2.rpy:1135
translate ingles explorar_nulla_act3_31150a8c:

    # nulla "No puede ser..."
    nulla "I can't believe it..."

# game/rutas/labelsact2.rpy:1139
translate ingles explorar_nulla_act3_758bb293:

    # "Observas como su mandíbula tiembla por unos segundos, al igual que sus manos que sostienen el papel con tu mensaje."
    "You watch his jaw tremble for a few seconds, along with the hands holding the paper with your message."

# game/rutas/labelsact2.rpy:1144
translate ingles explorar_nulla_act3_409f8636_1:

    # nulla "..."
    nulla "..."

# game/rutas/labelsact2.rpy:1145
translate ingles explorar_nulla_act3_b435dd31:

    # nulla "No, no es eso."
    nulla "No, that's not it."

# game/rutas/labelsact2.rpy:1146
translate ingles explorar_nulla_act3_021425df:

    # nulla "Claro que me ha gustado..."
    nulla "Of course I liked it..."

# game/rutas/labelsact2.rpy:1150
translate ingles explorar_nulla_act3_1ffccb32:

    # nulla "¡No!--- no pidas perdón."
    nulla "No--! Don't apologize."

# game/rutas/labelsact2.rpy:1151
translate ingles explorar_nulla_act3_a20cefa7_1:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:1154
translate ingles explorar_nulla_act3_a20cefa7_2:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:1156
translate ingles explorar_nulla_act3_2224cafa:

    # nulla "Ay---"
    nulla "Ay--"

# game/rutas/labelsact2.rpy:1157
translate ingles explorar_nulla_act3_da16815b:

    # "Nulla intenta ocultar su cara con la mano, desviando la mirada al suelo."
    "Nulla tries to hide his face behind his hand, lowering his gaze to the floor."

# game/rutas/labelsact2.rpy:1161
translate ingles explorar_nulla_act3_119db949:

    # nulla "No puedo creer que tenga algo escrito por ti, aquí... conmigo."
    nulla "I can't believe I have something written by you, right here... with me."

# game/rutas/labelsact2.rpy:1162
translate ingles explorar_nulla_act3_f752bd0f:

    # nulla "Algo que pueda mirar directamente y tocar..."
    nulla "Something I can look at directly and touch..."

# game/rutas/labelsact2.rpy:1163
translate ingles explorar_nulla_act3_2f4a7528:

    # nulla "Algo que puedo guardar."
    nulla "Something I can keep."

# game/rutas/labelsact2.rpy:1164
translate ingles explorar_nulla_act3_ca6c3027:

    # nulla "¿Es mío? ¿Me lo puedo quedar?"
    nulla "Is it mine? Can I keep it?"

# game/rutas/labelsact2.rpy:1180
translate ingles explorar_nulla_act3_a6ebd956:

    # "Su rostro se transforma completamente, totalmente ido."
    "His expression changes completely, as though he's lost in another world."

# game/rutas/labelsact2.rpy:1181
translate ingles explorar_nulla_act3_02ad5cd5:

    # "Solo falta que lo bese... o se lo coma... huh."
    "All that's left is for him to kiss it... or eat it... huh."

# game/rutas/labelsact2.rpy:1182
translate ingles explorar_nulla_act3_9408b4dc:

    # nulla "Lo llevaré conmigo."
    nulla "I'll carry it with me."

# game/rutas/labelsact2.rpy:1183
translate ingles explorar_nulla_act3_f0d57a3b:

    # nulla "A donde sea que vaya."
    nulla "Wherever I go."

# game/rutas/labelsact2.rpy:1193
translate ingles explorar_nulla_act3_ca74c9b3:

    # "Nulla sonríe."
    "Nulla smiles."

# game/rutas/labelsact2.rpy:1194
translate ingles explorar_nulla_act3_7e90ee39:

    # nulla "A ver si mi increible [nombrejugador] ha podido crear algo para mí~~~"
    nulla "Let's see if mi increible [nombrejugador] has managed to create something for me~~~"

# game/rutas/labelsact2.rpy:1197
translate ingles explorar_nulla_act3_a20cefa7_3:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:1199
translate ingles explorar_nulla_act3_171efc54:

    # nulla "Wow."
    nulla "Wow."

# game/rutas/labelsact2.rpy:1201
translate ingles explorar_nulla_act3_5cbfdb14:

    # nulla "Woow---"
    nulla "Woow--"

# game/rutas/labelsact2.rpy:1204
translate ingles explorar_nulla_act3_4cf5c386:

    # nulla "Este es el mejor regalo que alguien me ha hecho."
    nulla "This is the best gift anyone has ever given me."

# game/rutas/labelsact2.rpy:1205
translate ingles explorar_nulla_act3_34a1e044:

    # nulla "{size=*0.6}Ay--- se me va a salir el corazón-{/size}"
    nulla "{size=*0.6}Ay--my heart's going to burst out of my chest--{/size}"

# game/rutas/labelsact2.rpy:1207
translate ingles explorar_nulla_act3_ea8a85f3:

    # nulla "Agradece que estás detrás de esa pantalla---"
    nulla "Be grateful you're behind that screen..."

# game/rutas/labelsact2.rpy:1208
translate ingles explorar_nulla_act3_319e7881:

    # nulla "Porque si no fuera por eso---"
    nulla "... Because if it weren't for that--"

# game/rutas/labelsact2.rpy:1217
translate ingles explorar_nulla_act3_383b7bce:

    # "Comienzas a sentir una presión ajena en la parte de tu cuerpo inferior. Miras con urgencia hacia abajo, pensando en la posibilidad de que tu cuerpo ya esté cediendo al uso prolongado y esté comenzando a fallar."
    "You begin to feel an unfamiliar pressure in the lower part of your body. You urgently look down, wondering if your body is finally giving in to prolonged use and beginning to fail."

# game/rutas/labelsact2.rpy:1218
translate ingles explorar_nulla_act3_050cfa77:

    # "Mas solo te encuentras con 4 apéndices formados por las sombras de Nulla. Se enroscan y contorsionan en tus piernas y cintura, imposibilitando una posible huida."
    "But all you find are four appendages formed from Nulla's shadows. They coil and twist around your legs and waist, making any attempt to escape impossible."

# game/rutas/labelsact2.rpy:1221
translate ingles explorar_nulla_act3_989371ed:

    # "Se lo dices antes de que esas cosas te atrapen la boca."
    "You tell him before those things can cover your mouth."

# game/rutas/labelsact2.rpy:1222
translate ingles explorar_nulla_act3_175133bf:

    # nulla "¿Hmm?"
    nulla "Hmm?"

# game/rutas/labelsact2.rpy:1225
translate ingles explorar_nulla_act3_1e865a3a:

    # "Te devuelve la mirada confundido. Y tú no tienes más opción que agitar tu cuerpo para que él lo note."
    "He looks back at you, confused. And you have no choice but to struggle and move your body to make him notice."

# game/rutas/labelsact2.rpy:1230
translate ingles explorar_nulla_act3_f3200e52:

    # "Los apéndices se deslizan por tu cuerpo, subiendo hasta tu cuello. Envolviéndose entre si, bifurcando su camino con cada toque con otro apéndice."
    "The appendages slide along your body, climbing up to your neck. They coil around one another, branching off in different directions whenever they touch another appendage."

# game/rutas/labelsact2.rpy:1231
translate ingles explorar_nulla_act3_002b2e36:

    # "Con cada segundo pasado, las ramificaciones contraen la piel debajo de tus ropas, llegando a un punto en que sientes como la sangre bombea por tus venas."
    "With every passing second, the branches tighten against the skin beneath your clothes, until you can feel the blood pumping through your veins."

# game/rutas/labelsact2.rpy:1232
translate ingles explorar_nulla_act3_90f188e7:

    # nulla "Quiero tenerte."
    nulla "I want you."

# game/rutas/labelsact2.rpy:1233
translate ingles explorar_nulla_act3_e5f203e6:

    # nulla "Te quiero todo para mí."
    nulla "I want you all to myself."

# game/rutas/labelsact2.rpy:1234
translate ingles explorar_nulla_act3_3ac3a73c:

    # nulla "Quiero ser tuyo."
    nulla "I want to be yours."

# game/rutas/labelsact2.rpy:1235
translate ingles explorar_nulla_act3_5ea297d9:

    # "Los apéndices se contraen más en tu cuerpo, como si intentaran perforar la piel y escurrirse dentro de tu carne. Contaminar todo tu sistema con ese negro antinatural que rodea a Nulla."
    "The tendrils tighten further around your body, as though trying to pierce your skin and seep into your flesh; to contaminate your entire system with that unnatural blackness surrounding Nulla."

# game/rutas/labelsact2.rpy:1237
translate ingles explorar_nulla_act3_5d7e0601:

    # nulla "Podría engullir a la marioneta y mandar todo a la mierda."
    nulla "I could swallow the puppet whole and say 'fuck it all.'"

# game/rutas/labelsact2.rpy:1238
translate ingles explorar_nulla_act3_dfbc3987:

    # "Eso es todo lo que falta para que Nulla decida por fin moverse y tirarse hacia ti. Ambas manos toman tus mejillas para facilitar un feroz beso."
    "That's all it takes for Nulla to finally move and throw himself at you. He cups your cheeks with both hands, pulling you into a fierce kiss."

# game/rutas/labelsact2.rpy:1239
translate ingles explorar_nulla_act3_0745b9f2:

    # "No te deja respirar, es demandante e intenso, desesperado por un contacto que dificilmente puede llamarse tierno."
    "He doesn't let you breathe. He's demanding and intense, desperate for a kind of contact that could hardly be described as tender."

# game/rutas/labelsact2.rpy:1240
translate ingles explorar_nulla_act3_409f8636_2:

    # nulla "..."
    nulla "..."

# game/rutas/labelsact2.rpy:1241
translate ingles explorar_nulla_act3_1116b86d:

    # "Cuando finalmente Nulla decide separar su boca de la tuya, encuentra refugio en tu cuello. Respira hondo, intentando calmarse."
    "When Nulla finally decides to pull his mouth away from yours, he finds refuge against your neck and takes a deep breath, trying to calm himself."

# game/rutas/labelsact2.rpy:1242
translate ingles explorar_nulla_act3_ffefae5c:

    # nulla "Gracias---"
    nulla "Thank you--"

# game/rutas/labelsact2.rpy:1243
translate ingles explorar_nulla_act3_960a0c01:

    # nulla "No sabes lo feliz que me hace ver que has editado parte del juego por mí."
    nulla "You have no idea how happy it makes me to see that you've edited part of the game for me."

# game/rutas/labelsact2.rpy:1247
translate ingles explorar_nulla_act3_a20cefa7_4:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:1248
translate ingles explorar_nulla_act3_5efd5e4d:

    # "La presión llega a doler, pero te aguantas."
    "The pressure becomes painful, but you endure it."

# game/rutas/labelsact2.rpy:1249
translate ingles explorar_nulla_act3_d1ddaffa:

    # "........"
    "........"

# game/rutas/labelsact2.rpy:1250
translate ingles explorar_nulla_act3_401414d1:

    # "Duele."
    "It hurts."

# game/rutas/labelsact2.rpy:1255
translate ingles explorar_nulla_act3_94e3cd57:

    # "Nulla mira abajo, notando cómo sus sombras aún siguen estrujando tus extremidades, peligrando con cortar la circulación de estas mismas."
    "Nulla looks down, noticing that his shadows are still squeezing your limbs, threatening to cut off their circulation."

# game/rutas/labelsact2.rpy:1256
translate ingles explorar_nulla_act3_06fb3ab6:

    # nulla "¡Oh!"
    nulla "Oh!"

# game/rutas/labelsact2.rpy:1257
translate ingles explorar_nulla_act3_cbba5b82:

    # nulla "Lo siento."
    nulla "I'm sorry."

# game/rutas/labelsact2.rpy:1258
translate ingles explorar_nulla_act3_fa7d3198:

    # nulla "Me emocioné de más. Ja ja ja."
    nulla "I got a little carried away. Ja ja ja."

# game/rutas/labelsact2.rpy:1265
translate ingles explorar_nulla_act3_c0622113:

    # "Van afuera. Todo lo que recubre el supuesto jardín de su casa es una negrura que se extiende por todo tu campo de visión. No tienes idea de cuanto sea la magnitud de extensión del vacío, y eso te causa mucha curiosidad."
    "You head outside. All that surrounds the supposed garden of his house is a blackness stretching across your entire field of vision. You have no idea how far the void extends, and that makes you terribly curious."

# game/rutas/labelsact2.rpy:1266
translate ingles explorar_nulla_act3_9e89c3e5:

    # "Nulla se sienta en los escalones y espera en silencio."
    "Nulla sits on the steps and waits in silence."

# game/rutas/labelsact2.rpy:1271
translate ingles explorar_nulla_act3_09950f6c:

    # "Optas por quedarte de pie. Al final, sigues estando a su lado, y verlo desde arriba no está tan mal."
    "You choose to remain standing. After all, you're still by his side, and looking down at him isn't so bad."

# game/rutas/labelsact2.rpy:1272
translate ingles explorar_nulla_act3_020b23be:

    # "Se ve tierno. Pequeño."
    "He looks adorable. Small."

# game/rutas/labelsact2.rpy:1277
translate ingles explorar_nulla_act3_a2c6ae4c:

    # nulla "Si no te tuviera a mi lado ahora."
    nulla "If I didn't have you by my side right now."

# game/rutas/labelsact2.rpy:1278
translate ingles explorar_nulla_act3_807842a9:

    # nulla "Si no te hubiera conocido---"
    nulla "If I'd never met you--"

# game/rutas/labelsact2.rpy:1279
translate ingles explorar_nulla_act3_bbdfd5e6:

    # nulla "Seguiría sentado aquí, mirando el vacío."
    nulla "I'd still be sitting here, staring into the void."

# game/rutas/labelsact2.rpy:1280
translate ingles explorar_nulla_act3_c5060449:

    # "Sus ojos yacen pegados al horizonte, enfocado en algo que no comprendes del todo aún."
    "His eyes remain fixed on the horizon, focused on something you still don't quite understand."

# game/rutas/labelsact2.rpy:1285
translate ingles explorar_nulla_act3_079e2856:

    # nulla "¿Conoces la ciudad de Valparaíso?"
    nulla "Do you know the city of Valparaíso?"

# game/rutas/labelsact2.rpy:1291
translate ingles explorar_nulla_act3_38d1d143:

    # nulla "Ja, supongo que no es muy conocido."
    nulla "Ja, I suppose it's not very well-known."

# game/rutas/labelsact2.rpy:1296
translate ingles explorar_nulla_act3_76c1bb44:

    # nulla "Viví ahí."
    nulla "I lived there."

# game/rutas/labelsact2.rpy:1297
translate ingles explorar_nulla_act3_fc4cd82b:

    # nulla "Hay veces en que me gustaría estar ahí por mí mismo."
    nulla "Sometimes I wish I could be there myself."

# game/rutas/labelsact2.rpy:1298
translate ingles explorar_nulla_act3_e7bd9d2b:

    # nulla "Oler y escuchar el mar. Caminar por esas calles empinadas. No sé, experimentar realmente la ciudad."
    nulla "Smell and hear the sea. Walk through those steep streets... I don't know, actually experience the city."

# game/rutas/labelsact2.rpy:1299
translate ingles explorar_nulla_act3_feaf0db8:

    # nulla "A mi yo del pasado no le gustaba tanto."
    nulla "My past self didn't like it that much."

# game/rutas/labelsact2.rpy:1304
translate ingles explorar_nulla_act3_409f8636_3:

    # nulla "..."
    nulla "..."

# game/rutas/labelsact2.rpy:1305
translate ingles explorar_nulla_act3_c6d06276:

    # "Medita por un momento antes de suspirar decepcionado."
    "He reflects for a moment before sighing in disappointment."

# game/rutas/labelsact2.rpy:1310
translate ingles explorar_nulla_act3_a41a28ed:

    # nulla "Supongo que es cuestión de gustos y uno sueña con lo que no puede tener."
    nulla "I suppose it's a matter of taste, and we dream of what we can't have."

# game/rutas/labelsact2.rpy:1311
translate ingles explorar_nulla_act3_df8a019b:

    # "Nulla te comenta de memorias maltrechas por el tiempo, hay lagunas en sus historias, las cuales no puede rememorar."
    "Nulla tells you about memories worn away by time. There are gaps in his stories, things he can no longer recall."

# game/rutas/labelsact2.rpy:1312
translate ingles explorar_nulla_act3_7c44e213:

    # "Termina por evitar contar más memorias, frustrado con la dificultad de traer recuerdos no vividos."
    "Eventually, he stops sharing his memories, frustrated by how difficult it is to remember things he never experienced himself."

# game/rutas/labelsact2.rpy:1321
translate ingles explorar_nulla_act3_552f687f:

    # nulla "Cualquier cosa que me deje estar mirando tus ojos."
    nulla "Anything that lets me keep looking into your eyes."

# game/rutas/labelsact2.rpy:1322
translate ingles explorar_nulla_act3_797d721f:

    # "Le ofreces platicar y él acepta."
    "You offer to chat, and he accepts."

# game/rutas/labelsact2.rpy:1323
translate ingles explorar_nulla_act3_72896fe2:

    # "Pasan un buen rato hablando de pequeñeces y temas que sirven para matar el tiempo. Aun así, no es tiempo perdido, pues Nulla se asegura de no perder tu atención."
    "You spend quite a while talking about little things and whatever comes to mind to pass the time. Even so, it's not time wasted, as Nulla makes sure to keep your attention."

# game/rutas/labelsact2.rpy:1327
translate ingles explorar_nulla_act3_5f9b772e:

    # "...."
    "...."

# game/rutas/labelsact2.rpy:1334
translate ingles septemgana_n_act3_588777c5:

    # "Vas directo a donde se encuentra la vela, no lo dudas mucho. Sabes qué significa esa vela, ya has visto lo que puede hacer cuando estuviste con Septem en su momento..."
    "You head straight for the candle without much hesitation. You know what that candle means. You've already seen what it can do back when you were with Septem..."

# game/rutas/labelsact2.rpy:1335
translate ingles septemgana_n_act3_c59323f9:

    # "Esto es traición, lo sabes."
    "This is betrayal, and you know it."

# game/rutas/labelsact2.rpy:1336
translate ingles septemgana_n_act3_261d3599:

    # "Y sabes que Nulla sabe."
    "And you know Nulla knows."

# game/rutas/labelsact2.rpy:1337
translate ingles septemgana_n_act3_aa1c761e:

    # centered "{glitch=30.0}{color=ffffff}{size=*4.0}¡[nombrejugador]!{/size}{/color}"
    centered "{glitch=30.0}{color=ffffff}{size=*4.0}[nombrejugador]!{/size}{/color}"

# game/rutas/labelsact2.rpy:1338
translate ingles septemgana_n_act3_f982b127:

    # "Ignoras sus gritos."
    "You ignore his screams."

# game/rutas/labelsact2.rpy:1339
translate ingles septemgana_n_act3_458539a9:

    # "Ignoras sus comandos. Tanto piernas como brazos buscan tomar el control de sus deseos; evitar que no llegues, que no la toques. Pero eso no lo vas a permitir."
    "You ignore his commands. Both your arms and legs try to obey his wishes, preventing you from reaching the candle, from touching it. But you won't allow that."

# game/rutas/labelsact2.rpy:1342
translate ingles septemgana_n_act3_0b03776d:

    # "Septem no lo permite."
    "Septem won't allow it."

# game/rutas/labelsact2.rpy:1346
translate ingles septemgana_n_act3_5c0ef35f:

    # septem "Te lo dije."
    septem "I told you."

# game/rutas/labelsact2.rpy:1347
translate ingles septemgana_n_act3_00d0216f:

    # septem "Haré que te quedes conmigo el final."
    septem "I'll make sure you stay with me in the end."

# game/rutas/labelsact2.rpy:1350
translate ingles septemgana_n_act3_cf356954:

    # "Teniendo más libertad en tus movimientos gracias a la intervención de Septem, corres hacia la vela. Rompes el cristal que la protege, no importa cuanto tus manos sangren, tu objetivo es tomar la vela."
    "With greater freedom of movement thanks to Septem's intervention, you run toward the candle. You break the glass protecting it. It doesn't matter how much your hands bleed, your goal is to take the candle."

# game/rutas/labelsact2.rpy:1351
translate ingles septemgana_n_act3_5a88016e:

    # "Cuando por fin la tienes entre tus dedos, la cera se filtra por tus heridas, creando carne divina desde el ardiente dolor."
    "When you finally hold it between your fingers, the wax seeps into your wounds, creating divine flesh through burning pain."

# game/rutas/labelsact2.rpy:1353
translate ingles septemgana_n_act3_cac6a78c:

    # "Espirales blanquecinos toman posesión de tu cuerpo, volviendo todo estímulo confuso. Ya no ves, no sientes y a penas escuchas. Escuchas sus gritos pero no puedes hacer nada."
    "Whitish spirals take hold of your body, making every sensation confusing. You can no longer see or feel, and you can barely hear. There's nothing you can do about his screams."

# game/rutas/labelsact2.rpy:1354
translate ingles septemgana_n_act3_0cc67d49:

    # "Pronto, los gritos de Nulla se mezclan con el ruido blanco del lugar en que te encuentras. Él maldice, llora y grita por ti."
    "Soon, Nulla's cries blend with the white noise of the place you're in. He curses, weeps, and calls out for you."

# game/rutas/labelsact2.rpy:1356
translate ingles septemgana_n_act3_c203bf9d:

    # "Te pide que vuelvas, pero tú ya no te encuentras en ese lugar."
    "He begs you to come back, but you're no longer in that place."

# game/rutas/labelsact2.rpy:1357
translate ingles septemgana_n_act3_3803780f:

    # "Hasta que no lo escuchas más."
    "Until you can no longer hear him."

# game/rutas/labelsact2.rpy:1358
translate ingles septemgana_n_act3_a20cefa7:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:1359
translate ingles septemgana_n_act3_a604ebc5:

    # "Tienes la sensación de que tu mano es apretada por otra de mayor tamaño. Al mirar, te das cuenta de que no tienes un cuerpo como tal."
    "You feel as though your hand is being squeezed by a larger one. When you look, you realize you no longer have a body as such."

# game/rutas/labelsact2.rpy:1360
translate ingles septemgana_n_act3_35d889b2:

    # "Eres algo más. Eres un todo, intangible y hermoso."
    "You're something more: Whole, intangible, and beautiful."

# game/rutas/labelsact2.rpy:1361
translate ingles septemgana_n_act3_014d4c32:

    # septem "Por fin te tengo."
    septem "I finally have you."

# game/rutas/labelsact2.rpy:1362
translate ingles septemgana_n_act3_ea812564:

    # septem "No fue fácil llegar a ti."
    septem "It wasn't easy to reach you."

# game/rutas/labelsact2.rpy:1363
translate ingles septemgana_n_act3_0456a1c8:

    # "Sientes la presencia de Septem a tu lado... dentro y sobre de ti. Su alma rodea la tuya, la abraza y mece mientras te lleva por un flujo de energía que aún no puedes comprender."
    "You feel Septem's presence beside you... inside and above you. His soul surrounds yours, embracing and cradling it as he carries you through a flow of energy you still can't comprehend."

# game/rutas/labelsact2.rpy:1364
translate ingles septemgana_n_act3_99ad0fe3:

    # "El calor que transmite te calma. El alma de Septem tiene un efecto embriagador, evitando que pienses en demasiadas cosas a la vez, eliminando todo dato o persona que te ha hecho algún mal."
    "The warmth he radiates calms you. Septem's soul has an intoxicating effect, keeping you from thinking about too many things at once; erasing every memory or person that has ever caused you harm."

# game/rutas/labelsact2.rpy:1365
translate ingles septemgana_n_act3_af05cdff:

    # "Y junto a ello, borrando al dueño del vacío de tu alma proyectada en este plano."
    "And along with it, erasing the owner of the void from your soul projected onto this plane."

# game/rutas/labelsact2.rpy:1366
translate ingles septemgana_n_act3_f5e91222:

    # "Septem ríe."
    "Septem laughs."

# game/rutas/labelsact2.rpy:1367
translate ingles septemgana_n_act3_edf78f59:

    # septem "Podríamos quedarnos así."
    septem "We could stay like this."

# game/rutas/labelsact2.rpy:1368
translate ingles septemgana_n_act3_0576c613:

    # septem "Hasta que decidas volver conmigo por tu cuenta."
    septem "Until you decide to come back to me of your own free will."

# game/rutas/labelsact2.rpy:1369
translate ingles septemgana_n_act3_5914044b:

    # septem "Mientras... nos quedaremos aquí."
    septem "In the meantime... we'll remain here."

# game/rutas/labelsact2.rpy:1372
translate ingles septemgana_n_act3_049b0a35:

    # centered "{sc=3}{b}BAD END: Reminiscencias.{/b}{/sc}"
    centered "{sc=3}{b}BAD END: Reminiscences.{/b}{/sc}"

# game/rutas/labelsact2.rpy:1379
translate ingles septemgana2_n_act3_352e921b:

    # "Septem aprovecha de esos segundos de desconcierto. Una de sus manos consigue liberarse del agarre de Nulla y alcanza el cuchillo que está entre tus manos."
    "Septem takes advantage of those few seconds of confusion. He manages to free one of his hands from Nulla's grip and reaches for the knife you're holding."

# game/rutas/labelsact2.rpy:1381
translate ingles septemgana2_n_act3_cbfdb97e:

    # "Antes de que puedas reaccionar, o siquiera pestañear, sus dedos se cierran alrededor del mango. Forcejea contigo, tirando del arma con una fuerza descomunal."
    "Before you can react, or even blink, his fingers close around the handle. He struggles against you, pulling at the weapon with tremendous strength."

# game/rutas/labelsact2.rpy:1382
translate ingles septemgana2_n_act3_12e19274:

    # "De la nada, un destello de luz te deja ciego y confundido. Justo el tiempo suficiente para que Septem te arrebate el cuchillo de las manos."
    "Out of nowhere, a flash of light leaves you blinded and disoriented. Just long enough for Septem to snatch the knife from your hands."

# game/rutas/labelsact2.rpy:1390
translate ingles septemgana2_n_act3_8921bc6d:

    # "Septem te clava el cuchillo sin piedad en el pecho."
    "Septem mercilessly plunges the knife into your chest."

# game/rutas/labelsact2.rpy:1391
translate ingles septemgana2_n_act3_df984731:

    # "Hundiendo la hoja en tu carne, haciéndose paso entre tus costillas."
    "Driving the blade deep into your flesh, forcing its way between your ribs."

# game/rutas/labelsact2.rpy:1392
translate ingles septemgana2_n_act3_ee674bc9:

    # "Una vez."
    "Once."

# game/rutas/labelsact2.rpy:1393
translate ingles septemgana2_n_act3_0b920c5c:

    # "Otra."
    "Again."

# game/rutas/labelsact2.rpy:1394
translate ingles septemgana2_n_act3_6b9488e1:

    # "Y otra más."
    "And again."

# game/rutas/labelsact2.rpy:1395
translate ingles septemgana2_n_act3_d69ffd8f:

    # "No se detiene. Cada puñalada viene con rabia. Odio."
    "He doesn't stop. Every stab is filled with rage. Hatred."

# game/rutas/labelsact2.rpy:1396
translate ingles septemgana2_n_act3_e774433b:

    # "Perece disbrutar de ver como el rojo tiñe su mano y tu pecho."
    "He seems to enjoy watching the red stain his hand and your chest."

# game/rutas/labelsact2.rpy:1398
translate ingles septemgana2_n_act3_81183d59:

    # centered "{sc=3}{b}BAD END: Muy lento~{/b}{/sc}"
    centered "{sc=3}{b}BAD END: Too slow~{/b}{/sc}"

# game/rutas/labelsact2.rpy:1402
translate ingles septemgana2_n_act3_cba45555:

    # "Algo parece poseer a Septem. Agarra a Nulla de la cara, buscando con sus dedos sus ojos... intenta clavarlos ahí."
    "Something seems to possess Septem. He grabs Nulla by the face, his fingers searching for his eyes... trying to dig into them."

# game/rutas/labelsact2.rpy:1403
translate ingles septemgana2_n_act3_49d8af6e:

    # "Las sombras de Nulla se precipitan a retener al rubio, sin embargo, es inútil... Algo impide que puedan tocarlo. Una fuerza invisible protege a Septem."
    "Nulla's shadows rush to restrain the blond man, but it's useless... something prevents them from touching him. An invisible force protects Septem."

# game/rutas/labelsact2.rpy:1406
translate ingles septemgana2_n_act3_d5d233a3:

    # "Un crujido recorre el piso."
    "A cracking sound runs across the floor."

# game/rutas/labelsact2.rpy:1407
translate ingles septemgana2_n_act3_e4875227:

    # "Bajo de los pies de ambos, el suelo se resquebraja, formando grietas profundas y muy brillantes."
    "Beneath their feet, the ground fractures, forming deep, brilliantly glowing cracks."

# game/rutas/labelsact2.rpy:1408
translate ingles septemgana2_n_act3_457d0d9d:

    # "De ellas nacen apéndices pálidos que reptan rápidamente por el suelo en dirección a Nulla."
    "Pale appendages emerge from them, rapidly crawling toward Nulla."

# game/rutas/labelsact2.rpy:1409
translate ingles septemgana2_n_act3_6cad9ac1:

    # "Él a penas tiene tiempo de reaccionar, tomándolo por sorpresa cuando esas masas de luz toman captura de sus extremidades. Suspendiéndolo en el aire."
    "He barely has time to react, caught off guard as those masses of light seize his limbs, suspending him in midair."

# game/rutas/labelsact2.rpy:1410
translate ingles septemgana2_n_act3_0aaf5ac5:

    # "Septem se incorpora lentamente, tranquillo, ya sabiendo que Nulla está a su merced."
    "Septem slowly gets to his feet, calm and already knowing that Nulla is at his mercy."

# game/rutas/labelsact2.rpy:1411
translate ingles septemgana2_n_act3_e7428634:

    # "Escupe un poco de sangre al suelo, mira con atención como el liquido se esparce por el piso, intrigado."
    "He spits a little blood onto the floor, watching intently as the liquid spreads across it, intrigued."

# game/rutas/labelsact2.rpy:1412
translate ingles septemgana2_n_act3_d30d2fa2:

    # "Luego, con fastidio busca a Nulla con la mirada."
    "Then, with annoyance, he looks around for Nulla."

# game/rutas/labelsact2.rpy:1413
translate ingles septemgana2_n_act3_7199e454:

    # "Los apéndices se convierten en garras que tiran de las manos y piernas de Nulla. Rompiendo su cuerpo de manera lenta y tortuosa. Septem no le presta atención, en cambio, decide acercarse a ti, bloqueando tu vista con su cuerpo."
    "The appendages turn into claws that pull at Nulla's hands and legs. Slowly and torturously tearing his body apart. Septem pays him no attention, choosing instead to approach you, blocking your view with his body."

# game/rutas/labelsact2.rpy:1415
translate ingles septemgana2_n_act3_21aaed68:

    # septem "Con que aquí te vas cuando no estás conmigo."
    septem "So this is where you go when you're not with me."

# game/rutas/labelsact2.rpy:1416
translate ingles septemgana2_n_act3_bd6b90bc:

    # septem "Eres morboso."
    septem "You're morbid."

# game/rutas/labelsact2.rpy:1417
translate ingles septemgana2_n_act3_348c7378:

    # "Escuchas los quejidos de Nulla, quien te llama... su voz, que habitualmente va cargada con seguridad, se ve reducida a solo un grito roto."
    "You hear Nulla's cries as he calls out to you... his voice, usually filled with confidence, reduced to nothing more than a broken scream."

# game/rutas/labelsact2.rpy:1418
translate ingles septemgana2_n_act3_532c97dd:

    # "Entre sus quejidos, detectas otro sonido, uno humedo y espantoso."
    "Amid his sobs, you make out another sound, something wet and horrifying."

# game/rutas/labelsact2.rpy:1419
translate ingles septemgana2_n_act3_aaa403be:

    # "Luego de eso, los quejidos cesan."
    "After that, the cries cease."

# game/rutas/labelsact2.rpy:1420
translate ingles septemgana2_n_act3_b04ec6fe:

    # septem "Eso lo mantendrá callado por un tiempo."
    septem "That should keep him quiet for a while."

# game/rutas/labelsact2.rpy:1421
translate ingles septemgana2_n_act3_a1540d72:

    # "Septem no se molesta confirmar que es lo que ha pasado con Nulla."
    "Septem doesn't bother checking what happened to Nulla."

# game/rutas/labelsact2.rpy:1422
translate ingles septemgana2_n_act3_4f10c5ba:

    # septem "Ahora---"
    septem "Now--"

# game/rutas/labelsact2.rpy:1423
translate ingles septemgana2_n_act3_0897e3bf:

    # septem "Has sido tan bueno--- dejándome ver esta línea temporal."
    septem "You've been so good... letting me see this timeline."

# game/rutas/labelsact2.rpy:1424
translate ingles septemgana2_n_act3_126ec5c5:

    # septem "Eligiéndome a mí al final. Después de todo el trabajo que has hecho."
    septem "Choosing me in the end after all the work you've done."

# game/rutas/labelsact2.rpy:1426
translate ingles septemgana2_n_act3_5ee45a3d:

    # septem "Pero no te voy a perdonar el desastre que has causado al Jardín."
    septem "But I can't just forgive you for the destruction you've caused to the Garden."

# game/rutas/labelsact2.rpy:1427
translate ingles septemgana2_n_act3_5cdca032:

    # septem "Estarás a mi merced hasta que decida que puedes tener más libertades."
    septem "You'll be at my mercy until I decide you can have more freedom."

# game/rutas/labelsact2.rpy:1429
translate ingles septemgana2_n_act3_d6f9eab1:

    # "Septem te observa durante un largo tiempo. Al estar satisfecho con tu reacción, una pequeña sonrisa aparece en sus labios."
    "Septem watches you for a long time. Satisfied with your reaction, a faint smile appears on his lips."

# game/rutas/labelsact2.rpy:1430
translate ingles septemgana2_n_act3_0085d712:

    # septem "Voy a tomarme mi tiempo para domesticarte."
    septem "I'm going to take my time taming you."

# game/rutas/labelsact2.rpy:1431
translate ingles septemgana2_n_act3_9bec7340:

    # septem "No me molesta."
    septem "I don't mind."

# game/rutas/labelsact2.rpy:1432
translate ingles septemgana2_n_act3_f6f1137b:

    # septem "Ni en lo más mínimo."
    septem "Not in the slightest."

# game/rutas/labelsact2.rpy:1434
translate ingles septemgana2_n_act3_3d127a6b:

    # centered "{sc=3}{b}BAD END: Si tuvieras que elegir{/b}{/sc}"
    centered "{sc=3}{b}BAD END: If You Had to Choose{/b}{/sc}"

# game/rutas/labelsact2.rpy:1448
