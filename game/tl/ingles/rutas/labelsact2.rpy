    # septem "Ahora. Veamos que si has prestado atención realmente."
    septem "Now. Let's see if you've really been paying attention."

# game/rutas/labelsact2.rpy:997
translate ingles act3_explorar_septem_59566240:

    # "Septem suelta una risa jugetona justo detrás de tu oreja."
    "Septem lets out a playful chuckle right behind your ear."

# game/rutas/labelsact2.rpy:1467
translate ingles claseslatin_89457f5f:

    # septem "Tú puedes hacerlo..."
    septem "You can do it..."

# game/rutas/labelsact2.rpy:1468
translate ingles claseslatin_b1d4b50a:

    # septem "Pide algo que te involucre a ti."
    septem "Ask for something that involves yourself."

# game/rutas/labelsact2.rpy:1472
translate ingles claseslatin_95015146:

    # "Septem se ríe de tu pronunciación, bajito e intenta aguantarse un poco... no es una risa mal intencionada."
    "Septem laughs softly at your pronunciation, trying to hold it back a little... it's not a mean-spirited laugh."

# game/rutas/labelsact2.rpy:1473
translate ingles claseslatin_df7ec066:

    # septem "No, no, [nombrejugador]."
    septem "No, no, [nombrejugador]."

# game/rutas/labelsact2.rpy:1474
