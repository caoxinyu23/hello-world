translate ingles menupreguntas_septem2_d550ab1d:

    # "Septem te mira con los ojos entrecerrados."
    "Septem looks at you with narrowed eyes."

# game/rutas/labelsact2.rpy:109
translate ingles menupreguntas_septem2_a1b648c3:

    # septem "¿Yo?"
    septem "Me?"

# game/rutas/labelsact2.rpy:110
translate ingles menupreguntas_septem2_e87c5670_1:

    # septem "No."
    septem "No."

# game/rutas/labelsact2.rpy:111
translate ingles menupreguntas_septem2_ca197155:

    # septem "Es culpa de este cuerpo mortal..."
    septem "It's this mortal body's fault..."

# game/rutas/labelsact2.rpy:112
translate ingles menupreguntas_septem2_62cf90f8:

    # septem "Creeme, mi intención no es romperlo, pero estamos contra el tiempo."
    septem "Believe me, my intention is not to break it, but we are against time."

# game/rutas/labelsact2.rpy:113
translate ingles menupreguntas_septem2_cf2fc140:

    # septem "...Cuando encuentre la solución. Lo dejaré descansar el tiempo que desee."
    septem "... When I find the solution. I'll let it rest for as long as it wants."

# game/rutas/labelsact2.rpy:117
translate ingles menupreguntas_septem2_33b6bf63:

    # "Le cuentas lo que pasó cuando dormías."
    "You tell him what happened while you were asleep."

# game/rutas/labelsact2.rpy:119
translate ingles menupreguntas_septem2_fb26730a:

    # "Septem te escucha sin interrumpir ni opinar. Mientras más explicas, la cara de Septem va tomando un aire de tristeza."
    "Septem listens to you without interrupting or giving an opinion. While you explain more, Septem's face takes on an air of sadness."

# game/rutas/labelsact2.rpy:120
translate ingles menupreguntas_septem2_30db2a44:

    # "Aunque en cierto punto de tu explicación, Septem levanta la mano."
    "Although at one point during your explanation, Septem lifts his hand."

# game/rutas/labelsact2.rpy:121
translate ingles menupreguntas_septem2_041f9d30:

    # "Pidiendo silenciosamente que te detengas."
    "Silently asking you to stop."

# game/rutas/labelsact2.rpy:123
translate ingles menupreguntas_septem2_0bd7293a:

    # septem "Hablaremos de eso luego."
    septem "We'll talk about this later."

# game/rutas/labelsact2.rpy:124
translate ingles menupreguntas_septem2_7a294f58:

    # septem "Tengo otras cosas que solucionar antes."
    septem "I have other things to solve first."

# game/rutas/labelsact2.rpy:125
translate ingles menupreguntas_septem2_8a63a43c:

    # septem "Cuando encuentre una manera de unirnos sin poner en peligro tu experiencia o la mía, solucionaremos el problema que tiene Madre."
    septem "When I find a way for us to join without endangering your experience or mine, we'll solve Mother's problem."

# game/rutas/labelsact2.rpy:126
translate ingles menupreguntas_septem2_f16c461c:

