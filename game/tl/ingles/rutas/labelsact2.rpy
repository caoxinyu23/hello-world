    # septem "Recuerda...... {sc=3}{b}ego faciam{/sc}{b}"
    septem "Remember...... {sc=3}{b}ego faciam{/sc}.{b}"

# game/rutas/labelsact2.rpy:1481
translate ingles claseslatin_63bc4ce3:

    # septem "Tienes que soltar un poco más tu lengua."
    septem "You need to loosen your tongue a little more."

# game/rutas/labelsact2.rpy:1482
translate ingles claseslatin_e8baceb3:

    # septem "Y prestar más atención a lo que digo."
    septem "And pay closer attention to what I say."

