    # septem "Tierno..."
    septem "Adorable..."

# game/rutas/labelsact2.rpy:1491
translate ingles claseslatin_218bc981:

    # septem "Pero no es exactamente lo que buscamos."
    septem "But that's not exactly what we're looking for."

# game/rutas/labelsact2.rpy:1492
translate ingles claseslatin_e3d96940:

    # "Sus dedos te acarician el cuello, apretando un poquito más tu tráquea, siempre teniendo cuidado de no apretar de más y dañarte la zona."
    "His fingers caress your neck, pressing a little more firmly against your trachea, always careful not to squeeze too hard and hurt you."

# game/rutas/labelsact2.rpy:1501
translate ingles claseslatin2_a54f1628:

    # "Cuando por fin lo logras, Septem te felicita, enfatizando lo perfecto que ha salido."
    "When you finally get it right, Septem congratulates you, emphasizing just how perfectly you did it."

# game/rutas/labelsact2.rpy:1502
translate ingles claseslatin2_6e36546a:

    # "Septem es un buen maestro."
    "Septem is a good teacher."

# game/rutas/labelsact2.rpy:1506
