    # "una cosa más."
    "One more thing."

# game/rutas/labelsact2.rpy:137
translate ingles menupreguntas_septem2_a9f90d2e:

    # "Se le ve aflijido al escucharte."
    "He looks distressed as he listens to you."

# game/rutas/labelsact2.rpy:139
translate ingles menupreguntas_septem2_54d57a01:

    # "Se toma un tiempo antes de responder."
    "He takes a moment before answering."

# game/rutas/labelsact2.rpy:141
translate ingles menupreguntas_septem2_da22e196:

    # septem "{size=*0.6}... no sé como resultará.{/size}"
    septem "{size=*0.6}... I don't know how it will turn out.{/size}"

# game/rutas/labelsact2.rpy:142
translate ingles menupreguntas_septem2_c178b3f6:

    # "Septem habla tan despacio que te ha costado un poco entenderle. Antes de que puedas preguntarle, él se aclara la garganta para explicarse."
    "Septem speaks so slowly that it takes you a moment to understand him. Before you can ask him anything, he clears his throat in order to explain himself."

# game/rutas/labelsact2.rpy:144
translate ingles menupreguntas_septem2_380b1f44:

    # septem "Cuando te di uno de mis ojos, no resultó como yo esperaba."
    septem "When I gave you one of my eyes, it didn't turn out the way I expected."

# game/rutas/labelsact2.rpy:145
translate ingles menupreguntas_septem2_bceb7730:

    # septem "{b}Algo{b} dentro de esta cosa me prohibe enlasarme contigo."
    septem "{b}Something{b} inside this thing forbids me from merging with you."

# game/rutas/labelsact2.rpy:146
translate ingles menupreguntas_septem2_3dac244f:

    # septem "Además,te ha quitado la poca libertad que tienes para controlar a la marioneta."
    septem "Moreover, it has taken away the little freedom you had to control the puppet."

# game/rutas/labelsact2.rpy:147
translate ingles menupreguntas_septem2_bb050f58:

    # septem "Si hacemos la transfusión... no cumpliré con lo que te prometí y ambos seremos absorbidos por la marioneta si continuamos como estaba planeado..."
    septem "If we do the transfusion... I won't fulfill what I promised and we'll both be absorbed by the puppet if we continue as planned..."

# game/rutas/labelsact2.rpy:148
translate ingles menupreguntas_septem2_e048e386:

    # septem "Será un desastre."
    septem "It will be a disaster."

# game/rutas/labelsact2.rpy:149
