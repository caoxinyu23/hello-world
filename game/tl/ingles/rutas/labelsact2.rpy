    # "Septem guarda silencio por un largo rato. Y tú no sabes como rellenar ese silencio incómodo."
    "Septem remains silent for a long time. And you don't know how to fill that awkward silence."

# game/rutas/labelsact2.rpy:151
translate ingles menupreguntas_septem2_31fbc8fa:

    # septem "Retírate."
    septem "Leave."

# game/rutas/labelsact2.rpy:153
translate ingles menupreguntas_septem2_73d30947:

    # "Ni siquiera te da la oportunidad de tomar una decisión, pues te teletransporta a la pieza donde duermes."
    "He doesn't even give you the chance to make a decision, as he teleports you to the room where you sleep."

# game/rutas/labelsact2.rpy:158
translate ingles menupreguntas_septem2_a20cefa7:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:160
