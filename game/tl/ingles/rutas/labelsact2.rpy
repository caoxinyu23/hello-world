    # "....."
    "....."

# game/rutas/labelsact2.rpy:1450
translate ingles act3_s_badendnulla_d1ddaffa:

    # "........"
    "........"

# game/rutas/labelsact2.rpy:1451
translate ingles act3_s_badendnulla_f93a6c2f:

    # centered "Vamos mi vida, tóca el botón~"
    centered "Come on, mi vida, press the button~"

# game/rutas/labelsact2.rpy:1452
translate ingles act3_s_badendnulla_99fd4a43:

    # centered "Te esto esperando~"
    centered "I'm waiting for you~"

# game/rutas/labelsact2.rpy:1459
translate ingles act3_s_badendnulla_14cbeb85:

    # "Respirar se te hace cada vez más difícil."
    "Breathing becomes more and more difficult."

# game/rutas/labelsact2.rpy:1460
translate ingles act3_s_badendnulla_f0898928:

    # "Los tentáculos se fusionan contigo, tapando tus vias respiratorias. Buscan cercanía, buscan contacto, y lo toman con fuerza, sin cuidado."
    "The tentacles fuse with you, blocking your airways. They seek closeness, they seek contact, and they seize it forcefully, without care."

# game/rutas/labelsact2.rpy:1461
translate ingles act3_s_badendnulla_5858f125:

    # "Pronto, pierdes la consciencia."
    "Soon, you lose consciousness."

# game/rutas/labelsact2.rpy:1462
translate ingles act3_s_badendnulla_0b0f0ad2:

    # centered "{sc=3}{b}BAD END: Aún no estás listo.{/b}{/sc}"
