# game/rutas/labelsact2.rpy:51
translate ingles menupreguntas_septem2_867d649e:

    # "Una sutil sonrisa se posa en los labios de Septem, que te hace sentir un escalofrío recorrer tu cuerpo."
    "A subtle smile settles on Septem's lips, sending a shiver down your spine."

# game/rutas/labelsact2.rpy:57
translate ingles menupreguntas_septem2_cf974779:

    # "Estás seguro de que tus huesos cederán en cualquier momento si es que no logras zafarte de su agarre."
    "You're certain your bones will give in at any moment if you don't manage to break free from his grip."

# game/rutas/labelsact2.rpy:83
translate ingles menupreguntas_septem2_077fa6cb:

    # septem "Pero aun así, no hará nada para cambiarlo, con tal de complacerte."
    septem "But even so, it won't do anything to change it, as long as it pleases you."

# game/rutas/labelsact2.rpy:112
translate ingles menupreguntas_septem2_b06976b3:

    # septem "Créeme, mi intención no es romperlo, pero estamos contra el tiempo."
    septem "Believe me, my intention isn't to break it, but we're running out of time."

# game/rutas/labelsact2.rpy:137
translate ingles menupreguntas_septem2_2e1a756a:

    # "Se le ve afligido al escucharte."
    "He looks distressed upon hearing you."

# game/rutas/labelsact2.rpy:145
translate ingles menupreguntas_septem2_9edbb861:

    # septem "{b}Algo{b} dentro de esta cosa me prohíbe enlazarme contigo."
    septem "{b}Something{b} inside this thing forbids me from linking with you."

# game/rutas/labelsact2.rpy:160
translate ingles menupreguntas_septem2_d50870c1:

    # "Septem te mira frunciendo el ceño."
    "Septem looks at you, frowning."

# game/rutas/labelsact2.rpy:184
translate ingles badend_septem9_11c0d1e4:

    # "No vas a entrar... Quizás que cosas sucedan si lo haces."
    "You're not going to enter... Who knows what might happen if you do."

# game/rutas/labelsact2.rpy:192
translate ingles badend_septem9_ac179fc0:

    # septem "Tu desobediencia ya no es divertida."
    septem "Your disobedience is no longer amusing."

# game/rutas/labelsact2.rpy:195
translate ingles badend_septem9_90afd42b:

    # "Quitándote el aire de a poco, el sonríe."
    "Stealing your breath little by little, he smiles."

# game/rutas/labelsact2.rpy:221
translate ingles septem_badend_insistir_7f94ab28:

    # septem "Tú no entiendes..."
    septem "You don't understand..."

# game/rutas/labelsact2.rpy:222
translate ingles septem_badend_insistir_6f2f684f:

    # septem "¿O es que te lo estás buscando?"
    septem "Or are you asking for it?"

# game/rutas/labelsact2.rpy:223
translate ingles septem_badend_insistir_256e21ea:

    # septem "Veo que entiendes a la fuerza."
    septem "I see you only understand through force."

# game/rutas/labelsact2.rpy:226
translate ingles septem_badend_insistir_79f2962b:

    # "Septem toma una de tus manos, usando una fuerza que rompe y destroza tus huesos. Un dolor intenso explota en tu ser."
    "Septem takes one of your hands, using a force that shatters your bones. An intense pain bursts through your being."

# game/rutas/labelsact2.rpy:227
translate ingles septem_badend_insistir_33a72d9d:

    # "Es un dolor que no sabes bien como se origina, un dolor fantasma que se cuela en todo lo que puedes llamar tuyo."
    "It's a pain that's origin you can't quite grasp, a phantom pain that seeps into everything you can call your own."

# game/rutas/labelsact2.rpy:228
translate ingles septem_badend_insistir_ede79458:

    # "Y es un dolor compartido... uno dolor que Septem también siente."
    "And it's a shared pain... one that Septem feels as well."

# game/rutas/labelsact2.rpy:229
translate ingles septem_badend_insistir_a7329a88:

    # "Pero él está decidido a seguir."
    "But he's determined to continue."

# game/rutas/labelsact2.rpy:230
translate ingles septem_badend_insistir_a905a42f:

    # "Luego es tu ojo."
    "Then it's your eye."

# game/rutas/labelsact2.rpy:232
translate ingles septem_badend_insistir_a53b1ccc:

    # "El cual es cerrado de golpe."
    "Which is forced shut in an instant."

# game/rutas/labelsact2.rpy:233
translate ingles septem_badend_insistir_4965362e:

    # septem "Vuelve cuando separ respetar mi palabra."
    septem "Come back when you learn to respect my word."


# game/rutas/labelsact2.rpy:234
translate ingles septem_badend_insistir_5f05798d:

    # "No sabes bien lo que sucede luego."
    "You're not quite sure what happens next."

# game/rutas/labelsact2.rpy:235
translate ingles septem_badend_insistir_e1cc47f9:

    # "Pero tu conexión con Septem se corta."
    "But your connection with Septem is severed."

# game/rutas/labelsact2.rpy:241
translate ingles castigo_6affa467:

    # "Mirando con frialdad a la entidad, él chasquea los dedos."
    "Gazing coldly at the entity, he snaps his fingers."

# game/rutas/labelsact2.rpy:243
translate ingles castigo_e1ac6290:

    # "Un líquido negro comienza a salir de la boca de la entidad."
    "A liquid begins to pour from the entity's mouth."

# game/rutas/labelsact2.rpy:244
translate ingles castigo_434a6cfa:

    # "Y el corazón de Septem comienza a latir con una rapidez preocupante. Dándose cuenta de que: realmente ha lastimado a uno de los suyos por primera vez."
    "And Septem's heart begins to beat at a concerning pace. He realizes--perhaps for the first time--that he has truly harmed one of his own."

# game/rutas/labelsact2.rpy:245
translate ingles castigo_e1699edf:

    # "Pero el arrepentimiento no llega al instante."
    "But remorse does not come immediately."

# game/rutas/labelsact2.rpy:246
translate ingles castigo_7fe7e621:

    # "Todos dentro del lugar reaccionan con horror, incluso los Estandartes. Menos uno."
    "Everyone at the table reacts with horror, even the Symbols. Everyone except one."

# game/rutas/labelsact2.rpy:247
translate ingles castigo_826b11d4:

    # "Sextam en cambio aprieta los labios y se encoje bajando la mirada."
    "Sextam, on the other hand, presses her lips together and shrinks back, lowering her gaze."

# game/rutas/labelsact2.rpy:248
translate ingles castigo_58c4f070:

    # "Decepcionada."
    "Disappointed."

# game/rutas/labelsact2.rpy:249
translate ingles castigo_b4605a70:

    # septem "Ya han sido dos ofensas. A la próxima, no solo tu lengua será la que arrancaré."
    septem "There have already been two offenses. Next time, it won't be only your tongue that I tear out."

# game/rutas/labelsact2.rpy:250
translate ingles castigo_c7028178:

    # duae "¡Andrómeda!"
    duae "Andromeda!"

# game/rutas/labelsact2.rpy:251
translate ingles castigo_a4f38acd:

    # "El tono de Duae está entre una mezcla de miedo y reproche. Pero no se atreve a mover ni un músculo."
    "Duae's tone is a mix of fear and reproach. Yet she doesn't dare move a single muscle."

# game/rutas/labelsact2.rpy:252
translate ingles castigo_01310a53:

    # "Mientras Andrómeda coloca ambas manos sobre su boca y mandíbula, Unum se levanta de su lugar para recargar sus manos en la mesa y observar con una curiosidad morbida como la entidad, llamada Andrómeda, escupe lo que parece ser sangre."
    "While Andromeda clutches both hands over their mouth and jaw, Unum rises from his seat, leaning on the table to watch with morbid curiosity as the entity, Andromeda, spits out what appears to be blood."

# game/rutas/labelsact2.rpy:255
translate ingles castigo_ea86330e:

    # unum "¡Mierda, Septem! ¿¡Desde cuando puedes hacer eso?! HAHAHAHAHA INCREÍBLE."
    unum "Holy shit, Septem! Since when can you do that?! HAHAHAHAHA, AMAZING."

# game/rutas/labelsact2.rpy:256
translate ingles castigo_afdfc898:

    # "Sus ojos se abren, como si una idea que anteriormente haya sido imposible, de la noche a la mañana se haya hecho realidad."
    "His eyes widen, as though an idea once deemed impossible had, overnight, become reality."

# game/rutas/labelsact2.rpy:259
translate ingles castigo_5a04636e:

    # unum "¿Podemos combatir? Por favor, por favor. POR FAVOR."
    unum "Can we fight? Please, please. PLEASE."

# game/rutas/labelsact2.rpy:261
translate ingles castigo_4329167d:

    # septem "Unum siéntate. Ahora no quiero escuchar estupideces."
    septem "Unum, sit down. I don't want to hear any nonsense right now."

# game/rutas/labelsact2.rpy:263
translate ingles castigo_22adc0b7:

    # "El cuerpo de Unum cae reprentinamente sobre su asiento al mismo tiempo que Duae se levanta del suyo y agacha la cabeza."
    "Unum's body collapses abruptly back into his seat, just as Duae rises from hers and bows her head."

# game/rutas/labelsact2.rpy:264
translate ingles castigo_97bf799d:

    # duae "Su santidad Septem--"
    duae "Your Holiness Septem--"

# game/rutas/labelsact2.rpy:266
translate ingles castigo_763496bc:

    # "Septem levanta su mano, parando en seco el discurso de Duae."
    "Septem raises his hand, cutting Duae's speech short."

# game/rutas/labelsact2.rpy:267
translate ingles castigo_f3b1ef46:

    # septem "Basta Duae, no es tu culpa que tu consejero no sepa como expresar respeto..."
    septem "Enough, Duae. It's not your fault that your advisor doesn't know how to show respect..."

# game/rutas/labelsact2.rpy:268
translate ingles castigo_051c5e0d:

    # septem "Ahora, siéntense."
    septem "Now, sit down."

# game/rutas/labelsact2.rpy:279
translate ingles menuexplorar3_nulla_6d84bb94:

    # "Caminas al escritorio de la habitación. Al llegar allí, puedes observar como todos están ordenados, de manera casi complusiva."
    "You walk over to the desk in the room. Upon reaching it, you notice how everything is arranged with almost compulsive precision."

# game/rutas/labelsact2.rpy:280
translate ingles menuexplorar3_nulla_5292ca3f:

    # "Todas las hojas están perfectamente apiladas."
    "All the sheets are perfectly stacked."

# game/rutas/labelsact2.rpy:281
translate ingles menuexplorar3_nulla_372b3d21:

    # "Ojeas algunas, pero ninguna te llama la atención."
    "You skim through a few of them, but none catch your attention."

# game/rutas/labelsact2.rpy:282
translate ingles menuexplorar3_nulla_5dc1d9de:

    # "Hasta que encuentras una pila con hojas en blanco y un bolígrafo."
    "Until you come across a small stack of blank pages and a pen."

# game/rutas/labelsact2.rpy:283
translate ingles menuexplorar3_nulla_5f9b772e:

    # "...."
    "...."

# game/rutas/labelsact2.rpy:284
translate ingles menuexplorar3_nulla_45dcaf38:

    # "Dejar un mensaje para Nulla no estaría mal..."
    "Leaving a message for Nulla wouldn't be such a bad idea..."

# game/rutas/labelsact2.rpy:285
translate ingles menuexplorar3_nulla_6f296e62:

    # "¿No crees?"
    "Don't you think?"

# game/rutas/labelsact2.rpy:288
translate ingles menuexplorar3_nulla_a910efb8:

    # "Tomas el bolígrafo y mientras meditas lo que vas a escribir, dibujas garabatos en la esquina de la hoja."
    "You pick up the pen, and as you ponder what to write, you doodle aimlessly in the corner of the page."

# game/rutas/labelsact2.rpy:290
translate ingles menuexplorar3_nulla_ce373e8c:

    # "Miras tu mensaje por un momento y un pensamiento furtivo pasa por tu cabeza."
    "You stare at your message for a moment, and a fleeting thought crosses your mind."

# game/rutas/labelsact2.rpy:291
translate ingles menuexplorar3_nulla_1e341408:

    # "Realmente esperas que Nulla lo pueda leer algún día..."
    "You truly hope that Nulla will be able to read it someday..."

# game/rutas/labelsact2.rpy:294
translate ingles menuexplorar3_nulla_7072f3b4:

    # "No..."
    "No..."


# game/rutas/labelsact2.rpy:295
translate ingles menuexplorar3_nulla_fc356be7:

    # "No vale la pena."
    "It's not worth it."

# game/rutas/labelsact2.rpy:300
translate ingles menuexplorar3_nulla_bc3059ff:

    # "Vas nuevamente al escritorio. Esperando a que tu mensaje no haya sido borrado y olvidado por las mecanicas básicas del juego."
    "You go back to the desk, hoping your message hasn't been erased or forgotten by the basic mechanics of the game."

# game/rutas/labelsact2.rpy:301
translate ingles menuexplorar3_nulla_8f811b86:

    # "Encuentras tu hoja encima de todos los papeles, esperando a ser leída."
    "You find your sheet on top of all the papers, waiting to be read."

# game/rutas/labelsact2.rpy:302
translate ingles menuexplorar3_nulla_bf1c1bea:

    # "Así que, lees lo que escribiste la última vez:"
    "So, you read what you wrote last time:"

# game/rutas/labelsact2.rpy:303
translate ingles menuexplorar3_nulla_69661f23:

    # "[mensaje_guardado]"
    "[mensaje_guardado]"

# game/rutas/labelsact2.rpy:304
translate ingles menuexplorar3_nulla_8adf4389:

    # "Je..."
    "Heh..."

# game/rutas/labelsact2.rpy:310
translate ingles menuexplorar3_nulla_c9a4bbe3:

    # "Te paseas por toda la casa, recorriendo cada habitación en busca de algo que despierte tu curiosidad, algo que revele un poco más de él."
    "You wander through the house, going room by room in search of something that might spark your curiosity or reveal a little more about him."

# game/rutas/labelsact2.rpy:311
translate ingles menuexplorar3_nulla_d71dfe00:

    # "Pero pronto caes en la cuenta de que la casa de Nulla carece por completo de personalidad."
    "But soon you realize that Nulla's house lacks any trace of personality."

# game/rutas/labelsact2.rpy:312
translate ingles menuexplorar3_nulla_4506e2b9:

    # "No hay decoraciones, fotografías, ni objetos que cuenten cómo era su vida antes de tu llegada."
    "There are no decorations, no photographs, no objects that tell what his life was like before you arrived."

# game/rutas/labelsact2.rpy:313
translate ingles menuexplorar3_nulla_89b9e557:

    # "Tampoco hay libros, ni señales de pasatiempos que alguna vez haya disfrutado en tiempos mejores..."
    "There are no books either, nor any sign of hobbies he might have enjoyed in better times..."

# game/rutas/labelsact2.rpy:314
translate ingles menuexplorar3_nulla_b41371b0:

    # "Todo se siente vacío, sin alma. Artificial."
    "Everything feels empty, soulless. Artificial."

# game/rutas/labelsact2.rpy:315
translate ingles menuexplorar3_nulla_7b6814b6:

    # "Nulla tiene solo lo justo y necesario para existir."
    "Nulla only has what's strictly necessary to exist."

# game/rutas/labelsact2.rpy:316
translate ingles menuexplorar3_nulla_8c6c4c2d:

    # "Y, por alguna razón, eso te entristece un poco."
    "And, for some reason, that makes you a little sad."

# game/rutas/labelsact2.rpy:317
translate ingles menuexplorar3_nulla_a20cefa7:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:319
translate ingles menuexplorar3_nulla_36ba34e8:

    # "Caminas por la cocina..."
    "You walk through the kitchen..."

# game/rutas/labelsact2.rpy:321
translate ingles menuexplorar3_nulla_d8ee9178:

    # "Por la entrada de la casa."
    "Through the house's entrance."

# game/rutas/labelsact2.rpy:323
translate ingles menuexplorar3_nulla_c0f5863f:

    # "Y cerca de las escaleras."
    "And near the stairs."

# game/rutas/labelsact2.rpy:324
translate ingles menuexplorar3_nulla_6f1f0850:

    # "No hay nada que capte tu atención."
    "Nothing catches your attention."

# game/rutas/labelsact2.rpy:325
translate ingles menuexplorar3_nulla_5f9b772e_1:

    # "...."
    "...."

# game/rutas/labelsact2.rpy:326
translate ingles menuexplorar3_nulla_5f9b772e_2:

    # "...."
    "...."

# game/rutas/labelsact2.rpy:331
translate ingles menuexplorar3_nulla_401dd260:

    # "Afuera es frío y muy silencioso."
    "Outside, it's cold and eerily silent."

# game/rutas/labelsact2.rpy:332
translate ingles menuexplorar3_nulla_30d64e35:

    # "Como si hubiera helada ahora mismo y el lugar fuera solo una fotografía."
    "As if there were frost in the air and the whole place was just a photograph."

# game/rutas/labelsact2.rpy:333
translate ingles menuexplorar3_nulla_376a07d3:

    # "Nada se mueve y nada perturba el lugar."
    "Nothing moves, and nothing disturbs the place."

# game/rutas/labelsact2.rpy:334
translate ingles menuexplorar3_nulla_921bf221:

    # "Exepto tú."
    "Except for you."

# game/rutas/labelsact2.rpy:336
translate ingles menuexplorar3_nulla_2810788e:

    # "Decides volver dentro de la casa cuando ya no aguantas más el frío."
    "You decide to go back inside once you can't stand the cold any longer."

# game/rutas/labelsact2.rpy:341
translate ingles menuexplorar3_nulla_2c362246:

    # "Caminas por toda la casa en busca de Nulla, te cuesta admitirlo pero te sorprende lo difícil que es de encontrar."
    "You wander through the house looking for Nulla. You hate to admit it, but you're surprised by how hard he is to find."

# game/rutas/labelsact2.rpy:343
translate ingles menuexplorar3_nulla_8c455fb3:

    # "Y ahí está él."
    "And there he is."

# game/rutas/labelsact2.rpy:344
translate ingles menuexplorar3_nulla_6e4baa9e:

    # "Juras que ya pasaste por este lugar y él no estava ahí."
    "You swear you already passed by this spot, and he wasn't there."

# game/rutas/labelsact2.rpy:345
translate ingles menuexplorar3_nulla_2316fb50:

    # "Tal vez está jugándote una broma."
    "Maybe he's playing a prank on you."

# game/rutas/labelsact2.rpy:348
translate ingles menuexplorar3_nulla_aab5ec9f:

    # nulla "¿Me extrañaste?"
    nulla "Did you miss me?"

# game/rutas/labelsact2.rpy:349
translate ingles menuexplorar3_nulla_78f9233e:

    # "Pregunta él, muy campante."
    "He asks, casually."


# game/rutas/labelsact2.rpy:354
translate ingles menuexplorar3_nulla_b7e7a4ab:

    # nulla "Ouch."
    nulla "Ouch."

# game/rutas/labelsact2.rpy:359
translate ingles menuexplorar3_nulla_b978f204:

    # "Sonríe complacido."
    "He smiles, clearly pleased."

# game/rutas/labelsact2.rpy:363
translate ingles menuexplorar3_nulla_19f401da:

    # "Nulla te encamina a la cocina, enciende la tetera y busca un cuchillo junto con algunas frutas."
    "Nulla leads you to the kitchen, turns on the kettle, and grabs a knife along with some fruit."

# game/rutas/labelsact2.rpy:364
translate ingles menuexplorar3_nulla_18562cf8:

    # "Comienza a preparar fruta mientras tú lo observas. La habilidad que tiene con el cuchillo es admirable..."
    "He starts slicing fruit while you watch him. The skill he has with the knife is impressive..."

# game/rutas/labelsact2.rpy:373
translate ingles menuexplorar_unum_65f8125c:

    # "Buscas a los niños dentro de la residencia, pero solo encuentras remanentes de que estuvieron ahí. Una vasija rota más para la colección, uno de los cuadros rellados con lo que esperas sea pintura y así puedes seguir hasta mañana..."
    "You search for the children inside the residence, but only find traces that they were there. Another broken vase to add to the collection, one of the paintings scratched with what you hope is paint... You could go on and on like this until tomorrow..."

# game/rutas/labelsact2.rpy:374
translate ingles menuexplorar_unum_8a8f19b1:

    # "En cambio, a ellos no los hallas por ninguna parte."
    "But as for them, you can't find them anywhere."

# game/rutas/labelsact2.rpy:376
translate ingles menuexplorar_unum_3b24eb1d:

    # "Sales con la esperanza de encontrarlos en el patio."
    "You go outside, hoping to find them in the courtyard."

# game/rutas/labelsact2.rpy:377
translate ingles menuexplorar_unum_3fdd301f:

    # "Tampoco están ahí."
    "They aren't there either."

# game/rutas/labelsact2.rpy:378
translate ingles menuexplorar_unum_629bc3ca:

    # "Supones que deben estar en la residencia de las esposas de Unum."
    "You assume they must be in Unum's wives' residence."

# game/rutas/labelsact2.rpy:379
translate ingles menuexplorar_unum_f1ce1d25:

    # "... no sabes si será muy prudente ir allá."
    "... you're not sure if it would be wise to go there."

# game/rutas/labelsact2.rpy:383
translate ingles menuexplorar_unum_507c9835:

    # "Tus pasos son lentos. Temes que, si te apresuras, algo saldrá mal."
    "Your steps are slow. You're afraid that if you hurry, something will go wrong."

# game/rutas/labelsact2.rpy:384
translate ingles menuexplorar_unum_ed680ba5:

    # "No estás haciendo nada prohibido, al menos no de forma explícita; Unum nunca te ha dicho que no puedas venir aquí."
    "You're not doing anything forbidden, at least not explicitly; Unum has never told you that you can't come here."

# game/rutas/labelsact2.rpy:386
translate ingles menuexplorar_unum_24e3123b:

    # "Sin embargo, a medida que te acercas, cada paso te saca una gota de sudor que recorre tu nuca."
    "Still, as you get closer, each step draws a bead of sweat that slides down your neck."

# game/rutas/labelsact2.rpy:388
translate ingles menuexplorar_unum_45183be5:

    # "Finalmente, te detienes frente a una gran puerta cerrada, imponente, con grabados en la madera que hacen alegoría al sol."
    "Finally, you stop before a large closed door. It's imposing, with carvings in the wood depicting allegories of the sun."

# game/rutas/labelsact2.rpy:389
translate ingles menuexplorar_unum_9a0d84bc:

    # "Al levantar la mano para tocarla, algo en tu estómago se revuelve. Un nudo que asciende hasta la garganta, que no te permite pensar correctamente."
    "When you lift your hand to touch it, something in your stomach twists. A knot rises to your throat, making it hard to think straight."

# game/rutas/labelsact2.rpy:390
translate ingles menuexplorar_unum_d41c9e2b:

    # "El miedo entra en tu cuerpo, apretando tu suave piel. Un cuerpo jugoso, que no es nada más que un trozo de carne esperando a ser comido"
    "Fear seeps into your body, tightening around your soft skin. You're a juicy body, nothing more than a piece of flesh waiting to be eaten."

# game/rutas/labelsact2.rpy:392
translate ingles menuexplorar_unum_36099790:

    # "Estás a punto de darte la vuelta cuando, de pronto, la puerta se abre de par en par."
    "You're about to turn around when suddenly, the door swings wide open."

# game/rutas/labelsact2.rpy:394
translate ingles menuexplorar_unum_a3b8acfd:

    # "Es Solaris. Está sonriendo. Por un segundo, esa sonrisa te recuerda a la de Unum... por los dientes. Brillantes. Perfectos. Demasiado visibles."
    "It's Solaris. She's smiling. For a second, that smile reminds you of Unum's... because of the teeth. Bright. Perfect. Far too visible."

# game/rutas/labelsact2.rpy:395
translate ingles menuexplorar_unum_7e7a7b52:

    # solaris "¿Uh?"
    solaris "Huh?"

# game/rutas/labelsact2.rpy:396
translate ingles menuexplorar_unum_92a51d9b:

    # solaris "¿[nombrejugador]?"
    solaris "[nombrejugador]?"

# game/rutas/labelsact2.rpy:399
translate ingles menuexplorar_unum_c81fa524:

    # "Solaris parece sinceramente sorprendida. Deja de sonreír apenas reconoce quien eres tú."
    "Solaris looks genuinely surprised. She stops smiling the moment she realizes who you are."

# game/rutas/labelsact2.rpy:400
translate ingles menuexplorar_unum_3ad73079:

    # "El aire a su alrededor cambia. Puedes verlo sin problema: su cuerpo se tensa, y la sonrisa que intenta rearmar no le sale del todo bien."
    "The air around her shifts. You can see it clearly: Her body tenses, and the smile she tries to recall doesn't come out quite right."

# game/rutas/labelsact2.rpy:401
translate ingles menuexplorar_unum_8a38a6f0:

    # "Lo que resulta en una mueca incómoda. Demasiado diente, muy poca expresión en los ojos."
    "What comes out instead is an awkward grimace. Too many teeth, too little expression in her eyes."

# game/rutas/labelsact2.rpy:402
translate ingles menuexplorar_unum_96f3ab0e:

    # solaris "No puedes entrar aquí sin permiso."
    solaris "You can't come in here without permission."

# game/rutas/labelsact2.rpy:403
translate ingles menuexplorar_unum_fc986d3d:

    # solaris "Es peligroso. Unum aún no ha regresado con---"
    solaris "It's dangerous. Unum hasn't returned yet with--"

# game/rutas/labelsact2.rpy:404
translate ingles menuexplorar_unum_4f31287d:

    # solaris "Uhhh---"
    solaris "Uhhh--"

# game/rutas/labelsact2.rpy:405
translate ingles menuexplorar_unum_8b91bd89:

    # "Se interrumpe a sí misma. Aprieta los labios hasta formar una delgada línea y desvía la mirada hacia un costado, como si esperara que algo o alguien la salve de tener que continuar hablando."
    "She cuts herself off. Her lips press into a thin line as she turns her gaze aside, as if waiting for something--or someone--to rescue her from having to keep talking."

# game/rutas/labelsact2.rpy:406
translate ingles menuexplorar_unum_ec15d45b:

    # solaris "¡Noor! ¡Shams! ¡Han venido a buscarlos!"
    solaris "Noor! Shams! They've come looking for you!"

# game/rutas/labelsact2.rpy:407
translate ingles menuexplorar_unum_e80fd89c:

    # solaris "¡Ya les dije que deben avisar antes de aparecer aquí, par de sabandijas!"
    solaris "I told you to warn me before showing up here, you pair of pests!"

# game/rutas/labelsact2.rpy:408
translate ingles menuexplorar_unum_3eef10d3:

    # "Los niños no tardan en salir, con ambas colas conectadas resitando disculpas vacías a la mujer mientras ríen sin un rastro de vengüenza alguna en sus cuerpos."
    "The children come out quickly, their twin tails linked together as they mumble empty apologies to the woman, laughing without a trace of shame in their bodies."

# game/rutas/labelsact2.rpy:409
translate ingles menuexplorar_unum_0a679626:

    # solaris "¡Si lo hacen denuevo, le diré a Ignis que les prohiba la entrada!"
    solaris "If you do that again, I'll tell Ignis to ban you from coming here!"

# game/rutas/labelsact2.rpy:410
translate ingles menuexplorar_unum_591e6d40:

    # "Dice forzando una voz dura, aunque no convence a nadie. Luego de eso te mira, y te pide disculpas antes de cerrar la puerta en tu cara."
    "She says it with a forced stern tone, though she convinces no one. Then she looks at you, apologizes, and closes the door right in your face."

# game/rutas/labelsact2.rpy:411
translate ingles menuexplorar_unum_2b861c47:

    # "Tú estás atónito."
    "You're left stunned."

# game/rutas/labelsact2.rpy:412
translate ingles menuexplorar_unum_f064cada:

    # "No sabes que pensar realmente."
    "You don't really know what to think."

# game/rutas/labelsact2.rpy:413
translate ingles menuexplorar_unum_217952d0:

    # "Sientes pena y rechazo."
    "You feel both pity and rejection."

# game/rutas/labelsact2.rpy:415
translate ingles menuexplorar_unum_e456dd87:

    # "Pero los niños no te dan tiempo a poner en orden tus pensamientos, ya que te jalan de las mangas en dirección a la residencia de Unum."
    "But the children don't give you time to organize your thoughts, pulling at your sleeves toward Unum's residence."

# game/rutas/labelsact2.rpy:416
translate ingles menuexplorar_unum_b88e7ba9:

    # "Todo mientras te cuentan lo que hicieron en casa de las estrellas del cinturón de Orión."
    "All the while telling you what they did at the house of the stars of Orion's Belt."

# game/rutas/labelsact2.rpy:417
translate ingles menuexplorar_unum_f9a0bcef:

    # "De lo poco que puedes captar y procesar, es que Noor aprendió a bajar su intensidad, sea lo que eso signifique."
    "From the little you can catch and process, you gather that Noor learned to lower his intensity... whatever that means."

# game/rutas/labelsact2.rpy:421
translate ingles menuexplorar_unum_b5dfcccb:

    # "Paseas por los pasillos observando las pinturas que Unum tiene en su residencia."
    "You walk through the halls, observing the paintings that adorn Unum's residence."

# game/rutas/labelsact2.rpy:422
translate ingles menuexplorar_unum_f9688b4a:

    # "Y te das cuenta de que todas siguen un patrón muy especifico: Todas muestran cuerpos humanos en diferentes posiciones y expresiones."
    "And you realize they all follow a very specific pattern: They all depict human bodies in different positions and expressions."

# game/rutas/labelsact2.rpy:423
translate ingles menuexplorar_unum_7ca4ec01:

    # "Hay mucho cuidado en el uso de sombras, un contraste entre la luz y la sombra que es imposible de pasar por alto."
    "There's great care in the use of shadows--a contrast between light and darkness that's impossible to ignore."

# game/rutas/labelsact2.rpy:424
translate ingles menuexplorar_unum_5bf3f3c6:

    # "Hay algunas que te causan un poco de grima, siendo grotescas al punto de causar algo de incomodidad."
    "Some of them make you uneasy. They're grotesque enough to cause a subtle sense of discomfort."

# game/rutas/labelsact2.rpy:425
translate ingles menuexplorar_unum_bba97029:

    # "No te quieres imaginar como se verán en la noche."
    "You'd rather not imagine what they look like at night."

# game/rutas/labelsact2.rpy:426
translate ingles menuexplorar_unum_b914439b:

    # "No gracias."
    "No, thank you."

# game/rutas/labelsact2.rpy:439
translate ingles ataque_noor_afa7f807:

    # nj "¡SIRUS, para!"
    nj "SIRIUS, stop!"

# game/rutas/labelsact2.rpy:444
translate ingles ataque_noor_433005d5:

    # "[click_texts[click_count]]"
    "[click_texts[click_count]]"

# game/rutas/labelsact2.rpy:456
translate ingles badend_noor_bf67865e:

    # "Noor hace caso omiso a tus palabras."
    "Noor ignores your words."

# game/rutas/labelsact2.rpy:457
translate ingles badend_noor_7e89098c:

    # "Poco a poco, mueres a manos de tu propio hijo."
    "Slowly, you die at the hands of your own son."

# game/rutas/labelsact2.rpy:459
translate ingles badend_noor_91047a3a:

    # ".........."
    ".........."

# game/rutas/labelsact2.rpy:460
translate ingles badend_noor_0da10399:

    # "BAD END: Los nombres aquí son importantes."
    "BAD END: Names are important here."

# game/rutas/labelsact2.rpy:466
translate ingles finalacto25_a20cefa7:

    # "..."
    "..."

# game/rutas/labelsact2.rpy:472
translate ingles cuadro_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/labelsact2.rpy:474
translate ingles cuadro_2409c0c2:

    # nulla "Realmente lo has hecho..."
    nulla "You really did it..."

# game/rutas/labelsact2.rpy:475
translate ingles cuadro_2232ad7b:

    # nulla "Eres increible, [nombrejugador]."
    nulla "You're incredible, [nombrejugador]."

