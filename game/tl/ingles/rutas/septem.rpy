    # septem "{sc=2}Reconozco a una marioneta humana cuando la veo.{/sc}"
    septem "{sc=2}I know a puppet when I see one.{/sc}"

# game/rutas/septem.rpy:134
translate ingles rutaseptem_5bd3e7d7:

    # septem "{sc=2}Tienes sus mismos ojos.{/sc}"
    septem "{sc=2}You have the same eyes.{/sc}"

# game/rutas/septem.rpy:135
translate ingles rutaseptem_1b6eaeb7:

    # septem "{sc=2}Y puedo ver que su voluntad tiende a anteponerse a tus comandos{/sc}"
    septem "{sc=2}And I can see that its will tends to override your commands.{/sc}"

# game/rutas/septem.rpy:138
translate ingles rutaseptem_781d74c6:

    # septem "{sc=2}No tienes un control completo.{/sc}"
    septem "{sc=2}You don't have complete control.{/sc}"

# game/rutas/septem.rpy:139
translate ingles rutaseptem_a20cefa7_3:

    # "..."
    "..."

# game/rutas/septem.rpy:140
translate ingles rutaseptem_a61c384d:

    # "Esperas por lo peor, que te destripe o te rompa algun hueso."
    "You prepare for the worst, that he'll gut you or break a bone."

# game/rutas/septem.rpy:141
translate ingles rutaseptem_3a902d9d:

    # "Pero no sucede nada."
    "But nothing happens."

# game/rutas/septem.rpy:144
translate ingles rutaseptem_755e5437:

    # "Septem solo te observa."
    "Septem is just watching you."

# game/rutas/septem.rpy:147
translate ingles rutaseptem_4dd34298:

    # septem "{sc=2}Oh, no temas. Madre no tiene acceso a un lugar sellado.{/sc}"
    septem "{sc=2}Oh, fear not. Mother does not have access to a sealed place.{/sc}"

# game/rutas/septem.rpy:148
translate ingles rutaseptem_d315d483:

    # septem "{sc=2}Así que no te castigará.{/sc}"
    septem "{sc=2}So she won't punish you.{/sc}"

# game/rutas/septem.rpy:151
translate ingles rutaseptem_d70aab41:

    # "A pesar de que sus palabras tienen la intención de calmarte, el efecto que tienen en ti es todo lo contrario"
    "Although his words are intended to calm you down, the effect they have on you is quite the opposite."

# game/rutas/septem.rpy:157
translate ingles rutaseptem_ce84c45f:

    # septem "{sc=2}Hmm... el nivel de sincronización que tienen no está al 100 porciento.{/sc}"
    septem "{sc=2}Hmm... the level of synchronization is not at 100 percent.{/sc}"

# game/rutas/septem.rpy:158
translate ingles rutaseptem_3fa73a80:

    # septem "{sc=2}No están sintiendo lo mismo y sus reacciones tienden a contradecirse.{/sc}"
    septem "{sc=2}You two are not always feeling the same things, and your reactions tend to\n contradict one another.{/sc}"

# game/rutas/septem.rpy:161
translate ingles rutaseptem_7ac97627:

    # septem "{sc=2}Si tuvieras un control completo...{/sc}"
    septem "{sc=2}If you had complete control...{/sc}"

# game/rutas/septem.rpy:164
translate ingles rutaseptem_fc2800a7:

    # septem "{sc=2}podrías interactuar con este mundo como se te de la gana.{/sc}"
    septem "{sc=2}... you could interact with this world however you want.{/sc}"

# game/rutas/septem.rpy:165
translate ingles rutaseptem_fa1430d8:

    # septem "{sc=2}Una inversión total,{/sc}"
    septem "{sc=2}A total immersion,{/sc}"

# game/rutas/septem.rpy:166
translate ingles rutaseptem_dd079b31:

    # septem " {sc=2}no limitida como la que estás experimentando detrás de esa pantalla.{/sc}"
    septem "{sc=2}not limited like what you are experiencing behind that screen.{/sc}"

# game/rutas/septem.rpy:169
translate ingles rutaseptem_be492887:

    # septem "{sc=2}Estoy seguro de que Nulla ya se ha enterado, por lo que debemos actuar rápido.{/sc}"
    septem "{sc=2}I'm sure Nulla has already found out, so we must act quickly.{/sc}"

# game/rutas/septem.rpy:170
translate ingles rutaseptem_83d9691e:

    # septem "{sc=2}Puedo ayudarte...{/sc}"
    septem "{sc=2}I can help you...{/sc}"

# game/rutas/septem.rpy:171
translate ingles rutaseptem_95af17f3:

    # septem "{sc=2}Seguirás mis comandos si quieres sobrevivir..."
    septem "{sc=2}You will follow my commands if you want to survive..."

# game/rutas/septem.rpy:172
translate ingles rutaseptem_dc6ed0bc:

    # septem "{sc=3}Cuando Nulla saque el sello, no te muevas.{/sc}"
    septem "{sc=3}When Nulla removes the seal, don't move.{/sc}"

# game/rutas/septem.rpy:180
translate ingles rutaseptem_c48f724b:

    # "Aceptas con la esperanza de poder seguir con vida."
    "You accept in the hope that you can stay alive."

# game/rutas/septem.rpy:181
translate ingles rutaseptem_a0523c65:

    # "Harás lo que sea necesario para poder vivir."
    "You will do whatever it takes to live."

# game/rutas/septem.rpy:183
translate ingles rutaseptem_44629003:

    # "Te ganas una sonrisa por parte de Septem al escuchar tu respuesta."
    "You earn a smile from Septem upon hearing your response."

# game/rutas/septem.rpy:186
translate ingles rutaseptem_e1f60ce3:

    # septem "{sc=2}Nulla debe estar por quitar el sello.{/sc}"
    septem "{sc=2}Nulla must be about to remove the seal.{/sc}"

# game/rutas/septem.rpy:188
translate ingles rutaseptem_82415b07:

    # "Asientes con la cabeza..."
    "You nod your head..."

# game/rutas/septem.rpy:191
translate ingles rutaseptem_c3d53d74:

    # "No alcanzan a pasar ni 3 segundos cuando sientes una presión extraña en tu cuerpo... supones que debe ser Nulla."
    "Not even three seconds pass when you feel a strange pressure on your body... you assume it must be Nulla."

# game/rutas/septem.rpy:196
translate ingles rutaseptem_029cee01:

    # "Nulla y el pelirrojo se materializan justo donde los viste la última vez, Nulla parado a un lado de la mesa y el pelirrojo sentado al lado de Septem."
    "Nulla and the redhead materialize right where you saw them last, Nulla standing on one side of the table and the redhead sitting next to Septem."

# game/rutas/septem.rpy:197
translate ingles rutaseptem_7509a23e:

    # "Como si hubieran estado siempre allí."
    "As if they had always been there."

# game/rutas/septem.rpy:198
translate ingles rutaseptem_06a122d7:

    # "Septem mira con una cara larga a Nulla. Y él notando esto habla más rapido de lo normal."
    "Septem looks at Nulla with a long face. And noticing this, he speaks faster than normal."

# game/rutas/septem.rpy:201
translate ingles rutaseptem_0dc29525:

    # nulla "No veo que te haya gustado mucho el regalo. Podrías darmelo y yo le diré a Madre que lo cambie por otro."
    nulla "I see that you didn't like the gift very much. You could give it to me and I'll tell Mother to exchange it for another one."

# game/rutas/septem.rpy:202
translate ingles rutaseptem_0c3916fa:

    # "Se le oye ansioso."
    "He sounds anxious."

# game/rutas/septem.rpy:205
translate ingles rutaseptem_e6bf2171:

    # nulla "Se ve que no es de la máxima calidad..."
    nulla "It seems that it's not of the highest quality..."

# game/rutas/septem.rpy:208
translate ingles rutaseptem_836eb354:

    # nulla "Unum piensa lo mismo, supongo que los demás pensarán igual."
    nulla "Unum thinks the same, so I suppose the others will think so, too."

# game/rutas/septem.rpy:210
translate ingles rutaseptem_9bb8ce4c:

    # "Nulla comienza a acercarse a ti, con el objetivo de tomar tu brazo. Sus ojos sobre tu figura en todo momento."
    "Nulla begins to approach you with the intent to take hold of your arm. His gaze doesn't leave your figure."

# game/rutas/septem.rpy:212
translate ingles rutaseptem_6791dcd5:

    # septem "{sc=2}No es necesario. Irá conmigo a mi dominio.{/sc}"
    septem "{sc=2}There's no need. It will go with me to my domain.{/sc}"

# game/rutas/septem.rpy:213
translate ingles rutaseptem_714eca8d:

    # septem "{sc=2}Habla con madre para que traiga otro regalo.{/sc}"
    septem "{sc=2}Talk to Mother to bring another gift.{/sc}"

# game/rutas/septem.rpy:214
translate ingles rutaseptem_66417729:

    # septem "{sc=3}Dudo que demore más de 5 minutos.{/sc}"
    septem "{sc=3}I doubt it will take more than five minutes.{/sc}"

# game/rutas/septem.rpy:216
translate ingles rutaseptem_f6b77137:

    # nulla "Disculpa, pero no puedo manchar el nombre de Madre con esta ofrenda tan mediocre."
    nulla "Sorry, but I can't tarnish Mother's name with such a mediocre offering."

# game/rutas/septem.rpy:218
translate ingles rutaseptem_03c5a22d:

    # "Nulla te agarra el brazo fuertemente e intenta hablarte"
    "Nulla grabs your arm tightly and attempts to speak to you."

# game/rutas/septem.rpy:219
translate ingles rutaseptem_4efc56d4:

    # "{glitch=20.0}{color=ffffff}{b}Sígueme el juego. No es segu---{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Play along with me. It's not saf--{/glitch}"

# game/rutas/septem.rpy:221
translate ingles rutaseptem_39e93a0f:

    # "-pero Septem se lo impide tomando a Nulla por la espalda."
    "--but Septem stops him by striking Nulla from behind."

# game/rutas/septem.rpy:223
translate ingles rutaseptem_faca9fae:

    # nulla "Eres un--!"
    nulla "Son of a--!"

# game/rutas/septem.rpy:225
translate ingles rutaseptem_9582ac9b:

    # "En un abrir y cerrar de ojos Septem atraviesa el pecho de Nulla."
    "In the blink of an eye, Septem pierces Nulla's chest."

# game/rutas/septem.rpy:226
translate ingles rutaseptem_1ade8ae3:

    # septem "No dejaré que lo arruines."
    septem "{sc=2}I won't let you ruin it.{/sc}"

# game/rutas/septem.rpy:227
translate ingles rutaseptem_ba6c22e3:

    # "Y con desdén empuja el cuerpo del pelinegro a un lado, provocando que caiga con un golpe seco."
    "And with disdain, he pushes the black-haired man's body to the side, causing him to fall with a thump."

# game/rutas/septem.rpy:228
translate ingles rutaseptem_70079cdb:

    # "Nulla yace en el suelo, tosiendo sangre."
    "Nulla lies on the ground, coughing up blood."

# game/rutas/septem.rpy:229
translate ingles rutaseptem_5477e570:

    # septem "{sc=2}He dicho que me lo llevaré.{/sc}"
    septem "{sc=2}I said I'll take it with me.{/sc}"

# game/rutas/septem.rpy:232
translate ingles rutaseptem_036a8320:

    # "Unum se levanta con urgencia de la mesa, pero decide no acercarse a ellos."
    "Unum urgently gets up from the table, but decides not to approach them."

# game/rutas/septem.rpy:233
translate ingles rutaseptem_c452db4c:

    # unum "WOW Septem, estamos en público. Si alguien te llegase a ver..."
    unum "WOW, Septem, we are in public. If anyone were to see you..."

# game/rutas/septem.rpy:235
translate ingles rutaseptem_3285f4a3:

    # septem "{sc=3}CIERRA LA BOCA{/sc}"
    septem "{sc=3}SHUT YOUR MOUTH.{/sc}"

# game/rutas/septem.rpy:236
translate ingles rutaseptem_f3623661:

    # septem "{sc=3}Nulla{/sc}"
    septem "{sc=3}Nulla.{/sc}"

# game/rutas/septem.rpy:237
translate ingles rutaseptem_317a331c:

    # septem "{sc=2}Puedes decirles a los demás que estaré ocupado.{/sc}"
    septem "{sc=2}You can tell the others I'll be busy.{/sc}"

# game/rutas/septem.rpy:239
translate ingles rutaseptem_d9b6f071:

    # "No te puedes mover por el terror que estás sintiendo ahora mismo. Al parece haber aceptado a Septem no fue la mejor idea."
    "The terror you feel freezes you into place. It seems accepting Septem's offer wasn't the best idea."

# game/rutas/septem.rpy:240
translate ingles rutaseptem_ffb582e7:

    # "Pero de cierta manera le agradeces a los dioses que la ira de Septem no esté enfocada hacia a ti."
    "But in a way, you thank the gods that Septem's wrath isn't focused on you."

# game/rutas/septem.rpy:241
translate ingles rutaseptem_cd101ace:

    # "Aunque te sientes algo mal que haya sido Nulla."
    "Although, you feel a little bad that it'd been focused on Nulla."

# game/rutas/septem.rpy:242
translate ingles rutaseptem_cc8c6ed4:

    # "Septem se gira para poder verte cara a cara, y sin explicar nada te toca la frente delicadamente."
    "Septem turns around in order to be able to see you face to face, and without explaining anything, he touches your forehead delicately."

# game/rutas/septem.rpy:244
translate ingles rutaseptem_024f3a27:

    # "Y comienzas a ver borroso."
    "And your vision blurs."

# game/rutas/septem.rpy:245
translate ingles rutaseptem_7ec6ef2c:

    # "Repentinamente dejas de escuchar la respiración entrecortada de Nulla y el sonido ambiental del comedor."
    "You suddenly stop hearing Nulla's labored breathing and the ambient noise of the dining room."

# game/rutas/septem.rpy:248
translate ingles rutaseptem_a14ba3eb:

    # "Para luego abrir paso a una oscuridad total."
    "And then give way to total darkness."

# game/rutas/septem.rpy:249
translate ingles rutaseptem_a20cefa7_4:

    # "..."
    "..."

# game/rutas/septem.rpy:250
translate ingles rutaseptem_0fd4d656:

    # "......"
    "......"

# game/rutas/septem.rpy:251
translate ingles rutaseptem_6d4e8951:

    # "Despiertas con la sensación de estar cayendo."
    "You wake up to the feeling of falling."

# game/rutas/septem.rpy:254
translate ingles rutaseptem_47a795a8:

    # "Para luego darte cuenta de que estás en una cama espaciosa y calida."
    "And then you realize you're in a warm, spacious bed."

# game/rutas/septem.rpy:255
translate ingles rutaseptem_cd44561d:

    # "Lo primero que tus ojos ven es el enorme ventanal que está ubicado al costado de la cama."
    "The first thing your eyes see is the huge window that is located on the side of the bed."

# game/rutas/septem.rpy:256
translate ingles rutaseptem_99cb8f2d:

    # "Supones que es de día por la luz que entra, pero es extraño ya que no se ve nada más que la potente luz fuera de la ventana."
    "You assume it's daytime because of the light coming in, but it's strange that you can't see anything more than brightness outside the window."

# game/rutas/septem.rpy:257
translate ingles rutaseptem_a4f74b65:

    # "De repente se te viene a la mente lo ocurrido y con apuro buscas con la mirada algún rastro de Septem"
    "Suddenly what happened comes to mind and you hurriedly look for any trace of Septem."

# game/rutas/septem.rpy:258
translate ingles rutaseptem_02ee8d4a:

    # "No hay nadie en la habitación contigo."
    "There's no one in the room with you."

# game/rutas/septem.rpy:261
translate ingles rutaseptem_2d46abba:

    # "Tienes algo de miedo, para ser completamente honestos."
    "You're kind of scared, to be completely honest."

# game/rutas/septem.rpy:262
translate ingles rutaseptem_746b313e:

    # "Además de que la cama está perfecta como para quedarte unos minutos más."
    "Besides, the bed is perfect for staying a few more minutes."

# game/rutas/septem.rpy:263
translate ingles rutaseptem_ae561ae0:

    # "Poco a poco, vuelves a cerrar los ojos."
    "Little by little, you close your eyes again."

# game/rutas/septem.rpy:265
translate ingles rutaseptem_87158381:

    # septem "Despierta."
    septem "Wake up."

# game/rutas/septem.rpy:266
translate ingles rutaseptem_beca8321:

    # "Una voz te comanda y te obliga a abrir los ojos de golpe."
    "A voice commands you and forces you to open your eyes suddenly."

# game/rutas/septem.rpy:267
translate ingles rutaseptem_c48a39ad:

    # "Como si te hubieran echado agua fría en toda la cara."
    "Holding in your scream, you remain completely still."

# game/rutas/septem.rpy:270
translate ingles rutaseptem_79c294de:

    # "Con dificultad te levantas de la cama."
    "You get out of bed with difficulty."

# game/rutas/septem.rpy:272
translate ingles rutaseptem_b5b81d43:

    # "La habitación es asquerosamente amplia y con un ambiente que te recuerda a un hospital."
    "The room is disgustingly spacious with an atmosphere that reminds you of a hospital."

# game/rutas/septem.rpy:273
translate ingles rutaseptem_780d67d9:

    # "Todo blanco, sin rastos de otra gama de colores."
    "All white, without traces of any other color."

# game/rutas/septem.rpy:274
translate ingles rutaseptem_df9ad266:

    # "Nada de lo que se encuentra aquí evoca algún sentimiento de pertenencia o rastro de personalidad."
    "Nothing found here evokes any sense of belonging or trace of personality."

# game/rutas/septem.rpy:275
translate ingles rutaseptem_79fba47e:

    # "Es raro."
    "It's weird."

# game/rutas/septem.rpy:276
translate ingles rutaseptem_870335b3:

    # septem "Veo que ya has despertado."
    septem "I see you've already woken up."

# game/rutas/septem.rpy:282
translate ingles rutaseptem_6a9b0971:

    # septem "Es hora del desayuno."
    septem "It's time for breakfast."

# game/rutas/septem.rpy:284
translate ingles rutaseptem_ecee781a:

    # "Septem está cerca del ventanal con las manos detrás de su espalda."
    "Septem is near the window with his hands behind his back."

# game/rutas/septem.rpy:285
translate ingles rutaseptem_f674b13e:

    # "No tienes idea de donde apareció, y eso te pone la piel de gallina."
    "You have no idea where he came from, and it gives you goosebumps."

# game/rutas/septem.rpy:287
translate ingles rutaseptem_83d26d90:

    # "Al parecer te tomas más tiempo del necesario para contestarle, pues Septem hace una mueca, irritado."
    "It seems you take more time than necessary to answer him, because Septem grimaces, irritated."

# game/rutas/septem.rpy:288
translate ingles rutaseptem_d6950547:

    # septem "¿Me escuchaste?"
    septem "Did you hear me?"

# game/rutas/septem.rpy:289
translate ingles rutaseptem_ddb4b8d6:

    # "Asientes con la cabeza."
    "You nod."

# game/rutas/septem.rpy:290
translate ingles rutaseptem_d36e8bf2:

    # septem "Bien. Vamos."
    septem "Okay. Let's go."

# game/rutas/septem.rpy:293
translate ingles rutaseptem_a9295bf8:

    # "Septem junta las manos y el lugar comienza a cambiar. La cama y la habitación se transforman en un comedor con la misma paleta de colores."
    "Septem puts his hands together and the place begins to change. The bed and room transform into a dining room with the same color palette."

# game/rutas/septem.rpy:298
translate ingles rutaseptem_010eafc2:

    # "Caes en una silla, frente a una mesa que ya tiene platos y comida servida."
    "You fall into a chair in front of a table that already has plates and food served atop them."

# game/rutas/septem.rpy:299
translate ingles rutaseptem_51a9c508:

    # "Septem yace también sentado, al frente tuyo."
    "Septem is seated in front of you."

# game/rutas/septem.rpy:302
translate ingles rutaseptem_93d47bfd:

    # septem "La marioneta lleva más de 24 horas sin comer algo."
    septem "The puppet hasn't eaten anything for more than 24 hours."

# game/rutas/septem.rpy:303
translate ingles rutaseptem_97bef2f7:

    # septem "Debe comer, sino no funcionará de la manera correcta."
    septem "You must eat, otherwise the puppet won't work properly."

# game/rutas/septem.rpy:306
translate ingles rutaseptem_a0ba904b:

    # "Por algún motivo, aunque no sabrías explicar el porqué, parece que hablara desde la experiencia."
    "For some reason, although you couldn't explain why, it seems like he was speaking from experience."

# game/rutas/septem.rpy:307
translate ingles rutaseptem_8a21eb8a:

    # "No te atreves a hacer nada, pues Septem no te ha dado permiso para comenzar a comer. Y no quieres tentar a la suerte."
    "You don't dare do anything, since Septem hasn't given you permission to start eating. And you don't want to tempt fate."

# game/rutas/septem.rpy:310
translate ingles rutaseptem_be4b3e40:

    # septem "Puedes comer."
    septem "You can eat."

# game/rutas/septem.rpy:313
translate ingles rutaseptem_494c663e:

    # "Mientras comes te das cuenta de algo extraño y es que Septem ahora no posee esa voz que resuena tanto en tu cabeza como en tu cuerpo."
    "While eating, you realize something strange: Septem no longer has that voice that resonates both in your head and body."

# game/rutas/septem.rpy:314
translate ingles rutaseptem_3cccff85:

    # "Esa voz algo inestable y a la vez inorgánica."
    "That somewhat unstable and at the same time inorganic voice."

# game/rutas/septem.rpy:315
translate ingles rutaseptem_3228470c:

    # "Ahora es normal."
    "It's normal now."

# game/rutas/septem.rpy:316
translate ingles rutaseptem_e6aff6de:

    # "No crees que sea buena idea preguntarle, puede ser alguna falta de respeto hablar o preguntar ese tipo de cosas."
    "You don't think it's a good idea to ask him, it might be disrespectful to talk about that kind of thing."

# game/rutas/septem.rpy:319
translate ingles rutaseptem_21561f09:

    # septem "No me gusta que tengamos a la marioneta interfiriendo en nuestra conversación..."
    septem "I don't like that we have the puppet interfering in our conversation..."

# game/rutas/septem.rpy:320
translate ingles rutaseptem_9b263f43:

    # septem "Pero es indispensable para poder conectarte a este mundo."
    septem "But it's essential to be able to connect you to this world."

# game/rutas/septem.rpy:323
translate ingles rutaseptem_f31fa605:

    # septem "...Te respeto. Al ser una entidad de un plano superior, probablemente tienes más poder que yo o Madre juntos."
    septem "... I respect you. Being an entity from a higher plane, you probably have more power than me or Mother combined."

# game/rutas/septem.rpy:324
translate ingles rutaseptem_e3393e61:

    # septem "Incluso podría ser muy parecido al del creador..."
    septem "It could even be very similar to the power of the Creator..."

# game/rutas/septem.rpy:327
translate ingles rutaseptem_34ef2f63:

    # septem "Lastimosamente, ese poder no se puede demostrar ahora mismo, pues aquí solo estás de visita."
    septem "Unfortunately, that power cannot be demonstrated right now, since you're only visiting here."

# game/rutas/septem.rpy:330
translate ingles rutaseptem_5ab575e3:

    # "{sc=3}Probablemente te olvides de este mundo cuando cortes el vinculo conmigo.{/sc}"
    "{sc=3}You'll probably forget this world when you cut ties with me.{/sc}"

# game/rutas/septem.rpy:331
translate ingles rutaseptem_a3a46746:

    # "¿Que ha sido eso? una voz se ha colado dentro de tus pensamientos."
    "What was that? A voice slipped into your thoughts."

# game/rutas/septem.rpy:332
translate ingles rutaseptem_65414f6e:

    # "Esto no te gusta."
    "You don't like this."

# game/rutas/septem.rpy:333
translate ingles rutaseptem_31924e0f_1:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:336
translate ingles rutaseptem_772d2ca2:

    # septem "Necesito tiempo..."
    septem "I need time..."

# game/rutas/septem.rpy:341
translate ingles rutaseptem_a5164bf3:

    # "Septem te observa antes de contestar completamente serio."
    "Septem looks at you before answering completely seriously."

# game/rutas/septem.rpy:344
translate ingles rutaseptem_68d6f1d3:

    # septem "Tiempo para hacer el cambio de huesped."
    septem "Time to change the vessel."

# game/rutas/septem.rpy:345
translate ingles rutaseptem_ab0308a8:

    # septem "Y convertirnos un ser perfecto."
    septem "And become a perfect being."

# game/rutas/septem.rpy:346
translate ingles rutaseptem_da9f9a38:

    # septem "Tú [nombrejugador], eres lo que necesito."
    septem "You, [nombrejugador], are what I need."

# game/rutas/septem.rpy:351
translate ingles rutaseptem_86ac12d8:

    # septem "comprendo que para alguien ajeno al jardín pueda ser dificil de entender..."
    septem "I know that for someone outside the Garden, it may be difficult to understand..."

# game/rutas/septem.rpy:354
translate ingles rutaseptem_b90894fe:

    # septem "¿Pero cual sería la gracia de saber todo al instante? ¿Hmm?"
    septem "But what would be the point of knowing everything instantly? Hmm?"

# game/rutas/septem.rpy:355
translate ingles rutaseptem_2f956e14:

    # septem "Te prometo que te explicaré todo cuando sepa que eres lo que busco."
    septem "I promise I'll explain everything to you when I know you're what I'm looking for."

# game/rutas/septem.rpy:356
translate ingles rutaseptem_0cb6a9d9:

    # septem "Por ahora lo que puedes saber es que necesitamos tiempo para hacer el cambio de huesped."
    septem "For now, all you need to know is that we need time to make the change of vessel."

# game/rutas/septem.rpy:359
translate ingles rutaseptem_ab0308a8_1:

    # septem "Y convertirnos un ser perfecto."
    septem "And become a perfect being."

# game/rutas/septem.rpy:362
translate ingles rutaseptem_da9f9a38_1:

    # septem "Tú [nombrejugador], eres lo que necesito."
    septem "You, [nombrejugador], are what I need."

# game/rutas/septem.rpy:366
translate ingles rutaseptem_8c5bf15e:

    # nj "Ya tuve suficiente, harás lo que yo diga."
    nj "I've had enough, you'll do what I say."

# game/rutas/septem.rpy:369
translate ingles rutaseptem_8a0e874e:

    # "Septem te mira asombrado."
    "Septem looks at you in amazement."

# game/rutas/septem.rpy:370
translate ingles rutaseptem_a650887a:

    # "Con la información dada, sabes que ahora estás en una posición donde Septem no tiene poder ante ti."
    "With the information given, you know that you are now in a position where Septem has no power before you."

# game/rutas/septem.rpy:371
translate ingles rutaseptem_de3c221c:

    # "Pues claramente ha dicho eso."
    "Well, he clearly said that."

# game/rutas/septem.rpy:372
translate ingles rutaseptem_2c6012cb:

    # "...¿cierto?"
    "... Right?"

# game/rutas/septem.rpy:376
translate ingles rutaseptem_8aea4a58:

    # septem "Pero."
    septem "But."

# game/rutas/septem.rpy:379
translate ingles rutaseptem_46758629:

    # septem "Mientras más tiempo pase, más independencia va a adquirir tu marioneta."
    septem "The more time passes, the more independence your puppet will acquire."

# game/rutas/septem.rpy:380
translate ingles rutaseptem_64d5cbfc:

    # septem "Y necesitamos su permiso para realizar el cambio..."
    septem "And we need their permission to make the change..."

# game/rutas/septem.rpy:381
translate ingles rutaseptem_a45684bc:

    # septem "Eso será un problema si no sabes como controlarle."
    septem "That will be a problem if you don't know how to control them."

# game/rutas/septem.rpy:384
translate ingles rutaseptem_eb317aa3:

    # "{sc=3}Septem está mientiendo, yo nunca iría en tu contra o desobedecería tus comandos{/sc}"
    "{sc=3}Septem is lying, I would never go against you or disobey your commands.{/sc}"

# game/rutas/septem.rpy:385
translate ingles rutaseptem_3196b4cc:

    # "{sc=3}[nombrejugador], estoy aquí para servirte.{/sc}"
    "{sc=3}[nombrejugador], I am here to serve you.{/sc}"

# game/rutas/septem.rpy:386
translate ingles rutaseptem_b2f5aeaa:

    # "{sc=3}No le creas{/sc}"
    "{sc=3}Don't believe him.{/sc}"

# game/rutas/septem.rpy:389
translate ingles rutaseptem_6b6aa02b:

    # "Septem suelta una pequeña risa al observar tu reacción."
    "Septem lets out a small laugh as he watches your reaction."

# game/rutas/septem.rpy:390
translate ingles rutaseptem_ba128b60:

    # septem "Deberías tener más cuidado, ya está empezando a desligarse de ti."
    septem "You should be more careful, it's already starting to disengage from you."

# game/rutas/septem.rpy:393
translate ingles rutaseptem_0e5c1e24:

    # septem "Y si pasa eso, ya no me servirás."
    septem "And if that happens, you will no longer be of use to me."

# game/rutas/septem.rpy:395
translate ingles rutaseptem_adf4bbb1:

    # "el rubio se levanta de la mesa, y examina sus manos por un buen rato."
    "The blond gets up from the table, and examines his hands for a long time."

# game/rutas/septem.rpy:397
translate ingles rutaseptem_315ddbce:

    # septem "Nos vemos en el almuerzo, mientras, puedes recorrer mi dominio como te plazca."
    septem "See you at lunch, and in the meantime, you can roam around my domain as you please."

# game/rutas/septem.rpy:399
translate ingles rutaseptem_8ce29a22:

    # "Septem deja la mesa llevando los platos, ahora vacíos, a otro lugar. Supones que debe ser la cocina."
    "Septem leaves the table, taking the now empty plates somewhere else. You assume it must be to the kitchen."

# game/rutas/septem.rpy:400
translate ingles rutaseptem_ae317a76:

    # "Esperas a que Septem aparezca nuevamente, pues no te crees que te haya dejado sin supervición y te haya dado un pase libre para hacer lo que quieras."
    "You wait for Septem to appear again, because you can't believe he left you unsupervised and gave you a free pass to do whatever you want."

# game/rutas/septem.rpy:401
translate ingles rutaseptem_907ab9ba:

    # "Más él no vuelve a aparecer."
    "But he doesn't appear again."

# game/rutas/septem.rpy:402
translate ingles rutaseptem_9fc3798d:

    # "Te quedas ahí, recolectando tus pensamientos."
    "You stand there, collecting your thoughts."

# game/rutas/septem.rpy:403
translate ingles rutaseptem_89cd696d:

    # "Analizando todo lo que te han dicho y ha pasado."
    "Analyzing everything you've been told and everything that has happened."

# game/rutas/septem.rpy:404
translate ingles rutaseptem_09d76470:

    # "Septem quiere darte control completo, una sincronización completa con este cuerpo..."
    "Septem wants to give you complete control, complete synchronization with this body..."

# game/rutas/septem.rpy:405
translate ingles rutaseptem_9c77c47a:

    # "{sc=3}Pero no comprendo que estaría ganando él a cambio.{/sc}"
    "{sc=3}But I don't understand what he would be gaining in return.{/sc}"

# game/rutas/septem.rpy:406
translate ingles rutaseptem_688507c3:

    # "{sc=3}No es de fiar.{/sc}"
    "{sc=3}He is not trustworthy.{/sc}"

# game/rutas/septem.rpy:407
translate ingles rutaseptem_db499876:

    # "{sc=3}Necesitas a Nulla{/sc}"
    "{sc=3}You need Nulla.{/sc}"

# game/rutas/septem.rpy:411
translate ingles rutaseptem_09a43515:

    # "No necesitas a Nulla."
    "You don't need Nulla."

# game/rutas/septem.rpy:414
translate ingles rutaseptem_ceb58f1a:

    # "{sc=3}Tengo razón, necesitamos a Nulla.{/sc}"
    "{sc=3}I'm right, we need Nulla.{/sc}"

# game/rutas/septem.rpy:417
translate ingles rutaseptem_985dfb2a:

    # "Sea cual sea tu respuesta... no sabes si Nulla siga vivo o no."
    "Whatever your answer... you don't know if Nulla is still alive or not."

# game/rutas/septem.rpy:418
translate ingles rutaseptem_9401887a:

    # "Por lo que debes seguir por tu cuenta... por ahora."
    "So you must remain on your own... for now."

# game/rutas/septem.rpy:419
translate ingles rutaseptem_a20cefa7_5:

    # "..."
    "..."

# game/rutas/septem.rpy:421
translate ingles rutaseptem_df4df910:

    # "Pasas el tiempo caminando por lo que parece ser un templo."
    "You spend your time walking through what appears to be a temple."

# game/rutas/septem.rpy:422
translate ingles rutaseptem_bd56d05f:

    # "Pues tienen un monton de estatuas de Septem y cuadros con alegoría religiosa."
    "Well, it has a lot of statues of Septem and paintings with religious allegory."

# game/rutas/septem.rpy:423
translate ingles rutaseptem_9e2cbfd0:

    # "Y dentro de él te encuentras con un monton de puertas."
    "And inside it, you find a lot of doors."

# game/rutas/septem.rpy:429
translate ingles rutaseptem_ce39863e:

    # "No tienes muchas ganas de arriesgarte por hoy."
    "You don't feel like taking any chances today."

# game/rutas/septem.rpy:430
translate ingles rutaseptem_38ea4df4:

    # "Es mejor que esperes al almuerzo y así poder hablar con Septem."
    "It's better that you wait until lunch so you can talk to Septem."

# game/rutas/septem.rpy:432
translate ingles rutaseptem_24a0f086:

    # "Esperas a que pasen las horas."
    "You wait for the hours to pass."

# game/rutas/septem.rpy:433
translate ingles rutaseptem_124f101d:

    # "Dormitas pensando que fue lo que pasó con Nulla y el porqué Septem sabe de ti..."
    "You doze off thinking about what happened with Nulla and why Septem knows about you..."

# game/rutas/septem.rpy:434
translate ingles rutaseptem_e216f117:

    # "Pero no encuentras respuesta a ninguna de las dos incognitas."
    "But you can't find an answer to either..."

# game/rutas/septem.rpy:436
translate ingles rutaseptem_a34b9131:

    # "El tiempo pasa lo suficientemente rápido como para sorprenderte de la llegada de Septem al altar."
    "Time passes quickly enough to surprise you with Septem's arrival at the altar."

# game/rutas/septem.rpy:437
translate ingles rutaseptem_8f3a35f4:

    # "Esperas a que él te dirija la palabra para poder hablar."
    "You wait for him to speak so you can talk."

# game/rutas/septem.rpy:440
translate ingles rutaseptem_85232bc9:

    # septem "Es momento del almuerzo."
    septem "It's time for lunch."

# game/rutas/septem.rpy:443
translate ingles rutaseptem_ac23ce6e:

    # "Tienes la tentación de preguntar porqué le pone tanto enfasis a tener que compartir la comida contigo."
    "You're tempted to ask why he puts so much emphasis on sharing mealtimes with you."

# game/rutas/septem.rpy:444
translate ingles rutaseptem_5d167997:

    # "Si es que se está preocupando de que comas, entonces no es necesario sentarse a comer contigo."
    "If he's worrying about you eating, then there's no need to sit down and eat with you."

# game/rutas/septem.rpy:445
translate ingles rutaseptem_c27749eb:

    # "Sospechas que será así en toda tu estadía en este lugar."
    "You suspect it will be like this for your entire stay."

# game/rutas/septem.rpy:448
translate ingles rutaseptem_f91f3866:

    # "Nuevamente Septem los teletransporta al comedor, donde otra vez los reciben los platos ya listos en la mesa."
    "Septem teleports you to the dining room again, where the two of you are greeted by the dishes already placed on the table once more."

# game/rutas/septem.rpy:449
translate ingles rutaseptem_3a0e93f3:

    # "Septem espera a que tu comiences a comer para hacerlo él."
    "Septem waits for you to start eating before he does."

# game/rutas/septem.rpy:452
translate ingles rutaseptem_f1dec540:

    # "No se le ve muy dispuesto a tener una conversación..."
    "He doesn't seem very willing to have a conversation..."

# game/rutas/septem.rpy:455
translate ingles rutaseptem_d4d0e508:

    # "Pero no puedes evitar pensar que hay algo extraño en su actitud..."
    "But you can't help but think there's something strange about his attitude..."

# game/rutas/septem.rpy:456
translate ingles rutaseptem_8d3872a1:

    # "Su aura no es la misma a la que tuvo dentro de esa habitación."
    "His aura is not the same as the one he had inside that room."

# game/rutas/septem.rpy:457
translate ingles rutaseptem_1effc10f:

    # "El comportamiento es totalmente diferente, aquí muestra una careta segura... en cambio allá, una totalmente contraria."
    "His behavior is totally different, here it shows a confident mask... but there, a completely opposite one."

# game/rutas/septem.rpy:460
translate ingles rutaseptem_52a5a881:

    # septem "¿Oh? ¿A qué te refieres?"
    septem "Oh? What do you mean?"

# game/rutas/septem.rpy:461
translate ingles rutaseptem_4bddff63:

    # "Le explicas lo que pasó en la habitación del altar."
    "You explain to him what happened in the altar room."

# game/rutas/septem.rpy:465
translate ingles rutaseptem_c1a8675b:

    # "Preguntar la razón no te da buena espina, por lo que decides guardar silencio... por ahora."
    "You don't want to risk your life by asking, so you decide to remain silent... for now."

# game/rutas/septem.rpy:466
translate ingles rutaseptem_ea5c81f2:

    # "Septem no se digna en ningún momento en iniciar cualquier tipo de conversación."
    "Septem shows no interest in starting any kind of conversation."

# game/rutas/septem.rpy:467
translate ingles rutaseptem_f604fe56:

    # "Por lo que comen en silencio."
    "So you eat in silence."

# game/rutas/septem.rpy:471
translate ingles rutaseptem_fda0d2a2:

    # "Comienzan a comer."
    "You start eating."

# game/rutas/septem.rpy:473
translate ingles rutaseptem_0b717d72:

    # "Septem come de manera lenta, se le ve totalmente desconectado con la acción."
    "Septem eats slowly, he seems totally disconnected from the action."

# game/rutas/septem.rpy:474
translate ingles rutaseptem_623963f4:

    # "Como si lo estuviera haciendo en automático."
    "As if doing it automatically."

# game/rutas/septem.rpy:477
translate ingles rutaseptem_8a57a907:

    # septem "Tus ojos llevan un buen tiempo en mi cara."
    septem "Your eyes have been on my face for a long time."

# game/rutas/septem.rpy:478
translate ingles rutaseptem_6758ecc3:

    # septem "¿Pasa algo?"
    septem "Something wrong?"

# game/rutas/septem.rpy:481
translate ingles rutaseptem_bcf6dd4d:

    # "No."
    "No."

# game/rutas/septem.rpy:482
translate ingles rutaseptem_ada2b3b1:

    # septem "Está bien..."
    septem "Alright..."

# game/rutas/septem.rpy:485
translate ingles rutaseptem_c365013c:

    # "Comer de esta manera lo hace muy incómodo, puedes escuchar como masticas tu comida y estás al tanto de que el silencio que hay en el lugar ayuda a que se escuche cada sonido que tu boca y dientes emiten."
    "Eating this way makes the situation very uncomfortable. You can hear how you chew your food and you're keenly aware that the place's silence emphasizes every sound that your mouth and teeth make."

# game/rutas/septem.rpy:486
translate ingles rutaseptem_7bd6a41d:

    # "Es horrible y sumamente incómodo..."
    "It's horrible and extremely uncomfortable..."

# game/rutas/septem.rpy:492
translate ingles rutaseptem_682031a0:

    # nj "No es nada..."
    nj "It's no big deal..."

# game/rutas/septem.rpy:493
translate ingles rutaseptem_670abeb3:

    # nj "Solo es que siento que hay mucho silencio."
    nj "It's just that I feel like there's a lot of silence."

# game/rutas/septem.rpy:496
translate ingles rutaseptem_c8885b8b:

    # septem "¿Te incomoda?"
    septem "Does it make you uncomfortable?"

# game/rutas/septem.rpy:499
translate ingles rutaseptem_5b2e4b6b:

    # nj "No lo sé."
    nj "Don't know."

# game/rutas/septem.rpy:500
translate ingles rutaseptem_c81d3f08:

    # "No es que no lo sepas, es solo que no sabes que contestar para no hacerlo enojar, o que sienta que es una falta de respeto."
    "It's not that you don't know, it's just that you don't know what to answer so as not to make him angry, or make him feel like it's disrespectful."

# game/rutas/septem.rpy:501
translate ingles rutaseptem_f165e220:

    # "Te aterra no contestar de la manera que él encuentre correcta."
    "You're terrified that you won't answer in the way he thinks is right."

# game/rutas/septem.rpy:504
translate ingles rutaseptem_1fb57b89:

    # septem "No te procupes, tienes total libertad de hablarme como se te plazca."
    septem "Don't worry, you have complete freedom to talk to me as you please."

# game/rutas/septem.rpy:505
translate ingles rutaseptem_32147ef2:

    # septem "Siempre y cuando seas tú, [nombrejugador]. No la marioneta."
    septem "As long as it's you, [nombrejugador]. Not the puppet."

# game/rutas/septem.rpy:508
translate ingles rutaseptem_e1df7afd:

    # septem "Estoy aquí para servirte."
    septem "I am here to serve you."

# game/rutas/septem.rpy:517
translate ingles rutaseptem_0f35561d:

    # "Al terminar, Septem se lleva los platos y desaparece sin antes decir que se verán en la cena."
    "When finished, Septem takes the plates and disappears after saying you'll meet again at dinner."

# game/rutas/septem.rpy:518
translate ingles rutaseptem_a5db0307:

    # "Tú ya te estás aburriendo de la poca interacción que han estado teniendo."
    "You're already getting bored with the little interaction you've been having."

# game/rutas/septem.rpy:519
translate ingles rutaseptem_7ff8bf6d:

    # "Y nada interesante ha pasado hasta ahora... si hubieras ido con Unum..."
    "And nothing interesting has happened so far... if you had gone with Unum..."

# game/rutas/septem.rpy:520
translate ingles rutaseptem_2cab57c8:

    # "Bueno, tienes que pasar el tiempo de algún modo."
    "Well, you have to pass the time somehow."

# game/rutas/septem.rpy:527
translate ingles rutaseptem_ce39863e_1:

    # "No tienes muchas ganas de arriesgarte por hoy."
    "You don't feel like taking any chances today."

# game/rutas/septem.rpy:528
translate ingles rutaseptem_016dbb1d:

    # "Es mejor que esperes a la cena y así poder hablar con Septem."
    "It's better that you wait until dinner so you can talk to Septem."

# game/rutas/septem.rpy:533
translate ingles rutaseptem_4130ff4d:

    # "El tiempo pasa rápido, y esta vez presencias como Septem se materializa ante el altar del templo."
    "Time passes quickly, and this time you witness Septem materialize before the temple altar."

# game/rutas/septem.rpy:534
translate ingles rutaseptem_ba0baaf1:

    # "Ya a estas alturas supones que te has acostumbrado, pues no te sobresaltas."
    "By now you've gotten used to it, so you don't get startled."

# game/rutas/septem.rpy:537
translate ingles rutaseptem_652c9c43:

    # septem "Es hora de la cena."
    septem "It's time for dinner."

# game/rutas/septem.rpy:540
translate ingles rutaseptem_e7b0e8d1:

    # nj "{sc=3}¿Vamos a seguir esta rutina todos los días?{/sc}"
    nj "{sc=3}Are we going to follow this routine every day?{/sc}"

# game/rutas/septem.rpy:543
translate ingles rutaseptem_bc8d70e7:

    # septem "¿[nombrejugador], has sido tú quién a comandado esa pregunta?"
    septem "[nombrejugador], were you the one who asked that question?"

# game/rutas/septem.rpy:546
translate ingles rutaseptem_1f5d9c14:

    # nj "Sí."
    nj "Yes."

# game/rutas/septem.rpy:550
translate ingles rutaseptem_af15d919:

    # septem "Hmmmm."
    septem "Hmmmm."

# game/rutas/septem.rpy:553
translate ingles rutaseptem_ac4b0ebc:

    # septem "La idea es que las marionetas puedan obtener energía para funcionar..."
    septem "The idea is that the puppets can obtain energy to function properly..."

# game/rutas/septem.rpy:554
translate ingles rutaseptem_bf8c467c:

    # septem "Tanto la mía como la tuya."
    septem "Both mine and yours."

# game/rutas/septem.rpy:555
translate ingles rutaseptem_83755e0e:

    # nj "¿Tienes una marioneta?"
    nj "Do you have a puppet?"

# game/rutas/septem.rpy:556
translate ingles rutaseptem_385e441b:

    # septem "Algo así."
    septem "Something like that."

# game/rutas/septem.rpy:557
translate ingles rutaseptem_08020a50:

    # "Septem comienza a acercarse a ti. Su cara angelical es una antitesis con el aura que transmite."
    "Septem begins to approach you. His angelic face is an antithesis to the aura he transmits."

# game/rutas/septem.rpy:561
translate ingles rutaseptem_325dad7e:

    # nj "No"
    nj "No."

# game/rutas/septem.rpy:562
translate ingles rutaseptem_71bcb348:

    # septem "Veo que tendré que hacer algo al respecto..."
    septem "I see I'll have to do something about this..."

# game/rutas/septem.rpy:564
translate ingles rutaseptem_71108422:

    # septem "Aunque... viendo que aún tienes la capacidad de tomar una desición que va contra los deseos de la marioneta, la penalización no será fatal."
    septem "Although... seeing as you still have the ability to make a decision that goes against the puppet's wishes, the penalty will not be fatal."

# game/rutas/septem.rpy:568
translate ingles rutaseptem_5e393540:

    # "Septem sonrie de manera tétrica."
    "Septem smiles eerily."

# game/rutas/septem.rpy:571
translate ingles rutaseptem_dc04e0b1:

    # septem "Oh no te preocupes... a ti no te dolerá [nombrejugador]."
    septem "Oh, don't worry... it won't hurt you, [nombrejugador]."

# game/rutas/septem.rpy:572
translate ingles rutaseptem_acc57865:

    # septem "Esto le enseñará a tu recipiente a respetar tus deseos."
    septem "This will teach your puppet to respect your wishes."

# game/rutas/septem.rpy:574
translate ingles rutaseptem_3dbb62dc:

    # "Septem te prohibe moverte con solo el chasquido de sus dedos, y sonriendo comienza a acercarse a ti. Su cara angelical es una antitesis con el aura que transmite."
    "Septem forbids you to move with only the snap of his fingers, and he begins to approach you, smiling. His angelic face is an antithesis to the aura he transmits."

# game/rutas/septem.rpy:576
translate ingles rutaseptem_a9f7ebff:

    # "Una de sus manos se posa en tu mandibula, tomándola con delicadeza para luego apretar con fuerza entre tus mejillas, provocando que tu boca se abrar automaticamente."
    "One of his hands rests on your jaw, gently taking it and squeezing your cheeks hard, causing your mouth to open automatically."

# game/rutas/septem.rpy:578
translate ingles rutaseptem_fc88dd0d:

    # septem "Por respeto a tí, [nombrejugador], no lo haré de una forma tan cruda."
    septem "Out of respect for you, [nombrejugador], I won't do it in such a crude way."

# game/rutas/septem.rpy:579
translate ingles rutaseptem_d34446b1:

    # septem "Pero quiero que sepas que a mí me gusta mucho ensuciarme las manos."
    septem "But I want you to know that I really like to get my hands dirty."

# game/rutas/septem.rpy:581
translate ingles rutaseptem_8ec16bfb:

    # "Septem posa sus ojos en tu boca por un instante, y al parpadear, sientes como tu boca se llena de un líquido caliente y un dolor punzante nace donde debería estar tu lengua."
    "Septem rests his gaze on your mouth for a moment, and as you blink, you feel your mouth fill with a hot liquid and a stinging pain arises where your tongue should be."

# game/rutas/septem.rpy:584
translate ingles rutaseptem_e0cdf053:

    # "Duele y quema al mismo tiempo. Cada segundo que pasa, es agonizante."
    "It hurts and burns at the same time. Every second that passes is agonizing."

# game/rutas/septem.rpy:585
translate ingles rutaseptem_260ce5da:

    # "No solo por el dolor, sino que tambien porque no entiendes que está pasando, y porqué está pasando."
    "Not only because of the pain, but also because you don't understand what is happening, and why it is happening."

# game/rutas/septem.rpy:586
translate ingles rutaseptem_5ebe3d08:

    # "Tampoco puedes moverte como para inspeccionar que es el líquido que emana de tu boca y no deja salir."
    "Nor can you move to inspect the liquid that fills your mouth and dribbles out of it."

# game/rutas/septem.rpy:587
translate ingles rutaseptem_56fd4e60:

    # "Cuando intentas hablar, algo no responde."
    "When you try to talk, something doesn't respond."

# game/rutas/septem.rpy:588
translate ingles rutaseptem_2bd5646f:

    # "Algo falta... y no es tu voz."
    "Something is missing... and it's not your voice."

# game/rutas/septem.rpy:589
translate ingles rutaseptem_64fbb25b:

    # "Porque puedes gritar."
    "Because you can scream."

# game/rutas/septem.rpy:590
translate ingles rutaseptem_84bf453f:

    # "Pero no puedes modular las palabras."
    "But you can't modulate words."

# game/rutas/septem.rpy:591
translate ingles rutaseptem_2d11e6a0:

    # septem "Oh, creo que te has dado cuenta ya..."
    septem "Oh, I think you've already realized..."

# game/rutas/septem.rpy:592
translate ingles rutaseptem_c7625b7f:

    # septem "A estas alturas, no veo el proposito de tener una lengua que se manda sola y habla sin el permiso de su dueño."
    septem "I don't see the point of having a tongue that commands itself and speaks without the permission of its owner."

# game/rutas/septem.rpy:595
translate ingles rutaseptem_3561fda1:

    # septem "... Oh no."
    septem "... Oh no."

# game/rutas/septem.rpy:598
translate ingles rutaseptem_7f71929e:

    # septem "No, no, no. [nombrejugador], no pasa nada."
    septem "No, no, no. [nombrejugador], don't worry."

# game/rutas/septem.rpy:599
translate ingles rutaseptem_729d4530:

    # septem "Siento que haya roto parte de tu juguete, pero..."
    septem "I know that I broke part of your toy, but..."

# game/rutas/septem.rpy:602
translate ingles rutaseptem_0db6ebcc:

    # septem "No te preocupes por eso, dentro de poco dejarás este trozo de carne para cambiarlo por mí."
    septem "Don't worry about that, soon you will leave this piece of meat to exchange it for me."

# game/rutas/septem.rpy:603
translate ingles rutaseptem_51cee1b5:

    # septem "Además, aun puedes tomar decisiones."
    septem "Plus, you can still make decisions."

# game/rutas/septem.rpy:611
translate ingles rutaseptem_31924e0f_2:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:614
translate ingles rutaseptem_c04c614c:

    # septem "Mira, realmente quiero que entiendas lo que está pasando y por qué tú eres vital para la recuperación del jardín."
    septem "Look, I really want you to understand what's happening and why you are vital to the Garden's recovery."

# game/rutas/septem.rpy:615
translate ingles rutaseptem_4f8e6d6c:

    # septem "Y no me gustaría omitir infomación vital para tu toma de decisión cuando empiece el cambio de recipiente."
    septem "And I wouldn't want to leave out vital information for your decision-making when the container change begins."

# game/rutas/septem.rpy:616
translate ingles rutaseptem_3ef2236c:

    # septem "Implantaré mis memorias en la marioneta para que sea más rápido."
    septem "I will implant my memories into the puppet to make it simple."

# game/rutas/septem.rpy:618
translate ingles rutaseptem_a9b0c4e4:

    # "Septem coloca su mano izquierda en tu frente."
    "Septem places his left hand on your forehead."

# game/rutas/septem.rpy:620
translate ingles rutaseptem_8ccfc26d:

    # septem "Puedes saltarte la información que se te dará a continuación si es que no te interesa... Creo que tienes algo para hacer eso, Nulla una vez habló de ello."
    septem "You can skip the information below if you're not interested... I think you have something to do with that, Nulla once talked about it."

# game/rutas/septem.rpy:621
translate ingles rutaseptem_35112d7e:

    # septem "El botón de skip, creo que ese es su nombre."
    septem "The skip button, I think that's its name."

# game/rutas/septem.rpy:622
translate ingles rutaseptem_a20cefa7_6:

    # "..."
    "..."

# game/rutas/septem.rpy:624
translate ingles rutaseptem_9d162808:

    # "{b}En un inicio todo era oscuridad, la nada misma.{b}"
    "{b}In the beginning everything was darkness, nothingness itself.{b}"

# game/rutas/septem.rpy:626
translate ingles rutaseptem_98838416:

    # "{b}Cuando llegó el creador, se hizo la luz.{b}"
    "{b}When the Creator arrived, there was light.{b}"

# game/rutas/septem.rpy:630
translate ingles rutaseptem_bf226079:

    # "{b}Y fue ahí que comenzó mi existencia...{b}"
    "{b}And that was where my existence began...{b}"

# game/rutas/septem.rpy:632
translate ingles rutaseptem_88437628:

    # "{b}Aunque, al tener luz, nos permitió ver las sombras. Fue ahí que nos dimos cuenta de la existencia de Nulla.{b}"
    "{b}Although, having light, it allowed us to see the shadows. It was there that we realized the existence of Nulla.{b}"

# game/rutas/septem.rpy:633
translate ingles rutaseptem_9d3aac44:

    # "{b}Aquel que había estado en este lugar antes de mi existencia y de la llegada del creador al jardín... esperando.{b}"
    "{b}He who had been in this place before my existence and the Creator's arrival in the Garden... waiting.{b}"

# game/rutas/septem.rpy:635
translate ingles rutaseptem_42716b8c:

    # "{b}Nulla y el creador estuvieron hablando por un largo tiempo... y yo, al ser todavía un ser sin conocimiento de nada, no les entendí.{b}"
    "{b}Nulla and the Creator were talking for a long time... and I, still a being without knowledge of anything, did not understand them.{b}"

# game/rutas/septem.rpy:636
translate ingles rutaseptem_dd790313:

    # "Pero de algo estoy seguro, y es que Nulla parecía no respetar al creador. Lo trataba como a un igual, subiendo su voz y llegando hasta poner sus sucias manos encima...{b}"
    "{b}But I am sure of one thing, and that is that Nulla seemed to not respect the Creator. He treated them as an equal, raising his voice and even putting his dirty hands on them...{/b}"

# game/rutas/septem.rpy:638
translate ingles rutaseptem_4c61f610:

    # "{b}...{b}"
    "{b}...{b}"

# game/rutas/septem.rpy:639
translate ingles rutaseptem_b6d10283:

    # "{b}Luego el creador me dió la misión de crear estandartes para mantener al jardín funcionando{b}"
    "{b}Then, the Creator gave me the mission to create the Symbols to keep the Garden running.{b}"

# game/rutas/septem.rpy:641
translate ingles rutaseptem_e8abdd86:

    # "{b}Así que eso fue lo que hice. El lunes, le di vida al sol, pero tú lo conoces como Umun.{b}"
    "{b}So that's what I did. On Monday, I gave life to the sun, but you know it as Unum.{b}"

# game/rutas/septem.rpy:643
translate ingles rutaseptem_9d442630:

    # "{b}El martes fue el firmamento y las estrellas, Duae.{b}"
    "{b}Tuesday was the firmament and the stars, Duae.{b}"

# game/rutas/septem.rpy:645
translate ingles rutaseptem_06b96b30:

    # "{b}El miércoles se creó la tierra y las plantas, Tria{b}"
    "{b}On Wednesday, the earth and the plants were created, Tria.{b}"

# game/rutas/septem.rpy:647
translate ingles rutaseptem_7c69b765:

    # "{b}El jueves se creó la luna, Quattor fue igual de brillante que el sol en un inicio..."
    "{b}On Thursday, the moon was created. Quattor was just as bright as the sun at first...{b}"

# game/rutas/septem.rpy:649
translate ingles rutaseptem_015d851d:

    # "{b}Una lastima la pelea que Unum empezó.{b}"
    "{b}It's a shame the fight Unum started.{b}"

# game/rutas/septem.rpy:650
translate ingles rutaseptem_ebf910bc:

    # "{b}...Antes de poner orden todo era un caos, si tan solo hubiera podido intervenir.{b}"
    "{b}... Before putting order, everything was chaos, if only I could have intervened.{b}"

# game/rutas/septem.rpy:652
translate ingles rutaseptem_3362c77e:

    # "{b}Tal vez Quattor seguiría con sus cuatro ojos...{b}"
    "{b}Maybe Quattor would still have her four eyes...{b}"

# game/rutas/septem.rpy:653
translate ingles rutaseptem_ebb3e7b6:

    # "{b}...Al quitarle dos de sus ojos la luna dejó de brillar y ahora sale cuando el sol se oculta.{b}"
    "{b}... By taking away two of her eyes, the moon stopped shining and now rises when the sun sets.{b}"

# game/rutas/septem.rpy:654
translate ingles rutaseptem_4c61f610_1:

    # "{b}...{b}"
    "{b}...{b}"

# game/rutas/septem.rpy:656
translate ingles rutaseptem_52f44f99:

    # "{b}El viernes, se crearon a todas las criaturas, y se dispuso un estandarte que les representa: Quinque.{b}"
    "{b}On Friday, all creatures were created, and a Symbol was set up to represent them: Quinque.{b}"

# game/rutas/septem.rpy:658
translate ingles rutaseptem_5417dcd7:

    # "{b}Por último el sabado, mi querida Sextam nació junto con la humanidad.{b}"
    "{b}Finally on Saturday, my dear Sextam was born along with humanity.{b}"

# game/rutas/septem.rpy:660
translate ingles rutaseptem_1301b323:

    # "{b}...El domingo fue un día de descanso. Dónde estuve todo el día observando el funcionamiento del jardín, pero--{b}"
    "{b}... Sunday was a day of rest. I spent all day observing the operation of the Garden, but--{b}"

# game/rutas/septem.rpy:661
translate ingles rutaseptem_e6cac3c2:

    # "{b}No tenía un cuerpo físico para poder experimentar todo lo que había creado.{b}"
    "{b}I did not have a physical body to experience everything I had created.{b}"

# game/rutas/septem.rpy:662
translate ingles rutaseptem_da90dfce:

    # "{b}Y por mucho tiempo estuve así...{b}"
    "{b}And for a long time, I was like that...{b}"

# game/rutas/septem.rpy:664
translate ingles rutaseptem_1ad02dc9:

    # "{b}Hasta que Sextam me habló de transfundir mi esencia a un humano.{b}"
    "{b}Until Sextam told me about transfusing my essence into a human.{b}"

# game/rutas/septem.rpy:665
translate ingles rutaseptem_a8ddda2c:

    # "{b}Pero para ello debía dejar mi existencia y empezar a vivir como un humano.{b}"
    "{b}But to do this, I had to leave my existence behind and start living as a human. So I did....{b}"

# game/rutas/septem.rpy:667
translate ingles rutaseptem_fe3aab53:

    # "{b}... al instante me di cuenta de mi error, los humanos al ser concebidos, se les da un alma que es distribuida por el jardín o Madre.{b}"
    "{b}... I instantly realized my mistake. When humans are conceived, they are given a soul that is distributed by the Garden or Mother.{b}"

# game/rutas/septem.rpy:668
translate ingles rutaseptem_9b5da504:

    # "{b}Haciendo que la transfusión resulte en una mezcla del alma del humano y la esencia de la deidad que la hace.{b}"
    "{b}Making the transfusion results in a mixture of the human's soul and the essence of the deity that makes it.{b}"

# game/rutas/septem.rpy:669
translate ingles rutaseptem_870d037d:

    # "{b}Así que este cuerpo no es completamente mío.{b}"
    "{b}So, this body is not completely mine.{b}"

# game/rutas/septem.rpy:676
translate ingles rutaseptem_753f0344:

    # septem "Supongo que te estarás preguntando para que te necesito..."
    septem "I guess you're wondering why I need you..."

# game/rutas/septem.rpy:680
translate ingles rutaseptem_d2f5ca3c:

    # septem "... Ya no tengo el control del jardín."
    septem "... I no longer have control of the Garden."

# game/rutas/septem.rpy:681
translate ingles rutaseptem_9e91e54f:

    # septem "Luego de que el creador se esfumara, el jardín empezó a agonizar."
    septem "After the Creator vanished, the Garden began to wither."

# game/rutas/septem.rpy:684
translate ingles rutaseptem_e56d86d9:

    # septem "El primer signo fue la desaparición de los hijos de Sextam, los humanos que nos daban devoción genuina."
    septem "The first sign was the disappearance of the children of Sextam, the humans who gave us genuine devotion."

# game/rutas/septem.rpy:687
translate ingles rutaseptem_84a66e1f:

    # septem "En el caos, reapareció Nulla, Y me puso al tanto de todo lo que tiene que ver con nuestro mundo y el creador..."
    septem "In the chaos, Nulla reappeared and filled me in on everything about our world and the Creator..."

# game/rutas/septem.rpy:688
translate ingles rutaseptem_a4a9882d:

    # septem "Luego, me enseñó de la existencia de otros mundos abandonados por el creador, en un estado igual al nuestro."
    septem "Then, he taught me of the existence of other worlds abandoned by the Creator, in a state equal to ours."

# game/rutas/septem.rpy:691
translate ingles rutaseptem_e4314c93:

    # septem "Pero la diferencia es que tenían humanos... Asi que nos implantamos en su cultura."
    septem "But the difference is that they had humans... so we implanted ourselves in their culture."

# game/rutas/septem.rpy:692
translate ingles rutaseptem_39807f1c:

    # septem "Y consumimos su devoción de manera directa, cada último domingo del mes."
    septem "And we consume their devotion directly, every last Sunday of the month."

# game/rutas/septem.rpy:695
translate ingles rutaseptem_5bc014a0:

    # septem "Pero contigo aquí no será necesario continuar con esto... si nos unimos en una transfusión, me consederás la autoridad de manipular el jardín a mí---"
    septem "But with you here, it will not be necessary to continue with that... if we join together in a transfusion, you will grant me the authority to manipulate the Garden to my--"

# game/rutas/septem.rpy:696
translate ingles rutaseptem_a2c4f2cb:

    # septem "no--- a nuestro antojo."
    septem "No--at our whim."

# game/rutas/septem.rpy:697
translate ingles rutaseptem_b35c89c4:

    # septem "¡Podemos salvar este mundo!"
    septem "We can save this world!"

# game/rutas/septem.rpy:698
translate ingles rutaseptem_a965f901:

    # septem "Y evitar que Nulla lo destruya todo."
    septem "And prevent Nulla from destroying everything."

# game/rutas/septem.rpy:701
translate ingles rutaseptem_bf3aa20a:

    # septem "...mira."
    septem "... Look."

# game/rutas/septem.rpy:702
translate ingles rutaseptem_eb24d18b:

    # septem "Nadie de los Estandartes sabe la triste verdad de que no somos más que un mundo que simula ser orgánico... lo único que saben es que nuestro mundo agoniza."
    septem "None of the Symbols knows the sad truth that we are nothing more than a world that pretends to be organic... all they know is that our world is dying."

# game/rutas/septem.rpy:703
translate ingles rutaseptem_38fccbcb:

    # septem "Para ti puede ser un juego, pero para mí y los míos es nuestro hogar."
    septem "To you, it may be a game, but for me and my people, it is our home."

# game/rutas/septem.rpy:704
translate ingles rutaseptem_86de1225:

    # septem "A pesar de que todo sea una mentira... quiero que ellos puedan vivir en las mejores condiciones, que el jardín pueda volver a ser lo que era antes."
    septem "Even though everything is a lie... I want them to live in the best conditions, for the Garden to return to what it once was."

# game/rutas/septem.rpy:705
translate ingles rutaseptem_1867c009:

    # septem "Quiero hacer todo lo posible para evitar lo inevitable..."
    septem "I want to do everything possible to avoid the inevitable..."

# game/rutas/septem.rpy:706
translate ingles rutaseptem_2fd2e95b:

    # septem "Ahora que lo sabes..."
    septem "Now that you know..."

# game/rutas/septem.rpy:709
translate ingles rutaseptem_e9fdea7c:

    # septem "¿Aceptas?"
    septem "Do you accept the deal?"

# game/rutas/septem.rpy:712
translate ingles rutaseptem_7a599ed3:

    # "Nulla quiere destruir todo... pero, ¿aceptar el trato de Septem es lo correcto?"
    "Nulla wants to destroy everything... but, is accepting Septem's deal the right thing to do?"

# game/rutas/septem.rpy:713
translate ingles rutaseptem_bd032d79:

    # "No parece ser tan malo como creías... tal vez es algo inadaptado... despues de todo él hace lo que cree que es correcto, siempre siguiendo la etiqueta y reglas pues eso es lo único que conoce."
    "He doesn't seem as bad as you thought... maybe he's just a bit misfit. After all, he does what he believes is right, always following etiquette and rules because that's all he knows."

# game/rutas/septem.rpy:714
translate ingles rutaseptem_393d8f54:

    # "Pero por otro lado..."
    "But on the other hand..."

# game/rutas/septem.rpy:715
translate ingles rutaseptem_06e2de65:

    # "Uhg..."
    "Uhg..."

# game/rutas/septem.rpy:722
translate ingles rutaseptem_fcf2b7ec:

    # "No puedes invocar su nombre..."
    "You cannot invoke his name..."

# game/rutas/septem.rpy:723
translate ingles rutaseptem_7dbd5d11:

    # "Imposible hacerlo sin una lengua...."
    "Its impossible to do it without your tongue..."

# game/rutas/septem.rpy:724
translate ingles rutaseptem_a19d9883:

    # "Por lo que solo tienes dos opciones"
    "So you only have two options."

# game/rutas/septem.rpy:739
translate ingles rutaseptem_2492ff5c:

    # "Aceptas indicando con la cabeza."
    "You accept by nodding your head."

# game/rutas/septem.rpy:740
translate ingles rutaseptem_23f847b1:

    # "Pues ya no puedes hablar por la falta de tu lengua."
    "You can no longer speak due to the lack of your tongue."

# game/rutas/septem.rpy:741
translate ingles rutaseptem_9eab044f:

    # "Aunque... ya no duele tanto."
    "Although... it doesn't hurt as much anymore."

# game/rutas/septem.rpy:744
translate ingles rutaseptem_26d36b6d:

    # nj "Acepto"
    nj "I accept."

# game/rutas/septem.rpy:747
translate ingles rutaseptem_4d1ca861:

    # "Septem te extiende la mano y tú la tomas firmemente."
    "Septem extends his hand to you and you take it firmly."

# game/rutas/septem.rpy:748
translate ingles rutaseptem_fdc27936:

    # "Sientes como una electricidad recorre tu cuerpo."
    "You feel like electricity is running through your body."

# game/rutas/septem.rpy:749
translate ingles rutaseptem_cd56f135:

    # "Y la sonrisa de Septem se hace más grande con cada segundo pasado."
    "And Septem's smile grows bigger with each passing second."

# game/rutas/septem.rpy:750
translate ingles rutaseptem_bd53e6ce:

    # septem "Empezaré con los preparativos."
    septem "I'll start with the preparations."

translate ingles strings:

    # game/rutas/septem.rpy:259
    old "Quedarte aquí y esperar"
    new "Stay here and wait."

    # game/rutas/septem.rpy:259
    old "Investigar la habitación"
    new "Investigate the room."

    # game/rutas/septem.rpy:259
    old "Salir de la habitación"
    new "Leave the room."

    # game/rutas/septem.rpy:337
    old "¿Tiempo para qué?"
    new "Time for what?"

    # game/rutas/septem.rpy:337
    old "Yo necesito que me expliques que está pasando"
    new "I need you to explain to me what's happening."

    # game/rutas/septem.rpy:337
    old "Basta harás lo que yo diga"
    new "Enough, just do what I say."

    # game/rutas/septem.rpy:408
    old "¿Necesitas a Nulla?"
    new "Do you need Nulla?"

    # game/rutas/septem.rpy:424
    old "Investigar las puertas."
    new "Investigate the doors."

    # game/rutas/septem.rpy:424
