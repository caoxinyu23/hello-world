# game/rutas/septem.rpy:1311
translate ingles rutaseptem_9a677332:
    # "{sc=3}Al momento de que Tria se esfumase, la habitación comienza a cambiar.{/sc}"
    "{sc=3}The moment Tria vanishes, the room begins to change.{/sc}"

# game/rutas/septem.rpy:1313
translate ingles rutaseptem_498bac31:
    # "{sc=3}Transformándose en el jardín del dominio de Septem...{/sc}"
    "{sc=3}Transforming into the Garden of Septem's domain...{/sc}"

# game/rutas/septem.rpy:1315
translate ingles rutaseptem_22d827f2:
    # "{sc=3}Y solo queda Septem y Sextam, junto conmigo.{/sc}"
    "{sc=3}And only Septem and Sextam remain, along with me.{/sc}"

# game/rutas/septem.rpy:1318
translate ingles rutaseptem_6d21feb8:
    # sextam "Septem, ¿podemos tener una reunión mañana?"
    sextam "Septem, can we have a meeting tomorrow?"

# game/rutas/septem.rpy:1320
translate ingles rutaseptem_e8202050:
    # septem "¿Por qué no ahora?"
    septem "Why not now?"

# game/rutas/septem.rpy:1323
translate ingles rutaseptem_b007b68a:
    # sextam "Debo ir a rezar a la iglesia..."
    sextam "I have to go pray at the church..."

# game/rutas/septem.rpy:1324
translate ingles rutaseptem_52fb4c4f:
    # septem "Ya no es necesario."
    septem "That's no longer necessary."

# game/rutas/septem.rpy:1325
translate ingles rutaseptem_c2acdfa1:
    # sextam "Septem..."
    sextam "Septem..."

# game/rutas/septem.rpy:1326
translate ingles rutaseptem_ac6b3f7c:
    # "{sc=3}Sextam mira dolida a Septem, y me gustaría saber el porqué.{/sc}"
    "{sc=3}Sextam looks at Septem with pain, and I wish I knew why.{/sc}"

# game/rutas/septem.rpy:1329
translate ingles rutaseptem_1fb87b84:
    # septem "Está bien. Mañana hablamos, pero iré yo a visitarte."
    septem "Alright. We'll talk tomorrow, but I'll come visit you."

# game/rutas/septem.rpy:1333
translate ingles rutaseptem_2f5a46d3:
    # "{sc=3}Sin decir nada más, Sextam baja la cabeza a modo de despedida.{/sc}"
    "{sc=3}Without saying another word, Sextam lowers her head in farewell.{/sc}"

# game/rutas/septem.rpy:1334
translate ingles rutaseptem_0bda2b3b:
    # "{sc=3}y sale caminando por la puerta.{/sc}"
    "{sc=3}And leaves, walking out the door.{/sc}"

# game/rutas/septem.rpy:1335
translate ingles rutaseptem_70646d49:
    # "{sc=3}... Hay un silencio entre ambos.{/sc}"
    "{sc=3}... There's silence between them.{/sc}"

# game/rutas/septem.rpy:1336
translate ingles rutaseptem_4a78b4cf:
    # "{sc=3}.......{/sc}........"
    "{sc=3}...............{/sc}"

# game/rutas/septem.rpy:1337
translate ingles rutaseptem_86223631:
    # "Septem te mira de reojo. Sientes como un peso te es quitado de encima, y te das cuenta de que es debido a que Septem ha recuperado su séptimo ojo."
    "Septem glances at you sideways. You feel as if a weight has been lifted off you, and you realize it's because Septem has regained his seventh eye."


# game/rutas/septem.rpy:1338
translate ingles rutaseptem_72049994:
    # "{sc=3}¡¿!? ¡[nombrejugador]!{/sc}"
    "{sc=3}What?! [nombrejugador]!{/sc}"

# game/rutas/septem.rpy:1339
translate ingles rutaseptem_f0baab31:
    # "{sc=3}Estás nuevamente vinculado conmigo.{/sc}"
    "{sc=3}You're bound to me once again.{/sc}"

# game/rutas/septem.rpy:1342
translate ingles rutaseptem_bf2e99c9:
    # "Septem se gira para mirarte de frente."
    "Septem turns to face you."

# game/rutas/septem.rpy:1345
translate ingles rutaseptem_f51a89c6:
    # septem "Bienvenido de vuelta [nombrejugador]."
    septem "Welcome back, [nombrejugador]."

# game/rutas/septem.rpy:1346
translate ingles rutaseptem_01be02f2:
    # "Él levanta la mano lentamente para tocarte la frente."
    "He slowly raises his hand to touch your forehead."

# game/rutas/septem.rpy:1347
translate ingles rutaseptem_bde6a814:
    # septem "Buenas noches [nombrejugador]. Nos vemos mañana."
    septem "Good night, [nombrejugador]. See you tomorrow."

# game/rutas/septem.rpy:1349
translate ingles rutaseptem_024f3a27_1:
    # "Y comienzas a ver borroso."
    "And your vision begins to blur."

# game/rutas/septem.rpy:1350
translate ingles rutaseptem_78c8bd45:
    # "Repentinamente dejas de escuchar el sonido tenue del ambiente."
    "Suddenly, you stop hearing the faint ambient sounds."

# game/rutas/septem.rpy:1353
translate ingles rutaseptem_a20cefa7_17:
    # "..."
    "..."

# game/rutas/septem.rpy:1354
translate ingles rutaseptem_0fd4d656_1:
    # "......"
    "......"

# game/rutas/septem.rpy:1357
translate ingles rutaseptem_7094308c:
    # "Los días transcurren lentamente en el dominio de Septem, donde lo único que puedes hacer es comer y dormir."
    "Days pass slowly in Septem's domain, where all you can do is eat and sleep."

# game/rutas/septem.rpy:1358
translate ingles rutaseptem_5e177062:
    # "Septem apenas interactúa contigo; prefiere pasar la mayor parte del tiempo en la biblioteca. Estás convencido de que lleva mucho tiempo sin dormir, y sospechas que mientras tú duermes, él continúa inmerso en sus lecturas."
    "Septem barely interacts with you; he prefers spending most of his time in the library. You're convinced he hasn't slept in ages, and you suspect that while you sleep, he remains absorbed in his reading."

# game/rutas/septem.rpy:1359
translate ingles rutaseptem_68127203:
    # "En las pocas ocasiones en las que lo has visto, has notado un cambio inquietante en su apariencia: sus manos están completamente negras."
    "In the few times you've seen him, you've noticed a disturbing change in his appearance: His hands are entirely black."

# game/rutas/septem.rpy:1360
translate ingles rutaseptem_f498cdad:
    # "Al igual que tus manos... y has perdido un poco de sensibilidad en la zona."
    "Just like your hands... and you've lost some sensation there."

# game/rutas/septem.rpy:1361
translate ingles rutaseptem_ee3cc6ae:
    # "{sc=3}¡Pero no hay nada de que preocuparse, [nombrejugador]! Estás manos aún sirven.{/sc}"
    "{sc=3}But there's nothing to worry about, [nombrejugador]! Your hands still work.{/sc}"

# game/rutas/septem.rpy:1362
translate ingles rutaseptem_a20cefa7_18:
    # "..."
    "..."

# game/rutas/septem.rpy:1365
translate ingles rutaseptem_e9b3a457:
    # "Te estás aburriendo."
    "You're getting bored."

# game/rutas/septem.rpy:1366
translate ingles rutaseptem_2de5633a:
    # "Necesitas hablar con Septem, ya sea para aclarar algunos asuntos pendientes o, quizás, simplemente para tener su compañía."
    "You need to speak with Septem, whether to resolve pending issues or simply for his company."

# game/rutas/septem.rpy:1367
translate ingles rutaseptem_5cc9dd44:
    # "Decidido aquello, te aventuras hacia la biblioteca, esta vez con la intención de enfrentarte a él directamente."
    "Having decided that, you head to the library, intent on facing him directly."

# game/rutas/septem.rpy:1369
translate ingles rutaseptem_b3a02726:
    # "Cuando llegas, lo encuentras con ambas manos sobre la cabeza, inmerso en su estrés."
    "When you arrive, you find him with his hands in his head, overwhelmed by stress."

# game/rutas/septem.rpy:1370
translate ingles rutaseptem_bb3ede6c:
    # "Es extraño verlo así. Es evidente que Septem está acostumbrado a tener el control de todo, y cualquier cosa que escape a su dominio parece consumirlo por completo."
    "It's odd to see him like this. It's clear that Septem is used to controlling everything, and anything beyond his grasp seems to overwhelm him."

# game/rutas/septem.rpy:1374
translate ingles rutaseptem_65b1196b:
    # "Golpeas suavemente la puerta entreabierta de la biblioteca. Septem levanta la mirada, fijando todos sus ojos en ti, con una expresión que, sin palabras, parece cuestionar qué deseas y por qué te atreves a interrumpirlo."
    "You gently knock on the ajar library door. Septem looks up, his gaze fixed on you, his expression silently questioning what you want and why you dare to interrupt him."

# game/rutas/septem.rpy:1375
translate ingles rutaseptem_3c884a16:
    # septem "Supongo que ha pasado bastante tiempo sin nada interesante, [nombrejugador]."
    septem "I suppose it's been a long time without anything interesting, [nombrejugador]."

# game/rutas/septem.rpy:1378
translate ingles rutaseptem_6efd8635:
    # "Intentas regresar sobre tus pasos, retrocediendo apenas dos cuando escuchas el sonido de una silla deslizándose."
    "You begin to retrace your steps, only taking a couple of steps back when you hear the sound of a chair sliding."

# game/rutas/septem.rpy:1380
translate ingles rutaseptem_1ab3f389:
    # septem "Si has llegado hasta aquí, es porque realmente deseas algo."
    septem "If you've made it this far, it's because you truly desire something."

# game/rutas/septem.rpy:1382
translate ingles rutaseptem_f69e98d8:
    # "Hace una pausa prolongada, como si evaluara tu presencia, y luego añade con una leve sonrisa"
    "He pauses for a prolonged moment, as if assessing your presence, then adds with a slight smile."

# game/rutas/septem.rpy:1383
translate ingles rutaseptem_d6d4731c:
    # septem "Adelante. Te concedo el permiso de pasar."
    septem "Go ahead. I grant you permission to proceed."

# game/rutas/septem.rpy:1384
translate ingles rutaseptem_ed4ea31e:
    # "¿Acaso no te dañará? ¿Sin huesos rotos o una muerte estúpidamente desmedida?"
    "Won't you get harmed? Broken bones or an outrageously disproportionate death?"

# game/rutas/septem.rpy:1385
translate ingles rutaseptem_1dd15331:
    # "No te lo crees."
    "You don't believe it."

# game/rutas/septem.rpy:1386
translate ingles rutaseptem_efe0b3f2:
    # "{sc=3}No me fío... deberíamos volver.{/sc}"
    "{sc=3}I don't trust it... we should go back.{/sc}"

# game/rutas/septem.rpy:1392
translate ingles rutaseptem_6095d050:
    # "Entras a la habitación a paso lento, cuidando cada movimiento, como si intentaras no hacer nada que pueda alterarlo."
    "You enter the room slowly, carefully controlling every movement so as not to disturb anything."

# game/rutas/septem.rpy:1393
translate ingles rutaseptem_4c37a5b3:
    # "Sin movimientos bruscos ni una caminata muy rápida o lenta."
    "No abrupt movements, and neither too fast nor too slow a pace."

# game/rutas/septem.rpy:1394
translate ingles rutaseptem_3192e160:
    # "Te acercas a su escritorio, pero dudas. ¿Deberías sentarte? La respuesta viene rápidamente a tu mente: no, no sin su permiso. Conoces bien la naturaleza del rubio. Desafiar sus reglas, aunque sea por descuido, podría traerte consecuencias graves."
    "You approach his desk but hesitate. Should you sit? The answer comes quickly: No, not without his permission. You know the nature of the blond well--defying his rules, even accidentally, could have serious consequences."

# game/rutas/septem.rpy:1395
translate ingles rutaseptem_9aa89d2e:
    # "No quieres morir por algo que fácilmente podrías haber evitado si prestaras más atención."
    "You don't want to die over something you could easily have avoided if you had been more attentive."

# game/rutas/septem.rpy:1396
translate ingles rutaseptem_4027b8ad:
    # septem "Siéntate."
    septem "Sit down."

# game/rutas/septem.rpy:1398
translate ingles rutaseptem_3bb5af65:
    # "Lo haces. Aunque por dentro no puedes evitar un leve resentimiento."
    "You do, though inside, you can't help but feel a slight resentment."

# game/rutas/septem.rpy:1399
translate ingles rutaseptem_e1a2e16b:
    # "{sc=3}¡A regañadientes!, si me permites agregar.{/sc}"
    "{sc=3}Reluctantly, if I may add.{/sc}"

# game/rutas/septem.rpy:1400
translate ingles rutaseptem_bfea6d18:
    # septem "Dime, ¿qué necesitas?"
    septem "Tell me, what do you need?"

# game/rutas/septem.rpy:1408
translate ingles rutaseptem_f608a0a0:
    # "Te acuestas en la cama pensando en que mañana será un día parecido a los que ya has tenido."
    "You lie in bed, thinking that tomorrow will probably be just another day like the ones you've already had."

# game/rutas/septem.rpy:1409
translate ingles rutaseptem_ee35835f:
    # "Tendrás que esperar a que Septem consiga lo que busca para poder hacer cosas más interesantes..."
    "You'll have to wait until Septem achieves his goal to do something more interesting..."

# game/rutas/septem.rpy:1410
translate ingles rutaseptem_10f64ccb:
    # "Por más que pasan las horas, no puedes conciliar el sueño..."
    "No matter how many hours pass, you can't fall asleep..."

# game/rutas/septem.rpy:1411
translate ingles rutaseptem_28dfc17a:
    # "Y te preguntas si será por la permanencia de la luz y la falta de oscuridad que no permite tener claro cuando es o no la hora de descansar."
    "And you wonder if it's due to the constant light and lack of darkness that makes it unclear when it's time to sleep."

# game/rutas/septem.rpy:1412
translate ingles rutaseptem_a20cefa7_19:
    # "..."
    "..."

# game/rutas/septem.rpy:1413
translate ingles rutaseptem_309e7bb0:
    # "Supones que darte una vuelta por el templo no haría mal."
    "You figure a stroll through the temple wouldn't hurt."

# game/rutas/septem.rpy:1414
translate ingles rutaseptem_0d8726c7:
    # "Tal vez si te mueves un poco, el sueño llegará tarde o temprano."
    "Perhaps if you move a bit, sleep will eventually come."

# game/rutas/septem.rpy:1416
translate ingles rutaseptem_832bf138:
    # "Recorres los pasillos del templo, evitando la biblioteca a toda costa, ya que realmente no quieres alterar más de la cuenta a Septem."
    "You wander the temple corridors, deliberately avoiding the library, because you really don't want to disturb Septem any further."

# game/rutas/septem.rpy:1417
translate ingles rutaseptem_e11302c2:
    # "...no quieres perder ninguna parte de tu cuerpo hoy."
    "... You don't want to lose any part of your body today."

# game/rutas/septem.rpy:1418
translate ingles rutaseptem_f01ea870:
    # "Al pasar cerca de la sala que tiene el altar escuchas murmullos."
    "As you pass by the altar room, you hear murmurs."

# game/rutas/septem.rpy:1419
translate ingles rutaseptem_922b2cb8:
    # "Crees escuchar la voz de Septem salir de ese lugar, se oye alterado."
    "You think it's Septem's voice, sounding agitated."

# game/rutas/septem.rpy:1420
translate ingles rutaseptem_ab1f4b6d:
    # "Te acercas para poder confirmar si realmente se trata de él."
    "You approach to see if it really is him."

# game/rutas/septem.rpy:1422
translate ingles rutaseptem_661c7861:
    # "Intentas ser lo más delicado posible con tus pasos y movimientos, para no perturbar el ambiente con tus pasos, que seguramente Septem podrá escuchar si son muy notorios."
    "You try to move as delicately as possible so as not to disturb the atmosphere, as he would surely notice any conspicuous sounds."

# game/rutas/septem.rpy:1423
translate ingles rutaseptem_faedadd2:
    # septem "{size=*0.7}...puede ser salvado. Me he estado esforzando para encontrar una solución.{/size}"
    septem "{size=*0.7}... it might be saved. I've been working hard to find a solution.{/size}"

# game/rutas/septem.rpy:1424
translate ingles rutaseptem_3309e476:
    # septem "{size=*0.7}Padre por favor... Todos estamos rezando por ti.{/size}"
    septem "{size=*0.7}Father, please... We're all praying for you.{/size}"

# game/rutas/septem.rpy:1425
translate ingles rutaseptem_7c836fde:
    # septem "{size=*0.7}Todos están pidiendo tu regreso.{/size}"
    septem "{size=*0.7}Everyone is asking for your return.{/size}"

# game/rutas/septem.rpy:1426
translate ingles rutaseptem_637edb9b:
    # septem "{size=*0.7}Sextam no está enojada porque te has llevado a sus humanos... y te prometo que Nulla se arrepiente de haberte hecho eso...{/size}"
    septem "{size=*0.7}Sextam isn't angry because you took her humans... and I promise that Nulla regrets having done that to you...{/size}"

# game/rutas/septem.rpy:1427
translate ingles rutaseptem_1376ba4d:
    # septem "{size=*0.7}No es nada personal contigo, es solo que, le recuerdas a...{/size}"
    septem "{size=*0.7}It's nothing personal with you, it's just that you remind him of...{/size}"

# game/rutas/septem.rpy:1429
translate ingles rutaseptem_9454f6d6:
    # "Asomas tu cabeza y ahí está el rubio..."
    "You peek your head out and there he is, the blond..."


# game/rutas/septem.rpy:1430
translate ingles rutaseptem_c108e9a4:

    # "Arrodillado frente al altar, con ambas manos juntas, como si suplicara. Ahora estando a esta distancia puedes discernir lo que significan esos murmullos."
    "Kneeling before the altar, with both hands clasped together as if supplicating. Now, from this distance, you can discern what those murmurs mean."

# game/rutas/septem.rpy:1431
translate ingles rutaseptem_a3fdcbc3:

    # "Es una vista tan extraña que te deja sin saber cómo reaccionar."
    "It's such a strange sight that you don't know how to react."

# game/rutas/septem.rpy:1432
translate ingles rutaseptem_31924e0f_7:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:1438
translate ingles rutaseptem_b479e220:

    # "Septem toma aire, meditando... y ahora mira al cielo, aún con las manos juntas, habla."
    "Septem takes a breath, meditating... and now, still with his hands clasped together, looks up at the sky and speaks."

# game/rutas/septem.rpy:1440
translate ingles rutaseptem_0472f1f5:

    # septem "{size=*0.7}No sé tu nombre, Nulla nunca me lo ha querido decir, pero por favor... manifiéstate{/size}"
    septem "{size=*0.7}I don't know your name, Nulla has never been willing to tell me, but please... manifest yourself.{/size}"

# game/rutas/septem.rpy:1441
translate ingles rutaseptem_eb0b8e4b:

    # septem "{size=*0.7}Yo sé que estás aquí, de algún modo u otro, lo estás.{/size}"
    septem "{size=*0.7}I know you're here, one way or another.{/size}"

# game/rutas/septem.rpy:1442
translate ingles rutaseptem_9125e05e:

    # septem "{size=*0.7}Entiendo que Padr- tu marioneta no quiera volver aquí, pero aún así lo extraño...{/size}"
    septem "{size=*0.7}I understand that Fa--... your puppet doesn't want to come back here, but I still miss it...{/size}"

# game/rutas/septem.rpy:1443
translate ingles rutaseptem_945216b1:

    # septem "{size=*0.7}Deseo verlo nuevamente y poder hablar con él para calmar mi corazón.{/size}"
    septem "{size=*0.7}I long to see him again and speak with him to soothe my heart.{/size}"

# game/rutas/septem.rpy:1444
translate ingles rutaseptem_6d80d828:

    # septem "{size=*0.7}Entiendo su odio a Nulla, y su condena...{/size}"
    septem "{size=*0.7}I understand his hatred for Nulla, and his condemnation...{/size}"

# game/rutas/septem.rpy:1445
translate ingles rutaseptem_a042a92b:

    # septem "{size=*0.7}Pero, ¿no crees que ya ha sido mucho?{/size}"
    septem "{size=*0.7}But don't you think that's too much already?{/size}"

# game/rutas/septem.rpy:1446
translate ingles rutaseptem_8f7edebb:

    # septem "{size=*0.7}Yo sé que puedes abolir lo que ha hecho el demiurgo y traerlo de vuelta...{/size}"
    septem "{size=*0.7}I know you can undo what the demiurge has done and bring him back...{/size}"

# game/rutas/septem.rpy:1447
translate ingles rutaseptem_0e8357a8:

    # septem "{size=*0.7}Yo sé que puedes hacer un montón de cosas.{/size}"
    septem "{size=*0.7}I know you can do a lot of things.{/size}"

# game/rutas/septem.rpy:1448
translate ingles rutaseptem_31924e0f_8:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:1449
translate ingles rutaseptem_c576bc8b:

    # septem "¡Prometo hacer las cosas bien esta vez! prometo no aburrirte, prometo cumplir con todo lo que tu marioneta pida, prometo ser tuyo."
    septem "I promise to do things right this time! I promise not to bore you, I promise to fulfill everything your puppet asks, I promise to be yours."

# game/rutas/septem.rpy:1450
translate ingles rutaseptem_344d1c6d:

    # septem "{size=*2.0}¡Prometo hacer las cosas bien esta vez!{/size}"
    septem "{size=*2.0}I promise to do things right this time!{/size}"

# game/rutas/septem.rpy:1451
translate ingles rutaseptem_3444381b:

    # septem "...con tal de que lo traigas de vuelta y nos dotes de una vida tranquila."
    septem "... As long as you bring him back and grant us a peaceful life."

# game/rutas/septem.rpy:1452
translate ingles rutaseptem_325f3184:

    # septem "No quiero cambios..."
    septem "I don't want any changes..."

# game/rutas/septem.rpy:1453
translate ingles rutaseptem_09aedc1c:

    # septem "Prefiero que todo vuelva a como era antes."
    septem "I prefer that everything goes back to the way it was before."

# game/rutas/septem.rpy:1454
translate ingles rutaseptem_a20cefa7_20:

    # "..."
    "..."

# game/rutas/septem.rpy:1455
translate ingles rutaseptem_c6f4f644:

    # "{sc=3}¿Qué mierda?{/sc}"
    "{sc=3}What the hell?{/sc}"

# game/rutas/septem.rpy:1456
translate ingles rutaseptem_42966c6e:

    # "{sc=3}Eso suena pátetico...{/sc}"
    "{sc=3}That sounds pathetic...{/sc}"

# game/rutas/septem.rpy:1457
translate ingles rutaseptem_ed008d29:

    # septem "Pero si no arreglas al Jardín me veré en la necesidad de reemplazarlo y reemplazarte a ti también... cambiar de dueño."
    septem "But if you don't fix the Garden, I'll be forced to replace it--and you, too... change its owner."

# game/rutas/septem.rpy:1458
translate ingles rutaseptem_d11cbfd7:

    # septem "[nombrejugador] parece ser un buen candidato."
    septem "[nombrejugador] seems to be a good candidate."

# game/rutas/septem.rpy:1459
translate ingles rutaseptem_40e2f5e0:

    # septem "Después de todo sigue aquí..."
    septem "After everything, they're still here..."

# game/rutas/septem.rpy:1460
translate ingles rutaseptem_bf6f3849:

    # septem "Podría darle el control y el derecho de todos dentro del Jardín."
    septem "I could give them control and the rights to everything within the Garden."

# game/rutas/septem.rpy:1461
translate ingles rutaseptem_88c94f48:

    # septem "Aunque signifique eliminar todo rastro de Padre y tuyo..."
    septem "Even if it means eliminating every trace of Father and yours..."

# game/rutas/septem.rpy:1462
translate ingles rutaseptem_336f93bc:

    # septem "Así que, por favor, manifiéstate si no quieres que lo haga..."
    septem "So, please, manifest yourself if you don't want me to do it..."

# game/rutas/septem.rpy:1463
translate ingles rutaseptem_f536ee97:

    # "Septem espera por un largo tiempo, pero no hay respuesta de ningún tipo."
    "Septem waits for a long time, but there is no response of any kind."

# game/rutas/septem.rpy:1464
translate ingles rutaseptem_36dd932c:

    # "Comprendiendo que ha sido ignorado, lentamente se levanta y observa la vela que está en la mesa ceremonial."
    "Realizing he has been ignored, he slowly rises and looks at the candle on the ceremonial table."

# game/rutas/septem.rpy:1465
translate ingles rutaseptem_10b9903e:

    # "Septem se levanta, y suspira mientras se arregla el cabello."
    "Septem rises and sighs as he fixes his hair."

# game/rutas/septem.rpy:1466
translate ingles rutaseptem_de50a7ab:

    # "Luego coloca ambas manos detrás de su espalda, para mirar en la dirección donde tú yaces escondido."
    "Then he places both hands behind his back, to look in the direction where you're hidden."

# game/rutas/septem.rpy:1468
translate ingles rutaseptem_52a607b5:

    # septem "¿Sabes que escuchar a escondidas es una falta tremenda de respeto?"
    septem "Do you know that eavesdropping is a tremendous sign of disrespect?"

# game/rutas/septem.rpy:1469
translate ingles rutaseptem_383adbff:

    # septem "Me has visto así, y eso no me gusta."
    septem "You've seen me like this, and I don't like it."

# game/rutas/septem.rpy:1470
translate ingles rutaseptem_d741e5da:

    # "Del susto caes sobre tu trasero..."
    "Startled, you fall onto your rear..."

# game/rutas/septem.rpy:1471
translate ingles rutaseptem_200631e6:

    # "Era obvio, era muy obvio que Septem sabría que te encuentras aquí."
    "It was obvious--very obvious--that Septem knows you're here."

# game/rutas/septem.rpy:1472
translate ingles rutaseptem_27e96024:

    # "Te arrastras hacia atrás cuando ves que Septem comienza a avanzar a paso lento, viniendo a donde te encuentras."
    "You crawl backwards when you see Septem beginning to advance slowly toward you."

# game/rutas/septem.rpy:1474
translate ingles rutaseptem_867ca1b4:

    # septem "¿Sabes? Creo que lo haces a propósito..."
    septem "You know? I think you do it on purpose..."

# game/rutas/septem.rpy:1475
translate ingles rutaseptem_2c7c4c30:

    # septem "Buscas estas instancias, ya sea para saber que pasará o porque te gusta ver como esta marioneta sufre."
    septem "You seek out these moments, either to know what will happen or because you enjoy watching this puppet suffer."

# game/rutas/septem.rpy:1476
translate ingles rutaseptem_d42b8502:

    # septem "No eres mejor que yo."
    septem "You're no better than me."

# game/rutas/septem.rpy:1477
translate ingles rutaseptem_11bb3b5d:

    # septem "Eres una entidad sádica."
    septem "You're a sadistic entity."

# game/rutas/septem.rpy:1478
translate ingles rutaseptem_3ac6dc30:

    # "Estás paralizado y no sabes si es por el miedo o porque Septem te ha inmovilizado de una u otra manera."
    "You're paralyzed, unsure if it's out of fear or because Septem has immobilized you in one way or another."

# game/rutas/septem.rpy:1480
translate ingles rutaseptem_bf5f0561:

    # "Los pies de Septem están peligrosamente cerca a tu mano izquierda..."
    "Septem's feet are dangerously close to your left hand..."

# game/rutas/septem.rpy:1481
translate ingles rutaseptem_61579f77:

    # septem "Es decir... a quién le gustaría ver..."
    septem "That is to say... one who would like to see..."

# game/rutas/septem.rpy:1483
translate ingles rutaseptem_cb44287c:

    # "Septem coloca su pie sobre tu mano, tocando el dorso de tu mano con la suela de su zapato con delicadeza... como su advirtiera de lo que hará."
    "Septem places his foot on your hand, gently brushing the back of your hand with the sole of his shoe... as if to warn you of what he'll do."

# game/rutas/septem.rpy:1484
translate ingles rutaseptem_472c5454:

    # septem "¿Esto?"
    septem "This?"

# game/rutas/septem.rpy:1485
translate ingles rutaseptem_e7d38aa1:

    # septem "Yo sinceramente creo que lo haces porque..."
    septem "I honestly believe you do it because..."

# game/rutas/septem.rpy:1486
translate ingles rutaseptem_600a9b17:

    # septem "No tiene ninguna consecuencia real en tu integridad, [nombrejugador]."
    septem "It doesn't have any real consequence on your integrity, [nombrejugador]."

# game/rutas/septem.rpy:1487
translate ingles rutaseptem_5b578ffb:

    # septem "No te importa lo que le pase a tu marioneta. Y, desafortunadamente, a mí tampoco."
    septem "You don't care what happens to your puppet. And, unfortunately, neither do I."

# game/rutas/septem.rpy:1488
translate ingles rutaseptem_aa4c6579:

    # septem "Fácilmente podría destrozar su mano. Después de todo, creo que ya no será tan necesaria en un futuro."
    septem "I could easily crush its hand. After all, I think it won't be so necessary in the future."

# game/rutas/septem.rpy:1489
translate ingles rutaseptem_2f5892ac:

    # septem "Pero hoy me siento misericordioso."
    septem "But today, I feel merciful."

# game/rutas/septem.rpy:1491
translate ingles rutaseptem_f5e91222:

    # "Septem ríe."
    "Septem laughs."

# game/rutas/septem.rpy:1492
translate ingles rutaseptem_ed60f859:

    # septem "La dinámica de poder entre tú y la marioneta me fascina. Ambos sabemos que la marioneta hará todo lo que tú le digas que haga."
    septem "The power dynamic between you and the puppet fascinates me. We both know that the puppet will do everything you tell it to do."

# game/rutas/septem.rpy:1493
translate ingles rutaseptem_f8971406:

    # septem "Entonces... ¿Qué harás?"
    septem "So... what will you do?"

# game/rutas/septem.rpy:1496
translate ingles rutaseptem_db4e59de:

    # septem "Ah, impresionante. Tienes algo de aprecio por ella, supongo."
    septem "Ah, impressive. I suppose you have some affection for them."

# game/rutas/septem.rpy:1498
translate ingles rutaseptem_e9f3ffa4:

    # "Septem se agacha y te toma por la mandíbula, obligándote a mirarle a los ojos. Lentamente se acerca, y por un momento piensas que te besará, pero sus labios se dirigen a tu oído, rozando tu piel."
    "Septem bends down and grabs you by the jaw, forcing you to look him in the eyes. He slowly approaches, and for a moment you think he will kiss you, but his lips move to your ear, brushing against your skin."

# game/rutas/septem.rpy:1499
translate ingles rutaseptem_345bba10:

    # septem "Me encantaría tener este poder sobre ti, [nombrejugador]."
    septem "I would love to have this power over you, [nombrejugador]."

# game/rutas/septem.rpy:1500
translate ingles rutaseptem_b020cf4c:

    # septem "Lástima que está fuera de mi alcance."
    septem "Too bad you're out of my reach."

# game/rutas/septem.rpy:1502
translate ingles rutaseptem_e05e88e6:

    # "Septem te suelta y se levanta."
    "Septem lets you go and stands up."

# game/rutas/septem.rpy:1503
translate ingles rutaseptem_63edd924:

    # septem "Vete de aquí y deja a tu marioneta descansar."
    septem "Get out of here and let your puppet rest."

# game/rutas/septem.rpy:1504
translate ingles rutaseptem_f87b9ec8:

    # "Cuando Septem deja el altar, recuperas el control de tu cuerpo."
    "When Septem leaves the altar, you regain control of your body."

# game/rutas/septem.rpy:1505
translate ingles rutaseptem_6be3ecdf:

    # "Sin pensartelo dos veces, vuelves a tu habitación."
    "Without a second thought, you return to your room."

# game/rutas/septem.rpy:1508
translate ingles rutaseptem_b067c36b:

    # septem "Nada..."
    septem "Nothing..."

# game/rutas/septem.rpy:1509
translate ingles rutaseptem_1881f20d:

    # septem "Wow, entonces realmente quieres verlo."
    septem "Wow, so you really want to see it."

# game/rutas/septem.rpy:1510
translate ingles rutaseptem_09f81009:

    # septem "Ja-"
    septem "Ha--"


# game/rutas/septem.rpy:1511
translate ingles rutaseptem_497e1042:

    # septem "Bueno, ¿quién soy yo sino un anfitrión intentando que la visita se sienta lo suficientemente cómoda como para quedarse?"
    septem "Well, who am I but a host, trying to make the guest feel comfortable enough to stay?"

# game/rutas/septem.rpy:1513
translate ingles rutaseptem_5dd02050:

    # "La presión sobre tu mano se intensifica, transformándose rápidamente en dolor. Septem aplica más peso y retuerce su suela sobre tu mano."
    "The pressure on your hand intensifies, quickly turning into pain. Septem applies more weight and twists the sole of his shoe against your hand."

# game/rutas/septem.rpy:1514
translate ingles rutaseptem_b2b3f86c:

    # "Tú al no poder moverte, solo lloras del dolor, y estás seguro que si pasa más tiempo, tus huesos se romperán..."
    "Unable to move, you can only cry out in pain, and you're sure that if more time passes, your bones will break..."

# game/rutas/septem.rpy:1515
translate ingles rutaseptem_a0477f6f:

    # "Si es que ya no se encuentran rotos."
    "If they're not already broken."

# game/rutas/septem.rpy:1517
translate ingles rutaseptem_a86b1b4b:

    # "Subes la mirada porque no aguantas mirar como tu mano es destrozada en cuestión de minutos."
    "You look up because you can't bear to watch your hand being destroyed in a matter of minutes."

# game/rutas/septem.rpy:1518
translate ingles rutaseptem_60d82482:

    # "Aunque con lo que te encuentras no es mucho mejor: La expresión de Septem es extraña. Tiene la mirada clavada en tus ojos y no en tus manos, como si buscara algo en ellos que aún no puede encontrar."
    "Although things aren't much better for you: Septem's expression is strange. His gaze is fixed on your eyes rather than your hands, as if searching for something in them that he still cannot find."

# game/rutas/septem.rpy:1519
translate ingles rutaseptem_68fff526:

    # "Está sonriendo más de lo normal y sus mejillas están levemente pintadas de rosa."
    "He is smiling more than usual, and his cheeks are slightly flushed with pink."

# game/rutas/septem.rpy:1521
translate ingles rutaseptem_ffb90bd3:

    # septem "No puedo creer que tenga control de un ser como tú. Lástima que solo se debe a que estás eternamente conectado a la marioneta."
    septem "I can't believe I have control over a being like you. It's a shame it's only because you're connected to the puppet."

# game/rutas/septem.rpy:1522
translate ingles rutaseptem_82ce225f:

    # septem "Me encantaría ver como realmente reaccionarias si te pasara esto de verdad..."
    septem "I would love to see how you would really react if this actually happened to you..."

# game/rutas/septem.rpy:1523
translate ingles rutaseptem_837bafad:

    # septem "¿Simplemente llorarías o lucharías contra mí?"
    septem "Would you just cry, or fight me?"

# game/rutas/septem.rpy:1524
translate ingles rutaseptem_f0c9f4f8:

    # "Septem ríe, eufórico."
    "Septem laughs, euphorically."

# game/rutas/septem.rpy:1525
translate ingles rutaseptem_c6c243f3:

    # septem "Un ser del plano superior, bajo mi poder."
    septem "A being from the higher plane, under my power."

# game/rutas/septem.rpy:1526
translate ingles rutaseptem_04837ee0:

    # septem "Ah~"
    septem "Ah~"

# game/rutas/septem.rpy:1527
translate ingles rutaseptem_54d7f96d:

    # "Crack, escuchas algo romperse... y sabes al instante que se trata de tu mano."
    "Crack, you hear something break... and you instantly know it's your hand."

# game/rutas/septem.rpy:1528
translate ingles rutaseptem_35d252b4:

    # "Él dolor es tan inmenso que pierdes el conocimiento al instante."
    "The pain is so immense that you lose consciousness instantly."

# game/rutas/septem.rpy:1531
translate ingles rutaseptem_a20cefa7_21:

    # "..."
    "..."

# game/rutas/septem.rpy:1532
translate ingles rutaseptem_0fd4d656_2:

    # "......"
    "......"

# game/rutas/septem.rpy:1534
translate ingles rutaseptem_f282f074:

    # "Pasan algunos días despues de eso y comienzas a ver algo extraño en Septem."
    "A few days pass after that, and you begin to notice something strange about Septem."

# game/rutas/septem.rpy:1535
translate ingles rutaseptem_de81fd81:

    # "Ahora el te evita lo más que puede. La biblioteca permanece permanentemente cerrada y cada vez que tocas la puerta, Septem te pide que te retires."
    "Now he avoids you as much as he can. The library remains permanently closed, and every time you knock on the door, Septem tells you to leave."

# game/rutas/septem.rpy:1536
translate ingles rutaseptem_90f6b08b:

    # "Pero lo extraño no es eso."
    "But that's not the strange part."

# game/rutas/septem.rpy:1537
translate ingles rutaseptem_ad5cbab0:

    # "Lo extraño es su tono de voz."
    "The strange thing is his tone of voice."

# game/rutas/septem.rpy:1538
translate ingles rutaseptem_86f27576:

    # "No es lo que te esperas y cada vez suena más débil y más bajo."
    "It's not what you expect, and it sounds weaker and lower with each passing moment."

# game/rutas/septem.rpy:1539
translate ingles rutaseptem_b4d92779:

    # "Y temes que en algún momento no obtengas respuesta."
    "And you fear that, at some point, you won't get a response."

# game/rutas/septem.rpy:1542
translate ingles rutaseptem_a6434137:

    # "Una mañana, eres levantado por Septem, quien se encuentra parado a los pies de la cama."
    "One morning, you are awakened by Septem, who is standing at the foot of the bed."

# game/rutas/septem.rpy:1543
translate ingles rutaseptem_e4d1059c:

    # "Sonriendo, pero ya no se ve tan angelical como antes..."
    "Smiling, but he no longer looks as angelic as before..."

# game/rutas/septem.rpy:1544
translate ingles rutaseptem_15bb1619:

    # "Tiene unas ojeras que parecen estar tatuadas con tinta negra en su cara... supones que no ha dormido en días."
    "He has dark circles that look as if they're tattooed onto his face in black ink... you suppose he hasn't slept in days."

# game/rutas/septem.rpy:1545
translate ingles rutaseptem_65e56f96:

    # "Tal vez muy ocupado leyendo y buscando lo que sea que está buscando en los libros de su biblioteca."
    "Perhaps he's been too busy reading and searching for whatever it is he seeks in the books of his library."

# game/rutas/septem.rpy:1548
translate ingles rutaseptem_b8771f30:

    # septem "Creo que ya sé cual es el problema."
    septem "I think I now know what the problem is."

# game/rutas/septem.rpy:1551
translate ingles rutaseptem_933a5dc4:

    # "¿? ¿De que está hablando?"
    "Huh? What is he talking about?"

# game/rutas/septem.rpy:1554
translate ingles rutaseptem_5d022a39:

    # septem "La identidad de tu marioneta no me deja hacer el vínculo."
    septem "The identity of your puppet prevents me from establishing the bond."

# game/rutas/septem.rpy:1555
translate ingles rutaseptem_3af035b2:

    # septem "Necesitamos un cuerpo completamente vacío para unirnos."
    septem "We need a completely empty body to join."

# game/rutas/septem.rpy:1558
translate ingles rutaseptem_1a2ce4c1:

    # "No puedes empezar con esta locura desde tan temprano, por favor..."
    "You can't start this madness so early, please..."

# game/rutas/septem.rpy:1559
translate ingles rutaseptem_7e4b1b04:

    # "Ni siquiera has podido tomar tu desayuno y Septem ya ha empezado con sus payasadas."
    "You haven't even had your breakfast, and Septem has already begun his antics."

# game/rutas/septem.rpy:1560
translate ingles rutaseptem_1354a41d:

    # "Aunque estás agradecido de que no te esté comandando con es vox tan dura que pone cuando lo hace... hoy no, hoy se le ve ansioso y angustiado."
    "Although you're grateful he isn't commanding you in that harsh tone he usually uses... not today. Today, he appears anxious and distressed."

# game/rutas/septem.rpy:1563
translate ingles rutaseptem_92926560:

    # septem "Tenemos que hacerlo ahora."
    septem "We have to do it now."

# game/rutas/septem.rpy:1564
translate ingles rutaseptem_75b9932c:

    # septem "Vamos."
    septem "Let's go."

# game/rutas/septem.rpy:1566
translate ingles rutaseptem_b9074cb1:

    # "Esta vez Septem no los teletransporta al destino, sino que prefiere caminar..."
    "This time, Septem doesn't teleport you to your destination; instead, he prefers to walk..."

# game/rutas/septem.rpy:1567
translate ingles rutaseptem_82b69e5b:

    # "Pero su modo de caminar es lento, como si le costara o doliera moverse."
    "But his way of walking is slow, as if he struggles or feels pain when moving."

# game/rutas/septem.rpy:1568
translate ingles rutaseptem_a20cefa7_22:

    # "..."
    "..."

# game/rutas/septem.rpy:1569
translate ingles rutaseptem_7ebbd610:

    # "...A este paso llegarán mañana."
    "... At this rate, you'll arrive there tomorrow."

# game/rutas/septem.rpy:1573
translate ingles rutaseptem_dc7cbe70:

    # "Septem pausa su caminata y gira su cabeza para observarte."
    "Septem pauses his walk and turns his head to look at you."

# game/rutas/septem.rpy:1574
translate ingles rutaseptem_cbdf55cd:

    # "Sus cejas se fruncen sellando tu destino... no debiste preguntar eso."
    "His brows furrow, sealing your fate... you shouldn't have asked that."

# game/rutas/septem.rpy:1576
translate ingles rutaseptem_cf9228fc:

    # septem "¿Piensas ayudarme?"
    septem "Do you intend to help me?"

# game/rutas/septem.rpy:1577
translate ingles rutaseptem_d06bfa74:

    # "Por una fracción de segundo puedes notar que sus cejas se elevan, evocando una expresión que jamás te habrías imaginado ver."
    "For a fraction of a second, you notice his eyebrows rising, evoking an expression you never would have imagined seeing."

# game/rutas/septem.rpy:1579
translate ingles rutaseptem_8af72d3c:

    # "se ve vulnerable..."
    "He looks vulnerable..."

# game/rutas/septem.rpy:1580
translate ingles rutaseptem_a880ad74:

    # "Aunque esa mirada es borrada de manera casi instantánea."
    "Although that look is almost instantly erased."

# game/rutas/septem.rpy:1582
translate ingles rutaseptem_688a5035:

    # septem "¿A mí?"
    septem "Me?"


# game/rutas/septem.rpy:1583
translate ingles rutaseptem_1e20bf1d:

    # "Pregunta como si no se lo creyera."
    "He asks as if he didn't believe it."

# game/rutas/septem.rpy:1587
translate ingles rutaseptem_31924e0f_9:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:1588
translate ingles rutaseptem_540d2def:

    # "Septem no responde de manera verbal. Simplemente cierra los ojos e inhala por la nariz antes de acercarse más a ti."
    "Septem does not respond verbally. He simply closes his eyes and inhales through his nose before drawing closer to you."

# game/rutas/septem.rpy:1589
translate ingles rutaseptem_b483d0a4:

    # "Pero no se digna a darte más que aquello, pues opta por esperar a que tú reacciones y lo aceptes."
    "But he deigns not to give you anything more than that, choosing instead to wait for you to react and accept it."

# game/rutas/septem.rpy:1590
translate ingles rutaseptem_e8a09e31:

    # "Se le ve incómodo, se nota que no le gusta la posición en que se encuentra ahora."
    "He looks uncomfortable; it's clear he doesn't like the position he's in."

# game/rutas/septem.rpy:1591
translate ingles rutaseptem_7a6f876f:

    # "Vulnerable y sin otra opción que depender de ti."
    "Vulnerable and with no choice but to depend on you."

# game/rutas/septem.rpy:1592
translate ingles rutaseptem_c5b1d16c:

    # "Con movimientos pausados y asegurándote de mostrarle tus manos en todo momento, Septem te observa con atención. Lentamente, colocas uno de tus brazos alrededor de su cintura."
    "With slow movements and making sure to show him your hands at all times, Septem watches you intently. Slowly, you wrap one of your arms around his waist."

# game/rutas/septem.rpy:1593
translate ingles rutaseptem_d279d11c:

    # "Y eso es todo lo que necesita el rubio para tensar su cuerpo."
    "And that's all the blond needs to tense his body."

# game/rutas/septem.rpy:1594
translate ingles rutaseptem_e19b2f6d:

    # septem "Ugh."
    septem "Ugh."

# game/rutas/septem.rpy:1595
translate ingles rutaseptem_d62b5b86:

    # "Septem coloca su mano encima de la tuya, y la aprieta débilmente, como si dudara en que hacer a continuación."
    "Septem places his hand on top of yours and squeezes it weakly, as if unsure of what to do next."

# game/rutas/septem.rpy:1596
translate ingles rutaseptem_e32f9c36:

    # "Intuyes que no está acostumbrado al contacto con otro cuerpo... o quizás siente algún tipo de dolor."
    "You sense that he is not accustomed to physical contact... or perhaps he feels some kind of pain."

# game/rutas/septem.rpy:1597
translate ingles rutaseptem_7dbb4f36:

    # "Pero si le doliera, ni siquiera dejaría que lo tocases."
    "But if it hurt him, he wouldn't even let you touch him."

# game/rutas/septem.rpy:1598
translate ingles rutaseptem_e87c5670_2:

    # septem "No."
    septem "No."

# game/rutas/septem.rpy:1599
translate ingles rutaseptem_cc6d835b:

    # septem "Suéltame."
    septem "Let me go."

# game/rutas/septem.rpy:1600
translate ingles rutaseptem_c0ca2fc1:

    # "Sin más se suelta de tu agarre y en el proceso se dobla el tobillo al pisar mal."
    "Without further ado, he releases your grasp, and in the process, his ankle twists from a misstep."

# game/rutas/septem.rpy:1601
translate ingles rutaseptem_46fa28c1:

    # "Si no fuera por sus reflejos, ya estaría en el suelo."
    "If it weren't for his reflexes, he would already be on the ground."

# game/rutas/septem.rpy:1602
translate ingles rutaseptem_c132a67d:

    # "Tú solo lo observas, se siente extraño verlo sin esa gracia que siempre transmite en sus movimientos."
    "You simply stare at him. It feels strange to see him without that grace he usually exudes in his movements."

# game/rutas/septem.rpy:1603
translate ingles rutaseptem_fb3271fd:

    # "Y como si no hubiera pasado nada, Septem junta ambas manos."
    "And as if nothing had happened, Septem brings his hands together."

# game/rutas/septem.rpy:1609
translate ingles rutaseptem_20922415:

    # "Septem suelta una pequeña risa para luego suspirar con pesadez, como si le doliera hacerlo."
    "Septem lets out a small laugh, then sighs heavily, as if it hurts him to do so."

# game/rutas/septem.rpy:1610
translate ingles rutaseptem_1875de54:

    # "Sin decir nada, junta ambas manos."
    "Without saying a word, he brings his hands together."

# game/rutas/septem.rpy:1615
translate ingles rutaseptem_a20cefa7_23:

    # "..."
    "..."

# game/rutas/septem.rpy:1616
translate ingles rutaseptem_a888206f:

    # "Lo miras caminar lentamente, por cada paso que das tienes que pausar por unos segundos para no adelantar a Septem."
    "You watch him walk slowly, and with every step you have to pause for a few seconds so as not to outpace Septem."

# game/rutas/septem.rpy:1617
translate ingles rutaseptem_a44a12ee:

    # "Sus pies tiemblan con cada contacto que tienen con el piso, como si peligraran en doblarse."
    "His feet tremble with every contact with the floor, as if they were in danger of buckling."

# game/rutas/septem.rpy:1618
translate ingles rutaseptem_42d0fa91:

    # "No están avanzando nada."
    "No progress is being made."

# game/rutas/septem.rpy:1619
translate ingles rutaseptem_08bcc9d3:

    # "Y Septem también se ha dado cuenta de eso."
    "And Septem has also noticed that."

# game/rutas/septem.rpy:1620
translate ingles rutaseptem_4c40221d:

    # "Suspirando pesadamente, junta ambas manos."
    "Sighing heavily, he brings his hands together."

# game/rutas/septem.rpy:1623
translate ingles rutaseptem_008b9a94:

    # "Al hacerlo, ambos son teletransportados."
    "In doing so, both of you are teleported."

# game/rutas/septem.rpy:1625
translate ingles rutaseptem_af86384f:

    # "Aparecen en la sala del altar. Pero no alcanzas a inspeccionar, pues ves como Septem cae al suelo."
    "You both appear in the altar room. But you don't get a chance to inspect anything, as you see Septem fall to the ground."

# game/rutas/septem.rpy:1626
translate ingles rutaseptem_62b18882:

    # "Mientras lo observas allí, patéticamente en el suelo, escuchas cómo tose... e intenta aclarase la garganta."
    "As you watch him there, pathetically on the ground, you hear him cough... and try to clear his throat."

# game/rutas/septem.rpy:1627
translate ingles rutaseptem_31924e0f_10:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:1628
translate ingles rutaseptem_088f3ed3:

    # "Cuando ya no tiene nada más que toser, Septem se queda congelado."
    "Once he has nothing left to cough up, Septem freezes."

# game/rutas/septem.rpy:1629
translate ingles rutaseptem_56cfe502:

    # "Sinceramente crees que debe sentir algún grado de vergüenza. Vergüenza que lo vean en ese estado, tan humano."
    "You truly believe he must feel some degree of shame at being seen in such a state, so human."

# game/rutas/septem.rpy:1630
translate ingles rutaseptem_f34ad498:

    # "{sc=3}Ohh- se siente liberardo verlo así.{/sc}"
    "{sc=3}Ohh--it feels liberating to see him like this.{/sc}"

# game/rutas/septem.rpy:1631
translate ingles rutaseptem_3eddc6ea:

    # septem "Disculpa, este cuerpo ya no aguanta más."
    septem "Sorry, this body can't take it anymore."

# game/rutas/septem.rpy:1635
translate ingles rutaseptem_9f6c5da5:

    # "Se levanta con dificultad y te dedica una mirada rápida."
    "He rises with difficulty and gives you a quick glance."

# game/rutas/septem.rpy:1638
translate ingles rutaseptem_5c3cac98:

    # septem "Ja."
    septem "Ha."

# game/rutas/septem.rpy:1639
translate ingles rutaseptem_6d3babab:

    # "Hay rastros de sangre en sus labios y barbilla."
    "There are traces of blood on his lips and chin."

# game/rutas/septem.rpy:1640
translate ingles rutaseptem_8516013b:

    # "Es grave."
    "It's serious."

# game/rutas/septem.rpy:1641
translate ingles rutaseptem_ba284de7:

    # "Verlo sangrar es tan bizarro como pensar en que Septem puede llegar a morir..."
    "Seeing him bleed is as bizarre as thinking that Septem might actually die..."

# game/rutas/septem.rpy:1642
translate ingles rutaseptem_1c5756bc:

    # "¿Siquiera puede morir?"
    "Can he even die?"

# game/rutas/septem.rpy:1643
translate ingles rutaseptem_04962f91:

    # "Puede que su cuerpo físico sí..."
    "Perhaps his physical body can..."

# game/rutas/septem.rpy:1645
translate ingles rutaseptem_b6ea8138:

    # "Él como puede, se encamina a la vela que decora la mesa ceremonial del altar."
    "As best as he can, he makes his way to the candle that adorns the ceremonial altar table."

# game/rutas/septem.rpy:1646
translate ingles rutaseptem_ce8a81bb:

    # "Toca la cúpula, dedicándole una mirada solemne."
    "He touches the dome, giving it a solemn look."

# game/rutas/septem.rpy:1647
translate ingles rutaseptem_98d2cfaf:

    # "Como si quisiera sentir su calor de cerca."
    "As if he wanted to feel its warmth up close."

# game/rutas/septem.rpy:1648
translate ingles rutaseptem_63edc880:

    # septem "La respuesta siempre estuvo aquí..."
    septem "The answer was always here..."

# game/rutas/septem.rpy:1649
translate ingles rutaseptem_bdc8d5f4:

    # septem "Es parte de Padre, su carne está aquí."
    septem "It is part of Father; his flesh is here."

# game/rutas/septem.rpy:1650
translate ingles rutaseptem_c2d95d13:

    # septem "Material de un dios primordial."
    septem "Material of a primordial god."

# game/rutas/septem.rpy:1651
translate ingles rutaseptem_6ef4fd68:

    # septem "La utilizaremos para hacer un cuerpo completamente divino."
    septem "We will use it to create a completely divine body."

# game/rutas/septem.rpy:1654
translate ingles rutaseptem_8481efbb:

    # "Septem te ofrece la mano y espera tu respuesta."
    "Septem offers you his hand and awaits your response."

# game/rutas/septem.rpy:1655
translate ingles rutaseptem_38e1ac83:

    # septem "Sé que tienes muchas dudas aún, pero te prometo que cuando nos juntemos sabrás todo."
    septem "I know you still have many doubts, but I promise that when we join together, you will know everything."

# game/rutas/septem.rpy:1659
translate ingles rutaseptem_d59179c8:

    # septem "Sin la necesidad de que te lo explique."
    septem "Without the need for me to explain it to you."

# game/rutas/septem.rpy:1663
translate ingles rutaseptem_f70642f8:

    # septem "Verás todo desde mis ojos."
    septem "You will see everything through my eyes."

# game/rutas/septem.rpy:1664
translate ingles rutaseptem_b61de944:

    # septem "Seremos uno solo y dejaremos estos cuerpos finitos."
    septem "We will become one and leave behind these finite bodies."

# game/rutas/septem.rpy:1671
translate ingles rutaseptem_675d9137:

    # septem "El mío recuperará su individualidad..."
    septem "Mine will regain its individuality..."

# game/rutas/septem.rpy:1672
translate ingles rutaseptem_c6214803:

    # septem "El tuyo, lamentablemente tendrá que morir. No puedo arriesgar que algo de la procedencia de Nulla camine por el Jardín."
    septem "Yours, unfortunately, will have to die. I cannot risk any trace of Nulla's walking through the Garden."

# game/rutas/septem.rpy:1675
translate ingles rutaseptem_d6dc0975:

    # "{sc=3}¿Qué?{/sc}"
    "{sc=3}What?{/sc}"

# game/rutas/septem.rpy:1676
translate ingles rutaseptem_7e519b56:

    # nj "¿Supones que soy de Nulla? estás equivocado, ¡yo solo le sirvo a [nombrejugador]!"
    nj "Do you suppose I'm from Nulla? You're mistaken, I only serve [nombrejugador]!"

# game/rutas/septem.rpy:1679
translate ingles rutaseptem_2ab7104e:

    # septem "No supongo. Lo sé."
    septem "I don't suppose; I know it."

# game/rutas/septem.rpy:1680
translate ingles rutaseptem_e1f3ceeb:

    # septem "Mi ojo lo ha sentido cuando lo vinculé contigo."
    septem "My eye sensed it when I bonded with you."

# game/rutas/septem.rpy:1681
translate ingles rutaseptem_2fcf40ef:

    # septem "Él tiene acceso a ti, y una vez que poses tus ojos en él."
    septem "He has access to you, and once you set your eyes on him."

# game/rutas/septem.rpy:1682
translate ingles rutaseptem_0268de42:

    # septem "Será el principio del fin."
    septem "It will be the beginning of the end."

# game/rutas/septem.rpy:1683
translate ingles rutaseptem_8372c869:

    # septem "Debes dejar a [nombrejugador]."
    septem "You must let go of [nombrejugador]."

# game/rutas/septem.rpy:1686
translate ingles rutaseptem_355d11c4:

    # "{sc=3}No... [nombrejugador], no me hagas esto{/sc}"
    "{sc=3}No... [nombrejugador], don't do this to me!{/sc}"


# game/rutas/septem.rpy:1687
translate ingles rutaseptem_754e9b6b:

    # "Septem te mira en silencio."
    "Septem looks at you in silence."

# game/rutas/septem.rpy:1690
translate ingles rutaseptem_a20cefa7_24:

    # "..."
    "..."

# game/rutas/septem.rpy:1693
translate ingles rutaseptem_c79b4fc9:

    # septem "¿Te importa la marioneta?..."
    septem "Do you care about the puppet?..."

# game/rutas/septem.rpy:1698
translate ingles rutaseptem_31924e0f_11:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:1699
translate ingles rutaseptem_af7374be:

    # septem "......"
    septem "......"

# game/rutas/septem.rpy:1702
translate ingles rutaseptem_0d5e334f:

    # septem "Tal vez... podamos pensar en algo."
    septem "Maybe... we can think of something."

# game/rutas/septem.rpy:1708
translate ingles rutaseptem_73bbfdd5:

    # septem "No puedo arriesgar al Jardín."
    septem "I cannot risk the Garden."

# game/rutas/septem.rpy:1709
translate ingles rutaseptem_30bee673:

    # septem "Admiro lo leal que es tu marioneta a ti, pero..."
    septem "I admire how loyal your puppet is to you, but..."

# game/rutas/septem.rpy:1710
translate ingles rutaseptem_3830a537:

    # septem "No sé si Nulla pueda tomar control de ella."
    septem "I don't know if Nulla can take control of it."

# game/rutas/septem.rpy:1711
translate ingles rutaseptem_872d1e55:

    # septem "Prefiero evitar futuros problemas..."
    septem "I prefer to avoid future problems..."

# game/rutas/septem.rpy:1715
translate ingles rutaseptem_b1a2163c:

    # "Septem comienza a toser nuevamente."
    "Septem begins to cough again."

# game/rutas/septem.rpy:1716
translate ingles rutaseptem_e649b071:

    # septem "Debemos apurarnos, sino él morirá."
    septem "We must hurry, or he will die."

# game/rutas/septem.rpy:1717
translate ingles rutaseptem_718e6a41:

    # "¿Se refiera a su marioneta?"
    "Is he referring to his puppet?"

# game/rutas/septem.rpy:1719
translate ingles rutaseptem_78822429:

    # septem "Dame la mano."
    septem "Give me your hand."

# game/rutas/septem.rpy:1720
translate ingles rutaseptem_79720257:

    # "Tomas su mano con fuerza y Septem comienza a recitar cánticos con palabras que no puedes comprender."
    "You grasp his hand tightly and Septem begins to recite chants in words you cannot understand."

# game/rutas/septem.rpy:1721
translate ingles rutaseptem_9baddf07:

    # septem "{b}Pater, hoc sacro corpore ultimam voluntatem meam implebo ad novam aetatem sine tua praesentia nec damnatione.{/b}"
    septem "{b}Father, with this sacred body I shall fulfill my ultimate will for a new age without your presence or condemnation.{/b}"

# game/rutas/septem.rpy:1722
translate ingles rutaseptem_8dc1d5eb:

    # septem "{b}Utrasque animas accipiam et in unam coalescam, divinum esse in corpore et anima creando.{/b}"
    septem "{b}I will take both souls and merge them into one, creating the divine being in body and soul.{/b}"

# game/rutas/septem.rpy:1723
translate ingles rutaseptem_650b5226:

    # septem "{b}Et dimítte nobis offénsa nostra...{/b}"
    septem "{b}And forgive us our trespasses...{/b}"

# game/rutas/septem.rpy:1732
translate ingles rutaseptem_286eeb5f:

    # "Algo en la sala cambia. El lugar poco a poco va desapareciendo, dejando a su paso un blanco absoluto."
    "Something in the room changes. The space gradually disappears, leaving behind an absolute white."

# game/rutas/septem.rpy:1733
translate ingles rutaseptem_c2098168:

    # "Donde solo estás tú, Septem y la vela."
    "Where only you, Septem, and the candle remain."

# game/rutas/septem.rpy:1734
translate ingles rutaseptem_bd369ff2:

    # "Poco a poco ese blanco comienza a mutar."
    "Gradually, that white begins to mutate."

# game/rutas/septem.rpy:1735
translate ingles rutaseptem_459cbf51:

    # "Dando vida a pequeños destellos de luz y polvo."
    "Giving rise to small flashes of light and dust."

# game/rutas/septem.rpy:1736
translate ingles rutaseptem_bb37da88:

    # "La vela va aumentando su forma con cada minuto que pasa, se extiende de manera anormal."
    "The candle expands its form with each passing minute, stretching out abnormally."

# game/rutas/septem.rpy:1738
translate ingles rutaseptem_6141596f:

    # "Buscando una forma... buscando una figura."
    "Searching for a form... searching for a figure."

# game/rutas/septem.rpy:1739
translate ingles rutaseptem_5879cb55:

    # "Buscando la forma perfecta de un cuerpo humano."
    "Searching for the perfect form of a human body."

# game/rutas/septem.rpy:1740
translate ingles rutaseptem_2818de66:

    # septem "{b}Transfíge óculos huius entitátis maióris in novum corpus.{/b}"
    septem "{b}Transfer the eyes of this greater entity into a new body.{/b}"

# game/rutas/septem.rpy:1742
translate ingles rutaseptem_8f1f08f4:

    # "Sientes un dolor intenso en los ojos. Como si los presionaran contra tu craneo."
    "You feel an intense pain in your eyes, as if they were being pressed against your skull."

# game/rutas/septem.rpy:1743
translate ingles rutaseptem_cacba5ad:

    # "Como si los quemaran."
    "As if they were burned."

# game/rutas/septem.rpy:1744
translate ingles rutaseptem_74cead2f:

    # "Como si los arrancaran a la fuerza."
    "As if they were being torn out by force."

# game/rutas/septem.rpy:1745
translate ingles rutaseptem_f1e6ce0b:

    # septem "{b}Transfíge essentiam meam in hic novum corpus.{/b}"
    septem "{b}Transfer my essence into this new body.{/b}"

# game/rutas/septem.rpy:1746
translate ingles rutaseptem_7e369b16:

    # septem "{b}Sine ut unus simus.{/b}"
    septem "{b}And let us become one.{/b}"

# game/rutas/septem.rpy:1748
translate ingles rutaseptem_c2dc5fbe:

    # "Dejas de ver."
    "You stop seeing."

# game/rutas/septem.rpy:1749
translate ingles rutaseptem_30870b06:

    # "Dejas de escuchar."
    "You stop hearing."

# game/rutas/septem.rpy:1751
translate ingles rutaseptem_ccde7f29:

    # "Todo se vuelve negro."
    "Everything turns black."


# game/rutas/septem.rpy:1752
translate ingles rutaseptem_88b7fe5b:

    # "---------"
    "---------"

# game/rutas/septem.rpy:1753
translate ingles rutaseptem_924f12d3:

    # "................."
    "..................."

# game/rutas/septem.rpy:1754
translate ingles rutaseptem_551ad45d:

    # "......................."
    "............................."

# game/rutas/septem.rpy:1755
translate ingles rutaseptem_d099e177:

    # ell "¿Septem?"
    ell "... Septem?"

# game/rutas/septem.rpy:1757
translate ingles rutaseptem_94acaf39:

    # "FIN DEL ACTO 2."
    "END OF ACT 2."

# game/rutas/septem.rpy:1759
translate ingles rutaseptem_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2} You'll have to wait a while to find out how this ends... :3{/sc}"

translate ingles strings:

    # game/rutas/septem.rpy:783
    old "¿Por qué hablas conmigo?"
    new "Why do you speak to me?"

    # game/rutas/septem.rpy:798
    old "¿Te han condenado?"
    new "Have you been condemned?"

    # game/rutas/septem.rpy:858
    old "Te extraño..."
    new "I miss you..."

    # game/rutas/septem.rpy:858
    old "Por favor no destruyas esta ruta..."
    new "Please, do not destroy this route..."

    # game/rutas/septem.rpy:895
    old "Esperar hasta la cena."
    new "Wait until dinner."

    # game/rutas/septem.rpy:944
    old "¿No has dormido?"
    new "Haven't you slept?"

    # game/rutas/septem.rpy:944
    old "No sé que hacer..."
    new "I don't know what to do..."

    # game/rutas/septem.rpy:944
    old "Quiero salir al jardín."
    new "I want to go out to the garden."

    # game/rutas/septem.rpy:971
    old "¿No me puedo quedar aquí?"
    new "Can't I stay here?"

    # game/rutas/septem.rpy:1044
    old "¿A mí?"
    new "Me?"

    # game/rutas/septem.rpy:1044
    old "¿A la marioneta?"
    new "The puppet?"

    # game/rutas/septem.rpy:1363
    old "Buscar a Septem"
    new "Search for Septem."

    # game/rutas/septem.rpy:1363
    old "Ir a dormir"
    new "Go to sleep."

    # game/rutas/septem.rpy:1371
    old "Hacerte notar."
    new "Make yourself noticed."

    # game/rutas/septem.rpy:1371
    old "Retirarte."
    new "Retreat."

    # game/rutas/septem.rpy:1387
    old "No entrar"
    new "Do not enter."

    # game/rutas/septem.rpy:1387
    old "Entrar"
    new "Enter."

    # game/rutas/septem.rpy:1433
    old "Volver a tu habitación..."
    new "Return to your room..."

    # game/rutas/septem.rpy:1433
    old "Quedarte y escuchar."
    new "Stay and listen."

    # game/rutas/septem.rpy:1494
    old "Proteger a la marioneta."
    new "Protect the puppet."

    # game/rutas/septem.rpy:1570
    old "Preguntar si necesita ayuda."
    new "Ask if he needs help."

    # game/rutas/septem.rpy:1570
    old "Seguir caminando."
    new "Keep walking."

    # game/rutas/septem.rpy:1584
    old "Puedes apoyarte en mí si lo necesitas."
    new "You can lean on me if you need to."

    # game/rutas/septem.rpy:1584
    old "Disculparse por preguntar aquello."
    new "Apologize for asking that."

    # game/rutas/septem.rpy:1667
    old "¿Qué les pasará a los cuerpos?"
    new "What will happen to the bodies?"

    # game/rutas/septem.rpy:1688
    old "¡Tienes que hacer algo para dejarlo vivir!"
    new "You have to do something to let them live!"

    # game/rutas/septem.rpy:1694
    old "Por favor, yo te estoy ayudando. No dejes que muera."
    new "Please, I'm trying to help you. Don't let them die."

