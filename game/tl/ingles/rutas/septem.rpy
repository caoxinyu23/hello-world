# game/rutas/septem.rpy:2935
translate ingles continuacion3_3462b4ba:

    # septem "A tu izquierda debería estar mi regalo, ve si lo puedes encontrar y ocuparlo."
    septem "My gift should be on your left. See if you can find and use it."

# TODO: Translation updated at 2026-10-18 18:06

# game/rutas/septem.rpy:385
translate ingles rutaseptem_d40e9ccf:

    # septem "Eso será un problema si no sabes cómo controlarle."
    septem "That will be a problem if you don't know how to control them."

# game/rutas/septem.rpy:870
translate ingles rutaseptem_7fad60f8:

    # "Buenas noches, cariño...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Good night, cariño...{/glitch}"

# game/rutas/septem.rpy:2894
translate ingles continuacion3_2342f016:

    # "Dejas de ver por unos segundos. Pero tus demás sentidos se multiplican y danzan entre sí, coordinados hasta en el más mínimo detalle."
    "You lose sight for a few seconds, but your other senses multiply and dance together, coordinated down to the smallest detail."

# game/rutas/septem.rpy:3057
translate ingles acto3_septem_a20cefa7:

    # "..."
    "..."

# game/rutas/septem.rpy:3061
translate ingles acto3_septem_5e99b4e1:

    # "Aunque tienes tu propio cuerpo, sigues estando conectado a Septem, para bien o para mal. Es algo a lo que nunca te podrás deshacer."
    "Even though you have your own body, you're still connected to Septem, for better or worse. It's something you'll never be able to break free from."

# game/rutas/septem.rpy:3062
translate ingles acto3_septem_0732dabf:

    # "Donde quiera que vayas, ya sea en el mundo físico o en el mundo donde reside tu consciencia, una parte de él estará a tu lado."
    "Wherever you go, whether in the physical world or the world where your consciousness resides, a part of him will always be by your side."

# game/rutas/septem.rpy:3063
translate ingles acto3_septem_accefc69:

    # "Y los sueños no son la excepción. No lo fueron cuanto estabas junto a él y no lo son ahora que técnicamente eres un ser independiente de él."
    "And dreams are no exception. They weren't when you were by his side, and they aren't now that you're technically a being independent of him."

# game/rutas/septem.rpy:3064
translate ingles acto3_septem_fdcf5986:

    # "Sus sueños ahora son los tuyos. Los sueños que controlan a Septem cuando descansa ahora te controlan a ti. Haciendo que ambos se vean atrapados en los mismos pesares que agobian su mente."
    "The dreams that control Septem while he rests now control you as well, leaving you both trapped in the same sorrows that weigh on his mind."

# game/rutas/septem.rpy:3065
translate ingles acto3_septem_a20cefa7_1:

    # "..."
    "..."

# game/rutas/septem.rpy:3066
translate ingles acto3_septem_73d8f491:

    # "Escuchas como una voz te llama, desde el fondo del suelo. Es insistente e intensa, lo suficiente para provocar que las piernas te tiemblen de tan solo sentir las vibraciones que acompañan el canto de tu nombre al ser llamado desde el fondo..."
    "You hear a voice calling out to you from deep beneath the ground. It's persistent and intense, enough to make your legs tremble just from feeling the vibrations that accompany the chanting of your name from the depths..."

# game/rutas/septem.rpy:3067
translate ingles acto3_septem_7f98154b:

    # "Reconoces la voz. Es la voz que le pertenece a la primera entidad que te dio la bienvenida a este mundo."
    "You recognize the voice. It belongs to the very first entity that welcomed you into this world."

# game/rutas/septem.rpy:3071
translate ingles acto3_septem_26cfec81:

    # "Padre te llama."
    "Father is calling you."

# game/rutas/septem.rpy:3072
translate ingles acto3_septem_4fcbc101:

    # "{i}Septem... [nombrejugador]...{i} No estás seguro a cuál nombre llama. Lo que sí sabes, es que las náuseas y el miedo que sientes, no es tuyo."
    "{i}Septem... [nombrejugador]...{/i} you're not sure which name he's calling. What you do know is that the nausea and fear you're feeling aren't yours."

# game/rutas/septem.rpy:3074
translate ingles acto3_septem_007a38c7:

    # centered "Regla número uno: Nada puede entrar o salir del Jardín. Está estrictamente prohibido."
    centered "Rule number one: Nothing may enter or leave the Garden. It is strictly forbidden."

# game/rutas/septem.rpy:3076
translate ingles acto3_septem_0f2cd024:

    # creador "Y aun así, dejaste que Nulla saliera y te trajera un cuerpo."
    creador "And yet, you allowed Nulla to leave and bring you a body."

# game/rutas/septem.rpy:3078
translate ingles acto3_septem_7a173de3:

    # centered "Regla número dos: Se te tiene prohibido dañar a los tuyos. Y así nada ni nadie que tenga origen dentro del Jardín puede dañarte de vuelta."
    centered "Rule number two: You are forbidden from harming your own kind, and in turn, nothing and no one originating from within the Garden can harm you."

# game/rutas/septem.rpy:3080
translate ingles acto3_septem_fc8c6dac:

    # creador "Y a sabiendas de que has roto la primera regla, has tenido las agallas de romper la segunda."
    creador "And knowing full well that you've broken the first rule, you had the nerve to break the second."

# game/rutas/septem.rpy:3081
translate ingles acto3_septem_84871eb9:

    # creador "Tú no aprendes."
    creador "You never learn."

# game/rutas/septem.rpy:3083
translate ingles acto3_septem_14634a23:

    # creador "Predicas seguir las reglas a todos tus súbditos, pero no prácticas."
    creador "You preach about following the rules to all your subjects, yet you don't follow them yourself."

# game/rutas/septem.rpy:3084
translate ingles acto3_septem_3a508119:

    # creador "Tu boca solo expulsa hipocresía."
    creador "Nothing but hypocrisy comes out of your mouth."

# game/rutas/septem.rpy:3086
translate ingles acto3_septem_eca719d8:

    # centered "Regla número tres: el Jardín debe funcionar a como dé lugar."
    centered "Rule number three: The Garden must function at all costs."

# game/rutas/septem.rpy:3088
translate ingles acto3_septem_cf34a257:

    # creador "No importa lo que tengas que hacer. Cambios, reemplazos de tus Estandartes, o incluso empezar desde cero, con tal de seguir con vida a tu alrededor."
    creador "It doesn't matter what you have to do. Make changes, replace your Symbols, or even start from scratch, as long as life continues to thrive around you."

# game/rutas/septem.rpy:3090
translate ingles acto3_septem_bcb4a6e1:

    # creador "..."
    creador "..."

# game/rutas/septem.rpy:3091
translate ingles acto3_septem_57789ea5:

    # creador "Es más fácil volver a empezar."
    creador "It's easier to start over."

# game/rutas/septem.rpy:3092
translate ingles acto3_septem_99ff364d:

    # creador "Borrar todo y comenzar de nuevo."
    creador "Erase everything and begin again."

# game/rutas/septem.rpy:3093
translate ingles acto3_septem_effca092:

    # creador "Mismos conceptos, distinto mando."
    creador "Same concepts, different leadership."

# game/rutas/septem.rpy:3095
translate ingles acto3_septem_ef917f66:

    # creador "Pero... veo que te has encariñado con los tuyos a un a sabiendas de que son defectuosos."
    creador "But... I see you've grown attached to your own, even knowing they're flawed."

# game/rutas/septem.rpy:3097
translate ingles acto3_septem_66aadf53:

    # centered "Siempre supe que eras un sentimentalista... y un terco."
    centered "I always knew you were a sentimental fool... and a stubborn one."

# game/rutas/septem.rpy:3098
translate ingles acto3_septem_8fb15281:

    # centered "Desde el día que te cree."
    centered "From the day I created you."

# game/rutas/septem.rpy:3099
translate ingles acto3_septem_15f98276:

    # centered "..........."
    centered "..........."

# game/rutas/septem.rpy:3101
translate ingles acto3_septem_069f1ab8:

    # creador "Bien."
    creador "Very well."

# game/rutas/septem.rpy:3103
translate ingles acto3_septem_d4a0dd3e:

    # creador "Lo has conseguido."
    creador "You've done it."

# game/rutas/septem.rpy:3104
translate ingles acto3_septem_127f5336:

    # creador "Rompe ese sello y sigue con tus Estandartes a tu lado."
    creador "Break that seal and carry on with your Symbols by your side."

# game/rutas/septem.rpy:3105
translate ingles acto3_septem_41b3913b:

    # creador "Solo recuerda una cosa."
    creador "Just remember one thing."

# game/rutas/septem.rpy:3107
translate ingles acto3_septem_f746b73a:

    # creador "Deberás aplicar mano dura para evitar más deslices."
    creador "You'll have to rule with an iron fist to prevent any further missteps."

# game/rutas/septem.rpy:3109
translate ingles acto3_septem_a20cefa7_2:

    # "..."
    "..."

# game/rutas/septem.rpy:3110
translate ingles acto3_septem_3928a113:

    # "......."
    "......."

# game/rutas/septem.rpy:3115
translate ingles acto3_septem_f1d24599:

    # "La voz por fin deja de llamar tu nombre."
    "The voice finally stops calling your name."

# game/rutas/septem.rpy:3116
translate ingles acto3_septem_5a224d7b:

    # "Abandonándote una vez más."
    "Abandoning you once again."

# game/rutas/septem.rpy:3117
translate ingles acto3_septem_72ebd4f5:

    # "No puedes evitar sentir un poco de tristeza. Incluso en un sueño, Padre no te ha dicho más que acusaciones y recomendaciones que nadie le ha solicitado."
    "You can't help but feel a little sad. Even in a dream, Father has offered you nothing but accusations and unsolicited advice."

# game/rutas/septem.rpy:3118
translate ingles acto3_septem_10b1c76d:

    # "Nada que te tranquilice a ti o a tu intangible corazón."
    "Nothing to soothe you or your intangible heart."

# game/rutas/septem.rpy:3119
translate ingles acto3_septem_755555e7:

    # "Ahora, sin nada a lo que agarrarte, comienzas a caminar por el sendero imaginario que se forma con cada paso que das."
    "Now, with nothing left to hold on to, you begin walking along the imaginary path that forms with every step you take."

# game/rutas/septem.rpy:3120
translate ingles acto3_septem_7127c5a2:

    # "Paso tras paso, tu yo comienza a dejar el espacio de tu mente, para recobrar lentamente los sentidos de tu cuerpo físico."
    "Step by step, your sense of self begins to leave the confines of your mind, slowly regaining the senses of your physical body."

# game/rutas/septem.rpy:3121
translate ingles acto3_septem_a20cefa7_3:

    # "..."
    "..."

# game/rutas/septem.rpy:3122
translate ingles acto3_septem_3b4f4ffe:

    # "-------------"
    "-------------"

# game/rutas/septem.rpy:3128
translate ingles acto3_septem_ae99003b:

    # "Lo primero que percibes es lo pesado de tu cuerpo y lo cansado que están tus músculos. La gran mayoría de ellos queman y se tensan cada tanto."
    "The first thing you notice is how heavy your body feels and how exhausted your muscles are. Most of them burn and tense up every so often."

# game/rutas/septem.rpy:3129
translate ingles acto3_septem_a0c6ed71:

    # "Luego viene la autopercepción. Eres Tú. Ya no un Él, o una extraña mezcla que te transforma en {i}Ellos{i}."
    "Then comes self-awareness: You're you--no longer Septem or some strange mixture of you and him."

# game/rutas/septem.rpy:3130
translate ingles acto3_septem_ac4573b0:

    # "Sigues conectado a Septem, claro, aún sientes su presencia. La diferencia es que ahora, estando despierto, eres solo un tú. Alejado de sus pensamientos y preocupaciones subconscientes."
    "You're still connected, of course. You can still feel his presence. The difference is that now, while awake, you're simply yourself... free from his subconscious thoughts and worries."

# game/rutas/septem.rpy:3131
translate ingles acto3_septem_d69eb911:

    # "Y lo agradeces, sintiendo como se te infla el pecho con el gozo egoísta de desear individualidad."
    "And you're grateful for it, feeling your chest swell with the selfish joy of longing for individuality."

# game/rutas/septem.rpy:3132
translate ingles acto3_septem_a740268e:

    # "Te estiras para ser recibido por más dolor y tensión de tus músculos y tendones. Pero eso te permite dejar de lado la confusión que procede después pasar del sueño al despertar."
    "You stretch, only to be greeted by more pain and tension in your muscles and tendons--but it helps you shake off the confusion that comes with transitioning from sleep to wakefulness."

# game/rutas/septem.rpy:3136
translate ingles acto3_septem_55dbf70f:

    # "Le echas un vistazo fugaz a la habitación. Sigue siendo la misma de siempre, sin ningún cambio aparente o que se pueda captar a primera vista."
    "You cast a fleeting glance around the room. It's the same as always, with no apparent changes or anything noticeable at first glance."

# game/rutas/septem.rpy:3137
translate ingles acto3_septem_86d6119f:

    # septem "Ya te has despertado..."
    septem "You're awake already..."

# game/rutas/septem.rpy:3141
translate ingles acto3_septem_62609753:

    # septem "Oh."
    septem "Oh."

# game/rutas/septem.rpy:3143
translate ingles acto3_septem_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:3144
translate ingles acto3_septem_d96039df:

    # septem "Espera..."
    septem "Wait..."

# game/rutas/septem.rpy:3145
translate ingles acto3_septem_f5dcb5c2:

    # "Escuchas una risa que proviene de todos lados."
    "You hear laughter coming from all directions."

# game/rutas/septem.rpy:3146
translate ingles acto3_septem_8343d429:

    # septem "Oh, ya veo..."
    septem "Oh, I see..."

# game/rutas/septem.rpy:3147
translate ingles acto3_septem_e07ec440:

    # septem "Has estado jugando con la basura esa..."
    septem "You've been playing with that trash..."

# game/rutas/septem.rpy:3148
translate ingles acto3_septem_84e7bdc7:

    # septem "Entiendo tu curiosidad morbosa."
    septem "I understand your morbid curiosity."

# game/rutas/septem.rpy:3149
translate ingles acto3_septem_6d3e8d01:

    # septem "Pero no permitiré que la lleves aquí..."
    septem "But I won't allow you to bring it here..."

# game/rutas/septem.rpy:3153
translate ingles acto3_septem_3a474e4b:

    # septem "Listo."
    septem "There."

# game/rutas/septem.rpy:3154
translate ingles acto3_septem_e71bf23d:

    # septem "Ahora no tienes como impedir que te encuentre cuando sea necesario."
    septem "Now there's no way for you to stop me from finding you when necessary."

# game/rutas/septem.rpy:3161
translate ingles acto3_septem_dcf7c54f:

    # "Su voz se escucha en todos lados, haciendo que la sensación de dejà vu te sacuda el cuerpo. Ya has vivido esto antes."
    "His voice echoes from every direction, sending a wave of déjà vu through your body. You've experienced this before."

# game/rutas/septem.rpy:3162
translate ingles acto3_septem_cf20b93e:

    # "Tus ojos lo buscan sin preguntarte si quieres o no. Es una respuesta automática."
    "Your eyes search for him without even asking whether you want to or not. It's an automatic response."

# game/rutas/septem.rpy:3166
translate ingles acto3_septem_ba29548f:

    # "Lo encuentran cruzando la puerta que divide tu habitación de la sala del templo."
    "They find him walking through the doorway that separates your bedroom from the temple hall."

# game/rutas/septem.rpy:3167
translate ingles acto3_septem_0a5243c9:

    # "Se ve calmado, pero su pecho yace apretado por algo que no puedes descifrar aún... no sabes si se debe al nerviosismo de lo que está por venir o por el sueño que has tenido..."
    "He looks calm, but something you can't quite decipher seems to be tightening in his chest... you don't know whether it's the nervousness of what's to come or the dream you've had..."

# game/rutas/septem.rpy:3168
translate ingles acto3_septem_cc1f9ccf:

    # "¿Será que Septem sabe lo que has soñado? No es como si él también estuviera dormido como para participar en el sueño junto contigo... ¿o sí?"
    "Could Septem know what you dreamed about? It's not like he was asleep too, so he couldn't have been part of the dream with you... could he?"

# game/rutas/septem.rpy:3169
translate ingles acto3_septem_d917f8a6:

    # "Tus labios tiemblan, con ansias de preguntar y quitarte la duda. Pero Septem te interrumpe antes de que puedas tomar una decisión."
    "Your lips tremble, eager to ask and put your doubts to bed, but Septem interrupts you before you can make up your mind."

# game/rutas/septem.rpy:3174
translate ingles acto3_septem_32a5fa0b:

    # septem "Espero que hayas podido descansar bien."
    septem "I hope you managed to get some good rest."

# game/rutas/septem.rpy:3175
translate ingles acto3_septem_96e2722b:

    # septem "Estuve monitoreando tu cuerpo mientras lo hacías, y..."
    septem "I was monitoring your body while you slept, and..."

# game/rutas/septem.rpy:3178
translate ingles acto3_septem_a99849ee:

    # septem "Tienes las mismas reacciones que tendría un humano al dormir."
    septem "Your body reacts exactly as a human's would during sleep."

# game/rutas/septem.rpy:3181
translate ingles acto3_septem_f1ac8e0d:

    # septem "Realmente eres perfecto. Una recreación perfecta de lo que serías si estuvieras aquí en realidad."
    septem "You truly are perfect. A perfect recreation of what you'd be like if you were actually here."

# game/rutas/septem.rpy:3186
translate ingles acto3_septem_43bc330e:

    # "Septem forma una sonrisa que abarca sus ojos también, formando pequeñas lineas de expresión a sus costados."
    "A smile spreads across Septem's face, reaching his eyes and forming little creases at their corners."

# game/rutas/septem.rpy:3187
translate ingles acto3_septem_33c0981a:

    # septem "Buenos días."
    septem "Good morning."

# game/rutas/septem.rpy:3192
translate ingles acto3_septem_892e50a7:

    # septem "Así es."
    septem "That's right."

# game/rutas/septem.rpy:3196
translate ingles acto3_septem_80dfccdd:

    # "Él se acerca hasta estar a una distancia prudente entre la cama y él. Te mira por unos segundos antes de ofrecerte la mano en un delicado gesto para que la tomes."
    "He approaches, stopping at a respectful distance from the bed. He looks at you for a few seconds before offering you his hand with a gentle gesture, inviting you to take it."

# game/rutas/septem.rpy:3197
translate ingles acto3_septem_eb5bfe72:

    # "Y espera atento a tus movimientos."
    "And he waits, watching your movements closely."

# game/rutas/septem.rpy:3201
translate ingles acto3_septem_d55b31da:

    # "Aceptas su mano, colocando la tuya sobre la de él. El contacto parece despertar una chispa entre tu mano y la suya, una chispa cálida y acogedora que te invita a seguir sujetando su mano hasta cansarte..."
    "You accept his hand, placing yours over his. The contact seems to ignite a spark between your hands, a warm, comforting spark that makes you want to keep holding his hand until you grow tired of it..."

# game/rutas/septem.rpy:3202
translate ingles acto3_septem_0feb6f05:

    # "Supones que debe ser porque tanto tú como él, están atados por el cuerpo y alma, lo que provoca que cada contacto sea una recompensa que busca que ambos quieran estar juntos en todo momento."
    "You suppose it must be because the two of you are bound together in body and soul, making every touch feel like a reward meant to keep you both longing to be together at all times."

# game/rutas/septem.rpy:3203
translate ingles acto3_septem_e5ba89f8:

    # "O simplemente es la reacción del contacto de un cuerpo cargado de electricidad estática con otro."
    "Or perhaps it's simply the reaction of a body charged with static electricity coming into contact with another."

# game/rutas/septem.rpy:3204
translate ingles acto3_septem_23a16bc5:

    # "Siendo sincero no te importa. Cualquiera que sea la razón, te gusta sentir esto con el contacto de Septem."
    "To be honest, you don't care. Whatever the reason, you like feeling this whenever you touch Septem."

# game/rutas/septem.rpy:3205
translate ingles acto3_septem_c2e88765:

    # "Se siente bien."
    "It feels good."

# game/rutas/septem.rpy:3208
translate ingles acto3_septem_fd6cd95f:

    # "No aceptas su mano y en su lugar te levantas por tu cuenta."
    "You don't take his hand. Instead, you get up on your own."

# game/rutas/septem.rpy:3210
translate ingles acto3_septem_016b84c6:

    # septem "He preparado el desayuno. No voy a sacarte de mí templo sin la energía debida."
    septem "I've prepared breakfast. I'm not letting you leave my temple without enough energy."

# game/rutas/septem.rpy:3211
translate ingles acto3_septem_c1c35a85:

    # septem "Se viene un día largo, y no sé si tu cuerpo lo podrá aguantar por completo."
    septem "It's going to be a long day, and I'm not sure your body will be able to handle it all."

# game/rutas/septem.rpy:3215
translate ingles acto3_septem_9fa37023:

    # "El rubio hace una seña con su mano, que convierte la habitación en el comedor del templo. La mesa está llena de alimentos pensados en una dieta saludable y balanceada para consumir como primera ración del día."
    "The blond makes a gesture with his hand, transforming the room into the temple's dining hall. The table is filled with food carefully chosen to provide a healthy, balanced diet for the first meal of the day."

# game/rutas/septem.rpy:3216
translate ingles acto3_septem_d7ee1d48:

    # "La fruta está cortada en cubitos, todos perfectos y del mismo tamaño. Tienes que acercar un poco tu cara para poder apreciarlos como es debido (y buscar alguna imperfección en el proceso). Parecen de mentira por lo exactas que son todas las porciones."
    "The fruit has been cut into tiny cubes, each one perfect and exactly the same size. You have to lean in a little to appreciate them properly (and look for any imperfections while you're at it)."

# game/rutas/septem.rpy:3217
translate ingles acto3_septem_1b7c7b0c:

    # "Son tan apetitosas a la vista que parecen dulces postres refinados, capaces de hacer que hasta la gente que no gusta de la fruta se le haga agua la boca."
    "Every piece is so precise that they almost look fake, resembling exquisite little desserts enough to make even those who dislike fruit feel their mouths water."

# game/rutas/septem.rpy:3218
translate ingles acto3_septem_23219629:

    # "Hay un frasco con miel y mermelada, con un color intenso. Pan en pocas cantidades, humeante y fresco. Y un montón de otras cosas que, si te detienes a ver una por una, terminarás más espantado que encantado."
    "There's a jar of honey; some richly colored jam; a small amount of bread, fresh and still steaming; and plenty of other things that, if you stop to examine them one by one, will leave you stunned by their beauty. There's even something cute drawn in the drink."

# game/rutas/septem.rpy:3219
translate ingles acto3_septem_9d7596f9:

    # "Si no conocieras a Septem, jurarías que esto es una trampa elaborada con el fin de hacerte comer y bajar la guardia con lo lindo que se ve todo. Lo cual, no es el caso."
    "If you didn't know Septem, you'd swear how pretty everything appears is an elaborate trap designed to lower your guard and eat it all."

# game/rutas/septem.rpy:3220
translate ingles acto3_septem_d888d23b:

    # "Septem lo ha hecho porque puede y quiere, sin motivos ocultos más que hacer que tu cuerpo recupere energía."
    "Which isn't the case. Septem did it because he can and because he wants to, with no hidden motives beyond helping your body regain its energy."

# game/rutas/septem.rpy:3221
translate ingles acto3_septem_d7311ef8:

    # "Lo tierno del asunto es que, se ha tomado el tiempo de hacer que la comida se vea estéticamente atractiva visualmente para ti. Porque necesidad no tiene él para poner tanto empeño en la decoración de la mesa."
    "The endearing thing about it is that he's taken the time to make everything look visually appealing with his own hands, just for you. After all, he has no real need to put so much effort into decorating the table otherwise."

# game/rutas/septem.rpy:3222
translate ingles acto3_septem_2ae5351e:

    # "Septem es lindo... cuando quiere."
    "Septem is sweet... when he wants to be."

# game/rutas/septem.rpy:3224
translate ingles acto3_septem_e5f098d6:

    # septem "Puedes comer todo lo que hay en la mesa."
    septem "You can have anything from the table."

# game/rutas/septem.rpy:3225
translate ingles acto3_septem_d2b54ff3:

    # "Dice, sentándose al frente tuyo con una copa en mano."
    "He says, settling across from you with a glass in hand."

# game/rutas/septem.rpy:3232
translate ingles acto3_septem_continuacion_06c3e9b3:

    # "Estás por darle el último bocado a tu desayuno cuando Septem baja la copa, dejándola en la mesa."
    "You're about to take the last bite of your breakfast when Septem lowers his glass and sets it on the table."

# game/rutas/septem.rpy:3234
translate ingles acto3_septem_continuacion_7982588e:

    # septem "Acerca de Madre..."
    septem "About Mother..."

# game/rutas/septem.rpy:3235
translate ingles acto3_septem_continuacion_ab413d25:

    # septem "Lo ví en tus memorias. Ella te contactó en tus sueños---"
    septem "I saw it in your memories. She contacted you in your dreams--"

# game/rutas/septem.rpy:3238
translate ingles acto3_septem_continuacion_7a8f0436:

    # septem "Lo que pide es una barbaridad..."
    septem "What she's asking for is outrageous..."

# game/rutas/septem.rpy:3239
translate ingles acto3_septem_continuacion_045f7aa9:

    # septem "Los ojos que tenemos me sirven para hacer conexión con todos en el Jardín."
    septem "The eyes we have allow me to connect with everyone in the Garden."

# game/rutas/septem.rpy:3242
translate ingles acto3_septem_continuacion_3b93dc77:

    # "Sus manos se juntan, y suelta un suspiro ahogado que te produce escalofríos. Se le ve nervioso."
    "He brings his hands together and lets out a stifled sigh that sends shivers down your spine. He appears nervous."

# game/rutas/septem.rpy:3243
translate ingles acto3_septem_continuacion_397d3d94:

    # "Es una imagen extraña de ver. Septem mostrándose de esta manera delante de ti, como si se quebrara algo que hace tiempo debería haberse quebrado."
    "It's a strange sight to behold: Septem revealing himself this way, as if something that should've broken long ago was finally cracking."

# game/rutas/septem.rpy:3244
translate ingles acto3_septem_continuacion_bbd38f29:

    # "Tal como si dejara de tirar de la cuerda que lo sostiene e impide mostrarse genuinamente. Dejando la máscara de líder de lado por un momento, para mostrar a una entidad muy similar a un humano."
    "Like he'd stopped pulling on the rope that holds him together and keeps him from showing his true self; setting aside his mask as a leader for a moment, revealing an entity remarkably similar to a human."

# game/rutas/septem.rpy:3245
translate ingles acto3_septem_continuacion_9a1b9549:

    # septem "Romper el sello que Padre le ha puesto a Sextam nos expondrá a su atención..."
    septem "Breaking the seal Father placed on Sextam will draw his attention to us..."

# game/rutas/septem.rpy:3246
translate ingles acto3_septem_continuacion_93d276c3:

    # septem "Y que Madre me pida romper todos los ojos... es una sentencia de muerte para mí."
    septem "And Mother asking me to destroy all the eyes... is a death sentence for me."

# game/rutas/septem.rpy:3247
translate ingles acto3_septem_continuacion_7a57e2a1:

    # septem "Tanto Padre como yo vemos a través de estos."
    septem "Both Father and I see through them."

# game/rutas/septem.rpy:3248
translate ingles acto3_septem_continuacion_e1c10723:

    # septem "No es una buena idea."
    septem "It's not a good idea."

# game/rutas/septem.rpy:3255
translate ingles acto3_septem_continuacion_cce13dc4:

    # septem "Eso ya lo sé."
    septem "I already know that."

# game/rutas/septem.rpy:3256
translate ingles acto3_septem_continuacion_b9e6dbfe:

    # septem "Pero romper los ojos sería una declaración de independencia."
    septem "But destroying the eyes would be a declaration of independence."

# game/rutas/septem.rpy:3261
translate ingles acto3_septem_continuacion_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:3264
translate ingles acto3_septem_continuacion_ed8b355f:

    # septem "¿Qué dices?"
    septem "What are you saying?"

# game/rutas/septem.rpy:3265
translate ingles acto3_septem_continuacion_22eeb9b8:

    # septem "Padre gusta de monitorear todo, no va a permitir que yo haga tal cosa."
    septem "Father likes to monitor everything. He won't allow me to do such a thing."

# game/rutas/septem.rpy:3268
translate ingles acto3_septem_continuacion_b5746a08:

    # septem "Y cortarlos también nos expone a un ataque por su parte."
    septem "And severing them would also leave us vulnerable to an attack from him."

# game/rutas/septem.rpy:3269
translate ingles acto3_septem_continuacion_b178c43c:

    # septem "[nombrejugador], no es una elección fácil."
    septem "[nombrejugador], it's not an easy choice."

# game/rutas/septem.rpy:3276
translate ingles acto3_septem_continuacion_5a5d28bd:

    # septem "Es lo único que no podemos cambiar..."
    septem "It's the only thing we can't change..."

# game/rutas/septem.rpy:3279
translate ingles acto3_septem_continuacion_53344203:

    # septem "....."
    septem "....."

# game/rutas/septem.rpy:3280
translate ingles acto3_septem_continuacion_31045030:

    # septem "Puedo hacerlo, pero---"
    septem "I can do it, but--"

# game/rutas/septem.rpy:3282
translate ingles acto3_septem_continuacion_c94f8cd7:

    # "Septem se levanta de golpe, enojado consigo mismo. El sonido de la silla raspar el suelo hace que tu cuerpo salte y tus oídos duelan."
    "Septem abruptly rises to his feet, angry with himself. The sound of the chair scraping against the floor makes you jump and sends a sharp pain through your ears."

# game/rutas/septem.rpy:3284
translate ingles acto3_septem_continuacion_36eabddf:

    # septem "Déjame pensarlo."
    septem "Let me think about it."

# game/rutas/septem.rpy:3285
translate ingles acto3_septem_continuacion_efe30b80:

    # septem "Necesito tiempo."
    septem "I need time."

# game/rutas/septem.rpy:3288
translate ingles acto3_septem_continuacion_ecb3e52c:

    # septem "No voy a arriesgar todo por Madre o el control total del Jardín."
    septem "I'm not going to risk everything for Mother or complete control over the Garden."

# game/rutas/septem.rpy:3291
translate ingles acto3_septem_continuacion_9d3acf1a:

    # septem "Voy a estar en la biblioteca. Si me necesitas estaré ahí hasta el mediodía."
    septem "I'll be in the library. If you need me, I'll be there until noon."

# game/rutas/septem.rpy:3294
translate ingles acto3_septem_continuacion_7947d9eb:

    # septem "Luego iremos a la ceremonia de iniciación."
    septem "After that, we'll go to the initiation ceremony."

# game/rutas/septem.rpy:3295
translate ingles acto3_septem_continuacion_4566399d:

    # septem "Te dejé tus vestimentas para la ceremonia en tu habitación."
    septem "I left your ceremonial attire in your room."

# game/rutas/septem.rpy:3297
translate ingles acto3_septem_continuacion_e870f7ba:

    # "Septem se retira, sin antes hacer desaparecer los platos y la comida sobrante de la mesa."
    "Septem leaves, but not before making the plates and leftover food on the table disappear."

# game/rutas/septem.rpy:3298
translate ingles acto3_septem_continuacion_89ee3a40:

    # "... Tú lo dejas ir."
    "... You let him go."

# game/rutas/septem.rpy:3299
translate ingles acto3_septem_continuacion_5d005423:

    # "Necesita tiempo solo."
    "He needs some time alone."

# game/rutas/septem.rpy:3308
translate ingles acto3_septem_continuacion_4c605dc4:

    # "Caminas por los pasillos del templo hasta llegar a tu habitación."
    "You walk through the temple's corridors until you reach your room."

# game/rutas/septem.rpy:3312
translate ingles acto3_septem_continuacion_81101ac4:

    # "Al entrar, notas en la cama telas que no hacen encaje con tus sábanas y asumes que esas deben ser las ropas que Septem te ha dejado."
    "Upon entering, you notice some fabrics on the bed that don't match your bedsheets, and assume they must be the clothes Septem left for you."

# game/rutas/septem.rpy:3316
translate ingles acto3_septem_continuacion_a2bf7407:

    # "Te acercas para inspeccionarlas."
    "You move closer to inspect them."

# game/rutas/septem.rpy:3317
translate ingles acto3_septem_continuacion_5fa89da9:

    # "Cada pieza que compone el conjunto está desplegada por orden en el que se debe poner."
    "Each piece of the outfit is laid out in the order you're supposed to put it on."

# game/rutas/septem.rpy:3321
translate ingles acto3_septem_continuacion_d0f693aa:

    # "Primero las capas inferiores, luego las capas superiores, terminando con los adornos."
    "First the inner layers, then the outer layers, and finally the ornaments."

# game/rutas/septem.rpy:3322
translate ingles acto3_septem_continuacion_f6a325d9:

    # "Luchas con cada prenda al intentar ponértela, cada una te toma más tiempo de lo que te gustaría admitir."
    "You struggle with each garment as you try to put it on, each one taking longer than you'd like to admit."

# game/rutas/septem.rpy:3325
translate ingles acto3_septem_continuacion_11bedf1c:

    # "Hmm..."
    "Hmm..."

# game/rutas/septem.rpy:3326
translate ingles acto3_septem_continuacion_8e5d23a9:

    # "Cuando terminas, examinas tu trabajo: La túnica color marfil que te cubre todo el cuerpo, cae de manera impecable hasta tocar el suelo. Las mangas son largas en exceso, haciendo dificultoso el movimiento de tus brazos."
    "Once you're done, you examine your work: The ivory-colored robe covering your entire body falls flawlessly to the floor. The sleeves are excessively long, making it difficult to move your arms."

# game/rutas/septem.rpy:3327
translate ingles acto3_septem_continuacion_b47220e6:

    # "Los patrones que decoran y recorren la tela son similares a los que posee Septem, más no iguales. Esta es una vestimenta que complementa a la de Septem, más no copia."
    "The patterns adorning the fabric are similar to those on Septem's attire, but not identical. This is an outfit that complements his, rather than copying it."

# game/rutas/septem.rpy:3331
translate ingles acto3_septem_continuacion_387d099d:

    # "Al dar tu primer paso, comprendes algo importante."
    "As you take your first step, you realize something important."

# game/rutas/septem.rpy:3332
translate ingles acto3_septem_continuacion_c9146501:

    # "Lo que llevas puesto no es una prenda hecha para moverse con facilidad."
    "What you're wearing isn't a garment designed for easy movement."

# game/rutas/septem.rpy:3333
translate ingles acto3_septem_continuacion_aada74bc:

    # "Debes tener cuidado con cada paso que das, procurando no enredar tus pues en las telas que se arrastran por el suelo."
    "You have to be careful with every step you take, making sure your feet don't get tangled in the fabric dragging along the floor."

# game/rutas/septem.rpy:3342
translate ingles acto3_septem_continuacion2_60982eea:

    # "Una vez llegan a la entrada el templo, te observa por unos segundos, inspeccionando tu apariencia de pies a cabeza."
    "Once you reach the temple entrance, he watches you for a few seconds, inspecting your appearance from head to toe."

# game/rutas/septem.rpy:3346
translate ingles acto3_septem_continuacion2_12b16674:

    # "Sus manos suben hasta alinearse con tu pecho, cuando piensas que posará su palma en tu corazón, Septem agarra la tela que cubre tu pecho para arreglarla."
    "His hands rise to the level of your chest. Just when you think he's about to place his palm over your heart, Septem grabs the fabric covering your chest and adjusts it."

# game/rutas/septem.rpy:3347
translate ingles acto3_septem_continuacion2_e1376337:

    # septem "Hoy necesito que no te despegues de mi lado."
    septem "Today, I need you to stay by my side at all times."

# game/rutas/septem.rpy:3348
translate ingles acto3_septem_continuacion2_6eb1b18c:

    # septem "No mires al resto a los ojos y mantente alejado de las voces que llamen a tu nombre."
    septem "Don't look anyone else in the eye, and stay away from any voices calling your name."

# game/rutas/septem.rpy:3355
translate ingles acto3_septem_continuacion2_3a6bca7d:

    # "Tu respuesta le saca una sonrisa satisfecha."
    "Your answer draws a satisfied smile from him."

# game/rutas/septem.rpy:3356
translate ingles acto3_septem_continuacion2_1728687d:

    # septem "¿Aceptas sin consultar?"
    septem "You agree without even asking?"

# game/rutas/septem.rpy:3357
translate ingles acto3_septem_continuacion2_a20cefa7:

    # "..."
    "..."

# game/rutas/septem.rpy:3358
translate ingles acto3_septem_continuacion2_ea6825bf:

    # "Sus manos dejan tu ropa para acariciar tu mejilla con firmeza."
    "His hands leave your clothes to caress your cheek with a firm touch."

# game/rutas/septem.rpy:3361
translate ingles acto3_septem_continuacion2_c4c0fd5c:

    # septem "Eres ingenuo."
    septem "You're naive."

# game/rutas/septem.rpy:3368
translate ingles acto3_septem_continuacion2_9543838f:

    # "Septem frunce el ceño, no acostumbrado a ser cuestionado por otro ser."
    "Septem furrows his brow, unaccustomed to being questioned by another being."

# game/rutas/septem.rpy:3369
translate ingles acto3_septem_continuacion2_ce7aa610:

    # septem "Porque es peligroso."
    septem "Because it's dangerous."

# game/rutas/septem.rpy:3370
translate ingles acto3_septem_continuacion2_27dc21fe:

    # septem "Eres como un..."
    septem "You're like a..."

# game/rutas/septem.rpy:3374
translate ingles acto3_septem_continuacion2_9a92c958:

    # "Pausa un segundo, procesando si la palabra que estaba a punto de usar corresponde ser usada o no."
    "He pauses for a moment, considering whether the word he was about to use is appropriate or not."

# game/rutas/septem.rpy:3377
translate ingles acto3_septem_continuacion2_1c73d00a:

    # septem "Apenas tienes el poder de confirmar cambios."
    septem "You barely have the power to approve changes."

# game/rutas/septem.rpy:3378
translate ingles acto3_septem_continuacion2_8548ba5c:

    # septem "No sabes comandar y tu cuerpo no te permite crear nada aún."
    septem "You don't know how to command, and your body doesn't allow you to create anything yet."

# game/rutas/septem.rpy:3379
translate ingles acto3_septem_continuacion2_4a670f15:

    # septem "Sigues estando confinado en un cuerpo que no responde del todo tus deseos."
    septem "You're still confined to a form that doesn't fully respond to your wishes."

# game/rutas/septem.rpy:3382
translate ingles acto3_septem_continuacion2_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:3385
translate ingles acto3_septem_continuacion2_c516b468:

    # septem "Si te quedas solo, ellos no dudarán en romperte en pedazos."
    septem "If you're left alone, they won't hesitate to tear you to pieces."

# game/rutas/septem.rpy:3386
translate ingles acto3_septem_continuacion2_a9c1ae9b:

    # septem "El más fuerte manda, así funciona."
    septem "The strongest rules. That's how it works."

# game/rutas/septem.rpy:3389
translate ingles acto3_septem_continuacion2_5423ce2f:

    # "Eso no te lo esperabas... ¿no se supone que tienes un rango alto?"
    "You weren't expecting that... aren't you supposed to hold a high rank?"

# game/rutas/septem.rpy:3390
translate ingles acto3_septem_continuacion2_dc795b2c:

    # "Estás a punto de ser presentado como el amo y señor de estas tierras, ¿pero eres débil?"
    "You're about to be introduced as the lord and master of these lands, but you're weak?"

# game/rutas/septem.rpy:3391
translate ingles acto3_septem_continuacion2_76d3aeec:

    # "Septem ve la confusión en tu rostro."
    "Septem notices the confusion on your face."

# game/rutas/septem.rpy:3398
translate ingles acto3_septem_continuacion2_38c9a876:

    # septem "Todos funcionan mantener el Jardín funcionando a como de lugar."
    septem "Everyone works to keep the Garden functioning at all costs."

# game/rutas/septem.rpy:3399
translate ingles acto3_septem_continuacion2_4acdddf8:

    # septem "Si el resto ve a un Estandarte o alto rango deficiente, no dudarán en romperlo y comerlo para tomar su poder y lugar."
    septem "If the others see a defective Symbol or high-ranking being, they won't hesitate to tear them apart and devour them to take their power and place."

# game/rutas/septem.rpy:3400
translate ingles acto3_septem_continuacion2_02c810d1:

    # septem "Y tú, mi querido pequeño Creador, tienes un rango muy deseado."
    septem "And you, my dear little Creator, hold a highly coveted rank."

# game/rutas/septem.rpy:3401
translate ingles acto3_septem_continuacion2_1a1005b8:

    # septem "Pero tu cuerpo no rinde lo que debería rendir."
    septem "But your body doesn't perform as well as it should."

# game/rutas/septem.rpy:3402
translate ingles acto3_septem_continuacion2_3cbed1f2:

    # septem "Ya que tú, solo confirmas los cambios, no creas."
    septem "Because you only approve changes, you don't create."

# game/rutas/septem.rpy:3406
translate ingles acto3_septem_continuacion2_a501c5a6:

    # "Abres la boca para soltar tus temores y dudas, pero las manos de Septem atrapan las tuyas, juntándolas y llevándolas frente tuyo."
    "You open your mouth to voice your fears and doubts, but before you can, Septem catches your hands in his, bringing them together in front of you."

# game/rutas/septem.rpy:3410
translate ingles acto3_septem_continuacion2_da77f571:

    # "Se inclina un poco para poder verte directamente a los ojos, con sus cejas arqueadas y una sonrisa que pide perdón sin dejar de ser algo condescendiente..."
    "He leans down to look you directly in the eyes. His eyebrows are raised and he's wearing an apologetic smile that's somewhat condescending..."

# game/rutas/septem.rpy:3411
translate ingles acto3_septem_continuacion2_61bad72d:

    # septem "Déjame cuidarte hasta que podamos transferir este mundo a ti por completo."
    septem "Let me take care of you until we can transfer this world entirely to you."

# game/rutas/septem.rpy:3412
translate ingles acto3_septem_continuacion2_14a494c9:

    # septem "Hasta ese entonces ---no dejaré que nadie te ponga una sola mano encima."
    septem "Until then--I won't let anyone lay a hand on you."

# game/rutas/septem.rpy:3417
translate ingles acto3_septem_continuacion2_a20cefa7_1:

    # "..."
    "..."

# game/rutas/septem.rpy:3418
translate ingles acto3_septem_continuacion2_32cfe002:

    # "Te sientes algo traicionado. Por un momento Septem te hizo creer que ya tenías todo a tu merced."
    "You feel somewhat betrayed. For a moment there, Septem had you convinced you already had everything at your mercy."

# game/rutas/septem.rpy:3419
translate ingles acto3_septem_continuacion2_ea7a6e13:

    # "Te llamó próximo amo del Jardín, te dio un cuerpo que puede ser regenerado, pero..."
    "He called you the next master of the Garden, gave you a body that can regenerate, but..."

# game/rutas/septem.rpy:3420
translate ingles acto3_septem_continuacion2_f0ea2b89:

    # "Todo esto, todo tu rango depende de él..."
    "Even so, your entire rank actually depends on him..."

# game/rutas/septem.rpy:3421
translate ingles acto3_septem_continuacion2_962b6126:

    # "No eres más que una flor encapsulada en una cúpula de hierro."
    "... You're nothing more than a flower enclosed beneath a dome."

# game/rutas/septem.rpy:3425
translate ingles acto3_septem_continuacion2_6552a87c:

    # "Septem te mira, notando como tus pensamientos comienzan a divagar de lo que sucede a tu alrededor, mas no te interrumpe. Sus manos ajustan una última cosa en tus ropas y se retiran de tu espacio personal."
    "Septem looks at you, noticing how your thoughts were drifting away from what's happening around you, but he doesn't interrupt. His hands make one final adjustment to your clothes before he withdraws from your personal space."

# game/rutas/septem.rpy:3426
translate ingles acto3_septem_continuacion2_9abf523d:

    # "Levanta sus manos una vez más, preparándose para invocar a ambos al lugar dónde el resto del Jardín los espera."
    "He raises his hands once more, preparing to transport you both to the place where the rest of the Garden awaits."

# game/rutas/septem.rpy:3427
translate ingles acto3_septem_continuacion2_f2b14fec:

    # septem "Recuerda sonreír y no despegarte de mí."
    septem "Remember to smile and stay close to me."

# game/rutas/septem.rpy:3433
translate ingles acto3_septem_continuacion2_d55b2a2c:

    # "Él hace señas con sus manos mientras recita palabras que no tienen significado para ti aún."
    "He makes gestures with his hands while reciting words that hold no meaning for you yet."

# game/rutas/septem.rpy:3434
translate ingles acto3_septem_continuacion2_cc509b37:

    # "Cuando tu vista es invadida por una luz intensa, Septem te toma de la mano con un agarre firme, que teme ser cortado. Sientes como bajo de toda esa cara de seguridad y expresión serena, algo estruja su pecho."
    "As an intense light floods your vision, Septem takes your hand in a firm grip, as though afraid of being torn away from you. You can feel that beneath his confident demeanor and serene expression, something is tightening in his chest."

# game/rutas/septem.rpy:3435
translate ingles acto3_septem_continuacion2_0e9800f3:

    # "Es la duda. Duda a lo incierto del resultado en esta jornada. Duda y cuestionamiento al cambio, posiblemente."
    "It's doubt: Doubt about the uncertain outcome of this day... apprehension about change, perhaps."

# game/rutas/septem.rpy:3436
translate ingles acto3_septem_continuacion2_7d2b94b0:

    # "Es inseguridad te contagia, invitando al miedo a colarse en tus entrañas. "
    "That insecurity spreads to you, inviting fear to creep into your gut. "

# game/rutas/septem.rpy:3437
translate ingles acto3_septem_continuacion2_d1fd2ef5:

    # "La sensación de caer te invade los sentidos, por un segundo crees que la superficie del suelo te ha tragado sin aviso. El vértigo es más grande que ti y no dudas en apretar la mano de Septem con fuerza, listo para agarrarse a su cuerpo con piernas y brazos si es necesario."
    "The sensation of falling overwhelms your senses. For a second, you think the ground has swallowed you without warning. The vertigo is more than you can bear, and you don't hesitate to squeeze Septem's hand tightly, ready to cling to his body with both arms and legs if necessary."

# game/rutas/septem.rpy:3438
translate ingles acto3_septem_continuacion2_6932ec84:

    # "La luz molesta deja tus retinas en paz y junto con ello, el vértigo desaparece."
    "The blinding light finally gives your eyes a rest, and with it, the vertigo disappears."

# game/rutas/septem.rpy:3439
translate ingles acto3_septem_continuacion2_8e8706e7:

    # "Has llegado a tu destino."
    "You've reached your destination."

# game/rutas/septem.rpy:3445
translate ingles acto3_septem_continuacion2_75db7107:

    # "El lugar no es para nada lo que te habías imaginado. De cierta manera tu mente tenía proyectado un espacio similar al de la reunión anterior. Donde el tiempo y el espacio se mezclan, dejando una extraña brecha que no puede ser entendida por el ojo humano."
    "The place is nothing like you imagined. Somehow, your mind had pictured a space similar to the one from the previous gathering. A place where time and space intertwine, creating a strange rift beyond the comprehension of the human eye."

# game/rutas/septem.rpy:3446
translate ingles acto3_septem_continuacion2_352afcfd:

    # "Lo que te da la bienvenida es nada más y nada menos que un salón para eventos. Masivo y pulcro, en sus muros ornamentados con molduras, te conducen a un techo que demandan levantar la vista para poder apreciarlos correctamente."
    "What greets you is none other than an event hall. Massive and immaculate, its walls adorned with intricate moldings that lead your gaze toward a ceiling so high you have to look up to appreciate it properly."

# game/rutas/septem.rpy:3447
translate ingles acto3_septem_continuacion2_ee37de61:

    # "Tomando en consideración lo amplio del lugar, parece un escenario ideal para un banquete o un vals."
    "Considering how spacious the place is, it seems like the perfect setting for a banquet or dancing a waltz."

# game/rutas/septem.rpy:3451
translate ingles acto3_septem_continuacion2_8e175548:

    # "Ya hay entidades repartidas en cada esquina donde sus ojos se posen. La gran mayoría lleva máscaras que les tapan toda expresión en sus caras, acompañados por múltiples ornamentos que hacen juego con su vestimenta."
    "There are already entities scattered throughout every corner your eyes fall upon. Most of them wear masks that conceal every trace of expression on their faces, along with various ornaments that complement their attire."

# game/rutas/septem.rpy:3452
translate ingles acto3_septem_continuacion2_f5410e4f:

    # "Es fácil darse cuenta de que no todos proceden del mismo lugar, por la forma y colores de sus máscaras."
    "It's easy to tell that they don't all come from the same place, judging by the shapes and colors of their masks."

# game/rutas/septem.rpy:3453
translate ingles acto3_septem_continuacion2_f40ec05d:

    # "Sin embargo, intuyes que todos los presentes ocupan posiciones importantes, todo material que los cubre es ostentoso, desde la cabeza hasta los pies..."
    "However, you suspect that everyone present holds an important position. Everything they wear is extravagant, from head to toe..."

# game/rutas/septem.rpy:3454
translate ingles acto3_septem_continuacion2_3f6245f0:

    # "Te preguntas si las clases sociales serán tan marcadas aquí como lo son en el mundo humano, donde la repartija de recursos es dispareja."
    "You wonder if social classes are as sharply divided here as they are in the human world, where resources are distributed so unevenly."

# game/rutas/septem.rpy:3455
translate ingles acto3_septem_continuacion2_26987246:

    # "Le sigues el paso, procurando no quedar atrás o ser absorbido por las figuras que bloquean tu paso, intentando llamar tu atención."
    "You keep up with Septem, careful not to fall behind or get swallowed up by the figures blocking your path that are trying to win your attention."

# game/rutas/septem.rpy:3456
translate ingles acto3_septem_continuacion2_1b7fcee7:

    # "Septem camina por el lugar, saludando de vez en cuando a algunas entidades, sin darles la oportunidad para comenzar una conversación más extensa con él o contigo."
    "Septem walks through the hall, occasionally greeting a few entities without giving them the chance to strike up a longer conversation with either of you."

# game/rutas/septem.rpy:3457
translate ingles acto3_septem_continuacion2_7abc7903:

    # "Él está buscando algo en particular."
    "He's looking for something in particular."

# game/rutas/septem.rpy:3462
translate ingles acto3_septem_continuacion2_41e48d06:

    # "Dan unos pasos más hasta frenar frente a un cúmulo de figuras femeninas que rodean a alguien. Estiras el cuello para poder tener más campo de visión, y solo gracias a que las entidades se dan cuenta de la presencia de Septem, es que puedes ver a quien ocultaban con sus cuerpos. Es Sextam."
    "You both take a few more steps before stopping in front of a cluster of female figures surrounding someone. You crane your neck to get a better view, and it's only when the entities notice Septem's presence that you can finally see who they've been concealing with their bodies."

# game/rutas/septem.rpy:3467
translate ingles acto3_septem_continuacion2_5b07ccb3:

    # "Mientras las mujeres agachan la cabeza y saludan a Septem con su título, Ella ya tiene sus ojos puestos en ti. No se mueve ni habla, espera a que Septem le dirija la palabra."
    "It's Sextam. While the women bow their heads and greet Septem by his title, she already has her eyes fixed on you. She neither moves nor speaks, waiting for Septem to address her."

# game/rutas/septem.rpy:3468
translate ingles acto3_septem_continuacion2_05d77e52:

    # "Su rostro no refleja alegría... se le ve apática."
    "There's no joy on her face... she looks apathetic."

# game/rutas/septem.rpy:3469
translate ingles acto3_septem_continuacion2_12e069be:

    # "Septem les sonríe a las acompañantes de Sextam antes de dirigirse a ella."
    "Septem smiles at Sextam's companions before addressing her."

# game/rutas/septem.rpy:3474
translate ingles acto3_septem_continuacion2_7b977863:

    # septem "Es un gusto ver a la corte del Seis en un evento público."
    septem "It's a pleasure to see the Court of Six at a public event."

# game/rutas/septem.rpy:3475
translate ingles acto3_septem_continuacion2_c65de846:

    # "Sextam se cruza de brazos, mirando a una de las mujeres que tiene a su lado."
    "Sextam crosses her arms, glancing at one of the women beside her."

# game/rutas/septem.rpy:3479
translate ingles acto3_septem_continuacion2_5159a1b7:

    # sextam "Durmieron por un largo tiempo. Supongo que ahora son necesarias ahora."
    sextam "They slept for a long time. I suppose they're needed now."

# game/rutas/septem.rpy:3484
translate ingles acto3_septem_continuacion2_b9017f31:

    # septem "Te serán útiles manteniendo y guiando a las nodrizas."
    septem "They'll be useful in overseeing and guiding the wet nurses."

# game/rutas/septem.rpy:3489
translate ingles acto3_septem_continuacion2_6048ae9d:

    # sextam "Supongo..."
    sextam "I suppose..."

# game/rutas/septem.rpy:3496
translate ingles acto3_septem_continuacion2_d04d2235:

    # "La vibra del momento es pesada. Sextam no está interesada en hacer conversación con Septem y no se molesta en ocultarlo."
    "The atmosphere is tense. Sextam has no interest in making conversation with Septem, and she doesn't bother hiding it."

# game/rutas/septem.rpy:3501
translate ingles acto3_septem_continuacion2_f85d3f7f:

    # septem "Entiendo cómo te sientes, pero es por el bien---"
    septem "I understand how you feel, but it's for the good of--"

# game/rutas/septem.rpy:3509
translate ingles acto3_septem_continuacion2_43c9ccd6:

    # sextam "Ya lo sé, Septem."
    sextam "I already know, Septem."

# game/rutas/septem.rpy:3510
translate ingles acto3_septem_continuacion2_e67a0f52:

    # "Su voz sale lo suficientemente dura como para hacer que Septem se muerda la lengua y apriete los dientes. Sextam notando aquello, esboza una pequeña sonrisa, bajando así su intensidad."
    "Her voice comes out harsh enough to make Septem bite his tongue and clench his teeth. Noticing this, Sextam gives a faint smile, softening her tone."

# game/rutas/septem.rpy:3511
translate ingles acto3_septem_continuacion2_6ba6aa00:

    # sextam "Haré mi trabajo, no dudes de ello."
    sextam "I'll do my job, don't doubt that."

# game/rutas/septem.rpy:3514
translate ingles acto3_septem_continuacion2_be4e505d:

    # "Suena sincera."
    "She sounds sincere."

# game/rutas/septem.rpy:3519
translate ingles acto3_septem_continuacion2_590288cb:

    # septem "Jamás lo dudaría... pero me preocupa como te sientas."
    septem "I would never doubt that... but I'm worried about how you feel."

# game/rutas/septem.rpy:3524
translate ingles acto3_septem_continuacion2_ccc900eb:

    # sextam "No es necesario hablar de eso ahora."
    sextam "There's no need to talk about that right now."

# game/rutas/septem.rpy:3529
translate ingles acto3_septem_continuacion2_3279708e:

    # sextam "..."
    sextam "..."

# game/rutas/septem.rpy:3530
translate ingles acto3_septem_continuacion2_55c9c747:

    # sextam "Luego de esto, mi consejo quiere comentarte algunas observaciones que han hecho del dominio."
    sextam "After this, my council would like to share some observations they've made about the domain."

# game/rutas/septem.rpy:3535
translate ingles acto3_septem_continuacion2_b9115b73:

    # septem "Pueden hacerlo ahora."
    septem "They can do so now."

# game/rutas/septem.rpy:3536
translate ingles acto3_septem_continuacion2_146084b3:

    # septem "Unum y su consejo aún no llegan, tenemos tiempo..."
    septem "Unum and his council haven't arrived yet. We have time..."

# game/rutas/septem.rpy:3546
translate ingles acto3_septem_continuacion2_b08fd866:

    # "Sextam deja que sus chicas sigan a Septem mientras recorren el lugar. Tú vas a su lado, sin participar de la conversación. No es que te interese tanto, pues con solo escuchar las primeras frases has captado que entiendes poco y nada de lo que están hablando."
    "Sextam lets her girls follow Septem as they make their way through the hall. You walk beside him without joining the conversation. Not that you're particularly interested, since just hearing the first few sentences has made you realize you understand next to nothing of what they're talking about."

# game/rutas/septem.rpy:3547
translate ingles acto3_septem_continuacion2_d3c7c464:

    # "Y ahora mismo no estás pendiente en hacer sentido a la logística."
    "And right now, you're not particularly concerned with making sense of the logistics."

# game/rutas/septem.rpy:3548
translate ingles acto3_septem_continuacion2_7cb68a62:

    # "Lo único que tienes que hacer ahora es seguirles el paso e ignorar las miradas de los demás invitados y alguna que otra consejera de Sextam que no tenga la palabra en ese momento."
    "All you have to do now is keep up, and ignore the stares from the other guests and the occasional member of Sextam's council who isn't speaking at the moment."

# game/rutas/septem.rpy:3549
translate ingles acto3_septem_continuacion2_938fc2fb:

    # "Luego de caminar por un rato, tu túnica se ha convertido en tu peor enemigo hasta el momento. Te imposibilita moverte libertad, haciendo que te cueste seguirle el paso a Septem y el grupo de mujeres que revolotean a tu alrededor."
    "After walking for a while, your robe has become your worst enemy thus far. It keeps you from moving freely, making it difficult to maintain pace with Septem and the group of women fluttering around you."

# game/rutas/septem.rpy:3550
translate ingles acto3_septem_continuacion2_aac924bf:

    # "Ya has contado dos pasos en falso que casi te han hecho caer."
    "You've already counted two missteps that nearly sent you tumbling!"

# game/rutas/septem.rpy:3551
translate ingles acto3_septem_continuacion2_0025a45a:

    # "En un momento dado, un grupo de entidades se cruzan con ustedes, haciendo que pierdas por un segundo la figura de Septem. Y es ahí donde sientes un fuerte jalón en tu manga."
    "At one point, a group of entities crosses your path, causing you to lose sight of Septem for a second... and that's when you feel a sharp tug on your sleeve."

# game/rutas/septem.rpy:3557
translate ingles acto3_septem_continuacion2_cb65d8e9:

    # "Te giras esperando encontrarte con la cara del rubio, pero te quedas helado al ver que quien te sujeta por las mangas es una entidad desconocida. Alta y robusta, con una cabeza pequeña que no hace más que acentuar su gran cuerpo."
    "You turn around, expecting to see the blond's face, but you freeze when you realize that the one gripping your sleeves is a totally unfamiliar entity; tall and heavily built, with a small head that only serves to emphasize its massive body."

# game/rutas/septem.rpy:3558
translate ingles acto3_septem_continuacion2_c0eecd33:

    # "Su mano te suelta por un segundo, solo para agarrar tu brazo, incrustando sus garras en la tela. Esto es peligroso, con un poco más de fuerza la tela sería traspasada y esas garras dañarían tu tierna piel."
    "Its hand releases you for a second, only to grab your arm, digging its claws into the fabric. This is dangerous: With just a little more force, those claws would pierce through the fabric and damage your tender skin."

# game/rutas/septem.rpy:3559
translate ingles acto3_septem_continuacion2_c7c5f6b2:

    # ell "¿Es cierto lo que dicen las lunas de Concejal Saturno?"
    ell "Is what Councilor Saturn's moons say true?"

# game/rutas/septem.rpy:3560
translate ingles acto3_septem_continuacion2_967e9842:

    # "Su tono de voz tiene una mezcla de curiosidad junto con asco, que hace que quieras escapar de su agarre y correr a los brazos de Septem."
    "Its tone carries a mixture of curiosity and disgust that makes you want to escape and run straight into Septem's arms."

# game/rutas/septem.rpy:3561
translate ingles acto3_septem_continuacion2_9d229b08:

    # "Te observa por unos segundos más antes de soltar con veneno en su voz."
    "It stares at you for a few more seconds before spitting out its next words with venom in its voice."

# game/rutas/septem.rpy:3562
translate ingles acto3_septem_continuacion2_22101024:

    # ell "Pareces más un sirviente que alguien digno de caminar junto a Septem."
    ell "You look more like a servant than someone worthy of walking beside Septem."

# game/rutas/septem.rpy:3563
translate ingles acto3_septem_continuacion2_e155c407:

    # "Sus garras rompen la tela hasta llegar a tu delicada y fina piel. Como cuchillos en mantequilla, desgarran piel, pasando la capa de la dermis."
    "Its claws tear through the fabric until they reach your delicate, fragile skin. Like knives slicing through butter, they rip into your flesh, cutting past the dermis."

# game/rutas/septem.rpy:3564
translate ingles acto3_septem_continuacion2_0837767e:

    # "Intentas zafarte de su agarre, pero eso no hace más que rasgar más tu piel."
    "You try to break free from its grasp, but that only tears your skin further."

# game/rutas/septem.rpy:3565
translate ingles acto3_septem_continuacion2_401414d1:

    # "Duele."
    "It hurts."

# game/rutas/septem.rpy:3566
translate ingles acto3_septem_continuacion2_9d00e059:

    # "Sin procesar tus opciones, cierras las manos con rabia para darle un puñetazo y así poder quitártelo de encima. Sabes que es en vano, por el tamaño colosal que posee, tu golpe no podrá conectar en ese punto débil de manera exitosa."
    "Without even considering your options, you clench your fists, ready to punch it to get it off you. You know it's futile. Given its colossal size, there's no way your hit will successfully reach that weak spot."

# game/rutas/septem.rpy:3567
translate ingles acto3_septem_continuacion2_e428b787:

    # "Sin embargo, no te vas a quedar como un bueno para nada y esperar a que te trituren el hueso del brazo. Pues, al paso que va su agarre, ese será el resultado si no haces nada."
    "Still, you're not going to stand there like a good-for-nothing and wait for the bone in your arm to be crushed... because at the rate its grip is tightening, that's exactly what will happen!"

# game/rutas/septem.rpy:3568
translate ingles acto3_septem_continuacion2_de98d62c:

    # ell "Hueles a humano."
    ell "You smell human."

# game/rutas/septem.rpy:3569
translate ingles acto3_septem_continuacion2_3d48aa9a:

    # "La voz de la entidad ha bajado al menos dos tonos, ya no te habla con asco... se ha interesado en ti repentinamente."
    "The entity's voice has dropped at least two pitches. It no longer speaks to you with disgust... it's suddenly taken an interest in you."

# game/rutas/septem.rpy:3570
translate ingles acto3_septem_continuacion2_33acb6e9:

    # "Su rostro se acerca más a ti, teniendo que encorvar la espalda unos grados para lograr estar lo suficientemente cerca de tu brazo. Clavando su atención donde sus garras te retienen, apretando con cada vez más fuerza."
    "Its face moves closer to you, forcing it to hunch over slightly to get close enough to your arm. Its attention remains fixed on the spot where its claws hold you captive, squeezing harder and harder."

# game/rutas/septem.rpy:3571
translate ingles acto3_septem_continuacion2_02863a57:

    # "Sangre brota de las heridas provocadas, siendo aquello lo que lo ha hecho pausar. Admirando, fascinado, como tu sangre tiñe la tela de la manga."
    "Blood begins to flow from the wounds it has inflicted, and that's what makes it pause, watching in fascination as your blood stains the fabric of your sleeve."

# game/rutas/septem.rpy:3572
translate ingles acto3_septem_continuacion2_8a847186:

    # "Está distraído, con la guardia baja. Tomando nota de ello, aprovechas esta oportunidad para darle con un gancho en su mandíbula."
    "Its guard is down. Noticing this, you seize the opportunity to land an uppercut to its jaw."

# game/rutas/septem.rpy:3576
translate ingles acto3_septem_continuacion2_cc9a5909:

    # "!!!"
    "!!!"

# game/rutas/septem.rpy:3577
translate ingles acto3_septem_continuacion2_9a4983af:

    # "..... no hay reacción."
    "... No reaction."

# game/rutas/septem.rpy:3578
translate ingles acto3_septem_continuacion2_ebc1b20f:

    # "Tu golpe no le ha hecho nada, ni siquiera le ha movido un pelo. Pero él si se ha dado cuenta de tus intenciones."
    "Your punch hasn't done a thing, not even ruffled a hair. But it has certainly noticed your intentions."

# game/rutas/septem.rpy:3579
translate ingles acto3_septem_continuacion2_1a66e7e0:

    # ell "Pffff."
    ell "Pffff."

# game/rutas/septem.rpy:3580
translate ingles acto3_septem_continuacion2_ea0c91d5:

    # "Ríe con gozo descontrolado mientras te levanta del brazo, con tal facilidad que parece que fueras un trapo. Quedas colgando, sin posibilidad de soltarte, tienes que apretar los dientes para aguantar el dolor, dejando salir un quejido quebrado."
    "It laughs with uncontrollable delight as it lifts you by the arm, so effortlessly that you might as well be a rag doll. You're left dangling, unable to break free. You have to grit your teeth to endure the pain, letting out a broken whimper."

# game/rutas/septem.rpy:3581
translate ingles acto3_septem_continuacion2_2afb2b76:

    # "La entidad levanta la cabeza al cielo, con la intención gritar frente a quien tiene a su alrededor. Tú, buscas a Septem entre la multitud, pero cuando miras alrededor, no hay nadie."
    "The entity throws its head back, intending to shout for everyone around it to hear. You search the crowd for Septem, but when you look around, there's no one."

# game/rutas/septem.rpy:3585
translate ingles acto3_septem_continuacion2_cf8abfbb:

    # "Antes de que pueda soltar sus palabras, se congela, y cuando intentas comprender lo que ha pasado, tú ya estás cayendo al suelo."
    "Before it can utter a single word, it freezes, and by the time you try to understand what's happened, you're already collapsing to the floor."

# game/rutas/septem.rpy:3586
translate ingles acto3_septem_continuacion2_0d962850:

    # "Te ha soltado."
    "It has let go of you."

# game/rutas/septem.rpy:3592
translate ingles acto3_septem_continuacion2_15d06808:

    # "Al mirar arriba, la túnica de Septem inunda tu campo de visión. Él está de espaldas a ti, cubriendo tu cuerpo y previniendo que veas lo que pasa con la otra entidad."
    "When you look up, Septem's robe fills your field of vision. His back is turned to you, shielding your body and preventing you from seeing what's happening to the other entity."

# game/rutas/septem.rpy:3596
translate ingles acto3_septem_continuacion2_5d3a370c:

    # "Giras tu cabeza, temiendo que la escena por fin tenga la atención de los demás asistentes, ahora que Septem ha entrado en escena. Avergonzado de ser la causa de este altercado, buscas a tu alrededor para contar cuantas entidades te están mirando en este instante."
    "You turn your head, afraid that the scene has finally drawn the attention of the other guests now that Septem has stepped in. Ashamed of being the cause of the altercation, you look around, trying to count how many entities are staring."

# game/rutas/septem.rpy:3597
translate ingles acto3_septem_continuacion2_611bf392:

    # "Nuevamente no hay nadie... eres solo tú, Septem y esa criatura."
    "Once again, there's no one--just you, Septem, and that creature."

# game/rutas/septem.rpy:3598
translate ingles acto3_septem_continuacion2_0a4f45f1:

    # "Entonces, lo comprendes al instante: Septem ha sellado el perímetro... o tal vez los ha sellado a ustedes tres."
    "Then, you understand immediately: Septem has sealed off the area... or just the three of you."

# game/rutas/septem.rpy:3599
translate ingles acto3_septem_continuacion2_8aa6cea5:

    # "Están solos."
    "You're alone."

# game/rutas/septem.rpy:3600
translate ingles acto3_septem_continuacion2_ed3a43be:

    # "Una parte de ti, se siente agradecida. No solo te han salvado el pellejo, sino que también te han ahorrado la humillación pública. No tendrías como dar la cara ante el resto del jardín si esto hubiera sido presenciado por otra gente."
    "A part of you feels grateful. Not only has your skin been saved, but you've also been spared the public humiliation. You wouldn't be able to face the rest of the Garden if anyone else had witnessed this."

# game/rutas/septem.rpy:3601
translate ingles acto3_septem_continuacion2_a6d5640a:

    # "Sabes cómo funcionan los rumores, y este tipo de escenas, son leña perfecta para que las malas lenguas lo hablen a tus espaldas. Haciendo más obvio lo débil y patéticamente humano que eres comparado con los demás seres del Jardín"
    "You know how rumors work, and scenes like this are perfect fuel for malicious tongues to gossip behind your back; making it all the more obvious how weak and pathetically human you are compared to the other beings of the Garden."

# game/rutas/septem.rpy:3602
translate ingles acto3_septem_continuacion2_074a4fee:

    # septem "No tienes permitido tocarlo."
    septem "You are not allowed to touch them."

# game/rutas/septem.rpy:3603
translate ingles acto3_septem_continuacion2_23a2a1d4:

    # ell "Su santidad Septem---"
    ell "Your Holiness, Septem--"

# game/rutas/septem.rpy:3604
translate ingles acto3_septem_continuacion2_a1996b75:

    # septem "Silencio."
    septem "Silence."

# game/rutas/septem.rpy:3610
translate ingles acto3_septem_continuacion2_60f623ac:

    # "La discusión muere ahí."
    "The argument ends there."

# game/rutas/septem.rpy:3611
translate ingles acto3_septem_continuacion2_0e87ef43:

    # "Septem se da la vuelta, sus cejas fruncidas crean líneas de expresión en su frente. Sus ojos viajan rápidamente a la zona lastimada y truena la lengua con coraje. Su ceño se frunce aún más al ver el estado de tu brazo."
    "Septem turns around, his furrowed brows forming creases on his forehead. His eyes quickly dart to the injured area, and he clicks his tongue in anger. His frown deepens even further when he sees the state of your arm."

# game/rutas/septem.rpy:3616
translate ingles acto3_septem_continuacion2_41d2a16b:

    # "Se agacha para tocar la herida por sobre la desmarañada tela. Está tan rota que puedes apreciar parte del daño en tu piel... hay al menos tres agujeros profundos con sangre que brota de ellos en un flujo constante."
    "He crouches down to touch the wound through the tattered fabric. It's so badly torn that you can see some of the damage to your skin... there are at least three deep puncture wounds, blood steadily flowing from each one."

# game/rutas/septem.rpy:3617
translate ingles acto3_septem_continuacion2_609f3d05:

    # "Su mano sujeta algo extraño, lo acerca a tu herida sin explicación verbal. De consistencia blanda y color similar a la piel de la criatura que te ha herido, puedes suponer que es lo que Septem tiene en la mano."
    "He's holding something strange in his hand, bringing it closer to your wound without a word of explanation. Soft in texture and similar in color to the skin of the creature that injured you, you can guess what Septem is holding."

# game/rutas/septem.rpy:3621
translate ingles acto3_septem_continuacion2_8cb8b869:

    # "Te alejas de Septem, tirando tu cuerpo hacía atrás, sin despegar la mirada de Septem y el trozo de carne que tiene en la mano."
    "You retreat, throwing your body backward without taking your eyes off him and the piece of flesh in his hand."

# game/rutas/septem.rpy:3622
translate ingles acto3_septem_continuacion2_e739157c:

    # nj "¿Qué haces?"
    nj "What are you doing?"

# game/rutas/septem.rpy:3623
translate ingles acto3_septem_continuacion2_165359b2:

    # "Él te mira serio antes de levantar parte del cuerpo de la entidad, con la intención de mostrártelo. Como si eso te ayudara a calmar tus dudas y lograr que aceptes lo que planea hacer contigo."
    "He gives you a serious look before raising the piece of the entity's body, intending to show it to you---as if that would somehow ease your doubts and convince you to accept what he plans to do to you."

# game/rutas/septem.rpy:3624
translate ingles acto3_septem_continuacion2_12005bb0:

    # septem "Voy a curarte."
    septem "I'm going to heal you."

# game/rutas/septem.rpy:3625
translate ingles acto3_septem_continuacion2_ac1a6b3f:

    # "Al no tener respuesta tuya, Septem se explica."
    "When you don't respond, Septem explains himself."

# game/rutas/septem.rpy:3628
translate ingles acto3_septem_continuacion2_f285235e:

    # septem "Parte del brazo de ese escriba."
    septem "Part of that scribe's arm."

# game/rutas/septem.rpy:3629
translate ingles acto3_septem_continuacion2_7bb2c27a:

    # "Dice restándole importancia."
    "He says, as if it were nothing."

# game/rutas/septem.rpy:3633
translate ingles acto3_septem_continuacion2_1d73815c:

    # septem "Te ha tocado."
    septem "It touched you."

# game/rutas/septem.rpy:3634
translate ingles acto3_septem_continuacion2_361f8a21:

    # septem "Y lastimado."
    septem "And hurt you."

# game/rutas/septem.rpy:3635
translate ingles acto3_septem_continuacion2_70a2c3e0:

    # "Lo dice con el tono y actitud de quién explica lo obvio. Justificando su actuar sin pena ni gloria."
    "He says it with the tone and attitude of someone explaining the obvious, justifying his actions without a hint of remorse or pride."

# game/rutas/septem.rpy:3636
translate ingles acto3_septem_continuacion2_a20cefa7_2:

    # "..."
    "..."

# game/rutas/septem.rpy:3643
translate ingles acto3_septem_continuacion2_c7bfe085:

    # septem "Voy a usar parte del escriba para regenerar tu brazo."
    septem "I'm going to use part of the scribe to regenerate your arm."

# game/rutas/septem.rpy:3644
translate ingles acto3_septem_continuacion2_2ab100df:

    # "Se te revuelve el estómago al pensar en lo que Septem le ha hecho a la criatura."
    "Your stomach churns at the thought of what Septem has done to the creature."

# game/rutas/septem.rpy:3645
translate ingles acto3_septem_continuacion2_03e1f047:

    # "Septem asume que tu silencio es rechazo y ladea un poco la cabeza, formando una sonrisa sutil."
    "Septem takes your silence as rejection and tilts his head slightly, forming a subtle smile."

# game/rutas/septem.rpy:3649
translate ingles acto3_septem_continuacion2_1b51cb3c:

    # "Ladea su cuerpo para permitir que puedas ver lo que hay detrás de él."
    "He shifts his body to the side, allowing you to see what's behind him."

# game/rutas/septem.rpy:3650
translate ingles acto3_septem_continuacion2_7f9dc973:

    # septem "El escriba lo ha ofrecido como disculpas."
    septem "The scribe offered it as an apology."

# game/rutas/septem.rpy:3651
translate ingles acto3_septem_continuacion2_f12814f9:

    # "Su voz fuerza un tono que solo puedes describir como falsa amabilidad."
    "His voice takes on a forced tone that you can only describe as fake kindness."

# game/rutas/septem.rpy:3656
translate ingles acto3_septem_continuacion2_81bab14c:

    # septem "¿No es así?"
    septem "Isn't that right?"

# game/rutas/septem.rpy:3660
translate ingles acto3_septem_continuacion2_959157df:

    # "La criatura asiente levemente con la cabeza. Yace arrodillada y cabizbaja. Hay algo que no está bien con su cuerpo, pero no lograr identificarlo todavía. Prestando más atención a su figura en general, notas la ausencia de ambos brazos."
    "The creature nods faintly. It remains kneeling, its head bowed. There's something wrong with its figure, but you can't quite figure out what it is until you look more closely and notice its arm is missing."

# game/rutas/septem.rpy:3661
translate ingles acto3_septem_continuacion2_85dd79bf:

    # "...no los tiene, ni sangra en esa zona. Su cuerpo ha sido reconstruido para eliminar las extremidades superiores de su figura humanoide."
    "... It's gone, and there's no bleeding where it should be. Its body has been reconstructed to remove the limb from its form."

# game/rutas/septem.rpy:3662
translate ingles acto3_septem_continuacion2_50f65d1f:

    # "Tragas saliva, pensando en lo literal que Septem se ha tomado el dicho 'ojo por ojo'..."
    "Thinking about how literally Septem has taken the saying 'an eye for an eye,' you swallow hard. 'An arm for an arm'..."

# game/rutas/septem.rpy:3667
translate ingles acto3_septem_continuacion2_c6e8f54a:

    # septem "Su lengua ha sido confiscada, por lo que no te puede pedir perdón de otra forma."
    septem "Its tongue has been confiscated, so it can't apologize to you any other way."

# game/rutas/septem.rpy:3668
translate ingles acto3_septem_continuacion2_d3469108:

    # "Dice con gracia, achinando los ojos en una sonrisa tierna e inocente, que genera un contraste repulsivo al comparar su expresión facial con sus palabras."
    "He says it cheerfully, smiling while his eyes narrow to give him a sweet, innocent look. There's a repulsive contrast between his expression and his words."

# game/rutas/septem.rpy:3673
translate ingles acto3_septem_continuacion2_e53a8cd1:

    # septem "Así que ha elegido un perdón retributivo."
    septem "So, it's chosen to make amends through retribution."

# game/rutas/septem.rpy:3674
translate ingles acto3_septem_continuacion2_ba387b47:

    # septem "Por favor acéptalo, o tendré que castigarlo por no disculparse por tan horrible acto que ha cometido contigo."
    septem "Please accept it, or I'll have to punish it for failing to apologize for the horrible act it committed against you."

# game/rutas/septem.rpy:3679
translate ingles acto3_septem_continuacion2_8a93ad20:

    # septem "A menos que quieras que lo castigue como es debido, mi Creador."
    septem "Unless you'd like me to punish it properly, my Creator."

# game/rutas/septem.rpy:3680
translate ingles acto3_septem_continuacion2_caa1c7bb:

    # "Él intenta reprimir el tono insistente, que pide a gritos que demandes el castigo. Sin embargo, no lo logra del todo, apenas puede controlarse."
    "He tries to suppress the insistent tone in his voice, one that practically begs you to demand the being's punishment. However, he doesn't quite succeed: You can tell he can barely restrain himself."

# game/rutas/septem.rpy:3681
translate ingles acto3_septem_continuacion2_a7715c7d:

    # "Ya sea curiosidad por los años en que la violencia le fue prohibida, o por puro placer de causar daño, Septem quiere seguir y empujar esa sensación hasta el límite."
    "Whether out of curiosity after years of being forbidden from using violence, or simply for the pleasure of causing harm, Septem wants to keep going and push that inclination to its limits."

# game/rutas/septem.rpy:3691
translate ingles acto3_septem_continuacion2_000f4ffa:

    # "Su inocente sonrisa muta, reemplazándola por dientes y ojos afilados que se asoman y distorsionan esa cara angelical, manchando todo rastro de pureza que pueda tener."
    "His innocent smile twists, giving way to sharp teeth and piercing eyes that emerge and distort that angelic face, tainting every trace of purity it might have."

# game/rutas/septem.rpy:3692
translate ingles acto3_septem_continuacion2_c47e281a:

    # "Es una expresión de puro éxtasis, maravillado al tener tu complicidad."
    "It's an expression of pure ecstasy, utterly delighted to have you as his accomplice."

# game/rutas/septem.rpy:3693
translate ingles acto3_septem_continuacion2_eca54016:

    # "Tu brazo ya se ha curado cuando Septem se acerca al escriba, lo toma por el cuello."
    "Your arm has already healed by the time Septem approaches the scribe and grabs it by the neck."

# game/rutas/septem.rpy:3698
translate ingles acto3_septem_continuacion2_b4988006:

    # septem "Aún a sabiendas de que todo lo que tiene mi nombre y esencia, has osado dañarlo."
    septem "Despite knowing they bear my name and essence, you dared to harm them."

# game/rutas/septem.rpy:3699
translate ingles acto3_septem_continuacion2_82b60576:

    # septem "Siendo un escriba deberías ser más sabio."
    septem "As a scribe, you should know better."

# game/rutas/septem.rpy:3700
translate ingles acto3_septem_continuacion2_1e38daba:

    # septem "No mereces tu puesto, claramente."
    septem "Clearly, you don't deserve your position."

# game/rutas/septem.rpy:3707
translate ingles acto3_septem_continuacion2_881f10c0:

    # "Hay una pausa, Septem levanta el cuerpo de la criatura sin dificultad, y este no pelea. Se ha sometido por completo a Septem, aceptando su castigo."
    "There's a pause. Septem lifts the creature's body effortlessly, and it doesn't resist. It has completely submitted to Septem, accepting its punishment."

# game/rutas/septem.rpy:3708
translate ingles acto3_septem_continuacion2_5b4c7605:

    # "Pero sabes que debajo de esa máscara, hay una cara de terror que está por romper en llanto."
    "But you know that beneath that mask, there's a terrified face on the verge of bursting into tears."

# game/rutas/septem.rpy:3709
translate ingles acto3_septem_continuacion2_a9135eaa:

    # "Sin más discurso, Septem atraviesa el pecho del escriba, sacando una esfera color carmesí del cuerpo del escriba. Gotea un líquido similar a la sangre en color, pero más espeso."
    "Without another word, Septem plunges his hand through the scribe's chest, pulling a crimson sphere from its body. It drips a liquid similar in color to blood, but thicker."

# game/rutas/septem.rpy:3710
translate ingles acto3_septem_continuacion2_d6ca9cc7:

    # "El cuerpo del escriba comienza a temblar y a perder la forma. Pequeñas hebras se despegan de la cabeza, buscando en movimientos erráticos la esencia que Septem tiene en la mano."
    "The scribe's body begins to tremble and lose its shape. Small strands peel away from its head, reaching out in erratic movements toward the essence Septem holds in his hand."

# game/rutas/septem.rpy:3711
translate ingles acto3_septem_continuacion2_0db9d5f6:

    # "Poco a poco, su cuerpo se desarma en hebras más grandes, que pierden forma y textura con cada segundo que pasa."
    "Little by little, its body unravels into larger strands, losing texture with every passing second."

# game/rutas/septem.rpy:3712
translate ingles acto3_septem_continuacion2_41aaf597:

    # "Septem, suelta la masa de hebras con apatía, alejándose a paso lento, caminando en tu dirección."
    "Septem indifferently drops the mass, slowly stepping away and walking toward you."

# game/rutas/septem.rpy:3713
translate ingles acto3_septem_continuacion2_131b82c0:

    # "Cuando él te tiene al frente, sus dedos se clavan en la esencia, activando algo que podrías describir como un destello tenue que provoca que entrecierres los ojos para poder apreciar bien que es lo que pasa."
    "Once he's standing in front of you, his fingers dig into the essence, triggering a faint flash of light that makes you squint to get a better look at what's happening."

# game/rutas/septem.rpy:3717
translate ingles acto3_septem_continuacion2_ac91b57b:

    # "Aquello que estaba en su mano se transforma en un broche, que en su interior lleva incrustado un cristal del mismo color carmesí de la esencia."
    "What was once in his hand transforms into a brooch, with a crystal embedded in its center--the same crimson color as the essence."

# game/rutas/septem.rpy:3718
translate ingles acto3_septem_continuacion2_b0293a69:

    # "Septem lo lleva con cuidado a tu pecho, buscando el mejor lugar para colocarlo en tu ropa. Encuentra lugar perfecto en tu pecho, justo donde late tu corazón por debajo de las telas, huesos y carne."
    "Septem carefully brings it closer, searching for the best place to fasten it to your clothes. He finds the perfect spot on your chest, right where your heart beats beneath the fabric, bones, and flesh."

# game/rutas/septem.rpy:3719
translate ingles acto3_septem_continuacion2_8e5236e8:

    # "No tarda mucho en engancharlo en la ropa. Al terminar, él da un paso atrás para ver como ha quedado, mientras tú bajas la cabeza para poder apreciar el nuevo accesorio en tu pecho."
    "It doesn't take him long to fasten it to your clothes. Once he's finished, he takes a step back to admire his work. You lower your head to get a better look at the new accessory."

# game/rutas/septem.rpy:3720
translate ingles acto3_septem_continuacion2_1129ff93:

    # "Su color sobresale, teniendo un destello anormal que ninguna piedra preciosa podría tener en realidad... debe ser porque dentro de esto, hay parte de un individuo."
    "Its color stands out, giving off an unnatural glimmer that no real gemstone could ever possess... it must be because there's a part of an individual inside it."

# game/rutas/septem.rpy:3727
translate ingles acto3_septem_continuacion2_5e7a9146:

    # "Septem suelta una risita."
    "Septem lets out a little chuckle."

# game/rutas/septem.rpy:3731
translate ingles acto3_septem_continuacion2_e87c5670:

    # septem "No."
    septem "No."

# game/rutas/septem.rpy:3732
translate ingles acto3_septem_continuacion2_0d85d1fb:

    # septem "Solo he cambiado su propósito."
    septem "I've merely changed its purpose."

# game/rutas/septem.rpy:3735
translate ingles acto3_septem_continuacion2_7d77e507:

    # "Septem baja la cabeza, haciendo una reverencia mientras una de sus manos toca donde se ubica su corazón."
    "Septem lowers his head in a bow, placing one hand over his heart."

# game/rutas/septem.rpy:3738
translate ingles acto3_septem_continuacion2_c4c711ff:

    # septem "Es un placer poder hacer valer tu palabra."
    septem "It's a pleasure to carry out your wishes."

# game/rutas/septem.rpy:3740
translate ingles acto3_septem_continuacion2_60c347c3:

    # "...te sientes extraño, algo en tu tripa se aprieta y no te deja tranquilo. Es una amalgama de sentimientos que no te permiten tomarlos uno por uno para poder identificarlos por separado."
    "... You feel strange. Something tightens in your gut, leaving you uneasy. It's an amalgamation of sensations so tangled together that you can't pick them apart to identify each one."

# game/rutas/septem.rpy:3741
translate ingles acto3_septem_continuacion2_42c4abc1:

    # "Sabes que entre ellos está la culpa, pero no es tan grande como para lamentarte o enojarte con Septem por lo que ha pasado."
    "You know guilt is among them, but it isn't strong enough to make you feel remorse or get angry with Septem over what happened."

# game/rutas/septem.rpy:3742
translate ingles acto3_septem_continuacion2_84bfa016:

    # "Después de todo, tú le has permitido seguir con esto cuando no era necesario."
    "After all, you're the one who allowed him to go through with this when it wasn't necessary."

# game/rutas/septem.rpy:3743
translate ingles acto3_septem_continuacion2_d301915c:

    # septem "Te ves bien con ello."
    septem "It looks good on you."

# game/rutas/septem.rpy:3750
translate ingles acto3_septem_continuacion2_62609753:

    # septem "Oh."
    septem "Oh."

# game/rutas/septem.rpy:3753
translate ingles acto3_septem_continuacion2_68ad5148:

    # "Las comisuras de sus labios se levantan, intentando formar una sonrisa forzada. Al no lograrlo, las deja caer... se le ve ligeramente decepcionado."
    "The corners of his mouth lift as he tries to force a smile. When he fails, he lets them fall... he looks slightly disappointed."

# game/rutas/septem.rpy:3757
translate ingles acto3_septem_continuacion2_9dcde856:

    # septem "Está bien."
    septem "It's fine."

# game/rutas/septem.rpy:3763
translate ingles acto3_septem_continuacion2_5a8dbc5b:

    # "No hay enojo, no hay más insistencia. Septem cae en silencio y de dedica a curar tu brazo con el trozo de carne que le pertenece al escriba."
    "There's no anger, no further insistence. Septem falls silent and focuses on healing your arm with the piece of flesh belonging to the scribe."

# game/rutas/septem.rpy:3764
translate ingles acto3_septem_continuacion2_22a8beaf:

    # "Tú prestas atención a cómo lo hace. La carne actúa como una especie de adherente, que busca contacto por sí solo con tu piel. Unas pequeñas hebras, se mueven en dirección a tus heridas."
    "You pay close attention to how he does it. The flesh acts as some kind of adhesive, seeking contact with your skin on its own. Small strands move toward your wounds."

# game/rutas/septem.rpy:3765
translate ingles acto3_septem_continuacion2_f8d52a8b:

    # "No puedes mentir, es asqueroso, tanto que te obligas a aguantar la reacción natural de tu cuerpo al sentir asco. Con ojos llorosos, muerdes la lengua para evitar dejar escapar arcadas."
    "Honestly, it's disgusting--so much so that you have to force yourself to suppress your body's natural reaction to disgust. With tears in your eyes, you bite your tongue to keep yourself from gagging."

# game/rutas/septem.rpy:3766
translate ingles acto3_septem_continuacion2_85af6c44:

    # "Poco a poco, tu piel acepta cada hebra que toca, absorbiendo y adhiriendo capa tras capa para regenerar el tejido desgarrado."
    "Little by little, your skin accepts every strand that touches it, absorbing and binding layer after layer to regenerate the torn tissue."

# game/rutas/septem.rpy:3767
translate ingles acto3_septem_continuacion2_d724c675:

    # "Septem termina con una delicada palmada en la zona, comprobando el resultado de la curación. Sonríe al percibir que tu brazo se encuentra en perfectas condiciones, sin marcas o cicatrices delatantes de la antigua herida."
    "Septem finishes with a gentle pat on the area, checking the results of the healing. He beams when he sees that your arm is in perfect condition, without any marks or scars betraying the wound that was once there."

# game/rutas/septem.rpy:3778
translate ingles acto3_septem_continuacion2_3a0542d4:

    # "Paras a Septem en seco con un solo no. Le pides que no te toque con esa cosa que tiene en la mano y le recriminas lo que acaba de hacer."
    "You stop Septem in his tracks with a firm 'no.' You tell him not to touch you with that thing in his hand."

# game/rutas/septem.rpy:3779
translate ingles acto3_septem_continuacion2_57fa887e:

    # "No sabes de dónde y cómo tienes la lengua para sacar tus palabras sin titubear, pero lo logras. Le expones su actuar con la esperanza de hacerlo entrar en razón."
    "You don't know where you found the nerve to speak without stammering, but somehow, you confront him about his actions, hoping to make him see reason."

# game/rutas/septem.rpy:3780
translate ingles acto3_septem_continuacion2_559f189b:

    # "Tu cerebro bloquea la posibilidad de terminar siendo tú la su próxima víctima, así que miedo no sientes por ahora. Debe ser la adrenalina."
    "Your brain blocks out the possibility that you might end up being his next victim, so for now, you don't feel fear: It must be the adrenaline."

# game/rutas/septem.rpy:3781
translate ingles acto3_septem_continuacion2_8c7f205f:

    # "Septem guarda silencio. Sabes que te está escuchando porque sus expresiones cambian, pasando de enojo a la tristeza genuina de manera progresiva."
    "Septem remains silent. You know he's listening because his expression gradually changes, shifting from anger to genuine sadness."

# game/rutas/septem.rpy:3782
translate ingles acto3_septem_continuacion2_4cea9246:

    # "Sabes que lo has hecho entrar en razón cuando se disculpa y gira su cuerpo para caminar hacía el escriba."
    "You know you've made him see reason when he apologizes and turns to walk toward the scribe."

# game/rutas/septem.rpy:3783
translate ingles acto3_septem_continuacion2_36f3e192:

    # "Si bien, Septem no pide perdón a la entidad, hace tronar sus dedos para devolverle los brazos y lengua a la criatura."
    "Although Septem doesn't apologize to the entity, he snaps his fingers to restore the creature's arms and tongue."

# game/rutas/septem.rpy:3784
translate ingles acto3_septem_continuacion2_10850f73:

    # "Esta al instante comienza a pedir perdón a Septem y a ti, y a pedir algún tipo de castigo que tu decides ignorar completamente."
    "The creature immediately begins apologizing to both you and Septem, begging for some kind of punishment, which you decide to ignore completely."

# game/rutas/septem.rpy:3785
translate ingles acto3_septem_continuacion2_3bda1fed:

    # "Al no aguantar el insistente parloteo del escriba, Septem truena una vez más los dedos y este desaparece."
    "Unable to stand the scribe's incessant babbling, Septem snaps his fingers once more, and the creature disappears."

# game/rutas/septem.rpy:3786
translate ingles acto3_septem_continuacion2_5d0c9a7a:

    # "No alcanzas a preguntas cuando el te responde, sin ánimos."
    "Before you can even ask, he answers you, sounding dispirited."

# game/rutas/septem.rpy:3790
translate ingles acto3_septem_continuacion2_b9576b5d:

    # septem "Le he quitado el sello."
    septem "I've removed the seal."

# game/rutas/septem.rpy:3791
translate ingles acto3_septem_continuacion2_cd2b533e:

    # septem "Ha vuelto con los demás invitados."
    septem "It's returned to the other guests."

# game/rutas/septem.rpy:3792
translate ingles acto3_septem_continuacion2_121a9ae5:

    # "Se produce un silencio incómodo, del cual no sabes cómo llenar."
    "An awkward silence settles between you, and you don't know how to fill it."

# game/rutas/septem.rpy:3796
translate ingles acto3_septem_continuacion2_1f5c5cbb:

    # septem "[nombrejugador]..."
    septem "[nombrejugador]..."

# game/rutas/septem.rpy:3797
translate ingles acto3_septem_continuacion2_3b53bb5c:

    # "Es Septem quien da el primer paso, buscando tu mirada. Sus cejas curvadas denotan arrepentimiento."
    "Septem is the one who takes the first step, seeking your gaze. The curve of his eyebrows betrays his regret."

# game/rutas/septem.rpy:3798
translate ingles acto3_septem_continuacion2_00c625e0:

    # septem "¿Me he equivocado? ¿el castigo no era necesario?"
    septem "Was I wrong? Was the punishment unnecessary?"

# game/rutas/septem.rpy:3799
translate ingles acto3_septem_continuacion2_74677130:

    # "Tiempo te falta para poder responderle. Septem no deja que lo hagas pues pregunta nuevamente, sin lograr entender tu razonamiento aún."
    "You barely have time to respond. Septem doesn't let you, asking another question before you can answer, still unable to understand your reasoning."

# game/rutas/septem.rpy:3800
translate ingles acto3_septem_continuacion2_56d48154:

    # septem "Si no corregimos esto ahora, el resto intentará lo mismo contigo."
    septem "If we don't correct this now, the others will try to do the same to you."

# game/rutas/septem.rpy:3801
translate ingles acto3_septem_continuacion2_0bcbb571:

    # septem "Eres vulnerable."
    septem "You're vulnerable."

# game/rutas/septem.rpy:3802
translate ingles acto3_septem_continuacion2_7620c303:

    # septem "Debo cuidarte."
    septem "I must protect you."

# game/rutas/septem.rpy:3805
translate ingles acto3_septem_continuacion2_78e11af2:

    # "Le explicar que actuar con tanta violencia no sería propio de un líder. Septem bufa, harto de tus sermones."
    "You explain to him that acting with such violence is unbecoming of a leader. Septem scoffs, fed up with your lectures."

# game/rutas/septem.rpy:3806
translate ingles acto3_septem_continuacion2_97ca0ec0:

    # "Agregas qué él mismo le ha pedido a Sextam hace unos días que lo detuviera si dañaba a alguien, y eso es lo que por fin lo hace reaccionar."
    "You add that he, himself, asked Sextam just a few days ago to stop him if he ever hurt someone. That's what finally makes him react."

# game/rutas/septem.rpy:3807
translate ingles acto3_septem_continuacion2_17ab9a8d:

    # "Te devuelve la mirada con los ojos abiertos de par en par. Hay un brillo singular en sus ojos, uno que es fácil pasar desapercibido, pero que está ahí."
    "He looks back at you, his eyes wide open. There's a peculiar glimmer in them, one that's easy to overlook, but it's there."

# game/rutas/septem.rpy:3808
translate ingles acto3_septem_continuacion2_1a5b875f:

    # "Luego de ello, hay solo quietud. Un tiempo muerto en donde Septem se queda solo con sus pensamientos, ordenando sus ideas y cambiando ciertas convicciones."
    "After that, there's nothing but stillness in which Septem is left alone with his thoughts, sorting through his ideas and reconsidering certain convictions."

# game/rutas/septem.rpy:3809
translate ingles acto3_septem_continuacion2_31924e0f_1:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:3814
translate ingles acto3_septem_continuacion2_6d8bb281:

    # septem "Tienes razón."
    septem "You're right."

# game/rutas/septem.rpy:3816
translate ingles acto3_septem_continuacion2_1d7052ae:

    # septem "Gracias por parar mis acciones."
    septem "Thank you for stopping me."

# game/rutas/septem.rpy:3820
translate ingles acto3_septem_continuacion2_31924e0f_2:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:3821
translate ingles acto3_septem_continuacion2_44d2c9fd:

    # septem "No puedes hacerlo, mi Creador."
    septem "You can't do that, my Creator."

# game/rutas/septem.rpy:3822
translate ingles acto3_septem_continuacion2_04c0adc3:

    # septem "Ya te lo dije, tu poder aún no se a liberado por completo."
    septem "I've already told you, your power hasn't been fully unleashed yet."

# game/rutas/septem.rpy:3823
translate ingles acto3_septem_continuacion2_3496765a:

    # septem "Eres vulnerable..."
    septem "You're vulnerable..."

# game/rutas/septem.rpy:3824
translate ingles acto3_septem_continuacion2_a9b30ea1:

    # "Septem pausa por unos segundos, meditando sus próximas palabras."
    "Septem pauses for a few seconds, carefully considering his next words."

# game/rutas/septem.rpy:3825
translate ingles acto3_septem_continuacion2_fe9bd52a:

    # septem "Buscaré otra forma de cuidarte."
    septem "I'll find another way to protect you."

# game/rutas/septem.rpy:3826
translate ingles acto3_septem_continuacion2_f2f8c6ac:

    # septem "Sin violencia..."
    septem "Without violence..."

# game/rutas/septem.rpy:3827
translate ingles acto3_septem_continuacion2_9c7a7635:

    # "Se le oye arrepentido, hasta podrías decir que hay algo de vergüenza metida por ahí en sus palabras."
    "He sounds remorseful. You could even say there's a hint of shame hidden somewhere in his words."

# game/rutas/septem.rpy:3834
translate ingles acto3_septem_continuacion2_8d0425f4:

    # "Septem se toma un tiempo prudente antes de romper el sello, todo con tal de volver más tranquilo y compuesto. Tú lo agradeces, porque sabes que también necesitas un momento de quietud."
    "Septem takes his time before breaking the seal, wanting to return feeling calmer and more composed. You're grateful for it, knowing that you also need a moment of peace."

# game/rutas/septem.rpy:3835
translate ingles acto3_septem_continuacion2_4f9af7ce:

    # "En el silencio, juegas con los bordes de las mangas para organizar tus ideas. Deseas preguntar más, pero no te salen las palabras de la boca, ni sabes qué preguntar con exactitud."
    "In the silence, you fiddle with the edges of your sleeves, trying to organize your thoughts. You want to ask more questions, but the words won't come out, and you don't even know exactly what to ask."

# game/rutas/septem.rpy:3836
translate ingles acto3_septem_continuacion2_5a506c25:

    # "Luego de un tiempo, ambos están listos para volver."
    "After a while, you're both ready to return."

# game/rutas/septem.rpy:3842
translate ingles acto3_septem_continuacion2_0c3e6602:

    # "Tu alrededor no se perturba, ni cambia en lo más mínimo; más bien los invitados se materializan al momento en que las palmas de Septem chocan entre sí."
    "Your surroundings remain undisturbed, without changing in the slightest. Instead, the guests materialize the moment Septem brings his palms together."

# game/rutas/septem.rpy:3843
translate ingles acto3_septem_continuacion2_64ea0f7d:

    # "El sonido de murmullos incomprensibles y risas estridentes invade tus oídos, distrayéndote por un instante de Septem."
    "The sound of unintelligible murmurs and shrill laughter floods your ears, distracting you from Septem for a moment."

# game/rutas/septem.rpy:3844
translate ingles acto3_septem_continuacion2_8c8a98ef:

    # "Él viendo aquello, toma tu mano, evitando que puedas perderte o quedarte atrás. Así es como se abren paso ante la multitud."
    "Seeing this, he takes your hand, making sure you don't get lost or fall behind. That's how you make your way through the crowd."

# game/rutas/septem.rpy:3845
translate ingles acto3_septem_continuacion2_08ebb46a:

    # septem "Ya estamos listos."
    septem "We're ready now."

# game/rutas/septem.rpy:3846
translate ingles acto3_septem_continuacion2_260cb5a2:

    # septem "No me sueltes."
    septem "Don't let go of me."

# game/rutas/septem.rpy:3847
translate ingles acto3_septem_continuacion2_aa008161:

    # "Te informa, mientras sigues el ritmo de sus pies. Él es quien te conduce y tú te dejas llevar, sin conocimiento del lugar al cual estás siendo arrastrado."
    "He tells you as you match the rhythm of his steps. He's the one leading you, and you let yourself be guided, unaware of where you're being taken."

# game/rutas/septem.rpy:3848
translate ingles acto3_septem_continuacion2_2b283f19:

    # "Te mareas de golpe, la coordinación entre piernas y cuerpo comienza a diluirse. Te es complejo sincronizar tus movimientos para estar a la par de Septem."
    "A sudden wave of dizziness hits you, and the coordination between your legs and the rest of your body begins to falter. You struggle to synchronize your movements and keep pace with Septem."

# game/rutas/septem.rpy:3849
translate ingles acto3_septem_continuacion2_116bf6fb:

    # "Sientes las náuseas asomarse por la boca de tu estómago, pero te cuesta encontrar el por qué te sientes así. Hasta que lo ves..."
    "You feel nausea rising from the pit of your stomach, but you can't quite figure out why you're feeling this way. Until you see it..."

# game/rutas/septem.rpy:3853
translate ingles acto3_septem_continuacion2_d085c176:

    # "El espacio lentamente se convierte en un espacio que no puedes explicar con palabras. Flotas y caes a la par, con el cuerpo pesado y ligero a la vez."
    "The space around you slowly transforms into something you can't describe with words. You float and fall at the same time, your body feeling both heavy and weightless."

# game/rutas/septem.rpy:3854
translate ingles acto3_septem_continuacion2_e3dc3e3e:

    # "Es extraño..."
    "It's strange..."

# game/rutas/septem.rpy:3855
translate ingles acto3_septem_continuacion2_f2b06c2f:

    # "Entre paso y paso sientes que pierdes la conexión con la realidad. Es como si te hundieras en el espacio, debiendo saltar de estrella en estrella para no perder el rumbo. Al hacer contacto con ellas, explotan formando nebulosas."
    "With every step, you feel yourself losing touch with reality. It's as if you're sinking into space, forced to leap from star to star to keep from losing your way. When you touch them, they explode into nebulae."

# game/rutas/septem.rpy:3856
translate ingles acto3_septem_continuacion2_bd6512e0:

    # "Colores que jamás has tenido el atrevimiento de imaginar, decoran la escena, cambiando con cada movimiento y contacto de tus pies con la superficie."
    "Colors you've never even dared to imagine fill the scene, shifting with every movement and every touch of your feet against the surface."

# game/rutas/septem.rpy:3857
translate ingles acto3_septem_continuacion2_1f8ca195:

    # "Parece un sueño. Uno que te atrapa con cada parpadeo y demanda que cierres los ojos permanentemente."
    "It feels like a dream; one that draws you in with every blink, demanding that you close your eyes forever."

# game/rutas/septem.rpy:3858
translate ingles acto3_septem_continuacion2_139cf597:

    # "Lo único que no te lo permite es Septem. Sus ojos te buscan cada que siente que estás por perder el conocimiento. Esos ojos verdosos son lo que te mantiene consciente, atrapan la mirada y te devuelven al presente."
    "The only thing keeping you from doing so is Septem. His eyes seek yours whenever he senses you're about to lose consciousness. Those verdant eyes are what keep you conscious, holding your gaze and pulling you back to the present."

# game/rutas/septem.rpy:3866
translate ingles acto3_septem_continuacion2_2cd0fe93:

    # "Un parpadeo más y tu destino aparece frente a ti. Es una especie de podio conformado con columnas que lo elevan del oscuro espacio en el que permaneces."
    "One more blink, and your destination appears before you. It's a kind of podium supported by columns that raise it above the dark space surrounding you."

# game/rutas/septem.rpy:3871
translate ingles acto3_septem_continuacion2_1503ff05:

    # "Otro parpadeo y ahora estás siendo exhibido en el. Hay un centenar de ojos puestos en ti, que miran, devorando tu pequeña silueta."
    "Another blink, and now you're on display atop it. Hundreds of eyes are fixed on you, watching, devouring your small figure with their gaze."

# game/rutas/septem.rpy:3872
translate ingles acto3_septem_continuacion2_1f5c5cbb_1:

    # septem "[nombrejugador]..."
    septem "[nombrejugador]..."

# game/rutas/septem.rpy:3876
translate ingles acto3_septem_continuacion2_9d665194:

    # "Septem sigue a tu lado, su voz te lo confirma, aunque... ha perdido su figura humana."
    "Septem is still by your side, his voice confirms it, although... he's lost his human form."

# game/rutas/septem.rpy:3877
translate ingles acto3_septem_continuacion2_06160478:

    # "No te asustas por lo chocante de su nueva apariencia, incluso, te sientes más protegido así. Con tantos ojos sobre ti, Septem parece estar más capacitado con esa forma para resguardar tu seguridad ante cualquier inconveniente."
    "You're not frightened by how shocking his new appearance is. In fact, you feel safer this way. With so many eyes upon you, Septem seems better equipped in this form to protect you from anything that might happen."

# game/rutas/septem.rpy:3878
translate ingles acto3_septem_continuacion2_161c482a:

    # "Sabes que tienes que mirar al frente, más no puedes despegar tu mirada del dios que tiene por nombre Septem."
    "You know you should be looking straight ahead, but you can't tear your attention away from the god known as Septem."

# game/rutas/septem.rpy:3879
translate ingles acto3_septem_continuacion2_12d72cf8:

    # "Septem habla sin apuro. Es un discurso que tu no prestas atención. Apenas puedes mantenerte consciente, no hay cómo puedas captar todo el discurso que expulsa su lengua."
    "Septem speaks without hurry. It's a speech you pay no attention to. You can barely stay conscious, let alone take in every word that leaves his mouth."

# game/rutas/septem.rpy:3880
translate ingles acto3_septem_continuacion2_52cdcf2b:

    # "Con todas tus fuerzas te concentras para entender lo que habla. Y lo que llega a tus oídos te hace enrojecer del pudor."
    "You concentrate with all your might to understand what he's saying. And what reaches your ears makes you blush with embarrassment."

# game/rutas/septem.rpy:3881
translate ingles acto3_septem_continuacion2_cd070e0a:

    # "Él se declara tu vasallo. Lo dice sin reparo o vergüenza por rebajar su rango ante miles de ojos hambrientos de más palabras."
    "He declares himself your 'vassal.' He says it without hesitation or shame, despite lowering his rank before thousands of eyes hungry for more."

# game/rutas/septem.rpy:3882
translate ingles acto3_septem_continuacion2_7c9d7484:

    # "Lo miras con intensidad, olvidando como comprender sus palabras nuevamente. Hay algo hipnotizante en su figura, que no puedes explicar."
    "You stare at him intently, once again forgetting how to comprehend his words. You find there's something inexplicably hypnotic about his form."

# game/rutas/septem.rpy:3883
translate ingles acto3_septem_continuacion2_61f36e30:

    # "Él es hermoso, belleza verdadera que no puede compararse a los estándares mundanos, ligados a la carne. Su halo abraza su figura, robando las miradas con lo deslumbrante de su composición similar al oro. Sus siete ojos están acompañados por alas que dan la ilusión de ser pestañas, sin llegar a serlo realmente."
    "He's stunning, a true beauty that cannot be compared to mundane standards bound to the flesh. His halo embraces his form, drawing every gaze with its dazzling, gold-like composition. His seven eyes are adorned with wings that give the illusion of eyelashes, without actually being them."

# game/rutas/septem.rpy:3884
translate ingles acto3_septem_continuacion2_e59481d2:

    # "Quieres tocarlo, sentir su forma, extender tus brazos y hundirte en él. Pero te aguantas."
    "You want to touch him, feel his form, stretch out your arms and sink into him... but you restrain yourself."

# game/rutas/septem.rpy:3885
translate ingles acto3_septem_continuacion2_91a1ca9e:

    # "Tienes que quedarte quieto y sonreír. Estar presentable ante los demás, como un plato de exposición al que nadie puede tocar. Solo admirar."
    "You have to stay still and smile; look presentable before the others, like a dish on display that no one is allowed to touch--only admire."

# game/rutas/septem.rpy:3889
translate ingles acto3_septem_continuacion2_8b3c2604:

    # "Y lo logras. Ya sea por las palabras de Septem o por lo atractivo de tu naturaleza semihumana, las entidades festejan recitando cánticos angelicales."
    "And you manage it. Whether because of Septem's words or the allure of your semi-human nature, the entities celebrate by chanting angelic hymns."

# game/rutas/septem.rpy:3890
translate ingles acto3_septem_continuacion2_798f9596:

    # "Septem los calla sin hablar. No sabes cómo lo ha hecho, pero con un solo movimiento de su cuerpo, el público ha vuelto al silencio."
    "Septem silences them without speaking. You don't know how he does it, but with a single movement of his body, the audience falls quiet once more."

# game/rutas/septem.rpy:3892
translate ingles acto3_septem_continuacion2_0297fee2:

    # septem "Vienen tiempos de cambios."
    septem "Times of change are coming."

# game/rutas/septem.rpy:3893
translate ingles acto3_septem_continuacion2_7da33ebe:

    # septem "Hoy, ante todo el Jardín, romperé un sello impuesto por siglos."
    septem "Today, before the entire Garden, I will break a seal that has endured for centuries."

# game/rutas/septem.rpy:3894
translate ingles acto3_septem_continuacion2_98ba393e:

    # septem "El dominio del Seis será liberado."
    septem "The Domain of Six shall be freed."

# game/rutas/septem.rpy:3895
translate ingles acto3_septem_continuacion2_9b756766:

    # septem "Y la maldición que les prohíbe albergar humanos--- queda abolida."
    septem "And the curse that forbids them from harboring humans--is hereby abolished."

# game/rutas/septem.rpy:3896
translate ingles acto3_septem_continuacion2_82b34733:

    # "Hay movimiento en el podio. Otra entidad da un paso al frente, asumes que es Sextam. No puedes identificarla, ya que, al igual que Septem, su forma ha dejado de ser humanoide."
    "There's movement on the podium. Another entity steps forward, and you assume it's Sextam. You can't identify her, since, like Septem, her form is no longer humanoid."

# game/rutas/septem.rpy:3900
translate ingles acto3_septem_continuacion2_2069b6d4:

    # "Sin embargo, su figura no es sólida. Es una llama que titila débil ante todos los presentes. A su centro se ve una esfera sellada por ramas de una sustancia viscosa que la cubren como si de una jaula se tratase."
    "She's a flame that flickers faintly before everyone present. At its center, you can see a sphere sealed by branching strands of a viscous substance that surround it like a cage."

# game/rutas/septem.rpy:3901
translate ingles acto3_septem_continuacion2_9d2103d0:

    # "Eso debe ser el sello."
    "That must be the seal."

# game/rutas/septem.rpy:3902
translate ingles acto3_septem_continuacion2_ed0bfe91:

    # "La voz de Septem vuelve a monopolizar todo el lugar, declamando cánticos que para un humano serían imposibles de reproducir. Tu cuerpo comienza a vibrar por los tonos y vibraciones del cántico; es una frecuencia que te toma y viaja por cada célula de tu organismo."
    "Septem's voice once again fills the entire space, reciting chants that would be impossible for a human to reproduce. Your body begins to vibrate with the tones and resonances of the chant; its frequency takes hold of you and journeys through every cell in your body."

# game/rutas/septem.rpy:3903
translate ingles acto3_septem_continuacion2_43690d67:

    # "No duele. No es placentero. Simplemente está ahí."
    "It doesn't hurt. It isn't pleasant. It's simply there."

# game/rutas/septem.rpy:3904
translate ingles acto3_septem_continuacion2_98343f2c:

    # "Los cánticos ceden cuando lo que recubre la esfera se derrite, esfumándose cuando toca el suelo."
    "The chanting fades as the substance covering the sphere melts away, vanishing as it touches the ground."

# game/rutas/septem.rpy:3908
translate ingles acto3_septem_continuacion2_46cbc675:

    # "Sin esa atadura, la llama que protege la esfera crece cuatro veces su tamaño."
    "Without that restraint, the flame protecting the sphere expands to four times its original size."

# game/rutas/septem.rpy:3909
translate ingles acto3_septem_continuacion2_62c486a6:

    # "Resultando en una llama que va danzando con el viento, tomando formas y caras humanas dentro de su ser."
    "The result is a flame that dances with the wind, taking on human shapes and faces within itself."

# game/rutas/septem.rpy:3910
translate ingles acto3_septem_continuacion2_6625a8f0:

    # "Es grotesco y fascinante a la vez. No puedes dejar de mirarla."
    "It's grotesque and fascinating at the same time: You can't stop staring at it."

# game/rutas/septem.rpy:3911
translate ingles acto3_septem_continuacion2_5166c9de:

    # "Sextam ha obtenido nuevamente su poder."
    "Sextam has regained her power."

# game/rutas/septem.rpy:3915
translate ingles acto3_septem_continuacion2_1bf864f1:

    # "Septem deja que su público deje de festejar para terminar con su discurso."
    "Septem waits for his audience to finish celebrating before concluding his speech."

# game/rutas/septem.rpy:3916
translate ingles acto3_septem_continuacion2_3ca75e03:

    # septem "Con esto, nos declaramos un imperio independiente de todo lo que Padre representa."
    septem "With this, we declare ourselves an empire independent of everything Father represents."

# game/rutas/septem.rpy:3917
translate ingles acto3_septem_continuacion2_b72b42af:

    # septem "Tendremos siete días para reconstruir este lugar, eliminando cada elemento ligado a Él."
    septem "We will have seven days to rebuild this place, removing every element connected to Him."

# game/rutas/septem.rpy:3918
translate ingles acto3_septem_continuacion2_5bba7bd6:

    # septem "Nunca más tendremos que aguantar el abandono y la miseria por manos irresponsables que no nos ven como a un todo."
    septem "Never again will we have to endure abandonment and misery at the hands of those who irresponsibly fail to see us as a whole."

# game/rutas/septem.rpy:3919
translate ingles acto3_septem_continuacion2_085d317c:

    # septem "A partir de hoy, nos moveremos hacia el cambio."
    septem "From this day forward, we will move toward change."

# game/rutas/septem.rpy:3920
translate ingles acto3_septem_continuacion2_774bfafb:

    # septem "Hoy aceptamos el primer paso para traspasar nuestro mundo a un Creador presente."
    septem "Today, we take the first step toward entrusting our world to a Creator who is present."

# game/rutas/septem.rpy:3921
translate ingles acto3_septem_continuacion2_718a6e60:

    # septem "Desde hoy responderán a [nombrejugador] como amo y señor de este lugar."
    septem "From this day forward, you shall answer to [nombrejugador] as the lord and master of this place."

# game/rutas/septem.rpy:3922
translate ingles acto3_septem_continuacion2_240d1632:

    # septem "Y yo, su único vasallo, representante de su palabra."
    septem "And I, their sole vassal, the representative of their word."

# game/rutas/septem.rpy:3923
translate ingles acto3_septem_continuacion2_6b9c126c:

    # "Quieres sonreír, decir algunas palabras tal vez, pero tu cuerpo no da más."
    "You want to smile, perhaps say a few words, but your body can't take any more."

# game/rutas/septem.rpy:3927
translate ingles acto3_septem_continuacion2_2582dfb7:

    # "Pierdes el conocimiento en el lugar."
    "You lose consciousness right there."

# game/rutas/septem.rpy:3931
translate ingles acto3_septem_continuacion2_a20cefa7_3:

    # "..."
    "..."

# game/rutas/septem.rpy:3932
translate ingles acto3_septem_continuacion2_aa72307c:

    # "___________"
    "___________"

# game/rutas/septem.rpy:3938
translate ingles acto3_septem_continuacion2_d22b55d6:

    # "Tu consciencia se ve atrapada con el subconsciente de Septem de nuevo."
    "Your consciousness becomes entangled with Septem's subconscious once again."

# game/rutas/septem.rpy:3939
translate ingles acto3_septem_continuacion2_7217961a:

    # "Esperas las mismas sensaciones de siempre... desesperación al no poder conseguir lo que buscas; Cansancio; o incluso, miedo... "
    "You expect the same feelings as always... despair at being unable to obtain what you seek; exhaustion; or even fear... "

# game/rutas/septem.rpy:3940
translate ingles acto3_septem_continuacion2_f8f71743:

    # "Hoy no es uno de esos días."
    "Today is not one of those days."

# game/rutas/septem.rpy:3941
translate ingles acto3_septem_continuacion2_55a8bded:

    # "Hoy te sientes ligero, libre y contento."
    "Today, you feel light, free, and happy."

# game/rutas/septem.rpy:3942
translate ingles acto3_septem_continuacion2_19505c05:

    # "Hay calidez a tu alrededor, acariciando tu cuerpo e invitándolo a echarse en un lecho de telas suaves, para descansar."
    "There's warmth all around you, caressing your body and inviting you to lie down on a bed of soft fabrics and rest."

# game/rutas/septem.rpy:3943
translate ingles acto3_septem_continuacion2_75bdc459:

    # "Por fin puedes hacerlo. Por fin puedes dejar escapar ese suspiro que guarda todo el trabajo y esfuerzo que has puesto en esta misión."
    "You can finally do it--let out that sigh holding all the work and effort you've poured into this mission."

# game/rutas/septem.rpy:3944
translate ingles acto3_septem_continuacion2_e0413f50:

    # "Estás feliz con todo lo que tienes hasta ahora. Con cada pequeño cambio que ha ocurrido hasta la fecha."
    "You're happy with everything you have so far and with every little change that has taken place up to this point."

# game/rutas/septem.rpy:3945
translate ingles acto3_septem_continuacion2_7d0b7127:

    # "Pero cuando miras tu reflejo en el cielo, algo no cuadra."
    "But when you look at your reflection in the sky, something doesn't feel right."

# game/rutas/septem.rpy:3946
translate ingles acto3_septem_continuacion2_8b2b4df5:

    # "Ya hace un tiempo que te has sentido así."
    "You've been feeling this way for a while now."

# game/rutas/septem.rpy:3947
translate ingles acto3_septem_continuacion2_b7c39438:

    # "Y crees que es momento de cambiar."
    "And you believe it's time for a change."

# game/rutas/septem.rpy:3948
translate ingles acto3_septem_continuacion2_6470fe30:

    # "Septem quiere cambiar."
    "Septem wants to change."

# game/rutas/septem.rpy:3949
translate ingles acto3_septem_continuacion2_a20cefa7_4:

    # "..."
    "..."

# game/rutas/septem.rpy:3950
translate ingles acto3_septem_continuacion2_8ba66edb:

    # "Cuando lo veas, hablarás con él. Conversarás de su identidad y cómo su apariencia también es algo que debería sentir propio. No algo ajeno o separado de él."
    "When you see him, you'll talk to him. You'll discuss his identity and how his appearance should also be something he feels is his own, not something foreign or separate from him."

# game/rutas/septem.rpy:3951
translate ingles acto3_septem_continuacion2_233edb56:

    # "Esperas una larga conversación, y alguna que otra negativa por su parte."
    "You expect a long conversation, and perhaps a few objections from him."

# game/rutas/septem.rpy:3952
translate ingles acto3_septem_continuacion2_663d55b7:

    # "Pero por ahora te dedicas a descansar."
    "But for now, you focus on resting."

# game/rutas/septem.rpy:3953
translate ingles acto3_septem_continuacion2_a20cefa7_5:

    # "..."
    "..."

# game/rutas/septem.rpy:3954
translate ingles acto3_septem_continuacion2_d47632bc:

    # septem "[nombrejugador]."
    septem "[nombrejugador]."

# game/rutas/septem.rpy:3958
translate ingles acto3_septem_continuacion2_b3610a72:

    # "Tus ojos se abren, liberándote de la conexión entre el mundo interior de Septem y tú. Quieres volver ahí, seguir descansando junto a esa sensación de triunfo, regocijado con todo lo que te rodea."
    "Your eyes open, freeing you from the connection between Septem's inner world and yourself. You want to go back there to keep resting with that feeling of triumph and basking in everything that surrounds you."

# game/rutas/septem.rpy:3959
translate ingles acto3_septem_continuacion2_f738dc2f:

    # "Aquí, todo lo que sientes es pesadez. Tu cuerpo es pesado; tus párpados, caen por el cansancio; hasta respirar sale con pesadez."
    "Here, all you feel is heaviness. Your body feels heavy; your eyelids droop with exhaustion; even breathing feels like a struggle."

# game/rutas/septem.rpy:3963
translate ingles acto3_septem_continuacion2_c461757f:

    # "Dejas caer tus párpados con la esperanza de volver a ese lugar onírico, decidiendo ignorar a Septem."
    "You let your eyelids fall, hoping to return to that dreamlike place, choosing to ignore Septem."

# game/rutas/septem.rpy:3966
translate ingles acto3_septem_continuacion2_ff9f229f:

    # septem "Mi salvador."
    septem "My savior."

# game/rutas/septem.rpy:3967
translate ingles acto3_septem_continuacion2_68d2e080:

    # "Dice con más insistencia, endureciendo su voz."
    "He says more insistently, his voice growing firmer."

# game/rutas/septem.rpy:3968
translate ingles acto3_septem_continuacion2_fb51cfd3:

    # "Balbuceas en respuesta, ni tú sabes muy bien lo que le estás pidiendo. Aun así, Septem no se deja doblegar y coloca su mano en tu hombro. No te mueve ni da palmadas, solo está ahí, reposando su peso en tu cuerpo."
    "You mumble in response, not even sure what you're asking of him. Even so, Septem refuses to give in and places his hand on your shoulder. He doesn't shake you or pat you, it's simply there, resting its weight against your body."

# game/rutas/septem.rpy:3970
translate ingles acto3_septem_continuacion2_402d19d5:

    # septem "Les he dado a todo el Jardín un día para organizar los preparativos. Para que mañana comencemos con la inspección de cada dominio."
    septem "I've given everyone in the Garden one day to make the necessary preparations, so that tomorrow we can begin inspecting each domain."

# game/rutas/septem.rpy:3971
translate ingles acto3_septem_continuacion2_da4ef4f6:

    # septem "Te dejaré dormir todo el día si quieres, pero antes necesito conversar contigo acerca de Madre."
    septem "I'll let you sleep all day if you wish, but first, I need to speak with you about Mother."

# game/rutas/septem.rpy:3975
translate ingles acto3_septem_continuacion2_77276328:

    # "Aquello es más que suficiente para despertarte por completo. Pestañeas un par de veces para acostumbrar tu vista a la iluminación cegadora de la habitación."
    "That's more than enough to wake you up completely. You blink a few times to adjust your eyes to the blinding light in the room."

# game/rutas/septem.rpy:3976
translate ingles acto3_septem_continuacion2_a3070807:

    # "Te estiras mientras buscas a Septem."
    "You stretch as you look for Septem."

# game/rutas/septem.rpy:3981
translate ingles acto3_septem_continuacion2_cc9a5909_1:

    # "!!!"
    "!!!"

# game/rutas/septem.rpy:3982
translate ingles acto3_septem_continuacion2_09fea123:

    # "¡¿HUH?!"
    "HUH?!"

# game/rutas/septem.rpy:3983
translate ingles acto3_septem_continuacion2_a8c47252:

    # "¿Ese es...?"
    "Is that...?"

# game/rutas/septem.rpy:3987
translate ingles acto3_septem_continuacion2_fdc64f95:

    # "Sin creerlo, posas tus ojos en la figura que tienes al frente, sentada a los pies de la cama. Él te devuelve la mirada con normalidad."
    "In disbelief, you stare at the figure sitting at the foot of the bed. He looks back at you as if nothing were out of the ordinary."

# game/rutas/septem.rpy:3988
translate ingles acto3_septem_continuacion2_2049bbd2:

    # "Sin hacer un escándalo o una escena por este cambio de forma."
    "Without making a fuss or a scene."

# game/rutas/septem.rpy:3989
translate ingles acto3_septem_continuacion2_3c867d38:

    # "La figura que tienes al frente te observa como Septem siempre lo hace. Su olor sigue siendo el mismo, al igual que su aura."
    "The figure watches you the way Septem always does. His scent remains the same, as does his aura."

# game/rutas/septem.rpy:3990
translate ingles acto3_septem_continuacion2_a76f2d25:

    # "La figura que tiene al frente te sonríe como lo Septem siempre lo hace, sin mostrar los dientes y entrecerrando levemente los ojos."
    "He smiles at you the way Septem always does, without showing his teeth and with his eyes slightly narrowed."

# game/rutas/septem.rpy:3991
translate ingles acto3_septem_continuacion2_8f0ed0c5:

    # "Es Septem. Aunque con un exterior distinto."
    "It's Septem... though with a different appearance."

# game/rutas/septem.rpy:3992
translate ingles acto3_septem_continuacion2_cb088cff:

    # "No es que ha cambiado mucho, sigue en posesión de ese aire tan suyo. Mismo gusto en estilo también. Cabello similar, ojos tiernos y semblante que no se permite estar relajado por mucho tiempo."
    "It's not that he's changed much. He still carries that unmistakable air of his. His taste in style remains the same, too. Similar hair, gentle eyes, and an expression that never allows itself to relax for too long."

# game/rutas/septem.rpy:3993
translate ingles acto3_septem_continuacion2_13e503f4:

    # "Ha cambiado."
    "But he's changed."

# game/rutas/septem.rpy:3994
translate ingles acto3_septem_continuacion2_7ebfa075:

    # "Se ve distinto... y a la vez no."
    "He looks different... and yet, really, he doesn't."

# game/rutas/septem.rpy:3995
translate ingles acto3_septem_continuacion2_9e198409:

    # "Ha dejado de lado la cara e identidad de Rafael, aunque su nuevo rostro bebe de la matriz que fue su antigua identidad."
    "He's left Rafael's face and identity behind, although his new face still draws from the foundation of his former identity."

# game/rutas/septem.rpy:3996
translate ingles acto3_septem_continuacion2_08b6ee5e:

    # "No lo ha descartado por completo, sigue reconociendo rasgos que los toma como suyos. Solo que esta vez se ha aventurado a alejarse un poquito más."
    "He hasn't discarded it entirely. He still recognizes certain features as his own. It's just that this time, he's dared to stray a little further."

# game/rutas/septem.rpy:3997
translate ingles acto3_septem_continuacion2_3454030e:

    # "Lo contemplas por unos segundos antes de reaccionar."
    "You gaze at him for a few seconds before reacting."

# game/rutas/septem.rpy:4002
translate ingles acto3_septem_continuacion2_efa4e52e:

    # "Le saludas con un 'buenos días', despacito para no forzar tu voz, a sabiendas de que en la mañana esta tiende a ser ronca y dura."
    "You greet him with a soft 'good morning', careful not to strain your voice, knowing how hoarse it can be in the morning."

# game/rutas/septem.rpy:4003
translate ingles acto3_septem_continuacion2_bd0b519c:

    # "Septem al escuchar tu saludo, su rostro te devuelve el gesto. Comisuras del labio suben y aparecen líneas de expresión en sus ojos que indican una sonrisa genuina."
    "Upon hearing your greeting, Septem returns the gesture. The corners of his mouth lift, and little creases appear around his eyes, revealing a genuine smile."

# game/rutas/septem.rpy:4004
translate ingles acto3_septem_continuacion2_33c0981a:

    # septem "Buenos días."
    septem "Good morning."

# game/rutas/septem.rpy:4005
translate ingles acto3_septem_continuacion2_4f94a8e4:

    # septem "Espero que hayas descansado lo que necesitas."
    septem "I hope you've gotten the rest you need."

# game/rutas/septem.rpy:4010
translate ingles acto3_septem_continuacion2_6e10bdcb:

    # "Acercas tu mano a su rostro y esperas. Preguntando con tu silencio si él te da el permiso de poder tocarlo."
    "You bring your hand closer to his face and wait. Silently asking for his permission to touch him."

# game/rutas/septem.rpy:4011
translate ingles acto3_septem_continuacion2_fa9386a8:

    # "Él te mira con sorpresa, la cual borra al instante después de comprobar que no estás invadiendo su espacio personal sin consultar antes."
    "He looks at you in surprise, but the expression vanishes as soon as he realizes you're not invading his personal space without asking first."

# game/rutas/septem.rpy:4012
translate ingles acto3_septem_continuacion2_6d6fd56f:

    # nj "Tu rostro..."
    nj "Your face..."

# game/rutas/septem.rpy:4016
translate ingles acto3_septem_continuacion2_a93fd73b:

    # septem "Necesito una nueva imagen."
    septem "I need a new image."

# game/rutas/septem.rpy:4017
translate ingles acto3_septem_continuacion2_e270579b:

    # "Tú no respondes al instante, prefieres calla y medir tus palabras primero."
    "You don't respond right away, preferring to remain silent and choose your words carefully first."

# game/rutas/septem.rpy:4018
translate ingles acto3_septem_continuacion2_42842a14:

    # "Ante tu silencio, Septem agrega, explicando su decisión."
    "Faced with your silence, Septem continues, explaining his decision."

# game/rutas/septem.rpy:4019
translate ingles acto3_septem_continuacion2_b498c3f3:

    # septem "El rostro de Rafael no me pertenece."
    septem "Rafael's face doesn't belong to me."

# game/rutas/septem.rpy:4020
translate ingles acto3_septem_continuacion2_878f9842:

    # septem "Y el Jardín lo asocia a un cuerpo humano."
    septem "And the Garden associates it with a human body."

# game/rutas/septem.rpy:4021
translate ingles acto3_septem_continuacion2_5d094fb5:

    # septem "Eso no me sirve."
    septem "That doesn't work for me."

# game/rutas/septem.rpy:4024
translate ingles acto3_septem_continuacion2_5e5eac6c:

    # septem "Quiero una identidad propia."
    septem "I want an identity of my own."

# game/rutas/septem.rpy:4025
translate ingles acto3_septem_continuacion2_e270579b_1:

    # "Tú no respondes al instante, prefieres calla y medir tus palabras primero."
    "You don't respond right away, preferring to remain silent and choose your words carefully first."

# game/rutas/septem.rpy:4026
translate ingles acto3_septem_continuacion2_42842a14_1:

    # "Ante tu silencio, Septem agrega, explicando su decisión."
    "Faced with your silence, Septem continues, explaining his decision."

# game/rutas/septem.rpy:4027
translate ingles acto3_septem_continuacion2_43d62ec7:

    # septem "Espero que no te perturbe mucho esta nueva apariencia."
    septem "I hope this new appearance doesn't unsettle you too much."

# game/rutas/septem.rpy:4028
translate ingles acto3_septem_continuacion2_d80226e0:

    # septem "Sé que ustedes prefieren lo familiar, así que no me alejé tanto de su rostro..."
    septem "I know you prefer what's familiar, so I didn't stray too far from his face..."

# game/rutas/septem.rpy:4029
translate ingles acto3_septem_continuacion2_5d17f2d1:

    # "Está hablando de Rafael."
    "He's talking about Rafael."

# game/rutas/septem.rpy:4034
translate ingles acto3_septem_continuacion2_ff9a3568:

    # "No te gusta."
    "You don't like it."

# game/rutas/septem.rpy:4035
translate ingles acto3_septem_continuacion2_c92da459:

    # "Y se lo haces saber, con su cara."
    "And you let him know through your expression."

# game/rutas/septem.rpy:4036
translate ingles acto3_septem_continuacion2_822ba9f6:

    # "Si a Septem le ha dolido tu reacción, él no lo hace notar. Su expresión no cambia en lo más mínimo, aunque dentro de tu ser, reconoces ese hormigueo que fluctúa entre la rabia y vergüenza."
    "If your reaction has hurt Septem, he doesn't show it. His expression doesn't change in the slightest, although deep within yourself, you recognize that tingling sensation fluctuating between anger and shame."

# game/rutas/septem.rpy:4037
translate ingles acto3_septem_continuacion2_741dc305:

    # septem "Veo que no te ha gustado..."
    septem "I can tell you don't like it..."

# game/rutas/septem.rpy:4038
translate ingles acto3_septem_continuacion2_59599db0:

    # septem "Pero a mí sí."
    septem "But I do."

# game/rutas/septem.rpy:4042
translate ingles acto3_septem_continuacion2_bd43a763:

    # "Él calla, esperando a que tú digas o hagas algo."
    "He falls silent, waiting for you to say or do something."

# game/rutas/septem.rpy:4046
translate ingles acto3_septem_continuacion2_d1fc19fd:

    # septem "Jamás creí que reaccionarías así..."
    septem "I never thought you'd react this way..."

# game/rutas/septem.rpy:4047
translate ingles acto3_septem_continuacion2_0534dd3b:

    # septem "Pensé que eras más..."
    septem "... I thought you were more..."

# game/rutas/septem.rpy:4048
translate ingles acto3_septem_continuacion2_f95e6546:

    # "Detiene sus palabras, emitiendo un chasquido con su lengua, incómodo."
    "He stops himself, clicking his tongue uncomfortably."

# game/rutas/septem.rpy:4049
translate ingles acto3_septem_continuacion2_d06dc205:

    # septem "Olvídalo."
    septem "Forget it."

# game/rutas/septem.rpy:4052
translate ingles acto3_septem_continuacion2_a20cefa7_6:

    # "..."
    "..."

# game/rutas/septem.rpy:4054
translate ingles acto3_septem_continuacion2_da809ade:

    # septem "No voy a cambiar."
    septem "I won't change."

# game/rutas/septem.rpy:4055
translate ingles acto3_septem_continuacion2_6603fa5d:

    # septem "Aunque me lo pidas o no te guste."
    septem "Even if you ask me to, or if you don't like it."

# game/rutas/septem.rpy:4056
translate ingles acto3_septem_continuacion2_185a6736:

    # septem "Eso es lo único que no voy a darte el gusto."
    septem "That's the one thing I won't indulge you in."

# game/rutas/septem.rpy:4057
translate ingles acto3_septem_continuacion2_02c246bc:

    # septem "Mi identidad no es de tu incumbencia."
    septem "My identity is none of your business."

# game/rutas/septem.rpy:4061
translate ingles acto3_septem_continuacion2_325d6788:

    # "Septem gira su cuerpo una vez ha terminado de abrochar su capa."
    "Septem turns around once he's finished fastening his cloak."

# game/rutas/septem.rpy:4065
translate ingles acto3_septem_continuacion2_5cf89112:

    # "Poco a poco tu alrededor se transforma. El blanco va tragando todo el espacio a su paso, dejando solo la cama para no perturbar tu descanso."
    "Little by little, your surroundings begin to transform. White slowly swallows everything in its path, leaving only the bed untouched so as not to disturb your rest."

# game/rutas/septem.rpy:4066
translate ingles acto3_septem_continuacion2_ce32be62:

    # "No hay nada en lo cual enfocarse, solo Septem quien se roba la escena con su presencia."
    "There's nothing left to focus on except Septem, whose presence commands all your attention."

# game/rutas/septem.rpy:4068
translate ingles acto3_septem_continuacion2_9c778c5f:

    # septem "Sé que aún nos queda un largo camino, pero---"
    septem "I know we still have a long way to go, but--"

# game/rutas/septem.rpy:4069
translate ingles acto3_septem_continuacion2_08d4a598:

    # septem "Quiero agradecerte, por todo lo que has hecho por mí."
    septem "I want to thank you for everything you've done for me."

# game/rutas/septem.rpy:4070
translate ingles acto3_septem_continuacion2_b003a923:

    # septem "No tengo nada tangible para darte. Nada que puedas tocar con tus propias manos."
    septem "I have nothing tangible to give you. Nothing you can touch with your own hands."

# game/rutas/septem.rpy:4071
translate ingles acto3_septem_continuacion2_cf8bcc0a:

    # septem "Pero si puedo darte el gusto de pedirme lo que quieras."
    septem "But I can grant you the pleasure of asking me for a wish."

# game/rutas/septem.rpy:4079
translate ingles acto3_septem_continuacion3_8f0cd3f1:

    # septem "Bien."
    septem "Alright."

# game/rutas/septem.rpy:4080
translate ingles acto3_septem_continuacion3_9b498649:

    # septem "No podemos quedarnos aquí para siempre."
    septem "We can't stay here forever."

# game/rutas/septem.rpy:4081
translate ingles acto3_septem_continuacion3_b6411245:

    # septem "Cuando terminemos con la restauración del Jardín podremos tener más momentos de calma."
    septem "Once we've finished restoring the Garden, we'll be able to enjoy more peaceful moments."

# game/rutas/septem.rpy:4082
translate ingles acto3_septem_continuacion3_d3174beb:

    # septem "En unos siete días más..."
    septem "In about seven more days..."

# game/rutas/septem.rpy:4083
translate ingles acto3_septem_continuacion3_c762df11:

    # septem "Ahora, tendrás que ejercer tu responsabilidad de nuevo creador."
    septem "Now, you'll have to fulfill your responsibilities as the new Creator."

# game/rutas/septem.rpy:4084
translate ingles acto3_septem_continuacion3_c6766e45:

    # septem "Y en el séptimo día, cuando todo esté listo."
    septem "And on the seventh day, when everything is ready."

# game/rutas/septem.rpy:4085
translate ingles acto3_septem_continuacion3_00e9a113:

    # septem "Te daré todo."
    septem "I will give you everything."

# game/rutas/septem.rpy:4086
translate ingles acto3_septem_continuacion3_bb6b2450:

    # septem "Y quitaré todo rastro de Padre para ser reemplazado por ti, [nombrejugador]."
    septem "And I will erase every trace of Father, so that you may take His place, [nombrejugador]."

# game/rutas/septem.rpy:4087
translate ingles acto3_septem_continuacion3_1114a899:

    # septem "Haré que te sientas orgulloso de tener un vasallo como yo."
    septem "I will make you proud to have a vassal like me."

# game/rutas/septem.rpy:4088
translate ingles acto3_septem_continuacion3_aa72307c:

    # "___________"
    "___________"

# game/rutas/septem.rpy:4091
translate ingles acto3_septem_continuacion3_25d7fcc4:

    # centered "FIN DEL ACTO 3"
    centered "END OF ACT 3"

# game/rutas/septem.rpy:4092
translate ingles acto3_septem_continuacion3_f8edcead:

    # centered "En proceso de elaboración..."
    centered "Work in progress..."

# game/rutas/septem.rpy:4093
translate ingles acto3_septem_continuacion3_78931897:

    # centered "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    centered "{sc=2} You'll have to wait a little longer to find out how this ends... •:3{/sc}"

# game/rutas/septem.rpy:4094
translate ingles acto3_septem_continuacion3_a20cefa7:

    # "..."
    "..."

