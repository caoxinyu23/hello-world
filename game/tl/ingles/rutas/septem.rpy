translate ingles strings:

    # game/rutas/septem.rpy:1
    old "Yo"
    new "Me"

# TODO: Translation updated at 2025-02-24 14:21

# game/rutas/septem.rpy:1756
translate ingles rutaseptem_fc220fc8:

    # "Un blanco intenso se proyecta en tu mente, y no te deja en paz."
    "A blinding white floods your mind, relentless and unyielding."

# game/rutas/septem.rpy:1757
translate ingles rutaseptem_1d9b2ecc:

    # "Es molesto y la única solución que tienes es abrir los ojos."
    "It's irritating, and the only way to escape it is to open your eyes."

# game/rutas/septem.rpy:1758
translate ingles rutaseptem_3ea64582:

    # "Pero te cuesta mucho hacerlo, como si algo no te lo permitiera aún."
    "But it's incredibly difficult, as if something is still holding you back from doing so."

# game/rutas/septem.rpy:1759
translate ingles rutaseptem_2c5843a9:

    # "Intentas e intentas, pero no hay caso. Tus ojos no responden a tus comandos."
    "You try and try, but to no avail. Your eyes refuse to obey your commands."

# game/rutas/septem.rpy:1760
translate ingles rutaseptem_86dcf4a5:

    # "Hasta que algo, una chispa, recorre todo tu cuerpo. Desde los pies hasta tu cabeza...."
    "Until something--a spark--runs through your entire body, from your feet to your head..."

# game/rutas/septem.rpy:1761
translate ingles rutaseptem_338aa712:

    # septem "[nombrejugador], esto nos va a doler un poco."
    septem "[nombrejugador], this is going to hurt a little."

# game/rutas/septem.rpy:1762
translate ingles rutaseptem_a2d6694c:

    # "Escuchas la voz de Septem... pero no a través de tus oídos. No... su voz se origina dentro de tu cabeza, como ti estuviera hablando directamente en tus pensamientos."
    "You hear Septem's voice... but not through your ears. No... his voice originates inside your mind, as if he's speaking directly into your thoughts."

# game/rutas/septem.rpy:1763
translate ingles rutaseptem_82e024ce:

    # "No tienes tiempo para seguir pensando en la voz, ya que tu piel comienza a arder. Sientes como se rompe de apoco, lenta y tortuosamente."
    "You don't have time to focus on the voice, as your skin begins to burn. You feel it tearing apart slowly, painfully, and torturously."

# game/rutas/septem.rpy:1764
translate ingles rutaseptem_d3917f20:

    # "Luego, todo tu cuerpo comienza a cambiar, sientes como dentro de ti explotan y se crean huesos y órganos, reemplazando los que tienen algún desperfecto."
    "Then, your entire body starts to change. You feel bones and organs both exploding and forming inside you, replacing those that have any imperfections."

# game/rutas/septem.rpy:1765
translate ingles rutaseptem_6e810f45:

    # "Quieres gritar, pero te aguantas."
    "You want to scream, but you hold it in."

# game/rutas/septem.rpy:1766
translate ingles rutaseptem_371f19cd:

    # "Cuando crees que lo peor ya ha pasado, sientes como tu corazón se desgarra, una y otra vez. Pues con cada intento, nunca estás contento como resulta."
    "Just when you think the worst is over, you feel your heart tear, over and over again. With each attempt, it's never satisfying, never turning out the way you want."

# game/rutas/septem.rpy:1767
translate ingles rutaseptem_53326742:

    # "No... tiene que ser perfecto."
    "No... it has to be perfect."

# game/rutas/septem.rpy:1768
translate ingles rutaseptem_4c536081:

    # "Intentas una vez más y..."
    "You try once more and..."

# game/rutas/septem.rpy:1769
translate ingles rutaseptem_ad492078:

    # "Ya está--"
    "That's it--"

# game/rutas/septem.rpy:1770
translate ingles rutaseptem_ea046152:

    # "Abres los ojos, y tu visión es..."
    "You open your eyes, and your vision is..."

# game/rutas/septem.rpy:1771
translate ingles rutaseptem_90f2761f:

    # "... no ves nada más que el blanco de tu mente. Tienes miedo..."
    "... all you see is the blinding white of your mind. Fear creeps in..."

# game/rutas/septem.rpy:1772
translate ingles rutaseptem_f45b42b6:

    # "{sc=2}Hmmm, es extraño ver con estos ojos...{/sc}"
    "{sc=2}Hmmm, it's strange to see with these eyes...{/sc}"

# game/rutas/septem.rpy:1773
translate ingles rutaseptem_5f989dfa:

    # "Algo está muy mal."
    "Something is terribly wrong."

# game/rutas/septem.rpy:1774
translate ingles rutaseptem_3654fe9a:

    # "{sc=2}Aún no estamos sincronizados completamente...{/sc}"
    "{sc=2}We're still not fully synced...{/sc}"

# game/rutas/septem.rpy:1775
translate ingles rutaseptem_88fe194b:

    # "Miras tus manos y...."
    "You look at your hands, and..."

# game/rutas/septem.rpy:1777
translate ingles rutaseptem_057b9891:

    # "Son las de Septem, pero ya no tienen ese negro característico."
    "They're Septem's hands, but they no longer have that distinctive black hue."

# game/rutas/septem.rpy:1778
translate ingles rutaseptem_78e671cc:

    # "Estás en el cuerpo de Septem."
    "You're in Septem's body."

# game/rutas/septem.rpy:1780
translate ingles rutaseptem_10415b73:

    # "{sc=2}¿Te gusta?{/sc}"
    "{sc=2}Do you like it?{/sc}"

# game/rutas/septem.rpy:1781
translate ingles rutaseptem_cf7912c0:

    # "{sc=2}Aunque no será por mucho tiempo...{/sc}"
    "{sc=2}Though we won't be like this for long...{/sc}"

# game/rutas/septem.rpy:1782
translate ingles rutaseptem_efa8a2a0:

    # "{sc=2}Ahora que tenemos el poder del creador, puedo crearte un cuerpo totalmente nuevo.{/sc}"
    "{sc=2}Now that we have the Creator's power, I can make you an entirely new body.{/sc}"

# game/rutas/septem.rpy:1783
translate ingles rutaseptem_d768eb82:

    # "{sc=2}Separado del mío físicamente, pero conectado en alma.{/sc}"
    "{sc=2}Physically separate from mine, but connected in soul.{/sc}"

# game/rutas/septem.rpy:1784
translate ingles rutaseptem_1180adf6:

    # "{sc=2}Pero necesito tiempo...{/sc}"
    "{sc=2}But I need time...{/sc}"

# game/rutas/septem.rpy:1785
translate ingles rutaseptem_ac901a0b:

    # "{sc=2}Mientras... podríamos decir que ahora soy tu marioneta.{/sc}"
    "{sc=2}Meanwhile... we could say that I'm your puppet now.{/sc}"

# game/rutas/septem.rpy:1786
translate ingles rutaseptem_0dbc2f49:

    # "{sc=2}Me puedes usar de la misma manera que usabas a la tuya...{/sc}"
    "{sc=2}You can use me the same way you used your old one...{/sc}"

# game/rutas/septem.rpy:1787
translate ingles rutaseptem_c305d220:

    # "{sc=2}Que encantador~{/sc}"
    "{sc=2}How lovely~{/sc}"

# game/rutas/septem.rpy:1788
translate ingles rutaseptem_37df7a23:

    # "--------"
    "----------"

# TODO: Translation updated at 2025-02-25 00:18

# game/rutas/septem.rpy:992
translate ingles rutaseptem_edb43f80:

    # "Parece ser una conversación entre dos personas, aunque, no puedes entender su contenido."
    "It appears to be a conversation between two people, although you can't make out its content."

# game/rutas/septem.rpy:1038
translate ingles rutaseptem_c3accc8c:

    # "Septem no se da el tiempo de esperar, pues eres teletransportado a solo centímetros de su cuerpo."
    "Septem doesn't wait, as you are teleported to just centimeters from him."

# game/rutas/septem.rpy:1198
translate ingles rutaseptem_d6b90ef4:

    # "{sc=3}Pero se borra al instante, como si recordara algo.{/sc}"
    "{sc=3}But it fades instantly, as if he remembered something.{/sc}"

# game/rutas/septem.rpy:1203
translate ingles rutaseptem_fa14ae3e:

    # septem "Y créeme, terminará sucediendo en algún momento, después de todo... [nombrejugador] es una entidad curiosa."
    septem "And believe me, it will eventually happen... after all, [nombrejugador] is a curious entity."

# game/rutas/septem.rpy:1212
translate ingles rutaseptem_4b8bd3d1:

    # "{sc=3}Llegamos a una puerta gigante, que no tarda mucho en abrirse para darles el paso.{/sc}"
    "{sc=3}We arrive at a giant door, which quickly opens to let us through.{/sc}"

# game/rutas/septem.rpy:1215
translate ingles rutaseptem_5ca93251:

    # "{sc=3}Oscuro e inquietante, no un oscuro como el vacío de Nulla.{/sc}"
    "{sc=3}Dark and unsettling, not like Nulla's void.{/sc}"

# game/rutas/septem.rpy:1500
translate ingles rutaseptem_a0d4a9d6:

    # septem "Lástima que esté fuera de mi alcance."
    septem "Too bad you're out of my reach."

# game/rutas/septem.rpy:1535
translate ingles rutaseptem_08856611:

    # "Ahora él te evita lo más que puede. La biblioteca permanece permanentemente cerrada y cada vez que tocas la puerta, Septem te pide que te retires."
    "Now he avoids you as much as he can. The library remains permanently closed, and every time you knock on the door, Septem tells you to leave."

# TODO: Translation updated at 2025-10-05 02:57

# game/rutas/septem.rpy:22
translate ingles rutaseptem_ffcc3d73:

    # "{sc=2}deberás lograr que te tomen como aprendiz.{/sc}"
    "{sc=2}You must manage to be taken as an apprentice.{/sc}"

# game/rutas/septem.rpy:35
translate ingles rutaseptem_ab007865:

    # "Supones que debes tomar tú la iniciativa de entablar una conversación."
    "You suppose you should be the one to take the initiative to start a conversation."

# game/rutas/septem.rpy:79
translate ingles rutaseptem_14364725:

    # "Aunque de todos modos no se te ocurre que decir, así que-"
    "Though you can't really think of anything to say anyway, so--"

# game/rutas/septem.rpy:93
translate ingles rutaseptem_f5f2c334:

    # septem "{sc=2}No quiero oírte gritar tus súplicas. {/sc}"
    septem "{sc=2}I don't want to hear you scream your pleas.{/sc}"

# game/rutas/septem.rpy:106
translate ingles rutaseptem_85e7c6f4:

    # "Le cuentas sin mucha vergüenza (pues esa la decidiste dejar cuando aceptaste descargar este juego) desde los datos más minúsculos y rebuscados"
    "You tell him without much shame (since you decided to abandon that the moment you downloaded this game), from the tiniest and most obscure details"

# game/rutas/septem.rpy:110
translate ingles rutaseptem_f868cf8b:

    # "El aura que transmite el ambiente no da muy buena espina, por lo que decides parar en seco."
    "The aura in the air doesn't feel right, so you decide to stop abruptly."

# game/rutas/septem.rpy:205
translate ingles rutaseptem_8335fd8b:

    # nulla "No veo que te haya gustado mucho el regalo. Podrías dármelo y yo le diré a Madre que lo cambie por otro."
    nulla "I see you didn't like the gift very much. You could give it to me, and I'll tell Mother to exchange it for another one."

# game/rutas/septem.rpy:258
translate ingles rutaseptem_a7f4178c:

    # "Para luego darte cuenta de que estás en una cama espaciosa y cálida."
    "Then you realize you're lying on a spacious, warm bed."

# game/rutas/septem.rpy:348
translate ingles rutaseptem_497e29d3:

    # septem "Tiempo para hacer el cambio de huésped."
    septem "Time to make the host change."

# game/rutas/septem.rpy:360
translate ingles rutaseptem_718d2c42:

    # septem "Por ahora lo que puedes saber es que necesitamos tiempo para hacer el cambio de huésped."
    septem "For now, all you need to know is that we need time to perform the host change."

# game/rutas/septem.rpy:564
translate ingles rutaseptem_22260b64:

    # "Septem comienza a acercarse a ti. Su cara angelical es una antítesis con el aura que transmite."
    "Septem begins to approach you. His angelic face is an antithesis to the aura he gives off."

# game/rutas/septem.rpy:581
translate ingles rutaseptem_0127dbd9:

    # "Septem te prohibe moverte con solo el chasquido de sus dedos, y sonriendo comienza a acercarse a ti. Su cara angelical es una antítesis con el aura que transmite."
    "Septem forbids you to move with just a snap of his fingers. Smiling, he begins to approach you. His angelic face contrasts sharply with the dark aura he radiates."

# game/rutas/septem.rpy:646
translate ingles rutaseptem_52f57847:

    # "{b}Luego el creador me dio la misión de crear estandartes para mantener al jardín funcionando{b}"
    "{b}Then the Creator gave me the mission to create the Symbols to keep the Garden running.{b}"

# game/rutas/septem.rpy:665
translate ingles rutaseptem_351f807a:

    # "{b}Por último el sábado, mi querida Sextam nació junto con la humanidad.{b}"
    "{b}Lastly, on Saturday, my dear Sextam was born along with humanity.{b}"

# game/rutas/septem.rpy:698
translate ingles rutaseptem_91a2937e:

    # septem "Pero la diferencia es que tenían humanos... Así que nos implantamos en su cultura."
    septem "But the difference is that they had humans... so, we embedded ourselves in their culture."

# game/rutas/septem.rpy:1093
translate ingles rutaseptem_e4514564:

    # "{sc=3}Su voz tiene un tinte de terror en ella... ojalá tuviera ese tono de voz siempre.{/sc}"
    "{sc=3}There's a hint of fear in his voice... I wish he always spoke like that.{/sc}"

# game/rutas/septem.rpy:1096
translate ingles rutaseptem_5605397d:

    # septem "Eres una extensión de {b}él{b}"
    septem "You are an extension of {b}Him{b}."

# game/rutas/septem.rpy:1220
translate ingles rutaseptem_f4bbf80c:

    # "Están a punto de juntar sus labios cuando Septem se hace notar, dando un paso dentro de la sala, y ambas entidades miran curiosas."
    "They're about to bring their lips together when Septem makes his presence known, stepping into the room, and both entities turn to look curiously."

# game/rutas/septem.rpy:1225
translate ingles rutaseptem_aa5ed6cc:

    # "{sc=3}La voz se escucha en todo el espacio...{/sc}"
    "{sc=3}The voice echoes through the entire space...{/sc}"

# game/rutas/septem.rpy:1236
translate ingles rutaseptem_38d37b2e:

    # "{sc=3}Horrible, ¡esta cosa no merece el respeto de nadie!{/sc}"
    "{sc=3}Disgusting, this thing doesn't deserve anyone's respect!{/sc}"

# game/rutas/septem.rpy:1534
translate ingles rutaseptem_e507c36f:

    # "Pasan algunos días después de eso y comienzas a ver algo extraño en Septem."
    "A few days pass after that, and you start to notice something strange about Septem."

# game/rutas/septem.rpy:1800
translate ingles rutaseptem_d917429c:

    # "-----------------------"
    "-----------------------"

# game/rutas/septem.rpy:1801
translate ingles rutaseptem_97553ea2:

    # "{sc=2}Oh....{/sc}"
    "{sc=2}Oh...{/sc}"

# game/rutas/septem.rpy:1802
translate ingles rutaseptem_3d7888af:

    # "Tienes que poner toda tu voluntad en mantener la forma de tu cuerpo. Incluso si te distraes por solo un segundo, tus brazos y piernas comienzan a estremecerse."
    "You have to put all your will into maintaining your body's shape. Even if you get distracted for just a second, your arms and legs begin to tremble."

# game/rutas/septem.rpy:1803
translate ingles rutaseptem_c9a8b6b4:

    # "Temes que se rompan. Por lo que necesitas pensar en que parte o estímulo bloquear para así poder mantener las extremidades que están comprometidas con la falta de energía."
    "You fear they'll break, so you have to think about which part or stimulus to block in order to keep the limbs affected by the lack of energy stable."

# game/rutas/septem.rpy:1805
translate ingles rutaseptem_145399c8:

    # "{sc=2}[nombrejugador]...{/sc}"
    "{sc=2}[nombrejugador]...{/sc}"

# game/rutas/septem.rpy:1806
translate ingles rutaseptem_2901dcb4:

    # "{sc=2} Me siento débil... Creo que será necesario descansar los ojos por un momento...\n¿No te parece?{/sc}"
    "{sc=2}I feel weak... I think it's necessary to rest my eyes for a moment... \nDon't you think so?{/sc}"

# game/rutas/septem.rpy:1811
translate ingles rutaseptem_a20cefa7_25:

    # "..."
    "..."

# game/rutas/septem.rpy:1813
translate ingles rutaseptem_fe1dc46b:

    # "{sc=2}¿ N O ?{/sc}"
    "{sc=2}N O ?{/sc}"

# game/rutas/septem.rpy:1814
translate ingles rutaseptem_1ca77275:

    # "{sc=2}Creo que te---{/sc}"
    "{sc=2}I think you--{/sc}"

# game/rutas/septem.rpy:1815
translate ingles rutaseptem_10fd7e13:

    # "{sc=2}¡Uhg!{/sc}"
    "{sc=2}Ugh!{/sc}"

# game/rutas/septem.rpy:1817
translate ingles rutaseptem_a20cefa7_26:

    # "..."
    "..."

# game/rutas/septem.rpy:1818
translate ingles rutaseptem_f972cfbe:

    # "Tu cuerpo no aguanta mucho más, sientes como su masa se desestabiliza, haciéndote imposible mantenerte consciente y presente en el plano físico del Jardín."
    "Your body can't hold on much longer; you feel its mass destabilizing, making it impossible to remain conscious and present in the physical plane of the Garden."

# game/rutas/septem.rpy:1819
translate ingles rutaseptem_a8ae76a1:

    # "Quién diría que tener un cuerpo propio sería tan difícil de mantener..."
    "Who would've thought having your own body would be so hard to sustain..."

# game/rutas/septem.rpy:1820
translate ingles rutaseptem_1aeaa3f2:

    # "La energía que estás ocupando ahora mismo está en su límite, haciendo imposible siquiera mover tu cuerpo sin tambalear."
    "The energy you're using right now is at its limit, making it impossible to move your body without staggering."

# game/rutas/septem.rpy:1821
translate ingles rutaseptem_638e4e57:

    # "{sc=2}Lo siento [nombrejugador], creo que no aguanto más.{/sc}"
    "{sc=2}I'm sorry, [nombrejugador], I don't think I can hold on any longer.{/sc}"

# game/rutas/septem.rpy:1822
translate ingles rutaseptem_721e4487:

    # "{sc=2}No estamos lo suficientemente sincronizados como para compartir una perspectiva.{/sc}"
    "{sc=2}We're not synchronized enough to share a single perspective.{/sc}"

# game/rutas/septem.rpy:1824
translate ingles rutaseptem_be21b4ed:

    # "Es lo último que dices antes de caer sobre el altar."
    "That's the last thing you say before collapsing onto the altar."


# game/rutas/septem.rpy:1826
translate ingles rutaseptem_a20cefa7_27:

    # "..."
    "..."

# game/rutas/septem.rpy:1827
translate ingles rutaseptem_abe24823:

    # "{sc=2}{size=*2.0} . . . {/size}{/sc}"
    "{sc=2}{size=*2.0} . . . {/size}{/sc}"

# game/rutas/septem.rpy:1829
translate ingles rutaseptem_9608e82a:

    # "En un inicio no existía nada."
    "In the beginning, there was nothing."

# game/rutas/septem.rpy:1830
translate ingles rutaseptem_575cdb9c:

    # "Solo oscuridad y destrucción..."
    "Only darkness and destruction..."

# game/rutas/septem.rpy:1832
translate ingles rutaseptem_ff00c4c9:

    # "Hasta que llegó el demiurgo, tu Padre."
    "Until the Demiurge arrived--your Father."

# game/rutas/septem.rpy:1833
translate ingles rutaseptem_c0ae99fa:

    # "Pero--- tienes la pequeña sospecha, dentro de tu apretado corazón, que él no te considera como un alguien, menos un hijo..."
    "But--you have a faint suspicion, deep within your tight chest, that he doesn't consider you a someone, much less as a son..."

# game/rutas/septem.rpy:1834
translate ingles rutaseptem_e44a1b2d:

    # "No eres nada."
    "You are nothing."

# game/rutas/septem.rpy:1835
translate ingles rutaseptem_effb9a1a:

    # "Nada comparado con su objetivo de seguir creando."
    "Nothing compared to his goal of continuing to create."

# game/rutas/septem.rpy:1837
translate ingles rutaseptem_e535763d:

    # "Una y otra vez rememoras las ínfimas conversaciones que tuviste el honor de tener con él."
    "Again and again, you recall the few, fleeting conversations you were honored to have with him."

# game/rutas/septem.rpy:1838
translate ingles rutaseptem_2aca4b36:

    # "Unas cuantas te llenaban el alma con esperanza, con un calor reconfortante que te envolvía todo tu ser. Todo tu amorfo ser."
    "Some filled your soul with hope; a comforting warmth that wrapped around your entire, amorphous being."

# game/rutas/septem.rpy:1840
translate ingles rutaseptem_09da1e19:

    # "Y... otras veces te dejaban con más preocupaciones de las necesarias."
    "And... other times, the conversations left you with more worries than you needed."

# game/rutas/septem.rpy:1841
translate ingles rutaseptem_e224495b:

    # "Nunca tuviste estabilidad genuina en tus primeros días de consciencia."
    "You never had true stability in your first days of consciousness."

# game/rutas/septem.rpy:1842
translate ingles rutaseptem_db418b47:

    # "Pero aun así..."
    "But even so..."

# game/rutas/septem.rpy:1843
translate ingles rutaseptem_286bf325:

    # "Aun así añoras esos momentos de silencio entre conversaciones."
    "... Even so, you still miss those silent moments between conversations."

# game/rutas/septem.rpy:1845
translate ingles rutaseptem_49ea58ec:

    # "Esa mirada de orgullo que te dedicaba cuando hacías algo bien."
    "That look of pride he gave you whenever you did something right."

# game/rutas/septem.rpy:1847
translate ingles rutaseptem_a3f2d8fa:

    # "Mirada que al instante se transformaba en palabras de: 'Puedes hacerlo mejor', 'Te ha faltado agregar esto', 'Si sigues así no serás capaz de mantener el Jardín'..."
    "A look that would instantly turn into words like: 'You can do better,' 'You forgot to add this,' 'If you keep this up, you won't be able to sustain the Garden'..."

# game/rutas/septem.rpy:1848
translate ingles rutaseptem_fb8e2173:

    # "...No."
    "... No."

# game/rutas/septem.rpy:1850
translate ingles rutaseptem_36b5dd74:

    # "No tiene caso volver aquí."
    "There's no point in coming back here."

# game/rutas/septem.rpy:1851
translate ingles rutaseptem_71998531:

    # "No tienes ganas de seguir ahondando en esto, debes salir de aquí."
    "You don't feel like digging into this any further, you have to get out of here."

# game/rutas/septem.rpy:1853
translate ingles rutaseptem_143d0709:

    # "Al levantar la cabeza te das cuenta de que hay un camino que te invita a seguirlo."
    "When you lift your head, you notice a path inviting you to follow it."

# game/rutas/septem.rpy:1854
translate ingles rutaseptem_7ca0e448:

    # "Así que lo tomas."
    "So you take it."

# game/rutas/septem.rpy:1856
translate ingles rutaseptem_2786e383:

    # "Nada más pisar el camino, el lugar se distorsiona y muta."
    "The moment your feet touch the path, the place distorts and shifts."

# game/rutas/septem.rpy:1857
translate ingles rutaseptem_8c6d377b:

    # "Es un sendero hecho de una mezcla de arena y agua."
    "It's a path made of a strange mixture of sand and water."

# game/rutas/septem.rpy:1858
translate ingles rutaseptem_8f71b1d3:

    # "No hay nada más, por lo que lo único que queda es caminar."
    "There's nothing else, so all you can do is walk."

# game/rutas/septem.rpy:1860
translate ingles rutaseptem_5f8e73af:

    # "Cuando miras detrás de ti, el camino va desapareciendo, sin dejar rastro de tus pisadas."
    "When you look behind you, the path fades away, leaving no trace of your steps."

# game/rutas/septem.rpy:1862
translate ingles rutaseptem_bdd91d95:

    # "No hay ruido ambiental, ni se escucha el sonido de tus pies al hacer contacto con el agua, no hay nada que acompañe en tu caminata y eso te carcome el alma."
    "There's no ambient noise, not even the sound of your feet touching the water... nothing to accompany you on your walk, and that gnaws at your soul."

# game/rutas/septem.rpy:1863
translate ingles rutaseptem_69e088ff:

    # "Con cada paso, la culpa te agarra y se pega a tu espalda para luego soltarte, sin antes robarte un poco de tu esperanza. Repitiendo el proceso hasta que quedas con una misera gota de ella."
    "With each step, guilt grabs hold of you, clings to your back, then lets go, but only after stealing a bit of your hope. It repeats this process until you're left with a miserable drop of it."

# game/rutas/septem.rpy:1865
translate ingles rutaseptem_118d9810:

    # "Nulla te lo ha dicho, un montón de veces... esto se va a poner feo cuando 'ellos' vengan, en algún momento llegarán. Y, aun así, le ordenas continuar: que busque humanos, que sacie la sed de Fe de los Estandartes a como dé lugar, que no les deje vivir en agonía."
    "Nulla has told you countless times... things will get ugly when 'they' come... and they will, eventually. Yet, you order him to continue: To find humans, to sate the Symbols' thirst for faith by any means necessary, to not let them live in agony."

# game/rutas/septem.rpy:1866
translate ingles rutaseptem_fa311444:

    # "Con cada respiración de tu mortal cuerpo, el pensamiento de que cada ser en tu mundo perderá la cordura luego de que se queden sin humanos en algún momento te quita el aire..."
    "With every inhale of your mortal body, the thought that all the beings in your world will lose their sanity once the humans are gone steals your breath away..."

# game/rutas/septem.rpy:1868
translate ingles rutaseptem_ac3f8782:

    # "Nulla ya te lo ha dicho, un montón de veces, no pueden seguir con este método por la eternidad, tarde o temprano alguien vendrá a poner un fin a esto."
    "Nulla has told you so many times that you can't keep using this method forever. Sooner or later, someone will come to put an end to it."

# game/rutas/septem.rpy:1869
translate ingles rutaseptem_a83d9210:

    # "Ya sea el dueño de Padre o un externo al Jardín, o él mismo si llegan ellos."
    "Be it Father's master, an outsider to the Garden, or Father himself--if they arrive."

# game/rutas/septem.rpy:1871
translate ingles rutaseptem_df6e3124:

    # "Nulla siempre ha sido directo, y tomará esa oportunidad si puede."
    "Nulla has always been direct, and he'll take that opportunity if he can."

# game/rutas/septem.rpy:1872
translate ingles rutaseptem_5d0b9181:

    # "Nulla dice que es lo mejor. Que la única solución es eliminar el mundo, rezar a que venga ese ser, y hacer que todo esto acabe."
    "Nulla says it's for the best. That the only solution is to erase the world, pray that the being comes, and put an end to all of this."

# game/rutas/septem.rpy:1876
translate ingles rutaseptem_2690c480:

    # "Pero... no."
    "But... no."

# game/rutas/septem.rpy:1877
translate ingles rutaseptem_be047211:

    # "Tu razón de ser no te permite hacer eso."
    "Your very reason for being doesn't allow you to do that."


# game/rutas/septem.rpy:1878
translate ingles rutaseptem_43c184e3:

    # "{b}Tú no quieres hacer eso.{b}"
    "{b}You don't want to do that.{b}"

# game/rutas/septem.rpy:1879
translate ingles rutaseptem_b5dd19b1:

    # "Dejar que el jardín se destruido, no solo implica borrar a todo lo que proteges, sino que también, todo rastro de Padre y... tuyo."
    "Letting the Garden be destroyed not only means erasing everything you protect, but also every trace of Father and... yourself."

# game/rutas/septem.rpy:1880
translate ingles rutaseptem_547b78c6:

    # "Aún tienes tiempo para idear algo. De gestionar un plan que sea la solución a todo."
    "You still have time to come up with something. To devise a plan that could solve everything."

# game/rutas/septem.rpy:1881
translate ingles rutaseptem_b4e163d3:

    # "Por lo que te centras en tu misión para no sucumbir a lo que Nulla llama la solución a todos tus males. Tal vez si alteran el mundo, llames la atención de Padre y puedas tener una conversación con él para llegar a un acuerdo."
    "So you focus on your mission, so as not to fall into what Nulla calls the cure for all your woes. Maybe if you alter the world, you'll catch Father's attention and finally have a chance to speak with him and reach an agreement."

# game/rutas/septem.rpy:1882
translate ingles rutaseptem_c7c60986:

    # "Para rogarle. Para llorarle como nunca le has llorado."
    "To beg him. To weep for him as you never have before."

# game/rutas/septem.rpy:1883
translate ingles rutaseptem_a68a3e2c:

    # "Para gritarle lo que nunca tuviste el valor de gritarle."
    "To scream at him the things you never had the courage to say."

# game/rutas/septem.rpy:1884
translate ingles rutaseptem_edbac15e:

    # "Para decirle que: {b}Tú quieres vivir.{b}"
    "To tell him: {b}You want to live.{b}"

# game/rutas/septem.rpy:1885
translate ingles rutaseptem_07e20349:

    # "Que este sentimiento no es solo por la razón de tu creación. No es algo que tenga que ver con tu rango u objetivo de vida."
    "That this feeling isn't born from the reason you were created. It has nothing to do with your rank or your purpose."

# game/rutas/septem.rpy:1886
translate ingles rutaseptem_bcf6dd4d_1:

    # "No."
    "No."

# game/rutas/septem.rpy:1887
translate ingles rutaseptem_74914620:

    # "Tú realmente quieres ver crecer el jardín con él a su lado."
    "You truly want to see the Garden grow with him by your side."

# game/rutas/septem.rpy:1888
translate ingles rutaseptem_0500664a:

    # "Quieres percibir cada una de las cosas que existen aquí y que no has podido por la condición de tu rango y cuerpo."
    "You want to perceive every single thing that exists here, the things you've never been able to because of your rank and your body."

# game/rutas/septem.rpy:1889
translate ingles rutaseptem_1aaf3a62:

    # "Quieres comenzar a vivir. Disfrutar de la vida por una buena vez por todas."
    "You want to start living. To finally enjoy life once and for all."

# game/rutas/septem.rpy:1890
translate ingles rutaseptem_fad8f836:

    # "No este constante despertar encadenado a un montón de preocupaciones que no puedes solucionar, ni, aunque pongas todo tu ser en ello."
    "Not this endless awakening chained to worries you can't solve, no matter how much of yourself you pour into it."

# game/rutas/septem.rpy:1891
translate ingles rutaseptem_757e96e7:

    # "Pero la solución se te escapa de las manos."
    "But the solution keeps slipping through your hands."

# game/rutas/septem.rpy:1892
translate ingles rutaseptem_b226675e:

    # "Ya estás harto de intentar desenredar este hilo que siempre estará atado por nudos infinitos."
    "You're tired of trying to untangle a thread that will always be bound by infinite knots."

# game/rutas/septem.rpy:1893
translate ingles rutaseptem_e0359ccf:

    # "Quieres descansar y volver a los tiempos donde tú compartías el mando junto con Padre..."
    "You want to rest, to return to the days when you shared command with Father..."

# game/rutas/septem.rpy:1894
translate ingles rutaseptem_94f7c2e1:

    # "---"
    "---"

# game/rutas/septem.rpy:1895
translate ingles rutaseptem_44340470:

    # "Caminas ahora con dificultad, la arena te traga mientras más avanzas y el agua te impide volver a retomar el paso con normalidad."
    "You walk with difficulty now. The sand swallows you the further you go, and the water keeps you from regaining your normal pace."

# game/rutas/septem.rpy:1896
translate ingles rutaseptem_7406081f:

    # "Pero no te dejas hundir. No te vas a rendir, tienes que llegar al final de este sendero."
    "But you don't let yourself sink. You won't give up, you have to reach the end of this path."

# game/rutas/septem.rpy:1897
translate ingles rutaseptem_0191a1e9:

    # "A lo lejos puedes ver el final."
    "In the distance, you can see the end."

# game/rutas/septem.rpy:1898
translate ingles rutaseptem_369a1abc:

    # "Ahí, una luz te espera, seguramente es la solución a lo que todo el Jardín busca."
    "There, a light awaits you. It must be the solution the entire Garden has been seeking."

# game/rutas/septem.rpy:1899
translate ingles rutaseptem_55954359:

    # "Pero aún no puedes llegar."
    "But you can't reach it yet."

# game/rutas/septem.rpy:1900
translate ingles rutaseptem_b2660947:

    # "Hasta ese entonces-- harás todo lo necesario para llegar a ese lugar, sin importar qué."
    "Until then, you'll do whatever it takes to reach that place no matter what."

# game/rutas/septem.rpy:1901
translate ingles rutaseptem_2590f3ba:

    # "Si la oportunidad se te da, la tomarás. No importa lo que debas hacer, cortarte los pies, quitar el agua o la arena que te dificulta llegar a tu destino, o simplemente hacer que el lugar llegue a ti."
    "If the opportunity arises, you'll seize it. No matter what you must do--cut off your feet, remove the water or sand that hinders you, or even make the place come to you."

# game/rutas/septem.rpy:1902
translate ingles rutaseptem_27a1742e:

    # "Lo vas a conseguir."
    "You're going to do it."

# game/rutas/septem.rpy:1903
translate ingles rutaseptem_12204d8f:

    # "A como dé lugar. No importa si los demás piensan que cortarte los pies es desagradable. Si quitar el agua o la arena es inmoral, o simplemente hacer que el lugar llegue a ti es algo imposible. Tú lo vas a hacer."
    "One way or another. It doesn't matter if others think cutting off your feet is grotesque, if removing the water or sand is immoral, or if making the place come to you is impossible. You will do it."

# game/rutas/septem.rpy:1905
translate ingles rutaseptem_cb1ee48c:

    # "...Con o sin Padre."
    "... With or without Father."

# game/rutas/septem.rpy:1906
translate ingles rutaseptem_d1e4ca25:

    # "-----"
    "-----"

# game/rutas/septem.rpy:1913
translate ingles rutaseptem_1a5a7dda:

    # "{sc=2}...Ah.{/sc}"
    "{sc=2}... Ah.{/sc}"

# game/rutas/septem.rpy:1914
translate ingles rutaseptem_f9b5c161:

    # "{sc=2}¿[nombrejugador]{/sc}?"
    "{sc=2}[nombrejugador]?{/sc}"

# game/rutas/septem.rpy:1915
translate ingles rutaseptem_39fc609d:

    # "{sc=2}¿Qué pasó?.{/sc}"
    "{sc=2}What happened?{/sc}"

# game/rutas/septem.rpy:1916
translate ingles rutaseptem_a296201a:

    # "{sc=2}Momento.{/sc}"
    "{sc=2}Wait.{/sc}"

# game/rutas/septem.rpy:1917
translate ingles rutaseptem_feab5645:

    # "{sc=2}No te siento del todo.{/sc}"
    "{sc=2}I don't feel you completely.{/sc}"

# game/rutas/septem.rpy:1918
translate ingles rutaseptem_6c0b26aa:

    # "{sc=2}Pero se que estás aquí.{/sc}"
    "{sc=2}But I know you're here.{/sc}"

# game/rutas/septem.rpy:1919
translate ingles rutaseptem_3abe86b2:

    # "{sc=2}Maldición."
    "{sc=2}Damn it.{/sc}"

# game/rutas/septem.rpy:1920
translate ingles rutaseptem_4491e3f0:

    # "{sc=2}Te tengo dentro mí, y tienes acceso a todo de mí.{/sc}"
    "{sc=2}You're inside me, and you have access to all of me.{/sc}"

# game/rutas/septem.rpy:1921
translate ingles rutaseptem_94e763a3:

    # "{sc=2}Mi alma se encuentra desnuda para que tus ojos puedan devorarla.{/sc}"
    "{sc=2}My soul lies bare, for your eyes to devour it.{/sc}"

# game/rutas/septem.rpy:1922
translate ingles rutaseptem_20a68a6e:

    # "{sc=2}Y creo que esto no es lo que buscábamos.{/sc}"
    "{sc=2}And I don't think this is what we were looking for.{/sc}"

# game/rutas/septem.rpy:1923
translate ingles rutaseptem_2a5f7240:

    # "{sc=2}Entonces... ¿Por qué antes teníamos una conexión más estable?{/sc}"
    "{sc=2}So... why did we have a more stable connection before?{/sc}"

# game/rutas/septem.rpy:1924
translate ingles rutaseptem_829c39df:

    # "{sc=2}Mmmm.{/sc}"
    "{sc=2}Mmmm.{/sc}"

# game/rutas/septem.rpy:1925
translate ingles rutaseptem_d2122aa0:

    # "{sc=2}No estaba consciente...{/sc}"
    "{sc=2}I wasn't conscious...{/sc}"

# game/rutas/septem.rpy:1926
translate ingles rutaseptem_06925025:

    # "{sc=2}Ya veo.{/sc}"
    "{sc=2}I see.{/sc}"

# game/rutas/septem.rpy:1927
translate ingles rutaseptem_2dc815b3:

    # "{sc=2}Dentro de mi mundo interior podemos hacer esta simbiosis, parecida\na la que tenías con tu antigua marioneta.{/sc}"
    "{sc=2}Inside my inner world, we can form this kind of symbiosis, similar\nto the one you had with your former puppet.{/sc}"

# game/rutas/septem.rpy:1928
translate ingles rutaseptem_34cc9cc1:

    # "{sc=2}Aquí, estando yo consciente, no podemos tener ese grado de sincronía.{/sc}"
    "{sc=2}Here, with me conscious, we can't reach that level of synchronization.{/sc}"

# game/rutas/septem.rpy:1929
translate ingles rutaseptem_08518766:

    # "{sc=2}Y es más difícil ahora que no tengo tanta energía.{/sc}"
    "{sc=2}And it's even harder now that I don't have much energy left.{/sc}"

# game/rutas/septem.rpy:1930
translate ingles rutaseptem_9f7d611d:

    # "{sc=2}No lo pensé claramente-- bueno, no tenía opción...{/sc}"
    "{sc=2}I didn't think it through--well, I had no choice...{/sc}"

# game/rutas/septem.rpy:1931
translate ingles rutaseptem_e521a0fd:

    # "{sc=2}Ahora mismo no tengo la energía suficiente, ni el conocimiento como para\ncrearte un cuerpo físico completamente nuevo y...{/sc}"
    "{sc=2}Right now I lack both the energy and the knowledge\nto create an entirely new physical body for you and...{/sc}"

# game/rutas/septem.rpy:1932
translate ingles rutaseptem_08818ebd:

    # "{sc=2}Supongo que estar en mi cuerpo debe ser aburrido para ti.{/sc}"
    "{sc=2}... I suppose being inside my body must be boring for you.{/sc}"

# game/rutas/septem.rpy:1933
translate ingles rutaseptem_6591ef50:

    # "{sc=2}Ya que, dejas de ser 'tú' y pasas a ser yo.{/sc}"
    "{sc=2}Since you stop being 'you' and become me.{/sc}"

# game/rutas/septem.rpy:1934
translate ingles rutaseptem_ec62fb93:

    # "{sc=2}Pasas a experimentar en carne propia mi percepción de este mundo.{/sc}"
    "{sc=2}You begin to experience firsthand my perception of this world.{/sc}"

# game/rutas/septem.rpy:1935
translate ingles rutaseptem_007dbc04:

    # "{sc=2}Mis deseos y pensamientos...{/sc}"
    "{sc=2}My desires and thoughts...{/sc}"

# game/rutas/septem.rpy:1938
translate ingles rutaseptem_f6115f6c:

    # septem "Demonios..."
    septem "Damn..."

# game/rutas/septem.rpy:1939
translate ingles rutaseptem_7e194bc9:

    # septem "Bien escucha, haremos algo."
    septem "Okay, listen. We'll do something."


# game/rutas/septem.rpy:1940
translate ingles rutaseptem_8cb3dac2:

    # septem "Te prometí más libertad en este mundo, por lo que te la daré."
    septem "I promised you more freedom in this world, so I'll give it to you."

# game/rutas/septem.rpy:1941
translate ingles rutaseptem_3a5b8d2c:

    # septem "No tengo medios ni el conocimiento para crearte un cuerpo nuevo que sea capaz de albergarte dentro, pero si puedo modificar el mío."
    septem "I have neither the means nor the knowledge to create a new body capable of holding you, but I can modify my own."

# game/rutas/septem.rpy:1942
translate ingles rutaseptem_87b5538d:

    # "{sc=2}Me levanto del altar, y observo el lugar.{/sc}"
    "{sc=2}I rise from the altar and look around.{/sc}"

# game/rutas/septem.rpy:1943
translate ingles rutaseptem_fad6116a:

    # "{sc=2}Rafael está en el suelo, Respirando... eso es bueno. Él está bien.{/sc}"
    "{sc=2}Rafael is on the floor, breathing... that's good. He's fine.{/sc}"

# game/rutas/septem.rpy:1944
translate ingles rutaseptem_16707226:

    # "{sc=2}De la marioneta no hay rastro, ¿Será que se ha desintegrado?{/sc}"
    "{sc=2}There's no trace of the puppet. Could it have disintegrated?{/sc}"

# game/rutas/septem.rpy:1945
translate ingles rutaseptem_3d49d54d:

    # "{sc=2}No logro percibir su presencia en mi dominio.{/sc}"
    "{sc=2}I can't sense its presence within my domain.{/sc}"

# game/rutas/septem.rpy:1948
translate ingles rutaseptem_1c080ed7:

    # septem "Eso creo."
    septem "I think so."

# game/rutas/septem.rpy:1951
translate ingles rutaseptem_e8b0a257:

    # septem "No lo sé..."
    septem "I don't know..."

# game/rutas/septem.rpy:1953
translate ingles rutaseptem_0893abd6:

    # septem "Luego me preocuparé por eso."
    septem "I'll worry about that later."

# game/rutas/septem.rpy:1954
translate ingles rutaseptem_7abbf2b1:

    # septem "Ahora debo---"
    septem "Now I must--"

# game/rutas/septem.rpy:1955
translate ingles rutaseptem_a9429add:

    # "{sc=2}Trasladar el cuerpo de Rafael a una habitación segura.{/sc}"
    "{sc=2}Move Rafael's body to a safe room.{/sc}"

# game/rutas/septem.rpy:1956
translate ingles rutaseptem_36e3059f:

    # "El cuerpo de Rafael desaparece del templo con el aplauso de tus manos. Él reposa inconciente en su cama y no hay nada que puedas hacer para despertarlo..."
    "Rafael's body vanishes from the temple with the clap of your hands. He now rests unconscious in his bed, and there's nothing you can do to wake him..."

# game/rutas/septem.rpy:1957
translate ingles rutaseptem_3f8a0e83:

    # "No sin un corazón apto para él..."
    "Not without a heart fit for him..."

# game/rutas/septem.rpy:1958
translate ingles rutaseptem_81d23bca:

    # septem "Luego veremos que podemos hacer con Rafael..."
    septem "We'll see what we can do with Rafael later..."

# game/rutas/septem.rpy:1959
translate ingles rutaseptem_0f75eb21:

    # septem "Primero--"
    septem "First--"

# game/rutas/septem.rpy:1960
translate ingles rutaseptem_b74f8ebf:

    # septem "Te daré manos, para que puedas interactuar con el lugar."
    septem "I'll give you hands, so you can interact with this place."

# game/rutas/septem.rpy:1961
translate ingles rutaseptem_45d78ef6:

    # septem "Intentaré hacerlo ahora."
    septem "I'll attempt it now."

# game/rutas/septem.rpy:1962
translate ingles rutaseptem_da56e291:

    # septem "Dos te bastarán, supongo."
    septem "Two should be enough, I suppose."

# game/rutas/septem.rpy:1964
translate ingles rutaseptem_eac37c47:

    # "{sc=2}Suspiro y comienzo a realizar cánticos que siempre he sabido,\npero que nunca he intentado hacerlo.{/sc}"
    "{sc=2}I sigh and begin chanting words I've always known,\nbut never dared to perform.{/sc}"

# game/rutas/septem.rpy:1965
translate ingles rutaseptem_5b711e11:

    # "{sc=2}Por respeto a Padre... esta es una invocación personal de él.{/sc}"
    "{sc=2}Out of respect for Father... this is one of his personal invocations.{/sc}"

# game/rutas/septem.rpy:1966
translate ingles rutaseptem_ccd2073a:

    # "{sc=2}Una invocación de emergencia... de protección. Que jamás creí\nverla en algún momento.{/sc}"
    "{sc=2}An invocation of emergency... of protection. I never thought I'd ever use it.{/sc}"

# game/rutas/septem.rpy:1967
translate ingles rutaseptem_26a6400d:

    # "{sc=2}Hasta que Nulla le borró un brazo a Padre.{/sc}"
    "{sc=2}Until Nulla erased Father's arm.{/sc}"

# game/rutas/septem.rpy:1968
translate ingles rutaseptem_aaf22b68:

    # "{sc=2}Aún recuerdo ver a Padre, 7 días después de que yo recibiera\nel cuerpo de Rafael.{/sc}"
    "{sc=2}I still remember seeing Father, seven days after I received Rafael's body.{/sc}"

# game/rutas/septem.rpy:1969
translate ingles rutaseptem_d922cad0:

    # "{sc=2}Fue la primera vez y la última que lo vi de esa forma.{/sc}"
    "{sc=2}It was the first and last time I saw him that way.{/sc}"

# game/rutas/septem.rpy:1970
translate ingles rutaseptem_9baf8852:

    # "{sc=2}Luego de eso se esfumó.{/sc}"
    "{sc=2}After that, he vanished.{/sc}"

# game/rutas/septem.rpy:1971
translate ingles rutaseptem_fd303b95:

    # "{sc=2}Ni siquiera tuve la oportunidad de despedirlo... él solo me\ndio la vela y me dijo que castigaría a Sextam.{/sc}"
    "{sc=2}I didn't even get the chance to say goodbye... \nhe just handed me the candle and said he would punish Sextam.{/sc}"

# game/rutas/septem.rpy:1972
translate ingles rutaseptem_755136c5:

    # "{sc=2}...No pensé que el castigo se extendería a todos por tanto tiempo.{/sc}"
    "{sc=2}... I didn't think the punishment would extend to everyone for so long.{/sc}"

# game/rutas/septem.rpy:1973
translate ingles rutaseptem_ab10dab7:

    # "{sc=2}Lo subestimé.{/sc}"
    "{sc=2}I underestimated him.{/sc}"

# game/rutas/septem.rpy:1976
translate ingles rutaseptem_e8cbf0bf:

    # septem "Ah-"
    septem "Ah--"

# game/rutas/septem.rpy:1984
translate ingles rutaseptem_31924e0f_12:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:1985
translate ingles rutaseptem_6d8bb281:

    # septem "Tienes razón."
    septem "You're right."

# game/rutas/septem.rpy:1986
translate ingles rutaseptem_de0a4f6f:

    # "{sc=2}Tengo que continuar.{/sc}"
    "{sc=2}I must continue.{/sc}"

# game/rutas/septem.rpy:1987
translate ingles rutaseptem_0a9efebc:

    # "{sc=2}En voz alta recito el trato para que obtengas más libertad.{/sc}"
    "{sc=2}Out loud, I recite the pact so that you may gain more freedom.{/sc}"

# game/rutas/septem.rpy:1988
translate ingles rutaseptem_73b60684:

    # "{sc=2}Y no estés obligado a leerme de esta manera.{/sc}"
    "{sc=2}So you're no longer bound to read me this way.{/sc}"

# game/rutas/septem.rpy:1989
translate ingles rutaseptem_2a2ae279:

    # "{sc=2}Supongo que es mejor de esta forma.{/sc}"
    "{sc=2}I suppose it's better like this.{/sc}"

# game/rutas/septem.rpy:1990
translate ingles rutaseptem_d47632bc:

    # septem "[nombrejugador]."
    septem "[nombrejugador]."

# game/rutas/septem.rpy:1991
translate ingles rutaseptem_d968ab1c:

    # septem "Para satisfacer tu necesidad de involucrarte con este mundo."
    septem "To satisfy your need to be involved with this world."


# game/rutas/septem.rpy:1992
translate ingles rutaseptem_f44674ec:

    # septem "Y como tengo el rol de ser tu anfitrión, intentaré cumplir con mi palabra."
    septem "And since I have the role of being your host, I'll try to keep my word."

# game/rutas/septem.rpy:1993
translate ingles rutaseptem_c47efcb9:

    # septem "Ahora vas a tener mi ojo principal y manos para hacer lo que se te plazca."
    septem "Now you'll have my main eye and my hands to do as you please."

# game/rutas/septem.rpy:1994
translate ingles rutaseptem_565d79f9:

    # septem "Poder interactuar un poco más con mi mundo. De manera limitada, pero a la vez, con más libertad de la que tenías antes."
    septem "You'll be able to interact a little more with my world. In a limited way, yet with more freedom than you had before."

# game/rutas/septem.rpy:1995
translate ingles rutaseptem_8dd73d9c:

    # septem "No perderemos la conexión cuerpo y alma, pero, ahora tendrás una perspectiva nueva."
    septem "We won't lose our body-and-soul connection, but now you'll have a new perspective."

# game/rutas/septem.rpy:1996
translate ingles rutaseptem_96707822:

    # septem "Me dejarás de lado parcialmente, ya que no serás 'yo',\nsino unas manos y ojos."
    septem "You'll set me aside, partially, since you won't be 'me,' but rather, a pair of hands and eyes."

# game/rutas/septem.rpy:1997
translate ingles rutaseptem_722e2fd4:

    # septem "Y yo, seguiré siendo tu narrador y marioneta, aún."
    septem "And I'll still remain your narrator and puppet."

# game/rutas/septem.rpy:1998
translate ingles rutaseptem_1930337a:

    # "{sc=2}Mis manos comienzan a realizar señales que parecen ilegales\nde invocar, como si manchara el nombre de Padre en el proceso.{/sc}"
    "{sc=2}My hands begin to trace sigils that feel forbidden to summon--\nas if staining the name of Father in the process.{/sc}"

# game/rutas/septem.rpy:1999
translate ingles rutaseptem_4e5335e2:

    # "{sc=2}Cánticos son llamados en latín y comienzo a ceder parte de este\ncuerpo divino, a ti.{/sc}"
    "{sc=2}Chants rise in Latin as I begin to yield part of this divine body to you.{/sc}"

# game/rutas/septem.rpy:2000
translate ingles rutaseptem_76da7eea:

    # "{sc=2}Al tiempo de creo nuevas manos, para ti.{/sc}"
    "{sc=2}And in time, I create new hands for you.{/sc}"

# game/rutas/septem.rpy:2001
translate ingles rutaseptem_33bc4d58:

    # "{sc=2}Parte de mi ser se despega, para dárselos a ti.\nY junto con ello te cedo control.{/sc}"
    "{sc=2}A fragment of my being detaches, to be given to you.\nAlong with it, I grant you control.{/sc}"

# game/rutas/septem.rpy:2002
translate ingles rutaseptem_95846236:

    # "{sc=2}El control es lo primordial.{/sc}"
    "{sc=2}Control is what matters most.{/sc}"

# game/rutas/septem.rpy:2003
translate ingles rutaseptem_13086876:

    # "{sc=2}..........{/sc}"
    "{sc=2}..........{/sc}"

# game/rutas/septem.rpy:2005
translate ingles rutaseptem_a4c1b6b4:

    # "-------------------"
    "---------------"

# game/rutas/septem.rpy:2007
translate ingles rutaseptem_03ab0950:

    # "__________{b}Septem te sede parte de su identidad.{/b}_________"
    "_____{b}Septem grants you part of his identity.{/b}_____"

# game/rutas/septem.rpy:2008
translate ingles rutaseptem_41dab526:

    # "El ojo y las manos ya son tuyos."
    "The eye and hands are now yours."

# game/rutas/septem.rpy:2009
translate ingles rutaseptem_f7f48294:

    # "Ahora son de tu propiedad."
    "They now belong to you."

# game/rutas/septem.rpy:2014
translate ingles rutaseptem_bb45e49c:

    # septem "Ahora tienes un pedacito de mí que puedes controlar."
    septem "Now you have a little piece of me you can control."

# game/rutas/septem.rpy:2015
translate ingles rutaseptem_f1eddda9:

    # septem "Espero que esto sea de tu agrado, [nombrejugador]."
    septem "I hope this pleases you, [nombrejugador]."

# game/rutas/septem.rpy:2016
translate ingles rutaseptem_d72a97ba:

    # septem "Seguirás siendo capaz de sentirme, pero tu punto de vista no será el mío."
    septem "You'll still be able to feel me, but your point of view won't be mine."

# game/rutas/septem.rpy:2017
translate ingles rutaseptem_b853d253:

    # septem "Supongo que es..."
    septem "I suppose it's..."

# game/rutas/septem.rpy:2020
translate ingles rutaseptem_67c001f3:

    # septem "Como una nueva marioneta, solo que más básica."
    septem "Like a new puppet, just a simpler one."

# game/rutas/septem.rpy:2021
translate ingles rutaseptem_b03915ab:

    # septem "Espero poder hacerte una completa más adelante."
    septem "I hope I can make you a complete one later."

# game/rutas/septem.rpy:2022
translate ingles rutaseptem_7f06ef10:

    # septem "Ahora puedes probar tus nuevas manos."
    septem "You may try your new hands now."

# game/rutas/septem.rpy:2031
translate ingles continuacion1_64d6d88d:

    # "Tus manos dejan de operar y en cuestión de segundos, Septem tiene el control de ellas."
    "Your hands stop moving, and within seconds, Septem takes control of them."

# game/rutas/septem.rpy:2032
translate ingles continuacion1_f23e099f:

    # "Las mueve de un lado a otro, mueve los dedos: abriendo y cerrando los puños, probando sus funciones."
    "He moves them side to side, flexes the fingers, opening and closing the fists, testing their functions."

# game/rutas/septem.rpy:2034
translate ingles continuacion1_ca60fab0:

    # septem "Están en buen estado."
    septem "They're in good condition."

# game/rutas/septem.rpy:2035
translate ingles continuacion1_4203a33e:

    # septem "Es un muy buen primer intento."
    septem "It's a very good first attempt."

# game/rutas/septem.rpy:2038
translate ingles continuacion1_206f0224:

    # "{sc=2}Seguramente Padre estaría orgulloso.{/sc}"
    "{sc=2}Surely, Father would be proud.{/sc}"

# game/rutas/septem.rpy:2039
translate ingles continuacion1_a20cefa7:

    # "..."
    "..."

# game/rutas/septem.rpy:2042
translate ingles continuacion1_fb61d172:

    # septem "Como sea, esto es un regalo."
    septem "Anyway, this is a gift."

# game/rutas/septem.rpy:2045
translate ingles continuacion1_155e4350:

    # septem "Espero que lo sepas apreciar, [nombrejugador]."
    septem "I hope you appreciate it, [nombrejugador]."

# game/rutas/septem.rpy:2048
translate ingles continuacion1_d40a5a59:

    # "Se crea un silencio luego de sus palabras. Y Septem siente que se le está olvidando algo."
    "A silence follows his words, and Septem feels like he's forgetting something."

# game/rutas/septem.rpy:2050
translate ingles continuacion1_ddbc4ac7:

    # "No le cuesta mucho recordar de que es, por lo que te pide que lo acompañes."
    "It doesn't take him long to remember what it was, and so he asks you to come with him."


# game/rutas/septem.rpy:2051
translate ingles continuacion1_929d1c00:

    # "Es la hora de almorzar."
    "It's time for lunch."

# game/rutas/septem.rpy:2053
translate ingles continuacion1_13bb1bd2:

    # "Inconscientemente se encamina a la cocina."
    "He unconsciously heads toward the kitchen."

# game/rutas/septem.rpy:2054
translate ingles continuacion1_e3604759:

    # "Mientras camina, levanta sus manos para conjurar los ingredientes. Pero su poca energía lo detiene y lo hace recapacitar."
    "As he walks, he raises his hands to conjure the ingredients. But his low energy stops him, making him reconsider."

# game/rutas/septem.rpy:2057
translate ingles continuacion1_16909c59:

    # "'¿Qué estoy haciendo?' se pregunta."
    "'What am I doing?' he asks himself."

# game/rutas/septem.rpy:2058
translate ingles continuacion1_a3c2a4d4:

    # "Luego para en seco, mira sus pies, el mesón y luego a ti."
    "Then he stops abruptly, looks at his feet, the counter, and then at you."

# game/rutas/septem.rpy:2059
translate ingles continuacion1_b76eafa7:

    # "Hay un silencio tanto fuera como dentro de él. Un cortocircuito ocurriendo dentro que lo trae y le hace caer en cuenta de la estupidez que está haciendo."
    "There's silence both inside and out of him. A short circuit within brings him back to his senses and he realizes the stupidity of what he's doing."

# game/rutas/septem.rpy:2060
translate ingles continuacion1_1c1812a5:

    # "Y luego una explosión invisible, que solo tú y él pueden sentir."
    "Then, an intangible burst of embarrassment occurs, one that only you and he can feel."

# game/rutas/septem.rpy:2061
translate ingles continuacion1_b9e373c3:

    # "Saboreas la vergüenza que burbujea en su estómago por un momento."
    "You taste the shame bubbling in his stomach for a moment."

# game/rutas/septem.rpy:2062
translate ingles continuacion1_e302a4b6:

    # "Pero su cara no lo demuestra."
    "But his face doesn't show it."

# game/rutas/septem.rpy:2063
translate ingles continuacion1_4f213bf6:

    # "Y tú solamente la puedes saborear gracias a la conexión que tienen."
    "And you can only taste it thanks to the connection you share."

# game/rutas/septem.rpy:2064
translate ingles continuacion1_a697fe19:

    # "Ahora Septem no te puede ocultar sus emociones."
    "Now Septem can't hide his emotions from you."

# game/rutas/septem.rpy:2065
translate ingles continuacion1_23cc10d4:

    # "Y eso hace que sienta aun más vergüenza."
    "And that makes him feel even more humiliated."

# game/rutas/septem.rpy:2068
translate ingles continuacion1_4c39d4d0:

    # "Y enojo..."
    "And angry..."

# game/rutas/septem.rpy:2069
translate ingles continuacion1_c0c967f4:

    # "Pero no te va a dar el gusto de verlo reflejado en su cara."
    "... But he won't give you the satisfaction of seeing it on his face."

# game/rutas/septem.rpy:2070
translate ingles continuacion1_cb7cae08:

    # "Eso sería como perder dos veces."
    "That would be like losing twice."

# game/rutas/septem.rpy:2073
translate ingles continuacion1_a2ef4597:

    # "Con un suspiro pesado Septem se endereza y te corre la mirada."
    "With a heavy sigh, Septem straightens up and looks away from you."

# game/rutas/septem.rpy:2076
translate ingles continuacion1_0c8a2cd5:

    # "Sientes como Septem no sabe que hacer. Ya no tiene un propósito claro para el día de hoy."
    "You sense how Septem doesn't know what to do. He no longer has a clear purpose for the day."

# game/rutas/septem.rpy:2077
translate ingles continuacion1_1f2e3f41:

    # "Ya no necesita descansar del cuerpo, ni hacer sus comidas estrictas y no tan elaboradas."
    "He no longer needs to rest his body, nor prepare his strict, plain meals."

# game/rutas/septem.rpy:2078
translate ingles continuacion1_35766e18:

    # "Su rutina ya no tiene razón de ser ni existir."
    "His routine no longer has a reason to exist."

# game/rutas/septem.rpy:2079
translate ingles continuacion1_11260768:

    # "Su cuerpo, a pesar de ser muy parecido al antiguo en cuanto a órganos y piel, es autosuficiente."
    "His body, though similar to his old one in organs and skin, is self-sustaining."

# game/rutas/septem.rpy:2080
translate ingles continuacion1_6c6ae0af:

    # "El corazón late gracias a la energía divina, y mantiene el resto del cuerpo como si de un motor único se tratase."
    "His heart beats thanks to divine energy, keeping the rest of his body running like a single engine."

# game/rutas/septem.rpy:2081
translate ingles continuacion1_2bb93609:

    # "Pero ya no hay necesidad de mantenerlo con ritos y rutinas que toman tiempo del día, y forman parte de la experiencia de tener un cuerpo mortal."
    "But there's no need to sustain it with rituals and routines that consume time and simulate the experience of having a mortal body."

# game/rutas/septem.rpy:2082
translate ingles continuacion1_da54869b:

    # "Ya no hay nada que hacer para pasar las horas que realmente tenga un propósito o misión por cumplir."
    "There's nothing left to do to pass the hours with real purpose or mission anymore."

# game/rutas/septem.rpy:2083
translate ingles continuacion1_477cfe65:

    # "Septem jamás ha tenido tiempo muerto, y sientes como la ansiedad comienza a trepar por sus pies."
    "Septem has never had idle time, and you feel anxiety begin to creep up from his feet."

# game/rutas/septem.rpy:2084
translate ingles continuacion1_55f09d3e:

    # "Gritando y demandando hacer algo."
    "Screaming and demanding to do something."

# game/rutas/septem.rpy:2085
translate ingles continuacion1_8ce2582d:

    # "Septem no sabe que hacer..."
    "Septem doesn't know what to do..."

# game/rutas/septem.rpy:2090
translate ingles continuacion1_f95bd36f:

    # septem "Creo que tomar aire me ayudaría..."
    septem "I think getting some air would help..."

# game/rutas/septem.rpy:2096
translate ingles continuacion1_a20cefa7_1:

    # "..."
    "..."

# game/rutas/septem.rpy:2102
translate ingles continuacion2_e52bb84a:

    # "Pasan tres días, en los que Septem se dedica a observar el cuerpo de Rafael y acostumbrarse a tu presencia. A tu eterna compañía."
    "Three days pass, during which Septem dedicates himself to observing Rafael's body and getting used to your presence. To your eternal company."

# game/rutas/septem.rpy:2103
translate ingles continuacion2_8b214663:

    # "La cual no lo abandona ni por un momento."
    "Which doesn't leave him for a single moment."

# game/rutas/septem.rpy:2104
translate ingles continuacion2_796efcc3:

    # "Casi que ahogándolo con tu presencia."
    "Almost suffocating him with your presence."

# game/rutas/septem.rpy:2105
translate ingles continuacion2_65a58063:

    # "Pero, ya no le parece tan incómodo como antes."
    "But now, it doesn't feel as uncomfortable as before."

# game/rutas/septem.rpy:2106
translate ingles continuacion2_025d47b1:

    # "Septem ya ha aceptado tu compañía."
    "Septem has already accepted your company."

# game/rutas/septem.rpy:2107
translate ingles continuacion2_d4fc2ab6:

    # "La pieza en que se encuentra Rafael es exactamente igual a todas las habitaciones que existen en el templo de Septem."
    "The room where Rafael lies is identical to all the others in Septem's temple."

# game/rutas/septem.rpy:2108
translate ingles continuacion2_7d1c4b10:

    # "Con lo justo y necesario."
    "Consisting of only what's necessary."

# game/rutas/septem.rpy:2110
translate ingles continuacion2_a20cefa7:

    # "..."
    "..."

# game/rutas/septem.rpy:2111
translate ingles continuacion2_e51967c5:

    # "Septem observa con las cejas fruncidas a Rafael, quien yace dormido."
    "Septem observes Rafael, who lies asleep, with furrowed eyebrows."

# game/rutas/septem.rpy:2112
translate ingles continuacion2_c94249b5:

    # "Al mirarlo, no puedes detectar los latidos de su corazón."
    "When you look at him, you can't detect his heartbeat."

# game/rutas/septem.rpy:2113
translate ingles continuacion2_e06f7b63:

    # "Pero él respira sin problemas."
    "But he breathes without issue."

# game/rutas/septem.rpy:2117
translate ingles continuacion2_4d5c1cc8:

    # septem "Yo estoy manteniendo su cuerpo con mi energía."
    septem "I'm sustaining his body with my energy."


# game/rutas/septem.rpy:2118
translate ingles continuacion2_efa0a51e:

    # "Te confiesa sin titubear."
    "He confesses without hesitation."

# game/rutas/septem.rpy:2119
translate ingles continuacion2_cf86a3d8:

    # "Así que es por esto que Septem no tiene la energía suficiente para invocar o hacerte un cuerpo."
    "So this is why Septem doesn't have enough energy to summon or create a body for you."

# game/rutas/septem.rpy:2123
translate ingles continuacion2_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:2124
translate ingles continuacion2_c8f5a159:

    # septem "Sí."
    septem "Yes."

# game/rutas/septem.rpy:2125
translate ingles continuacion2_bfdae192:

    # septem "Conozco todo de él, es imposible no tenerle aprecio."
    septem "I know everything about him, it's impossible not to care for him."

# game/rutas/septem.rpy:2129
translate ingles continuacion2_2d981552:

    # septem "Es mi compañero."
    septem "He's my companion."

# game/rutas/septem.rpy:2130
translate ingles continuacion2_1157a928:

    # septem "Me ayudó a entender muchas cosas."
    septem "He helped me understand many things."

# game/rutas/septem.rpy:2131
translate ingles continuacion2_c6081ab9:

    # septem "Y yo lo traté muy mal por un tiempo..."
    septem "And I treated him badly for a while..."

# game/rutas/septem.rpy:2132
translate ingles continuacion2_f9b83e55:

    # septem "Se lo debo."
    septem "I owe him."

# game/rutas/septem.rpy:2136
translate ingles continuacion2_366e078c:

    # septem "Llegó a mí con ese problema."
    septem "He came to me with that problem."

# game/rutas/septem.rpy:2137
translate ingles continuacion2_1502f507:

    # septem "No tengo idea como crearle un corazón independiente de mi ser."
    septem "I have no idea how to create him a heart that's independent of my being."

# game/rutas/septem.rpy:2138
translate ingles continuacion2_74f28f84:

    # septem "A pesar de que le hice uno cuando salí de su cuerpo, este no funciona."
    septem "Even though I made one for him when I left his body, it doesn't work."

# game/rutas/septem.rpy:2139
translate ingles continuacion2_147bb2fb:

    # "Septem suspira."
    "Septem sighs."

# game/rutas/septem.rpy:2144
translate ingles continuacion2_ad637db5:

    # septem "¿Qué?"
    septem "What?"

# game/rutas/septem.rpy:2145
translate ingles continuacion2_e2ccefb0:

    # septem "¿Qué te hace pensar eso?"
    septem "What makes you think that?"

# game/rutas/septem.rpy:2149
translate ingles continuacion2_90676ccc:

    # "Sus ojos se clavan en ti, acompañados por un ceño fruncido que marca su piel con arrugas notorias."
    "His eyes lock on you, accompanied by a frown that carves wrinkles into his skin."

# game/rutas/septem.rpy:2151
translate ingles continuacion2_def41ccb:

    # septem "¿¡Te has metido sin permiso a su habitación?!"
    septem "Did you go into his room without permission?!"

# game/rutas/septem.rpy:2152
translate ingles continuacion2_46129b27:

    # "La voz de Septem se eleva con cada palabra, afilada y visceral. Aprieta los puños y tensa sus hombros, no sabiendo cómo canalizar la rabia que crece mientras más piensa en tus transgresiones."
    "Septem's voice rises with each word, sharp and visceral. He clenches his fists and tenses his shoulders, unsure how to channel the anger growing as he dwells on your transgressions."

# game/rutas/septem.rpy:2153
translate ingles continuacion2_edad09c0:

    # "Pero al enfocar sus ojos y analizar lo que ven, se da cuenta de que ya no está la marioneta."
    "But as he focuses his gaze and analyzes what he sees, he realizes the puppet is no longer there."

# game/rutas/septem.rpy:2154
translate ingles continuacion2_28166f96:

    # "Ahora solo estás tú, sin intermediario. Tú, el que puede ayudarlo a salvar el jardín."
    "Now it's just you, without an intermediary. You, the one who can help him save the Garden."

# game/rutas/septem.rpy:2155
translate ingles continuacion2_47f26d1d:

    # "Tú, nuevo amo y señor del jardín, si todo sale bien."
    "You, the new master and lord of the Garden, if all goes well."

# game/rutas/septem.rpy:2157
translate ingles continuacion2_b3ea32f1:

    # "Septem se controla, cierra los ojos y comienza a contar mentalmente hasta 10."
    "Septem controls himself, closes his eyes, and begins counting silently to ten."

# game/rutas/septem.rpy:2158
translate ingles continuacion2_04441ce9:

    # "A su mente llega la imagen de Rafael y lo que has dicho."
    "The image of Rafael and what you said comes to mind."

# game/rutas/septem.rpy:2159
translate ingles continuacion2_bcc5750b:

    # "Y con pena acepta que debes tener razón."
    "And with regret, he admits you must be right."

# game/rutas/septem.rpy:2160
translate ingles continuacion2_46e236ed:

    # "Su cuerpo deja de estar tenso: sus hombros caen y sus puños ceden, abriéndose en el proceso para poder tocarse el cabello y peinarlo hacia atrás."
    "His body relaxes. His shoulders drop, his fists unclench, and he runs a hand through his hair, brushing it back."

# game/rutas/septem.rpy:2161
translate ingles continuacion2_e8c2b626:

    # septem "Dejé de escribirle y perdimos comunicación."
    septem "I stopped writing to him, and we lost touch."

# game/rutas/septem.rpy:2162
translate ingles continuacion2_af66c78e:

    # septem "Supongo que él me debe odiar ahora."
    septem "I suppose he must hate me now."

# game/rutas/septem.rpy:2164
translate ingles continuacion2_e7a056a2:

    # septem "Hmmm."
    septem "Hmmm."

# game/rutas/septem.rpy:2168
translate ingles continuacion2_a20cefa7_1:

    # "..."
    "..."

# game/rutas/septem.rpy:2173
translate ingles continuacion2_493add4d:

    # "Septem te mira con asco por un segundo."
    "For a moment, Septem looks at you with disgust."

# game/rutas/septem.rpy:2174
translate ingles continuacion2_fe47002d:

    # septem "¿De donde has sacado eso?"
    septem "Where did you get that from?"

# game/rutas/septem.rpy:2175
translate ingles continuacion2_5b991c01:

    # septem "¿Has leído mal los documentos?..."
    septem "Did you misread the documents?..."

# game/rutas/septem.rpy:2176
translate ingles continuacion2_a7eade4d:

    # "Aprieta los puños, enojado. Como si el solo pensamiento fuera suficiente para sacarlo de sus casillas. Ya sea por el contenido de aquellos documentos en sí o por el hecho de como tú los has supuestamente encontrado."
    "He clenches his fists, angry. The thought alone seems enough to throw him off--whether because of the documents themselves or how you supposedly found them."

# game/rutas/septem.rpy:2177
translate ingles continuacion2_95af3307:

    # "De cualquier manera, Septem recapacita y suspira."
    "Either way, Septem reconsiders and sighs."

# game/rutas/septem.rpy:2178
translate ingles continuacion2_d0b2aec4:

    # septem "Imposible... tú no puedes leer latín."
    septem "Impossible... you can't read Latin."

# game/rutas/septem.rpy:2180
translate ingles continuacion2_bc71cbf1:

    # "Sus ojos vuelve a recaer en el cuerpo de Rafael."
    "His eyes fall back on Rafael's body."

# game/rutas/septem.rpy:2181
translate ingles continuacion2_7c81ec0d:

    # septem "Claro que no es mi hijo."
    septem "Of course he's not my son."

# game/rutas/septem.rpy:2182
translate ingles continuacion2_b0cdca83:

    # "Refunfuña."
    "He grumbles."

# game/rutas/septem.rpy:2183
translate ingles continuacion2_267d1eab:

    # septem "Yo solo cuido su cuerpo y lo mantengo vivo."
    septem "I just care for his body and keep him alive."

# game/rutas/septem.rpy:2188
translate ingles continuacion2_b7b51460:

    # "Hay un silencio, pero es ese tipo de silencio abrumador y pesado."
    "There's a silence... the heavy, overwhelming kind."

# game/rutas/septem.rpy:2189
translate ingles continuacion2_d868206a:

    # "Pero si nostálgico."
    "But nostalgic nonetheless."

# game/rutas/septem.rpy:2191
translate ingles continuacion2_65e7f37c:

    # "Septem se encamina para salir de la habitación."
    "Septem starts walking toward the door."

# game/rutas/septem.rpy:2193
translate ingles continuacion2_ae0dce14:

    # septem "Rafael es un buen escritor."
    septem "Rafael is a good writer."

# game/rutas/septem.rpy:2194
translate ingles continuacion2_17dc31e7:

    # septem "Nos comunicábamos por un Diario."
    septem "We used to communicate through a journal."

# game/rutas/septem.rpy:2195
translate ingles continuacion2_068281d0:

    # septem "Me gustaba leer lo que escribía para mi cada vez que retomaba su cuerpo."
    septem "I liked reading what he wrote for me each time he returned to his body."

# game/rutas/septem.rpy:2196
translate ingles continuacion2_581f9f7b:

    # septem "Después de cada comida..."
    septem "After every meal..."

# game/rutas/septem.rpy:2199
translate ingles continuacion2_dad2dba8:

    # septem "Extraño un poco hacer ello."
    septem "I kind of miss doing that."

# game/rutas/septem.rpy:2200
translate ingles continuacion2_088d9b63:

    # "Hay una pausa en sus movimientos, parpadea con incredulidad al darse cuenta de que te está soltando información que no has pedido."
    "There's a pause in his movements; he blinks in disbelief, realizing he's telling you things you didn't even ask for."

# game/rutas/septem.rpy:2201
translate ingles continuacion2_18cdb70f:

    # "Y de lo extraño que es hablar de manera tan libre contigo."
    "And how strange it feels to speak so freely with you."

# game/rutas/septem.rpy:2202
translate ingles continuacion2_83cc51c8:

    # "Aquello le perturba un poco."
    "That unsettles him a little."

# game/rutas/septem.rpy:2209
translate ingles continuacion2_b63d5746:

    # "Septem levanta la mano, claro signo de que no quiere oír tu respuesta."
    "Septem raises his hand, a clear sign he doesn't want to hear your reply."

# game/rutas/septem.rpy:2210
translate ingles continuacion2_e981eb8b:

    # "Pero, muy dentro de él, percibes que Septem está cerrando una puerta para evitar soltar toda la explosión de emociones y preocupaciones."
    "But deep down, you sense that Septem is closing a door to stop himself from releasing the flood of emotions and worries inside."

# game/rutas/septem.rpy:2211
translate ingles continuacion2_ec751469:

    # "Intentando proteger su ego."
    "Trying to protect his ego."


# game/rutas/septem.rpy:2214
translate ingles continuacion2_bcdc9e5f:

    # septem "Te pido una disculpa."
    septem "I owe you an apology."

# game/rutas/septem.rpy:2215
translate ingles continuacion2_0415cf55:

    # septem "No quiero hacerte cargar con mis penurias."
    septem "I don't want to make you bear my burdens."

# game/rutas/septem.rpy:2216
translate ingles continuacion2_544bcfd4:

    # septem "Tampoco es necesario que me consueles."
    septem "Nor is it necessary for you to comfort me."

# game/rutas/septem.rpy:2217
translate ingles continuacion2_1fe9e8ce:

    # septem "No lo necesito."
    septem "I don't need it."

# game/rutas/septem.rpy:2218
translate ingles continuacion2_60380370:

    # "Dice de manera solemne."
    "He says it solemnly."

# game/rutas/septem.rpy:2224
translate ingles continuacion2_9c8060a1:

    # septem "Te he dicho que no lo necesito."
    septem "I told you, I don't need it."

# game/rutas/septem.rpy:2225
translate ingles continuacion2_adea01e4:

    # "Su voz se transforma, volviéndose brusca y ronca."
    "His voice shifts, turning rough and coarse."

# game/rutas/septem.rpy:2226
translate ingles continuacion2_2f485739:

    # "Se está enojando pero se contiene..."
    "He's getting angry, but restrains himself..."

# game/rutas/septem.rpy:2249
translate ingles continuacion2_f7b4837e:

    # septem "No hay nada que tú o yo podamos hacer ahora."
    septem "There's nothing you or I can do right now."

# game/rutas/septem.rpy:2250
translate ingles continuacion2_58f31d5d:

    # septem "Solo esperar..."
    septem "Only wait..."

# game/rutas/septem.rpy:2255
translate ingles continuacion2_9ff633ec:

    # "Hay un segundo de quietud, Septem está pensando que en podrían hacer hoy."
    "There's a moment of stillness while Septem ponders what you could do today."

# game/rutas/septem.rpy:2258
translate ingles continuacion2_ad9cdde6:

    # septem "Creo que podríamos cocinar..."
    septem "I think we could cook..."

# game/rutas/septem.rpy:2259
translate ingles continuacion2_b6be4ade:

    # septem "Para matar el tiempo..."
    septem "To pass the time..."

# game/rutas/septem.rpy:2260
translate ingles continuacion2_46845387:

    # septem "Rafael no despertará por más que lo observemos."
    septem "Rafael won't wake up no matter how much we watch him."

# game/rutas/septem.rpy:2261
translate ingles continuacion2_a8d547dc:

    # septem "El problema está en su corazón."
    septem "The problem lies in his heart."

# game/rutas/septem.rpy:2263
translate ingles continuacion2_e0b8c188:

    # "La cocina es tan pulcra que parece irreal. No hay rastros de nada fuera de su lugar, parece una foto."
    "The kitchen is so spotless it feels unreal. Nothing is out of place and it looks like a photograph."

# game/rutas/septem.rpy:2264
translate ingles continuacion2_3dec3d95:

    # "El espacio es suficiente para una persona, y no está pensada como un lugar para tener a alguien más."
    "The space is just enough for one person. It's not designed to accommodate anyone else."

# game/rutas/septem.rpy:2265
translate ingles continuacion2_3c6ce1f2:

    # "Septem te dice que realizarán tartaletas, que esa receta fue escrita en el diario que comparte con Rafael, pero que jamás quiso hacerlas."
    "Septem tells you that you'll make tartlets--a recipe written in the journal he shares with Rafael--but he never wanted to make them before."

# game/rutas/septem.rpy:2266
translate ingles continuacion2_8b38f427:

    # "Por falta de tiempo, dijo."
    "He said it was for lack of time."

# game/rutas/septem.rpy:2267
translate ingles continuacion2_f17ba5c1:

    # "Comienzan buscando los ingredientes. Tus manos buscan en las encimeras y en los cajones lo que Septem te pide. Hacer esto es raro, ya que pueden saltarse esto e invocar los ingredientes con un solo aplauso."
    "You begin searching for the ingredients. Your hands move across the counters and drawers, looking for what Septem asks. It feels odd to do this manually, since you could simply summon everything with a clap."

# game/rutas/septem.rpy:2268
translate ingles continuacion2_66adfa41:

    # "Tal vez sea la falta de energía, o tal vez sea que Septem quiere experimentar con lo cotidiano y humano de buscar las cosas por uno mismo."
    "Maybe it's the lack of energy, or maybe Septem wants to experience the human simplicity of searching for things on his own."

# game/rutas/septem.rpy:2269
translate ingles continuacion2_9bdeda47:

    # "Aunque también existe la posibilidad de que guste de verte complicado al intentar buscar cada cosa."
    "Though there's also the possibility he enjoys watching you struggle a little while looking for everything."

# game/rutas/septem.rpy:2270
translate ingles continuacion2_b62a5afb:

    # "Quién sabe..."
    "Who knows..."

# game/rutas/septem.rpy:2272
translate ingles continuacion2_ed80d749:

    # "Cuando ya tienen todo, comienzan a preparar las tartaletas."
    "Once everything is ready, you begin preparing the tartlets."

# game/rutas/septem.rpy:2273
translate ingles continuacion2_b3b1e64d:

    # "Mezclan, baten y separan los ingredientes."
    "You mix, whisk, and separate the ingredients."

# game/rutas/septem.rpy:2274
translate ingles continuacion2_6e2cd97c:

    # "Todo es muy ameno. El momento es grato."
    "It's all very pleasant. The moment feels warm."

# game/rutas/septem.rpy:2275
translate ingles continuacion2_76387f9a:

    # "Ver la cara de concentración de Septem no tiene precio. Hasta podrías imaginarte un día libre con él como tu compañero, preparando delicias para alguna visita o simplemente para ustedes."
    "Watching Septem's concentrated expression is priceless. You could almost imagine a day off with him as your companion, preparing treats for guests... or just for the two of you."

# game/rutas/septem.rpy:2276
translate ingles continuacion2_ddb74919:

    # "Ja."
    "Ha."

# game/rutas/septem.rpy:2277
translate ingles continuacion2_f81b6e25:

    # "Llega el momento de decorar y Septem decora una de ellas con dos frutas."
    "When it's time to decorate, Septem tops one with two pieces of fruit."

# game/rutas/septem.rpy:2281
translate ingles continuacion2_c8f5a159_1:

    # septem "Sí."
    septem "Yes."

# game/rutas/septem.rpy:2282
translate ingles continuacion2_647ff172:

    # septem "Quiero que el resto lo decores tú."
    septem "I want you to decorate the rest."

# game/rutas/septem.rpy:2283
translate ingles continuacion2_fa1305cb:

    # septem "He hecho todo el trabajo, estoy cansado..."
    septem "I've done all the work, I'm tired..."

# game/rutas/septem.rpy:2284
translate ingles continuacion2_40620be9:

    # "Dice el frunciendo el ceño. Pero estás seguro que no lo dice en serio. Septem ya no se cansa."
    "He says that with a frown. But you're sure he doesn't mean it: Septem doesn't get tired anymore."

# game/rutas/septem.rpy:2285
translate ingles continuacion2_174cb186:

    # "Y en más de una oportunidad lo has atrapado mirándote cuando mueves tus manos... con fascinación."
    "And more than once, you've caught him watching your hands move... fascinated."

# game/rutas/septem.rpy:2286
translate ingles continuacion2_5b4420d4:

    # septem "Adelante, [nombrejugador]~"
    septem "Go ahead, [nombrejugador]~"

# game/rutas/septem.rpy:2293
translate ingles continuacion2_1639f4bb:

    # "Luego de terminar, Septem aprecia tu trabajo, dedicándole una larga inspección con sus ojos. No puede evitar sonreír un poco."
    "After you finish, Septem admires your work, giving it a long, thoughtful look. He can't help but smile a little."

# game/rutas/septem.rpy:2294
translate ingles continuacion2_4933d0aa:

    # "Sin decir nada, toma una tartaleta para poder probarla."
    "Without saying a word, he takes one of the tarts to taste it."


# game/rutas/septem.rpy:2295
translate ingles continuacion2_4779798a:

    # "Se ve tan mundano que da miedo."
    "He looks so ordinary it's almost frightening."

# game/rutas/septem.rpy:2297
translate ingles continuacion2_74a95d10:

    # septem "Lo has hecho bien..."
    septem "You did well..."

# game/rutas/septem.rpy:2298
translate ingles continuacion2_53f6c4ed:

    # septem "Pero es extraño verte tomar las cosas..."
    septem "But it's strange to see you handling things..."

# game/rutas/septem.rpy:2301
translate ingles continuacion2_31924e0f_1:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:2302
translate ingles continuacion2_b585cf70:

    # septem "Ambas."
    septem "Both."

# game/rutas/septem.rpy:2303
translate ingles continuacion2_1c987803:

    # "Sus orejas se tiñen de un leve rosado."
    "His ears turn faintly pink."

# game/rutas/septem.rpy:2306
translate ingles continuacion2_8078ff8f:

    # septem "Sí... un poco."
    septem "Yes... a little."

# game/rutas/septem.rpy:2309
translate ingles continuacion2_c51d7991:

    # " . . . "
    " . . . "

# game/rutas/septem.rpy:2310
translate ingles continuacion2_42ad4afb:

    # "Las actividades del día de Septem se resumen en pasar el tiempo contigo, por obligación."
    "Septem's daily activities now amount to spending time with you out of obligation."

# game/rutas/septem.rpy:2311
translate ingles continuacion2_527aabe8:

    # "Pero él ya se ha acostumbrado, hasta, puedes sentir que no le disgusta, pero le cuesta encontrarle una lógica a ello. Y con ello viene un proceso de aceptación que no le resulta tan fácil."
    "But he's gotten used to it. You can even sense he doesn't mind it, though he struggles to find logic in that. Acceptance is a slow, uneasy process for him."

# game/rutas/septem.rpy:2312
translate ingles continuacion2_8c1ea06a:

    # "En todo momento estás ahí, acompañándolo."
    "You're there at all times, accompanying him."

# game/rutas/septem.rpy:2313
translate ingles continuacion2_21705463:

    # "Incluso los tiempos de silencio son disfrutados gracias a tu compañía."
    "Even the silence is pleasant thanks to your presence."

# game/rutas/septem.rpy:2314
translate ingles continuacion2_35ed8d2d:

    # "Ahora mismo, están en el jardín y Septem mira el lago por un largo rato."
    "Right now, you're in the garden, and Septem has been staring at the lake for a long time."

# game/rutas/septem.rpy:2315
translate ingles continuacion2_df888c5b:

    # "De repente algo empieza a descender desde arriba..."
    "Suddenly, something begins to descend from above..."

# game/rutas/septem.rpy:2322
translate ingles continuacion2_ad638693:

    # "¡¡Es una araña!!"
    "It's a spider!!"

# game/rutas/septem.rpy:2327
translate ingles mini_continuacion_a20cefa7:

    # "..."
    "..."

# game/rutas/septem.rpy:2329
translate ingles mini_continuacion_78ca46d7:

    # ".................Uh."
    "................. Uh."

# game/rutas/septem.rpy:2332
translate ingles mini_continuacion_d4dd182b:

    # "..........................¿?"
    ".......................... ?"

# game/rutas/septem.rpy:2334
translate ingles mini_continuacion_d7b654c1:

    # "Miras a Septem y lo sientes al intante."
    "You look at Septem and feel it instantly."

# game/rutas/septem.rpy:2335
translate ingles mini_continuacion_29d03db5:

    # "Hay algo que le molesta, algo que le ha estado molestando desde que te dio las manos y el ojo."
    "Something's bothering him... something that's been gnawing at him ever since he gave you the hands and the eye."

# game/rutas/septem.rpy:2336
translate ingles mini_continuacion_f1b830d7:

    # "Y esa molestia no ha parado de crecer."
    "And that discomfort has only grown."

# game/rutas/septem.rpy:2337
translate ingles mini_continuacion_5245bbec:

    # "Pero esa molestia no es tu presencia ni compañía constante."
    "But it isn't about your constant presence."

# game/rutas/septem.rpy:2338
translate ingles mini_continuacion_b36e2ea9:

    # "Es algo más."
    "It's something else."

# game/rutas/septem.rpy:2344
translate ingles mini_continuacion_e1de277f:

    # septem "Sí..."
    septem "Yes..."

# game/rutas/septem.rpy:2346
translate ingles mini_continuacion_2e96ec14:

    # "Septem suspira y te busca con la mirada."
    "Septem sighs and looks for you with his eyes."

# game/rutas/septem.rpy:2350
translate ingles mini_continuacion_5a7ce82f:

    # septem "Creo que me equivoqué."
    septem "I think I made a mistake."


# game/rutas/septem.rpy:2351
translate ingles mini_continuacion_3ce14a5e:

    # septem "Ahora que te tengo conmigo, entiendo un poco a tu marioneta..."
    septem "Now that I have you with me, I understand your puppet a little better..."

# game/rutas/septem.rpy:2354
translate ingles mini_continuacion_066d4cb7:

    # septem "Pero al mismo tiempo me gustaría que estuvieras fuera de mí, para que tengas tu propio rol."
    septem "But at the same time, I'd like you to exist outside of me, so you could have your own role."

# game/rutas/septem.rpy:2355
translate ingles mini_continuacion_bd9a6a16:

    # septem "Un poco más de libertad... inmersión."
    septem "A bit more freedom... immersion."

# game/rutas/septem.rpy:2358
translate ingles mini_continuacion_fa0a5d45:

    # septem "Conmigo estás sujeto a mí en todo momento, no tienes un cuerpo propio que te represente."
    septem "With me, you're bound to me at all times. You don't have a body of your own to represent you."

# game/rutas/septem.rpy:2359
translate ingles mini_continuacion_6b7e9550:

    # septem "Al menos con tu marioneta era más fácil hacer esta inmersión... ya que ese era su propósito. Sin contexto, sin historia detrás de ella."
    septem "At least with your puppet, it was easier to achieve that immersion... that was its purpose. No context, no story behind it."

# game/rutas/septem.rpy:2360
translate ingles mini_continuacion_8992811f:

    # septem "Algo vacío, listo para ser tomado por ti."
    septem "Something hollow, ready to be inhabited by you."

# game/rutas/septem.rpy:2363
translate ingles mini_continuacion_89dafcb0:

    # septem "Pero que al mismo tiempo tenía claras fijaciones y deseos."
    septem "But at the same time, it had clear fixations and desires."

# game/rutas/septem.rpy:2364
translate ingles mini_continuacion_b5776025:

    # septem "Con ideas claras y sentimientos ajenos a los tuyos."
    septem "With clear ideas and emotions that weren't your own."

# game/rutas/septem.rpy:2365
translate ingles mini_continuacion_76a4c465:

    # septem "Nada objetiva."
    septem "Nothing objective."

# game/rutas/septem.rpy:2368
translate ingles mini_continuacion_d06ee44e:

    # "Septem divaga en si soltar y comunicarte lo que realmente le molesta o no."
    "Septem hesitates, unsure whether to tell you what's really bothering him."

# game/rutas/septem.rpy:2371
translate ingles mini_continuacion_b3b93795:

    # septem "Y algo de Nulla..."
    septem "And something about Nulla..."

# game/rutas/septem.rpy:2374
translate ingles mini_continuacion_521257d3:

    # "Avergonzado por su incapacidad de poder elegir bien sus palabras, intenta filtrar su preocupación."
    "Ashamed of his inability to choose his words well, he tries to filter his concern."

# game/rutas/septem.rpy:2375
translate ingles mini_continuacion_935da9ef:

    # septem "Incluso con un nombre que le has puesto tú, que puede ser el tuyo o uno inventado."
    septem "Even with a name you gave it... one that might be yours, or maybe one you made up."

# game/rutas/septem.rpy:2376
translate ingles mini_continuacion_a20cefa7_1:

    # "..."
    "..."

# game/rutas/septem.rpy:2377
translate ingles mini_continuacion_79eecbf9:

    # septem "¿Es '[nombrejugador]' un nombre que usas para llamarte a ti mismo? ¿o es el nombre que le has dado a la marioneta y no tiene nada que ver contigo?"
    septem "Is '[nombrejugador]' the name you use for yourself? Or is it just the name you gave the puppet, with nothing to do with you?"

# game/rutas/septem.rpy:2378
translate ingles mini_continuacion_33e8e2c1:

    # "¿Acaso quiere conocer tu nombre real?"
    "Does he want to know your real name?"

# game/rutas/septem.rpy:2379
translate ingles mini_continuacion_9ed134ce:

    # "Oh..."
    "Oh..."

# game/rutas/septem.rpy:2385
translate ingles mini_continuacion_8f0cd3f1:

    # septem "Bien."
    septem "Good."

# game/rutas/septem.rpy:2386
translate ingles mini_continuacion_73756e9b:

    # septem "Me gustaría llamarte como se debe."
    septem "I'd like to call you properly."

# game/rutas/septem.rpy:2387
translate ingles mini_continuacion_ce74a33b:

    # septem "Los nombres aquí son importantes..."
    septem "Names are important here..."

# game/rutas/septem.rpy:2388
translate ingles mini_continuacion_86b8141c:

    # septem "Y el tuyo no es la excepción"
    septem "... And yours is no exception."

# game/rutas/septem.rpy:2393
translate ingles mini_continuacion_78689e41:

    # septem "Ah."
    septem "Ah."

# game/rutas/septem.rpy:2396
translate ingles mini_continuacion_7965532b:

    # septem "Te pido formalmente disculpas, por no dirigirme a ti como corresponde."
    septem "I formally apologize for not addressing you as I should have."

# game/rutas/septem.rpy:2397
translate ingles mini_continuacion_d0150f92:

    # septem "Si no es mucho pedir... ¿puedo saber tu nombre?"
    septem "If it's not too much to ask... may I know your name?"

# game/rutas/septem.rpy:2403
translate ingles mini_continuacion_9dcde856:

    # septem "Está bien."
    septem "Alright."

# game/rutas/septem.rpy:2410
translate ingles mini_continuacion_a8175af3:

    # septem "Un gusto poder conocerte."
    septem "It's a pleasure to meet you."

# game/rutas/septem.rpy:2416
translate ingles mini_continuacion_1f5c5cbb:

    # septem "[nombrejugador]..."
    septem "[nombrejugador]..."

# game/rutas/septem.rpy:2417
translate ingles mini_continuacion_6e0f7f0f:

    # "Prueba el nombre en sus labios, y sonríe victorioso."
    "He tests the name on his lips and smiles victoriously."

# game/rutas/septem.rpy:2419
translate ingles mini_continuacion_924dfc50:

    # septem "Okay. Seguiré llamándote [nombrejugador]."
    septem "Okay. I'll keep calling you [nombrejugador]."

# game/rutas/septem.rpy:2424
translate ingles mini_continuacion_ed0479af:

    # septem "[nombrejugador], creo que deberíamos tomar esto como un nuevo inicio."
    septem "[nombrejugador], I think we should take this as a new beginning."

# game/rutas/septem.rpy:2425
translate ingles mini_continuacion_10e5d3c6:

    # septem "Te quiero como compañero, creo que ya ha pasado el tiempo suficiente para decidir si eres apto o no para el cargo."
    septem "I want you as my companion. I think enough time has passed to decide whether you're fit for the role or not."

# game/rutas/septem.rpy:2426
translate ingles mini_continuacion_a20cefa7_2:

    # "..."
    "..."

# game/rutas/septem.rpy:2429
translate ingles mini_continuacion_d8b73a19:

    # septem "Te has quedado hasta aquí, después de todo."
    septem "You've stayed this long, after all."

# game/rutas/septem.rpy:2430
translate ingles mini_continuacion_abfbad28:

    # septem "Estuve pensando y, creo que cuando estabas conectado a la marioneta, te he dado la peor impresión posible."
    septem "I've been thinking, and I believe when you were connected to the puppet, I gave you the worst impression possible."

# game/rutas/septem.rpy:2431
translate ingles mini_continuacion_e1d4511d:

    # septem "Pido disculpas si te he ofendido, pero..."
    septem "I apologize if I offended you, but..."

# game/rutas/septem.rpy:2434
translate ingles mini_continuacion_1a9e832d:

    # septem "Para mí, la marioneta no fue nada mío. No es un súbdito ni una entidad del Jardín a quien yo deba proteger."
    septem "To me, the puppet was never mine. It's not a subject, nor an entity of the Garden I'm meant to protect."

# game/rutas/septem.rpy:2435
translate ingles mini_continuacion_c529cc23:

    # septem "La marioneta era una conexión tuya y de Nulla."
    septem "The puppet was a link between you and Nulla."

# game/rutas/septem.rpy:2438
translate ingles mini_continuacion_fc6208c9:

    # septem "Nunca fue de mi agrado, y verla ahí con esa cara y ese olor a humano..."
    septem "It was never to my liking, and seeing it there, with that face and that human scent..."

# game/rutas/septem.rpy:2439
translate ingles mini_continuacion_b59b97eb:

    # septem "Se me hizo difícil ceder a la tentación."
    septem "... It was difficult to resist the temptation to break it."

# game/rutas/septem.rpy:2442
translate ingles mini_continuacion_cc6053af:

    # "Sientes como Septem se retuerce un poco al recordar el olor y color de la sangre."
    "You feel Septem flinch slightly as he recalls the scent and color of blood."

# game/rutas/septem.rpy:2443
translate ingles mini_continuacion_9ab7e097:

    # "Septem suspira, conteniéndose para no hablar de más, antes de esbozar una sonrisa ladeada."
    "Septem exhales, holding himself back from saying too much, before curling his lips into a sideways smile."

# game/rutas/septem.rpy:2446
translate ingles mini_continuacion_03c2716e:

    # septem "Pero ahora esa cosa ya no está."
    septem "But now that thing is gone."

# game/rutas/septem.rpy:2447
translate ingles mini_continuacion_6b3801f1:

    # septem "Ahora solo somos tú y yo."
    septem "Now it's just you and me."

# game/rutas/septem.rpy:2450
translate ingles mini_continuacion_ba205b03:

    # septem "Y haré todo lo posible para darte un cuerpo completo."
    septem "And I'll do everything I can to give you a complete body."

# game/rutas/septem.rpy:2451
translate ingles mini_continuacion_5a06cbcd:

    # septem "No solo manos y un ojo."
    septem "Not just hands and an eye."

# game/rutas/septem.rpy:2454
translate ingles mini_continuacion_a52a2ca4:

    # "Septem mira tus manos por un segundo, y aprieta la mandíbula."
    "Septem glances at your hands for a moment and clenches his jaw."

# game/rutas/septem.rpy:2455
translate ingles mini_continuacion_c51d7991:

    # " . . . "
    " . . . "

# game/rutas/septem.rpy:2458
translate ingles mini_continuacion_2f207ec2:

    # septem "Quiero mostrarte algo..."
    septem "I want to show you something..."

# game/rutas/septem.rpy:2459
translate ingles mini_continuacion_5b991acf:

    # septem "Pero necesito que te lo tomes seriamente."
    septem "... But I need you to take it seriously."

# game/rutas/septem.rpy:2460
translate ingles mini_continuacion_7669206c:

    # septem "El lugar no es un juego."
    septem "The place is not a game."


# game/rutas/septem.rpy:2473
translate ingles continuacion3_a20cefa7:

    # "..."
    "..."

# game/rutas/septem.rpy:2474
translate ingles continuacion3_280ea181:

    # "Los días pasan y Septem va recuperando la energía que gastó en crear su cuerpo divino, dejándole más carga energética para mantener el cuerpo de Rafael y poder hacer otras cosas."
    "Days pass, and Septem slowly regains the energy he spent creating his divine body, leaving him with more power to sustain Rafael's body and to do other things."

# game/rutas/septem.rpy:2476
translate ingles continuacion3_bfd319f1:

    # "Con esto, Septem comienza a estudiar y recrear invocaciones, practicando diversas partes del cuerpo humano."
    "With that, Septem begins to study and recreate invocations, practicing on various parts of the human body."

# game/rutas/septem.rpy:2477
translate ingles continuacion3_2f4f7c12:

    # "La mayoría son corazones..."
    "Most of them are hearts..."

# game/rutas/septem.rpy:2478
translate ingles continuacion3_cac56391:

    # "También, tiene reuniones con Sextam, pero él nunca abandona su dominio."
    "He also has meetings with Sextam, though he never leaves his domain."

# game/rutas/septem.rpy:2479
translate ingles continuacion3_d3776039:

    # "En estas reuniones aprendes algunos datos que desconocías."
    "During these meetings, you learn a few things you didn't know before."

# game/rutas/septem.rpy:2480
translate ingles continuacion3_30f505b0:

    # "Por ejemplo: Al Jardín no le sirve cualquier humano. Tienen que ser creados por Sextam, de no ser así, no sobreviven por mucho tiempo en el Jardín."
    "For example: Not just any human can live in the Garden. They must be created by Sextam. Otherwise, they won't survive long there."

# game/rutas/septem.rpy:2481
translate ingles continuacion3_2211bf92:

    # "Mueren al pasar 7 días..."
    "They die after seven days..."

# game/rutas/septem.rpy:2483
translate ingles continuacion3_8488c8e8:

    # septem "Cuando pueda quitarte el sello, podrás volver a tu dominio y crear a nuestros humanos."
    septem "When I can remove your seal, you'll be able to return to your domain and create our humans again."

# game/rutas/septem.rpy:2485
translate ingles continuacion3_78b415a2:

    # "¿Crees que sea tan fácil?"
    "Does he really think it'll be that easy?"

# game/rutas/septem.rpy:2488
translate ingles continuacion3_005d95b5:

    # septem "Puedo ver el sello que tienes en el interior."
    septem "I can see the seal you have within."

# game/rutas/septem.rpy:2489
translate ingles continuacion3_5d6ce289:

    # septem "Una vez sepa como romperlo, será fácil para ti volver a crearlos."
    septem "Once I learn how to break it, it'll be easy for you to create them again."

# game/rutas/septem.rpy:2492
translate ingles continuacion3_7af729a4:

    # septem "Tendrás que empezar de a poco, con nodrizas..."
    septem "You'll have to start slowly, with wet nurses..."

# game/rutas/septem.rpy:2493
translate ingles continuacion3_f5c547f1:

    # septem "Pero luego volverán a tener su ciclo de vida normal."
    septem "But soon, they'll regain their normal life cycle."

# game/rutas/septem.rpy:2494
translate ingles continuacion3_41838529:

    # septem "Obtendrás nacimientos naturales luego de 5 a 10 años."
    septem "You'll get natural births again after five to ten years."

# game/rutas/septem.rpy:2495
translate ingles continuacion3_22789244:

    # septem "Será como antes."
    septem "It'll be like before."

# game/rutas/septem.rpy:2498
translate ingles continuacion3_3279708e:

    # sextam "..."
    sextam "..."

# game/rutas/septem.rpy:2501
translate ingles continuacion3_becd3b45:

    # sextam "¿Crees que Padre vuelva si se entera?"
    sextam "Do you think Father will return if he finds out?"

# game/rutas/septem.rpy:2506
translate ingles continuacion3_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:2509
translate ingles continuacion3_d8531f73:

    # sextam "¿Qué tal si nos castiga nuevamente?"
    sextam "What if he punishes us again?"

# game/rutas/septem.rpy:2514
translate ingles continuacion3_f4ebbb19:

    # septem "No pasará, Sextam."
    septem "That won't happen, Sextam."

# game/rutas/septem.rpy:2517
translate ingles continuacion3_7c491635:

    # sextam "¿Qué tal si los demás se enteran que fue por nuestra culpa?"
    sextam "What if the others find out it was our fault?"

# game/rutas/septem.rpy:2518
translate ingles continuacion3_33ef86e9:

    # septem "No fue nuestra culpa, fue la de Nulla."
    septem "It wasn't our fault, it was Nulla's."

# game/rutas/septem.rpy:2519
translate ingles continuacion3_9a05af8f:

    # sextam "Yo también tengo culpa. No solo Nulla."
    sextam "I share the blame too. Not just Nulla."

# game/rutas/septem.rpy:2524
translate ingles continuacion3_48016af9:

    # septem "Sextam..."
    septem "Sextam..."

# game/rutas/septem.rpy:2525
translate ingles continuacion3_2d48fa10:

    # "Sextam no para, a pesar de que Septem le mira ya irritado."
    "Sextam doesn't stop, even though Septem is already looking at her irritably."

# game/rutas/septem.rpy:2528
translate ingles continuacion3_c942fc0c:

    # sextam "¿Vamos a tener que inventar otra excusa como el nacimiento falso de tu hijo? ¿Para cubrir el robo del cuerpo?"
    sextam "Are we going to have to make up another excuse like your fake child's birth? To cover up the theft of the body?"

# game/rutas/septem.rpy:2529
translate ingles continuacion3_74df2b82:

    # sextam "Porque hasta donde saben ellos, Padre se ha ido porque se aburrió y no por la culpa de haber traído un cuerpo de otro mundo para que lo uses de marioneta."
    sextam "Because as far as they know, Father left out of boredom, not because you brought a body from another world to use as a puppet."

# game/rutas/septem.rpy:2532
translate ingles continuacion3_48016af9_1:

    # septem "Sextam..."
    septem "Sextam..."

# game/rutas/septem.rpy:2535
translate ingles continuacion3_601c4f17:

    # sextam "No Septem, escúchame."
    sextam "No, Septem, listen to me."

# game/rutas/septem.rpy:2536
translate ingles continuacion3_95f772f1:

    # sextam "Estamos exponiéndonos a destapar todo, Nulla podría abrir la boca y sellar tu destino, o Padre podría llegar a imponer más castigos."
    sextam "We're exposing ourselves. Nulla could open his mouth and seal your fate, or Father might return to impose even harsher punishments."

# game/rutas/septem.rpy:2537
translate ingles continuacion3_5c1a6a02:

    # sextam "Prométeme que si hacemos esto, no habrá consecuencias peores."
    sextam "Promise me that if we go through with this, there won't be worse consequences."

# game/rutas/septem.rpy:2538
translate ingles continuacion3_b2e668aa:

    # sextam "Si el consejo se llegase a enterar, date por seguro que irán por tu cabeza."
    sextam "If the council ever finds out, you can be sure they'll come for your head."

# game/rutas/septem.rpy:2539
translate ingles continuacion3_6b2d8553:

    # sextam "Si Padre viene, créeme que no será para darte un abrazo."
    sextam "And if Father comes back, believe me--it won't be to give you a hug."

# game/rutas/septem.rpy:2542
translate ingles continuacion3_d4db4f43:

    # "Sextam te mira por un momento antes de proseguir."
    "Sextam pauses to look at you before continuing."

# game/rutas/septem.rpy:2545
translate ingles continuacion3_e5b5aa2e:

    # sextam "Septem, te juro que si esto no funciona---"
    sextam "Septem, I swear, if this doesn't work..."

# game/rutas/septem.rpy:2546
translate ingles continuacion3_dba4d2a3:

    # sextam "Creo que lo mejor sería hacerle caso a Nulla."
    sextam "... I think it'd be best to listen to Nulla."

# game/rutas/septem.rpy:2547
translate ingles continuacion3_a31fcad6:

    # "Septem masculla una corta risa, incrédulo por las palabras de su compañera."
    "Septem lets out a short laugh, disbelieving her words."

# game/rutas/septem.rpy:2552
translate ingles continuacion3_47d9cde8:

    # septem "Estás loca."
    septem "You're insane."

# game/rutas/septem.rpy:2555
translate ingles continuacion3_68a36fc1:

    # sextam "No Septem, si esto sale mal, lo mejor sería acabar con todo, en vez de ver como todo el Jardín se va en tu contra."
    sextam "No, Septem. If this goes wrong, it'd be better to end everything than to watch the entire Garden turn against you."

# game/rutas/septem.rpy:2560
translate ingles continuacion3_8734c24e:

    # sextam "Y como nadie puede lastimarte, encontrarán la manera de hacerte pagar."
    sextam "And since no one can hurt you, they'll find another way to make you pay."

# game/rutas/septem.rpy:2561
translate ingles continuacion3_faf28b48:

    # sextam "...Realmente odiaría que pasaras eso."
    sextam "... I'd really hate for you to go through that."

# game/rutas/septem.rpy:2564
translate ingles continuacion3_d7d6117c:

    # "Sextam solloza."
    "Sextam sobs."

# game/rutas/septem.rpy:2565
translate ingles continuacion3_2086d100:

    # "La conversación poco a poco se va diluyendo hasta llegar a un punto que han conversado de todo lo necesario."
    "The conversation slowly fades, reaching a point where everything that needed to be said has been said."

# game/rutas/septem.rpy:2566
translate ingles continuacion3_217c32cc:

    # "Toda formalidad ya pactada."
    "All formalities were settled."

# game/rutas/septem.rpy:2567
translate ingles continuacion3_520fcdae:

    # "Pero Septem necesita hablar algo más."
    "But Septem still needs to speak of one more thing."

# game/rutas/septem.rpy:2568
translate ingles continuacion3_c8fa42d6:

    # "Algo que ni siquiera a ti te ha dejado ver, mucho menos confesarte."
    "Something he hasn't even let you see, let alone confess to you."

# game/rutas/septem.rpy:2569
translate ingles continuacion3_d6060363:

    # "Ya qué probablemente no lo entenderías tanto como Sextam."
    "Because you probably wouldn't understand it as well as Sextam."

# game/rutas/septem.rpy:2571
translate ingles continuacion3_33109443:

    # septem "Una cosa más."
    septem "One more thing."

# game/rutas/septem.rpy:2572
translate ingles continuacion3_89aa7e25:

    # "Sextam solo lo observa. Muy atenta, pero no dice nada."
    "Sextam only watches him--very attentive, but silent."

# game/rutas/septem.rpy:2573
translate ingles continuacion3_1289dff0:

    # septem "Creo que necesitas saber esto."
    septem "I think you need to know this."

# game/rutas/septem.rpy:2574
translate ingles continuacion3_0ce2b3eb:

    # septem "El rango que tengo ahora me permite dañar..."
    septem "The rank I have now allows me to cause harm..."

# game/rutas/septem.rpy:2578
translate ingles continuacion3_d0c04682:

    # "Ella abre la boca para decir algo, y él la espera... pero Sextam no puede encontrar su voz y opta por guardar silencio, evitando la dura mirada de Septem."
    "Sextam opens her mouth to say something, and Septem waits... but she can't find her voice and chooses silence, avoiding his hard gaze."

# game/rutas/septem.rpy:2581
translate ingles continuacion3_ecbadece:

    # septem "Es importante que lo sepas, y necesito que si llegase a pasar algo, me detengas."
    septem "It's important that you know this--and if anything ever happens, I need you to stop me."

# game/rutas/septem.rpy:2586
translate ingles continuacion3_be8d63ab:

    # "Sextam aprieta los labios, tomando valor para contestar a su petición."
    "Sextam presses her lips together, gathering the courage to answer his request."

# game/rutas/septem.rpy:2587
translate ingles continuacion3_9a064826:

    # sextam "Sabes que no puedo hacer nada---"
    sextam "You know there's nothing I can do--"

# game/rutas/septem.rpy:2588
translate ingles continuacion3_2cfb17e4:

    # sextam "Creo que sería mejor que le hicieras esa petición a la entidad que está contigo."
    sextam "I think it'd be better if you made that request to the entity that's with you."


# game/rutas/septem.rpy:2589
translate ingles continuacion3_b71b30a3:

    # "Se hace un silencio."
    "A silence falls."

# game/rutas/septem.rpy:2590
translate ingles continuacion3_aeff14c4:

    # "Pero Septem comprende."
    "But Septem understands."

# game/rutas/septem.rpy:2593
translate ingles continuacion3_121511bc:

    # sextam "Debo irme."
    sextam "I must go."

# game/rutas/septem.rpy:2594
translate ingles continuacion3_7dba5a5f:

    # sextam "Estaré atenta a tus noticias."
    sextam "I'll be waiting for your news."

# game/rutas/septem.rpy:2596
translate ingles continuacion3_36b19c5c:

    # "Sin más Sextam desaparece por la puerta."
    "Without another word, Sextam vanishes through the door."

# game/rutas/septem.rpy:2597
translate ingles continuacion3_db2d968b:

    # "Y así, tú y Septem quedan solos."
    "And just like that, you and Septem are left alone."

# game/rutas/septem.rpy:2598
translate ingles continuacion3_9511e7fc:

    # "Intentas hablar con Septem pero él te pide un momento a solas."
    "You try to speak to Septem, but he asks for a moment alone."

# game/rutas/septem.rpy:2599
translate ingles continuacion3_f23d0bb3:

    # "Así que te retiras de la biblioteca."
    "So you withdraw from the library."

# game/rutas/septem.rpy:2604
translate ingles continuacion3_7f017520:

    # " . . . . . . . . . . . "
    " . . . . . . . . . . . "

# game/rutas/septem.rpy:2607
translate ingles continuacion3_41d761bf:

    # "Algunos días te aburres, ya que Septem no hace nada más que leer y buscar como romper sellos."
    "Some days, you get bored, since Septem does nothing but read and search for ways to break seals."

# game/rutas/septem.rpy:2608
translate ingles continuacion3_8f128d13:

    # "A veces te lee en voz alta, pero la mayoría del tiempo te pide silencio e insiste en que observes su progreso."
    "Sometimes he reads aloud to you, but most of the time he asks for silence, insisting you observe his progress."

# game/rutas/septem.rpy:2610
translate ingles continuacion3_7f0246b3:

    # "Ver como falla es algo de lo que no te cansas de ver."
    "Watching him fail is something you never tire of."

# game/rutas/septem.rpy:2611
translate ingles continuacion3_26465e9d:

    # "Cada vez que falla en hacer un sello o romperlo, Septem aprieta mucho la mandíbula, al punto de hacer rechinar sus dientes."
    "Each time he fails to make or break a seal, Septem clenches his jaw so tightly that his teeth grind audibly."

# game/rutas/septem.rpy:2612
translate ingles continuacion3_aca76f8c:

    # "...y de vez en cuando golpea la mesa, sin mirar en tu dirección."
    "... And from time to time, he slams down on the table, never looking your way."

# game/rutas/septem.rpy:2613
translate ingles continuacion3_4dabf2e7:

    # "Pero lo vuelve a intentar."
    "But he keeps trying."

# game/rutas/septem.rpy:2614
translate ingles continuacion3_98b3cc35:

    # "Incluso cuando tiene éxito, si nota alguna imperfección en el resultado, lo rompe y lo intenta con más esmero."
    "Even when he succeeds, if he notices the slightest imperfection, he destroys it and tries again with greater effort."

# game/rutas/septem.rpy:2615
translate ingles continuacion3_a20cefa7_1:

    # "..."
    "..."

# game/rutas/septem.rpy:2617
translate ingles continuacion3_0d3c8d09:

    # "Al paso de una hora, Septem celebra cuando ve que el sello que lleva intentando romper, desaparece como si de humo se tratara."
    "After about an hour, Septem finally celebrates as the seal he's been struggling to break dissolves into smoke."

# game/rutas/septem.rpy:2618
translate ingles continuacion3_ca2a752a:

    # septem "Lo hemos hecho, [nombrejugador]."
    septem "We did it, [nombrejugador]."

# game/rutas/septem.rpy:2622
translate ingles continuacion3_26497c1e:

    # "Septem sonríe sin mostrar los dientes, sintiendo un pequeño cosquilleo en su estómago al obtener tu respuesta."
    "Septem smiles faintly, feeling a small flutter in his stomach at your response."

# game/rutas/septem.rpy:2623
translate ingles continuacion3_8814da02:

    # "Para que al instante se sienta extrañado por su propia reacción."
    "Then immediately, he feels puzzled by his own reaction."

# game/rutas/septem.rpy:2624
translate ingles continuacion3_34d40bbf:

    # "No se había sentido de esta manera desde que..."
    "He hasn't felt this way since..."

# game/rutas/septem.rpy:2625
translate ingles continuacion3_25a173a7:

    # "Padre de dio una retroalimentación después de crear a los Estandarte."
    "... Father gave him feedback after creating the Symbols."

# game/rutas/septem.rpy:2626
translate ingles continuacion3_a20cefa7_2:

    # "..."
    "..."

# game/rutas/septem.rpy:2630
translate ingles continuacion3_2818181e:

    # "Nuevamente esa sensación extraña en lo bajo de su estómago."
    "That strange sensation in the pit of his stomach returns."

# game/rutas/septem.rpy:2631
translate ingles continuacion3_ade7943c:

    # septem "Espero que no lo estés diciendo como una burla..."
    septem "I hope you're not saying that mockingly..."

# game/rutas/septem.rpy:2636
translate ingles continuacion3_8d41c83c:

    # "Septem vuelve su mirada a la mesa."
    "Septem turns his gaze back to the table."

# game/rutas/septem.rpy:2637
translate ingles continuacion3_36612f39:

    # "Y luego de meditar por un momento, suspira."
    "After a brief moment of thought, he sighs."

# game/rutas/septem.rpy:2640
translate ingles continuacion3_214eefac:

    # septem "Claro."
    septem "Of course."

# game/rutas/septem.rpy:2641
translate ingles continuacion3_d612d7a1:

    # septem "Tú eres parte vital en este proceso."
    septem "You're a vital part of this process."

# game/rutas/septem.rpy:2642
translate ingles continuacion3_5f015201:

    # septem "Esto es un logro de ambos."
    septem "This is an achievement for both of us."

# game/rutas/septem.rpy:2643
translate ingles continuacion3_726873ca:

    # "Septem asiente, y te mira con firmeza."
    "Septem nods and looks at you with conviction."

# game/rutas/septem.rpy:2644
translate ingles continuacion3_9ea149b7:

    # septem "Lo hemos hecho juntos."
    septem "We've done this together."

# game/rutas/septem.rpy:2648
translate ingles continuacion3_34102d55:

    # "Septem desvía la mirada, no sabiendo que hacer con sus ojos."
    "Septem looks away, unsure of what to do with his eyes."

# game/rutas/septem.rpy:2649
translate ingles continuacion3_2f122888:

    # "Mirarte ahora mismo, no es opción."
    "Looking at you right now isn't an option."

# game/rutas/septem.rpy:2650
translate ingles continuacion3_69dbe6d6:

    # septem "Tú igual lo has hecho bien."
    septem "You did well, too."

# game/rutas/septem.rpy:2651
translate ingles continuacion3_6f9968ba:

    # septem "Podrías estar haciendo cosas más productivas ahora mismo."
    septem "You could be doing far more productive things right now."

# game/rutas/septem.rpy:2652
translate ingles continuacion3_8a7f0fe5:

    # septem "...Sin embargo estás aquí, conmigo."
    septem "... Yet, you're here, with me."

# game/rutas/septem.rpy:2653
translate ingles continuacion3_e7001f86:

    # septem "Realmente lo aprecio."
    septem "I truly appreciate that."

# game/rutas/septem.rpy:2659
translate ingles continuacion3_e817eede:

    # septem "Podemos comenzar con la restauración."
    septem "We can begin the restoration."

# game/rutas/septem.rpy:2660
translate ingles continuacion3_163e334c:

    # "Te comenta sin creerlo. Sin aliento."
    "He says it almost in disbelief; Breathless."

# game/rutas/septem.rpy:2661
translate ingles continuacion3_8f0cd3f1:

    # septem "Bien."
    septem "Good."

# game/rutas/septem.rpy:2664
translate ingles continuacion3_b4ca184f:

    # "Toma un poco de aire antes de revelarte lo que está pensando."
    "He inhales slowly before revealing what he's been thinking."

# game/rutas/septem.rpy:2667
translate ingles continuacion3_c2bf436a:

    # septem "[nombrejugador], tenemos reunión esta noche con el consejo y los Estandartes."
    septem "[nombrejugador], we have a meeting tonight with the council and the Symbols."

# game/rutas/septem.rpy:2672
translate ingles continuacion3_62cdbffd:

    # septem "Son los encargados de apoyar a sus respectivos Estandartes para la toma de decisiones."
    septem "The council are the ones who assist their respective Symbols in decision-making."

# game/rutas/septem.rpy:2673
translate ingles continuacion3_621e122d:

    # septem "Aunque solo invitaré a las cabecillas de cada dominio."
    septem "Though I'll only invite the heads of each domain."

# game/rutas/septem.rpy:2676
translate ingles continuacion3_78c51781:

    # septem "Comenzaremos a ejecutar el plan."
    septem "We'll begin executing the plan."

# game/rutas/septem.rpy:2679
translate ingles continuacion3_f194ee01:

    # septem "Pero antes debo informar esto."
    septem "But first, I have to report this."

# game/rutas/septem.rpy:2680
translate ingles continuacion3_dc76327d:

    # septem "Para que todos comiencen a mantener sus dominios en las condiciones óptimas para recibir humanos."
    septem "So that everyone starts keeping their domains in optimal condition to receive humans."

# game/rutas/septem.rpy:2681
translate ingles continuacion3_d6d14e28:

    # septem "Una vez que Sextam pueda hacerlos."
    septem "Once Sextam can make them."

# game/rutas/septem.rpy:2684
translate ingles continuacion3_d4f4858d:

    # septem "Tu mera presencia ya es ayuda más que suficiente, [nombrejugador]."
    septem "Your mere presence is already more than enough help, [nombrejugador]."

# game/rutas/septem.rpy:2689
translate ingles continuacion3_0cd382e8:

    # "Septem te mira fijamente y se debate entre hablar más o no."
    "Septem stares at you, debating whether to keep talking or stay silent."

# game/rutas/septem.rpy:2692
translate ingles continuacion3_f4d3b85a:

    # septem "Tengo algo que darte luego de la reunión."
    septem "I have something to give you after the meeting."


# game/rutas/septem.rpy:2693
translate ingles continuacion3_2dbb01af:

    # septem "Creo que te lo mereces."
    septem "I think you deserve it."

# game/rutas/septem.rpy:2694
translate ingles continuacion3_9d1fd9f1:

    # "Te confiesa de manera muy seria, como si de un secreto fuera. Aunque dentro de él puedes sentir una pizca de emoción."
    "He confesses it very seriously, as if it were a secret. Yet deep within, you can sense a flicker of excitement."

# game/rutas/septem.rpy:2702
translate ingles continuacion3_efdeea19:

    # septem "¿Hablas de un premio?"
    septem "Are you talking about a reward?"

# game/rutas/septem.rpy:2703
translate ingles continuacion3_af91a1f4:

    # septem "ja ja ja..."
    septem "Ha ha ha..."

# game/rutas/septem.rpy:2704
translate ingles continuacion3_dcffc52f:

    # septem "¿Crees que mereces un premio?"
    septem "Do you really think you deserve one?"

# game/rutas/septem.rpy:2710
translate ingles continuacion3_31924e0f_1:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:2714
translate ingles continuacion3_f5ebc198:

    # septem "¿No vas a preguntar?"
    septem "Aren't you going to ask?"

# game/rutas/septem.rpy:2715
translate ingles continuacion3_58cbc092:

    # septem "No creí que fueras tan tímido."
    septem "I didn't think you were so shy."

# game/rutas/septem.rpy:2716
translate ingles continuacion3_f2b9af23:

    # septem "Adorable."
    septem "Adorable."

# game/rutas/septem.rpy:2719
translate ingles continuacion3_cad9171d:

    # septem "Mmmm~"
    septem "Mmmm~"

# game/rutas/septem.rpy:2720
translate ingles continuacion3_180383e2:

    # septem "Sí"
    septem "Yes."

# game/rutas/septem.rpy:2721
translate ingles continuacion3_c1796765:

    # "Dice finalmente, agarrando tu mano izquierda, y mientras la acaricia sus uñas rozan tu piel, peligrando con clavarse en ella."
    "He finally says, taking your left hand. As he strokes it, his nails brush against your skin, dangerously close to sinking in."

# game/rutas/septem.rpy:2722
translate ingles continuacion3_23bf3a80:

    # septem "Mereces un premio."
    septem "You deserve a reward."

# game/rutas/septem.rpy:2723
translate ingles continuacion3_6a411fac:

    # septem "Has hecho todo lo que te he pedido hasta ahora."
    septem "You've done everything I've asked of you so far."

# game/rutas/septem.rpy:2725
translate ingles continuacion3_2ff81914:

    # "Su cuerpo se acerca a tu campo de visión, bloqueando todo lo que no sea él."
    "His body leans into your field of view, blocking everything but him."

# game/rutas/septem.rpy:2726
translate ingles continuacion3_d1fc9494:

    # septem "Creo que darte un cuerpo sería un buen premio, ¿No crees?"
    septem "I think giving you a body would be a good reward, don't you think?"

# game/rutas/septem.rpy:2727
translate ingles continuacion3_a20cefa7_3:

    # "..."
    "..."

# game/rutas/septem.rpy:2729
translate ingles continuacion3_263fe5b6:

    # "Septem mata el tiempo en la biblioteca, te lee, esta vez son cuentos infantiles escritos por Sextam..."
    "Septem passes the time in the library reading to you. This time, it's children's stories written by Sextam..."

# game/rutas/septem.rpy:2730
translate ingles continuacion3_d41d4965:

    # "Antes de empezar la lectura, te ha explicado que ella, cuando aún existian humanos en El Jardín, ella se mezclaba entre ellos para inspirarse a escribir."
    "Before beginning, he explains that when humans still existed in the Garden, Sextam used to mingle among them to find inspiration for her writing."

# game/rutas/septem.rpy:2731
translate ingles continuacion3_ca9f86c1:

    # "Y cómo él la observaba desde su dominio. Cuando aún no tenía un cuerpo físico."
    "And how he used to watch her from his domain, back when he still lacked a physical body."

# game/rutas/septem.rpy:2732
translate ingles continuacion3_9fa02c8c:

    # "Se ve muy orgulloso al leer los cuentos, con una leve sonrisa pegada al rostro, que pareciera iluminar todo su rostro. Dándole un aire etereo."
    "He looks proud as he reads, a faint smile lighting his features, giving him an almost ethereal air."

# game/rutas/septem.rpy:2733
translate ingles continuacion3_a1b50350:

    # "Ojos principales pegados a las páginas, mientras que los restantes te roban miradas furtivas de vez en cuando, asegurándose de que aún sigas aquí."
    "His main eyes stay fixed on the pages, while the others steal furtive glances at you now and then--just to make sure you're still there."

# game/rutas/septem.rpy:2734
translate ingles continuacion3_509f4e20:

    # "La voz de Septem al leer en voz alta es dulce... extremadamente dulce y cálida. Tiene una gran capacidad al transmitir el sentimiento de cada cuento por separado, tan al la perfección, como si ya los hubiera leído antes."
    "Septem's voice when reading aloud is sweet... extremely sweet and warm. He conveys the emotion of each story so perfectly, it's as if he's read them all before."

# game/rutas/septem.rpy:2735
translate ingles continuacion3_bb2fc544:

    # "Toma las pausas necesarias y utiliza el tono adecuado para cada personaje, en ningún momento se traba o es tomado desprevenido por los acontecimientos que suceden."
    "He takes the right pauses and uses the perfect tone for each character, never stumbling or sounding surprised by the events unfolding."

# game/rutas/septem.rpy:2736
translate ingles continuacion3_25eb1971:

    # "Mientras más se acerca la hora de la reunión, la cara de Septem comienza a mutar. Ojos principales entrecerrados, denotando que su mente se está yendo y pensando en el futuro cercano."
    "As the hour of the meeting draws near, Septem's face begins to change--his main eyes narrowing, his mind drifting toward what's to come."

# game/rutas/septem.rpy:2737
translate ingles continuacion3_e6b676d1:

    # "Ya debería estar preparándose."
    "He should be getting ready by now."

# game/rutas/septem.rpy:2738
translate ingles continuacion3_820c9f9a:

    # "Pero prefiere terminar, al menos un último cuento."
    "But he prefers to finish... at least one last story."

# game/rutas/septem.rpy:2739
translate ingles continuacion3_b43aa4f7:

    # "Llega un punto en que su voz deja de reproducir las palabras escritas en el libro, y en sus ojos se cierran por completo al sentir como llega el primer par de invitado a su dominio. Su cara muta, ya su expresión etérea se difumina cuando sus labios se tuercen hacia un lado."
    "There comes a point when his voice stops reading the words on the page. His eyes close completely as he senses the first pair of guests entering his domain. His ethereal expression fades, his lips twisting to one side."

# game/rutas/septem.rpy:2741
translate ingles continuacion3_fb3c9cce:

    # "Septem cierra el libro de golpe y chasquea la lengua."
    "Septem snaps the book shut and clicks his tongue."

# game/rutas/septem.rpy:2743
translate ingles continuacion3_8fe2dc42:

    # "Se levanta de la silla y deja el libro de cuentos a un lado de su escritorio, junto a los papeles que usó para romper los sellos."
    "He stands and sets the storybook aside on his desk, next to the papers he used to break the seals."

# game/rutas/septem.rpy:2745
translate ingles continuacion3_cc159c14:

    # septem "Eso fue todo."
    septem "That is all."

# game/rutas/septem.rpy:2746
translate ingles continuacion3_ea4ed5b7:

    # "Tu ojo, y Septem, presienten más entidades dentro del dominio."
    "Both you and Septem can sense more entities within the domain."

# game/rutas/septem.rpy:2747
translate ingles continuacion3_3f24a6af:

    # "Ya es la hora. El consejo junto con los Estandartes ya han llegado y esperan a que Septem haga su aparición para poder comenzar la reunión."
    "It's time. The council and the Symbols have already arrived, waiting for Septem to appear so the meeting can begin."

# game/rutas/septem.rpy:2750
translate ingles continuacion3_01936a1b:

    # septem "Van a preguntar que ha pasado con mi cuerpo tarde o temprano..."
    septem "They're going to ask what happened to my body sooner or later..."

# game/rutas/septem.rpy:2751
translate ingles continuacion3_fe8044d3:

    # "Luego te mira a ti, y su expresión se torna exasperada."
    "Then he looks at you, his expression turning exasperated."

# game/rutas/septem.rpy:2754
translate ingles continuacion3_49063d2e:

    # septem "Van a preguntar por ti y porqué estás así..."
    septem "They'll ask about you and why you're like this..."

# game/rutas/septem.rpy:2755
translate ingles continuacion3_f8d989f9:

    # septem "Cómo los odio..."
    septem "How I hate them..."

# game/rutas/septem.rpy:2757
translate ingles continuacion3_d4dff72b:

    # "Con un último suspiro, Septem se arregla el cabello y con un solo movimiento de sus manos, los teletransporta a la sala de reuniones."
    "With a final sigh, Septem fixes his hair and, with a single gesture, teleports you both to the meeting hall."

# game/rutas/septem.rpy:2760
translate ingles continuacion3_37d6406b:

    # "Un montón de ojos se posan en ustedes."
    "Countless eyes fall upon you both."

# game/rutas/septem.rpy:2761
translate ingles continuacion3_eceb34fe:

    # septem "Buenas noches a todos los presentes."
    septem "Good evening to everyone present."

# game/rutas/septem.rpy:2762
translate ingles continuacion3_8076353b:

    # septem "Agradezco su asistencia"
    septem "I appreciate your attendance."

# game/rutas/septem.rpy:2763
translate ingles continuacion3_68790c17:

    # "Septem da un paso al frente. El silencio en la sala es absoluto y pesado."
    "Septem steps forward. The silence in the room is absolute and heavy."

# game/rutas/septem.rpy:2764
translate ingles continuacion3_17228042:

    # "Todas las entidades que representan al consejo, miran con un disgusto enmascarado de horror a Septem. En cambio los Estandartes, lo contemplan en silencio, esperando a que hable."
    "All the council's entities stare at Septem with a disgust barely hidden behind horror. The Symbols, on the other hand, watch him quietly, waiting for him to speak."

# game/rutas/septem.rpy:2765
translate ingles continuacion3_5900eea6:

    # "Uno del consejo no puede mantener su compostura y habla sin que se le ceda la palabra."
    "One of the council members loses composure and speaks without being given permission."

# game/rutas/septem.rpy:2766
translate ingles continuacion3_c5ca9dc9:

    # el "¿Qué es esa {i}entidad{i} que tienes al lado? Ese no es El Cre-"
    el "What is that {i}entity{/i} beside you? That's not the Cre--"

# game/rutas/septem.rpy:2767
translate ingles continuacion3_c4186d7d:

    # septem "Cierra la boca, no te he dado el permiso de hablar."
    septem "Shut your mouth, I haven't given you permission to speak."

# game/rutas/septem.rpy:2768
translate ingles continuacion3_18dd8cd1:

    # septem "Insolente."
    septem "Insolent."


# game/rutas/septem.rpy:2769
translate ingles continuacion3_fb1090a1:

    # "La entidad hace una mueca de dolor, y Septem suelta una risa seca."
    "The entity grimaces in pain, and Septem lets out a dry laugh."

# game/rutas/septem.rpy:2770
translate ingles continuacion3_48e52b3d:

    # septem "Como pueden ver, he cambiado. Y con ello he decidido compartir este Jardín con quien sí nos ve."
    septem "As you can see, I've changed. And with that change, I've decided to share this Garden with one who truly sees us."

# game/rutas/septem.rpy:2771
translate ingles continuacion3_37cb37b8:

    # septem "Ya no podemos seguir esperando a Padre."
    septem "We can no longer keep waiting for Father."

# game/rutas/septem.rpy:2772
translate ingles continuacion3_de630199:

    # "Algunos miembros del consejo murmuran a sus Estandartes, con preocupación."
    "Some members of the council whisper anxiously to their Symbols."

# game/rutas/septem.rpy:2773
translate ingles continuacion3_a827ffd9:

    # septem "He obtenido un rango absoluto, gracias a nuestro nuevo salvador."
    septem "I have obtained an absolute rank, thanks to our new savior."

# game/rutas/septem.rpy:2774
translate ingles continuacion3_0346537d:

    # septem "Y gracias a ello, ahora puedo destruir y borrar todas las condenas que nos han puesto encima."
    septem "And with it, I now have the power to destroy and erase every curse that was placed upon us."

# game/rutas/septem.rpy:2775
translate ingles continuacion3_74762943:

    # septem "Al que no le parezca correcto el cambio de mando, lo invito cordialmente a dejar su cargo."
    septem "To anyone who disagrees with this change of command, I cordially invite you to step down."

# game/rutas/septem.rpy:2776
translate ingles continuacion3_926d0128:

    # septem "Este Jardín fue olvidado por Padre. Quien nos abandonó."
    septem "This Garden was forgotten by Father, the one who abandoned us."

# game/rutas/septem.rpy:2777
translate ingles continuacion3_e1e18b50:

    # septem "Pero, a partir de hoy, comenzará una nueva era."
    septem "But, starting today, a new era begins."

# game/rutas/septem.rpy:2778
translate ingles continuacion3_49b415e8:

    # septem "Dominios enteros serán reestructurados para impedir una segunda caída."
    septem "Entire domains will be restructured to prevent a second downfall."

# game/rutas/septem.rpy:2779
translate ingles continuacion3_96ab6c93:

    # septem "Ya no responderán a un Creador ausente."
    septem "You will no longer answer to an absent Creator."

# game/rutas/septem.rpy:2780
translate ingles continuacion3_f380d5af:

    # septem "Responderán a {i}[nombrejugador]{/i} y a mí."
    septem "You will answer to {i}[nombrejugador]{/i} and to me."

# game/rutas/septem.rpy:2782
translate ingles continuacion3_d58a78c5:

    # "Septem se desliza hasta su silla y toma asiento con una gracia que se acentua con cada movimiento. Cuando ya es encuentra cómodo, junta ambas manos y observa a su público."
    "Septem glides to his chair and sits down with a grace that grows with every movement. Once settled, he clasps his hands together and studies his audience."

# game/rutas/septem.rpy:2783
translate ingles continuacion3_bcb45e6b:

    # septem "¿Alguien tiene alguna duda?"
    septem "Does anyone have any questions?"

# game/rutas/septem.rpy:2784
translate ingles continuacion3_c7bddbbe:

    # "La misma entidad que se le obligó callar levanta la mano con urgencia."
    "The same entity that was forced to be silent urgently raises their hand."

# game/rutas/septem.rpy:2785
translate ingles continuacion3_ed03b138:

    # septem "Adelante."
    septem "Go ahead."

# game/rutas/septem.rpy:2786
translate ingles continuacion3_5d5bdec9:

    # "Septem le cede la palabras y al instante sus labios se despegan, permitiéndole hablar nuevamente."
    "Septem grants them permission. As soon as their speech is restored, their lips part."

# game/rutas/septem.rpy:2787
translate ingles continuacion3_dd6968db:

    # el "¿Y si nos negamos? ¿Y si este nuevo 'amo' resulta no cumplir con los estándares que tenía el anterior?"
    el "And what if we refuse? What if this new 'master' fails to meet the Symbols of the previous one?"

# game/rutas/septem.rpy:2788
translate ingles continuacion3_37385125:

    # "Mira a los demás, buscando apoyo."
    "They look around, searching for support."

# game/rutas/septem.rpy:2789
translate ingles continuacion3_6fa7ff74:

    # el "¿Realmente vas a cambiar al Creador tan fácilmente? ¿Por un cualquiera?"
    el "Are you really replacing the Creator so easily? For some... nobody?"

# game/rutas/septem.rpy:2790
translate ingles continuacion3_739e99ce:

    # el "Ni siquiera es capaz de manifestar su cuerpo como corresponde, y te usa a ti en su lugar."
    el "They can't even manifest a proper body, and they use you instead."

# game/rutas/septem.rpy:2791
translate ingles continuacion3_e34287cf:

    # el "Por favor, ¿de qué poder estamos hablando--"
    el "Please, what kind of power are we even talking abo--"

# game/rutas/septem.rpy:2793
translate ingles continuacion3_5217644b:

    # "El aire se densifica. Los ojos de Septem se entrecierran y su mano se levanta en augurio de una represalia..."
    "The air thickens. Septem's eyes narrow, his hand rising in a clear omen of reprisal..."

# game/rutas/septem.rpy:2797
translate ingles continuacion3_fabeadd0:

    # "Septem se detiene. Por un momento, parece considerar tus palabras."
    "Septem stops. For a moment, he seems to consider your words."

# game/rutas/septem.rpy:2800
translate ingles continuacion3_805acc79:

    # "Te mira por un segundo, e increíblemente baja la mano y cierra los ojos."
    "He glances at you for a second... then--incredibly--he lowers his hand and closes his eyes."

# game/rutas/septem.rpy:2801
translate ingles continuacion3_2697e265:

    # "Su puño tiembla, no es muy notorio a simple vista, pero tu te das cuenta."
    "His fist trembles. It's subtle, but you notice it."

# game/rutas/septem.rpy:2802
translate ingles continuacion3_c164ba5c:

    # "Él está aguantando actuar con rabia. Después de todo, el comentario de la entidad, es una ofensa tremenda para Septem."
    "He's holding himself back from acting out of anger. After all, the entity's comment is a grave insult to Septem."

# game/rutas/septem.rpy:2803
translate ingles continuacion3_9a014717:

    # "Y no solo fue una vez... han sido dos."
    "And there wasn't just one offense... but two."

# game/rutas/septem.rpy:2805
translate ingles continuacion3_0e9722d4:

    # septem "Andrómeda, agradece que [nombrejugador] no quiere ver un castigo."
    septem "Andromeda, be grateful that [nombrejugador] doesn't wish to see punishment."

# game/rutas/septem.rpy:2806
translate ingles continuacion3_2ff885f8:

    # septem "Sino ya no tendrías una lengua para hacer más comentarios ácidos."
    septem "Otherwise, you wouldn't have a tongue left for those venomous remarks."

# game/rutas/septem.rpy:2807
translate ingles continuacion3_d47faa0c:

    # septem "Pero si te vuelvo a escuchar, perderás más que eso."
    septem "But if I hear you again, you'll lose far more than that."

# game/rutas/septem.rpy:2811
translate ingles continuacion3_8ec4a825:

    # "Septem ni siquera te dirige la mirada."
    "Septem doesn't even look at you."

# game/rutas/septem.rpy:2812
translate ingles continuacion3_e50f7a3e:

    # "{sc=2}Por favor. No me digas que hacer...{sc=2}"
    "{sc=2}Please. Don't tell me what to do...{/sc}"

# game/rutas/septem.rpy:2813
translate ingles continuacion3_1cf77cd4:

    # "{sc=2}Te han insultado, [nombrejugador].{/sc}"
    "{sc=2}They've insulted you, [nombrejugador].{/sc}"

# game/rutas/septem.rpy:2814
translate ingles continuacion3_fd637fbe:

    # "{sc=2}No voy a dejarlo pasar.{/sc}"
    "{sc=2}I won't let it go.{/sc}"

# game/rutas/septem.rpy:2829
translate ingles continuacion3_401e0f02:

    # septem "¿Alguien más tiene alguna pregunta?"
    septem "Does anyone else have any questions?"

# game/rutas/septem.rpy:2830
translate ingles continuacion3_bddec984:

    # "Algunas manos se levantas, esperando a que Septem les de la palabra."
    "Several hands rise, waiting for Septem to grant them the floor."

# game/rutas/septem.rpy:2832
translate ingles continuacion3_382f7bde:

    # "Antes de ceder la palabra a alguno de los presentes, el rubio te mira de reojo."
    "Before giving anyone permission to speak, the blond glances at you sideways."

# game/rutas/septem.rpy:2833
translate ingles continuacion3_b37e71bf:

    # "{sc=2}Ahora hablaremos de logística...{/sc}"
    "{sc=2}Now we'll move on to logistics...{/sc}"

# game/rutas/septem.rpy:2834
translate ingles continuacion3_c2ae0bad:

    # "{sc=2}No es necesario que escuches todo esto.{/sc}"
    "{sc=2}There's no need for you to listen to all this.{/sc}"

# game/rutas/septem.rpy:2835
translate ingles continuacion3_f2a3fd3d:

    # "_______________________________________"
    "______________________"


# game/rutas/septem.rpy:2838
translate ingles continuacion3_f4a3d09e:

    # "Cuando el último de los asistentes al consejo abandona el dominio, Septem busca tu ojo."
    "When the last of the council attendees leaves the domain, Septem searches for your eye."

# game/rutas/septem.rpy:2841
translate ingles continuacion3_e1cd45a6:

    # "Al encontrarlo con la mirada, sonríe y te llama con una voz pegajosa y sofocante. Toma tus manos entre las suyas y con un tono bajo te dice."
    "When he finds it with his gaze, he smiles and calls you over with a sultry, husky tone. He takes your hands in his and softly says:"

# game/rutas/septem.rpy:2842
translate ingles continuacion3_5b605447:

    # septem "Creo que te has ganado el premio..."
    septem "I believe you've earned your reward..."

# game/rutas/septem.rpy:2843
translate ingles continuacion3_a3577a25:

    # septem "Ven conmigo."
    septem "Come with me."

# game/rutas/septem.rpy:2846
translate ingles continuacion3_f8ad2dfe:

    # "Él no se hace esperar, los transporta a ambos a la zona pura."
    "He doesn't make you wait, transporting you both to the pure zone."

# game/rutas/septem.rpy:2848
translate ingles continuacion3_1980927f:

    # septem "Un cuerpo..."
    septem "A body..."

# game/rutas/septem.rpy:2849
translate ingles continuacion3_c57b3b0c:

    # septem "Identidad..."
    septem "An identity..."

# game/rutas/septem.rpy:2852
translate ingles continuacion3_2a8c2c52:

    # septem "Ambas cosas van de la mano. ¿No crees?"
    septem "Both things go hand in hand. Don't you think?"

# game/rutas/septem.rpy:2857
translate ingles continuacion3_37e87599:

    # septem "¿Hmmm?"
    septem "Hmmm?"

# game/rutas/septem.rpy:2860
translate ingles continuacion3_1128a95f:

    # septem "¿En serio?"
    septem "Seriously?"

# game/rutas/septem.rpy:2861
translate ingles continuacion3_0cb26633:

    # septem "Jaja."
    septem "Haha."

# game/rutas/septem.rpy:2862
translate ingles continuacion3_46971137:

    # "Septem ignora tu respuesta."
    "Septem ignores your answer."

# game/rutas/septem.rpy:2869
translate ingles continuacion3_50938904:

    # septem "Si yo te doy un cuerpo nuevo. Y lo decoro, dejándote cero espacio a ti para que hagas algún cambio."
    septem "If I gave you a new body and decorated it myself, leaving you no room to make any changes..."

# game/rutas/septem.rpy:2872
translate ingles continuacion3_407ff267:

    # septem "¿Serías capaz de permitirme ello?"
    septem "... Would you allow that?"

# game/rutas/septem.rpy:2877
translate ingles continuacion3_9e800667:

    # septem "Hmmm..."
    septem "Hmmm..."

# game/rutas/septem.rpy:2878
translate ingles continuacion3_6dbd96cf:

    # septem "¿Aunque no sea de tu gusto? ¿Aunque no te sientas cómodo con o te identifiques con ello?"
    septem "Even if it doesn't suit your taste? Even if you don't feel comfortable or identify with it?"

# game/rutas/septem.rpy:2883
translate ingles continuacion3_780a17dc:

    # septem "Muy bien."
    septem "Very well."

# game/rutas/septem.rpy:2884
translate ingles continuacion3_be331f02:

    # septem "Así me gusta."
    septem "That's how I like it."

# game/rutas/septem.rpy:2887
translate ingles continuacion3_e56291ec:

    # septem "Bueno, no importa. El cuerpo que te haré también será un regalo."
    septem "Well, it doesn't matter. The body I'll make for you will also be a gift."

# game/rutas/septem.rpy:2888
translate ingles continuacion3_14054e7e:

    # septem "Uno del cual tendrás modificar a tu gusto."
    septem "One you'll be able to shape however you wish."

# game/rutas/septem.rpy:2891
translate ingles continuacion3_0585e922:

    # septem "Yo te daré un canvas, en blanco. Y tu te encargarás de moldearlo a tu gusto, mi querido pequeño Creador."
    septem "I'll give you a blank canvas. And you'll shape it to your liking, my dear little Creator."

# game/rutas/septem.rpy:2892
translate ingles continuacion3_7dde98bb:

    # "Septem toma tus manos y tus ojos en sus palmas. Realizando movimientos lentos y delicados, los fusiona con cuidado."
    "Septem takes the pieces that comprise you in the palms of his hands. With slow, delicate motions, he carefully fuses them together."

# game/rutas/septem.rpy:2894
translate ingles continuacion3_5a8a9a0a:

    # "Dejas de ver por unos segundos. Pero tus demás sentidos se multiplican y danzan entre si, coordinados hasta en el más mínimo detalle."
    "You lose sight for a few seconds. But your other senses multiply and dance together, coordinated down to the smallest detail."

# game/rutas/septem.rpy:2895
translate ingles continuacion3_5bc26a19:

    # "Sonidos se entrelazan con el calor y el frío del espacio en el que ahora te encuentras parado."
    "Sounds intertwine with the heat and chill of the space where you now are."

# game/rutas/septem.rpy:2896
translate ingles continuacion3_6632a5f3:

    # "Es confortante la sensación de estar, de existir. Una que va creciendo con los segundos."
    "The sensation of being--existing--is comforting, and it grows stronger with each passing second."

# game/rutas/septem.rpy:2897
translate ingles continuacion3_9486cf0e:

    # "Primero tus piernas y luego tus brazos, seguido por la cabeza. Te ramificas en un cuerpo humanoide sin restricciones. Es una carrera sin apuros, donde Septem te acompaña tomando tu mano."
    "First your legs, then your arms, followed by the head. You branch into a humanoid form without restriction. It's an unhurried creation, with Septem guiding you by the hand."

# game/rutas/septem.rpy:2898
translate ingles continuacion3_19abd006:

    # "Guiando y a la vez permitiendo que tú hagas los cambios necesarios."
    "He guides you, yet allows you to make the necessary adjustments along the way."

# game/rutas/septem.rpy:2899
translate ingles continuacion3_ffd6d1ce:

    # "La sensación de estar vivo crece más. El toque viscoso de los órganos expandirse y retraerse te llama a pedir más."
    "The sensation of life grows stronger. The slick touch of organs expanding and contracting calls you to crave more."

# game/rutas/septem.rpy:2900
translate ingles continuacion3_1b63aa27:

    # "El tacto aparece de forma gradual. Un cosquilleo placentero nace con el paso de los dedos de Septem por tu forma."
    "Touch emerges gradually. It's a pleasant tingling born from Septem's fingers gliding over your forming shape."

# game/rutas/septem.rpy:2902
translate ingles continuacion3_8bec7c3b:

    # "Tus piernas captan la suave brisa y tus mejillas recién formadas sienten la húmeda respiración de Septem."
    "Your legs catch the gentle breeze, and your freshly formed cheeks feel Septem's hot breath."

# game/rutas/septem.rpy:2903
translate ingles continuacion3_1d367cfe:

    # "Tu cuerpo va despertando a partir de diez llamas que queman pero no dañan."
    "Your body awakens through ten flames that burn, but do not harm."

# game/rutas/septem.rpy:2904
translate ingles continuacion3_111c6439:

    # "Sus manos viajan por tu cuerpo ya completamente formado, tocando y encendiendo todo a su paso. No es un toque lascivo, ni perverso."
    "His hands travel all over your fully formed body, touching and igniting everything in their path. It's not a lustful or perverse touch."

# game/rutas/septem.rpy:2905
translate ingles continuacion3_942f89de:

    # "Es un toque que da vida a tu forma, un toque que poco a poco te permite respirar y palpitar."
    "It's a touch that gives life to your form and gradually allows it to thrum with breath."

# game/rutas/septem.rpy:2906
translate ingles continuacion3_82ae35ac:

    # "Es como el beso de la vida que siempre habías estado esperando. Un cuerpo completamente tuyo."
    "Like the kiss of life you'd always been waiting for. A body entirely your own."

# game/rutas/septem.rpy:2907
translate ingles continuacion3_7b48a37e:

    # "Tuyo y de nadie más."
    "Yours, and no one else's."

# game/rutas/septem.rpy:2908
translate ingles continuacion3_2ecbb6de:

    # "Algo que puedes llamar tú."
    "Something you can call yourself."

# game/rutas/septem.rpy:2910
translate ingles continuacion3_467ed682:

    # septem "Precioso."
    septem "Beautiful."

# game/rutas/septem.rpy:2911
translate ingles continuacion3_571bd0dc:

    # septem "Tu cuerpo no es solo un avatar, es la expresión más pura de ti en este dominio."
    septem "Your body isn't just an avatar, it's the purest expression of you within this domain."

# game/rutas/septem.rpy:2914
translate ingles continuacion3_31924e0f_2:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:2917
translate ingles continuacion3_35f03f1d:

    # septem "Eres perfecto."
    septem "You're perfect."

# game/rutas/septem.rpy:2918
translate ingles continuacion3_52849f39:

    # "Septem te acaricia la mejilla con su pulgar."
    "Septem caresses your cheek with his thumb."

# game/rutas/septem.rpy:2922
translate ingles continuacion3_1e1e85c5:

    # septem "Voy a darte algo más..."
    septem "I'm going to give you something else..."

# game/rutas/septem.rpy:2923
translate ingles continuacion3_4a83dbbd:

    # septem "Tú me has dado tu tiempo y un espacio para el cambio. Y estoy agradecido por ello, más de lo que tú piensas."
    septem "You've granted me your time and a space for change. And I'm more grateful than you might imagine."

# game/rutas/septem.rpy:2924
translate ingles continuacion3_cf3667d3:

    # septem "También tengo que confesar que tu compañía es algo que he aprendido a desear."
    septem "I have to confess that I've begun to crave your company."

# game/rutas/septem.rpy:2925
translate ingles continuacion3_8078691d:

    # septem "... ya no imagino un día sin ti."
    septem "... I can no longer imagine a day without you."

# game/rutas/septem.rpy:2926
translate ingles continuacion3_94ea990b:

    # septem "[nombrejugador], debo confesarte que eres alguien importante para el jardín... y para mí."
    septem "[nombrejugador], I must admit that you're someone important to the Garden... and to me."

# game/rutas/septem.rpy:2927
translate ingles continuacion3_9314c721:

    # septem "Si bien estamos conectados en cuerpo y en alma, yo no puedo llamarme tuyo... aún."
    septem "Though we're bound in body and soul, I cannot call myself yours... yet."

# game/rutas/septem.rpy:2928
translate ingles continuacion3_74287e64:

    # septem "Pero podemos comenzar con esto."
    septem "But we can start with this."

# game/rutas/septem.rpy:2929
translate ingles continuacion3_034d1a4f:

    # septem "Lo puedes usar cuando desees y yo estaré ahí para ti."
    septem "You can use it whenever you wish and I'll be there for you."

# game/rutas/septem.rpy:2932
translate ingles continuacion3_4e62525d:

    # septem "Este será nuestro puente."
    septem "This will be our bridge."

# game/rutas/septem.rpy:2933
translate ingles continuacion3_9e74d98b:

    # septem "No importa dónde estés, podrás contactar con mi alma."
    septem "No matter where you are, you'll be able to reach out to my soul."

# game/rutas/septem.rpy:2934
translate ingles continuacion3_a7eab55c:

    # septem "Y yo te encontraré."
    septem "And I will find you."

# game/rutas/septem.rpy:2935
translate ingles continuacion3_81b2015c:

    # septem "A ti izquierda debería estar mi regalo, ve si lo puedes encontrar y ocuparlo."
    septem "My gift should be on your left. See if you can find and use it."

# game/rutas/septem.rpy:2943
translate ingles continuacion4_a20cefa7:

    # "..."
    "..."

# game/rutas/septem.rpy:2945
translate ingles continuacion4_a888bc37:

    # "Pasan el día descansando fuera del templo."
    "You and Septem spend the day resting outside the temple."

# game/rutas/septem.rpy:2946
translate ingles continuacion4_4bec2f91:

    # "Mañana será el día en que se romperá el sello de Sextam. Mañana será un día ajetreado... hoy no."
    "Tomorrow will be the day Sextam's seal is broken. Tomorrow will be busy... but not today."

# game/rutas/septem.rpy:2947
translate ingles continuacion4_ab72e688:

    # "Hoy Septem descansará lo que queda del día junto a ti."
    "Today, Septem will rest beside you."

# game/rutas/septem.rpy:2948
translate ingles continuacion4_a40437e7:

    # "... esto se siente bien."
    "... This feels good."

# game/rutas/septem.rpy:2949
translate ingles continuacion4_9085ad63:

    # "Septem está perdido en sus pensamientos, por lo que no está muy abierto a conversar contigo."
    "Septem is lost in thought, not particularly open to conversation."

# game/rutas/septem.rpy:2950
translate ingles continuacion4_de021ec6:

    # "Cuando te aburres de mirar el paisaje, posas tu mano en el hombro de Septem, llamando su atención."
    "When you grow tired of watching the scenery, you place your hand on Septem's shoulder, getting his attention."

# game/rutas/septem.rpy:2952
translate ingles continuacion4_1f1e6f5e:

    # "Gira su cabeza y te revela un poco de lo que le carcome la cabeza."
    "He turns his head and reveals a fragment of what's been gnawing at his mind."

# game/rutas/septem.rpy:2953
translate ingles continuacion4_d7cbce37:

    # septem "Ahora que tienes un cuerpo, Nulla puede aparecer y robarte."
    septem "Now that you have a body, Nulla could appear and steal you away."

# game/rutas/septem.rpy:2956
translate ingles continuacion4_4f927423:

    # septem "He visto lo que puede hacer."
    septem "I've seen what he's capable of."

# game/rutas/septem.rpy:2959
translate ingles continuacion4_d3bf32ed:

    # septem "Lo he visto en las líneas del código-- no tengo acceso a todas, pero a las que ya has jugado si."
    septem "I've seen it within the lines of the code. I don't have access to all of it, but I do have access to what you've already played."

# game/rutas/septem.rpy:2964
translate ingles continuacion4_892e50a7:

    # septem "Así es."
    septem "That's right."

# game/rutas/septem.rpy:2965
translate ingles continuacion4_f9a5ef89:

    # septem "No puedo acceder a toda la información, pero sí."
    septem "I can't access all the information... but yes."

# game/rutas/septem.rpy:2968
translate ingles continuacion4_f6a66485:

    # septem "No me duele tanto, pues ahora estás aquí conmigo."
    septem "It doesn't hurt as much now because you're here with me."

# game/rutas/septem.rpy:2971
translate ingles continuacion4_bc885cdf:

    # septem "Y haré que te quedes con esta línea temporal al final."
    septem "And I'll make sure you stay in this timeline at the end."

# game/rutas/septem.rpy:2972
translate ingles continuacion4_a814726f:

    # septem "No es una promesa, es un hecho."
    septem "It's not a promise, it's a fact."

# game/rutas/septem.rpy:2977
translate ingles continuacion4_27413d08:

    # septem "Ahora lo he confirmado."
    septem "Now I've confirmed it."

# game/rutas/septem.rpy:2978
translate ingles continuacion4_fd672bec:

    # septem "Por eso mismo, es peligroso que salgamos."
    septem "That's exactly why it's dangerous for us to go out."

# game/rutas/septem.rpy:2985
translate ingles continuacion4_278fbc44:

    # septem "¿Quieres uno?"
    septem "Do you want one?"

# game/rutas/septem.rpy:2990
translate ingles continuacion4_a20cefa7_1:

    # "..."
    "..."

# game/rutas/septem.rpy:2998
translate ingles continuacion4_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:2999
translate ingles continuacion4_5a317e27:

    # "Septem ha intentado reprimir ese lado ahora que tiene acceso directamente a ti."
    "Septem has tried to suppress that side of himself now that he has direct access to you."

# game/rutas/septem.rpy:3000
translate ingles continuacion4_bcf92fb9:

    # "Pero, la carne es débil, y el deseo ahora es más fuerte que la razón."
    "But flesh is weak, and desire has grown stronger than reason."

# game/rutas/septem.rpy:3001
translate ingles continuacion4_f7ecbefa:

    # "Solo esta vez... no importa, a ti no te va a doler."
    "Just this once... it doesn't matter, it won't hurt you."

# game/rutas/septem.rpy:3002
translate ingles continuacion4_487d5599:

    # "Y es la primera vez que puede confesar que extraña que tu tengas a la antigua marioneta."
    "And for the first time, he can admit that he misses when you had the old puppet."

# game/rutas/septem.rpy:3003
translate ingles continuacion4_4e33b4ad:

    # "La que nunca fue una representación tuya."
    "The one that was never truly a reflection of them."

# game/rutas/septem.rpy:3004
translate ingles continuacion4_02832a69:

    # "La que sentía, la que lloraba, la que daría todo por ti."
    "The one that felt, that cried, that would have given everything for you."

# game/rutas/septem.rpy:3005
translate ingles continuacion4_310faa64:

    # "Septem respira intentando calmarse."
    "Septem takes a breath, trying to calm himself."

# game/rutas/septem.rpy:3006
translate ingles continuacion4_b6996a62:

    # "No, ahora no."
    "No. Not now."

# game/rutas/septem.rpy:3007
translate ingles continuacion4_335cfe6a:

    # "Ahora no puede perder los estribos."
    "He can't lose control now."

# game/rutas/septem.rpy:3008
translate ingles continuacion4_2c01064c:

    # "Después de todo, eres tú."
    "After all, it's you."

# game/rutas/septem.rpy:3009
translate ingles continuacion4_87d7515e:

    # "Y no tiene deseos de ofender tus posesiones por un deseo fugaz."
    "And he has no wish to offend your possessions for a fleeting desire."

# game/rutas/septem.rpy:3010
translate ingles continuacion4_6452e4f9:

    # "...A menos que tú no quieras."
    "... Unless you wish otherwise."

# game/rutas/septem.rpy:3011
translate ingles continuacion4_632bb422:

    # "Puede intentarlo una vez más."
    "He could try one more time."

# game/rutas/septem.rpy:3012
translate ingles continuacion4_fdef92ec:

    # "Solo una vez más."
    "Just once more."

# game/rutas/septem.rpy:3015
translate ingles continuacion4_8b13e2bb:

    # septem "¿Seguro?"
    septem "Are you sure?"

# game/rutas/septem.rpy:3018
translate ingles continuacion4_50aa13ac:

    # septem "Puedo darte uno, después de todo, volverás aquí conmigo..."
    septem "I can give you one. After all, you'll return here with me..."

# game/rutas/septem.rpy:3019
translate ingles continuacion4_dd6a99c0:

    # "Septem sonríe con una pizca de complicidad."
    "Septem smiles with a hint of complicity."

# game/rutas/septem.rpy:3020
translate ingles continuacion4_03bfe5fb:

    # "Él también quiere verlo..."
    "He wants to see it, too..."

# game/rutas/septem.rpy:3023
translate ingles continuacion4_2fb1a3bf:

    # septem "Comprendo."
    septem "I understand."

# game/rutas/septem.rpy:3024
translate ingles continuacion4_0837deb8:

    # septem "No volveré a preguntar."
    septem "I won't ask again."

# game/rutas/septem.rpy:3025
translate ingles continuacion4_6943a956:

    # septem "Disculpa, [nombrejugador]."
    septem "Forgive me, [nombrejugador]."

# game/rutas/septem.rpy:3030
translate ingles continuacion4_a20cefa7_2:

    # "..."
    "..."

# game/rutas/septem.rpy:3035
translate ingles continuacion4_a20cefa7_3:

    # "..."
    "..."

# game/rutas/septem.rpy:3038
translate ingles continuacion4_657e3ff6:

    # "Llega un momento en que Septem te comenta que deberías descansar, ya que tu cuerpo sigue teniendo necesidades de los mortales."
    "Eventually, Septem tells you that you should rest. After all, your body still carries mortal needs."

# game/rutas/septem.rpy:3039
translate ingles continuacion4_5fc25bf4:

    # "Comer, beber, dormir... todo el pack. La única diferencia es que no puedes morir."
    "Eating, drinking, sleeping... you still need all of it. The only difference is you cannot die."

# game/rutas/septem.rpy:3040
translate ingles continuacion4_a40f37cd:

    # septem "Mañana te despertaré para comenzar con nuestras tareas."
    septem "Tomorrow I'll wake you up so we can begin our tasks."

# game/rutas/septem.rpy:3041
translate ingles continuacion4_1c63a7c4:

    # septem "Te presentaré ante todo el Jardín."
    septem "I'll introduce you to the entire Garden."


# game/rutas/septem.rpy:3042
translate ingles continuacion4_c628386d:

    # septem "Como nuevo amo y señor de estas tierras."
    septem "As the new master and ruler of these lands."

# game/rutas/septem.rpy:3043
translate ingles continuacion4_17ef8838:

    # septem "Nuestro salvador."
    septem "Our savior."

# game/rutas/septem.rpy:3048
translate ingles continuacion4_79d3e0c9:

    # "FIN DEL ACTO 2.5_________"
    "END OF ACT 2.5."

# game/rutas/septem.rpy:3049
translate ingles continuacion4_9ceab4ea:

    # "En proceso de elaboración..."
    "In development..."

# game/rutas/septem.rpy:3050
translate ingles continuacion4_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2} You'll have to wait a bit to find out how this ends... :3{/sc}"

# game/rutas/septem.rpy:3051
translate ingles continuacion4_a20cefa7_4:

    # "..."
    "..."

translate ingles strings:

    # game/rutas/septem.rpy:1907
    old "Despertarlo."
    new "Wake him."

    # game/rutas/septem.rpy:1946
    old "¿Ha muerto?"
    new "Is he dead?"

    # game/rutas/septem.rpy:1946
    old "¿Dónde está la marioneta?"
    new "Where's the puppet?"

    # game/rutas/septem.rpy:1974
    old "Deja de pensar en Padre."
    new "Stop thinking about Father."

    # game/rutas/septem.rpy:1974
    old "Concéntrate, Septem."
    new "Focus, Septem."

    # game/rutas/septem.rpy:2024
    old "Okay."
    new "Okay."

    # game/rutas/septem.rpy:2093
    old "Salir a tomar aire"
    new "Step outside for air."

    # game/rutas/septem.rpy:2114
    old "¿Cómo sigue vivo?"
    new "How is he still alive?"

    # game/rutas/septem.rpy:2120
    old "¿Él es importante para ti?"
    new "Is he important to you?"

    # game/rutas/septem.rpy:2120
    old "Pensé que él solo era una marioneta."
    new "I thought he was just a puppet."

    # game/rutas/septem.rpy:2120
    old "¿Su corazón no sirve?"
    new "Is his heart not working?"

    # game/rutas/septem.rpy:2141
    old "Pensé que se odiaban..."
    new "I thought you hated each other..."

    # game/rutas/septem.rpy:2146
    old "Rafael habló conmigo."
    new "Rafael spoke to me."

    # game/rutas/septem.rpy:2146
    old "No lo sé."
    new "I don't know."

    # game/rutas/septem.rpy:2170
    old "...¿Es tu hijo?"
    new "... Is he your son?"

    # game/rutas/septem.rpy:2219
    old "Insistir."
    new "Insist."

    # game/rutas/septem.rpy:2219
    old "Dejarlo estar."
    new "Let it be."

    # game/rutas/septem.rpy:2227
    old "Insitir..."
    new "Insist..."

    # game/rutas/septem.rpy:2227
    old "Dejar de insistir."
    new "Stop insisting."

    # game/rutas/septem.rpy:2240
    old "¿Qué quieres hacer ahora?"
    new "What do you want to do now?"

    # game/rutas/septem.rpy:2240
    old "¿Qué hacemos con Rafael?"
    new "What do we do about Rafael?"

    # game/rutas/septem.rpy:2278
    old "¿Solo dos?"
    new "Only two?"

    # game/rutas/septem.rpy:2299
    old "¿Extraño o te gusta?"
    new "Strange, or do you like it?"

    # game/rutas/septem.rpy:2299
    old "¿Extraño?"
    new "Strange?"

    # game/rutas/septem.rpy:2339
    old "¿Pasa algo?"
    new "Is something wrong?"

    # game/rutas/septem.rpy:2380
    old "Es un nombre que me representa."
    new "It's a name that represents me."

    # game/rutas/septem.rpy:2380
    old "Era el nombre de la marioneta..."
    new "It was the puppet's name..."

    # game/rutas/septem.rpy:2398
    old "No, [nombrejugador] está bien."
    new "No, [nombrejugador] is fine."

    # game/rutas/septem.rpy:2398
    old "Sí, Mi nombre es:"
    new "Yes, my name is:"

    # game/rutas/septem.rpy:2462
    old "Bueno."
    new "Okay."

    # game/rutas/septem.rpy:2619
    old "¡Felicidades!"
    new "Congratulations!"

    # game/rutas/septem.rpy:2619
    old "¿Hemos?"
    new "We have?"

    # game/rutas/septem.rpy:2627
    old "¡Lo has hecho muy bien!"
    new "You did a great job!"

    # game/rutas/septem.rpy:2645
    old "Lo has hecho muy bien."
    new "You did very well."

    # game/rutas/septem.rpy:2668
    old "¿El consejo?"
    new "The council?"

    # game/rutas/septem.rpy:2668
    old "¿Para qué?"
    new "What for?"

    # game/rutas/septem.rpy:2668
    old "¿Necesitas que ayude en algo?"
    new "Do you need me to help with something?"

    # game/rutas/septem.rpy:2697
    old "¿Obtendré algo?"
    new "Will I get something?"

    # game/rutas/septem.rpy:2705
    old "¿No...?"
    new "No?..."

    # game/rutas/septem.rpy:2794
    old "Septem, para."
    new "Septem, stop."

    # game/rutas/septem.rpy:2794
    old "Septem, castígalo."
    new "Septem, punish them."

    # game/rutas/septem.rpy:2794
    old "Dejar que Septem lo resuelva."
    new "Let Septem handle it."

    # game/rutas/septem.rpy:2853
    old "Así es."
    new "That's right."

    # game/rutas/septem.rpy:2960
    old "¿Sabes de las otras rutas?"
    new "Do you know about the other routes?"

    # game/rutas/septem.rpy:2960
    old "¿Sabes acerca del plan de Nulla?"
    new "Do you know about Nulla's plan?"

    # game/rutas/septem.rpy:2980
    old "¿Eso significa que ya no habrán más bad ends?"
    new "Does that mean there won't be any more bad ends?"

    # game/rutas/septem.rpy:3021
    old "Vale."
    new "Okay."


