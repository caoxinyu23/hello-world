# game/rutas/septem.rpy:165
translate ingles rutaseptem_9771b774:

    # septem "{sc=2}Una inmersión total,{/sc}"
    septem "{sc=2}A total immersion.{/sc}"

# game/rutas/septem.rpy:166
translate ingles rutaseptem_910e1a3a:

    # septem " {sc=2}no limitada como la que estás experimentando detrás de esa pantalla.{/sc}"
    septem "{sc=2}Not limited like the one you're experiencing behind that screen.{/sc}"

# TODO: Translation updated at 2024-09-24 23:31

# game/rutas/septem.rpy:16
translate ingles rutaseptem_56f2707a:

    # "{sc=2}Bien, lo has hecho bien...{/sc}"
    "{sc=2}Well, you've done well...{/sc}"

# game/rutas/septem.rpy:28
translate ingles rutaseptem_65cd6c85:

    # "En cuestión de segundos dejas de ver al pelirrojo y a Nulla, quedándote solamente con Septem en la mesa."
    "In a matter of seconds, you stop seeing the redhead and Nulla, leaving only Septem at the table with you."

# game/rutas/septem.rpy:140
translate ingles rutaseptem_213aa0d3:

    # "Esperas por lo peor, que te destripe o te rompa algún hueso."
    "You brace yourself for the worst; that he might gut you or break a bone."

# game/rutas/septem.rpy:198
translate ingles rutaseptem_5251a758:

    # "Septem mira con una cara larga a Nulla. Y él notando esto habla más rápido de lo normal."
    "Septem looks at Nulla with a long face. Noticing this, he speaks faster than usual."

# game/rutas/septem.rpy:273
translate ingles rutaseptem_90e2a806:

    # "Todo blanco, sin rastros de otra gama de colores."
    "All white, with no traces of any other color."

# game/rutas/septem.rpy:330
translate ingles rutaseptem_8bb06d6d:

    # "{sc=3}Probablemente te olvides de este mundo cuando cortes el vínculo conmigo.{/sc}"
    "{sc=3}You'll probably forget this world when you cut the bond with me.{/sc}"

# game/rutas/septem.rpy:351
translate ingles rutaseptem_0e183c89:

    # septem "comprendo que para alguien ajeno al jardín pueda ser difícil de entender..."
    septem "I understand that for someone unfamiliar with the Garden, it may be difficult to grasp..."

# game/rutas/septem.rpy:400
translate ingles rutaseptem_512ff982:

    # "Esperas a que Septem aparezca nuevamente, pues no te crees que te haya dejado sin supervisión y te haya dado un pase libre para hacer lo que quieras."
    "You wait for Septem to appear again, as you can't believe he would leave you unsupervised and give you a free pass to do whatever you want."

# game/rutas/septem.rpy:422
translate ingles rutaseptem_a39167de:

    # "Pues tienen un montón de estatuas de Septem y cuadros con alegoría religiosa."
    "Well, there's a bunch of statues of Septem and paintings with religious allegory."

# game/rutas/septem.rpy:423
translate ingles rutaseptem_90e678e0:

    # "Y dentro de él te encuentras con un montón de puertas."
    "And inside it, you find a bunch of doors."

# game/rutas/septem.rpy:434
translate ingles rutaseptem_d5308e44:

    # "Pero no encuentras respuesta a ninguna de las dos incógnitas."
    "But you find no answer to either of the two questions."

# game/rutas/septem.rpy:443
translate ingles rutaseptem_db955fee:

    # "Tienes la tentación de preguntar porqué le pone tanto énfasis a tener que compartir la comida contigo."
    "You're tempted to ask why he puts so much emphasis on sharing mealtimes with you."

# game/rutas/septem.rpy:504
translate ingles rutaseptem_7827259a:

    # septem "No te preocupes tienes total libertad de hablarme como se te plazca."
    septem "Don't worry, you have complete freedom to talk to me however you please."

# game/rutas/septem.rpy:567
translate ingles rutaseptem_84954979:

    # septem "Aunque... viendo que aún tienes la capacidad de tomar una decisión que va contra los deseos de la marioneta, la penalización no será fatal."
    septem "Although... seeing that you still have the ability to make a decision that goes against the puppet's wishes, the penalty won't be fatal."

# game/rutas/septem.rpy:579
translate ingles rutaseptem_86a647f7:

    # "Una de sus manos se posa en tu mandíbula, tomándola con delicadeza para luego apretar con fuerza entre tus mejillas, provocando que tu boca se abra automáticamente."
    "One of his hands rests on your jaw, gently taking it and squeezing your cheeks hard, causing your mouth to open automatically."

# game/rutas/septem.rpy:595
translate ingles rutaseptem_3c520728:

    # septem "A estas alturas, no veo el propósito de tener una lengua que se manda sola y habla sin el permiso de su dueño."
    septem "At this point, I see no purpose in having a tongue that acts on its own and speaks without its owner's permission."

# game/rutas/septem.rpy:618
translate ingles rutaseptem_b213137e:

    # septem "Y no me gustaría omitir información vital para tu toma de decisión cuando empiece el cambio de recipiente."
    septem "And I wouldn't want to omit vital information for your decision-making when the vessel change begins."

# game/rutas/septem.rpy:698
translate ingles rutaseptem_f74f2a4b:

    # septem "Pero contigo aquí no será necesario continuar con esto... si nos unimos en una transfusión, me concederás la autoridad de manipular el jardín a mí---"
    septem "But with you here, it won't be necessary to continue with this... if we unite in a transfusion, you will grant me the authority to manipulate the Garden for myself--"

# game/rutas/septem.rpy:716
translate ingles rutaseptem_a985075b:

    # "No parece ser tan malo como creías... tal vez es algo inadaptado... después de todo él hace lo que cree que es correcto, siempre siguiendo la etiqueta y reglas pues eso es lo único que conoce."
    "It doesn't seem so bad as you thought... maybe it's just a bit maladaptive... after all, he does what he believes is right, always following etiquette and rules because that's all he knows."

# TODO: Translation updated at 2025-02-22 21:37

# game/rutas/septem.rpy:46
translate ingles rutaseptem_be0a37cb:

    # "Fácilmente pasan 30 segundos donde ninguno de ustedes parpadea. Y tú ya te encuentras en el límite."
    "Thirty seconds pass effortlessly without either of you blinking. And you are already at your limit."

# game/rutas/septem.rpy:68
translate ingles rutaseptem_9d9c2b88:

    # "Con cautela te sientas al frente de Septem, quien te sonríe, complacido de que le hayas hecho caso sin mucha protesta."
    "Cautiously, you take a seat in front of Septem, who smiles at you, pleased that you complied without much protest."

# game/rutas/septem.rpy:106
translate ingles rutaseptem_60dad6be:

    # "Le cuentas sin mucha vergüenza (pues esa la decidiste dejar cuando aceptaste descargar este juego) desde los datos más minusculos y rebuscados"
    "You recount without much embarrassment (since you chose to leave that behind when you agreed to download this game) from the tiniest, most obscure details."

# game/rutas/septem.rpy:575
translate ingles rutaseptem_d2e773c5:

    # "Septem sonríe de manera tétrica."
    "Septem smiles in a grim manner."

# game/rutas/septem.rpy:585
translate ingles rutaseptem_27783ba4:

    # septem "Por respeto a ti, [nombrejugador], no lo haré de una forma tan cruda."
    septem "Out of respect for you, [nombrejugador], I won't do it in such a crude way."

# game/rutas/septem.rpy:592
translate ingles rutaseptem_36d385e5:

    # "No solo por el dolor, sino que también porque no entiendes que está pasando, y porqué está pasando."
    "Not only because of the pain, but also because you don't understand what's happening, or why it's happening."

# game/rutas/septem.rpy:758
translate ingles rutaseptem_b766d67f:

    # "Luego de aquello, Septem teletransporta a tu habitación para terminar por el día."
    "After that, Septem teleports you to your room to end the day."

# game/rutas/septem.rpy:759
translate ingles rutaseptem_171b8f92:

    # "Cuando te arropas en la cama, él te comenta que mañana comerás sin su compañía hasta la cena."
    "As you settle into bed, he tells you that tomorrow, you'll dine without his company until dinner."

# game/rutas/septem.rpy:760
translate ingles rutaseptem_79085e4b:

    # "Y se retira de la habitación sin dar más explicaciones, despidiéndose educadamente de ti..."
    "And he leaves the room without further explanation, politely saying goodbye to you..."

# game/rutas/septem.rpy:762
translate ingles rutaseptem_cb7e7694:

    # "Cierras los ojos, esperando dormirte al instante."
    "You close your eyes, hoping to fall asleep instantly."

# game/rutas/septem.rpy:763
translate ingles rutaseptem_a8ffe147:

    # "Pero te cuesta un poco."
    "But it takes you a while."

# game/rutas/septem.rpy:765
translate ingles rutaseptem_729cd744:

    # "___________________________"
    "__________"

# game/rutas/septem.rpy:768
translate ingles rutaseptem_3eda743c:

    # "Ves una figura aparecer en la oscuridad."
    "You see a figure appear in the darkness."

# game/rutas/septem.rpy:770
translate ingles rutaseptem_81c19a74:

    # "Pero cuando enfocas tus ojos a la figura, está desaparece."
    "But when you focus your eyes on the figure, it vanishes."

# game/rutas/septem.rpy:771
translate ingles rutaseptem_b7c3c6ec:

    # "De la impresión caes al suelo."
    "The shock makes you fall to the ground."

# game/rutas/septem.rpy:772
translate ingles rutaseptem_a20cefa7_7:

    # "..."
    "..."

# game/rutas/septem.rpy:774
translate ingles rutaseptem_a5d2750c:

    # "Hola, [nombrejugador]"
    "Hello, [nombrejugador]."

# game/rutas/septem.rpy:775
translate ingles rutaseptem_d1d9ae73:

    # "Veo que has tomado una decisión..."
    "I see that you have made a decision..."

# game/rutas/septem.rpy:776
translate ingles rutaseptem_a3e3d622:

    # "No tiene caso seguir insistiendo... supongo que la ideología de Septem siempre ha sido la correcta."
    "There's no point in insisting any further... I suppose Septem's ideology has always been the right one."

# game/rutas/septem.rpy:777
translate ingles rutaseptem_285cf8b3:

    # "Y nuestro plan es la opción egoísta y más fácil de ejecutar."
    "And our plan is the most selfish and easiest to execute."

# game/rutas/septem.rpy:778
translate ingles rutaseptem_a20cefa7_8:

    # "..."
    "..."

# game/rutas/septem.rpy:785
translate ingles rutaseptem_e9fbaf4e:

    # "Escuchas una risa seca."
    "You hear a dry laugh."

# game/rutas/septem.rpy:786
translate ingles rutaseptem_d02c65de:

    # "¿Qué una madre no puede tener una conversación con su hijo?"
    "What, can't a mother have a conversation with her child?"

# game/rutas/septem.rpy:787
translate ingles rutaseptem_a20cefa7_9:

    # "..."
    "..."

# game/rutas/septem.rpy:790
translate ingles rutaseptem_d00dc025:

    # madre "Soy Madre de tu marioneta, primera marioneta hecha con mi carne y fragmentos del alma de Nulla, para poder contenerte."
    madre "I am the Mother of your puppet, the first puppet made from my flesh and fragments of Nulla's soul, to be able to contain you."

# game/rutas/septem.rpy:791
translate ingles rutaseptem_ed4dd5ba:

    # madre "Así como también, soy Madre del jardín."
    madre "And likewise, I am the Mother of the Garden."

# game/rutas/septem.rpy:792
translate ingles rutaseptem_3a0ae1cc:

    # madre "Solamente puedo tener comunicación con Nulla gracias a las leyes estúpidas que dictaminó el Creador..."
    madre "I can only communicate with Nulla thanks to the stupid laws decreed by the Creator..."

# game/rutas/septem.rpy:793
translate ingles rutaseptem_44047298:

    # madre "Por lo que la única comunicación que tengo con el exterior es Nulla... y, no... él no se encuentra muy abierto a escuchar otras soluciones ahora que estás tu aquí."
    madre "So the only communication I have with the outside is with Nulla... and, no... he's not very open to hearing other solutions now that you're here."

# game/rutas/septem.rpy:794
translate ingles rutaseptem_a985d558:

    # madre "Pero puedo acceder a ti gracias a la marioneta. Y contigo aquí, fuera del alcance de Nulla, puedo conseguir lo que quiero sin dañar a nadie dentro del Jardín."
    madre "But I can reach you, thanks to the puppet. And with you here, out of Nulla's reach, I can get what I want without harming anyone within the Garden."

# game/rutas/septem.rpy:795
translate ingles rutaseptem_6d2fe123:

    # madre "Si tienes la oportunidad, dile a Septem que me deje ir."
    madre "If you get the chance, tell Septem to let me go."

# game/rutas/septem.rpy:796
translate ingles rutaseptem_f33e8ee8:

    # madre "Si hablas con Septem, tal vez él pueda idear algo para sacarme de esta condena."
    madre "If you speak with Septem, perhaps he can come up with something to get me out of this damnation."

# game/rutas/septem.rpy:801
translate ingles rutaseptem_213021c3:

    # madre "Sí, fue 'El Creador' o 'Padre', como quiera que lo llamen aquí. Él y yo éramos iguales... ambas divinidades omnipresentes creadas por un ser del plano superior."
    madre "Yes, it was 'The Creator' or 'Father', whichever you call him here. He and I were equal... both omnipresent deities created by a being from the higher plane."

# game/rutas/septem.rpy:802
translate ingles rutaseptem_c7bc8fb6:

    # madre "Aunque no vale la pena hablar de este ser, ya que nadie de aquí puede ponerle las manos encima, como sucede contigo [nombrejugador]."
    madre "Although it's not worth discussing this being, since no one here can lay hands on him, as is the case with you, [nombrejugador]."

# game/rutas/septem.rpy:803
translate ingles rutaseptem_d5bbc295:

    # madre "..."
    madre "..."

# game/rutas/septem.rpy:805
translate ingles rutaseptem_96fef91a:

    # madre "Lo que sucedió fue que el Creador, viendo mi historial, me consideró peligrosa para los habitantes del Jardín por abrirle los ojos a mi Ne--Nulla, en épocas pasadas."
    madre "What happened was that the Creator, seeing my history, deemed me dangerous to the inhabitants of the Garden for having opened my Ne--Nulla's eyes in times past."

# game/rutas/septem.rpy:806
translate ingles rutaseptem_b02dd2f1:

    # madre "Por ello, me condenó a estar segregada y a mantener al Jardín con mi cuerpo."
    madre "Therefore, he condemned me to be segregated and to sustain the Garden with my body."

# game/rutas/septem.rpy:807
translate ingles rutaseptem_e8ffb5a3:

    # madre "Amo y odio al Jardín. Estoy viva gracias a ellos, tengo conexión con toda entidad del Jardín, todos y cada uno. Siento todo, desde el 1 al 7..."
    madre "I both love and hate the Garden. I am alive because of it; I have a connection with every entity in the Garden, each and every one. I feel everything, from one to seven..."

# game/rutas/septem.rpy:808
translate ingles rutaseptem_fdd84dda:

    # madre "Siento su agonía; hago placebos, traigo humanos con ayuda de Nulla, todo para no sentir su dolor colectivo... aunque cueste romper mi cuerpo físico una y otra vez..."
    madre "I feel their agony; I make placebos, I bring humans with Nulla's help, all to avoid feeling their collective pain... even if it means breaking my physical body over and over again..."

# game/rutas/septem.rpy:809
translate ingles rutaseptem_426a2ba8:

    # madre "Es inútil... no puedo salir de aquí... No puedo amparar a mis hijos. No puedo siquiera tener una conversación con ellos."
    madre "It's useless... I can't get out of here... I can't protect my children. I can't even have a conversation with them."

# game/rutas/septem.rpy:810
translate ingles rutaseptem_343ce9ae:

    # madre "Y aun así, los conozco como la palma de mis manos."
    madre "And yet, I know them like the back of my hand."

# game/rutas/septem.rpy:812
translate ingles rutaseptem_e7fb5303:

    # madre "Sé las preocupaciones de Duae, sé la rabia que tiene Tria, la soledad de Quinque..."
    madre "I know Duae's worries, I know Tria's anger, Quinque's loneliness..."

# game/rutas/septem.rpy:813
translate ingles rutaseptem_4bf96bf1:

    # madre "Y sé lo roto que está Septem."
    madre "And I know how broken Septem is."

# game/rutas/septem.rpy:814
translate ingles rutaseptem_e3844e6b:

    # madre "Puedo sentir y escuchar sus plegarias, pidiendo a gritos a su padre que vuelva para arreglar todo."
    madre "I can feel and hear their prayers, desperately begging their father to come back and fix everything."

# game/rutas/septem.rpy:816
translate ingles rutaseptem_701c89c8:

    # madre "Pero él no va a venir."
    madre "But he is not going to come."

# game/rutas/septem.rpy:817
translate ingles rutaseptem_5045742c:

    # madre "Es muy orgulloso para ello."
    madre "He's too proud for that."

# game/rutas/septem.rpy:818
translate ingles rutaseptem_03caeffe:

    # madre "Y realmente, no le interesa."
    madre "And honestly, he doesn't care."

# game/rutas/septem.rpy:819
translate ingles rutaseptem_13b383b0:

    # madre "Septem es uno más de los tantos que tiene."
    madre "Septem is just one among many."

# game/rutas/septem.rpy:820
translate ingles rutaseptem_72d07420:

    # "Madre suspira pesadamente y su aura cambia."
    "Mother sighs heavily and her aura shifts."

# game/rutas/septem.rpy:822
translate ingles rutaseptem_2daf9bcc:

    # madre "No tengo problemas en dejar que el jardín siga viviendo."
    madre "I have no problem letting the Garden keep living."

# game/rutas/septem.rpy:823
translate ingles rutaseptem_ccb001e1:

    # madre "Pero mi individualidad, mi ser y omnipresencia ya no aguanta más."
    madre "But my individuality, my being, and omnipresence can no longer endure."

# game/rutas/septem.rpy:824
translate ingles rutaseptem_4997b13b:

    # madre "Así que por favor dile a Septem que me quite la individualidad. Que deje mi cuerpo en el vacío, eternamente en un ciclo infinito de destrucción y regeneración."
    madre "So please, tell Septem to strip me of my individuality. To leave my body in the Void, eternally in an endless cycle of destruction and regeneration."

# game/rutas/septem.rpy:825
translate ingles rutaseptem_db9e3787:

    # madre "Sé que mi cuerpo y esencia deben estar presentes... pero mi individualidad no es necesaria."
    madre "I know my body and essence must be present... but my individuality is not necessary."

# game/rutas/septem.rpy:826
translate ingles rutaseptem_f0220139:

    # madre "Sé que Septem puede hacer algo ahora que te tiene aquí. Confío en que puede arreglarlo."
    madre "I know Septem can do something now that he has you here. I trust he can fix it."

# game/rutas/septem.rpy:827
translate ingles rutaseptem_feaa587e:

    # madre "Ahora que tiene nuevos ojos que no están ligados al Creador."
    madre "Now that he has new eyes that are not tied to the Creator."

# game/rutas/septem.rpy:828
translate ingles rutaseptem_9522667d:

    # madre "Pueden sanar y eliminar todas las condenas del Creador."
    madre "They can heal and eliminate all of the Creator's curses."

# game/rutas/septem.rpy:829
translate ingles rutaseptem_23245ea8:

    # madre "Y si tienes la oportunidad-"
    madre "And if you get the chance--"

# game/rutas/septem.rpy:830
translate ingles rutaseptem_984524c6:

    # madre "Quiero que rompas los ojos de cada uno de los Estandartes."
    madre "I want you to break the eyes of each of the Symbols."

# game/rutas/septem.rpy:831
translate ingles rutaseptem_74df25df:

    # madre "Incluidos los de Septem."
    madre "Including Septem's."

# game/rutas/septem.rpy:832
translate ingles rutaseptem_e9727939:

    # madre "No pienso arriesgar que ese maldito se de cuenta del cambio de mando."
    madre "I won't risk that bastard noticing the change of command."

# game/rutas/septem.rpy:833
translate ingles rutaseptem_effb1ea2:

    # madre "Porque no sé cómo puede llegar a reaccionar---"
    madre "Because I don't know how he might react--"

# game/rutas/septem.rpy:834
translate ingles rutaseptem_6d72cbce:

    # "__________________________"
    "_________"

# game/rutas/septem.rpy:838
translate ingles rutaseptem_4c99e2fc:

    # "{glitch=20.0}{color=ffffff}{b}_________________________________{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}___________________{/glitch}"

# game/rutas/septem.rpy:839
translate ingles rutaseptem_a3435647:

    # "{glitch=20.0}{color=ffffff}{b}Madre no sabe lo que dice....{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Mother doesn't know what she's saying....{/glitch}"

# game/rutas/septem.rpy:840
translate ingles rutaseptem_90a31428:

    # "{glitch=20.0}{color=ffffff}{b}Es imposible deshacerse de él.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}It's impossible to get rid of him.{/glitch}"

# game/rutas/septem.rpy:841
translate ingles rutaseptem_5a2a8dd9:

    # "{glitch=20.0}{color=ffffff}{b}Dudo que los deje vivir tranquilos si hacen el cambio de mando.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I doubt he'll let them live in peace if they change command.{/glitch}"

# game/rutas/septem.rpy:842
translate ingles rutaseptem_3e34d92c:

    # "{glitch=20.0}{color=ffffff}{b}Con eso si que es como si le declararas la guerra a esa marioneta que se hace llamar Creador.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}That really is like declaring war on that puppet that calls itself Creator.{/glitch}"

# game/rutas/septem.rpy:843
translate ingles rutaseptem_b9aeb933:

    # "{glitch=20.0}{color=ffffff}{b}Es un imbécil...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}He's an idiot...{/glitch}"

# game/rutas/septem.rpy:844
translate ingles rutaseptem_131fdaec:

    # "{glitch=20.0}{color=ffffff}{b}La única forma de darle fin a esta agonía colectiva es con la destrucción total de todo.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}The only way to end this collective agony is the total destruction of everything.{/glitch}"

# game/rutas/septem.rpy:845
translate ingles rutaseptem_d37d0ab9:

    # "{glitch=20.0}{color=ffffff}{b}Sino, seguiré siendo reciclado hasta que quien controla al Creador se aburra....{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Otherwise, I'll keep being recycled until whoever controls the Creator gets bored....{/glitch}"

# game/rutas/septem.rpy:846
translate ingles rutaseptem_f5f2e60a:

    # "{glitch=20.0}{color=ffffff}{b}Y este mundo quedará completamente abandonado cuando quien controla al Creador se aburra de ellos...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}And this world will be completely abandoned when whoever controls the Creator gets tired of it...{/glitch}"

# game/rutas/septem.rpy:847
translate ingles rutaseptem_e8333b48:

    # "{glitch=20.0}{color=ffffff}{b}Sumidos en eterna oscuridad para siempre.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Condemned to eternal darkness forever.{/glitch}"

# game/rutas/septem.rpy:848
translate ingles rutaseptem_38926b24:

    # "{glitch=20.0}{color=ffffff}{b}Tienen suerte de que esa entidad no se haya aburrido aún.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}You're lucky that entity hasn't gotten bored yet.{/glitch}"

# game/rutas/septem.rpy:849
translate ingles rutaseptem_26bdc189:

    # "{glitch=20.0}{color=ffffff}{b}Si no fuera así ni siquiera estarías aquí.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}If it weren't so, you wouldn't even be here.{/glitch}"

# game/rutas/septem.rpy:850
translate ingles rutaseptem_5d4fd3f5:

    # "{glitch=20.0}{color=ffffff}{b}... {/glitch}"
    "{glitch=20.0}{color=ffffff}{b}...{/glitch}"

# game/rutas/septem.rpy:851
translate ingles rutaseptem_41641b7a:

    # "{glitch=20.0}{color=ffffff}{b}Oh! mil disculpas, no te saludé.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Oh! My apologies, I didn't greet you.{/glitch}"

# game/rutas/septem.rpy:852
translate ingles rutaseptem_0eec34e9:

    # "{glitch=20.0}{color=ffffff}{b}¡Hola, cariño!{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Hola, cariño!{/glitch}"

# game/rutas/septem.rpy:853
translate ingles rutaseptem_1873073d:

    # "{glitch=20.0}{color=ffffff}{b}Veo que aún no puedes dejarme ir... ni si quiera en esta ruta del juego.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I see that you still can't let me go... not even on this game route.{/glitch}"

# game/rutas/septem.rpy:854
translate ingles rutaseptem_ed4a70e1:

    # "{glitch=20.0}{color=ffffff}{b}Adorable.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Adorable.{/glitch}"

# game/rutas/septem.rpy:855
translate ingles rutaseptem_198e9d1d:

    # "{glitch=20.0}{color=ffffff}{b}Lamentablemente no puedo entrar al templo de Septem.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Unfortunately, I can't enter Septem's temple.{/glitch}"

# game/rutas/septem.rpy:856
translate ingles rutaseptem_219b3b09:

    # "{glitch=20.0}{color=ffffff}{b}No lo tengo permitido sin que tus ojos estén en mí en el límite de su dominio...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I'm not allowed to do that unless your eyes are on me at the edge of his domain...{/glitch}"

# game/rutas/septem.rpy:857
translate ingles rutaseptem_1e593bdd:

    # "{glitch=20.0}{color=ffffff}{b}Si pudieras salir de aquí y llegar al límite del dominio...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}If you could leave here and reach the edge of the domain...{/glitch}"

# game/rutas/septem.rpy:860
translate ingles rutaseptem_841087ed:

    # "{glitch=20.0}{color=ffffff}{b}Awww.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Awww.{/glitch}"

# game/rutas/septem.rpy:861
translate ingles rutaseptem_7eb3dcaa:

    # "{glitch=20.0}{color=ffffff}{b}Yo igual te extraño mucho.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I miss you a lot, too.{/glitch}"

# game/rutas/septem.rpy:862
translate ingles rutaseptem_6292bdbd:

    # "{glitch=20.0}{color=ffffff}{b}Pero.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}But.{/glitch}"

# game/rutas/septem.rpy:865
translate ingles rutaseptem_556c682b:

    # "{glitch=20.0}{color=ffffff}{b}¿Hmmm?{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Hmmm?{/glitch}"

# game/rutas/septem.rpy:866
translate ingles rutaseptem_84650c4f:

    # "{glitch=20.0}{color=ffffff}{b}Eso dependerá de ti.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}That will depend on you.{/glitch}"

# game/rutas/septem.rpy:867
translate ingles rutaseptem_e5d98dcc:

    # "{glitch=20.0}{color=ffffff}{b}Oh.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Oh.{/glitch}"

# game/rutas/septem.rpy:869
translate ingles rutaseptem_44cf5aa0:

    # "{glitch=20.0}{color=ffffff}{b}... debo retirarme.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}... I must take my leave.{/glitch}"

# game/rutas/septem.rpy:870
translate ingles rutaseptem_72501dcc:

    # "{glitch=20.0}{color=ffffff}{b}Buenas noches, cariño...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Good night, cariño...{/glitch}"

# game/rutas/septem.rpy:875
translate ingles rutaseptem_06da4fdb:

    # "Algo te impide seguir en el sueño."
    "Something prevents you from staying in the dream."

# game/rutas/septem.rpy:876
translate ingles rutaseptem_251e169e:

    # "Es la voz de Septem, que se escucha a lo lejos."
    "It's Septem's voice, heard in the distance."

# game/rutas/septem.rpy:879
translate ingles rutaseptem_a452dd9c:

    # "Abres los ojos de golpe, buscando al causante del casi mini ataque al corazón que estás teniendo."
    "You open your eyes abruptly, searching for the cause of the near-mini heart attack you're experiencing."

# game/rutas/septem.rpy:881
translate ingles rutaseptem_5367661f:

    # "Septem no se encuentra en ningún rincón de tu habitación."
    "Septem is nowhere to be found in your room."

# game/rutas/septem.rpy:882
translate ingles rutaseptem_20d8aa69:

    # "Debe haber sido parte del sueño."
    "It must have been part of the dream."

# game/rutas/septem.rpy:883
translate ingles rutaseptem_311366e4:

    # septem "[nombrejugador], es hora de que la marioneta vaya a comer."
    septem "[nombrejugador], it's time for the puppet to go eat."

# game/rutas/septem.rpy:884
translate ingles rutaseptem_f85bb379:

    # "O tal vez no..."
    "Or perhaps not..."

# game/rutas/septem.rpy:885
translate ingles rutaseptem_171c2b3f:

    # "Te levantas con dificultad, tal parece que no has descansado nada."
    "You struggle to get up; it seems you haven't rested at all."

# game/rutas/septem.rpy:886
translate ingles rutaseptem_41eafb74:

    # "Caminas por los pasillos como si de un robot se tratara, sabiendo exactamente donde se encuentra el comedor."
    "You walk through the corridors like a robot, knowing exactly where the dining hall is."

# game/rutas/septem.rpy:888
translate ingles rutaseptem_c37c09d3:

    # "Al llegar, los platos aparecen con nada más pestañear."
    "Upon arrival, the dishes appear in the blink of an eye."

# game/rutas/septem.rpy:889
translate ingles rutaseptem_a20cefa7_10:

    # "..."
    "..."

# game/rutas/septem.rpy:890
translate ingles rutaseptem_6141e6c5:

    # septem "Hoy no comeré contigo..."
    septem "I won't dine with you today..."

# game/rutas/septem.rpy:891
translate ingles rutaseptem_180dbdba:

    # "Que extraño..."
    "How strange..."

# game/rutas/septem.rpy:892
translate ingles rutaseptem_f95977d5:

    # "Te sientas y comes en silencio."
    "You sit down and eat in silence."

# game/rutas/septem.rpy:893
translate ingles rutaseptem_9f1566f2:

    # "Bocado tras bocado, terminas el desayuno."
    "Bite after bite, you finish your breakfast."

# game/rutas/septem.rpy:894
translate ingles rutaseptem_38eec854:

    # "Sin saber que hacer te levantas."
    "Unsure of what to do, you get up."

# game/rutas/septem.rpy:897
translate ingles rutaseptem_c6c40626:

    # "No tienes nada que hacer más que buscar a Septem."
    "You have nothing to do but search for Septem."

# game/rutas/septem.rpy:898
translate ingles rutaseptem_b1e94b2f:

    # "Es eso o esperar hasta la cena para acabar el día."
    "It's either that, or wait until dinner to end the day."

# game/rutas/septem.rpy:899
translate ingles rutaseptem_374e23e1:

    # "Te está aburriendo un poco de esto."
    "You're getting a little bored of this."

# game/rutas/septem.rpy:900
translate ingles rutaseptem_a20cefa7_11:

    # "..."
    "..."

# game/rutas/septem.rpy:902
translate ingles rutaseptem_be6729e4:

    # "Recorres toda la planta inferior del templo, sin mucho éxito."
    "You roam the entire lower level of the temple, with little success."

# game/rutas/septem.rpy:905
translate ingles rutaseptem_9eae176f:

    # "La habitación donde duerme Septem está abierta y no se encuentra nadie dentro de ella. Ni siquiera parece haber sido ocupada hoy."
    "The room where Septem sleeps is open and unoccupied. It doesn't even seem to have been used today."

# game/rutas/septem.rpy:906
translate ingles rutaseptem_a069a098:

    # "Y eso es extraño."
    "And that's strange."

# game/rutas/septem.rpy:908
translate ingles rutaseptem_6ae9f26c:

    # "No lo encuentras por ningún lado."
    "You can't find him anywhere."

# game/rutas/septem.rpy:910
translate ingles rutaseptem_b6a5265a:

    # "Te preguntas si estará en la segunda planta del templo."
    "You wonder if he might be on the second floor of the temple."

# game/rutas/septem.rpy:911
translate ingles rutaseptem_0322ba21:

    # "Después de todo, no recorriste todo el pasillo que viste anteriormente..."
    "After all, you didn't traverse the entire corridor you saw earlier..."

# game/rutas/septem.rpy:913
translate ingles rutaseptem_649841c5:

    # "Haciendo el último intento, subes por las escaleras en busca de Septem."
    "Making one last attempt, you climb the stairs in search of Septem."

# game/rutas/septem.rpy:914
translate ingles rutaseptem_e0f36592:

    # "No tienes muchas esperanzas de encontrarlo, sinceramente piensas que está fuera del dominio."
    "You don't hold much hope of finding him. Honestly, you think he might be outside the domain."

# game/rutas/septem.rpy:916
translate ingles rutaseptem_0f5ca67d:

    # "Caminas por el pasillo mirando todo lo que tiene que ofrecer, lo cual, no es mucho."
    "You walk down the corridor, taking in all it has to offer, which isn't much."

# game/rutas/septem.rpy:917
translate ingles rutaseptem_a13541de:

    # "Hasta que llevas al final del pasillo, y te topas con una puerta abierta."
    "Until you reach the end of it and come across an open door."

# game/rutas/septem.rpy:918
translate ingles rutaseptem_b51c9b64:

    # "De esas que deberían estar cerradas."
    "One that should be closed."

# game/rutas/septem.rpy:919
translate ingles rutaseptem_e56700c2:

    # "Te lo piensas antes de entrar.... pero Septem dijo que podías recorrer su dominio, y no consideras que sería una falta entrar a una puerta que está abierta."
    "You hesitate before entering... but Septem said you could roam his domain, and you don't consider it a transgression to enter an open door."

# game/rutas/septem.rpy:920
translate ingles rutaseptem_25343748:

    # "Prácticamente te está invitando a entrar."
    "It's practically inviting you in."

# game/rutas/septem.rpy:922
translate ingles rutaseptem_d2f912a6:

    # "Al entrar lo primero que ves es un montón de estantes con libros. Luego te das cuenta de los papeles en el suelo, revueltos y abandonados a su suerte."
    "Upon entering, the first thing you see is a multitude of shelves filled with books. Then you notice papers on the floor, scattered and abandoned."

# game/rutas/septem.rpy:924
translate ingles rutaseptem_e11828a4:

    # "Miras un poco más allá y ves a Septem, en lo que parece ser su escritorio. El escritorio es espacioso pero lleno de libros y documentos que bloquean su uso efectivo."
    "Looking further, you see Septem at what appears to be his desk. It's spacious, but cluttered with books and documents that hinder its effective use."

# game/rutas/septem.rpy:925
translate ingles rutaseptem_13756ac5:

    # "Los ojos en la cara de Septem no te miran directamente, pero sientes que los ojos que decoran su halo lo hacen."
    "The eyes on Septem's face don't look directly at you, yet you feel that the eyes adorning his halo do."

# game/rutas/septem.rpy:927
translate ingles rutaseptem_33b8185b:

    # septem "[nombrejugador], ¿necesitas algo?"
    septem "[nombrejugador], do you need anything?"

# game/rutas/septem.rpy:930
translate ingles rutaseptem_a8f6d440:

    # "Luego de no obtener respuesta por parte tuya, Septem entrecierra los ojos. Como si estuviera recordando algo importante, antes de soltar una risa burlona."
    "After receiving no response from you, Septem narrows his eyes, as if recalling something important, before letting out a mocking laugh."

# game/rutas/septem.rpy:932
translate ingles rutaseptem_9c165df2:

    # septem "Oh... casi lo olvido."
    septem "Oh... I almost forgot."

# game/rutas/septem.rpy:933
translate ingles rutaseptem_1df376b4:

    # "Septem ríe suavemente, como si un chiste cruzara por su cabeza."
    "Septem laughs softly, as if a joke had crossed his mind."

# game/rutas/septem.rpy:934
translate ingles rutaseptem_ab8595fb:

    # septem "No tienes lengua... Qué lástima."
    septem "You have no tongue... what a shame."

# game/rutas/septem.rpy:935
translate ingles rutaseptem_819a018c:

    # septem "Podría regenerarte una nueva... pero, sinceramente, no te lo has ganado."
    septem "I could regenerate a new one for you... but, honestly, you haven't earned it."

# game/rutas/septem.rpy:936
translate ingles rutaseptem_b60e56ab:

    # septem "Hmmm~ Se bueno y tal vez, solo tal vez, te ganes una nueva lengua."
    septem "Hmmm~ be good and maybe, just maybe, you'll earn a new tongue."

# game/rutas/septem.rpy:938
translate ingles rutaseptem_98135748:

    # "Septem te sonríe con una dulzura exagerada, pero sus ojos te atraviesan con una mirada que solo puede describirse como una burla cruel."
    "Septem smiles at you with exaggerated sweetness, but his eyes pierce you with a look that can only be described as cruel mockery."

# game/rutas/septem.rpy:940
translate ingles rutaseptem_53c06068:

    # "Tú suspiras y Septem vuelve a mirar su documento."
    "You sigh, and Septem returns his gaze to his document."

# game/rutas/septem.rpy:943
translate ingles rutaseptem_a6ee3c11:

    # "Te habla sin levantar su cara ni ojos del documento que está leyendo. Y es ahora que te das cuenta de que tiene los ojos rojos y la sombra de unas ojeras que están empezando a mostrarse."
    "He speaks to you without lifting his face or eyes from the document he's reading. And it's then that you notice his eyes are red and dark circles are beginning to appear."

# game/rutas/septem.rpy:947
translate ingles rutaseptem_731312a7:

    # "Septem deja de mirar la hoja y te ofrece su mirada cansada."
    "Septem stops looking at the paper and offers you his tired gaze."

# game/rutas/septem.rpy:948
translate ingles rutaseptem_e87c5670:

    # septem "No."
    septem "No."

# game/rutas/septem.rpy:950
translate ingles rutaseptem_061cb082:

    # "Es lo único que te dice para luego clavar nuevamente sus ojos en el documento."
    "That's the only thing he tells you before once again fixing his eyes on the document."

# game/rutas/septem.rpy:954
translate ingles rutaseptem_f5ff2fa5:

    # septem "Ahora no puedo entretenerte."
    septem "I can't entertain you now."

# game/rutas/septem.rpy:959
translate ingles rutaseptem_90fdb1a8:

    # septem "No será posible."
    septem "That won't be possible."


# game/rutas/septem.rpy:960
translate ingles rutaseptem_1bdb90f6:

    # septem "¿Qué me asegura que no intentarás escapar?"
    septem "What assures me that you won't try to escape?"

# game/rutas/septem.rpy:961
translate ingles rutaseptem_5e34b012:

    # nj "Pe--!"
    nj "But--!"

# game/rutas/septem.rpy:962
translate ingles rutaseptem_4860ff14:

    # "Septem levanta su palma en señal de que guardes silencio."
    "Septem raises his palm to signal you to be silent."

# game/rutas/septem.rpy:963
translate ingles rutaseptem_01a328b5:

    # septem "Tal vez más adelante."
    septem "Maybe later."

# game/rutas/septem.rpy:964
translate ingles rutaseptem_03d935a1:

    # septem "Cuando me demuestres ser leal."
    septem "When you prove yourself loyal."

# game/rutas/septem.rpy:967
translate ingles rutaseptem_48206f0f:

    # septem "Si has venido aquí por aburrimiento..."
    septem "If you've come here out of boredom..."

# game/rutas/septem.rpy:968
translate ingles rutaseptem_145a634d:

    # septem "Puedes leer algo de la biblioteca."
    septem "You can read something from the library."

# game/rutas/septem.rpy:969
translate ingles rutaseptem_d9c83436:

    # septem "Pero debes irte a otro lado para leerlo."
    septem "But you must go elsewhere to read it."

# game/rutas/septem.rpy:974
translate ingles rutaseptem_31924e0f_3:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:975
translate ingles rutaseptem_e87c5670_1:

    # septem "No."
    septem "No."

# game/rutas/septem.rpy:976
translate ingles rutaseptem_880ccd35:

    # septem "Toma un libro y retírate por favor."
    septem "Take a book and leave, please."

# game/rutas/septem.rpy:982
translate ingles rutaseptem_6b56b223:

    # "Sin ganas de tentar tu suerte, te diriges al primer estante que encuentras y sacas el primer libro que tus ojos ven."
    "Not feeling like tempting fate, you head to the first shelf you find and pull out the first book you see."

# game/rutas/septem.rpy:984
translate ingles rutaseptem_a20cefa7_12:

    # "..."
    "..."

# game/rutas/septem.rpy:985
translate ingles rutaseptem_e4ee1496:

    # "Genial, no tiene título ni nada."
    "Great, it doesn't even have a title or anything."

# game/rutas/septem.rpy:986
translate ingles rutaseptem_6057811b:

    # "Pero no quieres pasar más tiempo del necesario aquí, así que, a paso pesado, te retiras de la biblioteca."
    "But you don't want to linger any longer, so you leave the library at a slow pace."

# game/rutas/septem.rpy:987
translate ingles rutaseptem_297e1eec:

    # "Supones que ir a la habitación es la mejor idea."
    "You figure that going to your room is the best idea."

# game/rutas/septem.rpy:989
translate ingles rutaseptem_a20cefa7_13:

    # "..."
    "..."

# game/rutas/septem.rpy:990
translate ingles rutaseptem_58198949:

    # "Es un libro viejo, tipo diario, lo sabes porque está escrito a mano... pero tiene diferentes tipografías que se encuentran dentro."
    "It's an old book, like a diary--you know it's handwritten... but it features various typefaces within."

# game/rutas/septem.rpy:992
translate ingles rutaseptem_9b346112:

    # "Parece ser una convesación entre dos personas, aunque, no puedes entender su contenido."
    "It appears to be a conversation between two people, although you can't make out its content."

# game/rutas/septem.rpy:993
translate ingles rutaseptem_80b711e2:

    # "Ya que no eres capaz de leer el contenido."
    "Since you're unable to read the content."

# game/rutas/septem.rpy:994
translate ingles rutaseptem_15c7eebb:

    # "Así que te dedicas a observar los dibujos."
    "So you focus on examining the drawings."

# game/rutas/septem.rpy:996
translate ingles rutaseptem_fc5ff34f:

    # "Son lugares, entidades y algún que otra cara familiar."
    "They depict places, entities, and a few familiar faces."

# game/rutas/septem.rpy:998
translate ingles rutaseptem_c340fd10:

    # "Ves a Nulla en algunas páginas..."
    "You see Nulla on a few pages..."

# game/rutas/septem.rpy:999
translate ingles rutaseptem_03f0108b:

    # "¿Será Septem quien escribió esto?"
    "Could it be Septem who wrote this?"

# game/rutas/septem.rpy:1000
translate ingles rutaseptem_a20cefa7_14:

    # "..."
    "..."

# game/rutas/septem.rpy:1001
translate ingles rutaseptem_7f974a69:

    # "Al llegar a las últimas partes, te das cuenta de algo."
    "Upon reaching the final sections, you notice something."

# game/rutas/septem.rpy:1003
translate ingles rutaseptem_1ee3dd90:

    # "Y es la aparición de dos nombres que varían su aparición dependiendo de la tipografía."
    "And it's the emergence of two names, their appearance varying with the typeface."

# game/rutas/septem.rpy:1004
translate ingles rutaseptem_8ff8818a:

    # "Septem y Rafael..."
    "Septem and Rafael..."

# game/rutas/septem.rpy:1006
translate ingles rutaseptem_1c1a1eba:

    # "¿Esto es una conversación entre ellos dos?"
    "Is this a conversation between the two of them?"

# game/rutas/septem.rpy:1008
translate ingles rutaseptem_4348b1ff:

    # "¿Quién es Rafael?..."
    "Who is Rafael?..."

# game/rutas/septem.rpy:1009
translate ingles rutaseptem_6924fa98:

    # "No te da tiempo a pensar pues sientes una presión extraña en el cuerpo..."
    "You don't have time to think, as you feel a strange pressure in your body..."

# game/rutas/septem.rpy:1011
translate ingles rutaseptem_a82b8dee:

    # "Como si de un contenido prohibido se tratara, cierras el libro de golpe y lo guardas en el cajón del velador."
    "As if it were forbidden material, you slam the book shut and stow it in the bedside drawer."

# game/rutas/septem.rpy:1012
translate ingles rutaseptem_fd071456:

    # "Para calmarte, decides deambular por el templo para pasar el rato."
    "To calm yourself, you decide to wander the temple to pass the time."

# game/rutas/septem.rpy:1018
translate ingles rutaseptem_c8673d6a:

    # "No tienes ganas de ver al rubio."
    "You don't feel like seeing the blond."

# game/rutas/septem.rpy:1019
translate ingles rutaseptem_69f575bd:

    # "Así que esperarás hasta la cena."
    "So you'll wait until dinner."

# game/rutas/septem.rpy:1022
translate ingles rutaseptem_a20cefa7_15:

    # "..."
    "..."

# game/rutas/septem.rpy:1024
translate ingles rutaseptem_b1315871:

    # "Eres llamado para comer el almuerzo, y luego de eso, actas en automático."
    "You're called to have lunch, and afterward, you function on autopilot."

# game/rutas/septem.rpy:1025
translate ingles rutaseptem_489d8bda:

    # "Acostumbrado a esta rutina, te dedicas a recorrer una vez más los pasillos y el templo de Septem. Sin un motivo en específico."
    "Accustomed to this routine, you wander the corridors and Septem's temple once more, without any particular reason."

# game/rutas/septem.rpy:1027
translate ingles rutaseptem_02a92415:

    # "Pasas nuevamente por la biblioteca, y Septem sigue ahí..."
    "You pass the library once again, and Septem remains there..."

# game/rutas/septem.rpy:1028
translate ingles rutaseptem_d8400009:

    # "No estás tan fuera de ti como para molestarlo nuevamente."
    "You're not so out of it as to bother him again."

# game/rutas/septem.rpy:1030
translate ingles rutaseptem_e49429b6:

    # "Así que vuelves a tu habitación."
    "So you head back to your room."

# game/rutas/septem.rpy:1031
translate ingles rutaseptem_cea28e34:

    # "..........."
    "..........."

# game/rutas/septem.rpy:1032
translate ingles rutaseptem_1e4fecd9:

    # "A este paso te volverás loco."
    "At this rate, you'll go crazy."

# game/rutas/septem.rpy:1033
translate ingles rutaseptem_2d99e164:

    # "........................"
    "........................"

# game/rutas/septem.rpy:1034
translate ingles rutaseptem_915803fc:

    # "No sabes cuantas horas han pasado ya, pero la voz de Septem te interrumpe de tu meditación."
    "You don't know how many hours have passed, yet Septem's voice interrupts your meditation."

# game/rutas/septem.rpy:1035
translate ingles rutaseptem_d39b4a4d:

    # septem "[nombrejugador], Ven aquí un momento."
    septem "[nombrejugador], come here for a moment."

# game/rutas/septem.rpy:1038
translate ingles rutaseptem_a93b841a:

    # "Septem no se da el tiempo de esperar, pues eres teletransportado a solo centimetros de su cuerpo."
    "Septem doesn't wait, as you are teleported to just centimeters from him."

# game/rutas/septem.rpy:1039
translate ingles rutaseptem_21d24d25:

    # "Das dos pasos hacia atrás para respetar tu espacio personal... y tienes que subir un poco la cabeza para poder verle a los ojos."
    "You take two steps back to respect your personal space... and you have to tilt your head up to see his eyes."

# game/rutas/septem.rpy:1042
translate ingles rutaseptem_d8179e8c:

    # septem "He convocado una reunión con las hijas del Jardín..."
    septem "I've convened a meeting with the daughters of the Garden..."

# game/rutas/septem.rpy:1043
translate ingles rutaseptem_6ed0814c:

    # septem "Quieren conocerte."
    septem "They want to meet you."

# game/rutas/septem.rpy:1052
translate ingles rutaseptem_15b22704:

    # septem "Escúchame bien... Ellas no tienen idea de que esto es solo un juego para ti."
    septem "Listen well... They have no idea that this is just a game to you."

# game/rutas/septem.rpy:1055
translate ingles rutaseptem_87cc17dc:

    # septem "Tienes que actuar como el nuevo Creador."
    septem "You must act as the new Creator."


# game/rutas/septem.rpy:1056
translate ingles rutaseptem_944ab9ae:

    # "La voz de Septem tiembla un poco... como si la idea de un nuevo Creador le pusiera ansioso."
    "Septem's voice trembles slightly... as if the thought of a new Creator makes him anxious."

# game/rutas/septem.rpy:1057
translate ingles rutaseptem_4edb61b8:

    # septem "Un reemplazo."
    septem "A replacement."

# game/rutas/septem.rpy:1060
translate ingles rutaseptem_dd272b55:

    # septem "Si te comportas, haré algo entretenido para ti luego..."
    septem "If you behave, I'll do something entertaining for you later..."

# game/rutas/septem.rpy:1061
translate ingles rutaseptem_7ca3dffa:

    # "Su sonrisa hace que sientas nervios por todo tu cuerpo, como una corriente de escalofríos que te recorren desde la punta de los dedos hasta tu estómago."
    "His smile sends a shiver through your entire body, from your fingertips down to your stomach."

# game/rutas/septem.rpy:1062
translate ingles rutaseptem_e161ec52:

    # septem "Antes de ir debes ir con cuidado, el espacio comenzará a deformarse."
    septem "Before you go, you must proceed carefully; the space will begin to distort."

# game/rutas/septem.rpy:1063
translate ingles rutaseptem_23f32f3d:

    # septem "Si es mucho para tu marioneta, puedes..."
    septem "If it's too much for your puppet, you can..."

# game/rutas/septem.rpy:1064
translate ingles rutaseptem_2cf4d33d:

    # "Septem lleva sus manos a su halo y extrae uno de sus ojos."
    "Septem brings his hands to his halo and pulls out one of his eyes."

# game/rutas/septem.rpy:1065
translate ingles rutaseptem_b211af50:

    # "¡¿?!"
    "?!?!"

# game/rutas/septem.rpy:1067
translate ingles rutaseptem_f56dc85f:

    # "¿Acaba de... arrancarse un ojo?????"
    "Did he just... tear out an eye?????"

# game/rutas/septem.rpy:1068
translate ingles rutaseptem_e90790db:

    # "Septem lo observa por un momento."
    "Septem watches you for a moment."

# game/rutas/septem.rpy:1069
translate ingles rutaseptem_575e090d:

    # septem "Esto ayudará a calibrar los sentidos."
    septem "This will help recalibrate its senses."

# game/rutas/septem.rpy:1071
translate ingles rutaseptem_10839b17:

    # "Septem te ofrece el ojo como si fuera cualquier cosa."
    "Septem offers you the eye as if it were nothing special."

# game/rutas/septem.rpy:1072
translate ingles rutaseptem_3773e6e5:

    # "{sc=3}¿Nos está... dando un ojo?{/sc}"
    "{sc=3}Is he... giving us an eye?{/sc}"

# game/rutas/septem.rpy:1074
translate ingles rutaseptem_307a9f3a:

    # septem "... No te lo estoy dando para que te lo quedes."
    septem "... I'm not giving it to you so you can keep it."

# game/rutas/septem.rpy:1075
translate ingles rutaseptem_bb4a9394:

    # septem "Tener más de dos Estandartes en un mismo lugar genera caos."
    septem "Having more than two Symbols in one place creates chaos."

# game/rutas/septem.rpy:1076
translate ingles rutaseptem_eabe58b7:

    # septem "Y para un cuerpo mortal, eso es peligroso."
    septem "And for a mortal body, that's dangerous."

# game/rutas/septem.rpy:1078
translate ingles rutaseptem_a15a7c91:

    # "Septem cierra ambos ojos y comienza a recitar mientras hace una señal con la mano desocupada."
    "Septem closes both his eyes and begins to recite while gesturing with his free hand."

# game/rutas/septem.rpy:1079
translate ingles rutaseptem_1f0f88d2:

    # septem "Concedo parte de mi esencia a la marioneta de [nombrejugador] por el periodo que dure la reunión."
    septem "I grant part of my essence to [nombrejugador]'s puppet for the duration of the meeting."

# game/rutas/septem.rpy:1080
translate ingles rutaseptem_cbd2632b:

    # septem "Serás una extensión de mí, y yo seré una extensión de tu marioneta."
    septem "You will be an extension of me, and I will be an extension of your puppet."

# game/rutas/septem.rpy:1081
translate ingles rutaseptem_ffa9ce36:

    # septem "Nos uniremos en un vínculo débil y temporal."
    septem "We will be united in a weak, temporary bond."

# game/rutas/septem.rpy:1082
translate ingles rutaseptem_0fff6aa1:

    # "Septem abre nuevamente los ojos y deja de realizar la seña con su mano."
    "Septem opens his eyes again and stops making the gestures."

# game/rutas/septem.rpy:1083
translate ingles rutaseptem_59ee9de3:

    # septem "Si esto funciona, podremos..."
    septem "If this works, we'll be able to..."

# game/rutas/septem.rpy:1084
translate ingles rutaseptem_dba34e27:

    # "Septem deja de hablar, como si pensara en decir lo que iba a decir o no... sin explicarse más, el ojo es absorbido por tu cuerpo."
    "Septem stops speaking, as if debating whether to continue, and without further explanation, the eye is absorbed by your body."

# game/rutas/septem.rpy:1085
translate ingles rutaseptem_91fbb6a0:

    # "Y..."
    "And..."

# game/rutas/septem.rpy:1086
translate ingles rutaseptem_d0241836:

    # "{sc=3}Siento como algo dentro de mí cambia.{/sc}"
    "{sc=3}I feel something change inside me.{/sc}"

# game/rutas/septem.rpy:1087
translate ingles rutaseptem_8efd0953:

    # "{sc=3}.............{/sc}"
    "{sc=3}.............{/sc}"

# game/rutas/septem.rpy:1088
translate ingles rutaseptem_643274d5:

    # "{sc=3}[nombrejugador]?{/sc}"
    "{sc=3}[nombrejugador]?{/sc}"

# game/rutas/septem.rpy:1089
translate ingles rutaseptem_ad960620:

    # "{sc=3}¿¡[nombrejugador]?! ¿Por qué no te siento?{/sc}"
    "{sc=3}[nombrejugador]?! Why can't I feel you?{/sc}"

# game/rutas/septem.rpy:1090
translate ingles rutaseptem_a2266b14:

    # "{sc=3}Cierro los ojos, intentando buscarte. Pero no estás.{/sc}"
    "{sc=3}I close my eyes, trying to find you. But you're not there.{/sc}"

# game/rutas/septem.rpy:1092
translate ingles rutaseptem_b0c3d53c:

    # septem "¿Qué es esto...?"
    septem "What is this...?"

# game/rutas/septem.rpy:1093
translate ingles rutaseptem_48102f68:

    # "{sc=3}Su voz tiene un tinte de terror en ella... ojala tuviera ese tono de voz siempre.{/sc}"
    "{sc=3}His voice carries a tint of terror... I wish it always had that tone.{/sc}"

# game/rutas/septem.rpy:1096
translate ingles rutaseptem_af0648ac:

    # septem "Eres una extención de {b}él{b}"
    septem "You are an extension of {b}him.{b}"

# game/rutas/septem.rpy:1097
translate ingles rutaseptem_03f53933:

    # septem "¡¿Qué hiciste con [nombrejugador]?!"
    septem "What did you do with [nombrejugador]?!"

# game/rutas/septem.rpy:1099
translate ingles rutaseptem_262e9d0a:

    # "{sc=3}Septem me agarra por los hombros y empieza a apretar fuerte.{/sc}"
    "{sc=3}Septem grabs me by the shoulders and starts squeezing tightly.{/sc}"

# game/rutas/septem.rpy:1100
translate ingles rutaseptem_8e1c1997:

    # "¡{sc=3}Me habla como si fuera mi culpa y no la suya!{/sc}"
    "{sc=3}He talks to me as if it's my fault and not his!{/sc}"

# game/rutas/septem.rpy:1102
translate ingles rutaseptem_628f6c63:

    # "{sc=3}... Lo voy a matar...{/sc}"
    "{sc=3}... I'm going to kill him...{/sc}"

# game/rutas/septem.rpy:1103
translate ingles rutaseptem_1e4adaf1:

    # "{sc=3}¡Lo voy a matar!{/sc}"
    "{sc=3}I'm going to kill him!{/sc}"

# game/rutas/septem.rpy:1105
translate ingles rutaseptem_abf7352f:

    # yo "¡¿De qué hablas?! ¡Es tu culpa!"
    yo "What are you talking about?! It's your fault!"

# game/rutas/septem.rpy:1106
translate ingles rutaseptem_a8756270:

    # yo "¡Tu maldito ojo hizo algo que rompió la conexión entre [nombrejugador] y yo!"
    yo "Your damn eye did something that broke the connection between [nombrejugador] and me!"

# game/rutas/septem.rpy:1107
translate ingles rutaseptem_647e5ce4:

    # yo "¡¡¡Te voy a---!!!!"
    yo "I'm going to--!!!"

# game/rutas/septem.rpy:1109
translate ingles rutaseptem_1ffc38c9:

    # "{sc=3}Me abalanzo sobre él sin pensarlo. Ya nada importa.{/sc}"
    "{sc=3}I lunge at him without thinking. Nothing else matters now.{/sc}"

# game/rutas/septem.rpy:1110
translate ingles rutaseptem_bcd6e5de:

    # "{sc=3}Agarro una de sus alas y tiro de ellas.{/sc}"
    "{sc=3}I grab one of his wings and pull.{/sc}"

# game/rutas/septem.rpy:1111
translate ingles rutaseptem_b1bca8a5:

    # "{sc=3}Y me duele a mí también, pero no me importa.{/sc}"
    "{sc=3}And it hurts me too, but I don't care.{/sc}"

# game/rutas/septem.rpy:1114
translate ingles rutaseptem_372832dc:

    # "{sc=3}Lanzo un puñetazo con la otra mano directo a su estúpida cara.{/sc}"
    "{sc=3}I throw a punch with my other hand straight at his stupid face.{/sc}"

# game/rutas/septem.rpy:1117
translate ingles rutaseptem_e80e0899:

    # "{sc=3}Antes de que mi puño pueda conectar con su mejilla, él me detiene atrapando mi mano con la suya.{/sc}"
    "{sc=3}Before my fist can connect with his cheek, he stops me by grabbing my hand \nwith his.{/sc}"

# game/rutas/septem.rpy:1123
translate ingles rutaseptem_7790d8c5:

    # "{sc=3}Rompiéndome la muñeca con un solo apretón.{/sc}"
    "{sc=3}Breaking my wrist with one squeeze.{/sc}"

# game/rutas/septem.rpy:1124
translate ingles rutaseptem_1efe5ffc:

    # "{sc=3}Duele como mil demonios, y no puedo evitar gritar.{/sc}"
    "{sc=3}It hurts like a thousand demons, and I can't help but scream.{/sc}"

# game/rutas/septem.rpy:1127
translate ingles rutaseptem_926a31dc:

    # "{sc=3}El grito hace que Septem me suelte y me mire con los ojos muy abiertos.{/sc}"
    "{sc=3}The scream makes Septem let go and look at me with wide eyes.{/sc}"

# game/rutas/septem.rpy:1128
translate ingles rutaseptem_3b22bc0a:

    # "{sc=3}Observo el daño provocado en mi mano, está rota."
    "{sc=3}I examine the damage to my hand. It's broken.{/sc}"

# game/rutas/septem.rpy:1129
translate ingles rutaseptem_bd8d5e25:

    # "{sc=3}Y no puedo mover las articulaciones de los dedos...{/sc}"
    "{sc=3}And I can't move the joints in my fingers...{/sc}"

# game/rutas/septem.rpy:1130
translate ingles rutaseptem_e71b6685:

    # "{sc=3}Mi mano.... mi mano ya no sirve....{/sc}"
    "{sc=3}My hand... my hand is no longer functional...{/sc}"

# game/rutas/septem.rpy:1131
translate ingles rutaseptem_b5b85e1e:

    # "{sc=4}¡Ya no soy de utilidad para [nombrejugador] si es que llega a volver!{/sc}"
    "{sc=4}I'm no longer useful to [nombrejugador] if they ever return!{/sc}"

# game/rutas/septem.rpy:1132
translate ingles rutaseptem_c8109a81:

    # "{sc=4}...no puede ser{/sc}"
    "{sc=4}... It can't be.{/sc}"

# game/rutas/septem.rpy:1133
translate ingles rutaseptem_7e0bbd36:

    # "{sc=4}...{/sc}"
    "{sc=4}...{/sc}"

# game/rutas/septem.rpy:1136
translate ingles rutaseptem_1a074e63:

    # septem "Ah..."
    septem "Ah..."

# game/rutas/septem.rpy:1137
translate ingles rutaseptem_52484991:

    # "Septem fija sus ojos en su mano por un momento, para luego mirarme extrañado."
    "Septem fixes his gaze on his hand for a moment, then looks at me in surprise."

# game/rutas/septem.rpy:1138
translate ingles rutaseptem_569c6456:

    # septem "¿Te he hecho daño?"
    septem "Have I hurt you?"

# game/rutas/septem.rpy:1140
translate ingles rutaseptem_87c629ce:

    # "{sc=3}... No sé cómo quiere que le conteste sin una lengua... idiota.{/sc}"
    "{sc=3}... I don't know how he expects me to answer without a tongue... idiot.{/sc}"

# game/rutas/septem.rpy:1142
translate ingles rutaseptem_c88f34a2:

    # yo "¡Claro que sí, imbécil!"
    yo "Of course, you imbecile!"

# game/rutas/septem.rpy:1143
translate ingles rutaseptem_1e9c2586:

    # septem "[nombrejugador] sigue aquí entonces. Eso no debería haberte dañado sin su presencia y ojos."
    septem "[nombrejugador] is still here then. That shouldn't have hurt you without their presence and eyes."

# game/rutas/septem.rpy:1146
translate ingles rutaseptem_2eecb7c2:

    # septem "A ver, mírame."
    septem "Now, look at me."

# game/rutas/septem.rpy:1147
translate ingles rutaseptem_fb6f3f75:

    # "{sc=3}Miro a los ojos a Septem.{/sc}"
    "{sc=3}I look into Septem's eyes.{/sc}"

# game/rutas/septem.rpy:1148
translate ingles rutaseptem_2f169610:

    # "{sc=3}A pesar de que su expresión me intimida y disgusta, no quiero sufrir más daños en mi cuerpo.{/sc}"
    "{sc=3}Even though his expression intimidates and disgusts me, I don't want to \nsuffer any more harm.{/sc}"

# game/rutas/septem.rpy:1151
translate ingles rutaseptem_caf1168d:

    # "{sc=3}Después de unos segundos de una incómoda inspección, Septem sonríe.{/sc}"
    "{sc=3}After a few seconds of uncomfortable inspection, Septem smiles.{/sc}"

# game/rutas/septem.rpy:1154
translate ingles rutaseptem_ad5a21b5:

    # septem "Hmm, tus pupilas siguen blancas... sigues bajo su posesión."
    septem "Hmm, your pupils remain white... you're still under their control."

# game/rutas/septem.rpy:1155
translate ingles rutaseptem_9d9caae5:

    # septem "Parece que solo hemos disminuido su influencia..."
    septem "It seems we've only diminished their influence..."

# game/rutas/septem.rpy:1157
translate ingles rutaseptem_ee96f412:

    # "{sc=4}!!!{/sc}"
    "{sc=4}!!!{/sc}"

# game/rutas/septem.rpy:1158
translate ingles rutaseptem_2e882555:

    # "{sc=3}Eso significa que me vio actuar así...{/sc}"
    "{sc=3}That means they saw me act that way...{/sc}"

# game/rutas/septem.rpy:1159
translate ingles rutaseptem_8756184a:

    # "{sc=3}¡¡¡Qué vergüenza!!!!...{/sc}"
    "{sc=3}How embarrassing!!!!...{/sc}"

# game/rutas/septem.rpy:1161
translate ingles rutaseptem_31924e0f_4:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:1164
translate ingles rutaseptem_48fd589b:

    # septem "No pienso curarte la mano."
    septem "I'm not going to heal your hand."

# game/rutas/septem.rpy:1167
translate ingles rutaseptem_e4b2e5b0:

    # septem "Y no creas que olvidaré esta tremenda ofensa."
    septem "And don't think I'll forget this tremendous offense."

# game/rutas/septem.rpy:1168
translate ingles rutaseptem_9c05a541:

    # "{sc=3}Trago saliva, imaginando las horripilantes torturas que pueda hacerme...{/sc}"
    "{sc=3}I swallow hard, imagining the horrific tortures he could inflict onto me...{/sc}"


# game/rutas/septem.rpy:1169
translate ingles rutaseptem_125c4681:

    # "{sc=3}Y que seguramente hará.{/sc}"
    "{sc=3}And he surely will.{/sc}"

# game/rutas/septem.rpy:1172
translate ingles rutaseptem_5c3436a2:

    # septem "Bien, acompañame."
    septem "Alright, come with me."

# game/rutas/septem.rpy:1173
translate ingles rutaseptem_a48e080c:

    # "{sc=3}Septem se dispone a caminar, sin esperar a confirmar que le sigo o no.{/sc}"
    "{sc=3}Septem begins to walk without waiting to see if I follow him.{/sc}"

# game/rutas/septem.rpy:1174
translate ingles rutaseptem_685acd91:

    # "{sc=3}Suspirando, le sigo. Pero Septem se detiene en seco y voltea a mirarme.{/sc}"
    "{sc=3}Sighing, I follow him. But Septem stops abruptly and turns to look at me.{/sc}"

# game/rutas/septem.rpy:1176
translate ingles rutaseptem_b033c404:

    # septem "Espera. Sería raro que el nuevo Creador tuviera daños en su cuerpo... ellas me preguntarán la razón..."
    septem "Wait. It would be odd for the new Creator to be injured... they will ask me why..."

# game/rutas/septem.rpy:1177
translate ingles rutaseptem_b57439ca:

    # septem "Sextam seguramente molestará hasta saber..."
    septem "Sextam will surely pester until she finds out..."

# game/rutas/septem.rpy:1178
translate ingles rutaseptem_4c8861d0:

    # "{sc=3}¿Me va a curar?{/sc}"
    "{sc=3}Will he heal me?{/sc}"

# game/rutas/septem.rpy:1179
translate ingles rutaseptem_00168553:

    # nj "Hehehehe."
    yo "Hehehehe."

# game/rutas/septem.rpy:1180
translate ingles rutaseptem_69aab108:

    # "{sc=3}No puedo evitar mostrarle una sonrisa engreída.{/sc}"
    "{sc=3}I can't help but flash a smug smile at him.{/sc}"

# game/rutas/septem.rpy:1181
translate ingles rutaseptem_1849b238:

    # "{sc=3}Volveré a ser completamente funcional para [nombrejugador].{/sc}"
    "{sc=3}I'll be fully functional for [nombrejugador] once again.{/sc}"

# game/rutas/septem.rpy:1182
translate ingles rutaseptem_ad46e429:

    # "{sc=3}Ahhh~ Estoy tan feliz~~~{/sc}"
    "{sc=3}Ahhh~ I'm so happy~~~{/sc}"

# game/rutas/septem.rpy:1184
translate ingles rutaseptem_b0962fef:

    # "{sc=3}Septem pone cara de asco, pero no comenta nada.{/sc}"
    "{sc=3}Septem makes a face of disgust, but says nothing.{/sc}"

# game/rutas/septem.rpy:1186
translate ingles rutaseptem_62f1af33:

    # "{sc=3}Y solo se dedica a colocar ambas manos sobre mi mano rota.{/sc}"
    "{sc=3}And he simply places both his hands on my broken hand.{/sc}"

# game/rutas/septem.rpy:1188
translate ingles rutaseptem_c3885609:

    # septem "Abre la boca también."
    septem "Open your mouth, too."

# game/rutas/septem.rpy:1189
translate ingles rutaseptem_042b30f7:

    # "{sc=3}Me retuerzo al escuchar aquello, pero obedezco, bajo la promesa de adquirir otra lengua...{/sc}"
    "{sc=3}I wince at the sound, but obey, clinging to the promise of a new tongue...{/sc}"

# game/rutas/septem.rpy:1192
translate ingles rutaseptem_e2cf3853:

    # "{sc=3}Una sensación extraña recorre mi cuerpo.{/sc}"
    "{sc=3}A strange sensation courses through my body.{/sc}"

# game/rutas/septem.rpy:1193
translate ingles rutaseptem_4e8575f3:

    # "{sc=3}Y puedo sentir que las partes rotas y faltantes están nuevamente en su lugar.{/sc}"
    "{sc=3}And I can feel the broken and missing parts settling back into place.{/sc}"

# game/rutas/septem.rpy:1194
translate ingles rutaseptem_bfcb1369:

    # yo "Graciassss Septem~"
    yo "Thankssss, Septem~"

# game/rutas/septem.rpy:1196
translate ingles rutaseptem_20634858:

    # "{sc=3}La cara de Septem sigue siendo de disgusto. Da risa.{/sc}"
    "{sc=3}Septem's expression remains one of disgust. It's laughable.{/sc}"

# game/rutas/septem.rpy:1198
translate ingles rutaseptem_306e45aa:

    # "{sc=3}Pero se borra al intante, como si recordara algo.{/sc}"
    "{sc=3}But it fades instantly, as if he remembered something.{/sc}"

# game/rutas/septem.rpy:1199
translate ingles rutaseptem_2b23e184:

    # "{sc=3}Y en su expresión se pinta una sonrisa que no muestra dientes.{/sc}"
    "{sc=3}And his face softens into a smile that reveals no teeth.{/sc}"

# game/rutas/septem.rpy:1201
translate ingles rutaseptem_9619f359:

    # "{sc=3}Coloca una de sus manos sobre mi hombro para darme 3 palmadas suaves.{/sc}"
    "{sc=3}He places one hand on my shoulder to give me three gentle pats.{/sc}"

# game/rutas/septem.rpy:1202
translate ingles rutaseptem_0f5ab6ab:

    # septem "Tómalo como una nueva oportunidad para volver a romperte desde cero."
    septem "Take it as a new opportunity to be broken from scratch."

# game/rutas/septem.rpy:1203
translate ingles rutaseptem_5e861e03:

    # septem "Y creéme, terminará sucediendo en algún momento, después de todo... [nombrejugador] es una entidad curiosa."
    septem "And believe me, it will eventually happen... after all, [nombrejugador] is a curious entity."

# game/rutas/septem.rpy:1204
translate ingles rutaseptem_67c38907:

    # septem "... puede que hasta guste de leer eso. Quién sabe."
    septem "... maybe they'll even enjoy reading that. Who knows."

# game/rutas/septem.rpy:1206
translate ingles rutaseptem_b33e0489:

    # septem "Total, quien se ve afectado no es [nombrejugador]."
    septem "After all, [nombrejugador] isn't the one affected."

# game/rutas/septem.rpy:1207
translate ingles rutaseptem_786cfd05:

    # "{sc=3}... es verdad...{/sc}"
    "{sc=3}... It's true...{/sc}"

# game/rutas/septem.rpy:1208
translate ingles rutaseptem_86c39ea8:

    # "{sc=3}...{/sc}"
    "{sc=3}...{/sc}"

# game/rutas/septem.rpy:1209
translate ingles rutaseptem_02a44f7b:

    # "{sc=3}Caminamos en silencio luego de eso.{/sc}"
    "{sc=3}We walk in silence after that.{/sc}"

# game/rutas/septem.rpy:1210
translate ingles rutaseptem_b1183bcf:

    # "{sc=3}La caminata es larga, donde cada uno de nuestros pasos se escucha en todo el lugar.{/sc}"
    "{sc=3}The walk is long, with each of our steps echoing throughout the space.{/sc}"

# game/rutas/septem.rpy:1211
translate ingles rutaseptem_d70ef2db:

    # "{sc=3}El sonido de los pasos rebota en las paredes como un eco que nos persigue.{/sc}"
    "{sc=3}The sound of our steps bounces off the walls like an echo that follows us.{/sc}"

# game/rutas/septem.rpy:1212
translate ingles rutaseptem_afdb5238:

    # "{sc=3}Llegamos a una puerta gigante, que no tarda mucho en aberse para darles el paso.{/sc}"
    "{sc=3}We arrive at a giant door, which quickly opens to let us through.{/sc}"

# game/rutas/septem.rpy:1214
translate ingles rutaseptem_72b0877a:

    # "{sc=3}El espacio dentro de la puerta es extraño.{/sc}"
    "{sc=3}The space inside the door is strange.{/sc}"

# game/rutas/septem.rpy:1215
translate ingles rutaseptem_dbae87a0:

    # "{sc=3}Oscuro e inquetante, no un oscuro como el vacío de Nulla.{/sc}"
    "{sc=3}Dark and unsettling, not like Nulla's void.{/sc}"

# game/rutas/septem.rpy:1216
translate ingles rutaseptem_8d0f58c4:

    # "{sc=3}Me recuerda a la noche, llena de estrellas que aparecen y desaparecen.{/sc}"
    "{sc=3}It reminds me of the night, full of stars that appear and disappear.{/sc}"

# game/rutas/septem.rpy:1218
translate ingles rutaseptem_473902ad:

    # "En la sala hay 4 figuras, las que están más cerca de nosotros se encuentran conversando como si nada que no sean ellas importara."
    "In the room, there are four figures. The ones closest to us are engaged in conversation as if nothing else mattered."

# game/rutas/septem.rpy:1219
translate ingles rutaseptem_92c0af58:

    # "Están muy cerca la una de la otra, supongo que deben tener algún tipo de relación."
    "They are very close to each other; I suppose they must have some sort of relationship."

# game/rutas/septem.rpy:1220
translate ingles rutaseptem_18002931:

    # "Están apunto de juntar sus labios cuando Septem se hace notar, dando un paso dentro de la sala, y ambas entidades miran curiosas."
    "They are about to press their lips together when Septem makes his presence known by stepping into the room, and both entities look on curiously."

# game/rutas/septem.rpy:1221
translate ingles rutaseptem_c8d20897:

    # "Septem ríe con algo que se asemeja a la ternura, y es extraño."
    "Septem laughs with a hint of tenderness, and it's strange."

# game/rutas/septem.rpy:1223
translate ingles rutaseptem_17bf2701:

    # septem "Duae, no bajes la guardia."
    septem "Duae, don't let your guard down."

# game/rutas/septem.rpy:1224
translate ingles rutaseptem_6cc122fe:

    # duae "Septem..."
    duae "Septem..."

# game/rutas/septem.rpy:1225
translate ingles rutaseptem_22a1999b:

    # "{sc=3}La voz se escucha en toda el espacio...{/sc}"
    "{sc=3}The voice resonates throughout the entire space...{/sc}"

# game/rutas/septem.rpy:1226
translate ingles rutaseptem_14c4bb16:

    # "{sc=3}Luego, las entidades posan sus ojos en mí, como si fuera un bicho raro...{/sc}"
    "{sc=3}Then, the entities fix their eyes on me, as if I were some kind of freak...{/sc}"

# game/rutas/septem.rpy:1227
translate ingles rutaseptem_9e3278c2:

    # "{sc=3}No... me observan como si fuera la atracción principal de un circo.{/sc}"
    "{sc=3}No... they watch me as if I were the main attraction of a circus.{/sc}"

# game/rutas/septem.rpy:1228
translate ingles rutaseptem_bb84a428:

    # "{sc=3}Genial...{/sc}"
    "{sc=3}Great...{/sc}"

# game/rutas/septem.rpy:1229
translate ingles rutaseptem_5ffbed31:

    # "{sc=3}La primera en acercarse en una entidad de tres cabeza.{/sc}"
    "{sc=3}The first is a three-headed entity approaching.{/sc}"

# game/rutas/septem.rpy:1230
translate ingles rutaseptem_6a1b2893:

    # "{sc=3}Y de cerca le sigue la entidad cubierta de una túnica roja.{/sc}"
    "{sc=3}And closely behind follows an entity draped in a red robe.{/sc}"

# game/rutas/septem.rpy:1231
translate ingles rutaseptem_ecb1f31d:

    # "{sc=3}La otra al darse cuenta de ello, ríe y le toma la mano.{/sc}"
    "{sc=3}The other, noticing this, laughs and takes her hand.{/sc}"

# game/rutas/septem.rpy:1232
translate ingles rutaseptem_91b66b77:

    # el "No estés tan tensa, Duae."
    el "Don't be so tense, Duae."

# game/rutas/septem.rpy:1234
translate ingles rutaseptem_0d0e6893:

    # "{sc=3}Ambas llegan a nosotros y saludan a Septem, de manera respetuosa.{/sc}"
    "{sc=3}Both approach us and greet Septem respectfully.{/sc}"

# game/rutas/septem.rpy:1235
translate ingles rutaseptem_9d16cef8:

    # "{sc=3}Bajando la mirada y levemente la cabeza...{/sc}"
    "{sc=3}With lowered eyes and a slight bow of the head...{/sc}"

# game/rutas/septem.rpy:1236
translate ingles rutaseptem_deb9f766:

    # "{sc=3}Horrible, ¡esta cosa no mecere el respeto de nadie!{/sc}"
    "{sc=3}Horrible, this thing doesn't deserve anyone's respect!{/sc}"

# game/rutas/septem.rpy:1237
translate ingles rutaseptem_951becb1:

    # "{sc=3}Luego me miran a mí...{/sc}"
    "{sc=3}Then they look at me...{/sc}"

# game/rutas/septem.rpy:1238
translate ingles rutaseptem_14558ff2:

    # "{sc=3}Y me miran con la misma devoción y respeto con el que miraron a Septem.{/sc}"
    "{sc=3}And they gaze at me with the same devotion and respect as they did at Septem.{/sc}"

# game/rutas/septem.rpy:1239
translate ingles rutaseptem_4096fa3b:

    # "{sc=3}No me gusta.{/sc}"
    "{sc=3}I don't like it.{/sc}"

# game/rutas/septem.rpy:1240
translate ingles rutaseptem_fcee962e:

    # el "Tú eres [nombrejugador]."
    el "You are [nombrejugador]."


# game/rutas/septem.rpy:1241
translate ingles rutaseptem_1f5d9c14_1:

    # nj "Sí."
    nj "Yes."

# game/rutas/septem.rpy:1242
translate ingles rutaseptem_5aa08e25:

    # "{sc=3}Respondo con la mayor confianza que tengo.{/sc}"
    "{sc=3}I answer with all the confidence I have.{/sc}"

# game/rutas/septem.rpy:1243
translate ingles rutaseptem_8b9d71d9:

    # el "Muchas gracias por lo que estás haciendo... jamás pensamos que seríamos escuchados por otro ser tan poderoso como tú."
    el "Thank you so much for what you're doing... we never thought we'd be heard by another being as powerful as you."

# game/rutas/septem.rpy:1244
translate ingles rutaseptem_6618d122:

    # "{sc=3}Antes de poder responder, Septem abre la boca.{/sc}"
    "{sc=3}Before I can answer, Septem opens his mouth.{/sc}"

# game/rutas/septem.rpy:1245
translate ingles rutaseptem_8cd03ed2:

    # septem "Este Creador no es muy comunicativo."
    septem "This Creator isn't very communicative."

# game/rutas/septem.rpy:1246
translate ingles rutaseptem_03a82a90:

    # "{sc=3}Dice mientras me mira con ojos afilados.{/sc}"
    "{sc=3}He says while looking at me with piercing eyes.{/sc}"

# game/rutas/septem.rpy:1247
translate ingles rutaseptem_5a2144af:

    # "{sc=3}Okay, entiendo la indirecta... maldito.{/sc}"
    "{sc=3}Okay, I get the hint... damn it.{/sc}"

# game/rutas/septem.rpy:1248
translate ingles rutaseptem_da85993c:

    # el "Como el anterior, ja~"
    el "Just like the previous one, ha~"

# game/rutas/septem.rpy:1249
translate ingles rutaseptem_31924e0f_5:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:1250
translate ingles rutaseptem_e62e07d6:

    # septem "Ellas son Duae y Quattor, el firmamento y la luna."
    septem "They are Duae and Quattor, the firmament and the moon."

# game/rutas/septem.rpy:1251
translate ingles rutaseptem_217dbbc9:

    # "{sc=3}Ah, las reconozco, ellas son las de los recuerdos de Septem.{/sc}"
    "{sc=3}Ah, I recognize them; they're from Septem's memories.{/sc}"

# game/rutas/septem.rpy:1252
translate ingles rutaseptem_eba95c30:

    # "{sc=3}Entonces las que se encuentran en la mesa deben ser Sextam y Tria.{/sc}"
    "{sc=3}Then the ones at the table must be Sextam and Tria.{/sc}"

# game/rutas/septem.rpy:1253
translate ingles rutaseptem_ac5b1fa4:

    # sextam "¡No se queden ahí, vengan!"
    sextam "Don't just stand there, come on!"

# game/rutas/septem.rpy:1254
translate ingles rutaseptem_84170f67:

    # sextam "He preparado té."
    sextam "I've prepared tea."

# game/rutas/septem.rpy:1255
translate ingles rutaseptem_1baa0823:

    # "{sc=3}Septem camina directo a la mesa luego del llamado de Sextam. {/sc}"
    "{sc=3}Septem walks straight to the table after Sextam's call.{/sc}"

# game/rutas/septem.rpy:1256
translate ingles rutaseptem_39ad38ca:

    # "{sc=3}Y las otras dos también le siguen, como dos patitos siguiendo a su madre...{/sc}"
    "{sc=3}And the other two follow him too, like little ducklings following their mother...{/sc}"

# game/rutas/septem.rpy:1257
translate ingles rutaseptem_5b362532:

    # "{sc=3}Ahgg, si estuvieras aquí,[nombrejugador], todo sería más fácil.{/sc}"
    "{sc=3}Ah, if you were here, [nombrejugador], everything would be so much easier.{/sc}"

# game/rutas/septem.rpy:1258
translate ingles rutaseptem_a20cefa7_16:

    # "..."
    "..."

# game/rutas/septem.rpy:1260
translate ingles rutaseptem_57bbc157:

    # "{sc=3}Nos sentamos en la mesa, la cual tiene todo tipo de alimentos, dulces y salados.{/sc}"
    "{sc=3}We sit at the table, which is laden with all kinds of foods, both sweet and savory.{/sc}"

# game/rutas/septem.rpy:1261
translate ingles rutaseptem_56c2048f:

    # "{sc=3}sin embargo, nadie come a excepción de Septem.{/sc}"
    "{sc=3}However, no one eats except for Septem.{/sc}"

# game/rutas/septem.rpy:1262
translate ingles rutaseptem_968109ab:

    # "{sc=3}Las demás entidades se presentan, aunque, hay un cambio extraño en Sextam.{/sc}"
    "{sc=3}The other entities introduce themselves, though there's something odd about Sextam.{/sc}"

# game/rutas/septem.rpy:1263
translate ingles rutaseptem_b6466e51:

    # "{sc=3}Sus ojos están pegados a los míos, siguiendo cada movimiento.{/sc}"
    "{sc=3}Her eyes are fixed on mine, following my every move.{/sc}"

# game/rutas/septem.rpy:1264
translate ingles rutaseptem_42fccd3b:

    # "{sc=3}Pero intento ignorarlo.{/sc}"
    "{sc=3}But I try to ignore it.{/sc}"

# game/rutas/septem.rpy:1265
translate ingles rutaseptem_de090796:

    # "{sc=3}sonríe y mantente en silencio...{/sc}"
    "{sc=3}Smile and keep silent...{/sc}"

# game/rutas/septem.rpy:1266
translate ingles rutaseptem_ed54fc2b:

    # "{sc=3}Eso es lo que Septem quiere para no ser atrapados en esta mentira.{/sc}"
    "{sc=3}That's what Septem wants so that we won't be caught in this lie.{/sc}"

# game/rutas/septem.rpy:1267
translate ingles rutaseptem_ad82d0c5:

    # "{sc=3}Y así podré recuperar a [nombrejugador], después de esta reunión.{/sc}"
    "{sc=3}And that way, I'll be able to recover [nombrejugador] after this meeting.{/sc}"

# game/rutas/septem.rpy:1268
translate ingles rutaseptem_86c39ea8_1:

    # "{sc=3}...{/sc}"
    "{sc=3}...{/sc}"

# game/rutas/septem.rpy:1269
translate ingles rutaseptem_61e252fd:

    # "{sc=3}Las entidades hablan de trivialidades que no me son importantes ni quiero escuchar.{/sc}"
    "{sc=3}The entities talk about trivialities that don't matter to me and I don't want to hear.{/sc}"

# game/rutas/septem.rpy:1270
translate ingles rutaseptem_f74635e8:

    # "{sc=3}Pero podemos resumirlo en que le cuentan lo que han estado haciendo a Septem.{/sc}"
    "{sc=3}But it can be summed up as them telling Septem what they've been up to.{/sc}"

# game/rutas/septem.rpy:1271
translate ingles rutaseptem_464b863b:

    # "{sc=3}Quien muy a mi pesar, las escucha atentamente y les contesta de manera animada...{/sc}"
    "{sc=3}Much to my dismay, he listens attentively and responds energetically...{/sc}"

# game/rutas/septem.rpy:1272
translate ingles rutaseptem_5369a343:

    # "{sc=3}y sin pisca de comentarios pasivo agresivos...{/sc}"
    "{sc=3}... and without any passive-aggressive remarks...{/sc}"

# game/rutas/septem.rpy:1273
translate ingles rutaseptem_663d4288:

    # "{sc=3}Increíble. Hasta su aura parece haber cambiado.{/sc}"
    "{sc=3}Incredible. Even his aura seems to have changed.{/sc}"

# game/rutas/septem.rpy:1274
translate ingles rutaseptem_d2fae489:

    # "{sc=3}A pesar se seguir teniendo su cara angelical, este Septem no es el que yo conozco.{/sc}"
    "{sc=3}Though he still has that angelic face, this Septem is not the one I know.{/sc}"

# game/rutas/septem.rpy:1275
translate ingles rutaseptem_07d22e79:

    # "{sc=3}¿Quien es este ser benevolente y que le hizo al Septem original?{/sc}"
    "{sc=3}Who is this benevolent being, and what did he do to the original Septem?{/sc}"

# game/rutas/septem.rpy:1276
translate ingles rutaseptem_6e398176:

    # "{sc=3}Me da tanta grima que hasta deseo de vuelta al Septem que conozco.{/sc}"
    "{sc=3}This facade disgusts me so much that I long for the Septem I once knew.{/sc}"

# game/rutas/septem.rpy:1277
translate ingles rutaseptem_25b7f06b:

    # duae "Sinceramente, pensé que todos terminaríamos locos antes de volver a la normalidad."
    duae "Honestly, I thought we'd all go crazy before returning to normal."

# game/rutas/septem.rpy:1278
translate ingles rutaseptem_7fbd3bf9:

    # septem "Que no tengas fe en mí me duele..."
    septem "It hurts that you don't have faith in me..."

# game/rutas/septem.rpy:1279
translate ingles rutaseptem_4a003f79:

    # duae "No es eso... sé que la situación se te escapa de las manos..."
    duae "It's not that... I know the situation is getting out of your hands..."

# game/rutas/septem.rpy:1280
translate ingles rutaseptem_c519f961:

    # "{sc=3}Comenta Duae algo incomoda.{/sc}"
    "{sc=3}Duae makes an awkward comment.{/sc}"

# game/rutas/septem.rpy:1281
translate ingles rutaseptem_31924e0f_6:

    # septem "..."
    septem "..."

# game/rutas/septem.rpy:1282
translate ingles rutaseptem_7992f565:

    # duae "Me alegra que hayas podido encontrar a otro Creador. Creo que nuestros rezos de medianoche si dieron frutos."
    duae "I'm glad you managed to find another Creator. I think our midnight prayers really paid off."

# game/rutas/septem.rpy:1283
translate ingles rutaseptem_8e14bdf7:

    # duae "Espero que este sea más responsable."
    duae "I hope this one is more responsible."

# game/rutas/septem.rpy:1284
translate ingles rutaseptem_d9b370c6:

    # septem "Lo será."
    septem "They will be."

# game/rutas/septem.rpy:1285
translate ingles rutaseptem_dbf87e88:

    # tria "¿Cuándo podrá devolver la potestad de Sextam para crear humanos?"
    tria "When will Sextam be able to regain the power to create humans?"

# game/rutas/septem.rpy:1286
translate ingles rutaseptem_672b290b:

    # septem "Tengo que realizar unos preparativos antes."
    septem "I have to make some preparations first."

# game/rutas/septem.rpy:1287
translate ingles rutaseptem_84d4845f:

    # septem "¿No te molesta eso, cierto Sextam?"
    septem "That doesn't bother you, does it, Sextam?"

# game/rutas/septem.rpy:1288
translate ingles rutaseptem_57945901:

    # "{sc=3}Sextam no responde, su mirada sigue puesta en mí... que miedo.{/sc}"
    "{sc=3}Sextam doesn't respond; her gaze remains fixed on me... how frightening.{/sc}"

# game/rutas/septem.rpy:1289
translate ingles rutaseptem_820ec318:

    # septem "¿Sextam?"
    septem "Sextam?"

# game/rutas/septem.rpy:1290
translate ingles rutaseptem_8c344b46:

    # sextam "Ah."
    sextam "Ah."

# game/rutas/septem.rpy:1291
translate ingles rutaseptem_f03e11e9:

    # "{sc=3}Sextam parpadea un par de veces antes de clavar sus ojos en Septem.{/sc}"
    "{sc=3}Sextam blinks a couple of times before fixing her gaze on Septem.{/sc}"

# game/rutas/septem.rpy:1292
translate ingles rutaseptem_16f20889:

    # sextam "Claro que no, Septem."
    sextam "Of course not, Septem."

# game/rutas/septem.rpy:1293
translate ingles rutaseptem_babc7de4:

    # sextam "No me gustaría apurarte y poner en riesgo la vinculación de su santidad [nombrejugador] con el Jardín."
    sextam "I wouldn't want to rush you and jeopardize [nombrejugador]'s sacred bond with the Garden."

# game/rutas/septem.rpy:1294
translate ingles rutaseptem_62c8cba1:

    # "{sc=3}... no me gusta esta entidad.{/sc}"
    "{sc=3}... I don't like this entity.{/sc}"

# game/rutas/septem.rpy:1295
translate ingles rutaseptem_8553271f:

