    new "Accept him."

    # game/rutas/unum.rpy:2307
    old "¿Puedes hacerles daño?"
    new "Can you hurt them?"

    # game/rutas/unum.rpy:2342
    old "¿Mucho trabajo?"
    new "A lot of work?"

    # game/rutas/unum.rpy:2391
    old "Guardar un poco de comida para Noor."
    new "Save some food for Noor."

    # game/rutas/unum.rpy:2434
    old "No tomar nada."
    new "Don't take anything."

    # game/rutas/unum.rpy:2531
    old "Hablar y decirle que debe comer."
    new "Talk to him and tell him he needs to eat."

    # game/rutas/unum.rpy:2553
    old "{glitch=30.0}{color=ffffff}{b}Decir su nombre original: Sirius{b}{/color}"
    new "{glitch=30.0}{color=ffffff}{b}Say his original name: Sirius.{b}{/color}"

    # game/rutas/unum.rpy:2600
    old "Hablar con Noor."
    new "Talk to Noor."

    # game/rutas/unum.rpy:2632
    old "Comandarle que coma sin restricciones."
    new "Command him to eat without restrictions."

    # game/rutas/unum.rpy:2654
    old "Intentar calmarte y escucharlo."
    new "Try to calm down and listen to him."

    # game/rutas/unum.rpy:2828
    old "¿Eso es bueno?"
    new "Is that good?"

    # game/rutas/unum.rpy:2831
    old "¿Eso es malo?"
    new "Is that bad?"

    # game/rutas/unum.rpy:2865
    old "Explicar que querías verlas."
    new "Explain that you wanted to see them."

    # game/rutas/unum.rpy:2868
    old "Saludarlas."
    new "Greet them."

    # game/rutas/unum.rpy:2909
    old "¿Vieron la muerte de estrellas?"
    new "Did you watch stars die?"

