# game/rutas/unum.rpy:10
translate ingles rutaunum2_a20cefa7:

    # "..."
    "..."

# game/rutas/unum.rpy:12
translate ingles rutaunum2_b720caa8:

    # "El aumento de la temperatura es lo que te despierta."
    "The increase in temperature is what wakes you up."

# game/rutas/unum.rpy:13
translate ingles rutaunum2_114b14ef:

    # "Sientes como una gota gorda de sudor te recorre la frente."
    "You feel a thick drop of sweat running down your forehead."

# game/rutas/unum.rpy:14
translate ingles rutaunum2_fc93ae33:

    # "... pero quieres volver nuevamente a dormir, estás muy cansado."
    "... But you want to go back to sleep again, you're very tired."

# game/rutas/unum.rpy:15
translate ingles rutaunum2_6bf00144:

    # el "Deberías agradecer que la biología de esta cosa y los míos son muy parecidas..."
    el "You should be grateful that this thing's biology and mine are very similar..."

# game/rutas/unum.rpy:16
translate ingles rutaunum2_269d2bd7:

    # unum "¿Ya lo has hecho más veces?"
    unum "Have you done this before?"

# game/rutas/unum.rpy:17
translate ingles rutaunum2_813206b4:

    # el "Claro. No puedo estar en todos lados a la vez, siempre existe la posibilidad de que alguno de mis niños coma una fruta que faltó por santificar."
    el "Of course. I can't be everywhere at once; there's always the chance that one of my children might eat a fruit that wasn't sanctified."

# game/rutas/unum.rpy:19
translate ingles rutaunum2_f61cbec8:

    # "Abres los ojos para ver que está pasando, pero la luz es muy brillante."
    "You open your eyes to see what's happening, but the light is too bright."

# game/rutas/unum.rpy:20
translate ingles rutaunum2_4d8c62b2:

    # unum "¡OH! ¡Quinque, está funcionando!"
    unum "OH! Quinque, it's working!"

# game/rutas/unum.rpy:21
translate ingles rutaunum2_78c5ba34:

    # "Unum dice como si no se lo creyera. Quinque chasquea la lengua, exasperado."
    "Unum says it as if he can't believe it. Quinque clicks his tongue, exasperated."

# game/rutas/unum.rpy:23
translate ingles rutaunum2_3ce9a3e0:

    # quinque "¡No grites! aún falta sacar la rosa principal."
    quinque "Don't shout! We still need to extract the main rose."

# game/rutas/unum.rpy:24
translate ingles rutaunum2_4bde8eab:

    # "Una sensación extraña se forma en la piel que recubre tu vientre. Hay algo que se abre paso desde tu estómago hacía arriba con urgencia, no duele pero se siente molesto."
    "A strange sensation forms on the skin covering your abdomen. Something is pushing its way up from your stomach with urgency; it doesn't hurt, but it feels uncomfortable."

# game/rutas/unum.rpy:25
translate ingles rutaunum2_7f820265:

    # quinque "Escúpelo aquí."
    quinque "Spit it out here."

# game/rutas/unum.rpy:27
translate ingles rutaunum2_931d64a2:

    # "Tu vista se ve invadida por una mano que espera con la palma abierta algo."
    "Your vision is filled by a hand waiting with an open palm for something."

# game/rutas/unum.rpy:28
translate ingles rutaunum2_224a4607:

    # "Y ese algo no tarda en llegar, pues de tu boca expulsas una rosa en perfecto estado."
    "And that something doesn't take long to arrive, as you throw up a perfectly intact rose from your mouth."

# game/rutas/unum.rpy:29
translate ingles rutaunum2_081174ed:

    # "Es asqueroso, pero a juzgar por la cara de Quinque, el no piensa lo mismo... es más, se le ve completamente indiferente, le da igual tener en su mano una rosa llena de saliva y jugos gástricos."
    "It's disgusting, but judging by Quinque's face, he doesn't think the same... In fact, he looks completely indifferent, as if he doesn't care about holding a rose covered in saliva and gastric juices."

# game/rutas/unum.rpy:30
translate ingles rutaunum2_4d38ca30:

    # "Cómo si ya lo hubiera hecho un montón de veces."
    "As if he had done this countless times before."

# game/rutas/unum.rpy:31
translate ingles rutaunum2_667f031e:

    # quinque "Es exactamente lo mismo..."
    quinque "It's exactly the same..."

# game/rutas/unum.rpy:32
translate ingles rutaunum2_f7192d1e:

    # quinque "Realmente no entiendo la diferente entre los míos y los de Sextam."
    quinque "I really don't understand the difference between mine and Sextam's."

# game/rutas/unum.rpy:33
translate ingles rutaunum2_c46ffdc7:

    # quinque "Su biología es muy parecida..."
    quinque "Their biology is very similar..."

# game/rutas/unum.rpy:34
translate ingles rutaunum2_78900649:

    # unum "Los tuyos no piensan."
    unum "Yours don't think."

# game/rutas/unum.rpy:35
translate ingles rutaunum2_caed5748:

    # "Contesta Unum con gracia."
    "Unum replies playfully."

# game/rutas/unum.rpy:36
translate ingles rutaunum2_858abff8:

    # quinque "¡El que no piensa eres tú!"
    quinque "You're the one who doesn't think!"

# game/rutas/unum.rpy:38
translate ingles rutaunum2_d3fdeb0a:

    # "Quinque se levanta con rapidez para agarrar a Unum de sus ropas. El pelirrojo solo rie, restando importancia al enojo de Quinque."
    "Quinque quickly stands up and grabs Unum by his clothes. The redhead just laughs, downplaying Quinque's anger."

# game/rutas/unum.rpy:39
translate ingles rutaunum2_70acde1e:

    # quinque "Te vuelvo a escuchar decir eso una vez más y juro que rompo ese hibrido que tienes guardado."
    quinque "If I hear you say that one more time, I swear I'll break that hybrid you're hiding."

# game/rutas/unum.rpy:41
translate ingles rutaunum2_3c774f43:

    # "Su sonrisa se desvanece por completo, optando por mirar hacia abajo a Quinque, completamente serio."
    "His smile vanishes completely as he looks down at Quinque, utterly serious."

# game/rutas/unum.rpy:42
translate ingles rutaunum2_5083a61f:

    # unum "¿Ah? ¿Y tú cómo sabes eso?"
    unum "Huh? And how do you know about them?"

# game/rutas/unum.rpy:43
translate ingles rutaunum2_eaf6b939:

    # quinque "Escucho otro corazón además de el que tiene este humano."
    quinque "I can hear another heartbeat besides this human's."

# game/rutas/unum.rpy:44
translate ingles rutaunum2_387636ff:

    # unum "Hmmm."
    unum "Hmmm."

# game/rutas/unum.rpy:45
translate ingles rutaunum2_9efc825a:

    # "Unum no se mueve mientras mira fijamente a Quinque."
    "Unum remains still, staring intently at Quinque."

# game/rutas/unum.rpy:47
translate ingles rutaunum2_11725d59:

    # "Ya sea por la dificultad de sostener la mirada al sol o por simple incomodidad, Quinque chasquea la lengua, soltando y empujándolo."
    "Whether due to the difficulty of holding his gaze against the Sun or simple discomfort, Quinque clicks his tongue, letting go and pushing him away."

# game/rutas/unum.rpy:49
translate ingles rutaunum2_20726a14:

    # unum "Supongo que ya Septem les ha dicho que seré yo quien hará el cambio."
    unum "I suppose Septem has already told you that I'll be the one making the change."

# game/rutas/unum.rpy:51
translate ingles rutaunum2_ade8bcb2:

    # quinque "Sí."
    quinque "Yes."

# game/rutas/unum.rpy:52
translate ingles rutaunum2_51edbd0e:

    # unum "Entonces..."
    unum "Then..."

# game/rutas/unum.rpy:55
translate ingles rutaunum2_1c9a8b6a:

    # "Unum vuelve a sonreir."
    "Unum smiles again."

# game/rutas/unum.rpy:58
translate ingles rutaunum2_c81ebfce:

    # unum "¿Lo quieres ver?"
    unum "Do you want to see them?"

# game/rutas/unum.rpy:59
translate ingles rutaunum2_b5293d8d:

    # quinque "No gracias. Volveré a mi dominio."
    quinque "No, thanks. I'll return to my domain."

# game/rutas/unum.rpy:60
translate ingles rutaunum2_bf806542:

    # quinque "Si necesitas ayuda en cualquier situación que desconozcas, puedes llamarme a mi o a Sextam."
    quinque "If you need help in any unfamiliar situation, you can call me or Sextam."

# game/rutas/unum.rpy:61
translate ingles rutaunum2_d9b6a9b0:

    # quinque "Todos estamos al tanto."
    quinque "We are all aware about this..."

# game/rutas/unum.rpy:64
translate ingles rutaunum2_0839915a:

    # "Sin más, Quinque se retira de la habitación."
    "Without another word, Quinque leaves the room."

# game/rutas/unum.rpy:65
translate ingles rutaunum2_dbcb4977:

    # "Unum se queda por un momento pensativo, para luego dedicarte una mirada complice."
    "Unum remains thoughtful for a moment before giving you a knowing look."

# game/rutas/unum.rpy:67
translate ingles rutaunum2_11ad6c39:

    # unum "Ahora viene lo difícil. Cultivar a un dios."
    unum "Now comes the hard part. Cultivating a god."

# game/rutas/unum.rpy:70
translate ingles rutaunum2_dfea04e0:

    # unum "Tenemos que cultivar a este dios hasta que esté completamente listo."
    unum "We have to cultivate this god until it's completely ready."

# game/rutas/unum.rpy:75
translate ingles rutaunum2_c17099d3:

    # unum "¿No es así cómo se dice?"
    unum "Isn't that how you say it?"

# game/rutas/unum.rpy:76
translate ingles rutaunum2_11a870c1:

    # nj "¿Que cosa?"
    nj "Say what?"

# game/rutas/unum.rpy:77
translate ingles rutaunum2_ffa87e1d:

    # unum "Cuando tienes que cuidar algo hasta que esté listo."
    unum "When you have to take care of something until it's ready."

# game/rutas/unum.rpy:78
translate ingles rutaunum2_b915d907:

    # nj "Eso es criar..."
    nj "That's called raising..."

# game/rutas/unum.rpy:81
translate ingles rutaunum2_24d674e0:

    # unum "¡Perfecto! vamos a criar a un dios."
    unum "Perfect! Let's raise a god."

# game/rutas/unum.rpy:85
translate ingles rutaunum2_fad6d44c:

    # unum "Pero voy a necesitar tu ayuda..."
    unum "But I'm going to need your help..."

# game/rutas/unum.rpy:88
translate ingles rutaunum2_7a7c9e9f:

    # unum "Sigo sin entender cómo la vida orgánica pasa por cambios que le permiten crecer y mejorar."
    unum "I still don't understand how organic life goes through changes that allow it to grow and improve."

# game/rutas/unum.rpy:89
translate ingles rutaunum2_26ce0663:

    # unum "Nunca lo he visto por mi mismo..."
    unum "I've never seen it for myself..."

# game/rutas/unum.rpy:92
translate ingles rutaunum2_57d24dec:

    # unum "Así que supongo que tú sabes un poco más de esto..."
    unum "So I suppose you know a little more about this..."

# game/rutas/unum.rpy:93
translate ingles rutaunum2_07605984:

    # "Harás lo que sea necesario para salvarte el pellejo, y si eso requiere jugar a la familia feliz con el dios del sol, lo harás sin dudarlo."
    "You'll do whatever it takes to save your skin, and if that means playing happy family with the Sun god, you'll do it without hesitation."

# game/rutas/unum.rpy:98
translate ingles rutaunum2_25cea9cd:

    # "Unum sonríe sin mostrar los dientes."
    "Unum smiles without showing his teeth."

# game/rutas/unum.rpy:99
translate ingles rutaunum2_64b3b407:

    # "Su expresión es tierna, nada parecida a las miradas que te ha dedicado en el pasado."
    "His expression is tender, nothing like the looks he used to give you."

# game/rutas/unum.rpy:104
translate ingles rutaunum2_89abb2ff:

    # unum "Oh."
    unum "Oh."

# game/rutas/unum.rpy:105
translate ingles rutaunum2_ab081901:

    # unum "No te preocupes."
    unum "Don't worry."

# game/rutas/unum.rpy:106
translate ingles rutaunum2_6e3ff3d7:

    # unum "Ambos nos apoyaremos con esto."
    unum "We'll both support each other with this."

# game/rutas/unum.rpy:107
translate ingles rutaunum2_ac7d9b71:

    # unum "Despues de todo, este dios no es ni humano ni un Estandarte completamente."
    unum "After all, this god is neither completely human nor entirely a Symbol."

# game/rutas/unum.rpy:110
translate ingles rutaunum2_4a628198:

    # unum "¡Será lo mejor de dos mundos!"
    unum "It will be the best of both worlds!"

# game/rutas/unum.rpy:113
translate ingles rutaunum2_27fbc9be:

    # "El día pasa."
    "The day passes quickly."

# game/rutas/unum.rpy:115
translate ingles rutaunum2_47ac5640:

    # "E increíblemente te encuentras acompañado por Unum y sus esposas."
    "And incredibly, you find yourself accompanied by Unum and his wives."

# game/rutas/unum.rpy:116
translate ingles rutaunum2_03c06c37:

    # "A pesar de que el calor se hace cada vez más difícil de soportar, no es nada que te pueda hacer un daño verdadero."
    "Even though the heat is becoming increasingly hard to bear, it's nothing that can truly hurt you."

# game/rutas/unum.rpy:117
translate ingles rutaunum2_139a5d2b:

    # "Un poco de calor no mata a nadie... ¿cierto?"
    "A little heat doesn't kill anyone... right?"

# game/rutas/unum.rpy:118
translate ingles rutaunum2_952945c5:

    # "Miras tu entorno y te encuentras con 3 pares de ojos puestos en ti."
    "You look around and see three pairs of eyes fixed on you."

# game/rutas/unum.rpy:119
translate ingles rutaunum2_ee38209e:

    # "Aeliana, Ignis y Solaris. Quienes a pesar de mirarte como si te quisieran comer, son bastante respetuosas y calmadas, a diferencia de Unum."
    "Aeliana, Ignis, and Solaris. Even though they stare at you as if they wanted to devour you, they remain quite respectful and calm, unlike Unum."

# game/rutas/unum.rpy:121
translate ingles rutaunum2_19cfec53:

    # "Unum le pide a sus esposas que le enseñen a hacer la purificación de los alimentos, ya que según él tanto tú como el 'bebé' deben alimentarse sin preocuparse por un envenenamiento por parte de Tria."
    "Unum asks his wives to show him how to purify food, because according to him, both you and the 'baby' should eat without worrying about poisoning from Tria."

# game/rutas/unum.rpy:122
translate ingles rutaunum2_f3a07cfc:

    # ignis "Tienes que juntar tus manos alrededor de la fruta y..."
    ignis "You have to bring your hands together around the fruit and..."

# game/rutas/unum.rpy:123
translate ingles rutaunum2_a77c8288:

    # solaris "Debes cantar a la esencia de Tria."
    solaris "You must sing to the essence of Tria."

# game/rutas/unum.rpy:125
translate ingles rutaunum2_20e3db58:

    # "Sin más explicación, Ignis comienza a cantar en un idioma que desconoces. Tanto tú, junto con Unum miran con la boca abierta como la fruta comienza a brillar."
    "Without further explanation, Ignis starts singing in a language you do not understand. Both you and Unum stare in amazement as the fruit begins to glow."

# game/rutas/unum.rpy:126
translate ingles rutaunum2_63be3053:

    # "Para luego ser espectadores de como un sello se rompe en el aire."
    "Then you witness a seal shattering in midair."

# game/rutas/unum.rpy:127
translate ingles rutaunum2_812e887f:

    # aeliana "Cuando el sello de Tria se rompa, la fruta puede ser consumida."
    aeliana "When Tria's seal is broken, the fruit can be consumed."

# game/rutas/unum.rpy:128
translate ingles rutaunum2_980ecd06:

    # solaris "Hum... puede que el mini dios pueda no tener un riesgo mortal como [nombrejugador] al comer frutas no santificadas, pero el riesgo siempre está."
    solaris "Hmm... maybe the little god doesn't face as mortal danger as [nombrejugador] when eating unsanctified fruits, but the risk is always there."

# game/rutas/unum.rpy:129
translate ingles rutaunum2_374356f7:

    # ignis "Tal vez sea como nosotros..."
    ignis "Maybe it's like us..."

# game/rutas/unum.rpy:130
translate ingles rutaunum2_548e6e94:

    # aeliana "No asuman sin saber, queridas."
    aeliana "Don't assume without knowing, dears."

# game/rutas/unum.rpy:131
translate ingles rutaunum2_94298344:

    # aeliana "Hoy nosotras haremos la comida, pero a partir de mañana tú lo harás."
    aeliana "Today we'll cook, but starting tomorrow, you'll do it."

# game/rutas/unum.rpy:132
translate ingles rutaunum2_ab8b8dd9:

    # aeliana "Cocinaras para todos."
    aeliana "You'll cook for everyone."

# game/rutas/unum.rpy:133
translate ingles rutaunum2_55b0f189:

    # "Por un momento crees que te está hablando a ti, pero te das cuenta de que Aeliana tiene los ojos puestos en Unum."
    "For a moment, you think she's talking to you, but then you realize that Aeliana's eyes are fixed on Unum."

# game/rutas/unum.rpy:134
translate ingles rutaunum2_b1f073ba:

    # aeliana "Así que presta atención."
    aeliana "So pay attention."

# game/rutas/unum.rpy:136
translate ingles rutaunum2_efb5ef5c:

    # "Después de una intensa clase de cocina, en la que deben redirigir constantemente la atención de Unum a la explicación, todos se reúnen alrededor de la mesa para comer."
    "After an intense cooking class, where you have to constantly redirect Unum's attention to the explanation, everyone gathers around the table."

# game/rutas/unum.rpy:137
translate ingles rutaunum2_97fe06cb:

    # "Y comienzan a comer."
    "Then you all begin to eat."

# game/rutas/unum.rpy:138
translate ingles rutaunum2_0abc63df:

    # "El ambiente es hogareño, más hogareño de lo que tu mente podría imaginar. Y eso te asusta un poco."
    "The atmosphere is cozy, even more so than your mind could imagine. And that scares you a little."

# game/rutas/unum.rpy:139
translate ingles rutaunum2_7ee85923:

    # "Las esposas de Unum hablan mucho, demasiado... tanto que te cuesta seguirles el hilo, pero a Unum no."
    "Unum's wives talk a lot; too much... so much that you struggle to follow them, though Unum doesn't."

# game/rutas/unum.rpy:140
translate ingles rutaunum2_73f7e24f:

    # "Él está atento a todo lo que dicen, preguntando de vez en cuando, pero sin llegar a interrumpirlas."
    "He pays attention to everything they say, occasionally asking questions, but never interrupting."

# game/rutas/unum.rpy:141
translate ingles rutaunum2_fee43e29:

    # "Estás anodadado."
    "You're in a daze."

# game/rutas/unum.rpy:143
translate ingles rutaunum2_b3b3edcc:

    # aeliana "Mañana iremos con Duae a ver cómo está el cinturón de Orión."
    aeliana "Tomorrow we'll go with Duae to check on Orion's belt."

# game/rutas/unum.rpy:145
translate ingles rutaunum2_e4329893:

    # unum "Hace mucho tiempo que no van."
    unum "It's been a long time since you've been there."

# game/rutas/unum.rpy:146
translate ingles rutaunum2_a0aa4747:

    # unum "... no me gusta que Duae se refiera a ustedes con sus nombre asignados, ustedes ya no son su propiedad..."
    unum "... I don't like that Duae refers to you by your assigned names; you're no longer her property..."

# game/rutas/unum.rpy:148
translate ingles rutaunum2_99dc5cc0:

    # solaris "{size=*0.6}Si lo somos...{/size}"
    solaris "{size=*0.6}Yes, we are...{/size}"

# game/rutas/unum.rpy:151
translate ingles rutaunum2_88050d46:

    # ignis "Unum, ya hemos hablado de esto..."
    ignis "Unum, we've already talked about this..."

# game/rutas/unum.rpy:152
translate ingles rutaunum2_994105ca:

    # "Unum suelta un quejido, claramente agustiado y soprepasado por la situación."
    "Unum lets out a sigh, clearly displeased and overwhelmed by the situation."

# game/rutas/unum.rpy:153
translate ingles rutaunum2_65a89011:

    # unum "Es que sigo sin entender como no les molesta."
    unum "I still don't understand how it doesn't bother you."

# game/rutas/unum.rpy:154
translate ingles rutaunum2_c11362ea:

    # unum "Ustedes son libres, ya no están bajo el mandato de nadie."
    unum "You are free; you're no longer under anyone's command."

# game/rutas/unum.rpy:155
translate ingles rutaunum2_253425cd:

    # solaris "Eso solo aplica cuando no está Duae, y aún tenemos responsabilidades."
    solaris "That only applies when Duae isn't around, and we still have responsibilities."

# game/rutas/unum.rpy:156
translate ingles rutaunum2_bc5977f2:

    # unum "Pero..."
    unum "But..."

# game/rutas/unum.rpy:159
translate ingles rutaunum2_15460f12:

    # aeliana "No nos molesta, Unum."
    aeliana "We don't mind, Unum."

# game/rutas/unum.rpy:161
translate ingles rutaunum2_a38ed89a:

    # "Aeliana toma la mano de Unum con ternura, y con su pulgar acaricia el dorso de su mano."
    "Aeliana takes Unum's hand tenderly, caressing the back of it with her thumb."

# game/rutas/unum.rpy:162
translate ingles rutaunum2_727580d1:

    # "...Unum en cambio se come sus palabras, optando por no discutirles más."
    "... Unum, on the other hand, swallows his words, choosing not to argue any further."

# game/rutas/unum.rpy:164
translate ingles rutaunum2_4a7f44c8:

    # "Para cuando terminan, Unum y tú retiran los platos para lavarlos. Mientras que las esposas se despiden y te dan las buenas noches."
    "By the time you're finished, Unum and you clear the dishes to wash them, while the wives say their goodbyes and wish you good night."

# game/rutas/unum.rpy:168
translate ingles rutaunum2_48f8e2de:

    # unum "Ah... sí."
    unum "Ah... yes."

# game/rutas/unum.rpy:171
translate ingles rutaunum2_d3a9a388:

    # unum "Duae se los pone al crearlas, por lo general solo les pone un número... pero si son brillantes y tienen un buen desempeño, Duae las nombra con honores."
    unum "Duae gives them names when creating them; usually she just assigns a number... but if they're brilliant and perform well, Duae names them with honors."

# game/rutas/unum.rpy:172
translate ingles rutaunum2_4d9fe40c:

    # nj "¿Cómo se llamaban?"
    nj "What were they called?"

# game/rutas/unum.rpy:173
translate ingles rutaunum2_da9cec97:

    # unum "Alnitak, Alnilam y Mintaka."
    unum "Alnitak, Alnilam, and Mintaka."

# game/rutas/unum.rpy:176
translate ingles rutaunum2_a3140217:

    # unum "Son nombres bellos, pero son nombres de propiedad."
    unum "They are beautiful names, but they're names that are under ownership."

# game/rutas/unum.rpy:177
translate ingles rutaunum2_ddd77a80:

    # unum "Cuando vinieron conmigo, les pedí que eligeran sus propios nombres."
    unum "When they came with me, I asked them to choose their own names."

# game/rutas/unum.rpy:178
translate ingles rutaunum2_82f58935:

    # nj "Ya veo."
    nj "I see."

# game/rutas/unum.rpy:181
translate ingles rutaunum2_6432c15e:

    # unum "Tu nombre..."
    unum "Your name..."

# game/rutas/unum.rpy:184
translate ingles rutaunum2_20710ca2:

    # unum "¿Te lo han impuesto?"
    unum "Was it imposed on you?"

# game/rutas/unum.rpy:185
translate ingles rutaunum2_b4498675:

    # "{sc=3}El nombre que me has dado cuando estabas con Nulla.... ¿Cuenta como impuesto?{/sc}"
    "{sc=3}The name you gave me when you were with Nulla... does that count as imposed?{/sc}"

# game/rutas/unum.rpy:186
translate ingles rutaunum2_db49988a:

    # "... desvias el tema para no tener que responder su pregunta. No sabes si Unum comprende la indirecta o no, pero te sigue el juego."
    "... You change the subject to avoid answering his question. You don't know if Unum catches the hint or not, but he plays along."

# game/rutas/unum.rpy:188
translate ingles rutaunum2_f8177a80:

    # "Pasan el tiempo conversando de como santificar la comida, Unum te muestra lo que aprendió con una manzana."
    "Time passes as you discuss how to sanctify food, while Unum shows you what he learned with an apple."

# game/rutas/unum.rpy:189
translate ingles rutaunum2_fd2daf82:

    # "E increíblemente, ha podido romper el sello."
    "And incredibly, he managed to break the seal."

# game/rutas/unum.rpy:191
translate ingles rutaunum2_71e61dc4:

    # "Con una sonrisa que muestra todos sus dientes, te la ofrece."
    "With a smile revealing all his teeth, he offers it to you."

# game/rutas/unum.rpy:194
translate ingles rutaunum2_d901a034:

    # "Tomas la manzana y le das un gran mordisco."
    "You grab the apple and take a big bite."

# game/rutas/unum.rpy:195
translate ingles rutaunum2_d10b6264:

    # "Luego de mascar, le sonríes mostrando los dientes, al igual que lo hace él."
    "After chewing, you smile, baring your teeth just as he does."

# game/rutas/unum.rpy:196
translate ingles rutaunum2_d9558b4f:

    # "Unum se sonroja y suelta una carcajada."
    "Unum blushes and laughs heartily."

# game/rutas/unum.rpy:199
translate ingles rutaunum2_14778374:

    # nj "No gracias."
    nj "No, thank you."

# game/rutas/unum.rpy:201
translate ingles rutaunum2_97575fac:

    # "Claramente tu rechazo le afecta, pues su sonrisa se esfuma para soltar un simple {i}oh{i}."
    "Clearly, your rejection affects him, as his smile fades into a simple, {i}'oh.'{i}"

# game/rutas/unum.rpy:202
translate ingles rutaunum2_89e23df4:

    # unum "La dejaré aquí por si te llega a dar hambre."
    unum "I'll leave it here in case you get hungry."

# game/rutas/unum.rpy:204
translate ingles rutaunum2_bd07c23c:

    # "Llega el momento en que te sientes cansado, por lo que Unum te lleva a tu habitación."
    "Eventually, you feel tired, and Unum takes you to your room."

# game/rutas/unum.rpy:206
translate ingles rutaunum2_836e0045:

    # "Unum te mira por un segundo cuando ya te encuentras cubierto por las sábanas y se acerca repentinamente a ti."
    "Unum glances at you for a second while you're already under the sheets, then suddenly approaches."

# game/rutas/unum.rpy:207
translate ingles rutaunum2_ac882bcf:

    # unum "Cuándo duermes, ¿Que se siente?"
    unum "When you sleep, what does it feel like?"

# game/rutas/unum.rpy:208
translate ingles rutaunum2_b4feb9a6:

    # "... te cuesta un poco responder con su cara tan cerca de la tuya."
    "... It's a bit difficult to answer with his face so close to yours."

# game/rutas/unum.rpy:209
translate ingles rutaunum2_28eaf5fa:

    # "¿Cómo responderle eso a alguien que no puede o necesita dormir?"
    "How do you answer someone who can't or doesn't need to sleep?"

# game/rutas/unum.rpy:212
translate ingles rutaunum2_a61a1f4a:

    # "Tomas un poco de aire y comienzas a explicar desde como se siente dormir, porqué debes dormir y que pasa durante el sueño."
    "You take a breath and begin explaining what it feels like to sleep, why you must sleep, and what happens during sleep."

# game/rutas/unum.rpy:213
translate ingles rutaunum2_b21bb025:

    # "Le explicas la existencia de los sueños, recalcando que no siempre eres capaz de recordar tus sueños."
    "You explain the existence of dreams, emphasizing that you don't always remember them."

# game/rutas/unum.rpy:217
translate ingles rutaunum2_3b4a2ed7:

    # "No quieres confundirlo y sacar a tema conceptos rebuscados o difíciles de explicar, como las fases del sueño y el porqué existen los sueños."
    "You don't want to confuse him by delving into convoluted or hard-to-explain concepts, like sleep phases and why dreams exist."

# game/rutas/unum.rpy:218
translate ingles rutaunum2_58505ee1:

    # "Tal vez eso se lo puedas explicar otro día."
    "Maybe you can explain that another day."

# game/rutas/unum.rpy:219
translate ingles rutaunum2_8c168efb:

    # "Así que le respondes solo que que se siente dormir."
    "So you simply reply with what it feels like to sleep."

# game/rutas/unum.rpy:221
translate ingles rutaunum2_a0dd87a4:

    # "Mientras hablas, notas cómo Unum se recuesta en la cama, observándote con los ojos bien abiertos."
    "While you speak, you notice Unum reclining on the bed, watching you with his eyes wide open."

# game/rutas/unum.rpy:222
translate ingles rutaunum2_02a5d525:

    # "Su atención está en todo momento sobre ti, está pendiente de cada palabra que pronuncias, tal como lo hizo mientras sus esposas conversaban en la mesa."
    "His attention is entirely on you, catching every word you utter, just as he did when his wives were talking at the table."

# game/rutas/unum.rpy:223
translate ingles rutaunum2_3853d438:

    # "Se ve lindo."
    "He looks cute."

# game/rutas/unum.rpy:224
translate ingles rutaunum2_43102250:

    # unum "..."
    unum "..."

# game/rutas/unum.rpy:225
translate ingles rutaunum2_acf74fc2:

    # "En un momento, la expresión de Unum se torna a una expresión angustiada."
    "In a moment, Unum's expression shifts to one of distress."

# game/rutas/unum.rpy:226
translate ingles rutaunum2_d5b8e348:

    # unum "¿Crees que él bebé pueda soñar?"
    unum "Do you think the baby can dream?"

# game/rutas/unum.rpy:227
translate ingles rutaunum2_0a19f3f0:

    # unum "Me gustaría que pudiera experimentar aquello."
    unum "I wish they could experience that."

# game/rutas/unum.rpy:228
translate ingles rutaunum2_60eb8398:

    # unum "Suena... liberador."
    unum "It sounds... liberating."

# game/rutas/unum.rpy:231
translate ingles rutaunum2_e0e04066:

    # unum "...no."
    unum "... No."

# game/rutas/unum.rpy:232
translate ingles rutaunum2_8b07b611:

    # unum "No estamos configurados como los humanos."
    unum "We're not built like humans."

# game/rutas/unum.rpy:233
translate ingles rutaunum2_e1ed3ebc:

    # unum "No necesitamos descansar y menos soñar."
    unum "We don't need to rest, much less dream."

# game/rutas/unum.rpy:234
translate ingles rutaunum2_b1d1da41:

    # unum "Nuestro único propósito es mantener el orden del jardín."
    unum "Our only purpose is to maintain the order of the Garden."

# game/rutas/unum.rpy:235
translate ingles rutaunum2_b61c89aa:

    # unum "Por lo que dormir y soñar es una pérdida de tiempo."
    unum "So sleeping and dreaming is a waste of time. Or that's what Septem says..."

# game/rutas/unum.rpy:236
translate ingles rutaunum2_94004a03:

    # "Oh."
    "Oh."

# game/rutas/unum.rpy:240
translate ingles rutaunum2_1c7480a1:

    # unum "Waaah."
    unum "Waaaah--"

# game/rutas/unum.rpy:241
translate ingles rutaunum2_72fc075d:

    # unum "¡¿De verdad lo crees?!"
    unum "Do you really believe that?!"

# game/rutas/unum.rpy:242
translate ingles rutaunum2_8f52f5b8:

    # "Asientes con la cabeza y Unum se abalanza sobre ti para darte un abrazo junto con un beso."
    "You nod, and Unum pounces on you to give you a hug and a kiss."

# game/rutas/unum.rpy:243
translate ingles rutaunum2_a289e2d5:

    # unum "Estoy tan feliz."
    unum "I'm so happy."

# game/rutas/unum.rpy:244
translate ingles rutaunum2_cc6accae:

    # "Te asusta un poco que te crea como si lo que dices es la verdad absoluta..."
    "It scares you a bit that he takes your words as absolute truth..."

# game/rutas/unum.rpy:249
translate ingles rutaunum2_a20cefa7_1:

    # "..."
    "..."

# game/rutas/unum.rpy:251
translate ingles rutaunum2_40704a2b:

    # "Unum se aclara la garganta, algo avergonzado con su comentario."
    "Unum clears his throat, a bit embarrassed by his remark."

# game/rutas/unum.rpy:252
translate ingles rutaunum2_b43697ae:

    # unum "Deberías descansar ahora."
    unum "You should rest now."

# game/rutas/unum.rpy:253
translate ingles rutaunum2_ac2129c0:

    # unum "Nos vemos en unas horas."
    unum "See you in a few hours."

# game/rutas/unum.rpy:254
translate ingles rutaunum2_7a42e23b:

    # unum "¡Buenas noches!"
    unum "Good night!"

# game/rutas/unum.rpy:255
translate ingles rutaunum2_7dec6509:

    # "Te besa en la frente y se va de la habitación."
    "He kisses you on the forehead and leaves the room."

# game/rutas/unum.rpy:256
translate ingles rutaunum2_0e3a9f2c:

    # "Meditas por un largo tiempo lo conversado con Unum..."
    "You ponder for a long time over the conversation with Unum..."

# game/rutas/unum.rpy:257
translate ingles rutaunum2_6d1fd386:

    # "Los nombres aquí son importantes, más importantes de lo que tu creías."
    "The names here are important, more important than you thought."

# game/rutas/unum.rpy:258
translate ingles rutaunum2_19217d03:

    # "Si las esposas de Unum fueron pertenencia de Duae, entonces... los Estandartes también deben pertenecer a alguien."
    "If Unum's wives belonged to Duae, then... the Symbols must also belong to someone."

# game/rutas/unum.rpy:259
translate ingles rutaunum2_bc891fad:

    # "¿Ese alguien será Septem?"
    "Could that someone be Septem?"

# game/rutas/unum.rpy:260
translate ingles rutaunum2_adecc83c:

    # "Tal vez mañana deberías preguntar por qué los nombres son tan importantes y porqué Unum no se siente cómodo con nombrar a sus esposas por sus nombres originales."
    "Maybe tomorrow you should ask why names are so important and why Unum doesn't feel comfortable calling his wives by their original names."

# game/rutas/unum.rpy:261
translate ingles rutaunum2_f9f1084b:

    # "Poco a poco vas cerrando los ojos."
    "Little by little, your eyes begin to close."

# game/rutas/unum.rpy:262
translate ingles rutaunum2_0802056c:

    # "Y te dejas caer en un sueño profundo."
    "And you sink into a deep sleep."

# game/rutas/unum.rpy:267
translate ingles rutaunum2_a20cefa7_2:

    # "..."
    "..."

# game/rutas/unum.rpy:269
translate ingles rutaunum2_4f20e2a2:

    # unum "¡[nombrejugador]!"
    unum "[nombrejugador]!"

# game/rutas/unum.rpy:272
translate ingles rutaunum2_50bc8ca4:

    # unum "{size=*2.5}¡[nombrejugador]!{/size}"
    unum "{size=*2.5}[nombrejugador]!{/size}"

# game/rutas/unum.rpy:273
translate ingles rutaunum2_22a9c13d:

    # "Dos manos te agarran por los hombros para sacudirte con urgencia."
    "Two hands grab you by the shoulders, urgently shaking you."

# game/rutas/unum.rpy:275
translate ingles rutaunum2_b73bb00b:

    # unum "Fui a ver al bebé y hay algo raro en él."
    unum "I went to check on the baby, and there's something off about them."

# game/rutas/unum.rpy:276
translate ingles rutaunum2_68a16c5c:

    # "Tienes que parpadear unas cuantas veces para despertar completamente y entender que demonios está diciendo el pelirrojo."
    "You have to blink a few times to fully wake up and understand what the redhead is saying."

# game/rutas/unum.rpy:277
translate ingles rutaunum2_ee2c6ac2:

    # nj "¿Q- Que?"
    nj "W--What?"

# game/rutas/unum.rpy:278
translate ingles rutaunum2_cbb2875f:

    # unum "Hay algo raro con el bebé."
    unum "There's something off about the baby."

# game/rutas/unum.rpy:280
translate ingles rutaunum2_4645edd5:

    # "Sin más aviso que aquello, Unum toma tu mano y te arrastra fuera de la cama."
    "Without another word, Unum grabs your hand and drags you out of the bed."

# game/rutas/unum.rpy:281
translate ingles rutaunum2_aef3b425:

    # "Unum te explica como puede, entre el panico y los nervios, lo que está pasando con el bebé."
    "Unum does his best to explain, amid panic and nerves, what's happening with the baby."

# game/rutas/unum.rpy:282
translate ingles rutaunum2_9668e2a3:

    # "Pero tú no comprendes nada."
    "But you don't understand anything."

# game/rutas/unum.rpy:283
translate ingles rutaunum2_c152a037:

    # "Necesitas solo 5 minutos de paz... por favor."
    "You just need five minutes of peace... please."

# game/rutas/unum.rpy:284
translate ingles rutaunum2_4e9e2bb4:

    # "Solo 5 minutos, para pensar las decisiones que has tomado para haber llegado hasta aquí..."
    "Just five minutes, to ponder the choices that led you here..."

# game/rutas/unum.rpy:286
translate ingles rutaunum2_0dd00c9b:

    # unum "¿Es normal que se mueva tanto?"
    unum "Is it normal for it to move so much?"

# game/rutas/unum.rpy:287
translate ingles rutaunum2_d32adf6a:

    # "... ¿¿¿¿Por qué te pregunta esto, sabiendo que ninguno de ustedes dos TIENE IDEA ALGUNA DE COMO FUNCIONA EL DESARROLLO DE UN BEBÉ CREADO CON COMBINACIÓN DE ALMAS?????"
    "... Why is he asking you this, knowing that neither of you has any idea how a baby created from a combination of souls develops????"

# game/rutas/unum.rpy:288
translate ingles rutaunum2_95a85584:

    # nj "¿¿¿No lo sé???"
    nj "I... I don't know???"

# game/rutas/unum.rpy:289
translate ingles rutaunum2_f991ec0d:

    # nj "Acaso Sextam no te ha explicado el proceso de desarrollo de esta cosa?"
    nj "Hasn't Sextam explained the development process of this thing to you?"

# game/rutas/unum.rpy:290
translate ingles rutaunum2_d993a634:

    # unum "¡¿Cosa?!"
    unum "This 'thing?!'"

# game/rutas/unum.rpy:291
translate ingles rutaunum2_c29f910d:

    # unum "¡Es un bebé!"
    unum "It's a BABY!!"

# game/rutas/unum.rpy:292
translate ingles rutaunum2_f2d7899c:

    # "...no sabes que es lo hace que el comentario sea más divertido, la cara de Unum o el hecho de que la cosa que está apuntado claramente, no es un bebé."
    "... You don't know what makes the comment funnier: Unum's face, or the fact that the thing he's clearly pointing at isn't a baby."

# game/rutas/unum.rpy:293
translate ingles rutaunum2_7479c0f8:

    # "Es una masa transparente que se mueve como si sintiera incomodidad..."
    "It's a transparent mass that moves as if it were feeling discomfort..."

# game/rutas/unum.rpy:294
translate ingles rutaunum2_60eef718:

    # "Y ni siquiera sabes si eso es capaz de sentir o no algo aún."
    "And you don't even know if it's capable of feeling anything yet."

# game/rutas/unum.rpy:295
translate ingles rutaunum2_f55cf9fe:

    # unum "Creo que necesita estabilizarse..."
    unum "I think it needs to stabilize..."

# game/rutas/unum.rpy:296
translate ingles rutaunum2_65d86edb:

    # unum "Ambos tenemos que tomarlo."
    unum "We both have to take it."

# game/rutas/unum.rpy:297
translate ingles rutaunum2_4c0ac603:

    # "Esperas que esto se lo haya dicho Sextam y no se lo esté inventando..."
    "You hope that Sextam told him this and that he's not just making it up..."

# game/rutas/unum.rpy:298
translate ingles rutaunum2_33c47bec:

    # "A medida que se acercan puedes sentir un golpe de calor inmenso, no es agradeble como el calor que transmite el cuerpo de Unum."
    "As you approach, you feel an immense burst of heat, not as pleasant as the warmth radiating from Unum's body."

# game/rutas/unum.rpy:299
translate ingles rutaunum2_3606a7fe:

    # "No, este calor es insoportable."
    "No, this heat is unbearable."

# game/rutas/unum.rpy:307
translate ingles rutaunum2_864bc965:

    # "Junto con Unum, ambos colocan sus manos en la masa."
    "Together with Unum, you both place your hands on the mass."

# game/rutas/unum.rpy:308
translate ingles rutaunum2_2ddc2dbd:

    # "Sientes un hormigueo en tus dedos y brazo, pero no te duele ni quema."
    "You feel a tingling in your fingers and arm, but it doesn't hurt or burn."

# game/rutas/unum.rpy:309
translate ingles rutaunum2_02d23b18:

    # unum "Esto es como el nacimiento de una estrella..."
    unum "So, this is like the birth of a star..."

# game/rutas/unum.rpy:311
translate ingles rutaunum2_ef68f167:

    # "No eres capaz de responder a Unum cuando un destello te nubla los ojos. Es tan brillante que los tienes que cerrar con fuerza para no quedar ciego."
    "You're unable to answer Unum as a flash clouds your eyes. It's so bright that you have to shut them tightly to avoid blindness."

# game/rutas/unum.rpy:312
translate ingles rutaunum2_ffc1dfa9:

    # "Un calor intenso te rodea y abraza, es como si los rayos del sol se clavaran en tu piel, besándote suavemente por un prolongado tiempo."
    "An intense heat surrounds and embraces you, as if the sun's rays were piercing your skin, softly kissing you for an extended time."

# game/rutas/unum.rpy:313
translate ingles rutaunum2_f19b1a2c:

    # "Luego, el brillo cesa."
    "Then, the glow ceases."

# game/rutas/unum.rpy:315
translate ingles rutaunum2_fab7bdf1:

    # "Cuando abres los ojos, Unum grita."
    "When you open your eyes, Unum shouts."

# game/rutas/unum.rpy:316
translate ingles rutaunum2_986c69e6:

    # unum "¿Se partió?"
    unum "Did it split?!"

# game/rutas/unum.rpy:317
translate ingles rutaunum2_75b0a17f:

    # "Efectivamente, la masa ya no es una, sino dos."
    "Indeed, the mass is no longer one, but two."

# game/rutas/unum.rpy:319
translate ingles rutaunum2_a26d38d2:

    # "Escuchas como la puerta se abre de golpe."
    "You hear the door slam open."

# game/rutas/unum.rpy:321
translate ingles rutaunum2_68b55203:

    # aeliana "Mi señora Duae, no puede entrar a esta sala sin avisar."
    aeliana "My lady Duae, you cannot enter this room without notifying us."

# game/rutas/unum.rpy:323
translate ingles rutaunum2_ca965efe:

    # duae "No quiero que hables, Alnitak."
    duae "I don't want you to speak, Alnitak."

# game/rutas/unum.rpy:324
translate ingles rutaunum2_575b507f:

    # "Aeliana hace una mueca de dolor, y sus labios se sellan con fuerza."
    "Aeliana grimaces in pain, her lips pressed tightly shut."

# game/rutas/unum.rpy:325
translate ingles rutaunum2_863f0d9a:

    # "Unum se gira para ver a Duae entrar por la puerta, seguida de Aeliana."
    "Unum turns to see Duae entering through the door, followed by Aeliana."

# game/rutas/unum.rpy:328
translate ingles rutaunum2_262b5448:

    # unum "No tienes permiso de darles órdenes en mi dominio."
    unum "You don't have permission to give orders in my domain."

# game/rutas/unum.rpy:329
translate ingles rutaunum2_ac3cf74c:

    # unum "Devuélvele el habla ahora mismo."
    unum "Give her voice back right now."

# game/rutas/unum.rpy:330
translate ingles rutaunum2_144259ed:

    # duae "Hmmm. Luego de esto."
    duae "Hmmm. After this."

# game/rutas/unum.rpy:331
translate ingles rutaunum2_f5f15802:

    # "Duae ignora la orden, para acercarse a ustedes."
    "Duae ignores the order, moving closer to you."

# game/rutas/unum.rpy:332
translate ingles rutaunum2_b8dfb3ed:

    # duae "Debo asistir en el nacimiento de estas estrellas binarias."
    duae "I must assist in the birth of these binary stars."

# game/rutas/unum.rpy:333
translate ingles rutaunum2_101be476:

    # unum "No son tuyas."
    unum "They aren't yours."

# game/rutas/unum.rpy:334
translate ingles rutaunum2_8778e74e:

    # duae "Septem me ha dado órdenes de asistir en todo lo que sea necesario."
    duae "Septem has ordered me to assist with whatever is needed."

# game/rutas/unum.rpy:335
translate ingles rutaunum2_e9f6241e:

    # duae "Y mi asistencia es necesaria ahora, tú no estás calificado para esto..."
    duae "And my assistance is needed now. You're not qualified for this..."

# game/rutas/unum.rpy:336
translate ingles rutaunum2_55f847ba:

    # "Unum no tiene la oportunidad de rebatir su comentario cuando Duae agrega con algo de veneno en su voz."
    "Unum doesn't get a chance to retort as Duae adds, her voice laced with venom."

# game/rutas/unum.rpy:339
translate ingles rutaunum2_debcf7be:

    # duae "Eres muy egocéntrico, siendo que las que te rodean son incluso mejores que tú."
    duae "You're very egocentric, especially since those around you are even better than you."

# game/rutas/unum.rpy:340
translate ingles rutaunum2_708eacef:

    # duae "Más fuertes y grandes."
    duae "Stronger and larger."

# game/rutas/unum.rpy:343
translate ingles rutaunum2_ca09c7fa:

    # unum "Pero no aptos para dar espacio a la vida orgánica."
    unum "But not suitable for giving space to organic life."

# game/rutas/unum.rpy:344
translate ingles rutaunum2_5a8a9be7:

    # duae "Ja."
    duae "Ha."

# game/rutas/unum.rpy:345
translate ingles rutaunum2_a4080811:

    # "Duae quita tu mano de la masa y le pide a Unum espacio para que ella pueda hacer su trabajo."
    "Duae pulls your hand away from the mass and asks Unum for space so that she can do her work."

# game/rutas/unum.rpy:347
translate ingles rutaunum2_258ff61c:

    # "Unum a regañadientes da unos pasos atrás junto contigo, cuando considera que están a una distancia prudente, se coloca delante tuyo, cubriendo tu cuerpo con el suyo."
    "Reluctantly, Unum takes a few steps back with you, and when he deems the distance safe, he moves in front of you, covering your body with his own."

# game/rutas/unum.rpy:348
translate ingles rutaunum2_0058e9db:

    # "Supones que debe ser por protección."
    "You assume it must be for protection."

# game/rutas/unum.rpy:350
translate ingles rutaunum2_28e9f439:

    # "Duae coloca ambas manos en cada una de las masas, y de un solo jalón se forma un brillo mucho más brillante que el anterior."
    "Duae places both hands on each of the masses, and with one swift pull, a glow far brighter than before emerges."

# game/rutas/unum.rpy:352
translate ingles rutaunum2_db3cf2c9:

    # "Unum te cubre los ojos con su brazo."
    "Unum covers your eyes with his arm."

# game/rutas/unum.rpy:353
translate ingles rutaunum2_8c25c5a2:

    # "Hay un silencio sepulcral luego de aquello, y la temperatura que hay ahora en la sala es insoportable."
    "A deathly silence follows, and the room's temperature becomes unbearable."

# game/rutas/unum.rpy:354
translate ingles rutaunum2_a20cefa7_3:

    # "..."
    "..."

# game/rutas/unum.rpy:355
translate ingles rutaunum2_43725154:

    # "Y el llanto de un bebe lo rompe, seguido por otro mucho más débil."
    "And a baby's cry shatters the silence, followed by a much weaker one."

# game/rutas/unum.rpy:356
translate ingles rutaunum2_4735bba0:

    # duae "¿Qué es esto?"
    duae "What is this?"

# game/rutas/unum.rpy:358
translate ingles rutaunum2_82d51297:

    # "Como si de un pescador se tratase, Duae sujeta a dos criaturas por los pies, ambas lloran por la posición en la que están."
    "Like a fisherman, Duae holds two creatures by their feet and both cry because of the position they're in."

# game/rutas/unum.rpy:359
translate ingles rutaunum2_73c05aa1:

    # "Sientes como sudas, y tu visión comienza a nublarse. El aire que respiras es caliente y no hace más que desesperarte con el pasar de los segundos."
    "You feel yourself sweating, and your vision starts to blur. The hot air only deepens your desperation with each passing second."

# game/rutas/unum.rpy:360
translate ingles rutaunum2_95d37e13:

    # unum "¡Así no se toman, bruta!"
    unum "That's not how you hold them, you brute!"

# game/rutas/unum.rpy:361
translate ingles rutaunum2_bb1e920e:

    # duae "..."
    duae "..."

# game/rutas/unum.rpy:363
translate ingles rutaunum2_6e1f1d65:

    # "Anodadada Duae entrega a las dos entidades en los brazos de Unum. Quien las toma como es debido tomar a un bebé humano."
    "Taken aback, Duae hands the two entities to Unum, who cradles them as one would a human baby."

# game/rutas/unum.rpy:364
translate ingles rutaunum2_0e3637cf:

    # duae "¿Esto es un humano?"
    duae "Is this a human?"

# game/rutas/unum.rpy:365
translate ingles rutaunum2_d0b6ae07:

    # unum "No, híbridos."
    unum "No, they are hybrids."

# game/rutas/unum.rpy:366
translate ingles rutaunum2_c148150b:

    # duae "Pensé que de aquí saldría un dios ya listo para tomar su rango."
    duae "I thought a god, ready to claim their rank, would emerge."

# game/rutas/unum.rpy:367
translate ingles rutaunum2_ce120adc:

    # duae "No esto."
    duae "Not this."

# game/rutas/unum.rpy:368
translate ingles rutaunum2_aa735c6f:

    # unum "... eso da igual."
    unum "... That doesn't matter. You will have a god ready after a while."

# game/rutas/unum.rpy:369
translate ingles rutaunum2_d626f3c0:

    # duae "Supongo que Septem está al tanto de que jugarás a ser humano..."
    duae "I suppose Septem knows you're playing at being human..."

# game/rutas/unum.rpy:370
translate ingles rutaunum2_3d6e5abc:

    # "Duae observa a las pequeñas entidades en los brazos de Unum. El ambiente está tenso."
    "Duae watches the small entities in Unum's arms. The atmosphere is tense."

# game/rutas/unum.rpy:371
translate ingles rutaunum2_47c1f104:

    # duae "Son tuyos, debes ponerles un nombre."
    duae "They're yours. You need to give them names."

# game/rutas/unum.rpy:372
translate ingles rutaunum2_ed9e375f:

    # duae "Ahora."
    duae "Now."

# game/rutas/unum.rpy:374
translate ingles rutaunum2_d4db22ac:

    # "Ya no aguantas más y Unum parece darse cuenta de lo mal que te encuentras. Con nervisos asomandose en su voz, te pide salir de la sala por un momento."
    "You can't take it any longer, and Unum seems to notice how unwell you are. With a tremor of nervousness in his voice, he asks you to leave the room for a moment."

# game/rutas/unum.rpy:375
translate ingles rutaunum2_6f136585:

    # "Indicando que salgas al jardín para que tomes aire."
    "He gestures for you to step out into the garden for some fresh air."

# game/rutas/unum.rpy:377
translate ingles rutaunum2_db471cc5:

    # "Y tú lo haces sin chistar."
    "And you do so without a word of protest."

# game/rutas/unum.rpy:379
translate ingles rutaunum2_fd85b4ad:

    # "Caminas con dificultad hacia la puerta que conduce al jardín y te sientas en una de las bancas cercanas."
    "You trudge towards the door leading to the garden and sit down on one of the nearby benches."

# game/rutas/unum.rpy:382
translate ingles rutaunum2_7f5832e6:

    # "Respiras hondo y cierras los ojos..."
    "You take a deep breath and close your eyes..."

# game/rutas/unum.rpy:383
translate ingles rutaunum2_4ebfd80b:

    # "Aquí el aire es fresco y no te da la sensación de quemarte los pulmones al inspirar."
    "Here, the air is fresh, and you don't feel your lungs burning as you breathe in."

# game/rutas/unum.rpy:386
translate ingles rutaunum2_cd5e4065:

    # "Miras tus manos y hay algo que te está comenzando a preocupar..."
    "You glance at your hands, and something starts to worry you..."

# game/rutas/unum.rpy:387
translate ingles rutaunum2_bdba6663:

    # "No es el color de ellas, pues Septem también tiene esas marcas, no... lo que te preocupa es que has comenzado a sentir menos en ellas."
    "It's not their color, since Septem also bears those marks... No, what worries you is that you've begun to feel less in them."

# game/rutas/unum.rpy:388
translate ingles rutaunum2_c690ac7e:

    # "No tienes sensación en las yemas de tus dedos, la sensibilidad en esa zona es casi inexistente."
    "You have no sensation in your fingertips; the sensitivity in that area is almost nonexistent."

# game/rutas/unum.rpy:389
translate ingles rutaunum2_428f11f7:

    # "Si bien puedes mover tus dedos, algo dentro de ti te dice que tarde o temprano dejarás de tener ese beneficio."
    "Although you can move your fingers, something inside tells you that sooner or later you'll lose that ability."

# game/rutas/unum.rpy:390
translate ingles rutaunum2_4e25c72a:

    # "Si le comunicas esto a Unum, ¿podrá ayudarte?"
    "If you tell Unum about this, will he be able to help you?"

# game/rutas/unum.rpy:391
translate ingles rutaunum2_ff491738:

    # "Sinceramente, ahora Unum no parece ser tan aterrador, pero crees que es porque ya llevas algo de tiempo con él, entonces puede que ya te hayas acostumbrado a su extraña presencia y personalidad."
    "Honestly, Unum doesn't seem so frightening now, but you suspect it's because you've been with him for a while, and perhaps you've grown accustomed to his odd presence and personality."

# game/rutas/unum.rpy:392
translate ingles rutaunum2_a0ad42c4:

    # "No es malo... solo extraño y algo violento cuando tiene hambre."
    "He's not bad... just peculiar and a bit violent when he's hungry..."

# game/rutas/unum.rpy:393
translate ingles rutaunum2_5e7edd39:

    # "¿Será viable quedarte aquí?"
    "Could it be viable for you to stay here?"

# game/rutas/unum.rpy:394
translate ingles rutaunum2_59d99da1:

    # "Si intentas escapar... ¿tendrás alguna otra opción de sobrevivir?"
    "If you try to escape... will you have any other option to survive?"

# game/rutas/unum.rpy:401
translate ingles rutaunum2_eecc0134:

    # "Sí, es lo mejor dentro de tus posibilidades."
    "Yes, it's the best of your possible options."

# game/rutas/unum.rpy:402
translate ingles rutaunum2_e5f4e598:

    # "No conoces que hay más allá de este jardín, ni menos como es el mundo o sociedad allá afuera."
    "You don't know what's beyond this garden, nor what the world or society out there is like."

# game/rutas/unum.rpy:403
translate ingles rutaunum2_45e2a0d6:

    # "Para colmo: {i}apestas a humano{i}, según lo que has visto y escuchado, y eso no es bueno para ti."
    "To top it all off, according to what you've seen and heard, you {i}smell like a human{/i}, and that's not good for you."

# game/rutas/unum.rpy:404
translate ingles rutaunum2_79ecb2cb:

    # "Eres una presa fácil."
    "You're an easy target."

# game/rutas/unum.rpy:405
translate ingles rutaunum2_7635ee51:

    # el "{sc=2}¿Ya tienes permiso de estar afuera?{/sc}"
    el "{sc=2}Do you already have permission to be outside?{/sc}"

# game/rutas/unum.rpy:406
translate ingles rutaunum2_197c8560:

    # "Conoces esa voz..."
    "You recognize that voice..."

# game/rutas/unum.rpy:408
translate ingles rutaunum2_ab2187ef:

    # "Subes la mirada y vez como Septem se encuentra parado a tú lado, mirando por sobre tu hombro."
    "You lift your gaze and see Septem standing next to you, looking over your shoulder."

# game/rutas/unum.rpy:413
translate ingles rutaunum2_8bce32f2:

    # septem "{sc=2}¿Quien te dio el derecho de hacer preguntas?{/sc}"
    septem "{sc=2}Who gave you the right to ask questions?{/sc}"

# game/rutas/unum.rpy:414
translate ingles rutaunum2_fa5c5550:

    # "Septem sonríe dulcemente, pero su voz no refleja su expresión."
    "Septem smiles gently, but his voice doesn't match his expression."

# game/rutas/unum.rpy:415
translate ingles rutaunum2_afbf235b:

    # "Suena molesto."
    "He sounds annoyed."

# game/rutas/unum.rpy:418
translate ingles rutaunum2_4c46ac4b:

    # septem "{sc=2}Responde mi pregunta.{/sc}"
    septem "{sc=2}Answer my question.{/sc}"

# game/rutas/unum.rpy:419
translate ingles rutaunum2_0eb06432:

    # nj "..."
    nj "..."

# game/rutas/unum.rpy:423
translate ingles rutaunum2_69f7c82f:

    # nj "Buenos días..."
    nj "Good morning..."

# game/rutas/unum.rpy:424
translate ingles rutaunum2_4fee9170:

    # "Septem sonríe complacido."
    "Septem smiles contentedly."

# game/rutas/unum.rpy:427
translate ingles rutaunum2_4c46ac4b_1:

    # septem "{sc=2}Responde mi pregunta.{/sc}"
    septem "{sc=2}Answer my question.{/sc}"

# game/rutas/unum.rpy:428
translate ingles rutaunum2_ccbcf73f:

    # "¡Oh! cierto."
    "Oh! Right."

# game/rutas/unum.rpy:436
translate ingles rutaunum2_916fe3da:

    # nj "Unum me ha pedido que salga a tomar aire."
    nj "Unum asked me to go out for some air."

# game/rutas/unum.rpy:437
translate ingles rutaunum2_552adf4d:

    # nj "La habitación en que estábamos no era muy agradable."
    nj "The room we were in wasn't very pleasant, too much heat."

# game/rutas/unum.rpy:440
translate ingles rutaunum2_e9a5f945:

    # septem "{sc=2}Me imagino... {/sc}"
    septem "{sc=2}I imagine...{/sc}"

# game/rutas/unum.rpy:441
translate ingles rutaunum2_dcc95458:

    # septem "{sc=2}Los humanos no pueden resistir el poder de tantas estrellas por mucho tiempo.{/sc}"
    septem "{sc=2}Humans can't withstand the power of so many stars for very long.{/sc}"

# game/rutas/unum.rpy:442
translate ingles rutaunum2_b38df427:

    # septem "{sc=2}Menos de estrellas recién creadas.{/sc}"
    septem "{sc=2}Let alone newly formed stars.{/sc}"

# game/rutas/unum.rpy:443
translate ingles rutaunum2_e03130d2:

    # septem "{sc=2}Si no hubieras salido, seguramente estarías ya muerto.{/sc}"
    septem "{sc=2}If you hadn't gone out, you'd probably be dead by now.{/sc}"

# game/rutas/unum.rpy:444
translate ingles rutaunum2_bb3bf3cd:

    # "Quieres preguntar si ha venido a ver a los híbridos, pero tienes miedo de como él pueda reaccionar."
    "You want to ask if he's come to see the hybrids, but you're afraid of how he might react."

# game/rutas/unum.rpy:447
translate ingles rutaunum2_3b44b3ff:

    # septem "{sc=2}Vamos a verlos.{/sc}"
    septem "{sc=2}Let's go see them.{/sc}"

# game/rutas/unum.rpy:448
translate ingles rutaunum2_df3f0913:

    # nj "¿A los híbridos de Unum?"
    nj "Unum's hybrids?"

# game/rutas/unum.rpy:451
translate ingles rutaunum2_0aff9afe:

    # septem "{sc=2}Son tuyos también.{/sc}"
    septem "{sc=2}They're yours, too.{/sc}"

# game/rutas/unum.rpy:460
translate ingles rutaunum2_d88846e3:

    # septem "{sc=2}Hmmm, no fue una pregunta.{/sc}"
    septem "{sc=2}Hmmm, that wasn't a question.{/sc}"

# game/rutas/unum.rpy:461
translate ingles rutaunum2_5c9a2061:

    # septem "{sc=2}Vamos.{/sc}"
    septem "{sc=2}Let's go.{/sc}"

# game/rutas/unum.rpy:464
translate ingles rutaunum2_edbfa336:

    # "El camino de vuelta es incómodo, Septem no hace esfuerzo alguno por entablar una conversación y tú estás seguro de que si hablas primero, y sin permiso, él se enojará."
    "The walk back is awkward; Septem makes no effort to engage in conversation, and you're sure that if you speak first without his permission, he'll get angry."

# game/rutas/unum.rpy:465
translate ingles rutaunum2_3bc70022:

    # "Dentro de la residencia de Unum se encuentran con sus esposas, quienes están fuera de la habitación."
    "Inside Unum's residence, you encounter his wives, who are outside the room."

# game/rutas/unum.rpy:466
translate ingles rutaunum2_d849b822:

    # "Al notar la presencia de Septem, las tres agachan la cabeza a modo de saludo."
    "Noticing Septem's presence, all three lower their heads in greeting."

# game/rutas/unum.rpy:468
translate ingles rutaunum2_e8fd37e3:

    # septem "{sc=2}Alnitak ¿Se ha estabilizado la situación?{/sc}"
    septem "{sc=2}Alnitak, has the situation stabilized?{/sc}"

# game/rutas/unum.rpy:469
translate ingles rutaunum2_09c21fb1:

    # "Aeliana no responde y Septem parece darse cuenta del porqué, ya que con sus manos hace unas señas."
    "Aeliana remains silent, and Septem appears to understand why, as he gestures with his hands."

# game/rutas/unum.rpy:470
translate ingles rutaunum2_f9bb6d4c:

    # "Sus labios dejan de estar tensos y ella responde."
    "Her lips relax, and she replies."

# game/rutas/unum.rpy:472
translate ingles rutaunum2_628c3c9e:

    # aeliana "La señora Duae ha estabilizado a las nuevas estrellas."
    aeliana "Lady Duae has stabilized the new stars."

# game/rutas/unum.rpy:473
translate ingles rutaunum2_7d182e3a:

    # aeliana "Ya es seguro para [nombrejugador]."
    aeliana "It is now safe for [nombrejugador]."

# game/rutas/unum.rpy:476
translate ingles rutaunum2_5064d46d:

    # septem "{sc=2}Bien.{/sc}"
    septem "{sc=2}Good.{/sc}"

# game/rutas/unum.rpy:479
translate ingles rutaunum2_7dde6919:

    # "La puerta de la habitación se abre por si sola y Septem se abre paso por la habitación."
    "The door to the room opens by itself, and Septem makes his way through."

# game/rutas/unum.rpy:481
translate ingles rutaunum2_fffe0b43:

    # septem "{sc=2}Duae. Unum.{/sc}"
    septem "{sc=2}Duae. Unum.{/sc}"

# game/rutas/unum.rpy:484
translate ingles rutaunum2_57c81642:

    # septem "{sc=2}Les recuerdo que es primordial que [nombrejugador] esté en los momentos más cruciales.{/sc}"
    septem "{sc=2}I remind you that it's crucial for [nombrejugador] to be present at the most critical moments.{/sc}"

# game/rutas/unum.rpy:485
translate ingles rutaunum2_1d39ab6b:

    # septem "{sc=2}No volveré a tolerar que le saparen de ellos.{/sc}"
    septem "{sc=2}I will not tolerate them being taken away from them again.{/sc}"

# game/rutas/unum.rpy:486
translate ingles rutaunum2_b18abea2:

    # "Duae se enderesa completamente, como si de un soldado de bajo rango viera entrar a su general."
    "Duae stands up straight, as if a low-ranking soldier were witnessing a general's arrival."

# game/rutas/unum.rpy:488
translate ingles rutaunum2_46e5c82e:

    # duae "Septem, mil disculpas."
    duae "Septem, my apologies."

# game/rutas/unum.rpy:490
translate ingles rutaunum2_b9b0fef5:

    # unum "Le pedí que saliera porque la energía de todos está muy condensada en esta habitación."
    unum "I asked them to leave because the energy in this room is too condensed."

# game/rutas/unum.rpy:493
translate ingles rutaunum2_45d16377:

    # septem "{sc=2}Lo sé. Pero yo necesito que [nombrejugador] esté observando el desarrollo de ambos dioses.{/sc}"
    septem "{sc=2}I know. But I need [nombrejugador] to observe the development of both gods.{/sc}"

# game/rutas/unum.rpy:494
translate ingles rutaunum2_19423a7c:

    # septem "¿Ya están estables?"
    septem "{sc=2}Are they stable yet?{/sc}"

# game/rutas/unum.rpy:495
translate ingles rutaunum2_739ea829:

    # duae "Sí."
    duae "Yes."

# game/rutas/unum.rpy:496
translate ingles rutaunum2_50271c02:

    # septem "{sc=2}Okay. Duae, nos retiramos ahora.{/sc}"
    septem "{sc=2}Okay. Duae, we're leaving now.{/sc}"

# game/rutas/unum.rpy:497
translate ingles rutaunum2_32cba2a8:

    # septem "{sc=2}Unum.{/sc}"
    septem "{sc=2}Unum.{/sc}"

# game/rutas/unum.rpy:498
translate ingles rutaunum2_67c7a600:

    # unum "¿Sí?"
    unum "Yes?"

# game/rutas/unum.rpy:501
translate ingles rutaunum2_2e4c8762:

    # septem "{sc=2}Quiero una audiencia contigo en la noche.{/sc}"
    septem "{sc=2}I want an audience with you tonight.{/sc}"

# game/rutas/unum.rpy:504
translate ingles rutaunum2_07007670:

    # "Sin nada más que agregar, Septem se retira de la habitación con Duae."
    "Septem exits the room with Duae with a quick look in your direction."

# game/rutas/unum.rpy:505
translate ingles rutaunum2_c574fa64:

    # "Unum no se mueve hasta sentir que ambos Estandartes se encuentran lejos."
    "Unum doesn't move until he senses that both Symbols are far away."

# game/rutas/unum.rpy:509
translate ingles rutaunum2_afb157d6:

    # "Luego esboza una sonrisa."
    "Then he smiles."

# game/rutas/unum.rpy:510
translate ingles rutaunum2_b8d0b611:

    # unum "¡Mira!"
    unum "Look!"

# game/rutas/unum.rpy:513
translate ingles rutaunum2_d144f9c5:

    # "Se acerca a ti con ambas criaturas en los brazos."
    "He comes towards you, holding both creatures in his arms."

# game/rutas/unum.rpy:514
translate ingles rutaunum2_3ff20d31:

    # unum "Tienen un pulso al igual que tú."
    unum "They have a pulse, just like you."

# game/rutas/unum.rpy:515
translate ingles rutaunum2_caac6f86:

    # unum "Aunque tienen una frecuencia cardiaca muy diferente a la tuya."
    unum "Though their heart rate is very different from yours."

# game/rutas/unum.rpy:516
translate ingles rutaunum2_498306e6:

    # unum "¡Son tan lindos!"
    unum "They're so cute!"

# game/rutas/unum.rpy:517
translate ingles rutaunum2_26903031:

    # unum "Aún no los puedes tomar, su cuerpo aún está muy caliente."
    unum "You still can't hold them; their bodies are still too warm."

# game/rutas/unum.rpy:518
translate ingles rutaunum2_e079eb2b:

    # unum "Te puedes quemar tus manos."
    unum "You could burn your hands."

# game/rutas/unum.rpy:519
translate ingles rutaunum2_94004a03_1:

    # "Oh."
    "Oh."

# game/rutas/unum.rpy:520
translate ingles rutaunum2_85e4464a:

    # "Bueno, te conformarás con mirarlos de cerca."
    "Well, you'll have to be content with just watching them closely."

# game/rutas/unum.rpy:521
translate ingles rutaunum2_5e99e025:

    # "Cuando acercas tu cara, te das cuenta nuevamente del calor que el cuerpo de ambos bebés transmite."
    "As you lean in, you once again notice the heat radiating from both babies' bodies."

# game/rutas/unum.rpy:522
translate ingles rutaunum2_dfa94138:

    # nj "¿Cómo se llaman?"
    nj "What are their names?"

# game/rutas/unum.rpy:523
translate ingles rutaunum2_43102250_1:

    # unum "..."
    unum "..."

# game/rutas/unum.rpy:524
translate ingles rutaunum2_5f486fa5:

    # unum "Me gustaria esperar a que sea lo suficientemente grandes para que elijan sus propios nombres."
    unum "I'd like to wait until they're old enough to choose their own names."

# game/rutas/unum.rpy:525
translate ingles rutaunum2_65bec9e9:

    # nj "¿Por qué?"
    nj "Why?"

# game/rutas/unum.rpy:526
translate ingles rutaunum2_d9e19abb:

    # unum "Quiero que sean libres."
    unum "I want them to be free."

# game/rutas/unum.rpy:527
translate ingles rutaunum2_5b0636df:

    # unum "Que hagan lo que quieran hasta..."
    unum "Let them do as they please until..."

# game/rutas/unum.rpy:528
translate ingles rutaunum2_7887e408:

    # "Unum cierra su boca antes de terminar la frase."
    "Unum cuts himself off before finishing the sentence."

# game/rutas/unum.rpy:529
translate ingles rutaunum2_626a601e:

    # "Y luego ríe nervioso."
    "And then he laughs nervously."

# game/rutas/unum.rpy:530
translate ingles rutaunum2_532d8aa6:

    # unum "Septem dijo que crecerán rápido."
    unum "Septem said they'll grow fast."

# game/rutas/unum.rpy:531
translate ingles rutaunum2_097415b2:

    # unum "Posiblemente mañana ya no sean así de pequeñitos."
    unum "Maybe tomorrow they won't be this little."

# game/rutas/unum.rpy:532
translate ingles rutaunum2_a20cefa7_4:

    # "..."
    "..."

# game/rutas/unum.rpy:534
translate ingles rutaunum2_49f71e47:

    # "Pasan gran parte del tiempo cuidando de los bebés."
    "You two spend most of your time taking care of the babies."

# game/rutas/unum.rpy:535
translate ingles rutaunum2_0a771cc9:

    # "Bueno.. tú le das instrucciones a Unum para los cuidados, ya que aún no puedes tocarlos."
    "Well... you instruct Unum on how to care for them, as you still can't touch them."

# game/rutas/unum.rpy:536
translate ingles rutaunum2_697d208b:

    # "...y lo has comprobado por ti mismo, cuando intentaste tocar la mejilla de uno de ellos. Te quemaste la mano."
    "... And you've confirmed it yourself when you tried to touch one of their cheeks. You burned your hand."

# game/rutas/unum.rpy:537
translate ingles rutaunum2_df219f40:

    # "Unum casi llama a Quinque para que viniera a curarte, pero tú le has dicho que no es necesario."
    "Unum almost calls Quinque to come and heal you, but you've told him it's not necessary."

# game/rutas/unum.rpy:538
translate ingles rutaunum2_c89610ab:

    # "Cuando llega la noche, Unum se excusa con que debe hacer algo importante y se lleva a ambos bebés consigo."
    "When night falls, Unum excuses himself, saying he must do something important, and he takes both babies with him."

# game/rutas/unum.rpy:539
translate ingles rutaunum2_45b8b25e:

    # "Te pide que descanses y duermas para que mañana tengas todas tus energías."
    "He asks you to rest and sleep so that you'll have all the energy you need tomorrow."

# game/rutas/unum.rpy:540
translate ingles rutaunum2_cbc5d701:

    # "Así que descansas."
    "So you rest."

# game/rutas/unum.rpy:542
translate ingles rutaunum2_a20cefa7_5:

    # "..."
    "..."

# game/rutas/unum.rpy:544
translate ingles rutaunum2_870d17f8:

    # "Hoy sueñas."
    "You dream."

# game/rutas/unum.rpy:545
translate ingles rutaunum2_f1e3fba5:

    # "Por primera vez en tu corta existencia este mundo."
    "For the first time in your short existence in this small world, you dream."

# game/rutas/unum.rpy:546
translate ingles rutaunum2_8bacc769:

    # "Estás en un lugar oscuro."
    "You are in a dark place."

# game/rutas/unum.rpy:547
translate ingles rutaunum2_60fba90c:

    # "Y se escucha una voz."
    "And you hear a voice."

# game/rutas/unum.rpy:548
translate ingles rutaunum2_2a0dd69c:

    # "Pero no logras identificar que es lo que dice."
    "But you can't make out what it's saying."

# game/rutas/unum.rpy:549
translate ingles rutaunum2_a20cefa7_6:

    # "..."
    "..."

# game/rutas/unum.rpy:551
translate ingles rutaunum2_6e2b36cb:

    # "No sabes cómo ni cuándo, pero ya es el otro día."
    "You don't know how or when, but it's already the next day."

# game/rutas/unum.rpy:554
translate ingles rutaunum2_695da15a:

    # "Y lo primero que miras al abrir los ojos son tus manos."
    "And the first thing you see when you open your eyes is your hands."

# game/rutas/unum.rpy:555
translate ingles rutaunum2_4513ef06:

    # "El negro se ha comido más piel..."
    "The darkness has devoured more skin..."

# game/rutas/unum.rpy:557
translate ingles rutaunum2_fd0a610d:

    # "Lo segundo que tus ojos ven es a Unum recostado a tu lado, mirándote con mucha atención."
    "The second thing your eyes spot is Unum lying next to you, watching you intently."

# game/rutas/unum.rpy:559
translate ingles rutaunum2_52cf7a6d:

    # unum "Eres una criatura asombrosa."
    unum "You're an amazing creature."

# game/rutas/unum.rpy:560
translate ingles rutaunum2_4bc84aa1:

    # unum "Jamás creí que podría ser esposo de un humano."
    unum "I never thought I could be the husband of a human."

# game/rutas/unum.rpy:561
translate ingles rutaunum2_853842b0:

    # "¿Esposo?"
    "Husband?"

# game/rutas/unum.rpy:562
translate ingles rutaunum2_95ca30d2:

    # "¿Cuántos pasos se ha saltado este hombre?"
    "How many steps has this man skipped?"

# game/rutas/unum.rpy:563
translate ingles rutaunum2_39cb9abf:

    # "¿Desde cuándo él piensa que ustedes están en una relación? ¿Será así con todos los estandartes o es solo Unum quien no tiene idea de como funcionan las relaciones?"
    "Since when does he think that you are in a relationship? Is it like that with all the Symbols, or is it just Unum who has no idea how relationships work?"

# game/rutas/unum.rpy:564
translate ingles rutaunum2_6960d4ae:

    # "Sueltas una risa por lo extraño que te parece estar en esta relación."
    "You let out a laugh at how strange it is to be in this relationship."

# game/rutas/unum.rpy:566
translate ingles rutaunum2_8f58de10:

    # "Unum te mira confundido."
    "Unum looks at you, confused."

# game/rutas/unum.rpy:570
translate ingles rutaunum2_a431e742:

    # unum "¿No somos ya?"
    unum "Aren't we already?"

# game/rutas/unum.rpy:571
translate ingles rutaunum2_eeefef64:

    # "No puedes evitar dejar salir la carcajada que se forma en tu garganta."
    "You can't help but let out a laugh from your throat."

# game/rutas/unum.rpy:572
translate ingles rutaunum2_4b041256:

    # unum "Pero si hasta ya hemos tenido descendencia... y vives conmigo."
    unum "But we've even had children... and you live with me."

# game/rutas/unum.rpy:573
translate ingles rutaunum2_69b86eb6:

    # unum "Según lo que he leído, eso es más que suficiente para llamarnos esposos."
    unum "According to what I've read, that's more than enough to call us spouses."

# game/rutas/unum.rpy:574
translate ingles rutaunum2_7c382ca5:

    # "Vuelves a soltar otra risa."
    "You let out another laugh."

# game/rutas/unum.rpy:575
translate ingles rutaunum2_85703d1a:

    # unum "¡No te rias!"
    unum "Don't laugh!"

# game/rutas/unum.rpy:576
translate ingles rutaunum2_e6a69475:

    # nj "¡Está bien! ¡está bien!"
    nj "Alright! Alright!"

# game/rutas/unum.rpy:577
translate ingles rutaunum2_3dcae893:

    # nj "No sé cómo serán las relaciones de la gente del jardín... pero los humanos necesitamos tiempo y acuerdos para llegar a tener ese título."
    nj "I don't know how relationships work among the Garden people... but we humans need time and agreements before we can earn that title."

# game/rutas/unum.rpy:578
translate ingles rutaunum2_89abb2ff_1:

    # unum "Oh."
    unum "Oh."

# game/rutas/unum.rpy:579
translate ingles rutaunum2_a7e57ce8:

    # unum "¿Me podrías explicar?"
    unum "Could you explain it to me?"

# game/rutas/unum.rpy:580
translate ingles rutaunum2_8390df35:

    # unum "Aquí no hay ningún libro que te explique eso."
    unum "There's no book here that explains that to you."

# game/rutas/unum.rpy:581
translate ingles rutaunum2_b862c9c2:

    # "No tienes problemas con explicarle lo que se necesita para convertirse en 'esposos' a Unum, aunque recalcas que para todos es distinto."
    "You have no trouble explaining to Unum what it takes to become your 'husband,' although you emphasize that it's different for everyone."

# game/rutas/unum.rpy:583
translate ingles rutaunum2_8d054313:

    # unum "Mmm."
    unum "Mmm."

# game/rutas/unum.rpy:584
translate ingles rutaunum2_9af500f7:

    # unum "Si me esfuerzo... ¿Podría ser yo tu esposo?"
    unum "If I try... could I be your husband?"

# game/rutas/unum.rpy:588
translate ingles rutaunum2_d4a8f869:

    # "Unum sonríe mostrando todos sus dientes, victorioso."
    "Unum smiles, baring all his teeth, triumphantly."

# game/rutas/unum.rpy:591
translate ingles rutaunum2_0e6e8397:

    # "Unum sonrie."
    "Unum smiles."

# game/rutas/unum.rpy:594
translate ingles rutaunum2_89abb2ff_2:

    # unum "Oh."
    unum "Oh."

# game/rutas/unum.rpy:597
translate ingles rutaunum2_a59e8cb5:

    # "No te da el corazón para corregirlo."
    "You don't have the heart to correct him."

# game/rutas/unum.rpy:598
translate ingles rutaunum2_f345179f:

    # "Que crea lo que quiera creer."
    "Let him believe whatever he wants."

# game/rutas/unum.rpy:600
translate ingles rutaunum2_43102250_2:

    # unum "..."
    unum "..."

# game/rutas/unum.rpy:603
translate ingles rutaunum2_1055a640:

    # unum "Quería mostrarte el resto de mi dominio hoy, pero Septem dijo que es peligroso que salgas."
    unum "I wanted to show you the rest of my domain today, but Septem said it's dangerous for you to go out."

# game/rutas/unum.rpy:604
translate ingles rutaunum2_249f6558:

    # unum "Así que nos tendremos que quedar en el templo hasta que las estrellas hayan crecido."
    unum "So we'll have to stay in the temple until the stars have grown."

# game/rutas/unum.rpy:605
translate ingles rutaunum2_c74f84cd:

    # unum "No quiero perderme nada, ningún momento de su desarrollo."
    unum "I don't want to miss a thing, not a single moment of their development."

# game/rutas/unum.rpy:606
translate ingles rutaunum2_5a7eead7:

    # nj "¿Estás emocionado?"
    nj "Are you excited?"

# game/rutas/unum.rpy:607
translate ingles rutaunum2_3f8d2e0e:

    # unum "¡Claro! Además, te tengo a mi lado, lo que lo hace aún mejor."
    unum "Of course! Besides, I have you by my side, which makes it even better."

# game/rutas/unum.rpy:608
translate ingles rutaunum2_9867c2bd:

    # unum "Somos como las familias que Sextam adoraba ver crecer."
    unum "We're like the families that Sextam loved to watch grow."

# game/rutas/unum.rpy:609
translate ingles rutaunum2_9df6227f:

    # unum "¡Oh! Podríamos invitarla cuando deje sus rezos."
    unum "Oh! We could invite her when she finishes her prayers."

# game/rutas/unum.rpy:611
translate ingles rutaunum2_a8204b60:

    # "Unum se levanta de la cama y te mira con emoción."
    "Unum gets out of bed and looks at you excitedly."

# game/rutas/unum.rpy:613
translate ingles rutaunum2_83596e2d:

    # unum "Las chicas están cuidando de ellos, mientras, nosotros haremos el desayuno."
    unum "The girls are taking care of them, while we make breakfast."

# game/rutas/unum.rpy:614
translate ingles rutaunum2_29681fc1:

    # "Vaya... parece que Unum se está tomando las palabras de Aeliana en serio..."
    "Wow... it seems that Unum is taking Aeliana's words seriously..."

# game/rutas/unum.rpy:615
translate ingles rutaunum2_c166c775:

    # "Increíble."
    "Incredible."

# game/rutas/unum.rpy:619
translate ingles rutaunum2_6d9124ca:

    # "Caminan a la cocina y Unum se encarga de hacer el ritual de santificación antes de comenzar a preparar el desayuno."
    "You walk to the kitchen, and Unum performs the sanctification ritual before starting to prepare breakfast."

# game/rutas/unum.rpy:620
translate ingles rutaunum2_51d69029:

    # "Tú le ayudas en algunas cosas, pero él es quien hace la mayoría de las cosas, copia con exactitud lo preparado por las chicas el día anterior."
    "You help him with some tasks, but he does most of the work, precisely replicating what the girls prepared the day before."

# game/rutas/unum.rpy:621
translate ingles rutaunum2_1e169274:

    # "Y luego de un tiempo cocinando, el desayuno ya está listo."
    "And after a while of cooking, breakfast is ready."

# game/rutas/unum.rpy:622
translate ingles rutaunum2_15b6b1f7:

    # "Inflando el pecho, Unum mira con orgullo el resultado."
    "Puffing out his chest, Unum looks at the result with pride."

# game/rutas/unum.rpy:623
translate ingles rutaunum2_9028817e:

    # "Pero al instante se desinfla como un globo."
    "But instantly, he deflates like a balloon."

# game/rutas/unum.rpy:625
translate ingles rutaunum2_e8917953:

    # unum "Ahhhhhh- extraño ver a mis esposas cocinar...."
    unum "Ahhhhhh--I miss watching my wives cook...."

# game/rutas/unum.rpy:628
translate ingles rutaunum2_6e733382:

    # solaris "Veo que lo hiciste bastante bien."
    solaris "I see you did quite well."

# game/rutas/unum.rpy:630
translate ingles rutaunum2_01e0f844:

    # "Solaris entra por la puerta, sonriendo de medio lado."
    "Solaris enters through the door, with a half-smile."

# game/rutas/unum.rpy:631
translate ingles rutaunum2_73ff0b14:

    # solaris "Parece que ahora serás tú el encargado de cocinar, querido."
    solaris "It seems that now you'll be the one in charge of cooking, dear."

# game/rutas/unum.rpy:634
translate ingles rutaunum2_ee396c73:

    # unum "Solo si me acompañan."
    unum "Only if you join me."

# game/rutas/unum.rpy:635
translate ingles rutaunum2_311b3238:

    # solaris "Lo pensaremos."
    solaris "We'll think about it."

# game/rutas/unum.rpy:636
translate ingles rutaunum2_54d494d6:

    # solaris "¿Necesitan ayuda para colocar la mesa?"
    solaris "Do you need help setting the table?"

# game/rutas/unum.rpy:639
translate ingles rutaunum2_222f50fb:

    # unum "Si, por favor."
    unum "Yes, please."

# game/rutas/unum.rpy:641
translate ingles rutaunum2_e3dc3e3e:

    # "Es extraño..."
    "It's strange..."

# game/rutas/unum.rpy:642
translate ingles rutaunum2_82de9e3b:

    # "Esto es totalmente extraño. Jamás te imaginaste que convivir con ellos sería tan.... ¿normal?"
    "This is totally strange. You never imagined that living with them would be so... normal?"

# game/rutas/unum.rpy:643
translate ingles rutaunum2_520b4f78:

    # "¿Dónde se fue ese Unum sobreexaltado por cualquier cosa? ¿Ese que intentaba atacarte a la minima reacción de tu cuerpo?"
    "Where did that Unum, so overexcited about everything, go? The one who used to try to attack you at the slightest reaction of your body?"

# game/rutas/unum.rpy:644
translate ingles rutaunum2_369e8f0d:

    # "¿Dónde está el truco?"
    "What's the catch?"

# game/rutas/unum.rpy:645
translate ingles rutaunum2_a20cefa7_7:

    # "..."
    "..."

# game/rutas/unum.rpy:646
translate ingles rutaunum2_1a730561:

    # "¿Será que luego te comerán? después de todo son entidades que comen carne de humanos..."
    "Could it be that they'll end up eating you? After all, they are entities that eat human flesh..."

# game/rutas/unum.rpy:647
translate ingles rutaunum2_9daf6193:

    # "¿Realmente estás jugando a la familia feliz?"
    "Are you really playing at being a happy family?"

# game/rutas/unum.rpy:648
translate ingles rutaunum2_18f24bab:

    # unum "¿[nombrejugador]?"
    unum "[nombrejugador]?"

# game/rutas/unum.rpy:649
translate ingles rutaunum2_0fbdf1df:

    # nj "¡Ah! ¿s-sí?"
    nj "Ah! Y-yes?"

# game/rutas/unum.rpy:651
translate ingles rutaunum2_180b3f67:

    # unum "¿Los bebés humanos pueden comer en la mesa?"
    unum "Can human babies eat at the table?"

# game/rutas/unum.rpy:652
translate ingles rutaunum2_634f344a:

    # nj "¿Qué?"
    nj "What?"

# game/rutas/unum.rpy:655
translate ingles rutaunum2_b42efa75:

    # unum "Sinceramente no me los imagino sentados en la mesa con un tenedor y un cuchillo en las manos..."
    unum "Honestly, I can't imagine them sitting at the table with a fork and a knife in their hands..."

# game/rutas/unum.rpy:656
translate ingles rutaunum2_163eefdf:

    # unum "Sus manos son muy pequeñas y no tienen tanta coordinación con ellas."
    unum "Their hands are very small, and they don't have much coordination with them."

# game/rutas/unum.rpy:657
translate ingles rutaunum2_d0c7dcdd:

    # unum "Bueno... no tiene coordinación en nada."
    unum "Well... they have no coordination at all."

# game/rutas/unum.rpy:658
translate ingles rutaunum2_644f31ec:

    # "Respiras hondo antes de contestar, y recuerdas que Unum es una entidad totalmente opuesta a ti."
    "You take a deep breath before answering, and you remember that Unum is an entity completely opposite to you."

# game/rutas/unum.rpy:659
translate ingles rutaunum2_354aa241:

    # "Que solo sabe de los humanos gracias a lo que ha leído."
    "Who only knows about humans from what he's read."

# game/rutas/unum.rpy:660
translate ingles rutaunum2_a95b9c53:

    # "Y solo dios sabe que cosas que estado leyendo..."
    "And God knows what he's been reading..."

# game/rutas/unum.rpy:662
translate ingles rutaunum2_cf0a743e:

    # "Los días pasan rápido, más rápido de lo que te gustaría confesar. Con la presencia de Unum y sus esposas en casa, no hay momento en que te quedes solo."
    "The days pass quickly, faster than you'd care to admit. With Unum and his wives at home, there's never a moment when you're alone."

# game/rutas/unum.rpy:663
translate ingles rutaunum2_eaccfd17:

    # "Siempre hay algo que hacer, y siempre resulta ser algo agradable."
    "There's always something to do, and it's always something pleasant."

# game/rutas/unum.rpy:664
translate ingles rutaunum2_3f66c4ea:

    # "Bueno... no siempre."
    "Well... not always."

# game/rutas/unum.rpy:666
translate ingles rutaunum2_73b3a939:

    # unum "¿Puedes pelar esto?"
    unum "Can you peel this?"

# game/rutas/unum.rpy:667
translate ingles rutaunum2_1b1f14c0:

    # unum "Tengo que ir a preguntar a Ignis una cosa."
    unum "I have to go ask Ignis something."

# game/rutas/unum.rpy:668
translate ingles rutaunum2_b6648de1:

    # nj "Claro."
    nj "Of course."

# game/rutas/unum.rpy:670
translate ingles rutaunum2_a078de69:

    # "Cuando tomas el cuchillo y la fruta en tu mano te das cuenta de que tal vez no solo el color de tu piel está cambiando, sino que también tu movilidad en tus dedos."
    "When you take the knife and the fruit in your hand, you realize that perhaps not only is the color of your skin changing, but also the mobility of your fingers."

# game/rutas/unum.rpy:671
translate ingles rutaunum2_2d82248a:

    # "Te cuesta coordinar y ejercer presión, pero aún lo puedes hacer."
    "You find it hard to coordinate and apply pressure, but you can still do it."

# game/rutas/unum.rpy:673
translate ingles rutaunum2_a3333c09:

    # "Estás a punto de terminar de pelar cuando Unum aparece por detrás tuya, tocandote los hombros."
    "You're about to finish peeling when Unum appears behind you, touching your shoulders."

# game/rutas/unum.rpy:674
translate ingles rutaunum2_b4545730:

    # unum "¡HAHA! Lo haces mejor que yo."
    unum "HAHA! You do it better than I do."

# game/rutas/unum.rpy:677
translate ingles rutaunum2_7e0ed29c:

    # "Y solo eso basta para desconcentrarte y cortarte con el cuchillo la palma de tu mano."
    "And that's enough to distract you, causing you to cut the palm of your hand with the knife."

# game/rutas/unum.rpy:678
translate ingles rutaunum2_8ea05879:

    # "El corte es profundo."
    "The cut is deep."

# game/rutas/unum.rpy:679
translate ingles rutaunum2_0d5d6415:

    # "Y la sangre sale de ahí a cantidades preocupantes."
    "And blood flows out in concerning amounts."

# game/rutas/unum.rpy:681
translate ingles rutaunum2_0b3625af:

    # "Luego todo es un caos."
    "Then everything descends into chaos."

# game/rutas/unum.rpy:682
translate ingles rutaunum2_fda68762:

    # "Estás agradecido de que Unum no te haya desgarrado la mano de un solo bocado."
    "You're thankful that Unum didn't rip your hand off in one bite."

# game/rutas/unum.rpy:683
translate ingles rutaunum2_6452d7e0:

    # "Por qué a quien vamos a mentir, sabes que lo único que quería hacer en ese momento era comerte entero."
    "Let's be honest, you know that what he really wanted to do at that moment was to eat you whole."

# game/rutas/unum.rpy:684
translate ingles rutaunum2_3f3ba2ee:

    # "De pies a cabeza."
    "From head to toe."

# game/rutas/unum.rpy:688
translate ingles rutaunum2_1eb10702:

    # "Para el cuarto día, y poco a poco, te vas abriendo a cada una de las esposas de Unum."
    "By the fourth day, little by little, you start opening up to each of Unum's wives."

# game/rutas/unum.rpy:689
translate ingles rutaunum2_bcb11458:

    # "Y al igual que el pelirrojo, están deseosas de saber más de los humanos."
    "And, like the redhead, they're eager to learn more about humans."

# game/rutas/unum.rpy:690
translate ingles rutaunum2_a8c35fe4:

    # "Gracias a ellas descubres que ambos bebés necesitan estás juntos."
    "Thanks to them, you discover that both babies need to be together."

# game/rutas/unum.rpy:691
translate ingles rutaunum2_e8a9dc5b:

    # "'Son estrellas binarias, lo que significa que están ligadas permanentemente por una cola en una danza infinita' dijo Ignis una vez."
    "'They are binary stars, which means they are permanently linked by a tail in an endless dance,' Ignis once said."

# game/rutas/unum.rpy:692
translate ingles rutaunum2_9fb455e2:

    # "Aunque hay una gran preocupación en las caras de las chicas cuando hablan de ello, pero cada vez que les preguntas por la razón, ellas cambian el tema."
    "Although there is great concern on the girls' faces when they talk about it, every time you ask them why, they change the subject."

# game/rutas/unum.rpy:694
translate ingles rutaunum2_ece2d1f0:

    # "Al quinto día descubres el nombre de origen de ambos y si te concentras bien, enfocando tu mirada en los niños, puedes ver una cola."
    "On the fifth day, you discover their original name, and if you focus your gaze on the children, you can see a tail."

# game/rutas/unum.rpy:695
translate ingles rutaunum2_eb1cf341:

    # "Sirius, ese es el nombre que ambos comparten, Aeliana te explicó que eso es debido a que ambos nacieron al mismo tiempo."
    "Sirius, that is the name they both share. Aeliana explained to you that this is because they were born at the same time."

# game/rutas/unum.rpy:696
translate ingles rutaunum2_28fdc2ca:

    # "Pero no debes preocuparte pues solo será un nombre que nadie utilizará luego de que ambos dioses escojan sus propios nombres."
    "But you shouldn't worry because it's a name no one will use after both gods choose their own."

# game/rutas/unum.rpy:697
translate ingles rutaunum2_1f23f203:

    # "No puedes pasar mucho tiempo con ellos dentro de una habitación ya que su presencia te quema la piel, y te impide respirar con normalidad."
    "You can't spend too much time with them in one room because their presence burns your skin and prevents you from breathing normally."

# game/rutas/unum.rpy:698
translate ingles rutaunum2_a8e95963:

    # "Al menos ahora los puedes cargar por un pequeño tiempo... y, no puedes evitar pensar que son lindos. Ambos se parecen a Unum, no tienen ningún parecido a ti físicamente. Y cuando le comentas esto a Unum, él solamente suelta una carcajada."
    "At least now you can carry them for a short time... and you can't help but think they're cute. They both resemble Unum; they don't physically resemble you at all. And when you mention this to Unum, he just laughs."

# game/rutas/unum.rpy:700
translate ingles rutaunum2_e1617d7e:

    # "Recuerdas vividamente las palabras que salieron del dios del Sol en ese momento."
    "You vividly remember the words that came from the sun god at that moment."

# game/rutas/unum.rpy:702
translate ingles rutaunum2_0c9aeb02:

    # unum "Ambos comparten un corazón y esencia parecida a la tuya."
    unum "They both share a heart and an essence similar to yours."

# game/rutas/unum.rpy:703
translate ingles rutaunum2_a4d0247f:

    # unum "Y eso... es mil veces mejor que si tuvieran una apariencia parecida a la mía."
    unum "And that... is a thousand times better than having an appearance similar to mine."

# game/rutas/unum.rpy:704
translate ingles rutaunum2_65bec9e9_1:

    # nj "¿Por qué?"
    nj "Why?"

# game/rutas/unum.rpy:706
translate ingles rutaunum2_47f322ed:

    # unum "Porque ahora puedo sentir tu corazón, acompañado de dos melodías más."
    unum "Because now I can feel your heart, accompanied by two more melodies."

# game/rutas/unum.rpy:707
translate ingles rutaunum2_8c4f09db:

    # unum "Son diferentes, pero... la de ellos nace de la tuya, y juntas hacen la sinfonía más bella que he podido de escuchar."
    unum "They are different, but... theirs comes from yours, and together they create the most beautiful symphony I've ever heard."

# game/rutas/unum.rpy:708
translate ingles rutaunum2_3824e4c5:

    # "... aún no puedes creer que Unum te haya dicho aquello."
    "... You still can't believe Unum said that to you."

# game/rutas/unum.rpy:709
translate ingles rutaunum2_67b9a34d:

    # "Cada vez que lo recuerdas, sientes tus mejillas calentarse."
    "Every time you remember it, you feel your cheeks warm up."

# game/rutas/unum.rpy:710
translate ingles rutaunum2_a20cefa7_8:

    # "..."
    "..."

# game/rutas/unum.rpy:714
translate ingles rutaunum2_ec448326:

    # "Al séptimo día, un domingo, Septem viene a ver a tus bebés."
    "On the seventh day, a Sunday, Septem comes to see your babies."

# game/rutas/unum.rpy:715
translate ingles rutaunum2_8a7b8f97:

    # "Los mira por un solo segundo y luego te observa a ti."
    "He looks at them for just a second and then turns his gaze to you."

# game/rutas/unum.rpy:717
translate ingles rutaunum2_5e6f5a5e:

    # septem "{sc=2}Tus manos...{/sc}"
    septem "{sc=2}Your hands...{/sc}"

# game/rutas/unum.rpy:718
translate ingles rutaunum2_b163b27e:

    # nj "Ah... no es nada."
    nj "Ah... it's nothing."

# game/rutas/unum.rpy:721
translate ingles rutaunum2_8d6f2787:

    # septem "{sc=2}Buscaré una solución para eso.{/sc}"
    septem "{sc=2}I'll find a solution for that.{/sc}"

# game/rutas/unum.rpy:723
translate ingles rutaunum2_74ed525b:

    # "Sin explicarse, se retira."
    "Without explanation, he leaves."

# game/rutas/unum.rpy:725
translate ingles rutaunum2_c5206656:

    # unum "Ahora que Septem lo menciona."
    unum "Now that Septem mentioned it."

# game/rutas/unum.rpy:726
translate ingles rutaunum2_d9733823:

    # "Dice Unum mientras se acerca a inspeccionar tus manos."
    "Unum says as he approaches to inspect your hands."

# game/rutas/unum.rpy:727
translate ingles rutaunum2_98b19d64:

    # unum "Tus manos y brazos han cambiado con el tiempo."
    unum "Your hands and arms have changed over time."

# game/rutas/unum.rpy:728
translate ingles rutaunum2_f78de71d:

    # unum "¿Qué pasa con ellas?"
    unum "What's wrong with them?"

# game/rutas/unum.rpy:731
translate ingles rutaunum2_faa348c5:

    # unum "...no te preocupes."
    unum "... Don't worry."

# game/rutas/unum.rpy:734
translate ingles rutaunum2_e08f7e5d:

    # unum "Septem siempre cumple su palabra."
    unum "Septem always keeps his word."

# game/rutas/unum.rpy:737
translate ingles rutaunum2_e4d5264f:

    # unum "Siempre."
    unum "Always..."

# game/rutas/unum.rpy:738
translate ingles rutaunum2_5f9b772e:

    # "...."
    "..."

# game/rutas/unum.rpy:741
translate ingles rutaunum2_5c426c30:

    # unum "Hmmm..."
    unum "Hmmm..."

# game/rutas/unum.rpy:742
translate ingles rutaunum2_5f9b772e_1:

    # "...."
    "..."

# game/rutas/unum.rpy:747
translate ingles rutaunum2_142febb5:

    # unum "¡Oh!"
    unum "Oh!"

# game/rutas/unum.rpy:748
translate ingles rutaunum2_5f9b772e_2:

    # "...."
    "...."

# game/rutas/unum.rpy:752
translate ingles rutaunum2_387636ff_1:

    # unum "Hmmm."
    unum "Hmmm."

# game/rutas/unum.rpy:753
translate ingles rutaunum2_2bd27731:

    # unum "¡Hey!"
    unum "Hey!"

# game/rutas/unum.rpy:754
translate ingles rutaunum2_4a75d9ad:

    # nj "¿Si?"
    nj "Yeah?"

# game/rutas/unum.rpy:757
translate ingles rutaunum2_a9611073:

    # unum "He estado viendo a Sirius dormir... y creo que sueñan."
    unum "I've been watching Sirius sleep... and I think they dream."

# game/rutas/unum.rpy:758
translate ingles rutaunum2_67f16631:

    # unum "Se mueven y hacen gestos mientras duermen."
    unum "They move and make gestures while they sleep."

# game/rutas/unum.rpy:759
translate ingles rutaunum2_7647118d:

    # unum "¡Por lo que sueñan!"
    unum "Just imagine what they dream about!"

# game/rutas/unum.rpy:762
translate ingles rutaunum2_ed6f95bb:

    # unum "Ah---- muchas gracias por darme este cambio."
    unum "Ah... thank you so much for giving me this change."

# game/rutas/unum.rpy:763
translate ingles rutaunum2_ae269dbb:

    # unum "Realmente eres lo mejor que me ha pasado en un largo tiempo."
    unum "You're truly the best thing that's happened to me in a long time."

# game/rutas/unum.rpy:765
translate ingles rutaunum2_2056d851:

    # "Unum comienza a acercarse para rodearte con sus brazos. Él es tan alto y su complexión es tan grande que no puedes evitar sentirte enano a comparación."
    "Unum starts to move closer to wrap you in his arms. He's so tall and his build is so massive that you can't help but feel dwarfed in comparison."

# game/rutas/unum.rpy:766
translate ingles rutaunum2_5f69f481:

    # "Su abrazo es cálido, el sentimiento de que en cualquier momento te puede arrandar un trozo de piel con sus dientes no deja tu cabeza por nada del mundo."
    "His embrace is warm, yet the thought that he could rip a piece of your skin off with his teeth at any moment refuses to leave your mind."

# game/rutas/unum.rpy:767
translate ingles rutaunum2_d16c4fd7:

    # unum "Realmente me gusta tenerte aquí."
    unum "I really like having you here."

# game/rutas/unum.rpy:768
translate ingles rutaunum2_6e81d3ed:

    # unum "Me gusta tu calor, tu olor y tus latidos."
    unum "I love your warmth, your scent, and your heartbeat."

# game/rutas/unum.rpy:769
translate ingles rutaunum2_0951e3a3:

    # unum "Lo mortal y cambiante que eres."
    unum "The fact that you're mortal and ever-changing."

# game/rutas/unum.rpy:771
translate ingles rutaunum2_d1ac4799:

    # "Unum suelta un poco su agarre para tomar una de tus manos."
    "Unum loosens his grip slightly to take one of your hands."

# game/rutas/unum.rpy:772
translate ingles rutaunum2_4ea9dffd:

    # "Y la inspecciona mientras traza con su pulgar la costra que se te ha formado."
    "And he inspects it while tracing the scab that has formed on you with his thumb."

# game/rutas/unum.rpy:773
translate ingles rutaunum2_bbf1f604:

    # unum "...y lo adaptable que eres."
    unum "... And how adaptable you are."

# game/rutas/unum.rpy:776
translate ingles rutaunum2_2be47149:

    # unum "Mmm, hahaha."
    unum "Mmm, hahaha."

# game/rutas/unum.rpy:777
translate ingles rutaunum2_83c3ec86:

    # "Unum te ignora."
    "Unum ignores you."

# game/rutas/unum.rpy:781
translate ingles rutaunum2_36dc803d:

    # "Sin aviso lleva tu mano a su boca para lamerla."
    "Without warning, he takes your hand to his mouth and licks it."

# game/rutas/unum.rpy:782
translate ingles rutaunum2_586a0678:

    # "Tu corazon late a mil, aunque no sabes si es por miedo o otra cosa..."
    "Your heart is racing, though you're not sure if it's from fear or something else..."

# game/rutas/unum.rpy:783
translate ingles rutaunum2_170c5181:

    # unum "Ahhh~--"
    unum "Ahhh~--"

# game/rutas/unum.rpy:784
translate ingles rutaunum2_9f40a949:

    # "Su cara se acerca peligrosamente a la tuya."
    "His face draws dangerously close to yours."

# game/rutas/unum.rpy:787
translate ingles rutaunum2_d7ac5292:

    # unum "Pero también me dan ganas de comerte..."
    unum "But you also make me want to devour you..."

# game/rutas/unum.rpy:788
translate ingles rutaunum2_5c6f6d00:

    # unum "Esa vez que te cortaste con el cuchillo pelando la fruta."
    unum "Remember that time you cut yourself peeling the fruit with a knife?"

# game/rutas/unum.rpy:789
translate ingles rutaunum2_8c79e1d6:

    # unum "Fue de lo peor."
    unum "It was terrible."

# game/rutas/unum.rpy:790
translate ingles rutaunum2_0d7f220a:

    # unum "Si no me gustaras tanto, probablemente te abría destripado ahí mismo."
    unum "If I didn't like you so much, I probably would have gutted you right then."

# game/rutas/unum.rpy:791
translate ingles rutaunum2_98ab3d03:

    # "¿¿¿Qué clase de comentario es ese y por qué lo dice como si fuera un cumplido???"
    "What kind of comment is that, and why does he say it like it's a compliment???"

# game/rutas/unum.rpy:793
translate ingles rutaunum2_46b2bd93:

    # unum "Pero no te preocupes."
    unum "But don't worry."

# game/rutas/unum.rpy:794
translate ingles rutaunum2_fddf0792:

    # unum "Te voy a cuidar."
    unum "I'll take care of you."

# game/rutas/unum.rpy:796
translate ingles rutaunum2_ba753bc2:

    # "Sin explicar su razonamiento más allá de una sonrisa, Unum te planta un beso en los labios."
    "Without further explanation than a smile, Unum presses a kiss to your lips."

# game/rutas/unum.rpy:800
translate ingles rutaunum2_3181b7d1:

    # "Más días pasan y te cuesta un poco creer lo rápido que crecen los niños... Te has acostumbrado a decirles 'los niños' y no por su nombre de origen"
    "Days pass, and you find it hard to believe how quickly the children grow... You've gotten used to calling them 'the children' instead of their original names."

# game/rutas/unum.rpy:801
translate ingles rutaunum2_e267311a:

    # "Ahora que pueden caminar sueles pasar gran parte del día en el jardín junto con ellos, ya que aún es peligroso estar mucho tiempo con ellos dentro de un lugar cerrado."
    "Now that they can walk, you spend most of your day in the garden with them, since it's still too dangerous to be indoors with them for long periods of time."

# game/rutas/unum.rpy:802
translate ingles rutaunum2_3d1c0af3:

    # "La energía que ellos liberan es muy inestable y peligrosa para un cuerpo como el tuyo."
    "The energy they release is very unstable and dangerous for a body like yours."

# game/rutas/unum.rpy:803
translate ingles rutaunum2_a20cefa7_9:

    # "..."
    "..."

# game/rutas/unum.rpy:805
translate ingles rutaunum2_1114cc3f:

    # "Son adorables."
    "They're adorable."

# game/rutas/unum.rpy:806
translate ingles rutaunum2_a6ed7281:

    # "Es adorable verlos jugar e interactuar entre ellos o con las chicas."
    "It's adorable to see them playing and interacting with each other or with the girls."

# game/rutas/unum.rpy:807
translate ingles rutaunum2_5a2b846c:

    # "Aunque hay algo que te preocupa desde hace un tiempo ya, algo que ni Unum y las chicas han mostrado interés en explicar o comentar."
    "Yet there's something that's been worrying you for a while now, something that neither Unum nor the girls have shown any interest in explaining or discussing."

# game/rutas/unum.rpy:808
translate ingles rutaunum2_57e73da8:

    # "Por lo que supones que es algo normal... pero de igual forma te preocupa."
    "So you assume it's normal... but it still worries you."

# game/rutas/unum.rpy:809
translate ingles rutaunum2_381dc547:

    # "Y es que mientras más crecen más tendencias muestran a estar juntos, entrelazados por sus colas."
    "And the more they grow, the more they tend to stick together, their tails entwined."

# game/rutas/unum.rpy:810
translate ingles rutaunum2_f766abc3:

    # "Pueden pasar días entreros sujetos a sus colas."
    "They can spend entire days clinging to each other's tails."

# game/rutas/unum.rpy:813
translate ingles rutaunum2_fde9fd8b:

    # "Le avisas a los niños que entrarás por un segundo y que volverás luego."
    "You tell the children you're going to go inside for a second and that you'll be right back."

# game/rutas/unum.rpy:815
translate ingles rutaunum2_a89ad560:

    # "Buscas a Unum por los pasillos del templo y lo encuentras en la cocina junto con Solaris, quien le está dando consejos de cómo mejorar su última comida que ha hecho."
    "You search for Unum in the temple hallways and find him in the kitchen with Solaris, who is advising him on how to improve his latest meal."

# game/rutas/unum.rpy:817
translate ingles rutaunum2_dee5915b:

    # "Por curiosidad te detienes para escuchar un poco de su conversación."
    "Out of curiosity, you pause to listen to part of their conversation."

# game/rutas/unum.rpy:819
translate ingles rutaunum2_64fa63af:

    # solaris "Tienes que mejorar tu canto, mi sol."
    solaris "You need to improve your singing, my sun."

# game/rutas/unum.rpy:820
translate ingles rutaunum2_0fb30b27:

    # solaris "Si lo haces desafinado, puede que llegue a afectar el sabor."
    solaris "If you sing off-key, it might even affect the taste."

# game/rutas/unum.rpy:821
translate ingles rutaunum2_80de3ce2:

    # "Su voz oscila entre la risa y la ternura, pero no puede evitar en soltar una pequeña carcajada al final."
    "Her voice wavers between laughter and tenderness, yet she can't help but let out a small chuckle at the end."

# game/rutas/unum.rpy:823
translate ingles rutaunum2_a009d031:

    # unum "¿Me estás diciendo que canto mal?"
    unum "Are you telling me I sing badly?"

# game/rutas/unum.rpy:824
translate ingles rutaunum2_a0a31c9d:

    # solaris "Tal vez."
    solaris "Maybe."

# game/rutas/unum.rpy:825
translate ingles rutaunum2_8fc051b6:

    # "Y solo eso falta para que Solaris deje salir la gran carcajada que estaba aguantando."
    "And that's all it takes for Solaris to burst out with the big laugh she'd been holding back."

# game/rutas/unum.rpy:828
translate ingles rutaunum2_90a5565e:

    # unum "[nombrejugador], ¿tú piensas que hago los cánticos mal?"
    unum "[nombrejugador], do you think I do the chants badly?"

# game/rutas/unum.rpy:829
translate ingles rutaunum2_725474ec:

    # "Te sobresaltar un poco...No sabes cómo Unum pudo detectarte."
    "You jump a little... you can't believe how Unum detected you."

# game/rutas/unum.rpy:830
translate ingles rutaunum2_7416d2bf:

    # solaris "¡No es que los haces mal! es solo que eres desafinado."
    solaris "It's not that you do them badly! It's just that you're off-key."

# game/rutas/unum.rpy:833
translate ingles rutaunum2_4b9af26f:

    # nj "uh..."
    nj "Uh..."

# game/rutas/unum.rpy:839
translate ingles rutaunum2_e2c119a8:

    # nj "No.... Unum canta bien."
    nj "No... Unum sings well."

# game/rutas/unum.rpy:840
translate ingles rutaunum2_89ce823d:

    # "Solaris vuelve a reír, aún más fuerte. Y entre risas dice:"
    "Solaris laughs again, even louder. And between laughs, says:"

# game/rutas/unum.rpy:841
translate ingles rutaunum2_71691c07:

    # solaris "¡Tampoco hace falta mentir para convivir!"
    solaris "There's no need to lie just to get along!"

# game/rutas/unum.rpy:845
translate ingles rutaunum2_8cd36d62:

    # nj "...sí."
    nj "... Yes."

# game/rutas/unum.rpy:848
translate ingles rutaunum2_b1472776:

    # "Unum hace un quejido, derrotado mientras Solaris ríe con más fuerza."
    "Unum lets out a groan, defeated, while Solaris laughs even harder."

# game/rutas/unum.rpy:850
translate ingles rutaunum2_7dd52c23:

    # nj "¿Puedo preguntar algo? es sobre los niños."
    nj "Can I ask something? It's about the children."

# game/rutas/unum.rpy:851
translate ingles rutaunum2_68cbb899:

    # "Solo eso hace falta para que tengas la atención de ambos nuevamente en ti. Y no hace falta tener una respuesta verbal porque ellos y te miran esperando tu pregunta."
    "That alone is enough to get both of their attention back on you. And you don't need a verbal response, as they simply look at you, waiting for your question."

# game/rutas/unum.rpy:852
translate ingles rutaunum2_05fd33fa:

    # nj "¿Es normal que tengan sus colar entrelazadas todo el tiempo?"
    nj "Is it normal for them to have their tails intertwined all the time?"

# game/rutas/unum.rpy:853
translate ingles rutaunum2_d5fd0c0c:

    # unum "Es algo que hacen las estrellas binarias, uh... Solaris sabe más de eso."
    unum "It's something binary stars do, uh... Solaris knows more about it."

# game/rutas/unum.rpy:856
translate ingles rutaunum2_8a6581e0:

    # solaris "Hmmm, nosotros no tenemos cola... pero según lo que nos ha dicho Duae, cuando la acompañabamos a nacimientos de estrellas binarias, la unión de ambas colar es su forma de mantener el equilbrio gravitacional de ambas."
    solaris "Hmmm, we don't have tails... but according to what Duae told us when we accompanied her to the birth of binary stars, the union of both tails is their way of maintaining their gravitational balance."

# game/rutas/unum.rpy:857
translate ingles rutaunum2_d9e5a70b:

    # solaris "Así que funciona también como ah... ehh- un método de comunicación entre ambas estrellas."
    solaris "So it also works as ah... uh--a method of communication between the two stars."

# game/rutas/unum.rpy:862
translate ingles rutaunum2_770230cf:

    # unum "Si, eso mismo."
    unum "Yes, exactly."

# game/rutas/unum.rpy:863
translate ingles rutaunum2_196bd450:

    # unum "No te preocupes, es normal."
    unum "Don't worry, it's normal."

# game/rutas/unum.rpy:870
translate ingles rutaunum2_fde9fd8b_1:

    # "Le avisas a los niños que entrarás por un segundo y que volverás luego."
    "You let the children know that you'll step inside for a moment and be right back."

# game/rutas/unum.rpy:871
translate ingles rutaunum2_f03fc6ac:

    # "No te hace falta buscar pues las divisas saliendo de su residencia, así que corres hacía ellas."
    "You don't need to search, as you spot the figures leaving their residence, so you run towards them."

# game/rutas/unum.rpy:872
translate ingles rutaunum2_3fd9877f:

    # "Son Ignis y Aeliana, solamente. Solaris no está con ellas."
    "It's just Ignis and Aeliana. Solaris is not with them."

# game/rutas/unum.rpy:874
translate ingles rutaunum2_f2b7db4a:

    # ignis "Pequeño humano, ¿ha pasado algo?"
    ignis "Little human, has something happened?"

# game/rutas/unum.rpy:875
translate ingles rutaunum2_0af2ec31:

    # "Ignis pregunta con algo de miedo en su voz, ya que verte correr y jadear debe ser algo extraño de ver."
    "Ignis asks with a hint of fear in her voice, as seeing you run and pant must be an unusual sight."

# game/rutas/unum.rpy:876
translate ingles rutaunum2_9a1b6449:

    # nj "No, no es nada... es solo que me preocupa algo de los niños."
    nj "No, it's nothing... it's just that something about the children worries me."

# game/rutas/unum.rpy:878
translate ingles rutaunum2_68225baa:

    # aeliana "¿Qué es lo que te preocupa cariño?"
    aeliana "What worries you, dear?"

# game/rutas/unum.rpy:879
translate ingles rutaunum2_cc9a2e61:

    # "No importa cuantas veces Aeliana se refiera a ti como 'cariño', cada vez que lo hace sientes un hormigueo en tu estómago."
    "No matter how many times Aeliana calls you 'dear,' every time she does, you feel a tingling sensation in your stomach."

# game/rutas/unum.rpy:880
translate ingles rutaunum2_8c0bf320:

    # nj "¿Es normal que tengan sus colas entrelazadas todo el tiempo?"
    nj "Is it normal for them to have their tails intertwined all the time?"

# game/rutas/unum.rpy:883
translate ingles rutaunum2_9cf6c5fa:

    # "Ambas mujeres te observan en silencio antes de contestar, y la sonrisa de Aeliana flaquea por un segundo."
    "Both women watch you in silence before responding, and Aeliana's smile falters for a second."

# game/rutas/unum.rpy:884
translate ingles rutaunum2_c514cae3:

    # aeliana "Las estrellas binarias usan su cola para estabilizarse y mantener su campo gravitacional en un buen estado."
    aeliana "Binary stars use their tails to stabilize themselves and keep their gravitational field in good condition."

# game/rutas/unum.rpy:885
translate ingles rutaunum2_516e1351:

    # aeliana "Si no lo hacen, es posible que uno de ellos sea absorbido por el otro."
    aeliana "If they don't, one of them could be absorbed by the other."

# game/rutas/unum.rpy:886
translate ingles rutaunum2_dc3e6926:

    # aeliana "Al conectar sus colas, su poder se equilibra y reparte en partes iguales."
    aeliana "By connecting their tails, their power is balanced and evenly distributed."

# game/rutas/unum.rpy:887
translate ingles rutaunum2_2cd5441c:

    # ignis "También les ayuda a mejorar su vínculo emocional."
    ignis "It also helps strengthen their emotional bond."

# game/rutas/unum.rpy:890
translate ingles rutaunum2_64d1d5cd:

    # aeliana "Cierto."
    aeliana "That's right."

# game/rutas/unum.rpy:891
translate ingles rutaunum2_89b25a3e:

    # aeliana "No es nada de qué preocuparse, ellos lo hacen instintivamente."
    aeliana "It's nothing to worry about, they do it instinctively."

# game/rutas/unum.rpy:895
translate ingles rutaunum2_ca24d937:

    # "No crees que sea nada TAN preocupante como para consultarles a los demás."
    "You don't think it's anything THAT concerning to consult the others about."

# game/rutas/unum.rpy:896
translate ingles rutaunum2_02fe18e1:

    # "Si fuera algún problema, Unum ya lo habría discutido contigo para mantenerte al tanto."
    "If it were a problem, Unum would have already discussed it with you to keep you informed."

# game/rutas/unum.rpy:899
translate ingles rutaunum2_5ad2a70f:

    # "El resto del día lo pasas descansando con las chicas mientras Unum se encarga de los niños."
    "You spend the rest of the day resting with the girls while Unum takes care of the children."

# game/rutas/unum.rpy:901
translate ingles rutaunum2_75d025d8:

    # "Ya no te da miedo dejarlos con él, pues Unum ha demostrado ser un muy buen cuidador. Increíblemente, contra todo pronóstico."
    "You're no longer afraid to leave them with him, as Unum has proven to be a very good caretaker. Incredibly, against all odds."

# game/rutas/unum.rpy:904
translate ingles rutaunum2_dc5c7e10:

    # "Llega nuevamente el domingo. Y Septem vuelve a aparecer..."
    "Sunday arrives once again. And Septem appears once again..."

# game/rutas/unum.rpy:905
translate ingles rutaunum2_156b29a7:

    # "No te gusta que tú no puedas estar en la revisión del crecimiento de los niños. Pero Unum si, así que no te preocupas más de lo necesario. decidiendo esperar fuera de la sala."
    "You don't like that you can't be present during the children's growth check-up. But Unum can, so you don't worry more than necessary, deciding to wait outside the room."

# game/rutas/unum.rpy:906
translate ingles rutaunum2_a20cefa7_10:

    # "..."
    "..."

# game/rutas/unum.rpy:907
translate ingles rutaunum2_917f49f9:

    # "Pasan alrededor de 30 minutos, y ellos aún no salen."
    "About thirty minutes pass, and they still hadn't come out."

# game/rutas/unum.rpy:908
translate ingles rutaunum2_1b2ec6a3:

    # "...no es nada de preocuparse."
    "... It's nothing to worry about."

# game/rutas/unum.rpy:909
translate ingles rutaunum2_cd57ab94:

    # "Cuando se cumple una hora, llegan las chicas a acompañarte. Sin decir nada, lo que hace que comiences a sudar frío."
    "After an hour passes, the girls arrive to keep you company. They say nothing, which makes you start to break into a cold sweat."

# game/rutas/unum.rpy:910
translate ingles rutaunum2_e2b6b55b:

    # "¿Por qué está acá? ¿Y por qué se ven tan tensas?"
    "Why are they here? And why do they look so tense?"

# game/rutas/unum.rpy:912
translate ingles rutaunum2_10c4f3b1:

    # solaris "¿si no pasan la revisión...?"
    solaris "What if they don't pass the check-up...?"

# game/rutas/unum.rpy:914
translate ingles rutaunum2_748a9f48:

    # aeliana "Calla. Ni se te ocurra."
    aeliana "Be quiet. Don't even think about it."

# game/rutas/unum.rpy:915
translate ingles rutaunum2_ea26f1b1:

    # solaris "Lo siento."
    solaris "I'm sorry."

# game/rutas/unum.rpy:917
translate ingles rutaunum2_68da915b:

    # "¿Qué pasará si no pasan la revisión?"
    "What will happen if they don't pass the check-up?"

# game/rutas/unum.rpy:919
translate ingles rutaunum2_b3d95096:

    # "Estás a punto de entrar en pánico y preguntar a gritos a que se refieren cuando la puerta de la sala se abre."
    "You're about to panic and scream to ask what they mean when the door to the room opens."

# game/rutas/unum.rpy:921
translate ingles rutaunum2_f37f6f58:

    # "Los dos niños salen y corren a ustedes riendo, como si festejaran algo que desconoces."
    "The two children come out and run toward you laughing, as if celebrating something you don't know about."

# game/rutas/unum.rpy:923
translate ingles rutaunum2_c30a4107:

    # "Septem sale con ambos brazos detrás de su espalda, detrás de él viene Unum."
    "Septem walks out with both arms behind his back, with Unum following behind him."

# game/rutas/unum.rpy:925
translate ingles rutaunum2_c9cca5d8:

    # unum "¡Ya tienen sus nombres!"
    unum "They have their names now!"

# game/rutas/unum.rpy:930
translate ingles rutaunum2_51c37991:

    # septem "Todos los presentes: Unum; Alnitak; Mintaka y Alnilam, deberán referirse con esos nombres a partir de ahora. Tienen estrictamente prohibido nombrarlos por sus nombres de origen."
    septem "{sc=2}All present--Unum, Alnitak, Mintaka, and Alnilam--must refer to them
by these new\nnames from now on. It is strictly forbidden to call them by their original name.{/sc}"

# game/rutas/unum.rpy:931
translate ingles rutaunum2_848c2fe3:

    # "...Una presión inexplicable atraviesa tu cuerpo. Por la tensión en el rostro de Unum, sabes que no has sido el único en sentirla."
    "... An inexplicable pressure runs through your body. From the tension on Unum's face, you know you're not the only one who felt it."

# game/rutas/unum.rpy:934
translate ingles rutaunum2_04bc0411:

    # septem "Sirius, pueden presentarse."
    septem "{sc=2}Sirius, you may introduce yourselves.{/sc}"

# game/rutas/unum.rpy:936
translate ingles rutaunum2_e5f4bf6f:

    # noor "¡Mi nombre es Noor!"
    noor "My name is Noor!"

# game/rutas/unum.rpy:937
translate ingles rutaunum2_b0780a8e:

    # shams "Y yo me llamo Shams."
    shams "And I'm called Shams."

# game/rutas/unum.rpy:938
translate ingles rutaunum2_350dc1c9:

    # "Complacido y sin agregar nada más, Septem se despide con una voz monótona y distante. Aunque sus movimientos y su rostro mantienen la elegancia propia de su ser..."
    "Pleased, Septem bids farewell in a monotone and distant voice. Though his movements and expression maintain the elegance characteristic of his being..."

# game/rutas/unum.rpy:939
translate ingles rutaunum2_a651c5fb:

    # "...¿Por qué él es el único que puede referirse a ellos por su nombre impuesto?"
    "... Why is he the only one allowed to refer to them by their imposed names?"

# game/rutas/unum.rpy:940
translate ingles rutaunum2_ce812e4d:

    # "¿Y Unum no lo tiene permitido?"
    "And Unum isn't allowed to?"

# game/rutas/unum.rpy:941
translate ingles rutaunum2_8711795b:

    # "Temes por la razón de tal comando... pero por ahora no puede hacer nada."
    "You fear the reason behind such an order... but for now, you can do nothing."

# game/rutas/unum.rpy:942
translate ingles rutaunum2_ff5a1cce:

    # noor "¿Podemos ir al jardín a jugar?"
    noor "Can we go to the garden to play?"

# game/rutas/unum.rpy:943
translate ingles rutaunum2_8a679652:

    # "Tu atención se centra en tus niños, quienes te miran suplicantes y con sus colas entrelazadas."
    "Your attention shifts to the children, who look at you pleadingly, their tails intertwined."

# game/rutas/unum.rpy:946
translate ingles rutaunum2_36ea453d:

    # "La respuesta que obtienes es un coro de berrinches infantiles."
    "The response you get is a chorus of childish tantrums."

# game/rutas/unum.rpy:947
translate ingles rutaunum2_1d902425:

    # "Pero aceptan viendo que no sacarán nada haciendo eso."
    "But they accept, realizing they won't gain anything from it."

# game/rutas/unum.rpy:950
translate ingles rutaunum2_7effbeec:

    # "Shams y Noor se van corriendo por el pasillo hacía el jardín."
    "Shams and Noor run down the hallway toward the garden."

# game/rutas/unum.rpy:951
translate ingles rutaunum2_06bac1fe:

    # "En todo momento, sus colas yacen entrelazadas."
    "At all times, their tails remain intertwined."

# game/rutas/unum.rpy:953
translate ingles rutaunum2_4bf650c6:

    # "La vida aquí no es tan mala..."
    "Life here is not so bad..."

# game/rutas/unum.rpy:955
translate ingles rutaunum2_94acaf39:

    # "FIN DEL ACTO 2."
    "END OF ACT 2."

# game/rutas/unum.rpy:956
translate ingles rutaunum2_9ceab4ea:

    # "En proceso de elaboración..."
    "In the process of elaboration..."

# game/rutas/unum.rpy:957
translate ingles rutaunum2_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2} You'll have to wait a while to find out how this ends... :3{/sc}"

