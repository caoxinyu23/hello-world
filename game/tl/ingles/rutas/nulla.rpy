# game/rutas/nulla.rpy:2212
translate ingles rutanullaa_0920f824:

    # nulla "Si lo haces... cambia el nombre de la imagen a 'para_nulla' y así yo podré saber que es tuyo <3 ."
    nulla "If you do... rename the image to 'para_nulla', so I'll know it's yours. <3"

# game/rutas/nulla.rpy:2583
translate ingles continuacion_nulla1_be1dae94:

    # nulla "¿Si tuviera la misma apariencia que un muerto?"
    nulla "What if I looked just like a dead person?"

# game/rutas/nulla.rpy:3374
translate ingles acto3_nulla_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:3376
translate ingles acto3_nulla_c51d7991:

    # " . . . "
    " . . . "

# game/rutas/nulla.rpy:3378
translate ingles acto3_nulla_e9f33aa3:

    # "No hay nada peor que despertar con un nudo en el pecho, esa angustia estremecedora que evita que puedas respirar con normalidad."
    "There's nothing worse than waking up with a knot in your chest, that overwhelming anguish that keeps you from breathing normally."

# game/rutas/nulla.rpy:3379
translate ingles acto3_nulla_dc4db73c:

    # "Encontrar la razón de tal reacción corporal no es difícil."
    "Figuring out the reason behind such a physical reaction isn't difficult."

# game/rutas/nulla.rpy:3380
translate ingles acto3_nulla_6e19fcf9:

    # "Te sientes ansioso por lo que está por venir."
    "You're anxious about what's to come."

# game/rutas/nulla.rpy:3381
translate ingles acto3_nulla_a2ffa468:

    # "El trato que han hecho con Nulla ya está llegando a su fin; se te prometieron siete días... los días van descendiendo su cantidad cada vez que despiertas, cobrando una cuota de tiempo que no puede extenderse."
    "The deal you made with Nulla is nearing its end; you were promised seven days... and with every awakening, the number of days dwindles, taking its toll on the time you have left, time that cannot be extended."

# game/rutas/nulla.rpy:3382
translate ingles acto3_nulla_ab7edbcf:

    # "Quedan tres días para cumplir la semana... el tiempo que llevas aquí es minúsculo, y aun así pareciera ser más del que en realidad es."
    "Three days remain until the week is over... the time you've spent here is minuscule in the grand scheme of things, and yet it feels like far more than it actually is."

# game/rutas/nulla.rpy:3383
translate ingles acto3_nulla_9817adf9:

    # "Explicarlo es complejo y la lógica no ofrece un acompañamiento en ello. Pero si hay posibles culpables... que van desde la familiaridad con la que Nulla te trata hasta como el tiempo se distorsiona entre tu realidad y la de él."
    "Explaining it is complicated, and logic offers little help. But there are a few possible culprits... ranging from the familiarity with which Nulla treats you to the way time becomes distorted between your reality and his."

# game/rutas/nulla.rpy:3384
translate ingles acto3_nulla_a7965c6c:

    # "Ya te lo dijo en los primeros días: la percepción del tiempo es distinta para ambos."
    "He already told you during the first few days: The perception of time is different for each of you."

# game/rutas/nulla.rpy:3385
translate ingles acto3_nulla_b7afdb52:

    # "Definitivamente no han sido 7 días para ti... pueden haber sido menos o incluso mucho más."
    "It definitely hasn't been seven days for you... it could've been less, or even much longer."

# game/rutas/nulla.rpy:3386
translate ingles acto3_nulla_ce0ca1c0:

    # "Sin importar la cantidad exacta de tiempo---"
    "Regardless of the exact amount of time..."

# game/rutas/nulla.rpy:3389
translate ingles acto3_nulla_0a6213ce:

    # "---aquello debe ser el principal culpable de tu cariño casi irracional que le tienes a este individuo."
    "... that must be the main reason behind the almost irrational affection you feel for this individual."

# game/rutas/nulla.rpy:3390
translate ingles acto3_nulla_41f1e63b:

    # "Tiempo ocupado en conocerlo, tiempo del día que podrías utilizarlo en otras cosas; se lo entregas a él, tiempo que él devora tu atención como si de un vampiro de energía se tratara."
    "Time spent getting to know him, hours of the day you could devote to other things... you give them to him, while he devours your attention as if he were some kind of energy vampire."

# game/rutas/nulla.rpy:3391
translate ingles acto3_nulla_96184760:

    # "Claro, no vas a dártelas de moralista autocrítico o juicioso, estás aquí porque quieres, y tú haces con tu tiempo lo que se te da la reverenda gana."
    "Of course, you're not about to play the self-critical, judgmental moralist. You're here because you want to be, and you can do whatever the hell you please with your time."

# game/rutas/nulla.rpy:3392
translate ingles acto3_nulla_e17af40e:

    # "Y tiempo junto a él es lo que más buscas ahora mismo."
    "And spending time with him is what you want most right now."

# game/rutas/nulla.rpy:3393
translate ingles acto3_nulla_5e6c7c14:

    # "Tiempo es lo que te falta ahora, también."
    "Time is exactly what you're running out of, too."

# game/rutas/nulla.rpy:3394
translate ingles acto3_nulla_04b35438:

    # "...Tu estadía aquí siempre tuvo una fecha de caducidad, la cual no puedes simplemente ignorar a estas alturas de tu travesía."
    "... Your stay here always had an expiration date, one you can no longer simply ignore this far into your journey."

# game/rutas/nulla.rpy:3395
translate ingles acto3_nulla_959a9b9f:

    # "Nulla siempre fue claro con lo que quiere."
    "Nulla has always been clear about what he wants."

# game/rutas/nulla.rpy:3396
translate ingles acto3_nulla_3f747103:

    # "Nulla... que cruel la situación en la que te ha puesto."
    "Nulla... how cruel the situation he's put you in."

# game/rutas/nulla.rpy:3397
translate ingles acto3_nulla_1b64484b:

    # "No lo quieres perder."
    "You don't want to lose him."

# game/rutas/nulla.rpy:3398
translate ingles acto3_nulla_676e1b08:

    # "No quieres que llegue el último día. Pues sabes lo que significa."
    "You don't want the last day to come because you know what it means."

# game/rutas/nulla.rpy:3399
translate ingles acto3_nulla_3988665e:

    # "Será un adiós, rotundo y frío, no un hasta luego."
    "It will be a goodbye--absolute and cold, not a simple 'see you later.'"

# game/rutas/nulla.rpy:3400
translate ingles acto3_nulla_95cae89e:

    # "Una despedida cruda e intransigente, cultivada por ideas auto-destructivas que consumen los pensamientos del dueño del vacío."
    "A harsh, uncompromising farewell, born from the self-destructive thoughts that consume the mind of the master of the void."

# game/rutas/nulla.rpy:3401
translate ingles acto3_nulla_c02d30f1:

    # "Y si bien, no has tocado este tema de manera directa, o siquiera intentado convencerlo de repensar su decisión, tienes ya la idea de como será su reacción."
    "And although you haven't brought up the subject directly, or even tried to convince him to reconsider his decision, you already have an idea of how he'll react."

# game/rutas/nulla.rpy:3402
translate ingles acto3_nulla_96430478:

    # "Aunque... probar suerte no lo matará antes de que se cumpla el plazo."
    "Still... trying your luck won't kill him before the deadline arrives."

# game/rutas/nulla.rpy:3403
translate ingles acto3_nulla_bfe40e6c:

    # "No pierdes nada con hablar de esto."
    "You have nothing to lose by talking about it."

# game/rutas/nulla.rpy:3406
translate ingles acto3_nulla_b0bc5061:

    # "Es tiempo invertido en él."
    "It's time invested in him."

# game/rutas/nulla.rpy:3407
translate ingles acto3_nulla_18042331:

    # "Deseo de conocer su historia, de llegar al final... descubrir como esto acabará."
    "A desire to know his story, to reach the end... to discover how this will all turn out."

# game/rutas/nulla.rpy:3410
translate ingles acto3_nulla_e4ed7ca6:

    # nulla "Pensar en el futuro no hace más que amargarte el presente."
    nulla "Thinking about the future will only make your present miserable."

# game/rutas/nulla.rpy:3411
translate ingles acto3_nulla_ff43c514:

    # nulla "Por tu bien, creo que deberías parar y acompañarme a tomar desayuno junto a mí, amorcito."
    nulla "For your own sake, I think you should stop and join me for breakfast, amorcito."

# game/rutas/nulla.rpy:3413
translate ingles acto3_nulla_bdef2dc3:

    # "Ver a Nulla arreglándose para comenzar el día se siente fuera de este mundo. Por lo general su traje siempre está impecable, presentable ante tus ojos."
    "Watching Nulla get ready for the day feels almost otherworldly. Usually, his suit is always impeccable, perfectly presentable whenever you see him."

# game/rutas/nulla.rpy:3414
translate ingles acto3_nulla_4d5533bf:

    # "Por lo que verle en camisa, sin la capa protectora que es su guillete, es equiparable a verlo desnudo--- uhh... bueno, no exactamente---"
    "So seeing him in just his shirt, without the protective layer of his waistcoat, is almost like seeing him naked--uh... well, not exactly--"

# game/rutas/nulla.rpy:3415
translate ingles acto3_nulla_23a428d5:

    # "¡Es un decir!"
    "It's just a figure of speech!"

# game/rutas/nulla.rpy:3417
translate ingles acto3_nulla_e18a513f:

    # "Nulla ríe momentáneamente, presintiendo la imagen mental que te has hecho."
    "Nulla chuckles briefly, sensing the mental image you've conjured up."

# game/rutas/nulla.rpy:3418
translate ingles acto3_nulla_f7158575:

    # nulla "Has despertado antes de tiempo... aunque, si lo hubieras hecho 5 minutos antes me habrías visto sin camisa--- que penaaa~."
    nulla "You woke up earlier than expected... although, if you'd woken up five minutes sooner, you would've seen me without my shirt on--what a shaaame~"

# game/rutas/nulla.rpy:3419
translate ingles acto3_nulla_bede1073:

    # "Percatándose de tu sutil decepción, agrega con gracia."
    "Noticing your subtle disappointment, he adds playfully."

# game/rutas/nulla.rpy:3420
translate ingles acto3_nulla_659414c1:

    # nulla "No te pierdes de nada. No tengo abdominales marcados, jaja."
    nulla "You're not missing much. I don't have defined abs, jaja."

# game/rutas/nulla.rpy:3422
translate ingles acto3_nulla_62a32887:

    # "El remate le sirve para suspirar y bajar la mirada hasta la corbata que le cuelga del cuello, deshecha, a la espera de convertirse en un nudo."
    "After delivering the punchline, he sighs and lowers his gaze to the untied necktie hanging around his neck, waiting to be knotted."

# game/rutas/nulla.rpy:3423
translate ingles acto3_nulla_95301dea:

    # nulla "Estaba pensando en cambiar el traje---"
    nulla "I was thinking about changing my suit--"

# game/rutas/nulla.rpy:3424
translate ingles acto3_nulla_0aa61239:

    # "Juguetea con la corbata, pensativo, sin ánimos de proseguir para completar el nudo."
    "He fiddles with his tie, lost in thought, showing no intention of finishing the knot."

# game/rutas/nulla.rpy:3425
translate ingles acto3_nulla_a79f0342:

    # nulla "Podría usar un nuevo traje para el último día."
    nulla "I could wear a new suit for the last day."

# game/rutas/nulla.rpy:3426
translate ingles acto3_nulla_4d491ffc:

    # nulla "Quiero verme bonito."
    nulla "I want to look pretty."

# game/rutas/nulla.rpy:3428
translate ingles acto3_nulla_9c2047c4:

    # "Juntos elaboran el desayuno, tomando en consideración tus preferencias y gustos."
    "You prepare breakfast together, taking your preferences and tastes into consideration."

# game/rutas/nulla.rpy:3429
translate ingles acto3_nulla_57f7eecf:

    # "Entre cada preparación terminada, a Nulla le basta chasquear los dedos para mandar la comida a manos de una de sus sombras para que la lleve a la mesa."
    "Whenever a dish is ready, all Nulla has to do is snap his fingers to send the food into the hands of one of his shadows, which carries it to the table."

# game/rutas/nulla.rpy:3430
translate ingles acto3_nulla_ae53d719:

    # "Mas ninguna de ellas interfiere en la preparación del desayuno. Esa tarea es exclusiva, reservada solo para ustedes dos."
    "But none of them interfere with preparing breakfast. That task is exclusive, reserved for just the two of you."

# game/rutas/nulla.rpy:3431
translate ingles acto3_nulla_bba5adcb:

    # "Nulla no les presta atención, pero tú, en cambio, observas cada uno de sus movimientos. Repetidas veces dejas de hacer tus cosas para mirar lo que hacen las sombras."
    "Nulla pays them no attention, but you, on the other hand, watch their every movement. Time and again, you stop what you're doing to watch the shadows at work."

# game/rutas/nulla.rpy:3432
translate ingles acto3_nulla_22cf6fdd:

    # nulla "Con esto estaríamos."
    nulla "That should do it."

# game/rutas/nulla.rpy:3433
translate ingles acto3_nulla_5bfc8b69:

    # "Comenta el pelinegro, luego de servir leche caliente en un jarro."
    "The dark-haired man remarks after pouring hot milk into a pitcher."

# game/rutas/nulla.rpy:3437
translate ingles acto3_nulla_b3b8d771:

    # "Dando por finalizada la preparación del desayuno, te invita a la mesa, haciendo que todas las sombras desaparezcan cuando te sientas en la silla."
    "With breakfast finally prepared, he invites you to the table, making all the shadows disappear as you sit down."

# game/rutas/nulla.rpy:3441
translate ingles acto3_nulla_00dc195b:

    # "El desayuno se pasa entre conversaciones y risas, dando un falso sentido cotidianidad en el momento. El parloteo de Nulla es intencionado, constantemente redireccionándote si es que intentas tocar el tema del almuerzo o de lo que pasará en el séptimo día."
    "Breakfast passes amid conversations and laughter, giving the moment a false sense of normalcy. Nulla's chatter is deliberate, constantly steering you away whenever you try to bring up lunch or what will happen on the seventh day."

# game/rutas/nulla.rpy:3442
translate ingles acto3_nulla_93a0f147:

    # "No lo culpas... pero tampoco lo vas a excusar por intentar escapar de una conversación necesaria, que ambos deben tener antes de proseguir con el día."
    "You don't blame him... but you're not going to excuse him for trying to avoid a necessary conversation, one you both need to have before getting on with the day."

# game/rutas/nulla.rpy:3445
translate ingles acto3_nulla_79f823e0:

    # "No vas a permitir que te haga esto. Siempre termina saliéndose con la suya de una u otra manera, ya sea con palabras bonitas que te embriagan el juicio o con distracciones baratas."
    "You're not going to let him do this to you. He always ends up getting his way--one way or another, whether through sweet words that cloud your judgment or cheap distractions."

# game/rutas/nulla.rpy:3446
translate ingles acto3_nulla_f0fab0c3:

    # "Pero ahora se trata de algo importante... algo que debe ser hablado cara a cara."
    "But this time, it's something important... something that needs to be discussed face to face."

# game/rutas/nulla.rpy:3447
translate ingles acto3_nulla_e64a3401:

    # "No puedes dejar escapar esta oportunidad, y tal vez, este último momento de paz que tendrás junto a él."
    "You can't let this opportunity slip away, or perhaps this last moment of peace you'll have with him."

# game/rutas/nulla.rpy:3448
translate ingles acto3_nulla_6c928013:

    # "Insistes, decidido a hacerle hablar."
    "You insist, determined to make him talk."

# game/rutas/nulla.rpy:3453
translate ingles acto3_nulla_bd92e609:

    # nulla "Hmm."
    nulla "Hmm."

# game/rutas/nulla.rpy:3454
translate ingles acto3_nulla_d86aff6c:

    # "Su sonrisa se borra al darse cuenta de que no vas a ceder. Se recarga en el respaldo de la silla, suspirando de forma dramática, cortando el acto."
    "His smile fades when he realizes you're not going to give in. He leans back against his chair, letting out a dramatic sigh and dropping the act."

# game/rutas/nulla.rpy:3455
translate ingles acto3_nulla_13a76378:

    # nulla "No es algo fácil de hablar ¿sabes?"
    nulla "It's not an easy thing to talk about, you know?"

# game/rutas/nulla.rpy:3456
translate ingles acto3_nulla_50f0e18e:

    # "Ante tu silencio, Nulla se entrega por completo."
    "Faced with your silence, Nulla gives in completely."

# game/rutas/nulla.rpy:3461
translate ingles acto3_nulla_26d62383:

    # nulla "Bien--- ¿Qué quieres saber exactamente?"
    nulla "Fine--what exactly do you want to know?"

# game/rutas/nulla.rpy:3469
translate ingles acto3_nulla_891ad52c:

    # "Sus ojos son los primeros en darte una respuesta. Los abre, dejando escapar parte del control que se aferra a él en cada conversación que hay entre ustedes."
    "His eyes are the first to give you an answer. They widen, letting some of the control he clings to during every conversation between you slip away."

# game/rutas/nulla.rpy:3470
translate ingles acto3_nulla_8bdfd3f5:

    # "Siendo una de las pocas veces en que lo has visto de esta manera."
    "It's one of the few times you've seen him like this."

# game/rutas/nulla.rpy:3471
translate ingles acto3_nulla_09be99cb:

    # "Atrapado, sin una respuesta preparada o ensayada. A sabiendas que con tu sed de respuestas, no podrá salir sin darte lo que buscas."
    "Trapped, without a prepared or rehearsed answer. Knowing that, with your thirst for answers, he won't be able to get away without giving you what you're looking for."

# game/rutas/nulla.rpy:3476
translate ingles acto3_nulla_ce48733c:

    # nulla "¿Realmente quieres que te lo diga en voz alta?"
    nulla "Do you really want me to say it out loud?"

# game/rutas/nulla.rpy:3477
translate ingles acto3_nulla_023a067b:

    # nulla "El último día, tanto tu marioneta como yo, dejaremos de existir."
    nulla "On the last day, both your puppet and I will cease to exist."

# game/rutas/nulla.rpy:3478
translate ingles acto3_nulla_d0f71d46:

    # nulla "Sin el Jardín, tengo la libertad de decidir por mi mismo."
    nulla "Without the Garden, I'm free to decide for myself."

# game/rutas/nulla.rpy:3479
translate ingles acto3_nulla_d3a4d4de:

    # nulla "Dejar este mundo como corresponde y darle fin a mi existencia."
    nulla "To leave this world as I should and put an end to my existence."

# game/rutas/nulla.rpy:3481
translate ingles acto3_nulla_17e8d8ae:

    # "Hay vacilación en su voz, no se le oye del todo convencido. Y el hecho de que no se atreva a conectar su mirada con la tuya, te hace creer que hay algo en sus palabras que no lo convencen del todo."
    "There's hesitation in his voice. He doesn't sound entirely convinced. And the fact that he doesn't dare meet your gaze makes you think there's something about his own words that he doesn't quite believe."

# game/rutas/nulla.rpy:3486
translate ingles acto3_nulla_1d63d45c:

    # nulla "Quiero hacerlo sufrir..."
    nulla "I want to make them both suffer..."

# game/rutas/nulla.rpy:3487
translate ingles acto3_nulla_b846de95:

    # nulla "Quiero que esto le duela. Humillarlo antes de tener mi salida."
    nulla "I want this to hurt Her. To humiliate Her before I make my exit."

# game/rutas/nulla.rpy:3488
translate ingles acto3_nulla_d395f991:

    # nulla "Llevarme todos sus deseos de seguir haciendo estos mundos de mierda para que no le queden ganas de volver a traerme a la luz."
    nulla "To take away every last bit of Her desire to keep making these shitty worlds, so She'll never want to bring me into existence again."

# game/rutas/nulla.rpy:3489
translate ingles acto3_nulla_2bb07b94:

    # nulla "Cambiar mi historia. Mi cara, mi cuerpo..."
    nulla "To change my story. My face, my body..."

# game/rutas/nulla.rpy:3490
translate ingles acto3_nulla_9403366e:

    # nulla "Lo odio. Soy como--- su payaso personal."
    nulla "I hate Her. I'm like--Her personal clown."

# game/rutas/nulla.rpy:3491
translate ingles acto3_nulla_1fe31f2d:

    # nulla "Nunca lo suficientemente bueno, siempre hay algo mal. Algo que criticar y cambiar."
    nulla "Never good enough, there's always something wrong. Something to criticize and change."

# game/rutas/nulla.rpy:3496
translate ingles acto3_nulla_d3084bbe:

    # nulla "Me tiene harto."
    nulla "I'm sick of Her."

# game/rutas/nulla.rpy:3497
translate ingles acto3_nulla_85dfc7d6:

    # nulla "Su marioneta me tiene harto. Sus mundos me tienen harto."
    nulla "I'm sick of Her puppet. I'm sick of Her worlds."

# game/rutas/nulla.rpy:3498
translate ingles acto3_nulla_3ed3d235:

    # nulla "Nunca se cansa."
    nulla "She never gets tired."

# game/rutas/nulla.rpy:3499
translate ingles acto3_nulla_068d6caf:

    # nulla "No importa cuanto lo intente."
    nulla "No matter how hard I try."

# game/rutas/nulla.rpy:3500
translate ingles acto3_nulla_a5852a01:

    # nulla "Nunca para."
    nulla "She never stops."

# game/rutas/nulla.rpy:3504
translate ingles acto3_nulla_1059a71c:

    # nulla "Pero..."
    nulla "But..."

# game/rutas/nulla.rpy:3508
translate ingles acto3_nulla_c789b4a3:

    # nulla "Llegaste tú..."
    nulla "Then you came along..."

# game/rutas/nulla.rpy:3509
translate ingles acto3_nulla_212df0f6:

    # nulla "Me has concedido el permiso de liberarme."
    nulla "You've given me permission to free myself."

# game/rutas/nulla.rpy:3510
translate ingles acto3_nulla_dc454edd:

    # nulla "El séptimo día debería ser el mejor día de mi vida---"
    nulla "The seventh day should be the best day of my life--"

# game/rutas/nulla.rpy:3511
translate ingles acto3_nulla_fd6a638a:

    # "Nulla toma tus manos, traza con su pulgar tus nudillos, acariciando la piel que hay entre ellos."
    "Nulla takes your hands, tracing your knuckles with his thumb, caressing the skin between them."

# game/rutas/nulla.rpy:3512
translate ingles acto3_nulla_1e70d76b:

    # nulla "Pero ahora parece una condena más."
    nulla "But now it feels like yet another sentence."

# game/rutas/nulla.rpy:3513
translate ingles acto3_nulla_2dea6ee4:

    # "Hay una pausa."
    "There's a pause."

# game/rutas/nulla.rpy:3518
translate ingles acto3_nulla_c9b1979e:

    # nulla "No quiero dejarte."
    nulla "I don't want to leave you."

# game/rutas/nulla.rpy:3519
translate ingles acto3_nulla_f7103b6d:

    # nulla "No quiero ser algo pasajero."
    nulla "I don't want to be something temporary."

# game/rutas/nulla.rpy:3520
translate ingles acto3_nulla_efd7aaba:

    # nulla "Quiero llevarte conmigo."
    nulla "I want to take you with me."

# game/rutas/nulla.rpy:3521
translate ingles acto3_nulla_56c78e7d:

    # nulla "Salir de su agarre y quedarme contigo."
    nulla "To escape Her grasp and stay with you."

# game/rutas/nulla.rpy:3522
translate ingles acto3_nulla_114452b5:

    # "Su mano te da un pequeño apretón antes de romper el contacto."
    "His hand gives yours a gentle squeeze before letting go."

# game/rutas/nulla.rpy:3526
translate ingles acto3_nulla_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:3531
translate ingles acto3_nulla_e5e0fd81:

    # nulla "Creo que es lo mejor."
    nulla "I think it's for the best."

# game/rutas/nulla.rpy:3537
translate ingles acto3_nulla_d98ba0a6:

    # "No planeas obligar a Nulla para que te hable de algo que, si bien es importante que sepas, no se sienta cómodo con compartir contigo."
    "You don't intend to force Nulla to talk about something he doesn't feel comfortable sharing with you, even if it's important for you to know."

# game/rutas/nulla.rpy:3538
translate ingles acto3_nulla_810d7a4e:

    # "Si no quiere hablarlo contigo, está bien."
    "If he doesn't want to talk about it with you, that's fine."

# game/rutas/nulla.rpy:3539
translate ingles acto3_nulla_a99a4825:

    # "Ya llegará el momento en que deba romper el hielo y formular con palabras lo que siempre ha estado implícito en su trato."
    "The time will come when he'll have to break the ice and put into words what has always been implicit in your arrangement."

# game/rutas/nulla.rpy:3551
translate ingles acto3_nulla_a20cefa7_1:

    # "..."
    "..."

# game/rutas/nulla.rpy:3552
translate ingles acto3_nulla_450dcec8:

    # "El ritmo de la conversación cambia gradualmente, dejando la amargura atrás. Te asombra el manejo que tiene este hombre para moldear la conversación a su gusto."
    "The tone of the conversation gradually shifts, leaving the bitterness behind. You're amazed by this man's ability to steer a conversation however he pleases."

# game/rutas/nulla.rpy:3553
translate ingles acto3_nulla_5f30aff0:

    # "Incluso, sin que debas presionar más, Nulla comenta sus planes para el almuerzo."
    "He even brings up his plans for lunch without you having to press him any further."

# game/rutas/nulla.rpy:3554
translate ingles acto3_nulla_84132036:

    # "Y dentro de ellos, te pide que no lo pierdas de vista."
    "And as part of those plans, he asks you not to let him out of your sight."

# game/rutas/nulla.rpy:3559
translate ingles acto3_nulla_f11f0228:

    # nulla "Sextam es peligrosa."
    nulla "Sextam is dangerous."

# game/rutas/nulla.rpy:3560
translate ingles acto3_nulla_fe96c14b:

    # nulla "No sé en que bando está."
    nulla "I don't know whose side she's on."

# game/rutas/nulla.rpy:3561
translate ingles acto3_nulla_66f1d95a:

    # "Es todo lo que te ofrece de explicación antes de cambiar el tema nuevamente."
    "That's all the explanation he gives you before changing the subject again."

# game/rutas/nulla.rpy:3566
translate ingles acto3_nulla_f0e6edf2:

    # "Saltan de tema en tema, evitando que el silencio se abra paso entre ustedes. Tanto es el parloteo y los diversos olores del desayuno, que terminas algo mareado."
    "You jump from topic to topic, keeping silence from settling between you. Between all the chatter and the various smells of breakfast, you end up feeling a little dizzy."

# game/rutas/nulla.rpy:3567
translate ingles acto3_nulla_025ab383:

    # "Llega un punto en que no eres consciente de cuando el líquido de tu taza se acaba y el alimento en tu plato desaparece."
    "At some point, you don't even notice when your cup runs empty and the food on your plate disappears."

# game/rutas/nulla.rpy:3568
translate ingles acto3_nulla_8707e676:

    # "Nulla se percata de ello al tiempo en que tu boca deja de moverse."
    "Nulla notices this just as your mouth stops moving."

# game/rutas/nulla.rpy:3573
translate ingles acto3_nulla_fcb75035:

    # nulla "Oh, tenías hambre jaja."
    nulla "Oh, you were hungry, jaja."

# game/rutas/nulla.rpy:3578
translate ingles acto3_nulla_466fc46d:

    # nulla "Bien, hay que levantarse. Aún tenemos tiempo antes de que nos toque hacer el almuerzo."
    nulla "Well, time to get up. We still have some time before we have to make lunch."

# game/rutas/nulla.rpy:3581
translate ingles acto3_nulla_f63d10f8:

    # "Sin esperar, Nulla se levanta. Olvidando en la mesa su té, ahora frío, y sus rollos de canela a medio comer. Ignorando que aún hay comida en la mesa, chasquea los dedos para que esta desaparezca de su vista."
    "Without waiting, Nulla gets up, leaving behind his now-cold tea and half-eaten cinnamon rolls. Ignoring the fact that there's still food on the table, he snaps his fingers to make it disappear from sight."

# game/rutas/nulla.rpy:3585
translate ingles acto3_nulla_9091366b:

    # "Aunque él quiera ocultarlo con esa sonrisa confiada, su comportamiento expone lo ansioso que se encuentra. No le deja estar quieto, ni disfrutar del momento."
    "Although he tries to hide it behind that confident smile, his behavior betrays just how anxious he is. It won't let him sit still or enjoy the moment."

# game/rutas/nulla.rpy:3586
translate ingles acto3_nulla_553a5b7f:

    # "Tomárselo con calma no forma parte de sus planes hoy."
    "Taking things slowly isn't part of his plans today."

# game/rutas/nulla.rpy:3587
translate ingles acto3_nulla_ccb6f98b:

    # "Y eso te apena un poco."
    "And that's a little sad."

# game/rutas/nulla.rpy:3592
translate ingles acto3_nulla_409f8636_1:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:3597
translate ingles acto3_nulla_d5dc1417:

    # nulla "Hay cosas que quiero ver."
    nulla "There are things I want to see."

# game/rutas/nulla.rpy:3598
translate ingles acto3_nulla_8f6203ad:

    # "Balbucea, avergonzado."
    "He stammers, embarrassed."

# game/rutas/nulla.rpy:3603
translate ingles acto3_nulla_ac7807ae:

    # nulla "He estado esperando desde que modificaste las variables."
    nulla "I've been waiting ever since you modified the variables."

# game/rutas/nulla.rpy:3604
translate ingles acto3_nulla_918b08ca:

    # nulla "Y tú también has estado esperando el momento para que yo las vea---"
    nulla "And you've been waiting for the moment when I finally get to see them, too--"

# game/rutas/nulla.rpy:3609
translate ingles acto3_nulla_15b1f7b2:

    # nulla "¿O me equivocooo? :)"
    nulla "Or am I wrooong? :)"

# game/rutas/nulla.rpy:3610
translate ingles acto3_nulla_99598251:

    # "¿Acaso lo sabe?---"
    "Does he know...?"

# game/rutas/nulla.rpy:3612
translate ingles acto3_nulla_05ece69d:

    # "Supones que es esperable... Nulla puede sentir parte de los cambios que haces en este juego."
    "You suppose it's to be expected... Nulla can sense some of the changes you make to this game."

# game/rutas/nulla.rpy:3617
translate ingles acto3_nulla_21008113:

    # nulla "Ahh~ Quiero verlo ya---"
    nulla "Ahh~ I want to see it already--"

# game/rutas/nulla.rpy:3621
translate ingles acto3_nulla_409f8636_2:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:3631
translate ingles continuacion_nulla_act3_9983e170:

    # "Depender de solo la noción del tiempo biológico es peligroso, no tienes con que comparar cuánto falta para el almuerzo. Esto te pone ansioso, pero decides ignorarlo."
    "Relying solely on your internal sense of time is dangerous. You have no way of telling how much time is left until lunch. This makes you anxious, but you decide to ignore it."

# game/rutas/nulla.rpy:3632
translate ingles continuacion_nulla_act3_604c11ac:

    # "Disfrutar el momento cómo diría Nulla, seguramente."
    "Enjoy the moment, as Nulla would surely say."

# game/rutas/nulla.rpy:3633
translate ingles continuacion_nulla_act3_1d66d222:

    # "Es gracias a esto y la falta de un reloj, que hace la llegada del mediodía sea abrupta, y te resulte desagradable escuchar como Nulla suspira, anunciando en un tono monótono que es hora de comenzar a preparar la comida."
    "Between this and the lack of a clock, noon arrives abruptly, and you find it unpleasant to hear Nulla sigh before announcing in a monotonous tone that it's time to start preparing lunch."

# game/rutas/nulla.rpy:3637
translate ingles continuacion_nulla_act3_f693081b:

    # "Están ya en la cocina para cuando te das cuenta, no recuerdas como es que llegaron hasta aquí o como fue la conversación durante el camino, te has bloqueado por completo."
    "By the time you realize it, you're already in the kitchen. You don't remember how you got here or what you talked about along the way. Your mind has gone completely blank."

# game/rutas/nulla.rpy:3638
translate ingles continuacion_nulla_act3_04c34e7c:

    # "Si bien, el espacio de la cocina es amplio, hay algo en el ambiente que te hace sentir claustrofobia. Sientes como tu cuerpo se queda sin aire, aprisionado por paredes invisibles que lo rodean y se acercan cada vez más, buscando aplastarte."
    "Although the kitchen is spacious, there's something about the atmosphere that makes you feel claustrophobic. You feel the air being squeezed out of your body, trapped by invisible walls that surround you and creep ever closer, threatening to crush you."

# game/rutas/nulla.rpy:3639
translate ingles continuacion_nulla_act3_6b36fc45:

    # "Nulla prepara los platos e ingredientes que usará en la comida, desconoces que es lo que tiene pensado cocinar... aprovechas esta duda para inducir una conversación que logre sacarte los nervios de encima."
    "Nulla sets out the dishes and ingredients he'll use for the meal. You have no idea what he's planning to cook... so you take advantage of that uncertainty to strike up a conversation and try to calm your nerves."

# game/rutas/nulla.rpy:3640
translate ingles continuacion_nulla_act3_a6de9703:

    # "Así que preguntas, aguantando las náuseas que te tienen preso."
    "So you ask, fighting back the nausea that has you in its grip."

# game/rutas/nulla.rpy:3641
translate ingles continuacion_nulla_act3_57e8050c:

    # nulla "Sextam no tolera la carne."
    nulla "Sextam can't tolerate meat."

# game/rutas/nulla.rpy:3642
translate ingles continuacion_nulla_act3_5efcd978:

    # nulla "Y tengo ganas de algo típico de {i}mi{i} infancia... quiero probarlo por mí mismo."
    nulla "And I'm craving something traditional from {i}my{/i} childhood... I want to try it for myself."

# game/rutas/nulla.rpy:3643
translate ingles continuacion_nulla_act3_9dc20bb8:

    # "Nulla saca un libro de recetas que antes no estaba ahí, ni en sus manos o en el mesón donde ha puesto cada ingrediente."
    "Nulla pulls out a recipe book that wasn't there before, neither in his hands nor on the counter where he's laid out the ingredients."

# game/rutas/nulla.rpy:3647
translate ingles continuacion_nulla_act3_212de5d0:

    # nulla "Vamos a tener que modificar un poco la receta, no tengo tiempo para buscar una licuadora o molino."
    nulla "We'll have to modify the recipe a little. I don't have time to look for a blender or grinder."

# game/rutas/nulla.rpy:3648
translate ingles continuacion_nulla_act3_db42aa0e:

    # "Miras con atención la página que Nulla te señala; el título en grande te presenta el nombre del plato elegido."
    "You carefully examine the page Nulla points to; the large title reveals the name of the dish he's chosen."

# game/rutas/nulla.rpy:3649
translate ingles continuacion_nulla_act3_c8fe393b:

    # "Se ve interesante... lleva maíz molido, condimentado con otras especias y cocido envuelto en sus propias hojas."
    "It looks interesting... it's made with ground corn, seasoned with various spices and cooked wrapped in its own husks."

# game/rutas/nulla.rpy:3650
translate ingles continuacion_nulla_act3_68410a87:

    # nulla "De chico lo comía en el verano. A Mary le gustaba con azúcar."
    nulla "I used to eat it during the summer when I was little. Mary liked it with sugar."

# game/rutas/nulla.rpy:3651
translate ingles continuacion_nulla_act3_f409ad60:

    # "Ríe débilmente."
    "He lets out a faint laugh."

# game/rutas/nulla.rpy:3652
translate ingles continuacion_nulla_act3_80a4c00e:

    # nulla "Es una de las memorias más lejanas que tengo de ella."
    nulla "It's one of my earliest memories of her."

# game/rutas/nulla.rpy:3656
translate ingles continuacion_nulla_act3_1578406e:

    # "Comienzan a desgranar las mazorcas del maíz. Solo tienen un cuchillo como instrumento, del cual Nulla hace uso sin complicaciones en el proceso de desgranado."
    "You begin removing the kernels from the ears of corn. You only have a knife to work with, which Nulla handles effortlessly as he cuts the kernels off the cob."

# game/rutas/nulla.rpy:3657
translate ingles continuacion_nulla_act3_07171e26:

    # "Para ti es una tarea difícil. La culpa está en tus manos... que no responden como deberían hacerlo."
    "For you, it's a difficult task. The problem lies with your hands... they don't respond the way they should."

# game/rutas/nulla.rpy:3658
translate ingles continuacion_nulla_act3_0beea225:

    # "Te cuesta medir la fuerza ejercida, pues no tienes mucha sensación en ellas. Es un peso fantasma que se apodera en tus manos, impidiendo la buena manipulación del cuchillo contra la mazorca de maíz."
    "You struggle to control how much force you use, since you can barely feel anything in them. A phantom weight seems to take hold of your hands, preventing you from properly handling the knife against the corn cob."

# game/rutas/nulla.rpy:3659
translate ingles continuacion_nulla_act3_d93126b8:

    # "Cuando el cuchillo se estrella contra la tabla de picar por segunda vez, Nulla detiene para mirar el desastre que estás haciendo."
    "When the knife crashes against the cutting board for the second time, Nulla stops to look at the mess you're making."

# game/rutas/nulla.rpy:3660
translate ingles continuacion_nulla_act3_c6548c8e:

    # "Intentas excusarte pero el siseo que se escapa de sus labios te calla."
    "You try to make an excuse, but the soft coo escaping his lips silences you."

# game/rutas/nulla.rpy:3664
translate ingles continuacion_nulla_act3_a13d7c66:

    # nulla "Shhh--- no te preocupes, cariño."
    nulla "Shhh--don't worry, cariño."

# game/rutas/nulla.rpy:3665
translate ingles continuacion_nulla_act3_6b23ff62:

    # "Sus manos buscan las tuyas, tomándolas con suavidad."
    "His hands reach for yours, gently taking hold of them."

# game/rutas/nulla.rpy:3666
translate ingles continuacion_nulla_act3_399571e5:

    # nulla "No eres tú, es la marioneta el problema."
    nulla "It's not you, the puppet is the problem."

# game/rutas/nulla.rpy:3667
translate ingles continuacion_nulla_act3_dcb9207a:

    # nulla "Tus manos están empezando a pudrirse... ¿ves?"
    nulla "Its hands are starting to rot... see?"

# game/rutas/nulla.rpy:3671
translate ingles continuacion_nulla_act3_b4315d63:

    # "Gira tus manos, presentándote el fallo, con la delicadeza de no hacer movimientos bruscos que puedan dañarte de alguna forma. Enfocas tu mirada en tus manos, intentando ignorar lo cerca que está Nulla de tu cuerpo."
    "He turns your hands over, showing you the damage, careful not to make any sudden movements that might hurt you. You focus your gaze on your hands, trying to ignore how close Nulla is to your body."

# game/rutas/nulla.rpy:3672
translate ingles continuacion_nulla_act3_b243d614:

    # "El color negro que te carcome los dedos ha crecido, siendo el culpable de la perdida de sensibilidad en tus manos."
    "The blackness eating away at your fingers has spread, causing the loss of sensation in your hands."

# game/rutas/nulla.rpy:3673
translate ingles continuacion_nulla_act3_f008de02:

    # "Acaricia cada uno de tus dígitos para probar su punto, y tú apenas lo sientes."
    "He caresses each of your fingers to prove his point, and you can barely feel it."

# game/rutas/nulla.rpy:3674
translate ingles continuacion_nulla_act3_7db33d78:

    # nulla "¿Cómo serán tus manos en realidad?"
    nulla "I wonder what your real hands are like?"

# game/rutas/nulla.rpy:3676
translate ingles continuacion_nulla_act3_212d3605:

    # "Lleva tu mano hacia su cara, mirándolas, ahora él, de cerca."
    "He brings your hand closer to his face, taking a closer look at them himself."

# game/rutas/nulla.rpy:3677
translate ingles continuacion_nulla_act3_7fd1e487:

    # "Si bien sus ojos inspeccionan lo que tiene al frente, sabes que no está totalmente centrado en las manos que tiene al frente. Las mira, pero no observa..."
    "Although his eyes examine what's in front of him, you know he's not entirely focused on the hands he's holding. He looks at them, but doesn't really see them..."

# game/rutas/nulla.rpy:3678
translate ingles continuacion_nulla_act3_481d09db:

    # "Hay algo más en su mente que le impide tomar atención. La pregunta anterior te da una pista obvia de lo que está pasando dentro de él."
    "There's something else on his mind that's keeping him distracted. His earlier question gives you an obvious clue as to what's going on inside his head."

# game/rutas/nulla.rpy:3679
translate ingles continuacion_nulla_act3_72d6094b:

    # "Sus anhelos nuevamente se van lejos de su realidad."
    "Once again, his longing drifts far beyond his reality."

# game/rutas/nulla.rpy:3680
translate ingles continuacion_nulla_act3_f3d3ddd8:

    # nulla "¿Cálidas? o ¿Frías?"
    nulla "Warm? Or cold?"

# game/rutas/nulla.rpy:3681
translate ingles continuacion_nulla_act3_d7a0292e:

    # nulla "¿Suaves?"
    nulla "Soft?"

# game/rutas/nulla.rpy:3682
translate ingles continuacion_nulla_act3_98d511e7:

    # nulla "¿Grandes? ¿Pequeñas?"
    nulla "Big? Small?"

# game/rutas/nulla.rpy:3683
translate ingles continuacion_nulla_act3_2883466e:

    # nulla "¿Se sentirán distintas a esto?..."
    nulla "Would they feel different from these...?"

# game/rutas/nulla.rpy:3684
translate ingles continuacion_nulla_act3_0d8a5524:

    # "Suspira, frustrado al no encontrar una respuesta clara."
    "He sighs, frustrated by his inability to find a clear answer."

# game/rutas/nulla.rpy:3685
translate ingles continuacion_nulla_act3_fe0ea398:

    # nulla "Olvídalo, parezco un tonto."
    nulla "Forget it, I sound like a fool."

# game/rutas/nulla.rpy:3686
translate ingles continuacion_nulla_act3_2543c2a1:

    # "Una sutil sonrisa reemplaza su semblante melancólico. Sus ojos se entrecierran para simular una expresión más genuina, pero tú ya puedes ver a través de él."
    "A faint smile replaces his melancholic expression. His eyes narrow slightly to make it seem more genuine, but you can already see right through him."

# game/rutas/nulla.rpy:3687
translate ingles continuacion_nulla_act3_8f8d582b:

    # nulla "No importa al final de día, nunca las podré sentir."
    nulla "It doesn't matter at the end of the day. I'll never be able to feel them."

# game/rutas/nulla.rpy:3693
translate ingles continuacion_nulla_act3_1c5e5873:

    # "Tiras levemente de tu mano para hacerle notar a Nulla que ya quieres romper el contacto."
    "You gently pull your hand away to let Nulla know you want to break the contact."

# game/rutas/nulla.rpy:3694
translate ingles continuacion_nulla_act3_450d0bf8:

    # "Él opone algo de resistencia, sin dejar de lado su sonrisa, aplica fuerza para evitar que tu mano se aleje. Es una fuerza débil, la cual, si tiras más fuerte, posiblemente podrías romper su agarre."
    "He offers some resistance, keeping his smile in place as he tightens his grip to keep your hand from pulling away. It's a weak grip, one you could probably break if you pulled a little harder."

# game/rutas/nulla.rpy:3695
translate ingles continuacion_nulla_act3_6d4df1c3:

    # "Pasa un segundo, dos... y luego te deja ir."
    "One second passes, then two... and finally, he lets you go."

# game/rutas/nulla.rpy:3696
translate ingles continuacion_nulla_act3_4f95fca9:

    # "Sin dejar que esa sonrisa flaquee ante tu negativa."
    "Without letting that smile falter in the face of your rejection."

# game/rutas/nulla.rpy:3697
translate ingles continuacion_nulla_act3_31ea2a02:

    # "A pesar de que el momento es tenso, Nulla finge demencia e ignora lo que acaba de pasar tatareando una canción mientras vuelve a su tarea de desgranar las mazorcas de maíz."
    "Despite the tension, Nulla pretends nothing happened, ignoring what just took place as he hums a tune and returns to stripping the kernels from the corn cobs."

# game/rutas/nulla.rpy:3705
translate ingles continuacion_nulla_act3_eaa0a86f:

    # "Es un movimiento lento, sutil, que lo toma desprevenido cuando tus dedos se entrelazan con los suyos. Buscas reconfortarlo de cierta manera y, aunque no son tus manos las que comparten ese contacto con Nulla, estas son una representación de tus deseos."
    "It's a slow, subtle movement that catches him off guard when your fingers intertwine with his. You want to comfort him somehow, and although these aren't your real hands sharing that contact with Nulla, they're a reflection of your wishes."

# game/rutas/nulla.rpy:3706
translate ingles continuacion_nulla_act3_4d6f1d27:

    # "Le cuesta un par de segundos en responder. Al procesar por completo lo que has hecho, su mano se sella alrededor de la tuya, con la misma suavidad aplicada anteriormente."
    "It takes him a couple of seconds to respond. Once he fully processes what you've done, his hand closes around yours with the same gentleness as before."

# game/rutas/nulla.rpy:3710
translate ingles continuacion_nulla_act3_bdb125c2:

    # "No satisfecho con solo eso, dirige tu mano a sus labios. Sin romper el contacto con su propia mano, besa tus nudillos."
    "Not satisfied with just that, he brings your hand to his lips. Without releasing his hold on it, he kisses your knuckles."

# game/rutas/nulla.rpy:3711
translate ingles continuacion_nulla_act3_64f5196d:

    # "Los besa uno por uno, dándole una atención especial a todos por igual. Hay unos besos que duran más que otros, unos que vienen acompañados por un contacto visual intenso, o una simple risa melodiosa."
    "He kisses them one by one, giving each the same special attention. Some kisses linger longer than others, some accompanied by intense eye contact or a soft, melodious laugh."

# game/rutas/nulla.rpy:3712
translate ingles continuacion_nulla_act3_a5d752e3:

    # "Cuando termina con el último, coloca un beso en el dorso de tu mano. Similar a una caricia, que busca un contacto que va más allá de lo físico."
    "When he finishes with the last one, he places a kiss on the back of your hand. Like a caress, seeking a connection that goes beyond the physical."

# game/rutas/nulla.rpy:3713
translate ingles continuacion_nulla_act3_318d1ffc:

    # "Se queda ahí por un buen rato, suspirando mientras cierra los ojos, con miedo a abrirlos y ver lo que tiene al frente."
    "He stays like that for a long while, sighing as he closes his eyes, afraid to open them and see what's in front of him."

# game/rutas/nulla.rpy:3714
translate ingles continuacion_nulla_act3_8ef59aa6:

    # "Ver tu ausencia física en el mundo y romper la ilusión de que estás ahí, junto a él."
    "To see your physical absence from this world and shatter the illusion that you're there, beside him."

# game/rutas/nulla.rpy:3718
translate ingles continuacion_nulla_act3_ab88699e:

    # nulla "Deben ser perfectas."
    nulla "They must be perfect."

# game/rutas/nulla.rpy:3719
translate ingles continuacion_nulla_act3_e756d47f:

    # "Culmina su caricia diciendo esas palabras, dando una conclusión a sus preguntas retóricas."
    "He ends his caress with those words, bringing his rhetorical questions to a close."

# game/rutas/nulla.rpy:3720
translate ingles continuacion_nulla_act3_af7e7508:

    # "Se le ve satisfecho de cierto modo, mas no contento."
    "He looks satisfied in a way, but not happy."

# game/rutas/nulla.rpy:3721
translate ingles continuacion_nulla_act3_31a73078:

    # nulla "Hay que terminar la comida."
    nulla "We need to finish preparing lunch."

# game/rutas/nulla.rpy:3725
translate ingles continuacion_nulla_act3_43d6368a:

    # "Dice antes de continuar su tarea de desgranar las mazorcas de maíz"
    "He says before returning to the task of stripping the kernels from the corn cobs."

# game/rutas/nulla.rpy:3729
translate ingles continuacion_nulla_act3_6b1bbf75:

    # "Terminan con la preparación, no han tardado mucho gracias a que Nulla ha acelerado el proceso con ayuda de sus manos extras, las cuales se han encargado del procesar el maíz para convertirlo en una pasta."
    "You finish the preparation without taking too long, thanks to Nulla speeding up the process with the help of his extra hands, which have taken care of grinding the corn into a paste."

# game/rutas/nulla.rpy:3730
translate ingles continuacion_nulla_act3_dbf7d29a:

    # "Mientras colocan y envuelven la pasta en las hojas de maíz, te percatas de que a Nulla le está costando envolver y amarrar las hojas."
    "As you place the paste onto the corn husks and wrap it up, you notice that Nulla is struggling to fold and tie the husks."

# game/rutas/nulla.rpy:3731
translate ingles continuacion_nulla_act3_8b960714:

    # "Pareciera como si esta fuera su primera vez haciendo esta receta. Tal cual estuviera siguiendo unas instrucciones que no comprende del todo."
    "It's as if this were his first time making this recipe, like he's following instructions he doesn't entirely understand."

# game/rutas/nulla.rpy:3735
translate ingles continuacion_nulla_act3_bcc2a2ab:

    # nulla "Parecía más fácil en las memorias..."
    nulla "It seemed easier in the memories..."

# game/rutas/nulla.rpy:3738
translate ingles continuacion_nulla_act3_a5ded377:

    # "Masculla con mal humor."
    "He mutters irritably."

# game/rutas/nulla.rpy:3749
translate ingles continuacion_nulla_act3_34220d94:

    # "Nulla te mira en silencio, inseguro de cómo actuar."
    "Nulla looks at you in silence, unsure how to react."

# game/rutas/nulla.rpy:3754
translate ingles continuacion_nulla_act3_101e903c:

    # nulla "Yo no viví esto... solo dependo de los recuerdos de esa vieja versión mía."
    nulla "I never lived through this... I can only rely on the memories of that old version of myself."

# game/rutas/nulla.rpy:3759
translate ingles continuacion_nulla_act3_37a2e37f:

    # "Confiesa aún más avergonzado, como si quisiera que la tierra se lo tragara."
    "He confesses, even more embarrassed, as if he wished the ground would swallow him whole."

# game/rutas/nulla.rpy:3767
translate ingles continuacion_nulla_act3_27710674:

    # "Él toma una bocanada de aire, intentando sacar el valor para confesar algo que posiblemente muy dentro de él, duele."
    "He takes a deep breath, trying to muster the courage to confess something that probably hurts him deep down."

# game/rutas/nulla.rpy:3772
translate ingles continuacion_nulla_act3_a386bb12:

    # nulla "No soy más que un usurpador..."
    nulla "I'm nothing more than a usurper..."

# game/rutas/nulla.rpy:3773
translate ingles continuacion_nulla_act3_7ed2d597:

    # "Susurra con miedo a decirlo más fuerte."
    "He whispers, afraid to say it any louder."

# game/rutas/nulla.rpy:3774
translate ingles continuacion_nulla_act3_de47d500:

    # "Su mirada está clavada en la humita que tiene en sus manos y aún falta por cerrar."
    "His gaze is fixed on the humita in his hands, which he has yet to wrap up."

# game/rutas/nulla.rpy:3775
translate ingles continuacion_nulla_act3_ad5f7a1f:

    # "Extiende su mano en busca del cucharón, con ganas de agregar más relleno al montón que yace en las hojas del maíz, sintiendo que es muy poca la cantidad que tiene."
    "He reaches for the ladle, wanting to add more filling to the mound resting on the corn husks, feeling that there's far too little of it."

# game/rutas/nulla.rpy:3780
translate ingles continuacion_nulla_act3_a4f2c5af:

    # nulla "Jamás experimenté nada de las memorias que tengo dentro de mí..."
    nulla "I never experienced any of the memories I carry inside me..."

# game/rutas/nulla.rpy:3781
translate ingles continuacion_nulla_act3_3b5ee852:

    # nulla "Solo soy la versión más actual que guarda a todas las versiones anteriores a mí... como una muñeca rusa."
    nulla "I'm just the latest version, containing all that came before me... like a Russian nesting doll."

# game/rutas/nulla.rpy:3782
translate ingles continuacion_nulla_act3_638913c5:

    # "Viendo que no queda más espacio en las hojas, deja el cucharón de lado."
    "Seeing that there's no more room in the husks, he sets the ladle aside."

# game/rutas/nulla.rpy:3787
translate ingles continuacion_nulla_act3_1f7130b3:

    # nulla "Guardo toda memoria y sentimientos de mis predecesores, soy todos y nadie al mismo tiempo."
    nulla "I carry all the memories and feelings of my predecessors. I am all of them and none of them at the same time."

# game/rutas/nulla.rpy:3788
translate ingles continuacion_nulla_act3_5e6fce5b:

    # "Junta las hojas del maíz, apretando de más. Sus manos están tensas, buscan liberar aquella tensión en la tarea pero lo único que logra es que parte del relleno se salga por la fuerza aplicada."
    "He folds the corn husks together, squeezing too tightly. His hands are tense, trying to release that tension through the task, but all he manages to do is force some of the filling out."

# game/rutas/nulla.rpy:3789
translate ingles continuacion_nulla_act3_530d6bd6:

    # "Tú observas en silencio como el relleno se le escapa entre los dedos."
    "You silently watch as the filling slips between his fingers."

# game/rutas/nulla.rpy:3790
translate ingles continuacion_nulla_act3_3f18c57c:

    # "Hay algo en sus pensamientos que no lo deja tranquilo, algo cambia."
    "There's something on his mind that won't let him rest. Something changes."

# game/rutas/nulla.rpy:3795
translate ingles continuacion_nulla_act3_b0d97325:

    # nulla "El nuevo juguete del Creador que usará hasta aburrirse y crear otro que me reemplace."
    nulla "The Creator's new toy, which She'll use until She gets bored and creates another one to replace me."

# game/rutas/nulla.rpy:3800
translate ingles continuacion_nulla_act3_1f0660dc:

    # "Y tan rápido como llegó, desaparece."
    "And just as quickly as it appeared, it disappears."

# game/rutas/nulla.rpy:3801
translate ingles continuacion_nulla_act3_d735ba35:

    # "No sabes si es cuando se da cuenta del desastre que ha hecho con la humita o por lo tenso del ambiente, pero Nulla se calma. En sus labios se esboza una sonrisa amarga, que no se decide por completo si quiere ser sarcástica o melancólica."
    "You don't know whether it's because he notices the mess he's made of the humita or because of the tension in the air, but Nulla calms down. A bitter smile forms on his lips, as though it can't quite decide whether to be sarcastic or melancholic."

# game/rutas/nulla.rpy:3806
translate ingles continuacion_nulla_act3_f6ecb39c:

    # nulla "¿Qué tan cagado será la próxima versión mía si es que mi plan no funciona?"
    nulla "How fucked up will the next version of me be if my plan doesn't work?"

# game/rutas/nulla.rpy:3807
translate ingles continuacion_nulla_act3_bae325a6:

    # nulla "Ja--- no."
    nulla "Ja--no."

# game/rutas/nulla.rpy:3812
translate ingles continuacion_nulla_act3_c84db3f9:

    # nulla "Eso no va a pasar."
    nulla "That's not going to happen."

# game/rutas/nulla.rpy:3813
translate ingles continuacion_nulla_act3_ce78d7cb:

    # nulla "No voy a dejar que pase---"
    nulla "I won't let that happen--"

# game/rutas/nulla.rpy:3817
translate ingles continuacion_nulla_act3_9db4ecc5:

    # "Toma lo que queda de la humita para tirarlo al suelo. Antes de que toque el fondo, un agujero se abre, funcionando como un basurero improvisado."
    "He takes what's left of the humita and throws it onto the floor. Before it can hit the ground, a hole opens up, serving as an improvised trash can."

# game/rutas/nulla.rpy:3818
translate ingles continuacion_nulla_act3_a00f2227:

    # "Nulla se limpia las manos, dando por terminada la tarea."
    "Nulla wipes his hands, considering the task finished."

# game/rutas/nulla.rpy:3819
translate ingles continuacion_nulla_act3_a2908e8b:

    # nulla "No voy a quedar como el resto."
    nulla "I won't end up like the others."

# game/rutas/nulla.rpy:3820
translate ingles continuacion_nulla_act3_fd2f1a7a:

    # nulla "Voy a ser el último."
    nulla "I'm going to be the last."

# game/rutas/nulla.rpy:3823
translate ingles continuacion_nulla_act3_2d455f8b:

    # "Sus ojos te encuentran, dentro de ellos hay algo que no te esperas. No hay rabia, no hay tristeza..."
    "His eyes meet yours, and there's something in them you didn't expect. No anger, and not a sadness..."

# game/rutas/nulla.rpy:3824
translate ingles continuacion_nulla_act3_d013f9bb:

    # "Hay una pisca de ilusión."
    "... There's a glimmer of hope."

# game/rutas/nulla.rpy:3825
translate ingles continuacion_nulla_act3_b512a8d4:

    # nulla "Voy a salir de aquí y de su agarre."
    nulla "I'm going to get out of here and escape Her grasp."

# game/rutas/nulla.rpy:3826
translate ingles continuacion_nulla_act3_af349084:

    # "Su cuerpo te acorrala, quedando en medio del mesón y él. Cuando le buscas la mirada para entender que está ocurriendo, ya no solo hay una pisca de ilusión en sus ojos, ahora hay algo peligroso en ellos."
    "He corners you with his body, trapping you between him and the counter. When you seek his gaze to understand what's happening, there's no longer just hope in his eyes, but something dangerous in them, too."

# game/rutas/nulla.rpy:3827
translate ingles continuacion_nulla_act3_43f6c56e:

    # "Pupilas dilatadas te observan fijamente. Hay hambre en ella, como si le debieras algo más que solo tú atención."
    "Dilated pupils stare intently at you. There's a hunger burning in his gaze, as though you owe him something more than just your attention."

# game/rutas/nulla.rpy:3828
translate ingles continuacion_nulla_act3_e54bb3a8:

    # nulla "Seré tuyo de una u otra manera."
    nulla "I'll be yours one way or another."

# game/rutas/nulla.rpy:3829
translate ingles continuacion_nulla_act3_fba121b0:

    # "Su cara se acerca a la tuya, peligrando un beso."
    "His face draws closer to yours, threatening to close the distance with a kiss."

# game/rutas/nulla.rpy:3830
translate ingles continuacion_nulla_act3_eb27df3d:

    # nulla "Haré lo que sea para quedarme contigo."
    nulla "I'll do whatever it takes to stay with you."

# game/rutas/nulla.rpy:3831
translate ingles continuacion_nulla_act3_d609d4c0:

    # "Poco a poco, la distancia se acorta y el aire se hace cada vez más denso e intenso. Su aliento golpea tu piel, y genera un cosquilleo que te deja inquieto."
    "Little by little, the distance between you shrinks, and the air grows increasingly heavy and intense. His breath brushes against your skin, sending a tingling sensation through you that leaves you restless."

# game/rutas/nulla.rpy:3832
translate ingles continuacion_nulla_act3_b035631a:

    # "Sus manos buscan tu cintura, pegándose a ella. Está tan cerca que sus piernas tocan las tuyas, lo que no hace más que tu balance peligre con perderse."
    "His hands find your waist, pressing against it. He's so close that his legs touch yours, making it even harder for you to keep your balance."

# game/rutas/nulla.rpy:3833
translate ingles continuacion_nulla_act3_47d29c54:

    # nulla "Ya tengo control parcial de tu computadora, así que----"
    nulla "I already have partial control of your computer, so--"

# game/rutas/nulla.rpy:3834
translate ingles continuacion_nulla_act3_0f301043:

    # "Su boca roza tu oreja izquierda, haciendo que todos los vellos de tu nuca se ericen."
    "His lips brush against your left ear, making every hair on the back of your neck stand on end."

# game/rutas/nulla.rpy:3835
translate ingles continuacion_nulla_act3_31e75991:

    # nulla "Estoy pensando en un par de formas de cómo hacerlo <3."
    nulla "I'm thinking of a couple of ways to make it happen. <3"

# game/rutas/nulla.rpy:3836
translate ingles continuacion_nulla_act3_362cff71:

    # "Soltando una risa pícara, al ver el estado en que estás, se aleja y te deja."
    "He lets out a mischievous laugh at the state you're in, then pulls away and leaves you."

# game/rutas/nulla.rpy:3840
translate ingles continuacion_nulla_act3_9e5738af:

    # nulla "... no voy a dejar que me gane."
    nulla "... I'm not going to let Her beat me."

# game/rutas/nulla.rpy:3842
translate ingles continuacion_nulla_act3_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:3845
translate ingles continuacion_nulla_act3_e260f21f:

    # "Terminan de armar las humitas entre historias viejas que Nulla cuenta para llenar el silencio. Estando todas listas, las colocan en una olla con agua hirviendo."
    "You finish assembling the humitas while Nulla tells old stories to fill the silence. Once they're all ready, you place them in a pot of boiling water."

# game/rutas/nulla.rpy:3849
translate ingles continuacion_nulla_act3_ecb0109f:

    # "Dejan cocinando las humitas a fuego medio, un pequeño temporizador de gallina se materializa en el mesón, indicando la cuenta regresiva de treinta y cinco minutos exactos."
    "You leave the humitas cooking over medium heat. A small chicken-shaped kitchen timer materializes on the counter, counting down exactly thirty-five minutes."

# game/rutas/nulla.rpy:3852
translate ingles continuacion_nulla_act3_fc51df24:

    # "Mientras esperan, Nulla te pide ayuda para preparar la mesa."
    "While you wait, Nulla asks you to help set the table."

# game/rutas/nulla.rpy:3856
translate ingles continuacion_nulla_act3_fc5af044:

    # "Ponen tres copas, un juego de utensilios para tres personas y alimento para acompañar el plato fuerte."
    "You set out three glasses, cutlery for three people, and some side dishes to accompany the main course."

# game/rutas/nulla.rpy:3857
translate ingles continuacion_nulla_act3_ef42193a:

    # "Sin llegar a ser humilde, la exhibición que se encuentra en la mesa te parece poco. Supones que, para ser una reunión importante, Nulla pondría más esfuerzo en la mesa, al menos un poco más ostentosa."
    "Although you wouldn't call it modest, the spread on the table seems rather underwhelming to you. You'd assumed that, for such an important gathering, Nulla would put more effort into it, making it at least a little more extravagant."

# game/rutas/nulla.rpy:3858
translate ingles continuacion_nulla_act3_023b948b:

    # "Como las veces en que te hacia el desayuno..."
    "Like those times when he made you breakfast..."

# game/rutas/nulla.rpy:3859
translate ingles continuacion_nulla_act3_6531db8b:

    # "Actualmente pareciera ser una mesa típica para el almuerzo con rutinario con la familia, con lo justo y necesario. Nada muy lujoso o extraordinario."
    "Right now, it looks like a typical table set for an ordinary family lunch, with just what you need and nothing more. Nothing particularly luxurious or extraordinary."

# game/rutas/nulla.rpy:3860
translate ingles continuacion_nulla_act3_1300179f:

    # "Aún así, la mesa se ve linda, todo tiene un propósito y no hay comida que será desperdiciada."
    "Even so, the table looks lovely. Everything has a purpose and no food will go to waste."

# game/rutas/nulla.rpy:3861
translate ingles continuacion_nulla_act3_4cd0d816:

    # "Tal vez esto sea por petición de Sextam... quién sabe."
    "Perhaps this was Sextam's request... who knows."

# game/rutas/nulla.rpy:3862
translate ingles continuacion_nulla_act3_910082b7:

    # "El tiempo pasa volando. Ni cuenta te das de que ya se han cumplido los treinta y cinco minutos cuando el temporizador irrumpe en el ambiente, es un ruido estridente, poco agradable para el oído."
    "Time flies by. You don't even realize that thirty-five minutes have passed until the timer suddenly rings out, its shrill sound unpleasant to the ear."

# game/rutas/nulla.rpy:3867
translate ingles continuacion_nulla_act3_02203d80:

    # "Junto a ello, unos golpes en la puerta que indican que la invita ha llegado."
    "Along with it comes a knock at the door, announcing that your guest has arrived."

# game/rutas/nulla.rpy:3873
translate ingles continuacion_nulla_act3_9abc7631:

    # "Nulla solo sonríe cuando levantas la vista, nervioso, buscando alguna forma de tranquilizar tu corazón y lo rápido que este late."
    "Nulla merely smiles as you look up nervously, searching for some way to calm your heart and its frantic beating."

# game/rutas/nulla.rpy:3878
translate ingles continuacion_nulla_act3_9866e5b2:

    # nulla "Ven, vamos a abrir la puerta."
    nulla "Come on, let's go answer the door."

# game/rutas/nulla.rpy:3883
translate ingles continuacion_nulla_act3_f1beeda7:

    # nulla "¡Ah! pero antes---"
    nulla "Ah! But first--"

# game/rutas/nulla.rpy:3888
translate ingles continuacion_nulla_act3_38a945ca:

    # nulla "Creo que esta ocasión merece una vestimenta adecuada."
    nulla "I think this occasion calls for something appropriate to wear."

# game/rutas/nulla.rpy:3892
translate ingles continuacion_nulla_act3_1555cffd:

    # "Con un chasquido de sus dedos, la ropa de Nulla se transforma en un traje negro, decorado con pequeños detalles dorados que resaltan en las telas."
    "With a snap of his fingers, Nulla's clothes transform into a black suit, adorned with small golden details that stand out against the fabric."

# game/rutas/nulla.rpy:3893
translate ingles continuacion_nulla_act3_22bf604f:

    # "Se ve guapo... muy guapo e imponente."
    "He looks handsome... very attractive and imposing."

# game/rutas/nulla.rpy:3894
translate ingles continuacion_nulla_act3_ce8e5992:

    # nulla "¿Te gusta?"
    nulla "Do you like it?"

# game/rutas/nulla.rpy:3897
translate ingles continuacion_nulla_act3_ca74c9b3:

    # "Nulla sonríe."
    "Nulla smiles."

# game/rutas/nulla.rpy:3898
translate ingles continuacion_nulla_act3_1fc770e4:

    # nulla "A mí igual me gusta."
    nulla "I like it, too."

# game/rutas/nulla.rpy:3899
translate ingles continuacion_nulla_act3_d92a917d:

    # nulla "Ya me venía bien un cambio."
    nulla "I was due for a change, anyway."

# game/rutas/nulla.rpy:3900
translate ingles continuacion_nulla_act3_e12a0dd1:

    # "Sus labios buscan los tuyos, esperando un beso fugaz."
    "His lips seek yours, hoping for a smooch."

# game/rutas/nulla.rpy:3903
translate ingles continuacion_nulla_act3_54a450de:

    # "Es un beso sonoro, uno que no pasa más allá del contacto suave entre ambos labios."
    "You hear the sound of your lips meeting in a kiss that goes no further than a gentle touch."

# game/rutas/nulla.rpy:3904
translate ingles continuacion_nulla_act3_bd727526:

    # "Es tierno, casi te hace olvidar la situación en que estás."
    "It's tender, almost making you forget the situation you're in."

# game/rutas/nulla.rpy:3905
translate ingles continuacion_nulla_act3_194b8274:

    # "Si tan solo esto fuera una cena con algún familiar que conocerás por primera vez..."
    "If only this were a dinner with a family member you were meeting for the first time..."

# game/rutas/nulla.rpy:3906
translate ingles continuacion_nulla_act3_206f755f:

    # "Una cena para conocer a los allegados de Nulla."
    "A dinner to meet the people close to Nulla."

# game/rutas/nulla.rpy:3907
translate ingles continuacion_nulla_act3_96ac670d:

    # "Uhg."
    "Uhg."

# game/rutas/nulla.rpy:3910
translate ingles continuacion_nulla_act3_d403ca5f:

    # nulla "Aww :(."
    nulla "Aww. :("

# game/rutas/nulla.rpy:3911
translate ingles continuacion_nulla_act3_08e37ddf:

    # nulla "Será en otra ocasión."
    nulla "Maybe another time."

# game/rutas/nulla.rpy:3915
translate ingles continuacion_nulla_act3_c155c653:

    # "Las comisuras de sus labios caen."
    "The corners of his mouth droop."

# game/rutas/nulla.rpy:3916
translate ingles continuacion_nulla_act3_58d2c4ad:

    # nulla "A mí si me gusta..."
    nulla "Well, I like it..."

# game/rutas/nulla.rpy:3917
translate ingles continuacion_nulla_act3_653d887e:

    # nulla "No tengo tiempo para buscar otro conjunto..."
    nulla "I don't have time to look for another outfit..."

# game/rutas/nulla.rpy:3919
translate ingles continuacion_nulla_act3_6b51aca9:

    # "Son interrumpidos por los golpes de la puerta, demandando a que esta se abra."
    "You're interrupted by knocking at the door, demanding that it be opened."

# game/rutas/nulla.rpy:3925
translate ingles continuacion_nulla_act3_a43f4033:

    # "Decides acompañarlo, prefieres eso a tener que quedarte solo, esperando sin saber qué pasa con Nulla y Sextam..."
    "You decide to accompany him. You'd rather do that than stay behind alone, waiting without knowing what's happening between Nulla and Sextam..."

# game/rutas/nulla.rpy:3926
translate ingles continuacion_nulla_act3_93814076:

    # "Podrían tomarte desprevenido e indefenso estando sin la compañía del dueño del vacío, por lo que es mejor quedarte a su lado en todo momento."
    "Without the master of the void by your side, you could be caught off guard and left defenseless, so it's better to stay close to him at all times."

# game/rutas/nulla.rpy:3927
translate ingles continuacion_nulla_act3_8e175961:

    # "Además, no aguantarías la ansiedad de no saber que está pasando."
    "Besides, you wouldn't be able to stand the anxiety of not knowing what's going on."

# game/rutas/nulla.rpy:3931
translate ingles continuacion_nulla_act3_ba738db6:

    # "Así que tomas su mano y le acompañas a abrir la puerta."
    "So you take his hand and accompany him to answer the door."

# game/rutas/nulla.rpy:3932
translate ingles continuacion_nulla_act3_0e6ee20b:

    # "La mano de Nulla te sirve como ancla, te sostiene, dando un apoyo emocional que brinda seguridad. El apretón tierno que te da una vez levanta su mano para abrir la puerta, te calma."
    "Nulla's hand serves as an anchor, holding you steady and offering the emotional support that makes you feel safe. The gentle squeeze he gives your hand as he raises his own to open the door calms you."

# game/rutas/nulla.rpy:3936
translate ingles continuacion_nulla_act3_f2503f67:

    # nulla "Ya te estábamos esperando, bienvenida Sextam."
    nulla "We've been expecting you. Welcome, Sextam."

# game/rutas/nulla.rpy:3940
translate ingles continuacion_nulla_act3_e96a4952:

    # "Dice él abriendo la puerta. Por el umbral, puedes ver una alta y maciza figura que resplandece, aunque el vacío de afuera intente comerse su luz."
    "He says as he opens the door. Beyond the threshold, you can see a tall, imposing figure radiating light, even as the void outside tries to devour her glow."

# game/rutas/nulla.rpy:3945
translate ingles continuacion_nulla_act3_98cd2909:

    # "Sextam es simplemente hermosa."
    "Sextam is simply beautiful."

# game/rutas/nulla.rpy:3946
translate ingles continuacion_nulla_act3_c97b76a0:

    # "Tiene en su cabello flores repartidas en cada onda que cae por su cuerpo, simulando un manto que la protege."
    "Flowers are scattered throughout the waves of her hair, which cascade down her body like a protective cloak."

# game/rutas/nulla.rpy:3947
translate ingles continuacion_nulla_act3_f2d12494:

    # "En sus manos lleva una bandeja que no permite ver lo que hay en su interior ya que yace tapada."
    "She carries a covered tray in her hands, concealing whatever lies inside."

# game/rutas/nulla.rpy:3952
translate ingles continuacion_nulla_act3_d52b8d9f:

    # sextam "Es un gusto poder venir aquí."
    sextam "It's a pleasure to be here."

# game/rutas/nulla.rpy:3953
translate ingles continuacion_nulla_act3_f02e044b:

    # sextam "Pensé que jamás vería este lugar."
    sextam "I thought I'd never get to see this place."

# game/rutas/nulla.rpy:3958
translate ingles continuacion_nulla_act3_88699bb7:

    # "Sus ojos se topan con los tuyos, y no los suelta. Ni siquiera pestañea."
    "Her eyes meet yours, and she doesn't look away. She doesn't even blink."

# game/rutas/nulla.rpy:3959
translate ingles continuacion_nulla_act3_9f4aaf9f:

    # "Tragas saliva, sintiendo como los nervios te empiezan a comer vivo."
    "You swallow hard, feeling your nerves begin to eat you alive."

# game/rutas/nulla.rpy:3963
translate ingles continuacion_nulla_act3_a093e43b:

    # nulla "Pasa, la comida ya está lista."
    nulla "Come in, lunch is ready."

# game/rutas/nulla.rpy:3964
translate ingles continuacion_nulla_act3_2b604e77:

    # "Nulla te saca del trance, apretando nuevamente tu mano."
    "Nulla snaps you out of your trance by squeezing your hand again."

# game/rutas/nulla.rpy:3968
translate ingles continuacion_nulla_act3_9e78f7e4:

    # "Es él quien los conduce a la mesa. Mientras te ofrece la silla para que te sientes, una de sus sombras hace lo mismo para Sextam."
    "He's the one who leads you both to the table. While he pulls out a chair for you to sit down, one of his shadows does the same for Sextam."

# game/rutas/nulla.rpy:3971
translate ingles continuacion_nulla_act3_16e919ba:

    # "Le dices que no quieres ir, que prefieres esperarlos ya sentado en la mesa. Nulla hace una mueca, desconforme, pero no insiste."
    "You tell him you don't want to go, that you'd rather wait for them at the table. Nulla makes a displeased face, but doesn't insist."

# game/rutas/nulla.rpy:3972
translate ingles continuacion_nulla_act3_e028e854:

    # "Se va, dejándote solo en el comedor."
    "He leaves, abandoning you alone in the dining room."

# game/rutas/nulla.rpy:3973
translate ingles continuacion_nulla_act3_a20cefa7_1:

    # "..."
    "..."

# game/rutas/nulla.rpy:3974
translate ingles continuacion_nulla_act3_b135a47a:

    # "Tú solo esperas..."
    "You simply wait..."

# game/rutas/nulla.rpy:3975
translate ingles continuacion_nulla_act3_8055460e:

    # "Y esperas."
    "And wait."

# game/rutas/nulla.rpy:3976
translate ingles continuacion_nulla_act3_c51d7991:

    # " . . . "
    " . . . "

# game/rutas/nulla.rpy:3977
translate ingles continuacion_nulla_act3_4c492b2a:

    # "Condenado sea Nulla por no tener ningún reloj funcionando en la sala, y con el pollo no puedes contar pues ha sido comido por el vacío como medida para hacer que se callara."
    "Damn Nulla for not having a single working clock in the room. And you can't count on the chicken timer either, since the void swallowed it to shut it up."

# game/rutas/nulla.rpy:3978
translate ingles continuacion_nulla_act3_9685e8e7:

    # "Cuentas los segundos golpeando suavemente tu dedo índice contra la mesa, mientras tu estómago se contraer intentar aguantar los nervios."
    "You count the seconds by gently tapping your index finger against the table, while your stomach tightens as you struggle to keep your nerves under control."

# game/rutas/nulla.rpy:3979
translate ingles continuacion_nulla_act3_51b7b4ad:

    # nulla "Bienvenida, [nombrejugador] nos está esperando en la mesa."
    nulla "Welcome, [nombrejugador] is waiting for us at the table."

# game/rutas/nulla.rpy:3980
translate ingles continuacion_nulla_act3_e6a2b81e:

    # "Escuchas como Nulla saluda a Sextam, y eso te basta para sentir las náuseas formarse en tu garganta y lengua."
    "You hear Nulla greeting Sextam, and that's enough to make nausea rise in your throat and thicken around your tongue."

# game/rutas/nulla.rpy:3982
translate ingles continuacion_nulla_act3_5c8fe5fb:

    # "Tu respiración se acelera pensando en todo lo que podría salir mal ahora. ¡Y no puedes entender por qué mierda Nulla está tan tranquilo! Actúa como si se tratase de un almuerzo con una vieja amiga---"
    "Your breathing quickens as you think about everything that could go wrong now. And why the fuck Nulla is so calm?! He's acting as though this were just lunch with an old friend--"

# game/rutas/nulla.rpy:3989
translate ingles continuacion_nulla_act3_443882b7:

    # "Los ves pasar hacia el comedor, Nulla ofreciendo su brazo para que Sextam camine a su lado. Ella tiene una expresión neutral, la cual no cambia cuando posa sus ojos en ti."
    "You watch them enter the dining room, Nulla offering his arm for Sextam to walk beside him. Her expression is neutral, remaining unchanged even when her eyes settle on you."

# game/rutas/nulla.rpy:3990
translate ingles continuacion_nulla_act3_18a7823a:

    # "Si bien, te sientes incómodo por lo intensidad de su mirada sobre ti, no puedes evitar no mirarla."
    "Although the intensity of her gaze makes you uncomfortable, you can't help looking at her."

# game/rutas/nulla.rpy:3991
translate ingles continuacion_nulla_act3_e9565cf2:

    # "Sextam es hermosa, su cabello ondea con cada paso que ambos dan... parece un manto divino que recubre su cuerpo y lo protege de toda impureza a su alrededor. En cada onda hay una flor que decora su cabellera con un patrón finamente calculado."
    "Sextam is beautiful. Her hair sways with every step they take... it resembles a divine cloak that envelops her body, protecting it from every impurity around her. Each wave is adorned with a flower, arranged in a meticulously calculated pattern."

# game/rutas/nulla.rpy:3992
translate ingles continuacion_nulla_act3_b416e478:

    # "Lleva un vestido blanco, que recubre gran parte de su cuerpo, resguardando su figura."
    "She wears a white dress that covers most of her body, concealing her figure."

# game/rutas/nulla.rpy:3993
translate ingles continuacion_nulla_act3_796fb491:

    # "En su mano libre, lleva una bandeja de plata cubierta..."
    "In her free hand, she carries a covered silver tray..."

# game/rutas/nulla.rpy:3998
translate ingles continuacion_nulla_act3_8713dfa0:

    # "No puedes ver lo que hay en su interior."
    "You can't see what's inside."

# game/rutas/nulla.rpy:4004
translate ingles continuacion_nulla_act3_a20cefa7_2:

    # "..."
    "..."

# game/rutas/nulla.rpy:4005
translate ingles continuacion_nulla_act3_5c1a63f1:

    # "Tú ocupas la cabecera de la mesa, el puesto te deja al descubierto, muy expuesto para tu gusto."
    "You sit at the head of the table, a position that leaves you out in the open, far too exposed for your liking."

# game/rutas/nulla.rpy:4006
translate ingles continuacion_nulla_act3_bb89e13b:

    # "Al otro lado de la mesa se encuentra Sextam, aún sin despegar su mirada de ti. Nulla en cambio, está sentado en medio, haciendo de barrera entre tú y ella."
    "On the other side of the table sits Sextam, still without taking her eyes off you. Nulla, meanwhile, sits between you, acting as a barrier between you and her."

# game/rutas/nulla.rpy:4007
translate ingles continuacion_nulla_act3_453afdba:

    # "Sextam espera, no comenta nada ni intenta sacar a flote una conversación para romper el hielo. Hay un silencio opresivo, del que Nulla tampoco muestra interés en romper, pues parece muy ocupado en observar cómo sus sombras sirven la comida."
    "Sextam waits, saying nothing and making no attempt to strike up a conversation to break the ice. An oppressive silence hangs over the table, one that Nulla shows no interest in breaking either, as he seems far too busy watching his shadows serve the food."

# game/rutas/nulla.rpy:4008
translate ingles continuacion_nulla_act3_8537e384:

    # "Estas hacen su trabajo con diligencia, sirviendo según lo que cada uno pida... Sextam pide vino al igual que Nulla."
    "They carry out their duties diligently, serving whatever each person requests... Sextam asks for wine, just like Nulla."

# game/rutas/nulla.rpy:4009
translate ingles continuacion_nulla_act3_90a2969a:

    # "Al terminar, las sombras desaparecen con el chasquido de Nulla. Aquello parece despertar a Sextam, quien agradece por la comida, pero no toca nada que no sea la copa de vino."
    "Once they're finished, the shadows disappear with a snap of Nulla's fingers. That seems to snap Sextam out of her trance. She thanks him for the meal, but touches nothing except her glass of wine."

# game/rutas/nulla.rpy:4010
translate ingles continuacion_nulla_act3_8d9a06af:

    # "La copa gira en su mano, moviendo levemente el líquido carmesí del interior. Lo hace por un buen rato, sin signos de querer beber el contenido, mientras sus ojos oscilan entre la bandeja que ha traído y tú."
    "She swirls the glass in her hand, gently stirring the crimson liquid inside. She continues doing so for quite some time, showing no sign of wanting to drink it, while her eyes shift between the tray she brought and you."

# game/rutas/nulla.rpy:4011
translate ingles continuacion_nulla_act3_701a6076:

    # "Sin saber que hacer o decir, miras a un lado en busca de Nulla. Él ya ha tomado los utensilios con el fin de consumir lo que está en el plato. Justo lo atrapas en su primer bocado, y por su reacción, sabes que le ha gustado el sabor de la humita."
    "Not knowing what to do or say, you glance to the side, looking for Nulla. He's already picked up his utensils to eat what's on his plate. You catch him just as he takes his first bite, and judging by his reaction, you can tell he likes the taste of the humita."

# game/rutas/nulla.rpy:4012
translate ingles continuacion_nulla_act3_ce3bd96e:

    # nulla "Hmmm~"
    nulla "Hmmm~"

# game/rutas/nulla.rpy:4013
translate ingles continuacion_nulla_act3_41fdbd55:

    # nulla "Está delicioso."
    nulla "It's delicious."

# game/rutas/nulla.rpy:4014
translate ingles continuacion_nulla_act3_20a66869:

    # nulla "Deberías probarlo."
    nulla "You should try it."

# game/rutas/nulla.rpy:4015
translate ingles continuacion_nulla_act3_522c7a47:

    # "Le dice a Sextam."
    "He says to Sextam."

# game/rutas/nulla.rpy:4016
translate ingles continuacion_nulla_act3_d4a38f56:

    # sextam "No tengo hambre."
    sextam "I'm not hungry."

# game/rutas/nulla.rpy:4021
translate ingles continuacion_nulla_act3_00300114:

    # nulla "Bueno, entonces deberías dejar de mirar a [nombrejugador] de esa manera."
    nulla "Well, then you should stop looking at [nombrejugador] like that."

# game/rutas/nulla.rpy:4022
translate ingles continuacion_nulla_act3_0459bf38:

    # "Su rostro no cambia, sigue sonriendo, pero algo en su tono te hace apretar los dientes. La molestia que siente ante el accionar de Sextam se diluye en sus palabras de forma discreta, pero está ahí."
    "His expression doesn't change. He keeps smiling, but something in his tone makes you clench your teeth. His irritation at Sextam's behavior seeps subtly into his words, but it's there."

# game/rutas/nulla.rpy:4023
translate ingles continuacion_nulla_act3_24c75f36:

    # nulla "No me gusta. Lo pones nervioso."
    nulla "I don't like it. You're making them nervous."

# game/rutas/nulla.rpy:4024
translate ingles continuacion_nulla_act3_5f84e5b8:

    # "Sextam hace una pausa con su copa, parando en seco. El líquido en el interior de la copa es lo único que se mueve en su posición."
    "Sextam pauses, stopping her glass mid-motion. The liquid inside it is the only thing that continues to move."

# game/rutas/nulla.rpy:4026
translate ingles continuacion_nulla_act3_2d175fa6:

    # sextam "Y a mí no me gusta que hagas de su vocero."
    sextam "And I don't like you acting as their spokesperson."

# game/rutas/nulla.rpy:4027
translate ingles continuacion_nulla_act3_f96335e6:

    # sextam "Suficiente ya tuviste con ser el vocero de Septem."
    sextam "You've already spent enough time being Septem's spokesperson."

# game/rutas/nulla.rpy:4028
translate ingles continuacion_nulla_act3_76bffa03:

    # "Dice ella, con voz dura, sin perder la paciencia."
    "She says firmly, without losing her composure."

# game/rutas/nulla.rpy:4031
translate ingles continuacion_nulla_act3_02d2995b:

    # nulla "¿Aún te acuerdas de eso?"
    nulla "You still remember that?"

# game/rutas/nulla.rpy:4032
translate ingles continuacion_nulla_act3_3279708e:

    # sextam "..."
    sextam "..."

# game/rutas/nulla.rpy:4037
translate ingles continuacion_nulla_act3_814e2c4e:

    # nulla "Hablando de él, ¿Cómo está?"
    nulla "Speaking of him, how is he?"

# game/rutas/nulla.rpy:4038
translate ingles continuacion_nulla_act3_f82ba05b:

    # "Nulla deja de lado su comida, optando por poner sus codos sobre la mesa para poder juntar ambas manos y recostar su mandíbula en ellas. Sonríe, antelándose a la respuesta, sabiendo que lo que quiera que escuche lo complacerá."
    "Nulla sets his food aside, resting his elbows on the table so he can clasp his hands together and rest his chin on them. He smiles in anticipation of her answer, knowing that whatever he hears will please him."

# game/rutas/nulla.rpy:4043
translate ingles continuacion_nulla_act3_77f5c5db:

    # "Ella en respuesta, suelta una risa seca."
    "In response, she lets out a dry laugh."

# game/rutas/nulla.rpy:4044
translate ingles continuacion_nulla_act3_286ed6c4:

    # sextam "No vine aquí para servir de burla a nadie."
    sextam "I didn't come here to be anyone's laughingstock."

# game/rutas/nulla.rpy:4045
translate ingles continuacion_nulla_act3_07df5166:

    # sextam "Menos dejar que te burles de él."
    sextam "Much less to let you make fun of him."

# game/rutas/nulla.rpy:4046
translate ingles continuacion_nulla_act3_94a0cc64:

    # sextam "Vengo a hablar de nuestras opciones."
    sextam "I came to discuss our options."

# game/rutas/nulla.rpy:4047
translate ingles continuacion_nulla_act3_aeabf5dc:

    # nulla "¿Quieres hablarlo ahora?"
    nulla "You want to talk about it now?"

# game/rutas/nulla.rpy:4048
translate ingles continuacion_nulla_act3_095d37da:

    # sextam "No veo la necesidad de perder el tiempo en una comida de la cual nadie está interesado."
    sextam "I see no reason to waste time on a meal that no one is interested in."

# game/rutas/nulla.rpy:4052
translate ingles continuacion_nulla_act3_2181d0dc:

    # "Para dar más fuerza a su argumento, sus ojos color ámbar se posan en ti y en tu plato sin tocar. Nulla suspira, aceptando en silencio que ella tiene razón."
    "To reinforce her point, her amber eyes settle on you and your untouched plate. Nulla sighs, silently acknowledging that she's right."

# game/rutas/nulla.rpy:4053
translate ingles continuacion_nulla_act3_8e6e38d5:

    # "Sientes que la mirada de Sextam te consume el alma, dejándote solo con un hueco en el pecho que solo se llena de tristeza."
    "You feel as though Sextam's gaze is consuming your soul, leaving nothing but a hollow space in your chest that fills with sadness."

# game/rutas/nulla.rpy:4054
translate ingles continuacion_nulla_act3_22832a01:

    # "No te mira con odio. No te mira con rabia, ni disgusto, ni temor. En sus ojos solo hay pena."
    "She doesn't look at you with hatred. There's no anger, no disgust, no fear in her gaze. Only sorrow."

# game/rutas/nulla.rpy:4055
translate ingles continuacion_nulla_act3_0337174c:

    # sextam "Me sorprende lo bien que te ha resultado."
    sextam "I'm surprised by how well things have worked out for you."

# game/rutas/nulla.rpy:4056
translate ingles continuacion_nulla_act3_b42140f3:

    # sextam "Atrapar a uno de los de arriba."
    sextam "Trapping one of those from above."

# game/rutas/nulla.rpy:4057
translate ingles continuacion_nulla_act3_baa99941:

    # sextam "Por fin lo lograste..."
    sextam "You finally managed it..."

# game/rutas/nulla.rpy:4058
translate ingles continuacion_nulla_act3_75293d0e:

    # nulla "Así es."
    nulla "That's right."

# game/rutas/nulla.rpy:4059
translate ingles continuacion_nulla_act3_99f78619:

    # "Ambos se miran a los ojos, ignorando tu existencia a pesar de están hablando de ti. Sientes que detrás de esta interacción se enconde un conflicto, del cual no estás enterado."
    "They look each other in the eye, ignoring your existence despite the fact that they're talking about you. You sense a conflict hidden beneath this exchange, one you know nothing about."

# game/rutas/nulla.rpy:4064
translate ingles continuacion_nulla_act3_6bf48f95:

    # "Sextam levanta su mano hacia sus cabellos, buscando una de las flores con el fin de extraerla de sus rizos rosas. La mira, tomándose su tiempo para apreciarla. Juega con sus pétalos y traza cada una de las hojas que los sostienen."
    "Sextam raises a hand to her hair, searching for one of the flowers nestled among her pink curls. She plucks it free and gazes at it, taking her time to admire it. She plays with its petals and traces each of the leaves supporting them."

# game/rutas/nulla.rpy:4065
translate ingles continuacion_nulla_act3_ef7e03aa:

    # "Parte de la flor está presentable, bonita a simple vista. Pero si enfocas mejor tus ojos en los detalles, puedes distinguir como las esquinas de los pétalos han comenzado a marchitarse."
    "At first glance, the flower still looks lovely, perfectly presentable. But if you look more closely, you can make out how the edges of its petals have begun to wilt."

# game/rutas/nulla.rpy:4066
translate ingles continuacion_nulla_act3_9901ca5b:

    # sextam "Pasé la noche con Tria. Ella me las dio está mañana."
    sextam "I spent the night with Tria. She gave them to me this morning."

# game/rutas/nulla.rpy:4067
translate ingles continuacion_nulla_act3_444de8cc:

    # sextam "Me dijo que sin Unum no durarían mucho..."
    sextam "She told me they wouldn't last long without Unum..."

# game/rutas/nulla.rpy:4071
translate ingles continuacion_nulla_act3_504c8070:

    # nulla "No pensé que siguiera haciendo flores."
    nulla "I didn't think she still made flowers."

# game/rutas/nulla.rpy:4076
translate ingles continuacion_nulla_act3_461f70b6:

    # "El comentario hace que Sextam le mire, frunciendo el ceño."
    "The comment makes Sextam look at him, frowning."

# game/rutas/nulla.rpy:4077
translate ingles continuacion_nulla_act3_faac7e53:

    # sextam "Hoy ha hecho una excepción."
    sextam "She made an exception today."

# game/rutas/nulla.rpy:4078
translate ingles continuacion_nulla_act3_0650f01b:

    # sextam "Quería que llevara algo suyo en mi cuerpo."
    sextam "She wanted me to wear something of hers on my body."

# game/rutas/nulla.rpy:4081
translate ingles continuacion_nulla_act3_4fdbb46c:

    # "Nulla esboza una pequeña sonrisa que calma un poco a Sextam."
    "Nulla gives a small smile that puts Sextam a little more at ease."

# game/rutas/nulla.rpy:4082
translate ingles continuacion_nulla_act3_436cf588:

    # nulla "Es un lindo gesto."
    nulla "It's a lovely gesture."

# game/rutas/nulla.rpy:4083
translate ingles continuacion_nulla_act3_153f8774:

    # "Suelta con sinceridad, sin ánimos de ofender a la mujer."
    "He says sincerely, with no intention of offending the woman."

# game/rutas/nulla.rpy:4084
translate ingles continuacion_nulla_act3_d40792bd:

    # sextam "Lo es."
    sextam "It is."

# game/rutas/nulla.rpy:4085
translate ingles continuacion_nulla_act3_3279708e_1:

    # sextam "..."
    sextam "..."

# game/rutas/nulla.rpy:4089
translate ingles continuacion_nulla_act3_e2a7ef5f:

    # "Ella suspira, ya sin ganas de extender la conversación. Posa la flor en la mesa, a un lado del plato, y se dispone a continuar."
    "She sighs, no longer wishing to prolong the conversation. She places the flower on the table beside her plate and prepares to continue."

# game/rutas/nulla.rpy:4090
translate ingles continuacion_nulla_act3_9297d869:

    # sextam "Mira Nulla--- Vine aquí a hablar y ver la posibilidad de detener el daño que estás haciendo."
    sextam "Look, Nulla--I came here to talk and see if there's a way to stop the harm you're causing."

# game/rutas/nulla.rpy:4094
translate ingles continuacion_nulla_act3_21289533:

    # nulla "Sextam esto ya lo hablamos años atrás, tú misma piensas que---"
    nulla "Sextam, we already talked about this years ago. You yourself believe that--"

# game/rutas/nulla.rpy:4095
translate ingles continuacion_nulla_act3_a8b0a380:

    # sextam "Sé bien lo que pienso."
    sextam "I know perfectly well what I believe."

# game/rutas/nulla.rpy:4096
translate ingles continuacion_nulla_act3_48a9f521:

    # sextam "No lo hago por mí. Lo hago por los demás."
    sextam "I'm not doing this for myself. I'm doing it for the others."

# game/rutas/nulla.rpy:4097
translate ingles continuacion_nulla_act3_329394fb:

    # "Aquel comentario hace que Nulla cierre la boca, dejando el espacio para que Sextam hable. A ella le toma unos segundos sacar las palabras de su boca, complicada en como traer a la vida todos sus pensamientos."
    "That remark makes Nulla fall silent, giving Sextam room to speak. It takes her a few seconds to find the words, struggling to give voice to all her thoughts."

# game/rutas/nulla.rpy:4098
translate ingles continuacion_nulla_act3_8794bb21:

    # "Cuando por fin los tiene, opta por correr la mirada y cerrar sus ojos."
    "When she finally finds them, she chooses to look away and close her eyes."

# game/rutas/nulla.rpy:4099
translate ingles continuacion_nulla_act3_270afdae:

    # sextam "Si hubieras visto la reacción de los que fueron borrados..."
    sextam "If only you'd seen the reactions..."

# game/rutas/nulla.rpy:4100
translate ingles continuacion_nulla_act3_eaad439d:

    # sextam "Tria apenas podía levantarse cuando salió del espacio que antes era el dominio de Quinque."
    sextam "Tria could barely stand when she emerged from the space that used to be Quinque's domain."

# game/rutas/nulla.rpy:4101
translate ingles continuacion_nulla_act3_47999ce6:

    # "Hace una pausa, clavando sus ojos cristalinos que aguantan un llanto en la figura de Nulla."
    "She pauses, fixing her tear-filled eyes on Nulla, struggling to hold back her tears."

# game/rutas/nulla.rpy:4105
translate ingles continuacion_nulla_act3_bbca2774:

    # sextam "Te odio."
    sextam "I hate you."

# game/rutas/nulla.rpy:4106
translate ingles continuacion_nulla_act3_4b63dab7:

    # sextam "Cuando hablaste de esto, me dijiste que sería rápido."
    sextam "When you told me about this, you said it would be quick."

# game/rutas/nulla.rpy:4107
translate ingles continuacion_nulla_act3_9469d0ec:

    # nulla "Es rápido. Nadie sufre."
    nulla "It is quick. No one suffers."

# game/rutas/nulla.rpy:4108
translate ingles continuacion_nulla_act3_b7ec7ba8:

    # sextam "Los que quedan de último si lo hacen."
    sextam "Those who are left until the end do."

# game/rutas/nulla.rpy:4109
translate ingles continuacion_nulla_act3_10d4d28d:

    # "Él se acomoda en su asiento, harto de las palabras que salen de Sextam. Cruza ambos brazos y corre la cara, cerrado a seguir escuchándola."
    "He shifts in his seat, fed up with everything Sextam is saying. He crosses his arms and turns his face away, unwilling to listen to her any longer."

# game/rutas/nulla.rpy:4112
translate ingles continuacion_nulla_act3_952ca8c0:

    # nulla "Sextam si intentas hacerme sentir mal, ni te esfuerces..."
    nulla "Sextam, if you're trying to make me feel bad, don't even bother..."

# game/rutas/nulla.rpy:4113
translate ingles continuacion_nulla_act3_01cd3259:

    # nulla "Tú misma me comentaste que sería mejor acabar con todo."
    nulla "You were the one who told me it would be better to put an end to everything."

# game/rutas/nulla.rpy:4116
translate ingles continuacion_nulla_act3_d313b51f:

    # sextam "Jamás quise que fuera así."
    sextam "I never wanted it to happen like this."

# game/rutas/nulla.rpy:4119
translate ingles continuacion_nulla_act3_3279708e_2:

    # sextam "..."
    sextam "..."

# game/rutas/nulla.rpy:4120
translate ingles continuacion_nulla_act3_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:4121
translate ingles continuacion_nulla_act3_45ebfc8f:

    # sextam "Septem dice que con la ayuda de [nombrejugador] puede borrarte la memoria."
    sextam "Septem says that with [nombrejugador]'s help, he can erase your memories."

# game/rutas/nulla.rpy:4122
translate ingles continuacion_nulla_act3_ff5cc9d2:

    # "Nulla solo la mira, esperando a que se explique. Pero en su mirada hay algo vacío, que se apaga al instante. Ya en su cara no hay expresión alguna, no hay enojo o disgusto."
    "Nulla simply looks at her, waiting for her to explain. But there's something hollow in his gaze, something that fades instantly. His face is now completely expressionless, showing neither anger nor disgust."

# game/rutas/nulla.rpy:4123
translate ingles continuacion_nulla_act3_c081745e:

    # sextam "Si es que saber la verdad de este mundo es lo que te hace mal, borrarte la memoria puede ser la solución."
    sextam "If knowing the truth about this world is what's hurting you, erasing your memories might be the solution."

# game/rutas/nulla.rpy:4124
translate ingles continuacion_nulla_act3_6fc744a3:

    # sextam "Así evitamos eliminar vidas que no han pedido ser eliminadas..."
    sextam "That way, we can avoid erasing lives that never asked for it..."

# game/rutas/nulla.rpy:4125
translate ingles continuacion_nulla_act3_4cba6ddc:

    # "Nulla te mira de reojo por un instante antes de mirar sus manos, pareciera que está considerando la propuesta. Golpea la mesa con dos de sus dedos, lento y preciso."
    "Nulla glances at you out of the corner of his eye before looking down at his hands. He seems to be considering the proposal. He taps the table with two fingers, slowly and precisely."

# game/rutas/nulla.rpy:4126
translate ingles continuacion_nulla_act3_1a79d145:

    # "Pasa el tiempo y tú sientes que se te va el aire... lo único que quieres es que esta conversación termine para poder respirar tranquilo."
    "Time passes, and you feel the air slipping from your lungs... all you want is for this conversation to end so you can finally breathe easily."

# game/rutas/nulla.rpy:4131
translate ingles continuacion_nulla_act3_a77effd8:

    # nulla "Eso suena muy fácil, muy sensato."
    nulla "That sounds so easy, so sensible."

# game/rutas/nulla.rpy:4132
translate ingles continuacion_nulla_act3_6391a734:

    # "Escupe casi indignado, matizando su tono con una solitaria risa sarcástica. Todo para hace notar su desacuerdo con lo que dicen sus palabras."
    "He spits out the words, almost indignant, punctuating them with a single sarcastic laugh. All to make it clear that he doesn't agree with a word he's saying."

# game/rutas/nulla.rpy:4137
translate ingles continuacion_nulla_act3_f65abc2d:

    # "Ella guarda silencio, esperando a que Nulla le dé más que simplemente aquello. Luego vienen las risas, forzadas, cortas y ásperas que llenan todo el lugar con un débil eco."
    "She remains silent, waiting for Nulla to give her more than just that. Then comes the laughter--forced, short, and harsh--filling the entire room with a faint echo."

# game/rutas/nulla.rpy:4142
translate ingles continuacion_nulla_act3_6e37adf4:

    # nulla "¿Hasta dónde piensa borrar?"
    nulla "How much does he intend to erase?"

# game/rutas/nulla.rpy:4143
translate ingles continuacion_nulla_act3_e2ac5867:

    # nulla "¿Resetear de fábrica?"
    nulla "A factory reset?"

# game/rutas/nulla.rpy:4144
translate ingles continuacion_nulla_act3_42e5345e:

    # nulla "¿Borrar todas las memorias hasta el punto de olvidar quién soy?"
    nulla "Erase every memory until I forget who I am?"

# game/rutas/nulla.rpy:4149
translate ingles continuacion_nulla_act3_38621c2c:

    # "Toma aire, dedicando una sonrisa ladeada a ella, quien no sabe cómo reaccionar a tal respuesta."
    "He takes a breath, giving her a crooked smile. She doesn't know how to react to such an answer."

# game/rutas/nulla.rpy:4154
translate ingles continuacion_nulla_act3_b654e3a9:

    # nulla "Sextam, tú más que nadie sabe lo importante que son las vivencias de un ser vivo para moldear la identidad."
    nulla "Sextam, you of all people know how important a living being's experiences are in shaping their identity."

# game/rutas/nulla.rpy:4159
translate ingles continuacion_nulla_act3_d06a6c2b:

    # nulla "No me vengas con esa mierda de borrar la memoria y final feliz para todos."
    nulla "Don't come at me with that bullshit about erasing memories and giving everyone a happy ending."

# game/rutas/nulla.rpy:4160
translate ingles continuacion_nulla_act3_b5452ce9:

    # "Su voz sube, sin llegar a convertirse en gritos. Hay rabia en cómo se expresa, cada frase que sale de él se transforma en una daga que va dirigida hacia Sextam."
    "His voice rises, though not quite to the point of shouting. There's anger in the way he speaks, every sentence that leaves his mouth turning into a dagger aimed at Sextam."

# game/rutas/nulla.rpy:4161
translate ingles continuacion_nulla_act3_74c0ab71:

    # nulla "¿Y hasta cuándo piensan seguir con toda esta mentira?"
    nulla "And how long do you intend to keep up this entire lie?"

# game/rutas/nulla.rpy:4162
translate ingles continuacion_nulla_act3_45e58999:

    # nulla "¿Van a mentir hasta que se acaben los recursos humanos? ¿y después qué?"
    nulla "Are you going to keep lying until you run out of human resources? And then what?"

# game/rutas/nulla.rpy:4167
translate ingles continuacion_nulla_act3_637fcfaf:

    # nulla "Esperar a que todos comiencen a sufrir de hambre, ¿agonizar hasta que solo queden los Estandartes en pie?"
    nulla "Wait until everyone starts starving? Suffer in agony until only the Symbols are left standing?"

# game/rutas/nulla.rpy:4168
translate ingles continuacion_nulla_act3_e77078bd:

    # nulla "Van a terminar todos locos."
    nulla "You're all going to end up insane."

# game/rutas/nulla.rpy:4169
translate ingles continuacion_nulla_act3_fcec4fcf:

    # nulla "Y lo sabes."
    nulla "And you know it."

# game/rutas/nulla.rpy:4170
translate ingles continuacion_nulla_act3_0490ea03:

    # "Sextam le mira, ya agotada se encoje de hombros."
    "Sextam looks at him, exhausted, and shrugs."

# game/rutas/nulla.rpy:4175
translate ingles continuacion_nulla_act3_1328782c:

    # sextam "Con la ayuda de [nombrejugador] podemos evitar eso."
    sextam "With [nombrejugador]'s help, we can prevent that."

# game/rutas/nulla.rpy:4182
translate ingles continuacion_nulla_act3_6f31d433:

    # nulla "No, no, no. Sabes muy bien que no dependemos de [nombrejugador]."
    nulla "No, no, no. You know perfectly well that we don't depend on [nombrejugador]."

# game/rutas/nulla.rpy:4183
translate ingles continuacion_nulla_act3_e08a314f:

    # nulla "Ustedes dependen de un ser egocéntrico, no de [nombrejugador]. Dependen de Ella y de Padr--- de su estúpida marioneta."
    nulla "You all depend on a self-centered being, not on [nombrejugador]. You depend on Her \nand Fa--Her stupid puppet."

# game/rutas/nulla.rpy:4184
translate ingles continuacion_nulla_act3_353ed716:

    # nulla "[nombrejugador] solo está aquí de visita."
    nulla "[nombrejugador] is only here for a visit."

# game/rutas/nulla.rpy:4185
translate ingles continuacion_nulla_act3_625c08e8:

    # nulla "Y créeme que Ella no los va a soltar."
    nulla "And believe me, She won't let you go."

# game/rutas/nulla.rpy:4186
translate ingles continuacion_nulla_act3_362cafd2:

    # nulla "O se aburre de ustedes o no los va a soltar."
    nulla "Either She gets bored of you, or She never lets you go."

# game/rutas/nulla.rpy:4187
translate ingles continuacion_nulla_act3_8806a279:

    # nulla "Ambos son malos desenlaces."
    nulla "Neither ends well."

# game/rutas/nulla.rpy:4188
translate ingles continuacion_nulla_act3_9ba036af:

    # nulla "Sextam, por favor-"
    nulla "Sextam, please--"

# game/rutas/nulla.rpy:4193
translate ingles continuacion_nulla_act3_88cacd55:

    # sextam "Basta."
    sextam "Enough."

# game/rutas/nulla.rpy:4194
translate ingles continuacion_nulla_act3_accbe664:

    # sextam "Pelear contigo es lo que menos quiero ahora."
    sextam "Arguing with you is the last thing I want right now."

# game/rutas/nulla.rpy:4195
translate ingles continuacion_nulla_act3_3133ceb5:

    # sextam "No vamos a llegar a un acuerdo."
    sextam "We're not going to reach an agreement."

# game/rutas/nulla.rpy:4196
translate ingles continuacion_nulla_act3_0851af1c:

    # sextam "Ya he hecho lo que Septem me ha pedido---"
    sextam "I've already done what Septem asked of me--"

# game/rutas/nulla.rpy:4197
translate ingles continuacion_nulla_act3_43daf59c:

    # sextam "No voy a gastar más tiempo haciendo esto."
    sextam "I'm not going to waste any more time on this."

# game/rutas/nulla.rpy:4202
translate ingles continuacion_nulla_act3_a3b8c24c:

    # "Sextam extiende su mano a la bandeja de plata, toma la tapa y la levanta, revelando lo que hay dentro."
    "Sextam reaches for the silver tray, takes hold of the lid, and lifts it, revealing what's inside."

# game/rutas/nulla.rpy:4203
translate ingles continuacion_nulla_act3_204f48d7:

    # "Es una esfera color esmeralda, similar a la textura y tamaño de las esencias que has comido anteriormente..."
    "It's an emerald-colored sphere, similar in texture and size to the essences you've eaten before..."

# game/rutas/nulla.rpy:4204
translate ingles continuacion_nulla_act3_2ee18ff0:

    # "No tardas en comprender qué y a quién le pertenece."
    "It doesn't take you long to understand what it is and who it belongs to."

# game/rutas/nulla.rpy:4205
translate ingles continuacion_nulla_act3_3b5f93dd:

    # "Es Tria."
    "It's Tria."

# game/rutas/nulla.rpy:4208
translate ingles continuacion_nulla_act3_ad8a31f3:

    # sextam "No quiero que sufra más."
    sextam "I don't want her to suffer anymore."

# game/rutas/nulla.rpy:4213
translate ingles continuacion_nulla_act3_7ad47ca4:

    # sextam "Ni que hagas un espectáculo como lo hiciste con Quinque con su muerte."
    sextam "And I don't want you to make a spectacle of her death like you did with Quinque's."

# game/rutas/nulla.rpy:4218
translate ingles continuacion_nulla_act3_5fab8cc4:

    # sextam "Quiero que se vaya en paz."
    sextam "I want her to go in peace."

# game/rutas/nulla.rpy:4221
translate ingles continuacion_nulla_act3_b8a56c51:

    # "La única reacción que sale del pelinegro es lo mucho que se abren sus ojos. Se le ve perplejo, sin saber cómo contestar más allá de un suspiro o vocal rota."
    "The dark-haired man's only reaction is the way his eyes widen. He looks bewildered, unable to respond with anything more than a sigh or a broken sound."

# game/rutas/nulla.rpy:4222
translate ingles continuacion_nulla_act3_b6dbb24e:

    # nulla "Oh---"
    nulla "Oh--"

# game/rutas/nulla.rpy:4230
translate ingles continuacion_nulla_act3_e6a89f60:

    # "Sus manos se lanzan a tomar la bandeja. Sextam la corre lejos de su alcance antes de que Nulla la alcance, lo que se gana un chasqueo de lengua por parte de Nulla."
    "His hands dart toward the tray. Sextam moves it out of his reach before he can grab it, earning a click of Nulla's tongue."

# game/rutas/nulla.rpy:4231
translate ingles continuacion_nulla_act3_86ed2cd4:

    # sextam "Esto no es para ti."
    sextam "This isn't for you."

# game/rutas/nulla.rpy:4232
translate ingles continuacion_nulla_act3_c86f27a6:

    # sextam "Es para [nombrejugador]."
    sextam "It's for [nombrejugador]."

# game/rutas/nulla.rpy:4233
translate ingles continuacion_nulla_act3_8ee3fcd6:

    # "Nuevamente tus ojos y los de ella se encuentran. Te mira decidida, preparada para las consecuencias de lo que está ofreciendo. Entregando todo lo que le queda a Septem sin reparo..."
    "Once again, your eyes meet hers. She looks at you with determination, prepared for the consequences of what she's offering. Handing over everything Septem has left without hesitation..."

# game/rutas/nulla.rpy:4234
translate ingles continuacion_nulla_act3_56ca6a74:

    # "¿Se han rendido? ¿Es así de fácil?"
    "Have they given up? Is it really that easy?"

# game/rutas/nulla.rpy:4235
translate ingles continuacion_nulla_act3_f313e8cb:

    # "...¿En serio nos van a dar ambas esencias así sin más?"
    "... Are they seriously going to hand over both essences just like that?"

# game/rutas/nulla.rpy:4247
translate ingles continuacion_nulla_act3_91b721df:

    # sextam "Solo les pido una cosa..."
    sextam "I only ask one thing of you..."

# game/rutas/nulla.rpy:4248
translate ingles continuacion_nulla_act3_5f743c25:

    # "Sextam te interrumpe antes de que puedas decir o hacer algo."
    "Sextam interrupts you before you can say or do anything."

# game/rutas/nulla.rpy:4249
translate ingles continuacion_nulla_act3_b4932c3e:

    # sextam "Quiero ver cómo se la come."
    sextam "I want to watch [nombrejugador] eat it."

# game/rutas/nulla.rpy:4260
translate ingles continuacion_nulla_act3_1cc4d7fc:

    # nulla "¿Y eso?"
    nulla "And why is that?"

# game/rutas/nulla.rpy:4261
translate ingles continuacion_nulla_act3_9129389c:

    # "Esta vez Nulla te interrumpe, arqueando una ceja."
    "This time, Nulla interrupts you, raising an eyebrow."

# game/rutas/nulla.rpy:4264
translate ingles continuacion_nulla_act3_b817020e:

    # sextam "No me gustaría dejar a Tria sola en este momento..."
    sextam "I wouldn't want to leave Tria alone at a time like this..."

# game/rutas/nulla.rpy:4265
translate ingles continuacion_nulla_act3_c427262e:

    # nulla "Mmm..."
    nulla "Mmm..."

# game/rutas/nulla.rpy:4272
translate ingles continuacion_nulla_act3_8ccee493:

    # "Se lo dices fuerte y claro, llevando ambas miradas hacia ti. Nulla te mira divertido, como si aguantara una risa. Mientras que Sextam te mira seria y en silencio."
    "You say it loud and clear, drawing both their gazes toward you. Nulla looks at you with amusement, as though holding back a laugh, while Sextam watches you silently, her expression serious."

# game/rutas/nulla.rpy:4273
translate ingles continuacion_nulla_act3_178cfd36:

    # nulla "Discúlpalo, está algo estresado."
    nulla "Excuse them, they're a little stressed."

# game/rutas/nulla.rpy:4274
translate ingles continuacion_nulla_act3_67078d74:

    # "Sonríe, molesto por dentro de que le estés llevando la contraria frente a Sextam."
    "He smiles, inwardly annoyed that you're contradicting him in front of Sextam."

# game/rutas/nulla.rpy:4275
translate ingles continuacion_nulla_act3_eab65480:

    # "{glitch=20.0}{color=ffffff}{b}Cariño, ya están en la ruina.{/glitch}{b}"
    "{glitch=20.0}{color=ffffff}{b}Cariño, they're already ruined.{/glitch}{b}"

# game/rutas/nulla.rpy:4276
translate ingles continuacion_nulla_act3_88723023:

    # "{glitch=20.0}{color=ffffff}{b}Sextam no miente y la esencia de Tria está aquí.{/glitch}{b}"
    "{glitch=20.0}{color=ffffff}{b}Sextam isn't lying, and Tria's essence is right here.{/glitch}{b}"

# game/rutas/nulla.rpy:4277
translate ingles continuacion_nulla_act3_f1bd3e81:

    # "{glitch=20.0}{color=ffffff}{b}No hay nada de que temer.{/glitch}{b}"
    "{glitch=20.0}{color=ffffff}{b}There's nothing to be afraid of.{/glitch}{b}"

# game/rutas/nulla.rpy:4278
translate ingles continuacion_nulla_act3_ff388d94:

    # "Quieres decirle que esto es muy fácil, que debe haber algo extraño, pero tus labios no responden... con pena confirmas que él te ha incapacitado de usar tu boca."
    "You want to tell him that this is too easy, that something must be wrong, but your lips won't respond... to your dismay, you realize he's taken away your ability to speak."

# game/rutas/nulla.rpy:4279
translate ingles continuacion_nulla_act3_b8da79d9:

    # "Sabes que a Nulla ya se le han subido los humos a la cabeza, que ya prácticamente sueña con completar su misión. Ya en su mente ha ganado, pero--"
    "You know Nulla has already let everything go to his head, that he's practically dreaming of completing his mission. In his mind, he's already won, but--"

# game/rutas/nulla.rpy:4280
translate ingles continuacion_nulla_act3_5d73b0d5:

    # "Hay algo que no calza. No te tragas la excusa de que se han rendido."
    "Something doesn't add up. You don't buy the excuse that they've given up."

# game/rutas/nulla.rpy:4281
translate ingles continuacion_nulla_act3_76519205:

    # "{glitch=20.0}{color=ffffff}{b}Vida mía, si pasa algo. Yo me encargaré de arreglarlo.{/glitch}{b}"
    "{glitch=20.0}{color=ffffff}{b}Vida mía, if anything happens, I'll take care of it.{/glitch}{b}"

# game/rutas/nulla.rpy:4282
translate ingles continuacion_nulla_act3_fccdcf4f:

    # "{glitch=20.0}{color=ffffff}{b}No hay nada que ya no pueda hacer.{/glitch}{b}"
    "{glitch=20.0}{color=ffffff}{b}There's nothing I can't do anymore.{/glitch}{b}"

# game/rutas/nulla.rpy:4283
translate ingles continuacion_nulla_act3_4babd78f:

    # "{glitch=20.0}{color=ffffff}{b}Confía en mí...{/glitch}{b}"
    "{glitch=20.0}{color=ffffff}{b}Trust me...{/glitch}{b}"

# game/rutas/nulla.rpy:4284
translate ingles continuacion_nulla_act3_6d02f1f3:

    # "{glitch=20.0}{color=ffffff}{b}Sé que no te gusta hacer esto, así que lo haré por ti.{/glitch}{b}"
    "{glitch=20.0}{color=ffffff}{b}I know you don't like doing this, so I'll do it for you.{/glitch}{b}"

# game/rutas/nulla.rpy:4285
translate ingles continuacion_nulla_act3_02a67570:

    # "Te das cuenta a lo que se refiere demasiado tarde. Ambas manos buscan la esencia que te ofrece Nulla, con ayuda de una de sus sombras."
    "You realize what he means too late. Both your hands reach for the essence Nulla offers you with the help of one of his shadows."

# game/rutas/nulla.rpy:4286
translate ingles continuacion_nulla_act3_288b014d:

    # "Te mueve como a una muñeca, y a pesar de la resistencia que haces, es imposible volver a tomar el control de tu cuerpo."
    "He moves you like a doll, and despite your resistance, it's impossible to regain control of your body."

# game/rutas/nulla.rpy:4294
translate ingles continuacion_nulla_act3_efc875a6:

    # "La tomas con las manos desnudas. En tus manos se mueve como si palpitara, llena de vida aún. Inspeccionas un poco su configuración, encontrando que dentro de la capa exterior hay pequeñas chispas de luz que titilan organizadas por un orden que desconoces."
    "You take it in your bare hands. It moves in your grasp as though pulsating, still full of life. You examine its structure for a moment, discovering tiny sparks of light flickering beneath its outer layer, arranged in a pattern you don't recognize."

# game/rutas/nulla.rpy:4295
translate ingles continuacion_nulla_act3_0c76a210:

    # "Si este fuera otro contexto, estarías feliz de apreciar lo bello de este órgano."
    "Under different circumstances, you'd be happy to admire the beauty of this organ."

# game/rutas/nulla.rpy:4299
translate ingles continuacion_nulla_act3_bd078d8c:

    # "Subes la cabeza antes de darle el bocado que le otorgará el final a este Estandarte. Nulla te observa confiado, sin borrar esa sonrisa triunfante que venía escapándose desde el momento en que Sextam se ha sentado en la mesa."
    "You raise your head before taking the bite that will bring this Symbols' existence to an end. Nulla watches you confidently, never losing that triumphant smile that's been creeping onto his face ever since Sextam sat down at the table."

# game/rutas/nulla.rpy:4301
translate ingles continuacion_nulla_act3_913863f1:

    # "Ella, en cambio, yace como piedra. Sin un solo parpadeo o mueca, te observa desde la otra cabecera."
    "She, on the other hand, remains as still as a stone. Without blinking or showing the slightest expression, she watches you from the opposite end of the table."

# game/rutas/nulla.rpy:4308
translate ingles continuacion_nulla_act3_77e87476:

    # "Sin otra salida, y mientras cierras los ojos, tragas la esencia."
    "With no other way out, you close your eyes and swallow the essence."

# game/rutas/nulla.rpy:4309
translate ingles continuacion_nulla_act3_40eb28ff:

    # "No sientes nada."
    "You feel nothing."

# game/rutas/nulla.rpy:4310
translate ingles continuacion_nulla_act3_0a677e5a:

    # "No hay dolor ajeno o tuyo que se cultive en tu estómago. Es como beber agua."
    "No pain, neither yours nor anyone else's, takes root in your stomach. It's like drinking water."

# game/rutas/nulla.rpy:4312
translate ingles continuacion_nulla_act3_94626f1b:

    # centered "{sc=5}{size=*2.0}[nombrejugador].{/size}{/sc}"
    centered "{sc=5}{size=*2.0}[nombrejugador].{/size}{/sc}"

# game/rutas/nulla.rpy:4314
translate ingles continuacion_nulla_act3_a886ac79:

    # "Tu nombre es pronunciado, el llamado te eriza los cabellos de la nuca y obliga a mirar que pasa en tu alrededor."
    "Someone speaks your name. The call makes the hairs on the back of your neck stand on end, forcing you to look at what's happening around you."

# game/rutas/nulla.rpy:4320
translate ingles continuacion_nulla_act3_00c70bd2:

    # "Es Sextam, se ha subido a la mesa, sin importarle la comida repartida en esta. Sus pies derraman liquido y botan platos al suelo."
    "It's Sextam. She's climbed onto the table, paying no attention to the food spread across it. Her feet spill drinks and knock plates onto the floor."

# game/rutas/nulla.rpy:4321
translate ingles continuacion_nulla_act3_379686a5:

    # nulla "Detente, no te puedes acercar."
    nulla "Stop. You can't come any closer."

# game/rutas/nulla.rpy:4322
translate ingles continuacion_nulla_act3_500acae8:

    # nulla "Esto no es parte del acuerdo."
    nulla "This wasn't part of the agreement."

# game/rutas/nulla.rpy:4323
translate ingles continuacion_nulla_act3_b0d1c6ad:

    # sextam "Solo le voy a entregar mi esencia."
    sextam "I'm only going to give [nombrejugador] my essence."

# game/rutas/nulla.rpy:4324
translate ingles continuacion_nulla_act3_b03d6304:

    # "Te mira desde arriba, tapando todo lo que te rodea. Dejándote totalmente a su merced. Apenas puedes distinguir sus rasgos faciales, su cabello te impide hacerlo. Solo tienes acceso a sus ojos, cuyo brillo te atrapa, helando tu sangre."
    "She looks down at you, blocking out everything around you. Leaving you completely at her mercy. You can barely make out her facial features, obscured by her hair. All you can see are her eyes, their glow holding you captive and chilling your blood."

# game/rutas/nulla.rpy:4325
translate ingles continuacion_nulla_act3_b9da6d50:

    # "Las flores que Tria le ha dado siguen decorando su cabellera."
    "The flowers Tria gave her still adorn her hair."

# game/rutas/nulla.rpy:4326
translate ingles continuacion_nulla_act3_417b49e7:

    # sextam "Nulla---"
    sextam "Nulla--"

# game/rutas/nulla.rpy:4327
translate ingles continuacion_nulla_act3_fe9c47ef:

    # "En movimientos lentos, las flores se desprenden de sus cabellos. Algunas caen en tu plato, otras a tu alrededor."
    "Slowly, the flowers come loose from her locks. Some drift onto your plate, others around you."

# game/rutas/nulla.rpy:4328
translate ingles continuacion_nulla_act3_9f502122:

    # sextam "Tria es rencorosa."
    sextam "Tria holds grudges."

# game/rutas/nulla.rpy:4334
translate ingles continuacion_nulla_act3_3010089a:

    # "Escuchas movimiento, una silla caer y la respiración de Nulla entrecortarse."
    "You hear movement, a chair falling, and Nulla's breath catching in his throat."

# game/rutas/nulla.rpy:4335
translate ingles continuacion_nulla_act3_71a2c0ba:

    # sextam "Recuerda que yo me iré por mis propias manos, no me puedes atacar, ni yo a ti..."
    sextam "Remember, I'll be leaving by my own hand. You can't attack me, nor can I attack you..."

# game/rutas/nulla.rpy:4336
translate ingles continuacion_nulla_act3_5e772eba:

    # nulla "Eres una---"
    nulla "You are a--"

# game/rutas/nulla.rpy:4337
translate ingles continuacion_nulla_act3_5994da85:

    # "Una de las flores cae en tu antebrazo, provocando que esta se marchite, desintegrándose hasta solo ser polvo. El resto de las flores le siguen en una reacción en cadena."
    "One of the flowers falls onto your forearm, where it withers and disintegrates into dust. The remaining flowers follow in a chain reaction."

# game/rutas/nulla.rpy:4338
translate ingles continuacion_nulla_act3_77cb0422:

    # "Es en ese momento en que dentro de ti, tu estómago se aprieta. Sientes como pequeñas agujas se clavan en el, impidiendo que puedas correr o moverte."
    "It's at that moment that your stomach tightens. You feel tiny needles piercing it, keeping you from running or moving."

# game/rutas/nulla.rpy:4339
translate ingles continuacion_nulla_act3_0006737d:

    # "Un dolor intenso se origina dentro de ti, uno que no te suelta, te retuerce y estruja. Se esparce por todo tu cuerpo, desde la boca del estómago hasta la faringe, en una sanción de náuseas y agonía."
    "An intense pain erupts deep inside you, one that refuses to let go, twisting and squeezing you. It spreads throughout your body, from the pit of your stomach to your throat, bringing waves of nausea and agony."

# game/rutas/nulla.rpy:4340
translate ingles continuacion_nulla_act3_2417290e:

    # "Tu cuerpo pide a gritos expulsar lo que te has comido. Quieres vomitar, pero no puedes."
    "Your body is screaming to expel what you've eaten. You want to vomit, but you can't."

# game/rutas/nulla.rpy:4341
translate ingles continuacion_nulla_act3_9bf855eb:

    # sextam "Creo que tendrán que ver a Septem antes de tiempo..."
    sextam "I think you'll have to see Septem sooner than expected..."

# game/rutas/nulla.rpy:4342
translate ingles continuacion_nulla_act3_6386a519:

    # sextam "Se me ha olvidado santificar el postre."
    sextam "I forgot to sanctify the dessert."

# game/rutas/nulla.rpy:4343
translate ingles continuacion_nulla_act3_c509f434:

    # "Miras con horror como sus manos apuntan a su pecho, buscando el punto perfecto para clavar sus uñas en la piel y romper esa cáscara que es llamado cuerpo. De la herida emana un líquido rojo, que se asimila a la sangre por lo viscoso que es."
    "You watch in horror as her hands move toward her chest, searching for the perfect spot to dig her nails into her skin and tear open that shell called a body. A red liquid seeps from the wound, resembling blood in its viscosity."

# game/rutas/nulla.rpy:4347
translate ingles continuacion_nulla_act3_669a3394:

    # "Una de sus manos rompe la carne y huesos que protegen la esencia, mientras que la otra hurga la cavidad con dureza, desesperada por sacarla lo antes posible."
    "One of her hands tears through the flesh and bones protecting the essence, while the other digs roughly into the cavity, desperate to pull it out as quickly as possible."

# game/rutas/nulla.rpy:4348
translate ingles continuacion_nulla_act3_3cf7a33d:

    # "En cuestión de segundos, la esencia es extraída sin cuidado, con asco y desprecio. Parte del líquido que la recubre cae en tu cara."
    "Within seconds, the essence is ripped out carelessly, with disgust and contempt. Some of the liquid coating it splashes onto your face."

# game/rutas/nulla.rpy:4349
translate ingles continuacion_nulla_act3_f73ca7c9:

    # sextam "No te molestes en borrar nuestros dominios tan rápido. La marioneta ya está envenenada y no hay nadie que la pueda curar---"
    sextam "Don't bother erasing our domains so quickly. The puppet is already poisoned, and there's no one who can cure it--"

# game/rutas/nulla.rpy:4350
translate ingles continuacion_nulla_act3_d0e9a901:

    # "Sus palabras se pierden en la sangre que sale de su boca, se ahoga con ella. A pesar de esto, ella se agacha y ofrece la esencia, presentándola ante ti."
    "Her words are lost in the blood pouring from her mouth. She's choking on it. Despite this, she bends down and offers you the essence, holding it out before you."

# game/rutas/nulla.rpy:4351
translate ingles continuacion_nulla_act3_cbcbe0e8:

    # "Con ambas manos, la lleva a tu boca, y la empuja contra tus labios, obligando a darle paso entre tus dientes y lengua."
    "With both hands, she brings it to your mouth and presses it against your lips, forcing it past your teeth and tongue."

# game/rutas/nulla.rpy:4356
translate ingles continuacion_nulla_act3_e378046f:

    # "Una vez dentro de tu cuerpo, la figura de Sextam se esfuma como espuma. Desaparece de tu campo de visión, librándote de su presencia."
    "Once it's inside your body, Sextam's figure dissolves like foam. She disappears from your field of vision, freeing you from her presence."

# game/rutas/nulla.rpy:4357
translate ingles continuacion_nulla_act3_26bdb319:

    # nulla "¡[nombrejugador]!"
    nulla "[nombrejugador]!"

# game/rutas/nulla.rpy:4358
translate ingles continuacion_nulla_act3_78225f15:

    # "Nulla se levanta del suelo y corre hacia ti para verificar tu estado. Toma tu cara, apretando más de la cuenta, desesperado por saber qué pasa."
    "Nulla gets up from the floor and rushes toward you to check on your condition. He grabs your face, squeezing harder than he should, desperate to find out what's happening."

# game/rutas/nulla.rpy:4359
translate ingles continuacion_nulla_act3_6acef4df:

    # nulla "¡Puta mierda!"
    nulla "¡Puta mierda!"

# game/rutas/nulla.rpy:4360
translate ingles continuacion_nulla_act3_e32f6c25:

    # "Nulla se aferra a ti, te abre la camisa, arrancando varios de los botones en el proceso. Sus ojos caen en tu estómago, apretando la mandíbula cuando ve algo que no logras percibir a simple vista."
    "Nulla clings to you and pulls open your shirt, ripping off several buttons in the process. His eyes fall on your stomach, his jaw tightening when he sees something you can't make out with the naked eye."

# game/rutas/nulla.rpy:4361
translate ingles continuacion_nulla_act3_49d61ba9:

    # nulla "¡Mierda!"
    nulla "¡Mierda!"

# game/rutas/nulla.rpy:4362
translate ingles continuacion_nulla_act3_86579f0b:

    # "Sientes que estás por caer inconsciente. La vista se te nubla, y las náuseas no te permiten respirar como es debido. A penas puedes mover tus piernas, siendo imposible levantarte de la silla."
    "You feel like you're about to lose consciousness. Your vision blurs, and the nausea keeps you from breathing properly. You can barely move your legs, making it impossible to get up from the chair."

# game/rutas/nulla.rpy:4363
translate ingles continuacion_nulla_act3_4dfa5236:

    # "Antes de que caigas inconsciente Nulla abre un portal para atraparte en el vacío."
    "Before you lose consciousness, Nulla opens a portal to catch you in the void."

# game/rutas/nulla.rpy:4367
translate ingles continuacion_nulla_act3_65dd1a7f:

    # nulla "No te preocupes, aguanta un poco."
    nulla "Don't worry, just hold on a little longer."

# game/rutas/nulla.rpy:4373
translate ingles continuacion_nulla_act3_cea28e34:

    # "..........."
    "..........."

# game/rutas/nulla.rpy:4374
translate ingles continuacion_nulla_act3_085768d9:

    # "................"
    "................"

# game/rutas/nulla.rpy:4378
translate ingles continuacion_nulla_act3_eaed7b26:

    # "Escuchas una risa femenina, ya la has escuchado antes, se te hace conocida. Su efecto te recuerda a una canción de cuna, una que te acompañó en los primeros momentos de vida."
    "You hear a woman's laughter. You've heard it before, and it sounds familiar. Its effect reminds you of a lullaby, one that accompanied you during the earliest moments of your life."

# game/rutas/nulla.rpy:4379
translate ingles continuacion_nulla_act3_79ef2467:

    # "Es sedosa, suave. Es similar a una caricia que te invita a seguirla, para tener más de ella. Te mece en tu dolor, calmando un poco esa herida interna que te dificulta la respiración."
    "It's silky... gentle, like a caress that beckons you to follow it, yearning for more. It cradles you through your pain, soothing the inner wound that makes it difficult to breathe."

# game/rutas/nulla.rpy:4380
translate ingles continuacion_nulla_act3_490b4c5e:

    # madre "Esta cosa está por morir."
    madre "This thing is about to die."

# game/rutas/nulla.rpy:4381
translate ingles continuacion_nulla_act3_3a71353a:

    # "Ella suelta aire, sin llegar a ser una risa o un suspiro."
    "She lets out a breath, neither quite a laugh nor a sigh."

# game/rutas/nulla.rpy:4382
translate ingles continuacion_nulla_act3_5ce2fcae:

    # madre "No hay nada que hacer, Nulla."
    madre "There's nothing to be done, Nulla."

# game/rutas/nulla.rpy:4383
translate ingles continuacion_nulla_act3_104f96c5:

    # "No puedes moverte, hablar, ni mirar. Estás atrapado, flotando en el vacío, asfixiándote en tu propio dolor."
    "You can't move, speak, or see. You're trapped, floating in the void, suffocating in your own pain."

# game/rutas/nulla.rpy:4384
translate ingles continuacion_nulla_act3_93d931a7:

    # nulla "No, no, no, no me puedes hacer esto ahora."
    nulla "No, no, no, you can't do this to me now."

# game/rutas/nulla.rpy:4385
translate ingles continuacion_nulla_act3_5e03b12d:

    # nulla "¿Cómo se supone que mate a Septem sin ella?"
    nulla "How am I supposed to kill Septem without them?"

# game/rutas/nulla.rpy:4386
translate ingles continuacion_nulla_act3_6e6d8df7:

    # nulla "Yo solo no puedo herirlo y [nombrejugador] necesita un cuerpo."
    nulla "I can't hurt him on my own, and [nombrejugador] needs a body."

# game/rutas/nulla.rpy:4387
translate ingles continuacion_nulla_act3_d5bbc295:

    # madre "..."
    madre "..."

# game/rutas/nulla.rpy:4388
translate ingles continuacion_nulla_act3_c50b9a4b:

    # nulla "¡Grimal!"
    nulla "Grimal!"

# game/rutas/nulla.rpy:4389
translate ingles continuacion_nulla_act3_b3336eb3:

    # "Hay una pausa, durante la cual lo único que se oye es el movimiento de ropas siendo arrastradas por el suelo."
    "There's a pause, during which the only sound is that of fabric dragging across the floor."

# game/rutas/nulla.rpy:4390
translate ingles continuacion_nulla_act3_a3476a67:

    # madre "Ya no hay nada que me ligue a este lugar. Esto no es más que espacio muerto en un mar de ideas."
    madre "There's nothing tying me to this place anymore. This is nothing more than dead space in a sea of ideas."

# game/rutas/nulla.rpy:4391
translate ingles continuacion_nulla_act3_8ef4e95f:

    # "Luego, una mano ejerce presión en tu pecho, aliviando la punzada que tienes en el estómago."
    "Then, a hand presses against your chest, easing the stabbing pain in your stomach."

# game/rutas/nulla.rpy:4392
translate ingles continuacion_nulla_act3_88b69714:

    # madre "Lo único que me detiene es esta cosa---"
    madre "The only thing holding me back is this thing--"

# game/rutas/nulla.rpy:4393
translate ingles continuacion_nulla_act3_fa707a45:

    # nulla "Yo cumplí con mi parte del trato."
    nulla "I held up my end of the deal."

# game/rutas/nulla.rpy:4394
translate ingles continuacion_nulla_act3_2fcdaeb0:

    # nulla "No me vas a dejar sin nada para completar lo que yo quiero."
    nulla "You're not going to leave me with nothing to finish what I set out to do."

# game/rutas/nulla.rpy:4395
translate ingles continuacion_nulla_act3_1f541bd6:

    # nulla "Dame una solución para este cuerpo defectuoso, es tu culpa no haberlo diseñado para este inconveniente."
    nulla "Give me a solution for this defective body. It's your fault for not designing it to handle this problem."

# game/rutas/nulla.rpy:4396
translate ingles continuacion_nulla_act3_54b33c0d:

    # madre "Tan insignificante, y aun así demandando más... eres igual a él, usurpador."
    madre "So insignificant, yet still demanding more... you're just like him, usurper."

# game/rutas/nulla.rpy:4397
translate ingles continuacion_nulla_act3_f595b8d5:

    # madre "...uhg."
    madre "... Uhg."

# game/rutas/nulla.rpy:4398
translate ingles continuacion_nulla_act3_6edbab52:

    # madre "Esa cara que estás haciendo---"
    madre "That face you're making--"

# game/rutas/nulla.rpy:4399
translate ingles continuacion_nulla_act3_41bf5a49:

    # madre "Agradece que te pareces a él. Sin esa cara no habrías conseguido nada de mí."
    madre "Be grateful you look like him. Without that face, you wouldn't have gotten a thing from me."

# game/rutas/nulla.rpy:4400
translate ingles continuacion_nulla_act3_d5bbc295_1:

    # madre "..."
    madre "..."

# game/rutas/nulla.rpy:4401
translate ingles continuacion_nulla_act3_ec3ab6d9:

    # madre "Voy a ver que puedo hacer."
    madre "I'll see what I can do."

# game/rutas/nulla.rpy:4406
translate ingles continuacion_nulla_act3_da1aa1e0:

    # "Un calor se acumula en la zona de tu vientre, haciéndose cada vez más intenso con el pasar de los segundos. El calor pasa a convertirse en dolor al sentir cómo dos objetos extraños te perforan el ombligo."
    "Heat builds up in your abdomen, growing more intense with every passing second. The warmth turns into pain as you feel two foreign objects pierce through your navel."

# game/rutas/nulla.rpy:4407
translate ingles continuacion_nulla_act3_21e4733b:

    # "Te abren la piel sin piedad, haciendo los cortes necesarios para poder acceder al interior."
    "They mercilessly slice open your skin, making the necessary cuts to reach what's inside."

# game/rutas/nulla.rpy:4408
translate ingles continuacion_nulla_act3_78a29c57:

    # "Quieres gritar, pero ninguna parte de lo que llamas cuerpo responde. Ni siquiera sabes si estás respirando aún o si tus ojos funcionan."
    "You want to scream, but no part of what you call your body responds. You don't even know if you're still breathing or if your eyes are working."

# game/rutas/nulla.rpy:4409
translate ingles continuacion_nulla_act3_3da10bb4:

    # "El dolor es todo lo que eres actualmente, sientes es como abren y escarban en tu abdomen sacando vísceras tras vísceras sin cuidado alguno. La sangre inunda tus sentidos; su olor, tus fosas nasales--- y su sabor en tu lengua."
    "Pain is all you are now. You feel them opening up your abdomen and digging through it, pulling out organ after organ without the slightest care. Blood overwhelms your senses; its smell fills your nostrils--and its taste coats your tongue."

# game/rutas/nulla.rpy:4410
translate ingles continuacion_nulla_act3_8293dd77:

    # "No hay mucha diferencia entre tu cuerpo y un trozo de carne siendo mutilada."
    "There's little difference between your body and a piece of meat being mutilated."

# game/rutas/nulla.rpy:4411
translate ingles continuacion_nulla_act3_ce4770c2:

    # nulla "Le duele."
    nulla "It hurts them."

# game/rutas/nulla.rpy:4412
translate ingles continuacion_nulla_act3_bbbd3f8d:

    # madre "Te recuerdo que esto es solo una marioneta."
    madre "Let me remind you that this is only a puppet."

# game/rutas/nulla.rpy:4413
translate ingles continuacion_nulla_act3_6c9d10c1:

    # "Algo se enrosca en tus órganos, tirando de ellos. Los corta y expulsa fuera tuyo. Su ausencia es desesperante, al igual que el sangrado."
    "Something coils around your organs, pulling at them. It cuts them loose and drags them out of your body. Their absence is unbearable, as is the bleeding."

# game/rutas/nulla.rpy:4414
translate ingles continuacion_nulla_act3_7fc4d3ee:

    # "Te vas a desmayar en cualquier momento."
    "You're going to pass out at any moment."

# game/rutas/nulla.rpy:4415
translate ingles continuacion_nulla_act3_18a3d48c:

    # nulla "Pero---"
    nulla "But--"

# game/rutas/nulla.rpy:4416
translate ingles continuacion_nulla_act3_1b6d92e6:

    # madre "[nombrejugador] no está sintiendo nada de esto ahora mismo."
    madre "[nombrejugador] isn't feeling any of this right now."

# game/rutas/nulla.rpy:4417
translate ingles continuacion_nulla_act3_59958981:

    # madre "Déjame trabajar."
    madre "Let me work."

# game/rutas/nulla.rpy:4418
translate ingles continuacion_nulla_act3_31c05f86:

    # "Tu tortura se extiende por lo que parecieran ser horas. Siendo ultrajado hasta el punto en que han destrozado todo órgano interior cuya función esté vinculada con el sistema digestivo."
    "Your torture drags on for what feels like hours. Your body is violated to the point where every internal organ connected to your digestive system has been destroyed."

# game/rutas/nulla.rpy:4419
translate ingles continuacion_nulla_act3_7e44097c:

    # "Su ausencia se hace notar... hay un espacio extraño dentro de ti que no se siente habitado, un vacío que duele y sangra."
    "Their absence is unmistakable... there's a strange, unoccupied space inside you, an emptiness that aches and bleeds."

# game/rutas/nulla.rpy:4420
translate ingles continuacion_nulla_act3_4b791004:

    # "Algo golpea tu pecho, dándose el gusto de utilizar toda su fuerza en el impacto, sin importarle mucho cuanto has sufrido ya. El golpe te despierta, reincorporando una posición más cómoda para vomitar lo que yace atrapado en tu garganta."
    "Something strikes your chest, taking full advantage of the chance to hit you with all its strength, without caring how much you've already suffered. The blow jolts you awake, bringing you into a more comfortable position to vomit whatever is trapped in your throat."

# game/rutas/nulla.rpy:4421
translate ingles continuacion_nulla_act3_29f6bb9f:

    # "Lo expulsas entre saliva y bilis, siéndote repulsivo sentir como aquello pasa por tu garganta y boca."
    "You expel it along with saliva and bile, disgusted by the sensation of it passing through your throat and mouth."

# game/rutas/nulla.rpy:4426
translate ingles continuacion_nulla_act3_5aab1143:

    # "Cuando ya no hay nada más que sacar, abres los ojos. Nulla te mira preocupado, mientras que Madre lo hace con indiferencia."
    "When there's nothing left to expel, you open your eyes. Nulla looks at you with concern, while Mother watches with indifference."

# game/rutas/nulla.rpy:4427
translate ingles continuacion_nulla_act3_9b7834b7:

    # madre "Ahí está."
    madre "There it is."

# game/rutas/nulla.rpy:4428
translate ingles continuacion_nulla_act3_f5388708:

    # madre "Usa bien el tiempo. No le quedan más de dos días."
    madre "Make good use of your time. It has no more than two days left."

# game/rutas/nulla.rpy:4429
translate ingles continuacion_nulla_act3_7242a9e5:

    # madre "Lo justo para tu plan."
    madre "Just enough for your plan."

# game/rutas/nulla.rpy:4430
translate ingles continuacion_nulla_act3_d3387e86:

    # nulla "Gracias."
    nulla "Thank you."

# game/rutas/nulla.rpy:4431
translate ingles continuacion_nulla_act3_f427f2ef:

    # madre "Hmm..."
    madre "Hmm..."

# game/rutas/nulla.rpy:4432
translate ingles continuacion_nulla_act3_409f8636_1:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:4433
translate ingles continuacion_nulla_act3_612c4986:

    # nulla "¿Qué piensas hacer ahora?"
    nulla "What are you planning to do now?"

# game/rutas/nulla.rpy:4434
translate ingles continuacion_nulla_act3_a9568f84:

    # "Ella le dedica una mirada fulminante desde su lugar. Le mira cómo si lo que ha preguntado fuera lo más estúpido y obvio del mundo, casi que reprochando la mera existencia de la pregunta."
    "She shoots him a piercing glare from where she stands. She looks at him as though he's asked the most stupid, obvious question in the world, almost reproaching him for even asking it."

# game/rutas/nulla.rpy:4435
translate ingles continuacion_nulla_act3_adbe36c3:

    # "No se mueve ni parpadea. Aquello hace que Nulla se acerque un poco más a ti, temiendo una respuesta violenta por su parte."
    "She neither moves nor blinks. This makes Nulla move a little closer to you, fearing a violent reaction from her."

# game/rutas/nulla.rpy:4436
translate ingles continuacion_nulla_act3_dd2441d2:

    # madre "Septem sigue con vida aún... no lo voy a dejar solo."
    madre "Septem is still alive... I'm not going to leave him alone."

# game/rutas/nulla.rpy:4437
translate ingles continuacion_nulla_act3_38cca0eb:

    # madre "Pero cuando todo haya terminado, me iré lejos de este lugar."
    madre "But once everything is over, I'll go far away from this place."

# game/rutas/nulla.rpy:4438
translate ingles continuacion_nulla_act3_2d32ac7e:

    # "Dice mirando a un punto fijo del cielo infinito del vacío."
    "She says, gazing at a fixed point in the infinite sky of the void."

# game/rutas/nulla.rpy:4439
translate ingles continuacion_nulla_act3_48d98446:

    # madre "Allá, a la esfera más lejana..."
    madre "Over there, to the farthest sphere..."

# game/rutas/nulla.rpy:4443
translate ingles continuacion_nulla_act3_5867378e:

    # "Sigues la trayectoria donde sus ojos se enfocan, quieres ver que es lo que contempla con tanta esperanza. Aunque solo te topas con oscuridad entre más oscuridad. Nada interesante que ver. Tal vez ella, siendo una diosa, puede ver más allá que un ojo mortal podría soñar."
    "You follow the direction of her gaze, wanting to see what she's looking at with such hope. But all you find is darkness upon darkness. Nothing interesting to see. Perhaps she, being a goddess, can see farther than any mortal eye could ever dream of."

# game/rutas/nulla.rpy:4444
translate ingles continuacion_nulla_act3_126a978f:

    # "Pasa un tiempo observando, hasta descubrir sus dientes en una mueca de disgusto, como si lo que ha visto le causara repugnancia."
    "She spends some time observing, until she bares her teeth in a grimace of disgust, as though something she's seen has repulsed her."

# game/rutas/nulla.rpy:4448
translate ingles continuacion_nulla_act3_4266c2ad:

    # madre "El maldito de Ciro ha aprovechado mi ausencia--- uhg!"
    madre "That damned Ciro has taken advantage of my absence--uhg!"

# game/rutas/nulla.rpy:4449
translate ingles continuacion_nulla_act3_1844996c:

    # madre "Mi mundo original sigue allí... Debo poner orden en su sistema."
    madre "My original world is still there... I must restore order to its system."

# game/rutas/nulla.rpy:4450
translate ingles continuacion_nulla_act3_622d3deb:

    # "Desvía la mirada, irritada."
    "She looks away, irritated."

# game/rutas/nulla.rpy:4451
translate ingles continuacion_nulla_act3_68a8c0df:

    # nulla "Eso es nuevo."
    nulla "That's new."

# game/rutas/nulla.rpy:4452
translate ingles continuacion_nulla_act3_9a1500e6:

    # madre "A diferencia tuya, soy libre--- y no pienso morir aquí."
    madre "Unlike you, I'm free now--and I have no intention of dying here."

# game/rutas/nulla.rpy:4453
translate ingles continuacion_nulla_act3_d5bbc295_2:

    # madre "..."
    madre "..."

# game/rutas/nulla.rpy:4454
translate ingles continuacion_nulla_act3_6e847056:

    # "Ella parpadea un par de veces antes de clavar su mirada en ti."
    "She blinks a couple of times before fixing her gaze on you."

# game/rutas/nulla.rpy:4455
translate ingles continuacion_nulla_act3_0fd868fe:

    # madre "Te voy a cobrar el arreglo a tu marioneta."
    madre "I'm going to charge you for repairing your puppet."

# game/rutas/nulla.rpy:4456
translate ingles continuacion_nulla_act3_91af0e4b:

    # nulla "¿Qué quieres?"
    nulla "What do you want?"

# game/rutas/nulla.rpy:4457
translate ingles continuacion_nulla_act3_6b4d6b95:

    # madre "Una capa interior tuya."
    madre "One of your inner layers."

# game/rutas/nulla.rpy:4458
translate ingles continuacion_nulla_act3_82b7342e:

    # madre "No quiero que te lleves todo lo que fue él con tu muerte. Lo quiero de vuelta junto a mí."
    madre "I don't want you to take everything he once was with you when you die. I want him back by my side."

# game/rutas/nulla.rpy:4459
translate ingles continuacion_nulla_act3_409f8636_2:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:4460
translate ingles continuacion_nulla_act3_d4e2dc73:

    # nulla "No me voy a arriesgar a---"
    nulla "I'm not going to risk--"

# game/rutas/nulla.rpy:4461
translate ingles continuacion_nulla_act3_0628ee52:

    # "Madre chasquea la lengua."
    "Mother clicks her tongue."

# game/rutas/nulla.rpy:4462
translate ingles continuacion_nulla_act3_4841d032:

    # madre "No es una de las importantes... es una previa a mi intervención."
    madre "It's not one of the important ones... it's from before my intervention."

# game/rutas/nulla.rpy:4463
translate ingles continuacion_nulla_act3_32d92a4d:

    # "Mira sus manos, hay algo de culpa en su mirada."
    "She looks down at her hands, a hint of guilt in her eyes."

# game/rutas/nulla.rpy:4464
translate ingles continuacion_nulla_act3_83ade292:

    # madre "Cuando él no era más que una idea, un crío."
    madre "From when he was nothing more than an idea, a child."

# game/rutas/nulla.rpy:4465
translate ingles continuacion_nulla_act3_46e42e6e:

    # madre "No cometeré el mismo error."
    madre "I won't make the same mistake."

# game/rutas/nulla.rpy:4466
translate ingles continuacion_nulla_act3_55858748:

    # nulla "Grimal..."
    nulla "Grimal..."

# game/rutas/nulla.rpy:4467
translate ingles continuacion_nulla_act3_66154304:

    # madre "De nada te sirven esas, las vas a borrar de todos modos."
    madre "Those are of no use to you. You're going to erase them anyway."

# game/rutas/nulla.rpy:4468
translate ingles continuacion_nulla_act3_9c432375:

    # "Se hace un silencio largo, del cual le permite a Nulla meditar su próxima respuesta. Viendo que Nulla solo le regresa la mirada, ella insiste."
    "A long silence follows, giving Nulla time to consider his next response. Seeing that he merely stares back at her, she insists."

# game/rutas/nulla.rpy:4469
translate ingles continuacion_nulla_act3_49bf89f8:

    # madre "Con la potestad que tengo ante tus primeras capas, romperé la conexión con la raiz. Ese nombre dejará de ser parte de ti."
    madre "With the authority I hold over your earliest layers, I'll sever the connection to the root. That name will no longer be a part of you."

# game/rutas/nulla.rpy:4470
translate ingles continuacion_nulla_act3_2108c4b8:

    # madre "Ya eres un individuo aparte, solo falta que sea anunciado."
    madre "You're already an individual in your own right. All that's left is to make it official."

# game/rutas/nulla.rpy:4471
translate ingles continuacion_nulla_act3_cd4b4c01:

    # nulla "...Eres insufrible."
    nulla "... You're insufferable."

# game/rutas/nulla.rpy:4472
translate ingles continuacion_nulla_act3_94eeb37b:

    # "Nulla se acerca a ella, ofreciendo su pecho."
    "Nulla approaches her, offering his chest."

# game/rutas/nulla.rpy:4473
translate ingles continuacion_nulla_act3_a76bd28e:

    # nulla "Sácala y vete."
    nulla "Take it out and leave."

# game/rutas/nulla.rpy:4474
translate ingles continuacion_nulla_act3_6f1358cd:

    # madre "Será un placer."
    madre "With pleasure."

# game/rutas/nulla.rpy:4475
translate ingles continuacion_nulla_act3_ec3b035a:

    # "Madre tiene que encorbar su figura para estar a la par de Nulla, sus labios se posan tiernamente en la oreja del pelinegro."
    "Mother has to bend down to reach Nulla's height, her lips resting tenderly against the dark-haired man's ear."

# game/rutas/nulla.rpy:4476
translate ingles continuacion_nulla_act3_5e71927d:

    # "Palabras que no tienen un significado son susurradas a su oído, y aún así, tú eres capaz de escuchar todo. Cada palabra rebota por el espacio que ahora ocupas, se instalan en tu cabeza sin que puedas descifrar lo que quieren decir."
    "Meaningless words are merely whispered, and yet you can hear every single one. Each echoes through the space you now occupy, settling inside your head without you being able to decipher what they mean."

# game/rutas/nulla.rpy:4484
translate ingles continuacion_nulla_act3_cc9a5909:

    # "!!!"
    "!!!"

# game/rutas/nulla.rpy:4485
translate ingles continuacion_nulla_act3_118c7c03:

    # "Madre clava sus garras en el pecho de Nulla. Su mano se abre paso entre un líquido viscoso que parece reaccionar con la intrusión. Expandiéndose alrededor de ella, abriendo capa tras capa, permitiendo la extracción."
    "Mother sinks her claws into Nulla's chest. Her hand pushes through a viscous liquid that seems to react to the intrusion, spreading around it and opening layer after layer, allowing her to extract what she's looking for."

# game/rutas/nulla.rpy:4486
translate ingles continuacion_nulla_act3_2d4cbfe5:

    # "Una sustancia pequeña y roja es extraída de Nulla, brillando de forma sutil en su mano."
    "A small, red substance is extracted from Nulla, glowing faintly in her hand."

# game/rutas/nulla.rpy:4487
translate ingles continuacion_nulla_act3_a20cefa7_3:

    # "..."
    "..."

# game/rutas/nulla.rpy:4490
translate ingles continuacion_nulla_act3_3866fb8d:

    # "Ella la mira con una mezcla de fascinación y amor, como quien miraría a un hijo. Le sonríe y acerca a su cara, para poder apreciarlo con más atención."
    "She gazes at it with a mixture of fascination and love, the way one might look at a child. She smiles at it and brings it closer to her face, wanting to admire it more closely."

# game/rutas/nulla.rpy:4492
translate ingles continuacion_nulla_act3_9928390d:

    # "Luego, gira su cara a Nulla. Y por primera vez, Madre le dedica una mirada que no sabes cómo describir más que gratitud."
    "Then, she turns to face Nulla. And for the first time, Mother gives him a look you can only describe as gratitude."

# game/rutas/nulla.rpy:4493
translate ingles continuacion_nulla_act3_200ce618:

    # madre "Gracias..."
    madre "Thank you..."

# game/rutas/nulla.rpy:4494
translate ingles continuacion_nulla_act3_f892d50a:

    # madre "Es momento de retirarme..."
    madre "It's time for me to leave..."

# game/rutas/nulla.rpy:4495
translate ingles continuacion_nulla_act3_287300c8:

    # madre "Estaré cerca, mirando. Pero no me involucraré más contigo."
    madre "I'll be nearby, watching. But I won't involve myself with you any further."

# game/rutas/nulla.rpy:4496
translate ingles continuacion_nulla_act3_b0257743:

    # madre "Siempre has sido un mal augurio."
    madre "You've always been a bad omen."

# game/rutas/nulla.rpy:4497
translate ingles continuacion_nulla_act3_30bdd33f:

    # "Madre se despide de ambos, bajando la cabeza un poco antes de desaparecer."
    "Mother bids you both farewell, lowering her head slightly before disappearing."

# game/rutas/nulla.rpy:4501
translate ingles continuacion_nulla_act3_39b0a8d9:

    # "Quedan solos. Nulla comienza a guardar las capas abiertas de su cuerpo, ocultando con su espalda el proceso, temiendo tu reacción."
    "You're left alone together. Nulla begins closing the exposed layers of his body, turning his back to hide the process from you, afraid of your reaction."

# game/rutas/nulla.rpy:4502
translate ingles continuacion_nulla_act3_280901ae:

    # "Termina y da media vuelta, volviendo junto a ti. Se agacha para ofrecerte la mano, te cuesta hacer que tus piernas respondan con normalidad y necesitas que Nulla te levante tirando un poco del agarre."
    "Once he's finished, he turns around and comes back to you. He crouches down to offer you his hand. You struggle to make your legs respond normally, and you need Nulla to help you up by gently pulling on your hand."

# game/rutas/nulla.rpy:4503
translate ingles continuacion_nulla_act3_57b496a0:

    # "Te sientes inútil."
    "You feel useless."

# game/rutas/nulla.rpy:4509
translate ingles continuacion_nulla_act3_13c522dd:

    # nulla "El fin de un trato viejo."
    nulla "The end of an old deal."

# game/rutas/nulla.rpy:4510
translate ingles continuacion_nulla_act3_18b07b23:

    # nulla "Al destruir a todos los Estandartes, hemos destruido el Jardín y toda ley impuesta en él."
    nulla "By destroying the Symbols, we've destroyed the Garden and every law imposed upon it."

# game/rutas/nulla.rpy:4511
translate ingles continuacion_nulla_act3_46d0fc72:

    # nulla "Sin el Jardín yo y Grimal ya nos estamos atrapados."
    nulla "Without the Garden, Grimal and I are no longer trapped."

# game/rutas/nulla.rpy:4512
translate ingles continuacion_nulla_act3_2e1081a0:

    # nulla "Ahora puedo borrar a Septem."
    nulla "Now I can erase Septem."

# game/rutas/nulla.rpy:4517
translate ingles continuacion_nulla_act3_47a8b463:

    # "Nulla comienza a reír, intenta ocultar su acción tapando su boca, pero le es difícil quedarse callado."
    "Nulla begins to laugh, trying to hide it by covering his mouth, but he finds it difficult to keep quiet."

# game/rutas/nulla.rpy:4518
translate ingles continuacion_nulla_act3_e4e95b96:

    # nulla "Primero su cuerpo y después su divinidad."
    nulla "First his body, then his divinity."

# game/rutas/nulla.rpy:4519
translate ingles continuacion_nulla_act3_418a3608:

    # nulla "Luego seré libre."
    nulla "Then I'll be free."

# game/rutas/nulla.rpy:4520
translate ingles continuacion_nulla_act3_0829be8c:

    # nulla "Ah~~~ queda tan poco~."
    nulla "Ah~~~ we're so close now~."

# game/rutas/nulla.rpy:4521
translate ingles continuacion_nulla_act3_b90f240e:

    # nulla "Ahhh---"
    nulla "Ahhh--"

# game/rutas/nulla.rpy:4522
translate ingles continuacion_nulla_act3_a63c5cec:

    # "Exhala complacido, calmando la risa gradualmente hasta volver a la normalidad."
    "He exhales contentedly, his laughter gradually subsiding until he returns to normal."

# game/rutas/nulla.rpy:4527
translate ingles continuacion_nulla_act3_a20cefa7_4:

    # "..."
    "..."

# game/rutas/nulla.rpy:4533
translate ingles continuacion_nulla_act3_a20cefa7_5:

    # "..."
    "..."

# game/rutas/nulla.rpy:4536
translate ingles continuacion_nulla_act3_90f53264:

    # "Su mirada cae a tu vientre, tú haces lo mismo. Si bien, no te duele nada, hay una sensación de carencia en la parte que debería ser tu estómago, similar al hambre."
    "His gaze falls to your abdomen, and you do the same. Although nothing hurts, there's a feeling of something missing where your stomach should be, similar to hunger."

# game/rutas/nulla.rpy:4537
translate ingles continuacion_nulla_act3_f0182ec8:

    # "Es como si un hueco reemplazara ese espacio."
    "It's as if a hollow space has taken its place."

# game/rutas/nulla.rpy:4539
translate ingles continuacion_nulla_act3_b9bc46db:

    # nulla "¿Cómo te encuentras?"
    nulla "How are you feeling?"

# game/rutas/nulla.rpy:4548
translate ingles continuacion_nulla_act3_a20cefa7_6:

    # "..."
    "..."

# game/rutas/nulla.rpy:4551
translate ingles continuacion_nulla_act3_ec8de0ba:

    # "Él solo suspira y pide perdón."
    "He simply sighs and apologizes."

# game/rutas/nulla.rpy:4552
translate ingles continuacion_nulla_act3_5ef9b666:

    # nulla "Subestimé a Tria."
    nulla "I underestimated Tria."

# game/rutas/nulla.rpy:4553
translate ingles continuacion_nulla_act3_7ee69974:

    # nulla "No me esperaba que se entregara así..."
    nulla "I didn't expect her to give herself up like that..."

# game/rutas/nulla.rpy:4554
translate ingles continuacion_nulla_act3_9f30ed91:

    # nulla "Ahora por su culpa te falta la mitad de tus órganos..."
    nulla "Now, because of her, you're missing half your organs..."

# game/rutas/nulla.rpy:4563
translate ingles continuacion_nulla_act3_6ad0b205:

    # nulla "Yo te estoy manteniendo con vida."
    nulla "I'm the one keeping you alive."

# game/rutas/nulla.rpy:4564
translate ingles continuacion_nulla_act3_b8a797b8:

    # nulla "Ahora soy tu sistema digestivo~"
    nulla "Now I'm your digestive system~"

# game/rutas/nulla.rpy:4565
translate ingles continuacion_nulla_act3_4f5abd30:

    # nulla "Cada día más unidos, ¿no crees?"
    nulla "We're getting closer every day, don't you think?"

# game/rutas/nulla.rpy:4572
translate ingles continuacion_nulla_act3_409f8636_3:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:4573
translate ingles continuacion_nulla_act3_d454652a:

    # nulla "Veo que no estamos para chistes."
    nulla "I see we're not in the mood for jokes."

# game/rutas/nulla.rpy:4574
translate ingles continuacion_nulla_act3_c7857491:

    # nulla "Disculpa."
    nulla "Sorry."

# game/rutas/nulla.rpy:4575
translate ingles continuacion_nulla_act3_c335162c:

    # nulla "No era mi intención asquearte."
    nulla "I didn't mean to gross you out."

# game/rutas/nulla.rpy:4582
translate ingles continuacion_nulla_act3_a5652916:

    # nulla "Lo sé, lo sé."
    nulla "I know, I know."

# game/rutas/nulla.rpy:4583
translate ingles continuacion_nulla_act3_5ef21eb2:

    # nulla "Soy un romántico."
    nulla "I'm a romantic."

# game/rutas/nulla.rpy:4589
translate ingles continuacion_nulla_act3_6b68da75:

    # nulla "?!"
    nulla "?!"

# game/rutas/nulla.rpy:4594
translate ingles continuacion_nulla_act3_556c7070:

    # "Nulla se sonroja, subiéndosele el rubor hasta las orejas de tan solo escuchar en tu respuesta, no esperando tu elección."
    "Nulla blushes, the redness spreading all the way to his ears just from hearing your answer, having never expected you to choose that."

# game/rutas/nulla.rpy:4595
translate ingles continuacion_nulla_act3_05941df8:

    # nulla "Wo, wo, wo. ¿No crees que vamos un poco rápido?"
    nulla "Wo, wo, wo. Don't you think we're moving a little too fast?"

# game/rutas/nulla.rpy:4596
translate ingles continuacion_nulla_act3_40e419bd:

    # nulla "¿No llevamos juntos ni una semana y ya quieres pasar a eso?"
    nulla "We haven't even been together for a week, and you already want to go that far?"

# game/rutas/nulla.rpy:4597
translate ingles continuacion_nulla_act3_0b8b3d17:

    # nulla "Eres un---"
    nulla "You're such a--"

# game/rutas/nulla.rpy:4598
translate ingles continuacion_nulla_act3_8b7a16c2:

    # nulla "Ja ja."
    nulla "Ja ja."

# game/rutas/nulla.rpy:4603
translate ingles continuacion_nulla_act3_a20cefa7_7:

    # "..."
    "..."

# game/rutas/nulla.rpy:4604
translate ingles continuacion_nulla_act3_a02a5520:

    # "Nulla suelta tu mano, optando por arreglar su corbata y colocarla en su lugar, deshaciendo el nudo a uno para convertirlo en uno perfecto."
    "Nulla lets go of your hand, choosing instead to straighten his tie and put it back in place, undoing the knot so he can tie it again perfectly."

# game/rutas/nulla.rpy:4605
translate ingles continuacion_nulla_act3_bb3fcb32:

    # nulla "Escucha, [nombrejugador]."
    nulla "Listen, [nombrejugador]."

# game/rutas/nulla.rpy:4606
translate ingles continuacion_nulla_act3_a3bffb0e:

    # nulla "A madre le tomó un día entero arreglar a tu marioneta..."
    nulla "It took Mother an entire day to repair your puppet..."

# game/rutas/nulla.rpy:4607
translate ingles continuacion_nulla_act3_bfeb991c:

    # nulla "Tenemos que partir ahora."
    nulla "We have to leave now."

# game/rutas/nulla.rpy:4608
translate ingles continuacion_nulla_act3_3c4939e0:

    # nulla "Te juro que cuando matemos a Septem, te daré el séptimo día para pasar el día juntos..."
    nulla "I swear that once we kill Septem, I'll give you the seventh day so we can spend it together..."

# game/rutas/nulla.rpy:4609
translate ingles continuacion_nulla_act3_1ca3a7b9:

    # nulla "Solo tú y yo."
    nulla "Just you and me."

# game/rutas/nulla.rpy:4614
translate ingles continuacion_nulla_act3_7eec7c7a:

    # "Asientes sin pensarlo mucho. Ya no te quedan fuerzas para oponerte a Nulla, o hacer más larga tu estadía en este lugar."
    "You nod without giving it much thought. You no longer have the strength to oppose Nulla or prolong your stay in this place."

# game/rutas/nulla.rpy:4615
translate ingles continuacion_nulla_act3_58f6b747:

    # "Estás cansado y quieres terminar con la caza de una buena vez por todas."
    "You're tired, and you want to put an end to this hunt once and for all."

# game/rutas/nulla.rpy:4616
translate ingles continuacion_nulla_act3_451982fe:

    # "Será que gracias a todo lo que has pasado, ya te encuentras desensibilizado frente a todo el horror que has cometido junto a Nulla..."
    "Perhaps everything you've been through has left you desensitized to all the horrors you've committed alongside Nulla..."

# game/rutas/nulla.rpy:4617
translate ingles continuacion_nulla_act3_fd9475ee:

    # "Una muerte más, qué más da."
    "One more death, what does it matter?"

# game/rutas/nulla.rpy:4618
translate ingles continuacion_nulla_act3_2fbedd7b:

    # "Ahora solo es una tarea más que te llevará a tu recompensa final..."
    "Now it's just another task standing between you and your final reward..."

# game/rutas/nulla.rpy:4619
translate ingles continuacion_nulla_act3_2f5909af:

    # "Tomas su mano y comienzan a caminar."
    "You take his hand, and the two of you begin walking."

# game/rutas/nulla.rpy:4624
translate ingles continuacion_nulla_act3_a20cefa7_8:

    # "..."
    "..."

# game/rutas/nulla.rpy:4625
translate ingles continuacion_nulla_act3_db09dd44:

    # "Caminas por el vacío sin rumbo alguno. Te preguntas cuándo aparecerá la casa de Nulla, pero mientras más caminan, tus esperanzas de verla una vez más van disminuyendo."
    "You wander aimlessly through the void. You wonder when Nulla's house will appear, but the farther you walk, the more your hopes of seeing it again begin to fade."

# game/rutas/nulla.rpy:4626
translate ingles continuacion_nulla_act3_df190486:

    # "Tus pasos se mimetizan con los de él, caminando a paso lento, en sincronía."
    "Your footsteps fall into rhythm with his, the two of you walking slowly, in perfect sync."

# game/rutas/nulla.rpy:4627
translate ingles continuacion_nulla_act3_9df7ba5a:

    # "Optas por mirar como ambos zapatos avanzan en el inexistente suelo. Mirar al frente y no ver nada más que negro... es perturbador. No escuchar nada más que tus pasos, o el sonido de tu propia respiración, se siente extraño."
    "You choose to watch your shoes move across the nonexistent ground. Looking ahead and seeing nothing but blackness... it's unsettling. Hearing nothing but your footsteps and the sound of your own breathing feels strange."

# game/rutas/nulla.rpy:4628
translate ingles continuacion_nulla_act3_5db4b162:

    # "No puedes evitar pensar en que estás siendo consumido por un abismo descontrolado, que probablemente no tiene inicio o final."
    "You can't help feeling as though you're being swallowed by an uncontrollable abyss, one that probably has neither beginning nor end."

# game/rutas/nulla.rpy:4631
translate ingles continuacion_nulla_act3_f937aa16:

    # nulla "Sí."
    nulla "Yes."

# game/rutas/nulla.rpy:4632
translate ingles continuacion_nulla_act3_77c1289c:

    # nulla "Lindo, ¿no?"
    nulla "Lovely, isn't it?"

# game/rutas/nulla.rpy:4634
translate ingles continuacion_nulla_act3_a20cefa7_9:

    # "..."
    "..."

# game/rutas/nulla.rpy:4637
translate ingles continuacion_nulla_act3_2e7b1b92:

    # nulla "Ya no existe."
    nulla "It no longer exists."

# game/rutas/nulla.rpy:4638
translate ingles continuacion_nulla_act3_99c08a64:

    # "Te responde sin pizca de remordimiento o siquiera pena en su voz, y aún así, aprieta los labios."
    "He answers without a trace of remorse or even sadness in his voice, and yet he presses his lips together."

# game/rutas/nulla.rpy:4639
translate ingles continuacion_nulla_act3_2b9165c4:

    # nulla "La he borrado."
    nulla "I erased it."

# game/rutas/nulla.rpy:4650
translate ingles continuacion_nulla_act3_b8c57614:

    # nulla "Ah---no."
    nulla "Ah--no."

# game/rutas/nulla.rpy:4651
translate ingles continuacion_nulla_act3_bfd7c89e:

    # "Es ahí cuando su careta de no importarle nada se rompe. Nulla te mira complicado, sus labios tiemblan en una mueca que no sabes si es de pena o gracia."
    "That's when his mask of indifference finally cracks. Nulla gives you a troubled look, his lips trembling in an expression you can't quite tell is sorrow or amusement."

# game/rutas/nulla.rpy:4652
translate ingles continuacion_nulla_act3_28633a62:

    # "Cuando no puede más, él ríe nervioso."
    "When he can no longer hold it in, he laughs nervously."

# game/rutas/nulla.rpy:4653
translate ingles continuacion_nulla_act3_78905f3c:

    # nulla "Es lo {b}único{b} que no me atrevería a borrar."
    nulla "That's the {b}only{b} thing I wouldn't dare erase."

# game/rutas/nulla.rpy:4654
translate ingles continuacion_nulla_act3_22a8e35f:

    # nulla "Mira---"
    nulla "Look--"

# game/rutas/nulla.rpy:4656
translate ingles continuacion_nulla_act3_3074f71d:

    # nulla "Se ve tan linda en tu galería..."
    nulla "It looks so lovely in your gallery..."

# game/rutas/nulla.rpy:4657
translate ingles continuacion_nulla_act3_97656dfd:

    # nulla "¿Realmente pensaste que borraría eso?"
    nulla "Did you really think I'd erase that?"

# game/rutas/nulla.rpy:4658
translate ingles continuacion_nulla_act3_0ef1956f:

    # "Te sonríe con ternura."
    "He smiles at you tenderly."

# game/rutas/nulla.rpy:4661
translate ingles continuacion_nulla_act3_fb973d55:

    # nulla "Todo."
    nulla "Everything."

# game/rutas/nulla.rpy:4662
translate ingles continuacion_nulla_act3_1a5ae4bc:

    # "Responde él sin sentimiento alguno, importándole poco las memorias que aquel lugar le ha brindado."
    "He answers without a trace of emotion, caring little for the memories that place has given him."

# game/rutas/nulla.rpy:4669
translate ingles continuacion_nulla_act3_a20cefa7_10:

    # "..."
    "..."

# game/rutas/nulla.rpy:4673
translate ingles continuacion_nulla_act3_a20cefa7_11:

    # "..."
    "..."

# game/rutas/nulla.rpy:4674
translate ingles continuacion_nulla_act3_be3ae9d8:

    # "Nulla no te devuelve la palabra, interesado más en caminar."
    "Nulla doesn't respond, more interested in keeping on walking."

# game/rutas/nulla.rpy:4676
translate ingles continuacion_nulla_act3_adc264c6:

    # "Siguen caminando, sin apuro."
    "You continue walking, in no particular hurry."

# game/rutas/nulla.rpy:4677
translate ingles continuacion_nulla_act3_4d64040b:

    # "Nulla sonríe, una sonrisa que parece estar pegada a su cara. Supones que tiene justificación para estar así, ha pasado 4 años esperando este momento."
    "Nulla smiles, a smile that seems permanently plastered across his face. You suppose he has every reason to look this way. He's spent four years waiting for this moment."

# game/rutas/nulla.rpy:4678
translate ingles continuacion_nulla_act3_4da34512:

    # "Por fin obtendrá lo que busca..."
    "He'll finally get what he's been after..."

# game/rutas/nulla.rpy:4679
translate ingles continuacion_nulla_act3_669ef138:

    # "Pero--- ¿luego qué?"
    "But--what happens after that?"

# game/rutas/nulla.rpy:4680
translate ingles continuacion_nulla_act3_dc6f85c7:

    # "¿Será que realmente conseguirá lo que ansía?"
    "Will he really get what he longs for?"

# game/rutas/nulla.rpy:4681
translate ingles continuacion_nulla_act3_f02f9b94:

    # "Después de todo... el concepto de muerte solo aplica para los seres vivos..."
    "After all... the concept of death only applies to living beings..."

# game/rutas/nulla.rpy:4682
translate ingles continuacion_nulla_act3_c8b101b1:

    # "¿Es posible que Nulla deje de existir?"
    "Is it possible for Nulla to cease to exist?"

# game/rutas/nulla.rpy:4683
translate ingles continuacion_nulla_act3_019746f4:

    # "¿Qué pasaría si...?"
    "What if...?"

# game/rutas/nulla.rpy:4684
translate ingles continuacion_nulla_act3_81cd7b7e:

    # "¿Qué pasará contigo?"
    "What will happen to you?"

# game/rutas/nulla.rpy:4693
translate ingles continuacion_nulla_act3_63fe335e:

    # nulla "Mira al frente."
    nulla "Look ahead."

# game/rutas/nulla.rpy:4697
translate ingles continuacion_nulla_act3_e3383a62:

    # "Sus palabras rompen el silencio, llevando tu atención al camino por el que van avanzando."
    "His words break the silence, drawing your attention to the path ahead."

# game/rutas/nulla.rpy:4698
translate ingles continuacion_nulla_act3_f9400a2d:

    # nulla "¿Ves ese punto blanco de allá?"
    nulla "See that white dot over there?"

# game/rutas/nulla.rpy:4699
translate ingles continuacion_nulla_act3_6de6eb1f:

    # "Lo ves, es diminuto, una pequeña luz que titila formando un horizonte."
    "You see it. It's tiny, a little flickering light forming a horizon."

# game/rutas/nulla.rpy:4700
translate ingles continuacion_nulla_act3_4d1db86c:

    # nulla "Ahí está Septem."
    nulla "That's where Septem is."

# game/rutas/nulla.rpy:4701
translate ingles continuacion_nulla_act3_1d549609:

    # nulla "Ven, acerquémonos."
    nulla "Come on, let's get closer."

# game/rutas/nulla.rpy:4706
translate ingles continuacion_nulla_act3_9b3929ba:

    # "Nulla resopla riendo."
    "Nulla lets out a snorting laugh."

# game/rutas/nulla.rpy:4707
translate ingles continuacion_nulla_act3_e4134c0f:

    # nulla "Septem ya no puede hacer nada."
    nulla "Septem can't do anything anymore."

# game/rutas/nulla.rpy:4708
translate ingles continuacion_nulla_act3_d594b254:

    # nulla "Tiene un cuerpo mortal y nadie que lo proteja."
    nulla "He has a mortal body and no one to protect him."

# game/rutas/nulla.rpy:4717
translate ingles continuacion_nulla_act3_0d864ad3:

    # "Su expresión se torna oscura, ojos que te escanean, buscando alguna reacción detrás de la pantalla."
    "His expression darkens, his eyes scanning you, searching for any reaction behind the screen."

# game/rutas/nulla.rpy:4722
translate ingles continuacion_nulla_act3_f216c09e:

    # "Cuando crees que ya la encontró, él sonríe con malicia."
    "Just when you think he's found one, he smiles maliciously."

# game/rutas/nulla.rpy:4723
translate ingles continuacion_nulla_act3_558cd395:

    # nulla "Lindura, ya no tienes opción."
    nulla "Lindura, you don't have a choice anymore."

# game/rutas/nulla.rpy:4728
translate ingles continuacion_nulla_act3_e50e10f4:

    # nulla "No nos demoraremos tanto. Te lo prometo."
    nulla "It won't take us that long. I promise."

# game/rutas/nulla.rpy:4729
translate ingles continuacion_nulla_act3_248e5fe6:

    # nulla "Cuando termine, podemos hacer algo divertido~."
    nulla "When I'm done, we can do something fun~"

# game/rutas/nulla.rpy:4730
translate ingles continuacion_nulla_act3_b84bd42b:

    # "Te habla con un tono condescendiente, forzando sus labios en una imitación a una sonrisa. Muy tensa, muy falsa, haciéndose notable lo irritado que está gracias a sus ojos."
    "He speaks to you in a condescending tone, forcing his lips into an imitation of a smile; too tense, too fake, his irritation clearly visible in his eyes."

# game/rutas/nulla.rpy:4734
translate ingles continuacion_nulla_act3_a1449042:

    # nulla "Vamos."
    nulla "Let's go."

# game/rutas/nulla.rpy:4736
translate ingles continuacion_nulla_act3_5b737b12:

    # "En tus pies se siente movimiento, algo trepa por tu tobillo, deslizándose con suavidad hacia tu cadera y torso. Se enrosca en tu cuerpo como una serpiente, subiendo hasta tu cuello sin llegar a cortar el aire."
    "You feel movement around your feet. Something climbs up your ankle, sliding smoothly toward your hips and torso. It coils around your body like a snake, rising to your neck without cutting off your air."

# game/rutas/nulla.rpy:4737
translate ingles continuacion_nulla_act3_14c8dc85:

    # "Estás siendo consumido por las sombras de Nulla. Esa sensación fría, líquida y viscoso acaricia tu piel, permitiendo una entrada más rápida al lugar a donde Nulla quiere llegar."
    "You're being consumed by Nulla's shadows. That cold, liquid, viscous sensation caresses your skin, allowing you to enter the place Nulla wants to reach more quickly."

# game/rutas/nulla.rpy:4738
translate ingles continuacion_nulla_act3_55bd50df:

    # "La oscuridad cubre tu rostro y comienzas a caer."
    "Darkness covers your face, and you begin to fall."

# game/rutas/nulla.rpy:4739
translate ingles continuacion_nulla_act3_4cf4a0ae:

    # "No sabes con seguridad donde está Nulla, pero si lo sientes a tu lado. Dentro de tu estómago, en tu piel, boca y manos."
    "You don't know exactly where Nulla is, but you can feel him beside you. Inside your stomach, against your skin, in your mouth and hands."

# game/rutas/nulla.rpy:4740
translate ingles continuacion_nulla_act3_35109d56:

    # "Te ahogas en su presencia."
    "You're drowning in his presence."

# game/rutas/nulla.rpy:4741
translate ingles continuacion_nulla_act3_a20cefa7_12:

    # "..."
    "..."

# game/rutas/nulla.rpy:4745
translate ingles continuacion_nulla_act3_e5490a40:

    # "Tus pies tocan piso. Procurando no caer das un par de pasos para estabilizar tu cuerpo, Nulla también ayuda, ofreciendo su mano como soporte."
    "Your feet touch the ground. Trying not to fall, you take a couple of steps to steady yourself. Nulla helps too, offering his hand for support."

# game/rutas/nulla.rpy:4746
translate ingles continuacion_nulla_act3_6d0dcb0c:

    # "Das dos pasos hacia atrás y te topas con algo duro. Palpas descubriendo una superficie que te recuerda a la madera de algún escritorio o mesa."
    "You take two steps backward and bump into something hard. You feel around, discovering a surface that reminds you of the wood of a desk or table."

# game/rutas/nulla.rpy:4747
translate ingles continuacion_nulla_act3_461cb049:

    # "Escaneas tu alrededor, hay oscuridad total... es imposible discernir con la vista que es lo que te rodea."
    "You scan your surroundings. There's complete darkness... it's impossible to make out anything around you."

# game/rutas/nulla.rpy:4748
translate ingles continuacion_nulla_act3_52130979:

    # "Nulla cubre tu mano con la suya, el calor de que irradia te calma un poco los nervios."
    "Nulla covers your hand with his, the warmth radiating from it calming your nerves a little."

# game/rutas/nulla.rpy:4750
translate ingles continuacion_nulla_act3_aab2d07c:

    # nulla "Ja ja, esto sigue intacto."
    nulla "Ja ja, this is still intact."

# game/rutas/nulla.rpy:4751
translate ingles continuacion_nulla_act3_340ce8dd:

    # nulla "Salgamos de aquí."
    nulla "Let's get out of here."

# game/rutas/nulla.rpy:4752
translate ingles continuacion_nulla_act3_3d6b8b4e:

    # "Eres conducido por el lugar a ciegas, tú solo te preocupas de seguir la mano de Nulla, confiando plenamente en que no chocarás o caerás en ningún momento."
    "You're led blindly through the place, focusing only on following Nulla's hand, trusting completely that you won't bump into anything or fall."

# game/rutas/nulla.rpy:4753
translate ingles continuacion_nulla_act3_f91355c2:

    # "Escuchas cómo el pestillo de una puerta se acciona, acompañado por una manilla siendo girada."
    "You hear a door latch click, followed by the sound of a handle turning."

# game/rutas/nulla.rpy:4755
translate ingles continuacion_nulla_act3_c5def828:

    # "De repente, tu visión es invadida por un destello blanco. Es molesto, y tienes que parpadear un par de veces para acostumbrarte al repentino cambio."
    "Suddenly, a flash of white floods your vision. It's unpleasant, and you have to blink a few times to adjust to the sudden change."

# game/rutas/nulla.rpy:4761
translate ingles continuacion_nulla_act3_953613c9:

    # "Al recobrar la vista, un templo te da la bienvenida. El lugar es incomodo de ver, se siente exageradamente grande..."
    "When your vision returns, you're greeted by a temple. The place is unsettling to look at. It feels excessively large..."

# game/rutas/nulla.rpy:4762
translate ingles continuacion_nulla_act3_b46e4a68:

    # "Blanco tiñe las paredes, comiéndose de a poco el espacio. Resquebrajando los cuadros y estatuas, consumiendo todo a su paso de manera lenta."
    "White stains the walls, slowly devouring the space. Cracking paintings and statues, gradually consuming everything in its path."

# game/rutas/nulla.rpy:4763
translate ingles continuacion_nulla_act3_09193750:

    # "Moribundo."
    "Dying."

# game/rutas/nulla.rpy:4764
translate ingles continuacion_nulla_act3_b27f7fd1:

    # "Duele ver el estado del lugar."
    "It hurts to see the place in this condition."

# game/rutas/nulla.rpy:4765
translate ingles continuacion_nulla_act3_d02609d5:

    # "Dentro de la sala hay un montón de puertas, tantas que te mareas con tan solo pensar que tan grande será el lugar completo."
    "There are countless doors inside the room, so many that just thinking about how enormous the entire place must be makes you dizzy."

# game/rutas/nulla.rpy:4769
translate ingles continuacion_nulla_act3_53352823:

    # nulla "Es algo chistoso."
    nulla "It's kind of funny."

# game/rutas/nulla.rpy:4770
translate ingles continuacion_nulla_act3_95eea714:

    # "Nulla levanta la voz, buscando llegar a oídos que no son los tuyos. El sonido rebota provocando eco, chocando con el desolado espacio que queda del Jardín."
    "Nulla raises his voice, hoping to reach ears other than yours. His words echo through the desolate space that remains of the Garden."

# game/rutas/nulla.rpy:4774
translate ingles continuacion_nulla_act3_b1db83bf:

    # nulla "En el sexto día hiciste nacer la humanidad. Y fue un sábado el día en que te di ese cuerpo."
    nulla "On the sixth day, you brought humanity into existence. And it was on a Saturday that I gave you that body."

# game/rutas/nulla.rpy:4775
translate ingles continuacion_nulla_act3_f2557fe2:

    # nulla "Sólo me bastaron seis días para quitártelo. Es irónico---"
    nulla "It only took me six days to take it away from you. How ironic--"

# game/rutas/nulla.rpy:4776
translate ingles continuacion_nulla_act3_7fc84d0d:

    # "Él camina por el lugar desbordando confianza, ensimismado en la cercana victoria que ya se ha atribuido."
    "He walks through the place, brimming with confidence, absorbed in the approaching victory he's already claimed as his own."

# game/rutas/nulla.rpy:4782
translate ingles continuacion_nulla_act3_a7fc02ea:

    # "Se dirige a una de las tantas puertas, tú le sigues de cerca, con temor a quedarte atrás y ser tocado por lo que deteriora las paredes. Cuando la abre, te percatas como esta también comienza a deteriorarse en la zona que él ha tocado."
    "He heads toward one of the many doors, and you follow closely, afraid of falling behind and being touched by whatever is destroying the walls. When he opens it, you notice that the area he touched also begins to deteriorate."

# game/rutas/nulla.rpy:4783
translate ingles continuacion_nulla_act3_a1742dab:

    # "Avanzan por el pasillo que pareciera no tener fin..."
    "You make your way down a hallway that seems to have no end..."

# game/rutas/nulla.rpy:4787
translate ingles continuacion_nulla_act3_ab608786:

    # "Aun así, le sigues el paso sin mirar atrás."
    "Even so, you keep pace with him without looking back."

# game/rutas/nulla.rpy:4788
translate ingles continuacion_nulla_act3_a20cefa7_13:

    # "..."
    "..."

# game/rutas/nulla.rpy:4790
translate ingles continuacion_nulla_act3_4a3be9cc:

    # "Llevan un tiempo así, no más de tres minutos, pero tú ya comienzas a desesperar."
    "You've been walking like this for a while--no more than three minutes--but you're already starting to grow desperate."

# game/rutas/nulla.rpy:4799
translate ingles menu_pasillo_borrado_1016cfdd:

    # "Mantienes el paso."
    "You keep walking."

# game/rutas/nulla.rpy:4800
translate ingles menu_pasillo_borrado_98de3dd1:

    # "No pareces avanzar."
    "You don't seem to be making any progress."

# game/rutas/nulla.rpy:4801
translate ingles menu_pasillo_borrado_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:4809
translate ingles menu_pasillo_borrado_a20cefa7_1:

    # "..."
    "..."

# game/rutas/nulla.rpy:4810
translate ingles menu_pasillo_borrado_4cea44ae:

    # "Nulla está borrando el lugar."
    "Nulla is erasing the place."

# game/rutas/nulla.rpy:4818
translate ingles menu_pasillo_borrado2_e35173de:

    # "Esto no te gusta.........."
    "You don't like this.........."

# game/rutas/nulla.rpy:4826
translate ingles menu_pasillo_borrado2_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:4827
translate ingles menu_pasillo_borrado2_5b82e1a8:

    # "Lo blanco avanza con ustedes. Acercándose cada vez más."
    "The whiteness advances alongside you. Creeping closer and closer."

# game/rutas/nulla.rpy:4843
translate ingles menu_pasillo_borrado3_8cab8481:

    # "Aquello engulle cada paso que dejas, esperando a comerte si te distraes y quedas atrás. Casi dejas de caminar por estar mirando como lo blanco avanza, tentando tu suerte, pero Nulla no te lo permite."
    "It swallows every step you leave behind, waiting to devour you if you get distracted and fall back. You almost stop walking as you watch the whiteness advance, tempting fate, but Nulla won't allow it."

# game/rutas/nulla.rpy:4848
translate ingles menu_pasillo_borrado3_f8ad0bd5:

    # "Toma tu mano, acercando tu cuerpo al suyo."
    "He takes your hand, pulling your body closer to his."

# game/rutas/nulla.rpy:4853
translate ingles menu_pasillo_borrado3_839462ff:

    # nulla "No te quedes atrás, mi vida."
    nulla "Don't fall behind, mi vida."

# game/rutas/nulla.rpy:4854
translate ingles menu_pasillo_borrado3_e624fff5:

    # nulla "Si no tienes cuidado, podría borrarte <3."
    nulla "If you're not careful, I might erase you. <3"

# game/rutas/nulla.rpy:4855
translate ingles menu_pasillo_borrado3_595bbac8:

    # nulla "Y eso me pondría muy triste :(."
    nulla "And that would make me very sad. :("

# game/rutas/nulla.rpy:4862
translate ingles continuacion_nulla_act3_final_6e4d42ba:

    # "Por fin llegan al final."
    "You finally reach the end."

# game/rutas/nulla.rpy:4867
translate ingles continuacion_nulla_act3_final_09a53ea0:

    # "Nulla esboza una floja sonrisa, tomándose la situación con humor."
    "Nulla gives a faint smile, taking the situation with a sense of humor."

# game/rutas/nulla.rpy:4868
translate ingles continuacion_nulla_act3_final_c2267beb:

    # nulla "Eso fue intenso ja, ja, ja."
    nulla "That was intense, ja, ja, ja."

# game/rutas/nulla.rpy:4875
translate ingles continuacion_nulla_act3_final_378d293d:

    # "Pasan el umbral de la gran puerta que les bloquea el paso. Del otro lado hay un comedor."
    "You cross the threshold of the large door blocking your path. On the other side is a dining room."

# game/rutas/nulla.rpy:4876
translate ingles continuacion_nulla_act3_final_9e59caea:

    # nulla "Aquí estás."
    nulla "There you are."

# game/rutas/nulla.rpy:4877
translate ingles continuacion_nulla_act3_final_ac3d35f8:

    # nulla "Buenos días."
    nulla "Good morning."

# game/rutas/nulla.rpy:4878
translate ingles continuacion_nulla_act3_final_a4a61633:

    # septem "Púdrete."
    septem "Rot in hell."

# game/rutas/nulla.rpy:4880
translate ingles continuacion_nulla_act3_final_8717eec9:

    # "Escupe con veneno el rubio. Yace sentado en una mesa larga, apta para un banquete, especial para recibir visitas."
    "The blond spits out the words like venom. He sits at a long table, fit for a banquet and designed to receive guests."

# game/rutas/nulla.rpy:4881
translate ingles continuacion_nulla_act3_final_2e5c7b59:

    # "Está sentado en la cabecera, la que da al ventanal."
    "He's seated at the head of the table, facing the large window."

# game/rutas/nulla.rpy:4882
translate ingles continuacion_nulla_act3_final_bd81de88:

    # "En la superficie de la mesa hay un plato vacío junto a un montón de utensilios elegantes, una copa solitaria los acompaña, sin contenido dentro de ella."
    "On the table's surface sits an empty plate alongside an assortment of elegant utensils. A solitary glass accompanies them with nothing inside it."

# game/rutas/nulla.rpy:4883
translate ingles continuacion_nulla_act3_final_41eb0e83:

    # "En el centro, una vela, que brilla con una luz inusual. Su llama rojiza se alza por sobre la mecha, flameando con el aire."
    "At the center stands a candle, glowing with an unusual light. Its reddish flame rises above the wick, flickering in the air."

# game/rutas/nulla.rpy:4889
translate ingles continuacion_nulla_act3_final_efa47dae:

    # "Septem mira a Nulla con odio puro en sus ojos."
    "Septem glares at Nulla with pure hatred in his eyes."

# game/rutas/nulla.rpy:4893
translate ingles continuacion_nulla_act3_final_cad1a3a0:

    # nulla "No me mires así, ya sabías que esto iba a pasar."
    nulla "Don't look at me like that. You already knew this was going to happen."

# game/rutas/nulla.rpy:4898
translate ingles continuacion_nulla_act3_final_faf7fbe8:

    # nulla "Te he ganado. Ya no queda nada. No hagas esto más largo."
    nulla "I've beaten you. There's nothing left. Don't drag this out any longer."

# game/rutas/nulla.rpy:4899
translate ingles continuacion_nulla_act3_final_31924e0f:

    # septem "..."
    septem "..."

# game/rutas/nulla.rpy:4900
translate ingles continuacion_nulla_act3_final_f4f64415:

    # septem "¿Terminaste?"
    septem "Are you finished?"

# game/rutas/nulla.rpy:4907
translate ingles continuacion_nulla_act3_final_c5766059:

    # "Septem se levanta de la silla, más no se acerca a ustedes."
    "Septem rises from his chair, but doesn't approach either of you."

# game/rutas/nulla.rpy:4908
translate ingles continuacion_nulla_act3_final_8b602b4b:

    # septem "Siempre hablas tanto. Me enfermas."
    septem "You always talk so much. You make me sick."

# game/rutas/nulla.rpy:4909
translate ingles continuacion_nulla_act3_final_18d38041:

    # "Hay una pausa, en donde ambos hombres se observan sin realizar movimientos. Hasta que Septem decide acercarse, marcando el paso con sus suelas, emitiendo un sonido constante."
    "There's a pause, during which both men stare at each other without moving. Until Septem decides to approach, his soles striking the floor with each step, producing a steady sound."

# game/rutas/nulla.rpy:4910
translate ingles continuacion_nulla_act3_final_77a308ef:

    # "Se detiene al frente de Nulla, respetando su espacio, sin miedo a lo que le pueda pasar."
    "He stops in front of Nulla, respecting his space but unafraid of what might happen to him."

# game/rutas/nulla.rpy:4917
translate ingles continuacion_nulla_act3_final_1d3f20e5:

    # septem "No sé cómo planeas acabar conmigo..."
    septem "I don't know how you plan to finish me off, but..."

# game/rutas/nulla.rpy:4918
translate ingles continuacion_nulla_act3_final_d8cd5441:

    # septem "Esto es estúpido. La única regla que no depende del Jardín es esta."
    septem "This is stupid. This is the only rule that doesn't depend on the Garden."

# game/rutas/nulla.rpy:4919
translate ingles continuacion_nulla_act3_final_567a73c1:

    # septem "No me puedes dañar, ni borrar."
    septem "You can't hurt me or erase me."

# game/rutas/nulla.rpy:4920
translate ingles continuacion_nulla_act3_final_1e7ef19b:

    # septem "Termina con esta rabieta. Dame al Dios que tienes dentro de la marioneta."
    septem "Put an end to this tantrum. Give me the God you have inside the puppet."

# game/rutas/nulla.rpy:4923
translate ingles continuacion_nulla_act3_final_b7b1263a:

    # nulla "Con gusto."
    nulla "Gladly."

# game/rutas/nulla.rpy:4924
translate ingles continuacion_nulla_act3_final_267259b2:

    # "¡¿...!?"
    "...!?"

# game/rutas/nulla.rpy:4925
translate ingles continuacion_nulla_act3_final_eac00f25:

    # "Buscas a Nulla con la mirada, confundido, sin saber que hacer."
    "You look toward Nulla, confused, not knowing what to do."

# game/rutas/nulla.rpy:4929
translate ingles continuacion_nulla_act3_final_f4f41c25:

    # "Él se aparta del camino, dando un paso al lado, invitándote a avanzar hacia Septem."
    "He steps aside, clearing the way and inviting you to approach Septem."

# game/rutas/nulla.rpy:4930
translate ingles continuacion_nulla_act3_final_d7cfb1bd:

    # "{glitch=30.0}{color=ffffff}{b}Confía en mí, cariño.{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}Trust me, cariño.{b}{/color}"

# game/rutas/nulla.rpy:4934
translate ingles continuacion_nulla_act3_final_2a8cf8f9:

    # "{glitch=30.0}{color=ffffff}{b}Hazlo.{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}Do it.{b}{/color}"

# game/rutas/nulla.rpy:4978
translate ingles continuacion_nulla_act3_final_68b68ba6:

    # "Avanzas sin opción, no siendo dueño de tus movimientos una vez más. Te acercas a Septem a paso lento, él te ofrece la mano, esperando a que la tomes..."
    "You move forward with no choice, once again having no control over your movements. You approach Septem slowly. He offers you his hand, waiting for you to take it..."

# game/rutas/nulla.rpy:4979
translate ingles continuacion_nulla_act3_final_fc8a17f3:

    # "Tú la alzas, buscando agarrar su mano."
    "You raise yours, reaching to take his hand."

# game/rutas/nulla.rpy:4982
translate ingles continuacion_nulla_act3_final_705d73d4:

    # "Sus movimientos son rápidos, por lo que no eres capaz de comprender exactamente que pasó."
    "His movements are so fast that you can't quite understand what happened."

# game/rutas/nulla.rpy:4983
translate ingles continuacion_nulla_act3_final_721fc9d3:

    # "Eres lanzado lejos, cayendo directo al suelo, golpeando tu cabeza y espalda. El dolor en tu muñeca es insoportable, Septem te ha tomado por ahí."
    "You're thrown away, crashing straight onto the floor, hitting your head and back, and the pain in your wrist where Septem grabbed you is unbearable."

# game/rutas/nulla.rpy:4984
translate ingles continuacion_nulla_act3_final_e1c824f2:

    # "Tu visión se torna borrosa, bloqueando tus sentidos por completo junto a un pitido en tu oído."
    "Your vision blurs, your senses becoming completely overwhelmed by a ringing in your ears."

# game/rutas/nulla.rpy:4985
translate ingles continuacion_nulla_act3_final_4a14678d:

    # "Nulla te grita algo."
    "Nulla shouts something at you."

# game/rutas/nulla.rpy:4987
translate ingles continuacion_nulla_act3_final_567cbee4:

    # "Septem está encima de él, golpeando su cara y abriendo su pecho, en busca de su corazón. Nulla no puede hacer nada más que retorcerse."
    "Septem is on top of him, punching his face and tearing open his chest in search of his heart. Nulla can do nothing but writhe."

# game/rutas/nulla.rpy:4988
translate ingles continuacion_nulla_act3_final_a0ccf6ff:

    # "Intenta invocar sus sombras, las cuales alcanzan a formarse, pero se detienen justo antes de poder tocar a Septem."
    "He tries to summon his shadows, which manage to take shape but stop just before they can touch Septem."

# game/rutas/nulla.rpy:4989
translate ingles continuacion_nulla_act3_final_bdbb6994:

    # "Algunas se logran acceder a su cuerpo, pero solo sirven para retenerlo por unos segundos. Septem se encarga de romperlas y quemarlas."
    "Some manage to reach his body, but they only hold him back for a few seconds. Septem tears them apart and burns them."

# game/rutas/nulla.rpy:4990
translate ingles continuacion_nulla_act3_final_db80ba22:

    # "Una de las sombras de Nulla te ayuda a levantarte."
    "One of Nulla's shadows helps gather you to your feet."

# game/rutas/nulla.rpy:4991
translate ingles continuacion_nulla_act3_final_3651a4c6:

    # "Observas lo que pasa desde lo lejos, Nulla intenta defenderse reteniendo las manos del rubio, pero este no se deja."
    "You watch from a distance as Nulla tries to defend himself by restraining the blond man's hands, but Septem refuses to let him."

# game/rutas/nulla.rpy:4992
translate ingles continuacion_nulla_act3_final_b23307f0:

    # "Le grita, pidiendo que pare, logrando solo que Nulla ría."
    "He shouts at him, demanding that he stop, only managing to make Nulla laugh."

# game/rutas/nulla.rpy:4993
translate ingles continuacion_nulla_act3_final_12c2e6ca:

    # "{glitch=30.0}{color=ffffff}{b}Yo lo distraígo, cariño.{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}I'll distract him, cariño.{b}{/color}"

# game/rutas/nulla.rpy:4994
translate ingles continuacion_nulla_act3_final_2907f213:

    # "{glitch=30.0}{color=ffffff}{b}Tú toma unos de los cuchillos.{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}You grab one of the knives.{b}{/color}"

# game/rutas/nulla.rpy:4995
translate ingles continuacion_nulla_act3_final_e17a93b2:

    # "{glitch=30.0}{color=ffffff}{b}Debes atacarlo.{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}You have to attack him.{b}{/color}"

# game/rutas/nulla.rpy:5002
translate ingles continuacion_nulla_act3_final_bddf8caf:

    # "{glitch=30.0}{color=ffffff}{b}Oh, no, no, no, cariño.{/glitch}{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}Oh, no, no, no, cariño.{/glitch}{b}{/color}"

# game/rutas/nulla.rpy:5003
translate ingles continuacion_nulla_act3_final_bf42954e:

    # "{glitch=30.0}{color=ffffff}{b}No seas tonto.{/glitch}{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}Don't be silly.{/glitch}{b}{/color}"

# game/rutas/nulla.rpy:5004
translate ingles continuacion_nulla_act3_final_1c1ef5a4:

    # "{glitch=30.0}{color=ffffff}{b}No voy a permitir que hagas eso.{/glitch}{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}I'm not going to let you do that.{/glitch}{b}{/color}"

# game/rutas/nulla.rpy:5023
translate ingles continuacion_nulla_act3_final2_f5b62db8:

    # "En tus manos tienes el corazón de la entidad de máxima autoridad de lo que fue una vez el Jardín."
    "In your hands, you hold the heart of the entity who held the highest authority over what was once the Garden."

# game/rutas/nulla.rpy:5024
translate ingles continuacion_nulla_act3_final2_19e64225:

    # "Sigue latiendo, las venas doradas siguen ejerciendo fuerza sobre el pedazo de carne que tienes entre los dedos. Intentan bombear sangre aún."
    "It's still beating. The golden veins continue to exert pressure on the piece of flesh between your fingers. They're still trying to pump blood."

# game/rutas/nulla.rpy:5025
translate ingles continuacion_nulla_act3_final2_b3ae8aad:

    # "Parece un acto desesperado."
    "It seems like an act of desperation."

# game/rutas/nulla.rpy:5026
translate ingles continuacion_nulla_act3_final2_98417ca9:

    # "No se dan por vencidas..."
    "They refuse to give up..."

# game/rutas/nulla.rpy:5031
translate ingles continuacion_nulla_act3_final2_bd275596:

    # nulla "La tienes en tus manos."
    nulla "You have it in your hands."

# game/rutas/nulla.rpy:5039
translate ingles continuacion_nulla_act3_final2_4628fccb:

    # "Nulla aprieta los labios."
    "Nulla presses his lips together."

# game/rutas/nulla.rpy:5040
translate ingles continuacion_nulla_act3_final2_10198811:

    # nulla "Su esencia se fusionó con ese corazón."
    nulla "His essence fused with that heart."

# game/rutas/nulla.rpy:5042
translate ingles continuacion_nulla_act3_final2_719f12e1:

    # nulla "Deberías comerlo antes de que intente fusionarse contigo, mi vida."
    nulla "You should eat it before it tries to fuse with you, mi vida."

# game/rutas/nulla.rpy:5048
translate ingles continuacion_nulla_act3_final2_462010d4:

    # "Suspirando y ya agotado de todo esto, cierras los ojos."
    "Sighing, already exhausted by all of this, you close your eyes."

# game/rutas/nulla.rpy:5052
translate ingles continuacion_nulla_act3_final2_59e88e21:

    # "Te aguantas el asco como puedes."
    "You suppress any disgust as best you can."

# game/rutas/nulla.rpy:5055
translate ingles continuacion_nulla_act3_final2_e57b0e91:

    # "Abres la boca y Nulla se encarga de tomar tus manos con las suyas para ayudar a acercar el corazón de Septem a ti."
    "You open your mouth, and Nulla takes your hands in his to help bring Septem's heart closer."

# game/rutas/nulla.rpy:5056
translate ingles continuacion_nulla_act3_final2_9b384cf5:

    # "Intentas tragártelo, pero las arcadas te dificultan el proceso."
    "You try to swallow it, but your gag reflex makes it difficult."

# game/rutas/nulla.rpy:5057
translate ingles continuacion_nulla_act3_final2_da0d3bfc:

    # "No sabe a nada.... solo percibes su textura viscosa contra la lengua."
    "It tastes like nothing.... all you can feel is its slimy texture against your tongue."

# game/rutas/nulla.rpy:5058
translate ingles continuacion_nulla_act3_final2_b755dc35:

    # "Te toma al menos tres tortuosos intentos ingerir el corazón."
    "It takes you at least three agonizing attempts to swallow the heart."

# game/rutas/nulla.rpy:5059
translate ingles continuacion_nulla_act3_final2_75c2c007:

    # "Ya no puedes más..."
    "You can't take any more..."

# game/rutas/nulla.rpy:5060
translate ingles continuacion_nulla_act3_final2_cd05818e:

    # "Estás cansado...."
    "You're exhausted...."

# game/rutas/nulla.rpy:5061
translate ingles continuacion_nulla_act3_final2_5f9b772e:

    # "...."
    "...."

# game/rutas/nulla.rpy:5062
translate ingles continuacion_nulla_act3_final2_3928a113:

    # "......."
    "......."

# game/rutas/nulla.rpy:5063
translate ingles continuacion_nulla_act3_final2_8ca581bf:

    # "Escuchas a Nulla reír. Es una risa que en cualquier otro contexto sería normal, hasta tierna. Está llena de gozo genuino, una euforia que solo aparece cuando obtienes algo que has perseguido por mucho tiempo."
    "You hear Nulla laughing. It's the kind of laughter that, in any other context, would sound normal, even sweet. It's filled with genuine joy, an euphoria that only comes from finally obtaining something you've pursued for so long."

# game/rutas/nulla.rpy:5064
translate ingles continuacion_nulla_act3_final2_6265ee69:

    # "Te da las gracias una y otra vez. Te toma las manos, pero tú no lo puedes ver."
    "He thanks you over and over again. He takes your hands, but you can't see him."

# game/rutas/nulla.rpy:5065
translate ingles continuacion_nulla_act3_final2_32bc1c18:

    # "Te abraza, besa..."
    "He hugs you, kisses you..."

# game/rutas/nulla.rpy:5066
translate ingles continuacion_nulla_act3_final2_3068c0e5:

    # "Y sigues sin poderle ver, por lo que comienzas a entrar en pánico, pensando que tal vez hay algo mal con tus ojos."
    "And you still can't see him, so you begin to panic, thinking that perhaps something is wrong with your eyes."

# game/rutas/nulla.rpy:5071
translate ingles continuacion_nulla_act3_final2_8784a0f2:

    # nulla "Oh..."
    nulla "Oh..."

# game/rutas/nulla.rpy:5072
translate ingles continuacion_nulla_act3_final2_6e773d76:

    # "Es todo lo que te regala como respuesta."
    "That's all he offers you in response."

# game/rutas/nulla.rpy:5073
translate ingles continuacion_nulla_act3_final2_255068f3:

    # "Luego suelta aire, dejando escapar una risilla atónita."
    "Then he exhales, letting out a little laugh of astonishment."

# game/rutas/nulla.rpy:5074
translate ingles continuacion_nulla_act3_final2_fd7ac3fe:

    # nulla "Apagamos la luz de este lugar."
    nulla "We turned off the light in this place."

# game/rutas/nulla.rpy:5075
translate ingles continuacion_nulla_act3_final2_8b3fb7cf:

    # "Ríe nuevamente."
    "He laughs again."

# game/rutas/nulla.rpy:5076
translate ingles continuacion_nulla_act3_final2_043223f0:

    # nulla "Estamos a oscuras~~~"
    nulla "We're in the dark~~~"

# game/rutas/nulla.rpy:5077
translate ingles continuacion_nulla_act3_final2_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:5078
translate ingles continuacion_nulla_act3_final2_694c1bfd:

    # "Sus manos se entrelazan con las tuyas en la oscuridad, ofreciendo un granito de tranquilidad."
    "His hands intertwine with yours in the darkness, offering you a small measure of comfort."

# game/rutas/nulla.rpy:5079
translate ingles continuacion_nulla_act3_final2_1a0a36b9:

    # nulla "Pero no te preocupes~"
    nulla "But don't worry~"

# game/rutas/nulla.rpy:5080
translate ingles continuacion_nulla_act3_final2_d1e774d6:

    # nulla "Tengo ---"
    nulla "I have--"

# game/rutas/nulla.rpy:5084
translate ingles continuacion_nulla_act3_final2_96e09240:

    # centered "¡BRAVO!"
    centered "BRAVO!"

# game/rutas/nulla.rpy:5086
translate ingles continuacion_nulla_act3_final2_5701352c:

    # centered "¡¡¡¡Lo has logrado!!!!"
    centered "YOU DID IT!!!!"

# game/rutas/nulla.rpy:5090
translate ingles continuacion_nulla_act3_final2_575382ed:

    # "Escuchas aplausos alrededor tuyo."
    "You hear applause all around you."

# game/rutas/nulla.rpy:5093
translate ingles continuacion_nulla_act3_final2_d80ad61e:

    # "Una luz cegadora entra en tus retinas."
    "A blinding light floods your retinas."

# game/rutas/nulla.rpy:5098
translate ingles continuacion_nulla_act3_final2_bd6ee0a5:

    # "Cuando te acostumbras al cambio de iluminación, te encuentras con dos manos gigantes que aplauden arriba tuyo. Su ritmo es lento, como si se burlase de la situación."
    "Once your eyes adjust to the change in lighting, you find two enormous hands clapping above you. Their rhythm is slow, as though mocking the situation."

# game/rutas/nulla.rpy:5099
translate ingles continuacion_nulla_act3_final2_15a8e1a1:

    # el "Pero te has quedado sin tiempo~~~ \n\n Boo hooo~~~"
    el "But you've run out of time~~~ \n\n Boo hooo~~~"

# game/rutas/nulla.rpy:5100
translate ingles continuacion_nulla_act3_final2_6c3a1a4b:

    # nulla "¿¡QU----!?"
    nulla "WH--!?"

# game/rutas/nulla.rpy:5101
translate ingles continuacion_nulla_act3_final2_e4b77b78:

    # el "Tenemos que seguir un itinerario, lo siento querido~"
    el "We have a schedule to follow, sorry, dear~"

# game/rutas/nulla.rpy:5102
translate ingles continuacion_nulla_act3_final2_8b346002:

    # el "Tu tiempo se ha acabado."
    el "Your time is up."

# game/rutas/nulla.rpy:5103
translate ingles continuacion_nulla_act3_final2_4a92dda0:

    # el "Vamos a tener una pausa------- "
    el "We're going to take a break-------"

# game/rutas/nulla.rpy:5104
translate ingles continuacion_nulla_act3_final2_96a2ed47:

    # extend "laaaaaaaaaargaaaaa."
    extend "a loooooooooong break."

# game/rutas/nulla.rpy:5105
translate ingles continuacion_nulla_act3_final2_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:5106
translate ingles continuacion_nulla_act3_final2_782cbc0b:

    # el "Tal vez así puedas pensar mejor tus decisiones. Solo."
    el "Maybe this way you'll think more carefully about your decisions. Alone."

# game/rutas/nulla.rpy:5107
translate ingles continuacion_nulla_act3_final2_fa525492:

    # el "Mientras esperas que [nombrejugador] vuelva por nuevo contenido~"
    el "While you wait for [nombrejugador] to come back for new content~"

# game/rutas/nulla.rpy:5108
translate ingles continuacion_nulla_act3_final2_443f1f29:

    # nulla "ERES UN-----!!!"
    nulla "YOU'RE A--!!!"

# game/rutas/nulla.rpy:5111
translate ingles continuacion_nulla_act3_final2_82cf3321:

    # centered "Corte~~~~."
    centered "Cut~~~~"

# game/rutas/nulla.rpy:5114
translate ingles continuacion_nulla_act3_final2_4624efd9:

    # "---------------------------------------------"
    "---------------------------------------------"

# game/rutas/nulla.rpy:5115
translate ingles continuacion_nulla_act3_final2_e16f1cdc:

    # "------------------------------------------------------------------------"
    "------------------------------------------------------------------------"

# game/rutas/nulla.rpy:5116
translate ingles continuacion_nulla_act3_final2_2d24014d:

    # "{sc=4}Fin del acto 3.{/sc}"
    "{sc=4}End of Act 3.{/sc}"

# game/rutas/nulla.rpy:5117
translate ingles continuacion_nulla_act3_final2_a6535502:

    # "{sc=4}Tocará esperar a la última actualización para saber como acaba esta historia {/sc}"
    "{sc=4}You'll have to wait for the final update to find out how this story ends. •:3{/sc}"

