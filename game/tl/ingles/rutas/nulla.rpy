    new "Nulla?"

    # game/rutas/nulla.rpy:2970
    old "Tú no eres Nulla..."
    new "You're not Nulla..."

    # game/rutas/nulla.rpy:3004
    old "El ojo."
    new "The eye."

    # game/rutas/nulla.rpy:3004
    old "El gatito."
    new "The kitten."

    # game/rutas/nulla.rpy:3004
    old "El pollito."
    new "The chick."

    # game/rutas/nulla.rpy:3004
    old "El tiburon."
    new "The shark."

    # game/rutas/nulla.rpy:3032
    old "¡Gracias!"
    new "Thank you!"

    # game/rutas/nulla.rpy:3032
