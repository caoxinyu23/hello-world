# game/rutas/nulla.rpy:748
translate ingles null_bb684744:

    # nulla "Aunque no podremos acceder al jardín, ya que Madre me eliminará si sigo jugando con el mundo..."
    nulla "Although we won't be able to access the Garden, since Mother will eliminate me if I keep playing with the world..."

# game/rutas/nulla.rpy:749
translate ingles null_94593c63:

    # nulla "Tendremos que trabajar con mi memoria..."
    nulla "We'll have to work with my memory..."

# game/rutas/nulla.rpy:752
translate ingles null_599eed85:

    # nulla "No es por alardear pero"
    nulla "I'm not trying to brag, but..."

# game/rutas/nulla.rpy:753
translate ingles null_ca52cb04:

    # nulla "Conozco muchos lugares y muchos mundos."
    nulla "I know many places and many worlds."

# game/rutas/nulla.rpy:754
translate ingles null_add38350:

    # nulla "Vamos a una ciudad normal, ya estoy aburrido de ver tantas figuras con la cara tapada."
    nulla "Let's go to a normal city; I'm tired of seeing so many figures with their faces covered."

# game/rutas/nulla.rpy:756
translate ingles null_5db50600:

    # "Nulla te agarra la mano y te sonrie de medio lado."
    "Nulla grabs your hand and smiles at you slightly."

# game/rutas/nulla.rpy:758
translate ingles null_865f35cd:

    # "Y ambos se hunden en el vacío."
    "And both of you sink into the Void."

# game/rutas/nulla.rpy:759
translate ingles null_1eee34af:

    # nulla "Iremos a un parque... creo que esa zona es la más segura..."
    nulla "We'll go to a park... I think that area is the safest..."

# game/rutas/nulla.rpy:760
translate ingles null_4613c331:

    # "¿Segura? ¿a qué se refiere con eso?... Eso significa que, ¿habrá zonas que no son seguras?"
    "Safe? What does he mean by that?... Does that mean there are areas that aren't safe?"

# game/rutas/nulla.rpy:761
translate ingles null_7bf90c93:

    # nulla "No te separes de mí."
    nulla "Don't leave my side."

# game/rutas/nulla.rpy:762
translate ingles null_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:763
translate ingles null_50fdd4c8:

    # nulla "Si ves algo diferente en mi apariencia, no te asustes. Por favor..."
    nulla "If you see something different in my appearance, don't be scared. Please..."

# game/rutas/nulla.rpy:764
translate ingles null_5051dfa9:

    # "Tus pies tocan el suelo y el vacío comienza a desaparecer."
    "Your feet touch the ground, and the Void begins to disappear."

# game/rutas/nulla.rpy:767
translate ingles null_146f5996:

    # "Miras a tu alrededor y el lugar no se encuentra tan concurrido como esperabas."
    "You look around, and the place isn't as crowded as you expected."

# game/rutas/nulla.rpy:768
translate ingles null_f789fc21:

