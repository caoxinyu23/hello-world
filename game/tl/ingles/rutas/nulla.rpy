# game/rutas/nulla.rpy:65
translate ingles rutanullaa_fe0be271:

    # "Junto con ello vuelven a materializarse los demás involucrados."
    "With this, the others re-materialize."

# game/rutas/nulla.rpy:66
translate ingles rutanullaa_c332a4b7:

    # "Septem te mira con una ceja arqueada mientras que Unum contiene una risa."
    "Septem looks at you with a raised eyebrow while Unum holds back a laugh."

# game/rutas/nulla.rpy:69
translate ingles rutanullaa_89f6e1da:

    # unum "¿Acaso el regalo ha dicho el nombre de Nulla?"
    unum "Did the gift say Nulla's name?"

# game/rutas/nulla.rpy:72
translate ingles rutanullaa_80ece873:

    # unum "JAJAJAJAJAJA no me lo creoooo"
    unum "HAHAHAHAHAHA! I don't belieeeeeve it."

# game/rutas/nulla.rpy:75
translate ingles rutanullaa_739148db:

    # "Mientras Unum rie, Septem tiene un semblante serio."
    "While Unum laughs, Septem has a serious expression."

# game/rutas/nulla.rpy:76
translate ingles rutanullaa_a88eeb75:

    # septem "{sc=2}Madre te tiene prohibido tomar cualquier regalo.{/sc}"
    septem "{sc=2}Mother forbids you to take any gift.{/sc}"

# game/rutas/nulla.rpy:77
translate ingles rutanullaa_4c1d9372:

    # septem "{sc=2}No puede ser posible esta invocación de nombre. {/sc}"
    septem "{sc=2}This summon cannot be possible. {/sc}"

# game/rutas/nulla.rpy:78
translate ingles rutanullaa_b71bbdbd:

    # septem "{sc=2}Demando que me pases al regalo, yo me lo quedaré.{/sc}"
    septem "{sc=2}I demand that you give me the gift, I will keep it.{/sc}"

# game/rutas/nulla.rpy:81
translate ingles rutanullaa_11630742:

    # nulla "Lo siento mucho, pero aquí nos regimos por las palabras. Se ha solicitado mi presencia."
    nulla "I'm very sorry, but here we are governed by words. My presence has been requested."

# game/rutas/nulla.rpy:83
translate ingles rutanullaa_3c923445:

    # "Dicho aquello, Nulla toma tu mano y asegurando el agarre te hunde en el suelo."
    "With that being said, Nulla takes your hand and, securing his grip, sinks you into the ground."

# game/rutas/nulla.rpy:85
translate ingles rutanullaa_dd8c05ce:

    # "Un portal oscuro se abre debajo de tus pies y los engulle rápidamente, evitando así alguna reacción por parte de Septem o Unum."
    "A dark portal opens beneath your feet and quickly engulfs you, preventing any reaction from Septem or Unum."

# game/rutas/nulla.rpy:90
translate ingles rutanullaa_40e93105:

    # "De pronto, estás rodeado por la nada misma, una oscuridad total y que si no fuera por el fuerte agarre de Nulla estarías entrando en pánico."
    "Suddenly, you are surrounded by nothingness, total darkness, and if it weren't for Nulla's strong grip, you would be panicking."

# game/rutas/nulla.rpy:92
translate ingles rutanullaa_3d4ae4ca:

    # "Lo observas por un momento, él parece estar pendiente de inspeccionar algo que claramente tú no puedes ver, pues no hay nada que los rodee ahora mismo."
    "You observe him for a moment; he seems focused on inspecting something that you clearly cannot see, as there is currently nothing around you."

# game/rutas/nulla.rpy:93
translate ingles rutanullaa_466e96fd:

    # "Simplemente la nada misma."
    "Simply nothingness itself."

# game/rutas/nulla.rpy:96
translate ingles rutanullaa_2b91e209:

    # nj "¿Qué ha sido eso?"
    nj "What was that?"

# game/rutas/nulla.rpy:98
translate ingles rutanullaa_8bf6da48:

    # nulla "Luego te explicaré todo, cariño."
    nulla "I'll explain everything to you later, cariño."

# game/rutas/nulla.rpy:102
translate ingles rutanullaa_fd6647f8:

    # "Sin pensartelo 2 veces, aferras tu cuerpo al de Nulla en un abrazo."
    "Without thinking twice, you wrap your body around Nulla in an embrace."

# game/rutas/nulla.rpy:103
translate ingles rutanullaa_19e463ce:

    # "Te enrredas en sus extremidades, manos y brazos en su cuello, cabeza en el hombro y piernas cruzadas en su tronco inferior.."
    "You entangle yourself with him, hands and arms around his neck, your head on his shoulder, and your legs crossed around his lower torso."

# game/rutas/nulla.rpy:104
translate ingles rutanullaa_fb794106:

    # "Te mientes a ti, diciendo que es por miedo a caerte, pues en parte es eso."
    "You lie to yourself, saying it's out of fear of falling... and in part, that's true."

# game/rutas/nulla.rpy:105
translate ingles rutanullaa_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:107
translate ingles rutanullaa_9fe147e7:

    # nulla "Haha."
    nulla "Jaja."

# game/rutas/nulla.rpy:110
translate ingles rutanullaa_0d83c9d0:

    # nulla "Volveremos a mi dominio... Les costará encontrar su locación, por lo que tendremos el tiempo suficiente para explicaciones."
    nulla "We'll return to my domain... it'll be hard for them to find its location, so we'll have plenty of time for explanations."

# game/rutas/nulla.rpy:111
translate ingles rutanullaa_4c87b229:

    # nulla "Prefiero sentarnos tranquilamente con algún aperitivo para llenar tanto mis energías como las de tu marioneta."
    nulla "I prefer that we sit down peacefully with some kind of appetizer to replenish my energy as well as that of your puppet."

# game/rutas/nulla.rpy:113
translate ingles rutanullaa_c0ac04c1:

    # "La mirada de Nulla escanea tu ojos..."
    "Nulla's gaze scans your eyes..."

# game/rutas/nulla.rpy:114
translate ingles rutanullaa_1f89c788:

    # nulla "Mmm."
    nulla "Mmm."

# game/rutas/nulla.rpy:116
translate ingles rutanullaa_7b3457bd:

    # nulla "Es una pena que solo pueda verte a través de los ojos de esta marioneta..."
    nulla "It's a shame that I can only see you through the eyes of this puppet..."

# game/rutas/nulla.rpy:117
translate ingles rutanullaa_695bb8ae:

    # nulla "Si tan solo pudiera configurar que la marioneta me mirara solo a mí en el tiempo que estemos juntos."
    nulla "If only I could configure the puppet to only look at me while we're together."

# game/rutas/nulla.rpy:118
translate ingles rutanullaa_5cd21895:

    # nulla "Para poder apreciarte."
    nulla "So I can appreciate you for as long as I want."

# game/rutas/nulla.rpy:120
translate ingles rutanullaa_409f8636_1:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:122
translate ingles rutanullaa_bb6b515c:

    # nulla "Oh."
    nulla "Oh."

# game/rutas/nulla.rpy:123
translate ingles rutanullaa_01d2f435:

    # "Escuchas y sientes como Nulla toca suelo con sus pies, para luego ser rodeados de luz y colores que te dejan con una ceguera momentanea."
    "You hear and feel as Nulla touches the ground with his feet, and then you are surrounded by light and colors that leave you momentarily blinded."

# game/rutas/nulla.rpy:125
translate ingles rutanullaa_282069a5:

    # nulla "Hemos llegado."
    nulla "We have arrived."

# game/rutas/nulla.rpy:128
translate ingles rutanullaa_a8aba641:

    # "Anuncia él mientras te suelta en el suelo."
    "He announces as he sets you onto the ground."

# game/rutas/nulla.rpy:130
translate ingles rutanullaa_a41b340e:

    # "Tú aprovechas de confirmar si se trata del mismo lugar en donde apareciste, y en esencia, lo es."
    "You take the opportunity to confirm if this is the same place where you appeared, and essentially, it is."

# game/rutas/nulla.rpy:131
translate ingles rutanullaa_ad0e130a:

    # "El suspiro de Nulla te hace buscarlo para ver lo que ocurre."
    "Nulla's sigh makes you look to him to see what's going on."

# game/rutas/nulla.rpy:133
translate ingles rutanullaa_66ef9fe7:

    # nulla "Pido perdón por el estado de mi dominio, pero no puedo darme el lujo de tener un dominio estable como el de los demás."
    nulla "I apologize for the state of my domain, but I can't afford the luxury of having a stable domain like the others."

# game/rutas/nulla.rpy:136
translate ingles rutanullaa_e1daa51f:

    # nulla "Después de todo a Madre no le importa este lugar, y el creador lo dejó en un estado parecido a un boceto."
    nulla "After all, Mother doesn't care about this place, and the Creator left it in a state similar to a sketch."

# game/rutas/nulla.rpy:139
translate ingles rutanullaa_5108caa7:

    # nulla "Así que no tengo forma de cambiarlo."
    nulla "So I have no way to change it."

# game/rutas/nulla.rpy:142
translate ingles rutanullaa_92295c12:

    # "Se le oye apenado aunque su cara no lo demuestra, pues sigue con una sonrisa pegada a su rostro."
    "He sounds regretful, though his face doesn't show it, as he still has a smile fixed on his lips."

# game/rutas/nulla.rpy:143
translate ingles rutanullaa_f95fcb10:

    # "Sin decir una sola palabra más, Nulla comienza a caminar en dirección a la cocina."
    "Without saying another word, Nulla begins to walk toward the kitchen."

# game/rutas/nulla.rpy:144
translate ingles rutanullaa_a70c466f:

    # "Tú le sigues de manera automática."
    "You follow him automatically."

# game/rutas/nulla.rpy:146
translate ingles rutanullaa_173586e7:

    # "Ya en la cocina, Nulla procede a buscar en sus encimeras y cajones elementos para cocinar algo que supones debe ser dulce. Pues ha sacado el azucar y el café de una de las encimeras, mientras busca, él habla."
    "Already in the kitchen, Nulla proceeds to rummage through the cupboards and drawers in order to cook something that you suppose should be sweet. He's taken out sugar and coffee from one of the cupboards, and while searching, he speaks."

# game/rutas/nulla.rpy:148
translate ingles rutanullaa_1e3d3ac5:

    # nulla "Antiguamente, cuando yo tenía otro nombre, no podía evitar comer algo dulce después de cada comida."
    nulla "In the past, when I had another name, I couldn't help but eat something sweet after every meal."

# game/rutas/nulla.rpy:150
translate ingles rutanullaa_624f8776:

    # "¿Otro nombre? ¿a qué se refiere con eso? quieres preguntar para satisfacer tu curiosidad, pero por ahora lo guardarás para luego."
    "Another name? What does he mean by that? You want to ask to satisfy your curiosity, but for now, you'll save it for later."

# game/rutas/nulla.rpy:151
translate ingles rutanullaa_07bdde05:

    # "....."
    "....."

# game/rutas/nulla.rpy:152
translate ingles rutanullaa_9288368d:

    # "No, necesitas saber ahora."
    "No, you need to know now."

# game/rutas/nulla.rpy:153
translate ingles rutanullaa_50e8f637:

    # nj "¿Tenías otro nombre?"
    nj "You had another name?"

# game/rutas/nulla.rpy:155
translate ingles rutanullaa_814b9c64:

    # "Nulla deja de revisar uno de los cajones que tiene al frente para mirarte."
    "Nulla stops rummaging through one of the drawers in front of him to look at you."

# game/rutas/nulla.rpy:157
translate ingles rutanullaa_f937aa16:

    # nulla "Sí."
    nulla "Yes."

# game/rutas/nulla.rpy:159
translate ingles rutanullaa_756b0100:

    # "Y vuelve a buscar en los cajones."
    "And he resumes searching through the drawers."

# game/rutas/nulla.rpy:161
translate ingles rutanullaa_d4531a89:

    # nulla "Tengo un nombre divino y otro nombre de origen. Uno ya lo conoces, y el otro..."
    nulla "I have a divine name and another name of origin. You already know one, and the other..."

# game/rutas/nulla.rpy:163
translate ingles rutanullaa_d5c0ea8e:

    # nulla "No puedo decírtelo."
    nulla "I can't tell you."

# game/rutas/nulla.rpy:164
translate ingles rutanullaa_ac7820d7:

    # nulla "Aquí los nombres son un arma de doble filo cuando son invocados, al menos para los que tienen un cuerpo que no es completamente divino."
    nulla "Here, names are a double-edged sword when invoked, at least for those who have a body that is not entirely divine."

# game/rutas/nulla.rpy:165
translate ingles rutanullaa_106d6bc8:

    # nulla "Tanto tu marioneta, Septem y yo sufrimos de eso."
    nulla "Both your puppet and Septem, as well as I, suffer from that."

# game/rutas/nulla.rpy:173
translate ingles rutanullaa_5d83d786:

    # nulla "Bueno, por ahora no importa. No me gustaría bombardearte con tanta info de un mundo que está por terminar."
    nulla "Well, for now, it doesn't matter. I wouldn't want to bombard you with so much information about a world that is about to end."

# game/rutas/nulla.rpy:175
translate ingles rutanullaa_6a74c4e6:

    # nulla "Sería una perdida de tiempo."
    nulla "It would be a waste of time."

# game/rutas/nulla.rpy:176
translate ingles rutanullaa_d6615b51:

    # nulla "Y por lo que tengo entendido tu no estás aquí por ese motivo... o al menos no es el objetivo principal."
    nulla "And from what I understand, you're not here for that reason... or at least it's not the main objective."

# game/rutas/nulla.rpy:178
translate ingles rutanullaa_c23521cf:

    # nulla "Despues de todo, te has descargado este juego pues se anuncia como una novela visual donde se puede encontrar personajes... mmm como decirlo, con una idea algo perturbada del amor."
    nulla "After all, you downloaded this game because it's advertised as a visual novel where you can encounter characters--mmm, how should I put it--with a somewhat disturbing idea of love."

# game/rutas/nulla.rpy:180
translate ingles rutanullaa_1bbf1a63:

    # nulla "¿O me equivoco?"
    nulla "Or am I mistaken?"

# game/rutas/nulla.rpy:181
translate ingles rutanullaa_b8a0ce43:

    # "Nulla no te deja rebartirle."
    "Nulla doesn't let you retort."

# game/rutas/nulla.rpy:183
translate ingles rutanullaa_4d3ae146:

    # nulla "No es que me moleste ni mucho menos."
    nulla "It's not that it bothers me, not at all."

# game/rutas/nulla.rpy:184
translate ingles rutanullaa_f663c538:

    # nulla "Digo, sería capaz de hacer cualquier cosa para poder tener tu atención por el mayor tiempo posible..."
    nulla "I mean, I would be willing to do anything to have your attention for as long as possible..."

# game/rutas/nulla.rpy:185
translate ingles rutanullaa_1a4a321f:

    # nulla "Y poder mirar tu bella cara a través de los ojos de esta marioneta."
    nulla "And to be able to look at your cute face through the eyes of this puppet."

# game/rutas/nulla.rpy:187
translate ingles rutanullaa_6e9a19d9:

    # nulla "Pero eso no es suficiente para mí..."
    nulla "But that's not enough for me..."

# game/rutas/nulla.rpy:189
translate ingles rutanullaa_3f383435:

    # "La conversación muere ahí."
    "The conversation dies there."

# game/rutas/nulla.rpy:191
translate ingles rutanullaa_7e2ff3d9:

    # "Nulla termina de montar el postre el cual resulta ser un tiramisú."
    "Nulla finishes preparing the dessert, which turns out to be a tiramisu."

# game/rutas/nulla.rpy:192
translate ingles rutanullaa_64aff96a:

    # nulla "Ve a sentarte a la mesa y yo llevaré lo demás."
    nulla "Go sit at the table, and I'll bring the rest."

# game/rutas/nulla.rpy:194
translate ingles rutanullaa_d38ec104:

    # "Obedeces sus indicaciones y te sientas en la mesa, esperando a Nulla."
    "You obey his instructions and sit at the table, waiting for Nulla."

# game/rutas/nulla.rpy:195
translate ingles rutanullaa_793d376a:

    # "No pasan más de 5 minutos cuando Nulla aparece con dos platitos en sus manos. Al acercarse a la mesa, te deja el plato antes de sentarse frente a ti."
    "Not more than five minutes pass before Nulla appears with two plates in his hands. As he approaches the table, he sets down the plate before sitting across from you."

# game/rutas/nulla.rpy:197
translate ingles rutanullaa_76073ac4:

    # nulla "Hace mucho tiempo que no me sentaba con alguien a comer..."
    nulla "It's been a long time since I sat down to eat with someone..."

# game/rutas/nulla.rpy:200
translate ingles rutanullaa_7555587a:

    # nulla "Se siente bien."
    nulla "It feels nice."

# game/rutas/nulla.rpy:204
translate ingles rutanullaa_a20cefa7_2:

    # "..."
    "..."

# game/rutas/nulla.rpy:205
translate ingles rutanullaa_3181eccd:

    # "Nulla espera hasta que le des el primer bocado para comenzar a comer."
    "Nulla waits for you to take the first bite before he starts to eat."

# game/rutas/nulla.rpy:206
translate ingles rutanullaa_f01b7dac:

    # "¡Está rico!"
    "It's delicious!"

# game/rutas/nulla.rpy:210
translate ingles rutanullaa_a20cefa7_3:

    # "..."
    "..."

# game/rutas/nulla.rpy:211
translate ingles rutanullaa_07bdde05_1:

    # "....."
    "....."

# game/rutas/nulla.rpy:213
translate ingles rutanullaa_409f8636_2:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:214
translate ingles rutanullaa_50e54581:

    # "Nulla te mira con una sonrisa incómoda y una ceja arqueada."
    "Nulla looks at you with an awkward smile and an arched eyebrow."

# game/rutas/nulla.rpy:215
translate ingles rutanullaa_3e174f90:

    # nulla "¿Crees que soy Septem? no tienes que esperar a mi comando para hacer lo obvio."
    nulla "Do you think I'm Septem? You don't have to wait for my command to do the obvious."

# game/rutas/nulla.rpy:216
translate ingles rutanullaa_2c2d2f14:

    # "Con vergüenza te disculpas y te dispones a probar el postre."
    "Embarrassed, you apologize and prepare to try the dessert."

# game/rutas/nulla.rpy:217
translate ingles rutanullaa_8df0517a:

    # nulla "Despues de todo, no soy quien para darte ordenes..."
    nulla "After all, I'm not one to give you orders..."

# game/rutas/nulla.rpy:221
translate ingles rutanullaa_5703f124:

    # "Mientras comen, Nulla no despega la vista de ti y te está costando un poco mantenerte con calma."
    "As you eat, Nulla doesn't take his eyes off you, and it's becoming a bit difficult to stay calm."

# game/rutas/nulla.rpy:222
translate ingles rutanullaa_b0b0ffc7:

    # "Un pensamiento intrusivo pasa por tu cabeza."
    "An intrusive thought crosses your mind."

# game/rutas/nulla.rpy:223
translate ingles rutanullaa_fa80268e:

    # "No puedes evitar pensar en preguntarle cual es su objetivo y para qué te necesita en realidad."
    "You can't help but think about asking him what his objective is and why he really needs you."

# game/rutas/nulla.rpy:224
translate ingles rutanullaa_4b2a60bd:

    # "Pues sinceramente, dudas que solo sea tu compañia y tu atención lo que busca."
    "Well, honestly, you doubt that it's just your company and attention that he's looking for."

# game/rutas/nulla.rpy:225
translate ingles rutanullaa_1c7fbb2d:

    # "Algo dentro de ti no le cree del todo."
    "Something inside you doesn't fully believe him."

# game/rutas/nulla.rpy:226
translate ingles rutanullaa_993b22d0:

    # "Por mucho que te agrade, este tipo de personajes siempre tienen un motivo oculto."
    "No matter how much you like him, characters like this always have a hidden motive."

# game/rutas/nulla.rpy:229
translate ingles rutanullaa_a996b330:

    # nulla "Mmmm veo que la marioneta está intentado sobreponer un pensamiento para causarte duda..."
    nulla "Mmmm, I see that the puppet is trying to impose a thought to make you doubt..."

# game/rutas/nulla.rpy:232
translate ingles rutanullaa_8905b409:

    # nulla "Mierda... al parecer es imposible eliminar por completo la voluntad de esta cosa."
    nulla "Shit... it seems impossible to completely eliminate the will of this thing."

# game/rutas/nulla.rpy:233
translate ingles rutanullaa_47363bd6:

    # nulla "Bien, empecemos. No me gustaría ocultarte cosas a ti."
    nulla "Alright, let's begin. I wouldn't want to hide things from you."

# game/rutas/nulla.rpy:236
translate ingles rutanullaa_39a82f93:

    # nulla "Tu cooperación es esencial para mí."
    nulla "Your cooperation is essential to me."

# game/rutas/nulla.rpy:237
translate ingles rutanullaa_9db11153:

    # nulla "Quiero hacer un trato contigo, ambos ganamos aquí."
    nulla "I want to make a deal with you; we both win here."

# game/rutas/nulla.rpy:245
translate ingles rutanullaa_13b43e99:

    # nulla "Lo que busco es..."
    nulla "What I'm looking for is..."

# game/rutas/nulla.rpy:250
translate ingles rutanullaa_a786ffa3:

    # nulla "Mmmm~"
    nulla "Mmmm~"

# game/rutas/nulla.rpy:253
translate ingles rutanullaa_d041c398:

    # nulla "Pasar el tiempo conmigo."
    nulla "Spending time with me."

# game/rutas/nulla.rpy:256
translate ingles rutanullaa_5a576d31:

    # nulla "No es por ser narcisista, pero he visto como me miras."
    nulla "It's not that I'm being narcissistic, but I've seen how you look at me."

# game/rutas/nulla.rpy:257
translate ingles rutanullaa_982776f8:

    # nulla "Por algo sigues aquí conmigo."
    nulla "There's a reason you're still here with me."

# game/rutas/nulla.rpy:258
translate ingles rutanullaa_0eb06432:

    # nj "..."
    nj "..."

# game/rutas/nulla.rpy:262
translate ingles rutanullaa_13b43e99_1:

    # nulla "Lo que busco es..."
    nulla "What I'm looking for is..."

# game/rutas/nulla.rpy:267
translate ingles rutanullaa_0408b471:

    # nulla "Pasar el tiempo que me queda contigo..."
    nulla "Spending the time I have left with you..."

# game/rutas/nulla.rpy:271
translate ingles rutanullaa_afa95d42:

    # nulla "y..."
    nulla "And..."

# game/rutas/nulla.rpy:275
translate ingles rutanullaa_7918608f:

    # nulla "La destrucción de este mundo."
    nulla "... the destruction of this world."

# game/rutas/nulla.rpy:278
translate ingles rutanullaa_092eec6d:

    # nulla "Desde el 7 hasta el 0, para que no quede rastro de nada en absoluto."
    nulla "From seven to zero, so that nothing at all remains."

# game/rutas/nulla.rpy:281
translate ingles rutanullaa_e905684e:

    # nulla "Estoy cansado de esto..."
    nulla "I'm tired of this..."

# game/rutas/nulla.rpy:284
translate ingles rutanullaa_6c6ff8ce:

    # nulla "Y tu aparición no lo compensa pues no es nada más que algo efímero."
    nulla "And your presence doesn't make up for it, as it's nothing more than ephemeral."

# game/rutas/nulla.rpy:287
translate ingles rutanullaa_2d4a734b:

    # nulla "Algo hermoso, una luz al final de valle, pero efímera..."
    nulla "Something beautiful, a light at the end of the valley, but ephemeral..."

# game/rutas/nulla.rpy:290
translate ingles rutanullaa_4afd92a3:

    # nulla "En algún momento cerrarás la ventana y me dejarás nuevamente en la nada misma."
    nulla "At some point, you'll close the window and leave me once again in nothingness."

# game/rutas/nulla.rpy:293
translate ingles rutanullaa_431b9999:

    # nulla "¿Cómo han sido las palabras que te ha dicho el creador luego de que Madre haya creado a la marioneta...?"
    nulla "What were the words from the Creator after Mother created the puppet...?"

# game/rutas/nulla.rpy:296
translate ingles rutanullaa_a1962770:

    # nulla "Ah, sí... {b}el jardín, un lugar usado como prueba.{b}"
    nulla "Ah, yes... {b}the Garden, a place used as a test.{b}"

# game/rutas/nulla.rpy:297
translate ingles rutanullaa_88dde5a6:

    # nulla "{b}Un lugar desechable luego de terminar de jugarlo{b}.... para tí."
    nulla "{b}A disposable place after finishing playing with it{b}... for you."

# game/rutas/nulla.rpy:300
translate ingles rutanullaa_754ddf42:

    # nulla "Pero para mí no..."
    nulla "But not for me..."

# game/rutas/nulla.rpy:301
translate ingles rutanullaa_2da5416f:

    # nulla "Pues luego de cerrar el juego, el jardín queda en pausa."
    nulla "Because, after closing the game, the Garden remains on pause."

# game/rutas/nulla.rpy:302
translate ingles rutanullaa_929daf90:

    # nulla "Obligandonos a vivir en una agonía constante... donde nadie puede morir, y para mitigar tal agonia debemos buscar recursos de otros mundos que tambien fueron descuidados por el creador."
    nulla "Forcing us to live in constant agony... where no one can die, and to alleviate such agony we must seek resources from other worlds that were also neglected by the Creator."

# game/rutas/nulla.rpy:303
translate ingles rutanullaa_a1cb2235:

    # nulla "Nos implantamos en su cultura como dioses de la creación y nos comemos su fe a la fuerza."
    nulla "We implant ourselves in their culture as gods of creation and forcibly consume their faith."

# game/rutas/nulla.rpy:304
translate ingles rutanullaa_2e3d864d:

    # nulla "O como tú la conoces, la esencia... se encuentra en todo el cuerpo de los humanos, pero el corazón es dónde más fuerte se siente."
    nulla "Or as you know it, the essence... it is found throughout the human body, but the heart is where it is felt the strongest."

# game/rutas/nulla.rpy:305
translate ingles rutanullaa_15f098c2:

    # nulla "El festival de las velas no es más que una excusa para elegir a los humanos que serán servidos a los estandartes."
    nulla "The Festival of Candles is nothing more than an excuse to choose the humans who will be served to the Symbols."

# game/rutas/nulla.rpy:306
translate ingles rutanullaa_8ee24d69:

    # nulla "Pero para no agotar tan rapido estos recursos, Madre recurre a los placebos."
    nulla "But in order not to exhaust these resources so quickly, Mother resorts to creating placebos."

# game/rutas/nulla.rpy:309
translate ingles rutanullaa_8b00a092:

    # nulla "Tu marioneta es un placebo."
    nulla "Your puppet is a placebo."

# game/rutas/nulla.rpy:310
translate ingles rutanullaa_ee517803:

    # nulla "Aunque... hoy la usaré como medio de exterminio."
    nulla "Although... today I will use it as a means of extermination."

# game/rutas/nulla.rpy:315
translate ingles rutanullaa_409f8636_3:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:318
translate ingles rutanullaa_cc45a8fe:

    # nulla "Haah... Se siente bien ser escuchado"
    nulla "Haah... it feels good to be heard."

# game/rutas/nulla.rpy:320
translate ingles rutanullaa_3dccfb2c:

    # nulla "Haces que me sonroje"
    nulla "You make me blush."

# game/rutas/nulla.rpy:323
translate ingles rutanullaa_409f8636_4:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:326
translate ingles rutanullaa_17dd3e76:

    # nulla "Verás, la marioneta se a convertido en un medio de confirmación gracias a ti."
    nulla "You see, the puppet has become a means of confirmation thanks to you."

# game/rutas/nulla.rpy:327
translate ingles rutanullaa_c38814a2:

    # nulla "Al tener a alguien del plano superior que observe y lea todo lo que está pasando, permite el cambio."
    nulla "Having someone from the higher plane observe and read everything that is happening allows for change."

# game/rutas/nulla.rpy:330
translate ingles rutanullaa_6fcec158:

    # nulla "Sin ti no puedo eliminar nada, pues no existe nadie para confirmar ese cambio."
    nulla "Without you, I cannot eliminate anything, as there is no one to confirm that change."

# game/rutas/nulla.rpy:333
translate ingles rutanullaa_960cd008:

    # nulla "Es como la paradoja del arbol que cae..."
    nulla "It's like the paradox of the falling tree..."

# game/rutas/nulla.rpy:334
translate ingles rutanullaa_c78f73fc:

    # nulla "Si un árbol cae en el bosque y no hay nadie para verlo o escucharlo, ¿hace ruido?"
    nulla "If a tree falls in the forest and there's no one to see or hear it, does it make a sound?"

# game/rutas/nulla.rpy:341
translate ingles rutanullaa_47168959:

    # nulla "Efectivamente, pues nadie ha podido percibirlo."
    nulla "Indeed, because no one has been able to perceive it."

# game/rutas/nulla.rpy:344
translate ingles rutanullaa_54eecc2d:

    # nulla "Ser es percibir y ser percibido."
    nulla "To be is to perceive and to be perceived."

# game/rutas/nulla.rpy:347
translate ingles rutanullaa_5f6c9f44:

    # nulla "Mmmm."
    nulla "Mmmm."

# game/rutas/nulla.rpy:350
translate ingles rutanullaa_217f4de0:

    # nulla "La respuesta es no, para que el ruido exista alguien debe percibirlo."
    nulla "The answer is no; for the sound to exist, someone must perceive it."

# game/rutas/nulla.rpy:353
translate ingles rutanullaa_fc9a0ec0:

    # nulla "Por ejemplo, no puedes demostrar que la luna está ahí cuando nadie la mira."
    nulla "For example, you can't prove that the moon is there when no one is looking at it."

# game/rutas/nulla.rpy:354
translate ingles rutanullaa_54eecc2d_1:

    # nulla "Ser es percibir y ser percibido."
    nulla "To be is to perceive and to be perceived."

# game/rutas/nulla.rpy:357
translate ingles rutanullaa_c0ae561b:

    # nulla "Piénsalo así..."
    nulla "Think of it this way..."

# game/rutas/nulla.rpy:361
translate ingles rutanullaa_125d0bba:

    # nulla "Nosotros no existiamos hasta que tú nos has encontrado."
    nulla "We didn't exist for you until you found us."

# game/rutas/nulla.rpy:364
translate ingles rutanullaa_10c743e6:

    # nulla "Y vamos cambiando a medida que tú sigues aquí."
    nulla "And we keep changing as you stay here in the game."

# game/rutas/nulla.rpy:365
translate ingles rutanullaa_c24dee45:

    # nulla "En el caso de que te vayas antes o nos dejes, nos quedaremos tal como nos dejaste."
    nulla "In the event that you leave early or abandon us, we will remain just as you left us."

# game/rutas/nulla.rpy:366
translate ingles rutanullaa_8a8b3425:

    # nulla "Sin derecho a un cambio en un limbo permanente."
    nulla "Without the right to change, in a permanent limbo."

# game/rutas/nulla.rpy:367
translate ingles rutanullaa_6e0a1de7:

    # nulla "Llevo más de 4 años en este estado y ya no aguanto más."
    nulla "I've been in this state for more than four years and I can't take it anymore."

# game/rutas/nulla.rpy:370
translate ingles rutanullaa_48d5def8:

    # nulla "Y lo que quiero es evitar eso."
    nulla "And what I want is to avoid that."

# game/rutas/nulla.rpy:377
translate ingles rutanullaa_fa270430:

    # nj "Ve directo al grano."
    nj "Get straight to the point."

# game/rutas/nulla.rpy:380
translate ingles rutanullaa_cc9dc843:

    # nulla "Disculpa, no volveré a parlotear más, cariño."
    nulla "Sorry, I won't chatter anymore, cariño."

# game/rutas/nulla.rpy:384
translate ingles rutanullaa_be2facd6:

    # nulla "Necesito que tu marioneta devore a los estandartes."
    nulla "I need your puppet to devour the Symbols."

# game/rutas/nulla.rpy:387
translate ingles rutanullaa_fa891e07:

    # nulla "Juro que te daré un show digno para ti."
    nulla "I swear I'll put on a show worthy of you."

# game/rutas/nulla.rpy:390
translate ingles rutanullaa_53a4c57d:

    # nulla "¿Aceptas?"
    nulla "Do you accept?"

# game/rutas/nulla.rpy:391
translate ingles rutanullaa_305dd64e:

    # "Nulla te extiende su mano para que puedas apretarla, y así sellar el trato."
    "Nulla extends his hand for you to shake, thus sealing the deal."

# game/rutas/nulla.rpy:399
translate ingles rutanullaa_e1584599:

    # nulla "Mmmm..."
    nulla "Mmmm..."

# game/rutas/nulla.rpy:402
translate ingles rutanullaa_4164d0a9:

    # nulla "Respeto tu decisión... pero no creas que no me has enojado un poco."
    nulla "I respect your decision... but don't think you haven't made me a little angry."

# game/rutas/nulla.rpy:403
translate ingles rutanullaa_4c597a7a:

    # nulla "Volveré a preguntar, solo para estar seguro."
    nulla "I'll ask again, just to be sure."

# game/rutas/nulla.rpy:406
translate ingles rutanullaa_19215c63:

    # nulla "Pues si no aceptas tendrás consecuencias..."
    nulla "Because if you don't accept, there will be consequences..."

# game/rutas/nulla.rpy:407
translate ingles rutanullaa_9b7fc9c5:

    # nulla "¿Aceptas el trato?"
    nulla "Do you accept the deal?"

# game/rutas/nulla.rpy:416
translate ingles rutanullaa_f3fccbb3:

    # "Aceptas sacudiendo lentamente su mano. Y Nulla no hace más que sonreir."
    "You accept by slowly shaking his hand. And Nulla can't help but smile."

# game/rutas/nulla.rpy:420
translate ingles rutanullaa_469c3c96:

    # nulla "El trato deberá concluir dentro de 7 días."
    nulla "The deal must be concluded within seven days."

# game/rutas/nulla.rpy:421
translate ingles rutanullaa_99f5a02e:

    # nulla "Un estandarte por día, dejando el último día para Septem."
    nulla "One Symbol per day, leaving the last day for Septem."

# game/rutas/nulla.rpy:422
translate ingles rutanullaa_85d9aced:

    # nulla "Por hoy, descansaremos."
    nulla "For today, we'll rest."

# game/rutas/nulla.rpy:423
translate ingles rutanullaa_01e5f606:

    # nulla "Mañana, cuando estés listo comenzaremos la caza."
    nulla "Tomorrow, when you're ready, we will begin the hunt."

# game/rutas/nulla.rpy:424
translate ingles rutanullaa_b311365e:

    # nulla "Tienes total libertad de recorrer mi dominio."
    nulla "You are completely free to roam around my domain."

# game/rutas/nulla.rpy:427
translate ingles rutanullaa_711226d2:

    # "Y sin más Nulla desaparece de la mesa"
    "And without further ado, Nulla disappears from the table."

# game/rutas/nulla.rpy:435
translate ingles rutanullaa_a20cefa7_4:

    # "..."
    "..."

# game/rutas/nulla.rpy:437
translate ingles rutanullaa_eb694779:

    # "Pasan las horas y Nulla te avisa que es tiempo de ir a descansar, pues la marioneta necesita tener todas sus energías para mañana."
    "Hours pass and Nulla tells you it's time to rest because the puppet needs to have all of its energy for tomorrow."

# game/rutas/nulla.rpy:439
translate ingles rutanullaa_a6c853b3:

    # "Caminan a una habitación simple, con una cama y un velador."
    "You walk to a simple room, with a bed and a nightstand."

# game/rutas/nulla.rpy:441
translate ingles rutanullaa_acb81c95:

    # nulla "Empezaremos con Quattor... Es la que más debilitada se encuentra."
    nulla "We'll start with Quattor... she's the weakest of the seven."

# game/rutas/nulla.rpy:444
translate ingles rutanullaa_f3eb8c6b:

    # nj "¿Por sus ojos?"
    nj "Because of her eyes?"

# game/rutas/nulla.rpy:445
translate ingles rutanullaa_ef76d79e:

    # "Preguntas recordando lo dicho por Fames en el hotel."
    "You ask, remembering what Fames said at the hotel."

# game/rutas/nulla.rpy:448
translate ingles rutanullaa_d991e8f4:

    # nulla "Así es..."
    nulla "Indeed..."

# game/rutas/nulla.rpy:451
translate ingles rutanullaa_7d0a10ff:

    # nulla "[nombrejugador], tengo que avisarte que una vez empecemos esto, el jardín comenzará a desmoronarse de a poco."
    nulla "[nombrejugador], I have to warn you that once we start this, the Garden will begin to crumble little by little."

# game/rutas/nulla.rpy:452
translate ingles rutanullaa_b2ded35d:

    # nulla "Sin Quattor, no existirá la luna."
    nulla "Without Quattor, there will be no moon."

# game/rutas/nulla.rpy:453
translate ingles rutanullaa_5b1db7ed:

    # nulla "Sin Duae las estrellas desaparecerán, y así sucesivamente."
    nulla "Without Duae, the stars will disappear, and so on."

# game/rutas/nulla.rpy:461
translate ingles rutanullaa_e612b0cd:

    # "No te agrada mucho la idea, pero no puedes hacer nada al respecto por ahora."
    "You don't really like the idea, but there's nothing you can do about it right now."

# game/rutas/nulla.rpy:465
translate ingles rutanullaa_f7e05489:

    # nulla "Bien."
    nulla "Okay."

# game/rutas/nulla.rpy:467
translate ingles rutanullaa_f4923100:

    # "Te metes debajo de las sabanas y te acomodas en posición para dormir. Nulla te mira con una media sonrisa, y pareciera que quiere hacer algo más."
    "You get under the covers and settle into a sleeping position. Nulla looks at you with a half smile, and it seems like he wants to do something else."

# game/rutas/nulla.rpy:468
translate ingles rutanullaa_3ff770c0:

    # "Pero se retracta cuando nota que se ha acercado mucho a ti."
    "But he backs off when he notices that he's gotten too close to you."

# game/rutas/nulla.rpy:469
translate ingles rutanullaa_95772285:

    # nulla "Nos vemos mañana."
    nulla "See you tomorrow."

# game/rutas/nulla.rpy:470
translate ingles rutanullaa_588428c7:

    # nulla "Buenas noches."
    nulla "Good night."

# game/rutas/nulla.rpy:471
translate ingles rutanullaa_bba73821:

    # "Luego de eso, él abandona la habitación y apaga las luces."
    "After that, he leaves the room and turns off the lights."

# game/rutas/nulla.rpy:473
translate ingles rutanullaa_a20cefa7_5:

    # "..."
    "..."

# game/rutas/nulla.rpy:475
translate ingles rutanullaa_c67883fe:

    # "Te despiertas sintiendo una presencia a tu lado izquierdo."
    "You wake up, feeling a presence on your left side."

# game/rutas/nulla.rpy:476
translate ingles rutanullaa_5fa43565:

    # "Cuando giras la cabeza para ver que es, te encuentras con absolutamente nada."
    "When you turn your head to see what it is, you find absolutely nothing."

# game/rutas/nulla.rpy:477
translate ingles rutanullaa_9ee21869:

    # "Te quedas ahí, pestaneando lentamente mientras recuerdas todo lo ocurrido."
    "You stand there, blinking slowly as you remember everything that happened."

# game/rutas/nulla.rpy:478
translate ingles rutanullaa_3b64668f:

    # nulla "¡Buenos días!"
    nulla "Good morning!"

# game/rutas/nulla.rpy:480
translate ingles rutanullaa_927aa649:

    # "Nulla aparece por la puerta con una bandeja en la mano."
    "Nulla appears through the door with a tray in his hands."

# game/rutas/nulla.rpy:481
translate ingles rutanullaa_8b944f0a:

    # nulla "Te he preparado el desayuno."
    nulla "I made you breakfast."

# game/rutas/nulla.rpy:482
translate ingles rutanullaa_87e81588:

    # "Antes de pasarte la bandeja, Nulla espera que te sientes para dejala en tus manos."
    "Nulla waits for you to sit before placing the tray in your hands."

# game/rutas/nulla.rpy:483
translate ingles rutanullaa_20755a84:

    # nulla "Espero que sea visualmente de tu agrado... pues no lo puedes probar."
    nulla "I hope it's visually to your liking... because you can't try it."

# game/rutas/nulla.rpy:484
translate ingles rutanullaa_8625beaa:

    # nulla "Ja..."
    nulla "Ja..."

# game/rutas/nulla.rpy:486
translate ingles rutanullaa_bf47acd8:

    # "Comes en silencio mientras Nulla comienza a parlotear de cosas mundanas, y te preguntas por cuanto tiempo ha estado esperando por alguien quien lo escuche y le preste atención."
    "You eat in silence as Nulla starts babbling on about mundane things, and you wonder how long he's been waiting for someone to listen and pay attention to him."

# game/rutas/nulla.rpy:487
translate ingles rutanullaa_9863232a:

    # "Pues habla hasta por lo codos, sinceramente parece como si lo hubieran tenido bajo confinamiento hasta tu llegada."
    "He talks a lot, it honestly seems like he's been kept under confinement until your arrival."

# game/rutas/nulla.rpy:488
translate ingles rutanullaa_3c45d8cd:

    # "Al terminar de comer, Nulla hace desaparecer la bandeja mientras tu lo observas con impresión."
    "When you finish eating, Nulla makes the tray disappear while you watch in shock."

# game/rutas/nulla.rpy:490
translate ingles rutanullaa_08764b94:

    # nulla "Quattor está en su templo... pero no nos tenemos que apurar si no quieres."
    nulla "Quattor is in her temple... but we don't have to hurry if we don't want to."

# game/rutas/nulla.rpy:493
translate ingles rutanullaa_e066a4d0:

    # nulla "Tenemos todo el día. No hay prisa"
    nulla "We have all day. There is no rush."

# game/rutas/nulla.rpy:494
translate ingles rutanullaa_8fb367d0:

    # "Nulla se levanta de la cama y coloca ambas manos en su cadera."
    "Nulla gets out of bed and places both hands on his hips."

# game/rutas/nulla.rpy:497
translate ingles rutanullaa_d4d6d40a:

    # nulla "¿Qué quieres hacer ahora?"
    nulla "What do you want to do now?"

# game/rutas/nulla.rpy:504
translate ingles rutanullaa_4d9219a9:

    # "Le dices a Nulla que aún no quieres salir a por Quattor."
    "You tell Nulla that you don't want to go after Quattor yet."

# game/rutas/nulla.rpy:505
translate ingles rutanullaa_0f73ef40:

    # "Y Nulla lo entiende."
    "And Nulla understands."

# game/rutas/nulla.rpy:510
translate ingles rutanullaa_c4e12a3c:

    # "Consideras que ahora es un buen momento para decirle a Nulla que estás listo."
    "You think now is a good time to tell Nulla you're ready."

# game/rutas/nulla.rpy:511
translate ingles rutanullaa_010fcb08:

    # "Así que le comunicas a Nulla tu decisión."
    "So you tell Nulla your decision."

# game/rutas/nulla.rpy:512
translate ingles rutanullaa_e1711b6d:

    # nulla "Okay."
    nulla "Okay."

# game/rutas/nulla.rpy:513
translate ingles rutanullaa_28bedfdf:

    # nulla "Tendré que sellarnos para que pasemos desapercibidos."
    nulla "I'll have to seal us so that we go unnoticed."

# game/rutas/nulla.rpy:516
translate ingles rutanullaa_54d4aa64:

    # nulla "Estoy seguro que Septem ya ha avisado a los demás."
    nulla "I'm sure Septem has already warned the others."

# game/rutas/nulla.rpy:519
translate ingles rutanullaa_044ca03c:

    # "Nulla hace unas señas con sus manos y pronuncia en voz baja palabras que no logras entender."
    "Nulla makes signs with his hands and whispers words that you can't understand."

# game/rutas/nulla.rpy:520
translate ingles rutanullaa_910428f1:

    # nulla "Estamos listos."
    nulla "We are ready."

# game/rutas/nulla.rpy:522
translate ingles rutanullaa_8d7fb19d:

    # "Sin más son tragados por el portal que nace del suelo, ambos se ven rodeados de una negrura total."
    "Without further ado, the two of you are swallowed by the portal that rises from the ground, surrounded by total darkness."

# game/rutas/nulla.rpy:524
translate ingles rutanullaa_a20cefa7_6:

    # "..."
    "..."

# game/rutas/nulla.rpy:527
translate ingles rutanullaa_a66fefee:

    # "Cuando el vacío que los rodea se disipa, puedes apreciar que tu alrededor ha cambiado."
    "When the emptiness around you dissipates, you can see that your surroundings have changed."

# game/rutas/nulla.rpy:528
translate ingles rutanullaa_08838f23:

    # "Es de noche y están en la calle, hay gente pasando a tu alrededor y todos llevan máscaras similares."
    "It's night time and you're on the street. There are people walking around you and they're all wearing similar masks."

# game/rutas/nulla.rpy:529
translate ingles rutanullaa_ea6b9cd6:

    # "Te sobresaltas cuando uno de ellos camina en dirección a ustedes y parece no darse cuenta de ello."
    "You're startled when one of them walks towards you and doesn't seem to notice you."

# game/rutas/nulla.rpy:530
translate ingles rutanullaa_a9eb2a1f:

    # "Como si fueras nada, la entidad pasa a través de ti y Nulla."
    "As if you were nothing, the entity passes through you and Nulla."

# game/rutas/nulla.rpy:532
translate ingles rutanullaa_e1938c89:

    # nulla "No pasa nada, yo y la marioneta estamos sellados, por lo que no somos visibles para ellos."
    nulla "It's okay, the puppet and I are sealed, so we are not visible to them."

# game/rutas/nulla.rpy:534
translate ingles rutanullaa_51d5ec25:

    # "Nulla comienza a caminar por las calles y tu le sigues, caminan en silencio pues Nulla parece estar concentrado en algo."
    "Nulla starts walking through the streets and you follow him. You both walk in silence because Nulla seems to be focused on something."

# game/rutas/nulla.rpy:535
translate ingles rutanullaa_d29e00d6:

    # "De vez en cuando se detiene para observar su alrededor."
    "From time to time, he stops to look around."

# game/rutas/nulla.rpy:536
translate ingles rutanullaa_c4d12ee6:

    # "En esas pausas, decides mirar al cielo, buscando a la luna."
    "In those pauses, you decide to gaze up at the sky, searching for the moon."

# game/rutas/nulla.rpy:538
translate ingles rutanullaa_c525e5b4:

    # "Y ahí está, tan grande y majestuosa, iluminando las calles con su luz tenue."
    "And there it is, so big and majestic, illuminating the streets with its tender light."

# game/rutas/nulla.rpy:540
translate ingles rutanullaa_e045cca1:

    # "Luego miras a las entidades que siguen caminando por las calles, y te preguntas..."
    "Then you look at the entities still walking the streets, and you wonder..."

# game/rutas/nulla.rpy:541
translate ingles rutanullaa_b3b38b61:

    # "¿Qué pasará con ellos luego de que devores a los estandartes?"
    "What will happen to them after you devour the Symbols?"

# game/rutas/nulla.rpy:542
translate ingles rutanullaa_1abdd7b1:

    # nulla "Está escondida en su templo..."
    nulla "She is hidden in her temple..."

# game/rutas/nulla.rpy:544
translate ingles rutanullaa_35f10428:

    # nulla "Ya saben lo que está por venir."
    nulla "They know what's coming."

# game/rutas/nulla.rpy:545
translate ingles rutanullaa_31d60314:

    # "Observas a Nulla y te das cuenta que ahora se ve muy serio."
    "You look at Nulla and realize that he appears more serious now."

# game/rutas/nulla.rpy:546
translate ingles rutanullaa_ed6feda5:

    # "Un cambio completo a lo que ya estás acostumbrado."
    "A complete change from what you're already used to."

# game/rutas/nulla.rpy:547
translate ingles rutanullaa_0746c9d6:

    # "Tanto que no parece ser la misma persona."
    "So much so that he doesn't seem to be the same person."

# game/rutas/nulla.rpy:549
translate ingles rutanullaa_27879eef:

    # "Nuevamente son tragados por el portal que nace del suelo."
    "Once again you are swallowed by the portal that rises from the ground."

# game/rutas/nulla.rpy:551
translate ingles rutanullaa_25740524:

    # "Y reaparecen en lo que supones es el templo de Quattor, la construcción es imponente y bien acabada."
    "And you reappear in what you assume is the temple of Quattor: the construction is imposing and well made."

# game/rutas/nulla.rpy:552
translate ingles rutanullaa_521fe3a8:

    # "Al mirar al pico del templo, te das cuenta de que está diseñada con el proposito de enfocar a la luna y hacerla parte de su composición."
    "When you look at the peak of the temple, you realize that it is designed with the purpose of focusing on the moon and making it part of its composition."

# game/rutas/nulla.rpy:553
translate ingles rutanullaa_7b895fd9:

    # "Si te dijeran que este mundo está agonizando y en sus últimas, realmente no lo creerías."
    "If they told you that this world was suffering and on its last leg, really, you wouldn't believe it."

# game/rutas/nulla.rpy:555
translate ingles rutanullaa_df1ce28d:

    # nulla "No despeges tus ojos de mí, cariño."
    nulla "Don't take your eyes off me, cariño."

# game/rutas/nulla.rpy:558
translate ingles rutanullaa_d253a9af:

    # nulla "Cuando entremos al templo, necesito que busques un lugar seguro, pero apto para que tu puedas observarme."
    nulla "When we enter the temple, I need you to find a safe place, but suitable for you to look at me."

# game/rutas/nulla.rpy:559
translate ingles rutanullaa_67cef4f9:

    # nj "Está bien."
    nj "Alright."

# game/rutas/nulla.rpy:561
translate ingles rutanullaa_5a21689e:

    # "Caminan en dirección a las puertas del templo y entran."
    "You walk towards the doors of the temple and enter."

# game/rutas/nulla.rpy:563
translate ingles rutanullaa_5601f9fa:

    # "Al frente de ustedes, hay una figura arrodillada cerca del altar."
    "In front of you, there is a figure kneeling near the altar."

# game/rutas/nulla.rpy:564
translate ingles rutanullaa_59b3f2a3:

    # "Debe ser Quattor..."
    "This must be Quattor..."

# game/rutas/nulla.rpy:565
translate ingles rutanullaa_f1765ecf:

    # "Nulla desaparece por el portal, dejándote a solas."
    "Nulla disappears through the portal, leaving you on your own."

# game/rutas/nulla.rpy:575
translate ingles rutanullaa_81050e71:

    # "Escaneas el lugar pero nada te convence."
    "Your eyes scan the place but nothing calls out to you."

# game/rutas/nulla.rpy:576
translate ingles rutanullaa_ba9b22b4:

    # "Eso es hasta que ver el segundo piso... es un lugar con un amplio rango de visión, permitiendote además, ocultarte de lo que sea que suceda abajo."
    "That is until you see the second floor... it's a place with a wide range of vision, allowing you to hide from whatever is happening below."

# game/rutas/nulla.rpy:577
translate ingles rutanullaa_d306b312:

    # "Con mucho cuidado subes las escaleras hacia el segundo piso"
    "Carefully, you climb the stairs to the second floor."

# game/rutas/nulla.rpy:579
translate ingles rutanullaa_274c5fb9:

    # "Te colocas entremedio de las barandillas, y buscas a Nulla con la mirada."
    "You stand between the railings and search for Nulla with your eyes."

# game/rutas/nulla.rpy:581
translate ingles rutanullaa_d34adb3f:

    # "Él aparece nuevamente del suelo y te devuelve la mirada, mientras te hace una seña de guardar silencio."
    "He appears again from the ground and looks back at you, signing for you to remain silent."

# game/rutas/nulla.rpy:582
translate ingles rutanullaa_e707b1f4:

    # "Desenfunda su pistola."
    "He draws his gun."

# game/rutas/nulla.rpy:584
translate ingles rutanullaa_e81e5a66:

    # "Se prepara para disparar y..."
    "He prepares to shoot and..."

# game/rutas/nulla.rpy:589
translate ingles rutanullaa_e748e883:

    # "Otra figura aparece por el lateral de Nulla, impactando directamente sobre su cuerpo."
    "...Another figure appears from Nulla's side, directly impacting his body."

# game/rutas/nulla.rpy:591
translate ingles rutanullaa_2b114ecb:

    # "Sin esperar a que Nulla se pueda reincorporar, la figura materializa una guadaña que empuña hacia el cuello del pelinegro."
    "Without waiting for Nulla to get up, the figure materializes a scythe that they swing towards the black-haired man's neck."

# game/rutas/nulla.rpy:593
translate ingles rutanullaa_d719cd8f:

    # "Y sin mucha dificultad, corta la cabeza de Nulla."
    "And without much effort, they slice off Nulla's head."

# game/rutas/nulla.rpy:595
translate ingles rutanullaa_81e7a585:

    # "Se escuchan unas risas."
    "You hear some laughter."

# game/rutas/nulla.rpy:596
translate ingles rutanullaa_5f8723cc:

    # nj "Nulla!"
    nj "Nulla!"

# game/rutas/nulla.rpy:598
translate ingles rutanullaa_daefb755:

    # "Tu grito llama la atención de la entidad que le ha cortado la cabeza a Nulla mientras la otra se levanta del altar para caminar alrededor del cuerpo de Nulla."
    "Your scream draws the attention of the entity that has severed Nulla's head as the other rises from the altar to walk around his body."

# game/rutas/nulla.rpy:599
translate ingles rutanullaa_5fd24ed1:

    # "Despegas tu mirada del cuerpo de Nulla para ver como la entidad se eleva lentamente sobre el suelo, como si flotase."
    "You take your gaze off Nulla's body to see how the entity slowly rises above the ground, as if floating."

# game/rutas/nulla.rpy:600
translate ingles rutanullaa_2419fa87:

    # "Viene hacia ti."
    "It's coming towards you."

# game/rutas/nulla.rpy:601
translate ingles rutanullaa_69d0e1a4:

    # "La entidad se posa a tu lado y te observa"
    "The entity lands beside you and observes."

# game/rutas/nulla.rpy:602
translate ingles rutanullaa_495dbd54:

    # el "Septem, he econtrado lo que buscas."
    el "Septem, I have found what you seek."

# game/rutas/nulla.rpy:604
translate ingles rutanullaa_0da39241:

    # "Sin decir más la entidad te agarra de la ropa y te lanza al primer piso."
    "Without saying more, the entity grabs you by your clothes and throws you to the first floor."

# game/rutas/nulla.rpy:605
translate ingles rutanullaa_c54c490a:

    # "Antes de impactar en el suelo, una fuerza invisible te atrapa y te deja delicadamente en el piso."
    "Before hitting the ground, an invisible force catches you and gently places you on it instead."

# game/rutas/nulla.rpy:606
translate ingles rutanullaa_e5075332:

    # "{glitch=20.0}{color=ffffff}{b}No dejes de mirarme{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Don't stop looking at me.{/glitch}"

# game/rutas/nulla.rpy:607
translate ingles rutanullaa_6b465487:

    # "Esa es la voz de Nulla..."
    "That's Nulla voice..."

# game/rutas/nulla.rpy:608
translate ingles rutanullaa_d15bb69e:

    # "Posas tus ojos en el cuerpo de Nulla, el cual a pesar de ya no tener la cabeza, se levanta y toma desprevenida al estandarte de la luna."
    "You focus your gaze on Nulla's body, which, despite no longer having a head, rises and catches the Symbol of the moon off guard."

# game/rutas/nulla.rpy:610
translate ingles rutanullaa_87ef5e19:

    # "Un sentenar de manos salen del suelo y agarran por las extremidades a Quattor."
    "A hundred hands emerge from the ground and grab Quattor by the limbs."

# game/rutas/nulla.rpy:611
translate ingles rutanullaa_ec084438:

    # "Sometiéndola ante Nulla."
    "Submitting her before Nulla."

# game/rutas/nulla.rpy:613
translate ingles rutanullaa_b594941d:

    # "La mujer grita cuando Nulla atraviesa su pecho con fuerza."
    "The woman screams as Nulla forcefully pierces her chest."

# game/rutas/nulla.rpy:614
translate ingles rutanullaa_a6520ad1:

    # "Para cuando la entidad de ropas rojas se da cuenta de que algo le pasa a su compañera, ya es demasiado tarde."
    "By the time the entity in red clothing realizes that something is happening to her companion, it is already too late."

# game/rutas/nulla.rpy:616
translate ingles rutanullaa_63ebb0bd:

    # "Pues Nulla tiene en sus manos algo que se asemeja a un corazón."
    "For Nulla holds in his hands something that resembles a heart."

# game/rutas/nulla.rpy:617
translate ingles rutanullaa_5b682912:

    # "Y Quattor comienza a desintegrarse de a poco."
    "And Quattor begins to disintegrate little by little."

# game/rutas/nulla.rpy:618
translate ingles rutanullaa_4de02e49:

    # "La entidad es agarrada por las mismas manos que han sometido a Quattor."
    "The entity is grabbed by the same hands that have subdued Quattor."

# game/rutas/nulla.rpy:619
translate ingles rutanullaa_f2876658:

    # el "Desgraciado."
    el "Wretch."

# game/rutas/nulla.rpy:620
translate ingles rutanullaa_61eb07e0:

    # "Nulla se toma el tiempo al caminar hacia ustedes, en el proceso, su cabeza se regenera a partir del mismo compuesto que están hechas las manos."
    "Nulla takes his time walking towards you, and in the process, his head regenerates from the same substance that the hands are made of."

# game/rutas/nulla.rpy:621
translate ingles rutanullaa_6cee03b9:

    # "Pero sus rasgos no lo hacen."
    "But his features do not."

# game/rutas/nulla.rpy:623
translate ingles rutanullaa_f3ce4dde:

    # nulla "Duae."
    nulla "Duae."

# game/rutas/nulla.rpy:624
translate ingles rutanullaa_3a73365a:

    # nulla "No pensé que estarías aquí..."
    nulla "I didn't think you would be here..."

# game/rutas/nulla.rpy:625
translate ingles rutanullaa_7fa2f11b:

    # nulla "Eres presa facil cuando estás acompañada, te confías mucho..."
    nulla "You are an easy prey when you're accompanied; you trust too much..."

# game/rutas/nulla.rpy:626
translate ingles rutanullaa_4a9dac8a:

    # nulla "Bueno, no queda de otra que adelantar trabajo."
    nulla "Well, there's no choice but to go ahead with the work."

# game/rutas/nulla.rpy:628
translate ingles rutanullaa_a6850344:

    # "Dicho aquello, una mano proveniente del portal atraviesa el pecho de Duae."
    "That said, a hand rises from the portal and pierces Duae's chest."

# game/rutas/nulla.rpy:629
translate ingles rutanullaa_a20cefa7_7:

    # "..."
    "..."

# game/rutas/nulla.rpy:634
translate ingles rutanullaa_9b1ea239:

    # nulla "No es que a mí me agrade mucho hacerlo."
    nulla "It's not that I particularly enjoy doing this."

# game/rutas/nulla.rpy:637
translate ingles rutanullaa_833ece13:

    # nulla "Pero no hay otra opción."
    nulla "But there is no other option."

# game/rutas/nulla.rpy:641
translate ingles rutanullaa_eb95c801:

    # nulla "Hmm?, ah sí."
    nulla "Hmm? Oh, yes."

# game/rutas/nulla.rpy:644
translate ingles rutanullaa_b47b8c99:

    # nulla "Antiguamente ella fue mi aprendíz..."
    nulla "Long ago, she was my apprentice..."

# game/rutas/nulla.rpy:645
translate ingles rutanullaa_287f66ca:

    # nulla "Le enseñé casi todo lo que sé."
    nulla "I taught her almost everything I know."

# game/rutas/nulla.rpy:646
translate ingles rutanullaa_b5fac823:

    # nulla "Por lo que los sellos no funcionan con ella."
    nulla "Which is why the seals don't work on her."

# game/rutas/nulla.rpy:650
translate ingles rutanullaa_07c9aa64:

    # nulla "No."
    nulla "No."

# game/rutas/nulla.rpy:654
translate ingles rutanullaa_6d2e30f0:

    # nulla "Ah, esto."
    nulla "Ah, this."

# game/rutas/nulla.rpy:655
translate ingles rutanullaa_8cc74548:

    # nulla "Se arreglará dentro de un rato."
    nulla "It will be fixed in a little while."

# game/rutas/nulla.rpy:658
translate ingles rutanullaa_0742d489:

    # nulla "Piensa en mi como una cebolla."
    nulla "Think of me as an onion."

# game/rutas/nulla.rpy:659
translate ingles rutanullaa_e3b9ae94:

    # nulla "Cada capa es una vida distinta."
    nulla "Each layer is a different life."

# game/rutas/nulla.rpy:660
translate ingles rutanullaa_92d38e42:

    # nulla "Mientras más capas pierda, más recuerdos e identidades pierdo."
    nulla "The more layers I lose, the more memories and identities I'll lose."

# game/rutas/nulla.rpy:664
