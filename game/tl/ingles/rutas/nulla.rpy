translate ingles null_f11952f7:

    # "Mientras ambos caminan, sientes como una presencia les sigue, pero cada vez que volteas no ves nada..."
    "As you both walk, you feel a presence following you, but every time you turn around, you see nothing..."

# game/rutas/nulla.rpy:806
translate ingles null_b51d46b7:

