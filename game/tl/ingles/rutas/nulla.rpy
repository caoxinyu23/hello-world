# game/rutas/nulla.rpy:818
translate ingles null_26bbcbeb:

    # "Llegan a un callejón y estás seguro de que Nulla no es consciente de por donde camina ni a qué dirección va."
    "You two reach an alley, and you are sure that Nulla is unaware of where he is walking or which direction he is going."

# TODO: Translation updated at 2024-09-24 23:31

# game/rutas/nulla.rpy:27
translate ingles rutanullaa_5b9d4ce1:

    # nulla "{glitch=20.0}{color=ffffff}{b}Lástima que no tengo mucha energía por ahora...{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}Too bad I don't have much energy right now...{/glitch}"

# game/rutas/nulla.rpy:39
translate ingles rutanullaa_12b1a00f:

    # nulla "{glitch=20.0}{color=ffffff}{b}Tu presencia es adictiva, la atención que me das también lo es...{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}Your presence is addictive; the attention you give me is, too...{/glitch}"

# game/rutas/nulla.rpy:46
translate ingles rutanullaa_4f908bc8:

    # nulla "{glitch=20.0}{color=ffffff}{b}Pero esos dos también te roban por momentos.{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}But those two can steal you away.{/glitch}"

# game/rutas/nulla.rpy:81
translate ingles rutanullaa_5607e8a8:

    # nulla "Lo siento mucho, pero aquí nos regimos por las palabras. Y se ha solicitado mi presencia."
    nulla "I'm very sorry, but here we are governed by words. And my presence has been requested."

# game/rutas/nulla.rpy:103
translate ingles rutanullaa_c1600d56:

    # "Te enredas en sus extremidades, manos y brazos en su cuello, cabeza en el hombro y piernas cruzadas en su tronco inferior.."
    "You entangle yourself with him, hands and arms around his neck, your head on his shoulder, and your legs crossed around his lower torso."

# game/rutas/nulla.rpy:175
translate ingles rutanullaa_05c9a394:

    # nulla "Sería una pérdida de tiempo."
    nulla "It would be a waste of time."

# game/rutas/nulla.rpy:176
translate ingles rutanullaa_0fb47b51:

    # nulla "Y por lo que tengo entendido tú no estás aquí por ese motivo... o al menos no es el objetivo principal."
    nulla "And from what I understand, you're not here for that reason... or at least that's not the main objective."

# game/rutas/nulla.rpy:178
translate ingles rutanullaa_045b474c:

    # nulla "Después de todo, te has descargado este juego pues se anuncia como una novela visual donde se puede encontrar personajes... mmm como decirlo, con una idea algo perturbada del amor."
    nulla "After all, you downloaded this game because it's advertised as a visual novel where you can find characters... hmm, how should I put it, with a somewhat disturbed idea of love."

# game/rutas/nulla.rpy:217
translate ingles rutanullaa_af846e32:

    # nulla "Después de todo, no soy quien para darte ordenes..."
    nulla "After all, I'm not the one to give you orders..."

# game/rutas/nulla.rpy:224
translate ingles rutanullaa_5d3abff1:

    # "Pues sinceramente, dudas que solo sea tu compañía y tu atención lo que busca."
    "Well, honestly, you doubt that it's just your company and attention that he's looking for."

# game/rutas/nulla.rpy:302
translate ingles rutanullaa_4a086b31:

    # nulla "Obligándonos a vivir en una agonía constante... donde nadie puede morir, y para mitigar tal agonía debemos buscar recursos de otros mundos que también fueron descuidados por el creador."
    nulla "Forcing us to live in a constant agony... where no one can die, and to mitigate such agony, we must seek resources from other worlds that were also neglected by the Creator."

# game/rutas/nulla.rpy:306
translate ingles rutanullaa_36275f5e:

    # nulla "Pero para no agotar tan rápido estos recursos, Madre recurre a los placebos."
    nulla "But in order not to exhaust these resources so quickly, Mother resorts to creating placebos."

# game/rutas/nulla.rpy:361
translate ingles rutanullaa_8c7a4913:

    # nulla "Nosotros no existíamos hasta que tú nos has encontrado."
    nulla "We didn't exist until you found us."

# game/rutas/nulla.rpy:416
translate ingles rutanullaa_c7996c64:

    # "Aceptas sacudiendo lentamente su mano. Y Nulla no hace más que sonreír."
    "You accept, slowly shaking his hand. And Nulla simply smiles."

# game/rutas/nulla.rpy:467
translate ingles rutanullaa_96af90de:

    # "Te metes debajo de las sábanas y te acomodas en posición para dormir. Nulla te mira con una media sonrisa, y pareciera que quiere hacer algo más."
    "You slip under the sheets and settle into a sleeping position. Nulla looks at you with a half-smile, and it seems like he wants to do something more."

# game/rutas/nulla.rpy:477
translate ingles rutanullaa_f09c9976:

    # "Te quedas ahí, pestañeando lentamente mientras recuerdas todo lo ocurrido."
    "You stay there, blinking slowly as you remember everything that happened."

# game/rutas/nulla.rpy:482
translate ingles rutanullaa_cff4b8fc:

    # "Antes de pasarte la bandeja, Nulla espera que te sientes para dejalar en tus manos."
    "Nulla waits for you to sit down so he can place the tray in your hands."

# game/rutas/nulla.rpy:487
translate ingles rutanullaa_f8246d0e:

    # "Pues habla hasta por los codos, sinceramente parece como si lo hubieran tenido bajo confinamiento hasta tu llegada."
    "He talks a lot: It sincerely seems as if he's been kept in confinement until your arrival."

# game/rutas/nulla.rpy:516
translate ingles rutanullaa_03a2e174:

    # nulla "Estoy seguro de que Septem ya ha avisado a los demás."
    nulla "I'm sure Septem has already informed the others."

# game/rutas/nulla.rpy:534
translate ingles rutanullaa_1a6742c1:

    # "Nulla comienza a caminar por las calles y tú le sigues, caminan en silencio pues Nulla parece estar concentrado en algo."
    "Nulla starts walking through the streets and you follow him. You both walk in silence because Nulla seems to be focused on something."

# game/rutas/nulla.rpy:552
translate ingles rutanullaa_494134d6:

    # "Al mirar al pico del templo, te das cuenta de que está diseñada con el propósito de enfocar a la luna y hacerla parte de su composición."
    "As you look at the peak of the temple, you realize it is designed to focus on the moon and make it part of its composition."

# game/rutas/nulla.rpy:576
translate ingles rutanullaa_501e4ccb:

    # "Eso es hasta que ver el segundo piso... es un lugar con un amplio rango de visión, permitiéndote además, ocultarte de lo que sea que suceda abajo."
    "That is until you see the second floor... it's a place with a wide range of vision, allowing you to hide from whatever happens below."

# game/rutas/nulla.rpy:602
translate ingles rutanullaa_decba83e:

    # el "Septem, he encontrado lo que buscas."
    el "Septem, I've found what you're looking for."

# game/rutas/nulla.rpy:694
translate ingles rutanullaa_e521235a:

    # "Y rápidamente empuja ambas esferas dentro."
    "And he quickly pushes both spheres into your mouth."

# TODO: Translation updated at 2024-09-29 21:53

# game/rutas/nulla.rpy:482
translate ingles rutanullaa_6e73ac45:

    # "Antes de pasarte la bandeja, Nulla espera que te sientes para dejarla en tus manos."
    "Nulla waits for you to sit down so he can place the tray in your hands."

# TODO: Translation updated at 2025-02-22 21:37

# game/rutas/nulla.rpy:75
translate ingles rutanullaa_f012cccd:

    # "Mientras Unum ríe, Septem tiene un semblante serio."
    "While Unum laughs, Septem has a serious expression."

# game/rutas/nulla.rpy:297
translate ingles rutanullaa_292dbffa:

    # nulla "{b}Un lugar desechable luego de terminar de jugarlo{b}.... para ti."
    nulla "{b}A disposable place once you're done playing it{b}... for you."

# game/rutas/nulla.rpy:625
translate ingles rutanullaa_e0f52040:

    # nulla "Eres presa fácil cuando estás acompañada, te confías mucho..."
    nulla "You're an easy target when you're accompanied; you trust too easily..."

# game/rutas/nulla.rpy:700
translate ingles rutanullaa_9a4a431b:

    # nulla "Ahh a la mierda."
    nulla "Ahh, to hell with it."

# game/rutas/nulla.rpy:710
translate ingles rutanullaa_aaf1f038:

    # "Nulla se tambalea un poco y te mira directamente a los ojos con una expresión complicada."
    "Nulla staggers slightly and looks you straight in the eyes with a complicated expression."

# game/rutas/nulla.rpy:711
translate ingles rutanullaa_2a42c54d:

    # nulla "¿Puedes esperarme un poco?"
    nulla "Can you wait for me a bit?"

# game/rutas/nulla.rpy:712
translate ingles rutanullaa_93554086:

    # "Dice Nulla luego de alejarse de ti. Se está tocando la cabeza como si algo le molestase."
    "Nulla says this after moving away from you. He touches his head as if something were bothering him."

# game/rutas/nulla.rpy:721
translate ingles rutanullaa_59c02290:

    # nulla "Solo será un momento, te lo prometo."
    nulla "It'll only be a moment, I promise."

# game/rutas/nulla.rpy:722
translate ingles rutanullaa_0eb06432_1:

    # nj "..."
    nj "..."

# game/rutas/nulla.rpy:726
translate ingles rutanullaa_1e82a88f:

    # nulla "Necesito calibrar mis sentidos."
    nulla "I need to calibrate my senses."

# game/rutas/nulla.rpy:727
translate ingles rutanullaa_634f344a:

    # nj "¿Qué?"
    nj "What?"

# game/rutas/nulla.rpy:730
translate ingles rutanullaa_56055f1f:

    # nulla "Les que quitado la potestad a Quattor y a Duae."
    nulla "I've stripped Quattor and Duae of their power."

# game/rutas/nulla.rpy:731
translate ingles rutanullaa_a9fade5d:

    # nulla "Y me está costando un poco mantener mi cuerpo estable..."
    nulla "And I'm having a hard time keeping my body steady..."

# game/rutas/nulla.rpy:733
translate ingles rutanullaa_3f20b6a7:

    # "Nulla se tambalea un poco mientras intenta caminar en dirección a la puerta del templo que lleva a la salida."
    "Nulla staggers slightly as he tries to walk toward the temple door leading to the exit."

# game/rutas/nulla.rpy:734
translate ingles rutanullaa_5ddbfa94:

    # "Y tú le sigues de cerca."
    "And you follow him closely."

# game/rutas/nulla.rpy:736
translate ingles rutanullaa_19a8a10f:

    # nulla "Casi se me olvida que cualquiera que sea lo suficientemente fuerte, puede tomar el título de un Estandarte."
    nulla "I almost forgot that anyone strong enough can claim the title of a Symbol."

# game/rutas/nulla.rpy:739
translate ingles rutanullaa_9f400c7a:

    # nulla "En la época donde estaba el Creador, él puso un serie de reglas... tontas pero al fin y al cabo reglas para mantener al jardín estable."
    nulla "Back when the Creator was around, a series of rules were established... silly ones, but rules nonetheless to keep the Garden stable."

# game/rutas/nulla.rpy:740
translate ingles rutanullaa_391002f7:

    # nulla "Y se preguntó... ¿Qué pasaría si algún estandarte no está haciendo bien su trabajo?"
    nulla "And he wondered... What would happen if a Symbol wasn't doing its job properly?"

# game/rutas/nulla.rpy:743
translate ingles rutanullaa_94c50a93:

    # nulla "¡Simple! hay que reemplazarlo."
    nulla "Simple! You just have to replace it."

# game/rutas/nulla.rpy:746
translate ingles rutanullaa_409f8636_5:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:749
translate ingles rutanullaa_233307bd:

    # nulla "Ja- Nuevamente estoy haciendo infodumping de algo que ya no importa... No tengo arreglo, realmente no puedo dejar de hacerlo."
    nulla "Ja--once again, I'm infodumping on something that no longer matters... I just can't help it, I really can't stop."

# game/rutas/nulla.rpy:752
translate ingles rutanullaa_c7857491:

    # nulla "Disculpa."
    nulla "Sorry."

# game/rutas/nulla.rpy:757
translate ingles rutanullaa_409f8636_6:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:760
translate ingles rutanullaa_771cf3a0:

    # nulla "¿En serio?"
    nulla "Really?"

# game/rutas/nulla.rpy:761
translate ingles rutanullaa_1f5d9c14:

    # nj "Sí."
    nj "Yes."

# game/rutas/nulla.rpy:764
translate ingles rutanullaa_15779771:

    # nulla "Está bien. Quiero que entiendas de manera rápida, para que luego no tengamos mal entendidos."
    nulla "Alright. I want you to understand quickly so that we don't have any misunderstandings later."

# game/rutas/nulla.rpy:767
translate ingles rutanullaa_abd6b5b6:

    # nulla "Cualquiera puede tomar el título de Estandarte si es que el mundo no está en pausa... entonces, los Estandartes también se pueden matar entre sí, y obtener así más dominios a su poder."
    nulla "Anyone can claim the title of a Symbol if the world isn't paused... which means Symbols can also kill each other, thereby gaining more domains to their power."

# game/rutas/nulla.rpy:768
translate ingles rutanullaa_36b0876d:

    # nulla "Pero, como cada estandarte está ligado a un concepto del jardín, de los cuales deben mantener en la mejor de sus condiciones, utilizando su energía propia."
    nulla "But, each Symbol is tied to a Garden concept that must be kept in optimal condition using their own energy."

# game/rutas/nulla.rpy:771
translate ingles rutanullaa_f87e5288:

    # nulla "Por lo que a ninguno se les ha pasado por la cabeza asesinar al otro, pues sería más difícil mantener dos conceptos."
    nulla "So, none of them have ever thought about killing one another, since it would be much harder to maintain two concepts."

# game/rutas/nulla.rpy:774
translate ingles rutanullaa_7713350b:

    # nulla "Ahora mismo yo tengo a la merced el concepto de la luna y las estrellas."
    nulla "Right now, I have the concept of the moon and the stars at my mercy."

# game/rutas/nulla.rpy:775
translate ingles rutanullaa_8a5a3ad7:

    # nulla "Y puedo hacer lo que quiera con ellas."
    nulla "And I can do whatever I want with them."

# game/rutas/nulla.rpy:776
translate ingles rutanullaa_bb22a121:

    # "No te gusta lo que está insinuando."
    "You don't like what he's implying."

# game/rutas/nulla.rpy:782
translate ingles rutanullaa_1a5ea0fd:

    # nulla "... está bien."
    nulla "... Alright."

# game/rutas/nulla.rpy:783
translate ingles rutanullaa_7f3b0720:

    # nulla "No tienes porqué leer todo lo que digo."
    nulla "You don't have to read everything I say."

# game/rutas/nulla.rpy:787
translate ingles rutanullaa_fed4f4ce:

    # "Nulla intenta abrir la puerta del templo pero se cae antes de poder tocar el pomo."
    "Nulla tries to open the temple door but falls before he can reach the doorknob."

# game/rutas/nulla.rpy:788
translate ingles rutanullaa_a37ca3b9:

    # "Y tú, viendo el estado precario en que él se encuentra, corres a socorrerlo."
    "And you, seeing how precarious his condition is, run to help him."

# game/rutas/nulla.rpy:790
translate ingles rutanullaa_07c111de:

    # "Te agachas y lo levantas... y te das cuenta de que es increíblemente ligero."
    "You bend down and lift him up... and you realize that he is incredibly light."

# game/rutas/nulla.rpy:792
translate ingles rutanullaa_d3387e86:

    # nulla "Gracias."
    nulla "Thank you."

# game/rutas/nulla.rpy:801
translate ingles rutanullaa_3c619be3:

    # "Ambos toman el pomo de la puerta y empujan."
    "You both grab the doorknob and push."

# game/rutas/nulla.rpy:805
translate ingles rutanullaa_8ed28db7:

    # "El escenario que te encuentras afuera es uno totalmente diferente al que anteriormente has visto."
    "The setting outside is one that's completely different from what you've seen before."

# game/rutas/nulla.rpy:807
translate ingles rutanullaa_7826541a:

    # "Ese lugar con una tenue luz morada que cubría todo el paisaje ya no existe, ahora es solo un lugar vacío."
    "That place, once bathed in a faint purple light that covered the entire landscape, no longer exists; now it's just an empty space."

# game/rutas/nulla.rpy:808
translate ingles rutanullaa_3c70859f:

    # "Rodeado de blanco y negro."
    "Surrounded by black and white."

# game/rutas/nulla.rpy:809
translate ingles rutanullaa_0eb06432_2:

    # nj "..."
    nj "..."

# game/rutas/nulla.rpy:810
translate ingles rutanullaa_a5107048:

    # "Es ahora donde te das cuenta de las consecuencias de la misión de Nulla."
    "It's now that you realize the consequences of Nulla's mission."

# game/rutas/nulla.rpy:811
translate ingles rutanullaa_5dac192b:

    # "Todo volverá a ser nada."
    "Everything will go back to nothing."

# game/rutas/nulla.rpy:812
translate ingles rutanullaa_a8708d65:

    # "Todo será devorado por el vacío."
    "Everything will be devoured by the Void."

# game/rutas/nulla.rpy:814
translate ingles rutanullaa_b58cf5e8:

    # "Miras detrás tuyo, buscando inútilmente a la luna... no hay nada allá arriba ni tampoco ahora hay rastro del templo de Quattor."
    "You look behind you, searching in vain for the moon... there's nothing up there and now, not even a trace of the Quattor temple."

# game/rutas/nulla.rpy:815
translate ingles rutanullaa_18b07ae5:

    # "Y estás seguro que todas las entidades bajo el comando de las antiguas Estandartes ya se encuentran desaparecidas... o en proceso de."
    "And you're sure that all the entities under the command of the Symbols of the moon and stars have either vanished or are in the process of doing so."

# game/rutas/nulla.rpy:817
translate ingles rutanullaa_f8a30967:

    # "Caminas apoyando a Nulla, quien todavía presenta dificultades para tener balance."
    "You walk while supporting Nulla, who is still having trouble keeping his balance."

# game/rutas/nulla.rpy:818
translate ingles rutanullaa_6acd609e:

    # "Pero no te importa. Nulla no pesa nada y... de esta manera puedes estar cerca de él, hasta el punto de poder sentir la colonia que lleva en su cuerpo."
    "But you don't mind. Nulla weighs nothing, and this way, you can be close enough to catch the scent of his cologne."

# game/rutas/nulla.rpy:819
translate ingles rutanullaa_0d31e411:

    # "Es agradable."
    "It's pleasant."

# game/rutas/nulla.rpy:821
translate ingles rutanullaa_5a9706c9:

    # nulla "Esto tomará un poco. Comer dos dominios a la vez es una tarea difícil."
    nulla "This will take a while. Consuming two domains at once is a difficult task."

# game/rutas/nulla.rpy:822
translate ingles rutanullaa_a88a26e0:

    # nj "¿Te los estás comiendo?"
    nj "Are you eating them?"

# game/rutas/nulla.rpy:823
translate ingles rutanullaa_340bb2c6:

    # nulla "Su energía, sí."
    nulla "Their energy, yes."

# game/rutas/nulla.rpy:824
translate ingles rutanullaa_2dafe537:

    # nulla "Toda la energía puesta en la creación de cada dominio y cada entidad dentro de estos, así como también las memorias de este...."
    nulla "All the energy invested in the creation of each domain and every entity within them, as well as the memories tied to it...."

# game/rutas/nulla.rpy:826
translate ingles rutanullaa_4856ba9b:

    # "Nulla suspira apenado. No parece hacerle mucha gracia lo que está haciendo."
    "Nulla lets out a hesitant sigh. He doesn't seem too pleased with what he's doing."

# game/rutas/nulla.rpy:827
translate ingles rutanullaa_1057b585:

    # "Al menos no se lo toma de forma irrespetuosa, no hay ningún comentario mal intencionado o algún rastro de risa."
    "At least he doesn't take it in a disrespectful way; there's no ill-intentioned remark or hint of laughter."

# game/rutas/nulla.rpy:828
translate ingles rutanullaa_4cb155e4:

    # "Tienes que darle un punto."
    "You have to give him credit."

# game/rutas/nulla.rpy:830
translate ingles rutanullaa_a20cefa7_9:

    # "..."
    "..."

# game/rutas/nulla.rpy:831
translate ingles rutanullaa_ea375cac:

    # "Caminan por las calles vacías sin algún tipo de conversación que acompañe el ambiente lugubre del recorrido. Nulla ha estado callado y cabizbajo por un largo período de tiempo."
    "You walk together through the empty streets, silence lingering in the air, matching the somber mood of the journey. Nulla has remained quiet and downcast for quite some time."

# game/rutas/nulla.rpy:833
translate ingles rutanullaa_2220f377:

    # nulla "Duae estuvo genial..."
    nulla "Duae was great..."

# game/rutas/nulla.rpy:834
translate ingles rutanullaa_e8715fdc:

    # "Por tu mente pasa un pensamiento... {i} si era tan genial, ¿entonces por qué la has matado?{/i}"
    "A thought crosses your mind... {i}'if she was so great, then why did you kill her?'{/i}"

# game/rutas/nulla.rpy:835
translate ingles rutanullaa_3a441b99:

    # "Pero supones que es lo que tiene que hacer para obtener lo que quiere. Así que no emites comentario alguno."
    "But you assume this is what he must do to get what he wants. So you keep silent."

# game/rutas/nulla.rpy:836
translate ingles rutanullaa_3a3d0d13:

    # nulla "Hace mucho tiempo que no la veía."
    nulla "I haven't seen her in a long time."

# game/rutas/nulla.rpy:838
translate ingles rutanullaa_1c9a263a:

    # "Por el rabillo del ojo ves como Nulla coloca una de sus manos en su cabeza y solloza."
    "Out of the corner of your eye, you see Nulla place one of his hands on his head and sob."

# game/rutas/nulla.rpy:839
translate ingles rutanullaa_e7537c2a:

    # nulla "Lo siento [nombrejugador], te dejaré por un momento."
    nulla "I'm sorry, [nombrejugador], I'll leave you for a moment."

# game/rutas/nulla.rpy:841
translate ingles rutanullaa_8f7d386d:

    # "Y es así, como ambos son tragados por el portal que los lleva al vacío."
    "And so, both of you are swallowed by the portal that carries you into the Void."

# game/rutas/nulla.rpy:843
translate ingles rutanullaa_2f9851e2:

    # "Mientras están ahí, Nulla no te mira. Oculta sus ojos de tu mirada y te evita con la cara."
    "While you're there, Nulla doesn't look at you. He hides his eyes from your gaze and turns his face away."

# game/rutas/nulla.rpy:844
translate ingles rutanullaa_9a1320b1:

    # "... y eso hace que te sientas mal por él."
    "... And that makes you feel sorry for him."

# game/rutas/nulla.rpy:845
translate ingles rutanullaa_9cdb2ad5:

    # "Cuando sientes que tocas el suelo, todo pasa muy rápido."
    "When you feel yourself touching the ground, everything happens very quickly."

# game/rutas/nulla.rpy:848
translate ingles rutanullaa_c6480566:

    # "Nulla te deja en la habitación de su casa y se despide de ti, deseándote dulces sueños."
    "Nulla leaves you in his room and bids you farewell, wishing you sweet dreams."

# game/rutas/nulla.rpy:849
translate ingles rutanullaa_859d3834:

    # "Apaga la luz y cierra la puerta de la habitación."
    "Turns off the light and closes the room's door."

# game/rutas/nulla.rpy:850
translate ingles rutanullaa_a20cefa7_10:

    # "..."
    "..."

# game/rutas/nulla.rpy:851
translate ingles rutanullaa_7d2957a9:

    # "Sin saber que está pasando, se sientas en la cama."
    "Unaware of what's happening, you sit on the bed."

# game/rutas/nulla.rpy:852
translate ingles rutanullaa_b948c955:

    # "Y esperas..."
    "And you wait..."

# game/rutas/nulla.rpy:853
translate ingles rutanullaa_15355494:

    # "No sabes cuanto tiempo has estado sentado en la cama."
    "You don't know how long you've been sitting on the bed."

# game/rutas/nulla.rpy:854
translate ingles rutanullaa_ab8ac23c:

    # "Pero supones que ha sido uno largo, pues los huesos te comienzan a molestar."
    "But you assume it's been a long time, as your bones start to ache."

# game/rutas/nulla.rpy:855
translate ingles rutanullaa_fe01bfc9:

    # "Supones que te debes preparar mentalmente para dormir..."
    "You suppose you need to mentally prepare for sleep..."

# game/rutas/nulla.rpy:856
translate ingles rutanullaa_a20cefa7_11:

    # "..."
    "..."

# game/rutas/nulla.rpy:857
translate ingles rutanullaa_d0ac6549:

    # "Pero..."
    "But..."

# game/rutas/nulla.rpy:860
translate ingles rutanullaa_a20cefa7_12:

    # "..."
    "..."

# game/rutas/nulla.rpy:864
translate ingles rutanullaa_62930489:

    # "No puedes evitarlo."
    "You can't help it."

# game/rutas/nulla.rpy:865
translate ingles rutanullaa_005e8638:

    # "Quieres ir a ver que es lo que pasa con Nulla."
    "You want to go see what's happening with Nulla."

# game/rutas/nulla.rpy:866
translate ingles rutanullaa_ed22189f:

    # "Así que te levantas de la cama y partes camino al primer piso."
    "So you get out of bed and head toward the first floor."

# game/rutas/nulla.rpy:867
translate ingles rutanullaa_a1050169:

    # "Si Nulla no quiere que lo encuentres, no te dejará siquiera salir."
    "If Nulla doesn't want you to find him, he won't even let you leave."

# game/rutas/nulla.rpy:868
translate ingles rutanullaa_627fdc33:

    # "Por lo que cuando intentas abrir la puerta y lo logras con solo girar la manilla, sabes que Nulla te está dejando ir a por él."
    "So when you try to open the door and manage it by simply turning the knob, you know that Nulla is letting you go after him."

# game/rutas/nulla.rpy:870
translate ingles rutanullaa_d257a737:

    # "O tal vez no se ha dado cuenta... cosa que es poco probable."
    "Or maybe he hasn't realized... which is unlikely."

# game/rutas/nulla.rpy:871
translate ingles rutanullaa_bec8374f:

    # "Bajas con cuidado las escaleras, te da miedo no pisar bien debido a la falta de luz que hay en el pasillo y por consecuencia, en las escaleras."
    "You carefully descend the stairs, afraid of misstepping due to the lack of light in the hallway and, consequently, on the stairs."

# game/rutas/nulla.rpy:873
translate ingles rutanullaa_7615929e:

    # "Cuando llegas al último escalón escuchas un estruendo."
    "When you reach the last step, you hear a crash."

# game/rutas/nulla.rpy:875
translate ingles rutanullaa_d6b13ebb:

    # "Se escucha algo caer y romperse, el ruido es muy parecido a vidrios estallando y chocando contra el suelo."
    "You hear something fall and shatter; the sound is very much like glass exploding and crashing onto the floor."

# game/rutas/nulla.rpy:876
translate ingles rutanullaa_49d61ba9:

    # nulla "¡Mierda!"
    nulla "Shit!"

# game/rutas/nulla.rpy:877
translate ingles rutanullaa_b09a1e3c:

    # "Su voz se origina en la cocina. Te acercas al lugar con algo de apuro."
    "His voice comes from the kitchen. You rush towards the area."

# game/rutas/nulla.rpy:879
translate ingles rutanullaa_d4659345:

    # "Y ahí está él, sentado en la mesa... ha estado bebiendo."
    "And there he is, sitting at the table... he's been drinking."

# game/rutas/nulla.rpy:882
translate ingles rutanullaa_cc2dee24:

    # "Se ve fatal."
    "He looks awful."

# game/rutas/nulla.rpy:885
translate ingles rutanullaa_2b18aa85:

    # nulla "Debí suponer que ibas a venir, ja ja."
    nulla "I should have guessed you'd come, ja ja."

# game/rutas/nulla.rpy:886
translate ingles rutanullaa_46560092:

    # nulla "Después de todo esa opción maldita es la única interesante de las dos que te han dado."
    nulla "After all, that damned option is the only interesting one of the two you've been given."

# game/rutas/nulla.rpy:887
translate ingles rutanullaa_39e599d4:

    # "Colocas ambas manos en tus caderas y lo miras a los ojos."
    "You place both hands on your hips and look him in the eyes."

# game/rutas/nulla.rpy:888
translate ingles rutanullaa_c40ef4fe:

    # nj "¿Qué pasa?"
    nj "What's up?"

# game/rutas/nulla.rpy:889
translate ingles rutanullaa_6dcda270:

    # "Nulla desvía la mirada, sin ánimos de contestar."
    "Nulla looks away, unwilling to answer."

# game/rutas/nulla.rpy:892
translate ingles rutanullaa_c0aac483:

    # "Suspira entrecortadamente, como si aguantara un llanto."
    "He sighs in short, ragged breaths, as if holding back tears."

# game/rutas/nulla.rpy:893
translate ingles rutanullaa_409f8636_7:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:896
translate ingles rutanullaa_b674cb49:

    # nulla "¡No creí que sería tan difícil esto!"
    nulla "I didn't think this would be so hard!"

# game/rutas/nulla.rpy:897
translate ingles rutanullaa_1d5f9c3f:

    # nulla "Haber matado a Duae ha sido horrible, más de lo que pensaba."
    nulla "Killing Duae has been horrible, more than I thought."

# game/rutas/nulla.rpy:898
translate ingles rutanullaa_77c85709:

    # nulla "Pensanba que-- como esto ya había pasado en mi otra vida, sería más fácil..."
    nulla "I thought that--since this already happened in my past life--it would be easier..."

# game/rutas/nulla.rpy:899
translate ingles rutanullaa_07f03e75:

    # nulla "Ya la he matado ahí, ¿cuál es la diferencia esta vez?"
    nulla "I've already killed her there, so what's the difference this time?"

# game/rutas/nulla.rpy:900
translate ingles rutanullaa_14ddf2b8:

    # nulla "¡Son las memorias! Implantadas o no, las tengo ahora conmigo!"
    nulla "It's the memories! Implanted or not, I have them with me now!"

# game/rutas/nulla.rpy:901
translate ingles rutanullaa_7c6cba17:

    # nulla "Tengo muchos recuerdos de ella, que se han liberado al consumir su dominio... ella, me tenia una alta estima... aún."
    nulla "I have many memories of her that were released when her domain was consumed... she held me in high esteem... still."

# game/rutas/nulla.rpy:902
translate ingles rutanullaa_f55055d2:

    # nulla "Fui al que más confianza le depositó ¿¡y como se lo he pagado?!"
    nulla "I was the one she trusted the most--and how did I repay her?!"

# game/rutas/nulla.rpy:903
translate ingles rutanullaa_5da9e831:

    # nulla "Elimi--"
    nulla "Kill--"

# game/rutas/nulla.rpy:906
translate ingles rutanullaa_07c9aa64_1:

    # nulla "No."
    nulla "No."

# game/rutas/nulla.rpy:907
translate ingles rutanullaa_58eb4f81:

    # nulla "--no, no. Le he liberado de este infierno."
    nulla "--no, no. I've freed her from this hell."

# game/rutas/nulla.rpy:908
translate ingles rutanullaa_0aeae753:

    # nulla "Le he hecho un favor."
    nulla "I've done her a favor."

# game/rutas/nulla.rpy:910
translate ingles rutanullaa_f3933791:

    # "Te sientas a su lado, y ahora es muy notorio el olor a alcohol que despide su cuerpo."
    "You sit beside him, and now the scent of alcohol emanating from his body is unmistakable."

# game/rutas/nulla.rpy:911
translate ingles rutanullaa_cf04b33f:

    # "Nulla coloca ambas manos en su cara, cubriendo su expresión y comienza a balbusear palabras que no logras comprender."
    "Nulla places both hands on his face, covering his expression, and starts mumbling words you cannot understand."

# game/rutas/nulla.rpy:912
translate ingles rutanullaa_fd6b86e2:

    # "El cuerpo de Nulla comienza a cambiar de formas, unas líneas extrañas aparecen y desaparecen de su figura. Haciendo parecer que su cuerpo está perdiendo su forma original."
    "Nulla's body begins to change shape, with strange lines appearing and disappearing on his figure, making it seem as though his body is losing its original form."

# game/rutas/nulla.rpy:913
translate ingles rutanullaa_dc59bab0:

    # "Su estado emocional está por los suelos."
    "His emotional state is at rock bottom."

# game/rutas/nulla.rpy:914
translate ingles rutanullaa_7ec72945:

    # "Necesitas sacarlo de ese estado."
    "You need to pull him out of it."

# game/rutas/nulla.rpy:915
translate ingles rutanullaa_ea318467:

    # nulla "--Pero no ¡y ahora no tengo ninguna guía para absolutamente nada!"
    nulla "--But no, and now I have no guidance for absolutely anything!"

# game/rutas/nulla.rpy:919
translate ingles rutanullaa_73a73f75:

    # nulla "Tengo documentos de lo que se ha escrito anteriormente de mis yos antiguos..."
    nulla "I have documents of what was previously written about my former selves..."

# game/rutas/nulla.rpy:920
translate ingles rutanullaa_db2cddc0:

    # nulla "Pero el documento que estoy siguiendo ya no tiene nada más."
    nulla "But the document I'm following has nothing else."

# game/rutas/nulla.rpy:921
translate ingles rutanullaa_75f47946:

    # nulla "Solo páginas en blanco."
    nulla "Only blank pages."

# game/rutas/nulla.rpy:922
translate ingles rutanullaa_8b033598:

    # nulla "No sé cómo proseguir."
    nulla "I don't know how to proceed."

# game/rutas/nulla.rpy:923
translate ingles rutanullaa_a5dcd2cf:

    # nulla "No sé si resultará esto o no."
    nulla "I don't know if this will work or not."

# game/rutas/nulla.rpy:924
translate ingles rutanullaa_cf0dde1f:

    # nulla "No sé si Septem me dejará una vez más encerrado en el vacío o no."
    nulla "I don't know if Septem will let me be confined in the Void once again or not."

# game/rutas/nulla.rpy:925
translate ingles rutanullaa_ddba3f04:

    # nulla "¡Por primera vez en mucho que no tengo idea de nada de lo que ocurrirá!"
    nulla "For the first time in a long while, I have no idea whatsoever what will happen!"

# game/rutas/nulla.rpy:926
translate ingles rutanullaa_8c4e2b4d:

    # nulla "Y tengo miedo."
    nulla "And I'm scared."

# game/rutas/nulla.rpy:927
translate ingles rutanullaa_2413112f:

    # nulla "No quiero desperdiciar esta oportunidad."
    nulla "I don't want to waste this opportunity."

# game/rutas/nulla.rpy:928
translate ingles rutanullaa_413b56b0:

    # nulla "No quiero volver nuevamente ahí."
    nulla "I don't want to go back there again."

# game/rutas/nulla.rpy:929
translate ingles rutanullaa_e278f195:

    # nulla "En cualquier momento este mundo será abandonado nuevamente."
    nulla "At any moment, this world will be abandoned once more."

# game/rutas/nulla.rpy:930
translate ingles rutanullaa_308019c8:

    # nulla "Como siempre ha pasado con los anteriores mundos..."
    nulla "Just as it has always happened with previous worlds..."

# game/rutas/nulla.rpy:931
translate ingles rutanullaa_3a53bcf8:

    # nulla "No puedo."
    nulla "I can't."

# game/rutas/nulla.rpy:932
translate ingles rutanullaa_144d03b2:

    # nulla "No puedo dejar que Rafael siga así..."
    nulla "I can't let Rafael continue like this..."

# game/rutas/nulla.rpy:933
translate ingles rutanullaa_5ff1c93a:

    # nulla "Todo es mi culpa."
    nulla "It's all my fault."

# game/rutas/nulla.rpy:934
translate ingles rutanullaa_881eb602:

    # "Tienes que intervenir antes de que Nulla logre descompensarse completamente."
    "You have to intervene before Nulla completely loses control."

# game/rutas/nulla.rpy:938
translate ingles rutanullaa_5f9b772e_1:

    # "...."
    "...."

# game/rutas/nulla.rpy:939
translate ingles rutanullaa_779ea428:

    # "Realmente consideras que apoyarlo es lo mejor."
    "You truly believe that supporting him is the best option."

# game/rutas/nulla.rpy:940
translate ingles rutanullaa_5f2d8c79:

    # "No sacas nada con decir que todo estará bien, porque siendo sinceros... dudas que todo estará bien."
    "Saying that everything will be alright doesn't change anything, because, honestly... you doubt that everything will be alright."

# game/rutas/nulla.rpy:942
translate ingles rutanullaa_4069b723:

    # nj "[nombrejugador] está aquí para acompañarte, tienes toda su atención."
    nj "[nombrejugador] is here to accompany you; you have all their attention."

# game/rutas/nulla.rpy:943
translate ingles rutanullaa_01cbd358:

    # "{sc=3}Debo hacer esta separación, mil disculpas [nombrejugador]{/sc}"
    "{sc=3}I must make this separation, my apologies, [nombrejugador].{/sc}"

# game/rutas/nulla.rpy:944
translate ingles rutanullaa_01b61442:

    # "{sc=3}Pero dudo que Nulla se sienta tranquilo si hablo él desde el yo.{/sc}"
    "{sc=3}But I doubt Nulla \nwould feel at ease if I speak using 'I'.{/sc}"

# game/rutas/nulla.rpy:945
translate ingles rutanullaa_a20cefa7_13:

    # "..."
    "..."

# game/rutas/nulla.rpy:947
translate ingles rutanullaa_821691cd:

    # nulla "Hah, ni siquiera puedo quitarle la voluntad a tu marioneta..."
    nulla "Ja, I can't even strip the will from your puppet..."

# game/rutas/nulla.rpy:948
translate ingles rutanullaa_e653862b:

    # "Nulla no se digna a mirarte a los ojos."
    "Nulla doesn't deign to look you in the eyes."

# game/rutas/nulla.rpy:949
translate ingles rutanullaa_fcfcb08a:

    # "Pero sientes como Nulla aprieta tu mano con fuerza."
    "But you feel as if Nulla is squeezing your hand tightly."

# game/rutas/nulla.rpy:950
translate ingles rutanullaa_99ed1b91:

    # "No habla ni reacciona a hacer nada más que eso."
    "He doesn't speak, or react, or do anything more besides that."

# game/rutas/nulla.rpy:952
translate ingles rutanullaa_43d2951a:

    # "Hasta que comienza a llorar."
    "Until he begins to cry."

# game/rutas/nulla.rpy:953
translate ingles rutanullaa_8fb60e98:

    # "Es extraño verlo así, pero supones que ha estado rodeado de tanta agonía impuesta, ya sea por un ser superior o por sí mismo, que es una reacción que cualquier ser sintiente tendría en su situación."
    "It's strange to see him like this, but you assume he has been surrounded by so much imposed agony--whether from a higher being or from himself--that it's a reaction any sentient being in his situation would have."

# game/rutas/nulla.rpy:954
translate ingles rutanullaa_1af2535b:

    # "Envuelves ambas manos en la suya, la cual se ve tan pequeña ahora mismo, que te llega a espantar por un segundo."
    "You wrap both your hands around his, which now seem so small that they frighten you for a moment."

# game/rutas/nulla.rpy:955
translate ingles rutanullaa_92eedd82:

    # "Acaricias su espalda y das pequeñas palmadas, para ayudar a liberar esos sobrecojedores sentimientos, mezclados y atados, que se traducen en un llanto."
    "You caress his back and give gentle pats to help release those overwhelming, mixed, and intertwined feelings that manifest as tears."

# game/rutas/nulla.rpy:956
translate ingles rutanullaa_af24f8bf:

    # "Lo único que se escucha son los sollozos de un hombre desesperado por la validación de su propia existencia."
    "All you hear are the sobs of a man desperate for the validation of his own existence."

# game/rutas/nulla.rpy:957
translate ingles rutanullaa_4b44c0d9:

    # "Es tortuoso, pero debes aguantarlo."
    "It's torturous, but you have to endure it."

# game/rutas/nulla.rpy:958
translate ingles rutanullaa_6e3ff76c:

    # "Pues si no lo haces, estás seguro que comenzarás a llorar junto a él."
    "Because if you don't, you're sure to start crying along with him."

# game/rutas/nulla.rpy:959
translate ingles rutanullaa_0db85788:

    # nulla "Soy patético..."
    nulla "I'm pathetic..."

# game/rutas/nulla.rpy:962
translate ingles rutanullaa_61cd9492:

    # "Tú no lo corriges."
    "You don't correct him."

# game/rutas/nulla.rpy:966
translate ingles rutanullaa_f63cf671:

    # nj "¡No digas eso!"
    nj "Don't say that!"

# game/rutas/nulla.rpy:968
translate ingles rutanullaa_afed012d:

    # "Le dices todo lo que sabes de él, le aseguras que no es un hombre patético. Le hablas con sinceridad, cada palabra que sale de ti lleva un tono de sincera ternura."
    "You tell him everything you know about him, assuring him that he is not a pathetic man. You speak sincerely, each word laced with genuine tenderness."

# game/rutas/nulla.rpy:969
translate ingles rutanullaa_8d1b2680:

    # "Nulla no responde, ni discute. Simplemente te escucha en silencio."
    "Nulla doesn't respond or argue. He simply listens to you in silence."

# game/rutas/nulla.rpy:970
translate ingles rutanullaa_73e819bc:

    # "Mientras hablas, deslizas tu mano con suavidad sobre su cabeza, apartando delicadamente la capa de gel para llegar hasta su cuero cabelludo."
    "As you speak, you gently slide your hand over his head, delicately pushing aside the layer of gel to reach his scalp."

# game/rutas/nulla.rpy:971
translate ingles rutanullaa_30f1c18b:

    # "Su cabello es suave en las puntas, suave y delgado..."
    "His hair is soft at the ends, smooth and fine..."

# game/rutas/nulla.rpy:972
translate ingles rutanullaa_677c47a6:

    # "Si tan solo no tuviera gel en su cabello..."
    "If only he didn't have gel in his hair..."

# game/rutas/nulla.rpy:974
translate ingles rutanullaa_c71de4fe:

    # "Nulla suelta un suspiro, que tiene un aire de añoramiento."
    "Nulla lets out a sigh, imbued with a sense of longing."

# game/rutas/nulla.rpy:975
translate ingles rutanullaa_70ca0d24:

    # nulla "... nanai."
    nulla "... Nanai."

# game/rutas/nulla.rpy:978
translate ingles rutanullaa_a48a9ead:

    # "No reconoces esa palabra. Por lo que le preguntas que es lo que acaba de decir."
    "You don't recognize that word, so you ask him what he just said."

# game/rutas/nulla.rpy:980
translate ingles rutanullaa_a1a57b7b:

    # nulla "Ah!"
    nulla "Ah!"

# game/rutas/nulla.rpy:981
translate ingles rutanullaa_45839004:

    # "Nulla suena casi que avergonzado y se levanta para poder evitar completamente tu mirada, como si tuviera miedo de ver tu reacción."
    "Nulla sounds almost embarrassed and gets up to completely avoid your gaze, as if he were afraid of your reaction."

# game/rutas/nulla.rpy:984
translate ingles rutanullaa_75b44174:

    # nulla "Me he acordado de una vieja memoria."
    nulla "I've remembered an old memory."

# game/rutas/nulla.rpy:985
translate ingles rutanullaa_33377585:

    # nulla "Es... lo que se dice cuando alguien consuela a otro. Cuando era niño, solía decirlo mucho... cuando Ma-"
    nulla "It's... what you say when someone comforts another. When I was a child, I used to say it a lot... when Ma-"

# game/rutas/nulla.rpy:986
translate ingles rutanullaa_4e92c148:

    # "Nulla se detiene en seco y una risa se escapa de sus labios, pero no es una risa alegre... esta pesada, casi rota."
    "Nulla stops abruptly and a laugh escapes his lips, but it's not a joyful laugh... it's heavy, almost broken."

# game/rutas/nulla.rpy:987
translate ingles rutanullaa_5eae0f59:

    # nulla "...Significa 'acariciar con el corazón'."
    nulla "... It means 'to caress with the heart.'"

# game/rutas/nulla.rpy:988
translate ingles rutanullaa_77eeb9a7:

    # nulla "Es una de mis palabras favoritas."
    nulla "It's one of my favorite words."

# game/rutas/nulla.rpy:989
translate ingles rutanullaa_409f8636_8:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:992
translate ingles rutanullaa_5151da4e:

    # nulla "¿Cómo puede ser que mientras más tiempo pasa, más aprendes de mí y yo no puedo tener nada más que el reflejo de tus ojos?"
    nulla "How is it that the more time passes, the more you learn about me, and I can have nothing but the reflection of your eyes?"

# game/rutas/nulla.rpy:993
translate ingles rutanullaa_0e500403:

    # nulla "No es justo."
    nulla "It's not fair."

# game/rutas/nulla.rpy:994
translate ingles rutanullaa_409f8636_9:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:997
translate ingles rutanullaa_4f44afc8:

    # nulla "Prometí no involucrarme tanto para que la despedida no sea más terrible de lo que será."
    nulla "I promised not to get too involved, so that our farewell wouldn't be more terrible than it will be."

# game/rutas/nulla.rpy:998
translate ingles rutanullaa_bc2430ae:

    # nulla "Pero al menos quiero tener algo de ti conmigo."
    nulla "But I at least want to have some of you with me."

# game/rutas/nulla.rpy:1001
translate ingles rutanullaa_17023d32:

    # nulla "... dicen que las palabras son el reflejo del alma."
    nulla "... They say that words are the reflection of the soul."

# game/rutas/nulla.rpy:1004
translate ingles rutanullaa_28c759e5:

    # nulla "Me gustaría poder saber tu palabra favorita."
    nulla "I would like to know your favorite word."

# game/rutas/nulla.rpy:1005
translate ingles rutanullaa_63988e39:

    # nulla "Tú sabes la mía... ¿Cuál es la tuya?"
    nulla "You know mine... What's yours?"

# game/rutas/nulla.rpy:1007
translate ingles rutanullaa_409f8636_10:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:1009
translate ingles rutanullaa_9a220f99:

    # "Nulla no dice nada, pero baja la mirada y ves como sonríe levemente. Como si hubiera obtenido algo tan secretamente preciado que no quisiera dejarle notar al mundo lo que ha ganado."
    "Nulla doesn't say anything, but he lowers his gaze and you see him smile slightly, as if he had obtained something so secretly precious that he wouldn't let the world notice what he has gained."

# game/rutas/nulla.rpy:1012
translate ingles rutanullaa_a20cefa7_14:

    # "..."
    "..."

# game/rutas/nulla.rpy:1013
translate ingles rutanullaa_578c3ed9:

    # "El tiempo pasa rápido."
    "Time flies."

# game/rutas/nulla.rpy:1015
translate ingles rutanullaa_b4e7599e:

    # "Tan rápido que no te das cuenta de que Nulla te deja en la cama y se despide con la voz ronca, único vestigio de que estuvo llorando."
    "So quickly that you don't notice Nulla leaving you on the bed, saying goodbye in a hoarse voice--the only trace that he had been crying."

# game/rutas/nulla.rpy:1016
translate ingles rutanullaa_d7502db5:

    # "Ya que no te deja ver su cara en ningún momento."
    "Since he never lets you see his face."

# game/rutas/nulla.rpy:1017
translate ingles rutanullaa_fe66bcbb:

    # "Meditas por un tiempo lo ocurrido..."
    "You ponder what happened for a while..."

# game/rutas/nulla.rpy:1018
translate ingles rutanullaa_e69df51e:

    # "Y realmente piensas que..."
    "And you really think that..."

# game/rutas/nulla.rpy:1019
translate ingles rutanullaa_09cc57ec:

    # "{sc=3}{i} Nulla es un hombre complicado... ¿no lo crees, [nombrejugador]?{i} {/sc}"
    "{sc=3}{i} Nulla is a complicated man... don't you think so, [nombrejugador]?{i}{/sc}"

# game/rutas/nulla.rpy:1022
translate ingles rutanullaa_21cc7f20:

    # "No te gusta verlo en este estado tan deplorable."
    "You don't like seeing him in such a deplorable state."

# game/rutas/nulla.rpy:1023
translate ingles rutanullaa_059c9a75:

    # "¡Por lo que lo sacarás de ese estado a la fuerza!"
    "So you'll drag him out of it by force!"

# game/rutas/nulla.rpy:1025
translate ingles rutanullaa_88fc05b2:

    # "Te acercas lo suficiente como para poder tomar su corbata y tirar fuertemente de ella hacia tu dirección."
    "You get close enough to grab his tie and pull it forcefully toward you."

# game/rutas/nulla.rpy:1026
translate ingles rutanullaa_5eb7d55f:

    # "Sus ojos por fin se enfocan completamente en los tuyos, ahora tienes toda su atención."
    "His eyes finally focus completely on yours; now you have his full attention."

# game/rutas/nulla.rpy:1028
translate ingles rutanullaa_0a7bceda:

    # nj "¡Lloriqueando no vas a resolver nada!"
    nj "Whining isn't going to solve anything!"

# game/rutas/nulla.rpy:1029
translate ingles rutanullaa_f427ed99:

    # nj "Y menos hundiendo tus penas en alcohol."
    nj "And things certainly won't be solved by drowning your sorrows in alcohol."

# game/rutas/nulla.rpy:1030
translate ingles rutanullaa_d9b6d1ec:

    # nj "Si quieres conversar como te sientes, me tienes aquí."
    nj "If you want to talk about how you feel, I'm here."

# game/rutas/nulla.rpy:1031
translate ingles rutanullaa_a12e19a9:

    # nj "Pero este discurso unilateral no te hará más que hundir más en el hoyo que has cavado con tus propias manos."
    nj "But this one-sided talk will only sink you further into the hole you've dug with your own hands."

# game/rutas/nulla.rpy:1034
translate ingles rutanullaa_6be639f6:

    # nj "Enano de pacotilla..."
    nj "You little runt..."

# game/rutas/nulla.rpy:1035
translate ingles rutanullaa_65efaa49:

    # "Te detienes antes de continuar..."
    "You pause before continuing..."

# game/rutas/nulla.rpy:1036
translate ingles rutanullaa_d1373a83:

    # "{sc=3} Lo siento, [nombrejugador], no he podido aguantarme...{sc=3}"
    "{sc=3}I'm sorry, [nombrejugador], I couldn't hold it in...{sc=3}"

# game/rutas/nulla.rpy:1037
translate ingles rutanullaa_148fad38:

    # "Nulla te mira como si no pudiera creer lo que está pasando."
    "Nulla looks at you as if he can't believe what's happening."

# game/rutas/nulla.rpy:1038
translate ingles rutanullaa_409f8636_11:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:1040
translate ingles rutanullaa_be456b90:

    # "Una tenue sonrisa comienza a dibujarse en su rostro, para ser remplazada rápidamente por una carcajada forzada."
    "A faint smile begins to form on his face, only to be quickly replaced by a forced laugh."

# game/rutas/nulla.rpy:1041
translate ingles rutanullaa_05dd093a:

    # nulla "JA-- jajajajajaja. Ni siquiera tú te esperabas ese diálogo [nombrejugador]."
    nulla "JA--jajajajajaja. Even you didn't expect that dialogue, [nombrejugador]."

# game/rutas/nulla.rpy:1042
translate ingles rutanullaa_56a045b7:

    # nulla "Te seré sincero, si bien aprecio la intención que has tenido, pensando que esa sería la opción..."
    nulla "To be honest, while I appreciate the intent behind it, thinking that could be the option..."

# game/rutas/nulla.rpy:1043
translate ingles rutanullaa_3b56f735:

    # nulla "Hay una cosa que debes tener clara: Tú estás allá, [nombrejugador]. Detrás de sus ojos."
    nulla "There's one thing you must understand: You're over there, [nombrejugador]. Behind the eyes of the puppet."

# game/rutas/nulla.rpy:1044
translate ingles rutanullaa_6efc1c0f:

    # nulla "No te tengo aquí, lo único que tengo a mi lado es a la marioneta."
    nulla "I don't have you here; all I have by my side is the puppet."

# game/rutas/nulla.rpy:1045
translate ingles rutanullaa_553c695f:

    # nulla "Que parece no aceptar la eliminación de su voluntad."
    nulla "Which seems unwilling to accept the stripping away of its will."

# game/rutas/nulla.rpy:1046
translate ingles rutanullaa_55655887:

    # nulla "Que linda~"
    nulla "How lovely~"

# game/rutas/nulla.rpy:1047
translate ingles rutanullaa_214a9f08:

    # nulla "Tengo que aceptar que esto me ha hecho la noche."
    nulla "I have to admit, this really made my night."

# game/rutas/nulla.rpy:1048
translate ingles rutanullaa_968020ef:

    # "Nulla quita tus manos de él con delicadeza."
    "Nulla gently removes your hands from him."

# game/rutas/nulla.rpy:1050
translate ingles rutanullaa_742bee96:

    # nulla "Ya no más lloriquedos, lo prometo."
    nulla "No more whining, I promise."

# game/rutas/nulla.rpy:1052
translate ingles rutanullaa_a9f0cae8:

    # "Luego de ello, todo se vuelve incómodo. Nulla no muestra interés en conversar, así que te despides para ir a dormir, excusándote de que tienes sueño. Ambos suben las escaleras y Nulla te deja en la cama."
    "After that, everything becomes awkward. Nulla shows no interest in talking, so you say goodbye to go to sleep, apologizing that you're tired. Both of you climb the stairs and Nulla leaves you in bed."

# game/rutas/nulla.rpy:1053
translate ingles rutanullaa_bbb99b02:

    # "Dándote las buenas noches."
    "Wishing you goodnight."

# game/rutas/nulla.rpy:1055
translate ingles rutanullaa_3eb2153a:

    # "Cierras los ojos y te hundes en el país de los sueños."
    "You close your eyes and sink into the land of dreams."

# game/rutas/nulla.rpy:1057
translate ingles rutanullaa_af6c6b90:

    # "Pero a pesar de estar en el país de los sueños y deseos."
    "But despite being in the land of dreams and desires."

# game/rutas/nulla.rpy:1058
translate ingles rutanullaa_79fafc64:

    # "No sueñas con nada..."
    "You dream of nothing..."

# game/rutas/nulla.rpy:1062
translate ingles rutanullaa_f71b3735:

    # "Despiertas con mucho calor, tanto calor que cuando tocas tu frente, estás sudando."
    "You wake up extremely hot, so much so that when you touch your forehead, you're sweating."

# game/rutas/nulla.rpy:1063
translate ingles rutanullaa_1dfc7032:

    # "El ambiente se siente seco y ahogante por el calor."
    "The atmosphere feels dry and stifling from the heat."

# game/rutas/nulla.rpy:1064
translate ingles rutanullaa_508878cc:

    # "Como un horno que se está precalentando."
    "Like an oven that's preheating."

# game/rutas/nulla.rpy:1067
translate ingles rutanullaa_3b64668f_1:

    # nulla "¡Buenos días!"
    nulla "Good morning!"

# game/rutas/nulla.rpy:1070
translate ingles rutanullaa_53ae4beb:

    # nulla "Quisiera disculparme por lo de ayer..."
    nulla "I want to apologize for yesterday..."

# game/rutas/nulla.rpy:1073
translate ingles rutanullaa_cb0afef2:

    # nulla "Se que fue raro y prometo que no volverá a pasar."
    nulla "I know it was unusual, and I promise it won't happen again."

# game/rutas/nulla.rpy:1076
translate ingles rutanullaa_7059a117:

    # nulla "Ya me he deshecho de esos recuerdos... Por lo que no volverá a pasar."
    nulla "I've gotten rid of those memories... so it won't happen again."

# game/rutas/nulla.rpy:1077
translate ingles rutanullaa_c3d86362:

    # "Nulla sonríe, pero a ti no te gusta la implicancia de sus palabras."
    "Nulla smiles, but you don't like the implication of his words."

# game/rutas/nulla.rpy:1080
translate ingles rutanullaa_d06ac688:

    # nulla "Estuve pensando creo que debemos empezar de una vez la caza del día de hoy..."
    nulla "I've been thinking, I believe we should start today's hunt immediately..."

# game/rutas/nulla.rpy:1083
translate ingles rutanullaa_07df9560:

    # nulla "Se están empezando a movilizar ya..."
    nulla "They're starting to mobilize already..."

# game/rutas/nulla.rpy:1084
translate ingles rutanullaa_d9a5ae57:

    # nulla "Supongo que Unum debe estar resguardando a Tria y a Sextam."
    nulla "I suppose Unum must be guarding Tria and Sextam."

# game/rutas/nulla.rpy:1089
translate ingles rutanullaa_f310fd1d:

    # nulla "Está en su dominio."
    nulla "He's in his domain."

# game/rutas/nulla.rpy:1092
translate ingles rutanullaa_e3f0b983:

    # nulla "Es un blanco fácil, pero él no puede morir por ahora."
    nulla "He's an easy target, but he can't die right now."

# game/rutas/nulla.rpy:1095
translate ingles rutanullaa_8b71388f:

    # nulla "No me voy a arriesgar a enfrentarme a él."
    nulla "I'm not going to risk facing him."

# game/rutas/nulla.rpy:1096
translate ingles rutanullaa_1aa39f32:

    # nulla "¿Sientes que la temperatura térmica ha aumentado considerablemente?"
    nulla "Do you feel how the temperature's risen significantly?"

# game/rutas/nulla.rpy:1099
translate ingles rutanullaa_af09c7c5:

    # "Asientes con la cabeza. Hace tanto calor que sientes como la ropa se te pega al cuerpo gracias al sudor."
    "You nod. It's so hot that you feel your clothes sticking to your body from the sweat."

# game/rutas/nulla.rpy:1100
translate ingles rutanullaa_bb4a303d:

    # nulla "Unum es el causante."
    nulla "Unum is to blame."

# game/rutas/nulla.rpy:1103
translate ingles rutanullaa_080b422a:

    # nulla "Debe estar volviéndose loco por la pérdida de sus estrellas."
    nulla "He must be going crazy from the loss of his stars."

# game/rutas/nulla.rpy:1106
translate ingles rutanullaa_409f8636_12:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:1109
translate ingles rutanullaa_637ee36a:

    # nulla "No..."
    nulla "No..."

# game/rutas/nulla.rpy:1112
translate ingles rutanullaa_d1b4f789:

    # nulla "Ahora es muy peligroso enfrentarse a tres Estandartes en un espacio limitado."
    nulla "Now it's very dangerous to face three Symbols in a confined space."

# game/rutas/nulla.rpy:1115
translate ingles rutanullaa_65bec9e9:

    # nj "¿Por qué?"
    nj "Why?"

# game/rutas/nulla.rpy:1116
translate ingles rutanullaa_bc764515:

    # nulla "Porque muchos conceptos en un lugar alteran el espacio físico..."
    nulla "Because too many concepts in one place distort the physical space..."

# game/rutas/nulla.rpy:1119
translate ingles rutanullaa_b2240cbd:

    # nulla "Y no me quiero arriesgar a perderte por ello."
    nulla "And I don't want to risk losing you because of it."

# game/rutas/nulla.rpy:1123
translate ingles rutanullaa_ff6b4edb:

    # "Nulla no elabora más en ello."
    "Nulla doesn't elaborate any further."

# game/rutas/nulla.rpy:1124
translate ingles rutanullaa_b5957e25:

    # "Intentas recordar quien falta, pero no recuerdas todos los nombres."
    "You try to recall who is missing, but you don't remember all the names."

# game/rutas/nulla.rpy:1127
translate ingles rutanullaa_af4faf37:

    # nulla "Iremos a por Quinque, cariño."
    nulla "We'll go for Quinque, cariño."

# game/rutas/nulla.rpy:1129
translate ingles rutanullaa_4c426e14:

    # "Quinque..."
    "Quinque..."

# game/rutas/nulla.rpy:1130
translate ingles rutanullaa_9a869b0d:

    # "No sabes mucho de él, lo que supones que es lo mejor."
    "You don't know much about him, which you assume is for the best."

# game/rutas/nulla.rpy:1131
translate ingles rutanullaa_b3a41882:

    # "Así se hace más un poco más fácil verlos morir frente a tus ojos."
    "That way, it's a bit easier to watch them die before your eyes."

# game/rutas/nulla.rpy:1132
translate ingles rutanullaa_b7fd27b0:

    # "Supones..."
    "You suppose..."

# game/rutas/nulla.rpy:1133
translate ingles rutanullaa_e82458f8:

    # nulla "Pero antes, debemos tomar desayuno."
    nulla "But first, we need to have breakfast."

# game/rutas/nulla.rpy:1135
translate ingles rutanullaa_63187df1:

    # "Nulla te acompaña a la mesa una vez estás listo."
    "Nulla accompanies you to the table once you're ready."

# game/rutas/nulla.rpy:1136
translate ingles rutanullaa_e4a2a55d:

    # nulla "Ya está todo servido y listo, así que come sin miedo."
    nulla "Everything is served and ready, so eat without fear."

# game/rutas/nulla.rpy:1137
translate ingles rutanullaa_ff78d126:

    # "En la mesa hay de todo para ponerle al pan, hay tanta abundancia que te marea un poco."
    "On the table, there's everything to put on your bread--so much abundance that it overwhelms you a bit."

# game/rutas/nulla.rpy:1138
translate ingles rutanullaa_a20cefa7_15:

    # "..."
    "..."

# game/rutas/nulla.rpy:1140
translate ingles rutanullaa_c88f0578:

    # "Luego de terminar Nulla se lleva los platos a la cocina y comienza a lavar y ordenar todo."
    "After finishing, Nulla takes the dishes to the kitchen and starts washing and tidying everything up."

# game/rutas/nulla.rpy:1141
translate ingles rutanullaa_ca187bd9:

    # "Insistes en ayudarle, pero él te dice que no es necesario. Luego de insistir un poco más, él cede."
    "You insist on helping him, but he tells you it's not necessary. After you press a bit more, he relents."

# game/rutas/nulla.rpy:1142
translate ingles rutanullaa_09969aec:

    # "Tú ayudas secando los cubiertos y platos que Nulla lava, crees que es un buen trabajo en equipo."
    "You help dry the cutlery and plates that Nulla washes, and you think it's good teamwork."

# game/rutas/nulla.rpy:1144
translate ingles rutanullaa_52283750:

    # nulla "Los quehaceres de la casa se hacen más divertidos contigo al lado."
    nulla "Household chores are more fun with you by my side."

# game/rutas/nulla.rpy:1145
translate ingles rutanullaa_e9c71ed5:

    # nulla "ja- Me encantaría poder hacer todo esto contigo el resto de mi vida..."
    nulla "Ja--I'd love to do all this with you for the rest of my life..."

# game/rutas/nulla.rpy:1146
translate ingles rutanullaa_b66565af:

    # "Intentas imaginártelo, y te sorprendes de lo fácil que es hacerlo."
    "You try to imagine it, and you're surprised at how easily you can do so."

# game/rutas/nulla.rpy:1147
translate ingles rutanullaa_f7da50ef:

    # "Imaginas una vida común y corriente junto con él, haciendo cosas cotidianas, yendo de compras para llenar la despensa... citas y quien sabe que otras cosas más... y no se ve para nada mal."
    "You imagine a simple, everyday life with him--doing routine things, shopping to fill the pantry, going on dates, and who knows what else--and it doesn't look bad at all."

# game/rutas/nulla.rpy:1148
translate ingles rutanullaa_2451d4b6:

    # "Se ve y oye tan bien que te aterra."
    "It looks and sounds so good that it scares you."

# game/rutas/nulla.rpy:1149
translate ingles rutanullaa_727d2502:

    # nulla "¡Bien!"
    nulla "Good!"

# game/rutas/nulla.rpy:1151
translate ingles rutanullaa_af125f38:

    # "Nulla termina de lavar el último plato y voltea a mirarte."
    "Nulla finishes washing the last plate and turns to look at you."

# game/rutas/nulla.rpy:1153
translate ingles rutanullaa_9754841c:

    # nulla "Hora de ir a por Quinque."
    nulla "Time to go get Quinque."

# game/rutas/nulla.rpy:1159
translate ingles rutanullaa_9e2ecf0d:

    # nj "¿No podemos pasar un poco más de tiempo aquí?"
    nj "Can't we spend a little more time here?"

# game/rutas/nulla.rpy:1160
translate ingles rutanullaa_170f58db:

    # nulla "Mmmmh."
    nulla "Mmmmh."

# game/rutas/nulla.rpy:1163
translate ingles rutanullaa_7efbeaa5:

    # nulla "Realmente prefiero que acabemos con esto de una buena vez."
    nulla "I really prefer that we end this once and for all."

# game/rutas/nulla.rpy:1166
translate ingles rutanullaa_30c9d19f:

    # nulla "¡Además!"
    nulla "Besides!"

# game/rutas/nulla.rpy:1167
translate ingles rutanullaa_77159484:

    # nulla "Si terminamos con esto rápido, tendremos toda la tarde para pasar el tiempo juntos."
    nulla "If we finish this quickly, we'll have the whole afternoon to spend together."

# game/rutas/nulla.rpy:1168
translate ingles rutanullaa_9518ddb3:

    # nulla "Si quieres, luego te llevaré a un lugar que me gusta mucho."
    nulla "If you want, I'll take you to a place I really love."

# game/rutas/nulla.rpy:1169
translate ingles rutanullaa_a724e0c6:

    # nulla "Y desearía que tú lo vieras."
    nulla "And that I wish you could see."

# game/rutas/nulla.rpy:1172
translate ingles rutanullaa_5319a886:

    # nulla "¿Te parece?"
    nulla "Does that sound good to you?"

# game/rutas/nulla.rpy:1173
translate ingles rutanullaa_69bb3e0a:

    # "Habla como si de un trámite se tratara..."
    "He talks as if it were just a formality..."

# game/rutas/nulla.rpy:1176
translate ingles rutanullaa_ad626db1:

    # nj "Está bien"
    nj "Alright."

# game/rutas/nulla.rpy:1178
translate ingles rutanullaa_393bb177:

    # nulla "¡Perfecto!"
    nulla "Perfect!"

# game/rutas/nulla.rpy:1182
translate ingles rutanullaa_2205b126:

    # nj "{glitch=20.0}{color=ffffff}{b}Está bien.{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}Alright.{/glitch}"

# game/rutas/nulla.rpy:1183
translate ingles rutanullaa_b84f2801:

    # "¿¿¿¿????"
    "????"

# game/rutas/nulla.rpy:1184
translate ingles rutanullaa_4a86bf84:

    # "Eso no ha sido lo que querías decir. Tú no quieres ir ahora mismo."
    "That wasn't what you meant. You don't want to go right now."

# game/rutas/nulla.rpy:1185
translate ingles rutanullaa_d4a4a1ee:

    # "¿Qué está pasando?"
    "What's happening?"

# game/rutas/nulla.rpy:1187
translate ingles rutanullaa_393bb177_1:

    # nulla "¡Perfecto!"
    nulla "Perfect!"

# game/rutas/nulla.rpy:1188
translate ingles rutanullaa_25e761dd:

    # "Momento--"
    "Wait--"

# game/rutas/nulla.rpy:1189
translate ingles rutanullaa_b3bc5871:

    # "Intentas abrir la boca, pero no puedes. Algo no te deja hacerlo."
    "You try to open your mouth, but you can't. Something prevents you from doing so."

# game/rutas/nulla.rpy:1192
translate ingles rutanullaa_a82084f6:

    # nulla "¿Mmmm?"
    nulla "Hmm?"

# game/rutas/nulla.rpy:1195
translate ingles rutanullaa_0aa8c9dd:

    # nulla "¿Pasa algo?"
    nulla "Is something wrong?"

# game/rutas/nulla.rpy:1196
translate ingles rutanullaa_9d78bea3:

    # "Nulla sonríe, sabiendo exactamente lo que está pasando y lo que está haciendo."
    "Nulla smiles, knowing exactly what's happening and what he's doing."

# game/rutas/nulla.rpy:1198
translate ingles rutanullaa_d626eda1:

    # nulla "Ya expliqué mis razones."
    nulla "I've already explained my reasons."

# game/rutas/nulla.rpy:1199
translate ingles rutanullaa_288c63ce:

    # nulla "Por favor, debemos ir ahora."
    nulla "Please, we must go now."

# game/rutas/nulla.rpy:1200
translate ingles rutanullaa_edc29c14:

    # nulla "Luego tendremos tiempo para estar juntos y más tranquilos."
    nulla "Then we'll have time to be together more peacefully."

# game/rutas/nulla.rpy:1204
translate ingles rutanullaa_b77ec9e2:

    # "Nulla toma tu mano, asegurándose de acariciarla por un instante, antes de hundirse en el vacío junto contigo."
    "Nulla takes your hand, caressing it for a moment before plunging into the Void with you."

# game/rutas/nulla.rpy:1207
translate ingles rutanullaa_763e50cd:

    # "Una vez dentro, te abraza y te habla como si quisiera que nadie más que tú lo escuchase."
    "Once inside, he hugs you and speaks as if he wants only you to hear him."

# game/rutas/nulla.rpy:1208
translate ingles rutanullaa_58756107:

    # "Irónico, pues aquí no hay nada más que ustedes."
    "It's ironic, because here there's nothing but the two of you."

# game/rutas/nulla.rpy:1210
translate ingles rutanullaa_75e0ad12:

    # nulla "Me encanta venir aquí y mirarte..."
    nulla "I love coming here and looking at you..."

# game/rutas/nulla.rpy:1211
translate ingles rutanullaa_d56791ff:

    # nulla "Con la oscuridad del vacío puedo ver mejor lo que pasa detrás de esa pantalla."
    nulla "With the darkness of the Void, I can better see what's happening behind that screen."

# game/rutas/nulla.rpy:1212
translate ingles rutanullaa_a0cbdf50:

    # nulla "...Espero ser el primero que te lo dice hoy."
    nulla "... I hope I'm the first to tell you this."

# game/rutas/nulla.rpy:1214
translate ingles rutanullaa_9b768edf:

    # "{glitch=20.0}{color=ffffff}{b}Te ves adorable.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}You look adorable.{/glitch}"

# game/rutas/nulla.rpy:1216
translate ingles rutanullaa_b483eb6f:

    # "Caminan por la selva hasta llegar a un templo escondido entre plantas y rocas."
    "You walk through the jungle until you reach a temple hidden among plants and rocks."

# game/rutas/nulla.rpy:1217
translate ingles rutanullaa_4fc63170:

    # "La estructura del templo es diferente al de Quattor, al igual que su tamaño."
    "The temple's structure is different from Quattor's, as is its size."

# game/rutas/nulla.rpy:1218
translate ingles rutanullaa_1988e30e:

    # "Es algo pequeño... muy pequeño como la para el gusto de un Dios...."
    "It's rather small... very small, just the way a god would like it."

# game/rutas/nulla.rpy:1220
translate ingles rutanullaa_f4f3f678:

    # "Cuando se acercan más, pareciera estar hecho de algún tipo de piedra."
    "As you get closer, it seems to be made of some kind of stone."

# game/rutas/nulla.rpy:1222
translate ingles rutanullaa_8219848b:

    # nulla "Es piedra caliza."
    nulla "It's limestone."

# game/rutas/nulla.rpy:1223
translate ingles rutanullaa_01267159:

    # "Te informa Nulla después de leer tu dialogo interno."
    "Nulla informs you after reading your internal dialogue."

# game/rutas/nulla.rpy:1224
translate ingles rutanullaa_c181d676:

    # "¡Intruso!"
    "Intruder!"

# game/rutas/nulla.rpy:1227
translate ingles rutanullaa_705096be:

    # nulla "Jaja!"
    nulla "Jaja!"

# game/rutas/nulla.rpy:1228
translate ingles rutanullaa_042ead06:

    # "Y al sabandija no le causa nada más que gracia..."
    "And the little scoundrel finds it nothing but amusing..."

# game/rutas/nulla.rpy:1231
translate ingles rutanullaa_488bd16f:

    # nulla "Quinque hizo este templo pequeño para no quitarle espacio a sus bebés."
    nulla "Quinque made this small temple so as not to take up space from his offspring."

# game/rutas/nulla.rpy:1234
translate ingles rutanullaa_412dac29:

    # nulla "Sí, todos los animales que ves aquí son sus bebés."
    nulla "Yes, all the animals you see here are his babies."

# game/rutas/nulla.rpy:1237
translate ingles rutanullaa_75293d0e:

    # nulla "Así es."
    nulla "That's right."

# game/rutas/nulla.rpy:1239
translate ingles rutanullaa_defd59b7:

    # nulla "Y todos tienen nombres... sigo sin entender como Quinque recuerda cada uno de ellos."
    nulla "And they all have names... I still don't understand how Quinque remembers each one of them."

# game/rutas/nulla.rpy:1240
translate ingles rutanullaa_a2107e32:

    # "Adorable..."
    "Adorable..."

# game/rutas/nulla.rpy:1243
translate ingles rutanullaa_198c64f1:

    # nulla "Este es el único domino que ha sido intervenido por el trabajo de dos Estandartes en conjunto."
    nulla "This is the only domain that has been touched by the combined work of two Symbols."

# game/rutas/nulla.rpy:1244
translate ingles rutanullaa_b452d37b:

    # nulla "Tria y Quinque trabajaban juntos en la organización de ambos dominios cuando el Creador aún estaba aquí."
    nulla "Tria and Quinque worked together organizing both domains when the Creator was still here."

# game/rutas/nulla.rpy:1247
translate ingles rutanullaa_5408a3f8:

    # "Siendo completamente sinceros, te apena escuchar esto."
    "Honestly, it saddens you to hear this."

# game/rutas/nulla.rpy:1248
translate ingles rutanullaa_8fa734c3:

    # "Te apena escuchar de estos dioses que serán asesinados tarde o temprano."
    "It pains you to hear that these gods will eventually be killed."

# game/rutas/nulla.rpy:1249
translate ingles rutanullaa_184234b2:

    # "Piensas que sería mucho mejor no tener idea de nada y hacer este genocidio más fácil."
    "You think it would be much better not to know anything, making this genocide easier."

# game/rutas/nulla.rpy:1250
translate ingles rutanullaa_5066ff5d:

    # "No entiendes la finalidad que tiene Nulla al contarte esto."
    "You don't understand Nulla's purpose in telling you this."

# game/rutas/nulla.rpy:1251
translate ingles rutanullaa_a20cefa7_16:

    # "..."
    "..."

# game/rutas/nulla.rpy:1252
translate ingles rutanullaa_174f0612:

    # "¿Ahora se va a hacer el que no lee lo que piensas?"
    "Now are you going to pretend you don't read your own thoughts?"

# game/rutas/nulla.rpy:1253
translate ingles rutanullaa_6f3d18ff:

    # "Ja!"
    "Ha!"

# game/rutas/nulla.rpy:1256
translate ingles rutanullaa_d78d4b43:

    # nulla "¿Quieres que te explique, [nombrejugador]?"
    nulla "Do you want me to explain, [nombrejugador]?"

# game/rutas/nulla.rpy:1257
translate ingles rutanullaa_4cf8a9fd:

    # "He ahí él, confirmando una vez más que sabe todo lo que pasa en esta caja de diálogo, que se supone que es exclusivamente para tus ojos."
    "There he is, confirming once again that he knows everything happening in this dialogue box, which is meant exclusively for your eyes."

# game/rutas/nulla.rpy:1258
translate ingles rutanullaa_23b83c00:

    # "Maldita rata..."
    "Damn rat..."

# game/rutas/nulla.rpy:1263
translate ingles rutanullaa_18371a06:

    # nulla "No tengo problema en darte una explicación, mi vida."
    nulla "I have no problem explaining it to you, mi vida."

# game/rutas/nulla.rpy:1266
translate ingles rutanullaa_409f8636_13:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:1269
translate ingles rutanullaa_62e85fdf:

    # nulla "Solo creo que merece la pena recordarlos."
    nulla "I just think they deserve to be remembered."

# game/rutas/nulla.rpy:1270
translate ingles rutanullaa_2ced236d:

    # nulla "No les estaría haciendo justicia si los eliminara sin al menos intentar que sean recordados por algo."
    nulla "I wouldn't do them justice if I wiped them out without at least trying to have them remembered for something."

# game/rutas/nulla.rpy:1271
translate ingles rutanullaa_c3f4063e:

    # nulla "Hacer que su vida tenga algún impacto allá, en tu plano."
    nulla "To make their lives have some impact out there, in your realm."

# game/rutas/nulla.rpy:1272
translate ingles rutanullaa_ada3cca3:

    # nulla "Y que se quede en tu memoria es una buena forma de hacer aquello..."
    nulla "And having them remain in your memory is a good way to achieve that..."

# game/rutas/nulla.rpy:1273
translate ingles rutanullaa_43e84ad1:

    # "Te sorprende un poco sus palabras. Se oyen sinceras, muy consideradas de la situación."
    "You're a bit surprised by his words. They sound sincere, very considerate of the situation."

# game/rutas/nulla.rpy:1276
translate ingles rutanullaa_5997b66d:

    # nulla "Pero no quiero que te encariñes con ellos, solo lo suficiente para rendirles un último favor."
    nulla "But I don't want you to get too attached to them--just enough to pay them one last favor."

# game/rutas/nulla.rpy:1279
translate ingles rutanullaa_ae8769da:

    # nulla "Además... sirve como combustible para el show que quiero darte :)."
    nulla "Besides... it serves as fuel for the show I want to put on for you. :)"

# game/rutas/nulla.rpy:1280
translate ingles rutanullaa_cc220e55:

    # "Retiras lo dicho."
    "You take back what you said."

# game/rutas/nulla.rpy:1281
translate ingles rutanullaa_fbaea027:

    # nulla "Jaa--"
    nulla "Jaa--"

# game/rutas/nulla.rpy:1286
translate ingles rutanullaa_9b84c2c2:

    # nulla "Está bien, mi vida."
    nulla "Alright, mi vida."

# game/rutas/nulla.rpy:1288
translate ingles rutanullaa_9aebdc0d:

    # "Están por entrar al templo, cuando das un paso en falso."
    "You're about to enter the temple when you take a misstep."

# game/rutas/nulla.rpy:1290
translate ingles rutanullaa_6bc0ce19:

    # "Tus pies pisan una baldosa que se hunde. Accionando algún tipo de mecanismo que te traga en el proceso."
    "Your feet step on a tile that sinks, triggering a mechanism that swallows you in the process."

# game/rutas/nulla.rpy:1292
translate ingles rutanullaa_87f6559f:

    # "Y Nulla no es lo suficientemente rápido para agarrarte."
    "And Nulla isn't fast enough to catch you."

# game/rutas/nulla.rpy:1293
translate ingles rutanullaa_e2c83acc:

    # "Mientras caes, ves como algo rojo lo embiste, impidiéndole ir en tu búsqueda."
    "As you fall, you see something red charge at him, preventing him from pursuing you."

# game/rutas/nulla.rpy:1294
translate ingles rutanullaa_0fbef67a:

    # "Estás solo en esto."
    "You're in this alone."

# game/rutas/nulla.rpy:1295
translate ingles rutanullaa_e960d587:

    # "Y tienes miedo."
    "And you're scared."

# game/rutas/nulla.rpy:1296
translate ingles rutanullaa_bb7d117b:

    # "{glitch=20.0}{color=ffffff}{b}No te preocupes...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Don't worry...{/glitch}"

# game/rutas/nulla.rpy:1297
translate ingles rutanullaa_23324768:

    # "{glitch=20.0}{color=ffffff}{b}Iré en cuanto pueda.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I'll be there as soon as I can.{/glitch}"

# game/rutas/nulla.rpy:1299
translate ingles rutanullaa_b46fb51a:

    # "Al aterrizar en el suelo, no hay evidencia de golpe, pues unas manos te atrapan y te dejan suavemente en el suelo."
    "Upon landing, there's no sign of a hard impact, as some hands catch you and gently set you down."

# game/rutas/nulla.rpy:1300
translate ingles rutanullaa_3e07da15:

    # "{glitch=20.0}{color=ffffff}{b}Por favor, ten cuidado.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Please, be careful.{/glitch}"

# game/rutas/nulla.rpy:1301
translate ingles rutanullaa_7dd78e46:

    # "El lugar es espacioso, no hay nada aquí."
    "The place is spacious; there's nothing here."

# game/rutas/nulla.rpy:1302
translate ingles rutanullaa_2b24c5db:

    # "Es una gran sala delimitada por cuatro paredes sin ventanas ni puertas."
    "It's a large room enclosed by four walls with no windows or doors."

# game/rutas/nulla.rpy:1303
translate ingles rutanullaa_3b9ff284:

    # "Estás atrapado hasta nuevo aviso."
    "You're trapped until further notice."

# game/rutas/nulla.rpy:1304
translate ingles rutanullaa_c255b0ab:

    # "Caminas por todo el perímetro, buscando algún rastro que indique una salida o un escondite, porque aquí estás demasiado expuesto."
    "You walk along the entire perimeter, searching for any sign of an exit or a hiding place, because you're far too exposed here."

# game/rutas/nulla.rpy:1305
translate ingles rutanullaa_fb274991:

    # "Eres un blanco fácil."
    "You're an easy target."

# game/rutas/nulla.rpy:1306
translate ingles rutanullaa_725596ed:

    # "Si la figura que ha atacado a Nulla te encuentra, estarás perdido."
    "If the figure that attacked Nulla finds you, you're doomed."

# game/rutas/nulla.rpy:1307
translate ingles rutanullaa_401a1851:

    # "Y el calor no hace más que aumentar, es un calor que sofoca y no hace más que aumentar tu pánico."
    "And the heat only intensifies--it's a suffocating heat that only ramps up your panic."

# game/rutas/nulla.rpy:1308
translate ingles rutanullaa_08f4ebbf:

    # el "¿Así que eres tú?"
    el "So, it's you?"

# game/rutas/nulla.rpy:1309
translate ingles rutanullaa_b1114440:

    # "¿¡!?"
    "?!?!"

# game/rutas/nulla.rpy:1311
translate ingles rutanullaa_55094076:

    # "Giras tu cabeza para buscar a quién ha hablado."
    "You turn your head to see who just spoke."

# game/rutas/nulla.rpy:1313
translate ingles rutanullaa_b6a3dc5d:

    # "Un hombre de cabello azul te mira con una expresión de aburrimiento desde la otra esquina de la sala."
    "A blue-haired man watches you with a bored expression from the far corner of the room."

# game/rutas/nulla.rpy:1314
translate ingles rutanullaa_b6fe0bcb:

    # "Debe ser Quinque..."
    "It must be Quinque..."

# game/rutas/nulla.rpy:1315
translate ingles rutanullaa_e90df7c2:

    # quinque "¿...El reemplazo del Creador?"
    quinque "... The Creator's replacement?"

# game/rutas/nulla.rpy:1316
translate ingles rutanullaa_dd9b8cc0:

    # "¿Qué? Tú no eres el reemplazo de nadie..."
    "What? You're not anyone's replacement..."

# game/rutas/nulla.rpy:1319
translate ingles rutanullaa_eb9601a2:

    # quinque "Pensé que tendrías una apariencia más poderosa."
    quinque "I thought you'd have a more imposing appearance."

# game/rutas/nulla.rpy:1320
translate ingles rutanullaa_50d78a88:

    # quinque "Decepcionante."
    quinque "Disappointing."

# game/rutas/nulla.rpy:1323
translate ingles rutanullaa_6b4e18aa:

    # "Le llamas la atención, será un dios, pero no dejarás que te hable de esa forma."
    "You call him out--he may be a god, but you won't let him speak to you like that."

# game/rutas/nulla.rpy:1326
translate ingles rutanullaa_1d70949b:

    # quinque "Heh."
    quinque "Heh."

# game/rutas/nulla.rpy:1329
translate ingles rutanullaa_a129f648:

    # quinque "Pues Nulla no cree lo mismo."
    quinque "Well, Nulla doesn't think the same thing."

# game/rutas/nulla.rpy:1330
translate ingles rutanullaa_146865e9:

    # quinque "Solo te está utilizando."
    quinque "He's just using you."

# game/rutas/nulla.rpy:1331
translate ingles rutanullaa_ed0a15df:

    # nj "{sc=3}¡Eso no es cierto!{/sc}"
    nj "{sc=3}That's not true!{/sc}"

# game/rutas/nulla.rpy:1337
translate ingles rutanullaa_1d70949b_1:

    # quinque "Heh."
    quinque "Heh."

# game/rutas/nulla.rpy:1339
translate ingles rutanullaa_073277ed:

    # quinque "..."
    quinque "..."

# game/rutas/nulla.rpy:1342
translate ingles rutanullaa_59dbab68:

    # quinque "¿Qué cosa te dijo Nulla como para que estés haciendo esto?"
    quinque "What did Nulla say that's making you do this?"

# game/rutas/nulla.rpy:1343
translate ingles rutanullaa_f14e254f:

    # quinque "¿O es que esto es tu idea, y le prometiste a Nulla dejarlo con vida si es que te ayudaba?"
    quinque "Or is this your idea, and did you promise Nulla to let him live if he helped you?"

# game/rutas/nulla.rpy:1344
translate ingles rutanullaa_d5fc85a5:

    # "No entiendes lo que está hablando, pero no tienes ganas de tentar tu suerte y hacerlo enojar."
    "You don't understand what he's saying, but you don't feel like tempting fate by angering him."

# game/rutas/nulla.rpy:1345
translate ingles rutanullaa_e4d57340:

    # "Por lo que solo lo miras, mientras hace sus preguntas retóricas."
    "But that only makes him angrier."

# game/rutas/nulla.rpy:1346
translate ingles rutanullaa_25f883ff:

    # quinque "¿Crees que el trabajo del Creador y de Septem no es digno?"
    quinque "Do you think the work of the Creator and Septem isn't worthy?"

# game/rutas/nulla.rpy:1347
translate ingles rutanullaa_382e1254:

    # quinque "¿Quieres borrar y empezar de nuevo?"
    quinque "Do you want to wipe everything clean and start over?"

# game/rutas/nulla.rpy:1348
translate ingles rutanullaa_d7160260:

    # quinque "Me das asco."
    quinque "You disgust me."

# game/rutas/nulla.rpy:1349
translate ingles rutanullaa_073277ed:

    # "Woah, okay... eso está de más."
    "Woah, okay... that's enough."

# game/rutas/nulla.rpy:1350
translate ingles rutanullaa_0529ac9a:

    # "Grosero."
    "Rude."

# game/rutas/nulla.rpy:1351
translate ingles rutanullaa_99dc63e6:

    # quinque "Entidades como tú y Nulla, no deberían existir..."
    quinque "Entities like you and Nulla shouldn't exist..."

# game/rutas/nulla.rpy:1352
translate ingles rutanullaa_279cbfc7:

    # quinque "Ugh."
    quinque "Ugh."

# game/rutas/nulla.rpy:1353
translate ingles rutanullaa_2205429b:

    # quinque "Lástima que Septem te quiere vivo."
    quinque "Too bad Septem wants you alive."

# game/rutas/nulla.rpy:1357
translate ingles rutanullaa_4faf53f2:

    # "El instinto de correr te llama."
    "The instinct to run calls out to you."

# game/rutas/nulla.rpy:1358
translate ingles rutanullaa_bb5f198d:

    # "Aunque no tengas a donde ir más allá de las 4 paredes, no importa."
    "Even if there's nowhere to go beyond these four walls, it doesn't matter."

# game/rutas/nulla.rpy:1359
translate ingles rutanullaa_d76e8e03:

    # "Tus piernas te comandan a correr de él."
    "Your legs command you to run from him."

# game/rutas/nulla.rpy:1360
translate ingles rutanullaa_f3cb5555:

    # "Pero antes de poder hacer algún movimiento, te congelas al ver a Quinque."
    "But before you can move, you freeze at the sight of Quinque."

# game/rutas/nulla.rpy:1363
translate ingles rutanullaa_cb80de16:

    # "Necesitas ganar tiempo de alguna u otra forma, ya que no puedes hacer nada para defenderte o pelear contra este Dios."
    "You need to buy some time by any means, since you can't defend yourself or fight against this god."

# game/rutas/nulla.rpy:1364
translate ingles rutanullaa_00cc51a2:

    # nj "¿Qué quieres de mí?"
    nj "What do you want from me?"

# game/rutas/nulla.rpy:1365
translate ingles rutanullaa_54f67a57:

    # "Crees que hacerlo hablar de su plan malévolo funcionará para ganar tiempo..."
    "You figure that making him talk about his evil plan might buy you some time..."

# game/rutas/nulla.rpy:1366
translate ingles rutanullaa_742087df:

    # "Funciona en las películas, así que puede que funcione aquí."
    "It works in the movies, so maybe it'll work here."

# game/rutas/nulla.rpy:1367
translate ingles rutanullaa_15b24ad6:

    # "Quinque te mira con cara de pocos amigos."
    "Quinque looks at you with a scowl."

# game/rutas/nulla.rpy:1368
translate ingles rutanullaa_22deaa80:

    # quinque "¿Crees que soy imbécil?"
    quinque "Do you think I'm an idiot?"

# game/rutas/nulla.rpy:1369
translate ingles rutanullaa_df2befcd:

    # quinque "No voy a perder el tiempo en esto."
    quinque "I'm not going to waste my time on this."

# game/rutas/nulla.rpy:1372
translate ingles rutanullaa_2039c057:

    # "Quinque toma posición de ataque."
    "Quinque takes an attacking stance."

# game/rutas/nulla.rpy:1373
translate ingles rutanullaa_80eaf054:

    # quinque "Prometo no hacerte daño."
    quinque "I promise I won't hurt you."

# game/rutas/nulla.rpy:1375
translate ingles rutanullaa_e3bea074:

    # quinque "Así que quédate quieto."
    quinque "So, stay still."

# game/rutas/nulla.rpy:1378
translate ingles rutanullaa_f490af3d:

    # "Cuando ves que Quinque se abalanza hacia ti de un solo salto, ya es demasiado tarde. Tus pies no responden a tiempo, estás congelado en el lugar sin opción real a moverte."
    "When you see Quinque lunge toward you in one bound, it's already too late. Your feet don't respond in time; you're frozen in place with no real option to move."

# game/rutas/nulla.rpy:1379
translate ingles rutanullaa_86ddc45e:

    # "Al ver sus colmillos acercarse peligrosamente a tu campo de visión, antepones tus brazos entre tu cuerpo y Quinque."
    "Seeing his fangs dangerously close to your field of vision, you raise your arms between yourself and Quinque."

# game/rutas/nulla.rpy:1381
translate ingles rutanullaa_39d5ca59:

    # "En un intento patético de formar un escudo."
    "In a pathetic attempt to form a shield."

# game/rutas/nulla.rpy:1384
translate ingles rutanullaa_070c23c3:

    # "Y cierras los ojos por miedo a lo que pueda pasar."
    "And you close your eyes in fear of what might happen."

# game/rutas/nulla.rpy:1386
translate ingles rutanullaa_31d30660:

    # "{glitch=20.0}{color=ffffff}{b}No dejes que la marioneta cierre sus ojos, mi vida.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Don't let the puppet close its eyes, mi vida.{/glitch}"

# game/rutas/nulla.rpy:1392
translate ingles rutanullaa_254c21d5:

    # "Es... ¿Nulla?"
    "It's... Nulla?"

# game/rutas/nulla.rpy:1394
translate ingles rutanullaa_36e4c2f3:

    # "Ambos caen al suelo, Nulla con una forma diferente y Quinque parece estar totalmente mortificado por esto."
    "Both of you fall to the ground--Nulla in a different form and Quinque looking utterly horrified."

# game/rutas/nulla.rpy:1395
translate ingles rutanullaa_733e40d6:

    # "Se le ve atrerrado."
    "He looks terrified."

# game/rutas/nulla.rpy:1397
translate ingles rutanullaa_eb6d702c:

    # quinque "Duae..."
    quinque "Duae..."

# game/rutas/nulla.rpy:1399
translate ingles rutanullaa_293921d1:

    # nulla "¿Qué pasa, querido?"
    nulla "What's wrong, dear?"

# game/rutas/nulla.rpy:1400
translate ingles rutanullaa_3e298d3f:

    # "Incluso la voz de Nulla ha cambiado, se parece a la voz dura de la entidad que Nulla ha matado en el templo de Quattor."
    "Even Nulla's voice has changed--it now resembles the harsh tone of the entity he killed in the Quattor temple."

# game/rutas/nulla.rpy:1401
translate ingles rutanullaa_db80c73a:

    # "Duae... Nulla está en el cuerpo de Duae."
    "Duae... Nulla is in Duae's body."

# game/rutas/nulla.rpy:1402
translate ingles rutanullaa_578bd358:

    # "Las palabras de Nulla hacen reaccionar a Quinque, quien empuja sin mucha fuerza a Nulla y se aleja saltando hacia atrás."
    "Nulla's words prompt Quinque to react; he gives Nulla a light shove and jumps back."

# game/rutas/nulla.rpy:1405
translate ingles rutanullaa_c588aa6f:

    # quinque "¡Maldito enfermo!"
    quinque "Damn sicko!"

# game/rutas/nulla.rpy:1406
translate ingles rutanullaa_c4211f61:

    # "Le grita rechinando los dientes. Él intenta mostrarse enojado pero la expresión de terror no deja su cara."
    "He shouts, gritting his teeth. He tries to appear angry, but his face betrays his terror."

# game/rutas/nulla.rpy:1407
translate ingles rutanullaa_c220d1ee:

    # "Tiene miedo."
    "He's scared."

# game/rutas/nulla.rpy:1408
translate ingles rutanullaa_9ff26c82:

    # quinque "¿¡Qué mierda crees que haces!?"
    quinque "What the hell do you think you're doing!?"

# game/rutas/nulla.rpy:1409
translate ingles rutanullaa_acfa2719:

    # quinque "No tienes dignidad."
    quinque "You have no dignity."

# game/rutas/nulla.rpy:1410
translate ingles rutanullaa_1f18e025:

    # "Luego te busca a ti con la mirada."
    "Then he searches for you with his gaze."

# game/rutas/nulla.rpy:1413
translate ingles rutanullaa_306c31a1:

    # quinque "¿¡Es que no lo ves!?"
    quinque "Can't you see it!?"

# game/rutas/nulla.rpy:1414
translate ingles rutanullaa_ee93f94b:

    # quinque "¡Estás ayudando a un enfermo!"
    quinque "You're helping a sicko!"

# game/rutas/nulla.rpy:1415
translate ingles rutanullaa_0dec8832:

    # quinque "¡Este mundo aún puede recuperarse!"
    quinque "This world can still be saved!"

# game/rutas/nulla.rpy:1418
translate ingles rutanullaa_fd76b9a2:

    # quinque "Por favor..."
    quinque "Please..."

# game/rutas/nulla.rpy:1419
translate ingles rutanullaa_d2ba17a3:

    # "Te grita ahora suplicando..."
    "He shouts at you now, pleading..."

# game/rutas/nulla.rpy:1426
translate ingles rutanullaa_b098b5d5:

    # "{glitch=20.0}{color=ffffff}{b}¿De verdad has seleccionado esto?...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Have you really chosen this?...{/glitch}"

# game/rutas/nulla.rpy:1427
translate ingles rutanullaa_1d3f18cf:

    # "{glitch=20.0}{color=ffffff}{b}Ja--{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Ja--{/glitch}"

# game/rutas/nulla.rpy:1428
translate ingles rutanullaa_9be418c3:

    # "{glitch=20.0}{color=ffffff}{b}Supongo que ha sido para saber que pasaría, para llevarme la contraria... que lindo.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I guess it was to see what would happen, to defy me... how lovely.{/glitch}"

# game/rutas/nulla.rpy:1429
translate ingles rutanullaa_f0610074:

    # "{glitch=20.0}{color=ffffff}{b}Bueno, de igual manera no te voy a dejar hacer eso, [nombrejugador].{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Well, either way, I'm not going to let you do that, [nombrejugador].{/glitch}"

# game/rutas/nulla.rpy:1430
translate ingles rutanullaa_9bbab849:

    # "{glitch=20.0}{color=ffffff}{b}Pues la marioneta la controlas tanto tú como yo.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}After all, you and I control the puppet together.{/glitch}"

# game/rutas/nulla.rpy:1431
translate ingles rutanullaa_7f2faad1:

    # "{glitch=20.0}{color=ffffff}{b}:){/glitch}"
    "{glitch=20.0}{color=ffffff}{b}:){/glitch}"

# game/rutas/nulla.rpy:1435
translate ingles rutanullaa_c12e95b4:

    # quinque "No te quedes ahí parado mirando como un idiota, ¡haz algo! ¡Detenlo!"
    quinque "Don't just stand there staring like an idiot--do something! Stop him!"

# game/rutas/nulla.rpy:1436
translate ingles rutanullaa_45bb95fa:

    # quinque "Un ser con tu poder puede-- ¡UHG!"
    quinque "A being with your power can--UHG!"

# game/rutas/nulla.rpy:1437
translate ingles rutanullaa_dc5015a4:

    # "Nulla hace un gesto con sus manos y una sombra con forma de mano sale del suelo y agarra a Quinque del brazo lanzándolo contra la pared."
    "Nulla gestures and a hand-shaped shadow emerges from the ground, grabbing Quinque by the arm and hurling him against the wall."

# game/rutas/nulla.rpy:1438
translate ingles rutanullaa_61d159fc:

    # "Nulla ríe un poco antes de gritar de vuelta."
    "Nulla laughs briefly before shouting back."

# game/rutas/nulla.rpy:1440
translate ingles rutanullaa_23597a11:

    # nulla "Vamos! no te quedes ahí parado y ladrando como un perro, ¡haz algo!"
    nulla "Come on! Don't just stand there barking like a dog--do something!"

# game/rutas/nulla.rpy:1441
translate ingles rutanullaa_92a3ce62:

    # "Se burla el pelinegro."
    "The white-haired one mocks."

# game/rutas/nulla.rpy:1442
translate ingles rutanullaa_eb468ee9:

    # quinque "¡Púdrete!"
    quinque "Drop dead!"

# game/rutas/nulla.rpy:1443
translate ingles rutanullaa_61fa11be:

    # "Quinque toma posición de defensa, pero aun así no hace nada para enfrentar y atacar a Nulla."
    "Quinque assumes a defensive stance, yet does nothing to confront and attack Nulla."

# game/rutas/nulla.rpy:1444
translate ingles rutanullaa_63209e44:

    # nulla "¡¡¡Ohh!!! Ya entiendo..."
    nulla "Ohh!!! I get it now..."

# game/rutas/nulla.rpy:1445
translate ingles rutanullaa_11ae90e2:

    # nulla "Tienes miedo."
    nulla "You're scared."

# game/rutas/nulla.rpy:1446
translate ingles rutanullaa_25ed641a:

    # "Suelta una risita."
    "He lets out a small laugh."

# game/rutas/nulla.rpy:1447
translate ingles rutanullaa_e18190c6:

    # nulla "Jajajaja-- Me encanta saber que no puedes hacer nada al respecto."
    nulla "Jajajaja--I love knowing that you can't do anything about it."
#EDITAR
# game/rutas/nulla.rpy:1448
translate ingles rutanullaa_24794333:
    # nulla "Pero vamos~ dame un poco de contenido al menos..."
    nulla "But come on~ at least give me some content..."

# game/rutas/nulla.rpy:1449
translate ingles rutanullaa_a20cefa7_17:
    # "..."
    "..."

# game/rutas/nulla.rpy:1450
translate ingles rutanullaa_542f87fc:
    # "¿Realmente este es Nulla?"
    "Is this really Nulla?"

# game/rutas/nulla.rpy:1451
translate ingles rutanullaa_18dd1b28:
    # "{sc=3}No... él no es así.{/sc}"
    "{sc=3}No... he's not like that.{/sc}"

# game/rutas/nulla.rpy:1452
translate ingles rutanullaa_d7c4af77:
    # "{sc=3} ¿Cierto?"
    "{sc=3}Right?{/sc}"

# game/rutas/nulla.rpy:1453
translate ingles rutanullaa_63427f16:
    # "No vas a mentir, te cuesta un poco comprender el cambio de actitud que está teniendo..."
    "You're not going to lie, you find it hard to understand the change in attitude he's displaying..."

# game/rutas/nulla.rpy:1457
translate ingles rutanullaa_049825bb:
    # "No te gusta que se esté burlando..."
    "You don't like that he's mocking him..."

# game/rutas/nulla.rpy:1458
translate ingles rutanullaa_ac21dd96:
    # "Y parece estar fuera de sí..."
    "And he seems to be beside himself..."

# game/rutas/nulla.rpy:1460
translate ingles rutanullaa_077af11d:
    # "Gritas su nombre y le dices que por favor trate esta muerte con respeto."
    "You shout his name and tell him to please treat this death with respect."

# game/rutas/nulla.rpy:1461
translate ingles rutanullaa_a2df4916:
    # "Nulla te mira mientras intenta calmar su respiración."
    "Nulla looks at you while trying to calm his breathing."

# game/rutas/nulla.rpy:1462
translate ingles rutanullaa_efe6273f:
    # "Sus ojos se ven extraños."
    "His eyes look strange."

# game/rutas/nulla.rpy:1463
translate ingles rutanullaa_cf39dac2:
    # "Poco a poco pestañea y su expresión se torna más normal."
    "He blinks slowly and his expression becomes more normal."

# game/rutas/nulla.rpy:1464
translate ingles rutanullaa_48f2e0a6:
    # nulla "¿Ah? pero.."
    nulla "Huh? But..."

# game/rutas/nulla.rpy:1465
translate ingles rutanullaa_f0c6c7f0:
    # nulla "Pensé que querías leer algo más interesante..."
    nulla "I thought you wanted to read something more interesting..."

# game/rutas/nulla.rpy:1466
translate ingles rutanullaa_76e0fd44:
    # nulla "Ya sabes, para no hacerlo tan corto."
    nulla "You know, so it's not so brief."

# game/rutas/nulla.rpy:1467
translate ingles rutanullaa_137b62da:
    # nulla "¿No te está gustando?"
    nulla "Aren't you liking it?"

# game/rutas/nulla.rpy:1468
translate ingles rutanullaa_dc455a4d:
    # "No respondes, simplemente lo miras con incredulidad."
    "You don't reply; you just look at him in disbelief."

# game/rutas/nulla.rpy:1469
translate ingles rutanullaa_c0f405f2:
    # "{sc=3} Debe ser la influencia del cuerpo.... ¿cierto?{sc=3}"
    "{sc=3}It must be the influence of the body... right?{/sc}"

# game/rutas/nulla.rpy:1470
translate ingles rutanullaa_409f8636_14:
    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:1471
translate ingles rutanullaa_8a9a3802:
    # nulla "Tienes razón."
    nulla "You're right."

# game/rutas/nulla.rpy:1473
translate ingles rutanullaa_815827fe:
    # "Sin más, con sus manos agarran nuevamente a la entidad, que más que un Dios, se asemeja a un animal atrapado."
    "Without further ado, he grabs the entity once again, which, more than a god, resembles a trapped animal."

# game/rutas/nulla.rpy:1474
translate ingles rutanullaa_f66689de:
    # "Algo hace que el Estandarte mire hacia arriba."
    "Something makes the Symbol look upward."

# game/rutas/nulla.rpy:1479
translate ingles rutanullaa_8ba8ead0:
    # "No crees necesario limitar a Nulla en sus acciones."
    "You don't think it's necessary to restrict Nulla's actions."

# game/rutas/nulla.rpy:1480
translate ingles rutanullaa_94e35cd3:
    # "Después de todo, nada de esto importa."
    "After all, none of this matters."

# game/rutas/nulla.rpy:1481
translate ingles rutanullaa_44f358f4:
    # "Solo es un personaje más que decora esta escena."
    "He's just another character decorating this scene."

# game/rutas/nulla.rpy:1482
translate ingles rutanullaa_4d43ad3b:
    # "Sin mucho trasfondo..."
    "Without much backstory..."

# game/rutas/nulla.rpy:1484
translate ingles rutanullaa_3db5bb49:
    # "Nulla invoca nuevamente a sus manos, tomando por todas las extremidades a Quinque."
    "Nulla summons his hands once more, seizing Quinque by all his limbs."

# game/rutas/nulla.rpy:1485
translate ingles rutanullaa_8e55c4af:
    # "Las garras de sus manos hacen hoyos en la piel del Estandarte."
    "The claws of his hands punch holes in the Symbol's skin."

# game/rutas/nulla.rpy:1486
translate ingles rutanullaa_08fd3227:
    # "Y un líquido similar a la sangre sale de sus heridas."
    "And a blood-like liquid oozes from his wounds."

# game/rutas/nulla.rpy:1488
translate ingles rutanullaa_b636d1c4:
    # "Quinque sisea, lo que hace que Nulla ría nuevamente."
    "Quinque hisses, making Nulla laugh once more."

# game/rutas/nulla.rpy:1490
translate ingles rutanullaa_8e121b41:
    # "Nulla se materializa al lado de Quinque, quien aún se encuentra en el suelo, contra la pared."
    "Nulla materializes next to Quinque, who remains on the floor, pressed against the wall."

# game/rutas/nulla.rpy:1491
translate ingles rutanullaa_6d0d6972:
    # quinque "No te voy a dar el gusto."
    quinque "I'm not going to give you the pleasure."

# game/rutas/nulla.rpy:1492
translate ingles rutanullaa_282cc1ba:
    # quinque "Si quieres pelear, hazlo con tu cara."
    quinque "If you want to fight, do it with your own face."

# game/rutas/nulla.rpy:1493
translate ingles rutanullaa_e3242bd5:
    # quinque "Cobarde."
    quinque "Coward."

# game/rutas/nulla.rpy:1494
translate ingles rutanullaa_5c08f590:
    # "Nulla lo mira por un segundo, antes de susurrarle algo al oído."
    "Nulla looks at him for a second before whispering something in his ear."

# game/rutas/nulla.rpy:1495
translate ingles rutanullaa_9fdf8ed6:
    # "El cambio de expresión es inmediato, Quinque frunce el ceño y cruje los dientes."
    "His expression changes immediately; Quinque frowns and grits his teeth."

# game/rutas/nulla.rpy:1496
translate ingles rutanullaa_db9ce95c:
    # "Esta vez si reacciona con un ataque, optando por pegarle una cachetada que resuena en toda la sala."
    "This time, he reacts with an attack, slapping him with a sound that echoes through the room."

# game/rutas/nulla.rpy:1497
translate ingles rutanullaa_abd5c394:
    # nulla "Ouch~ ¿por qué me haces esto?"
    nulla "Ouch~ why are you doing this to me?"

# game/rutas/nulla.rpy:1498
translate ingles rutanullaa_e3c99938:
    # quinque "¡Qué te calles, maldita escoria sin dignidad!"
    quinque "Shut up, you damn scum without dignity!"

# game/rutas/nulla.rpy:1499
translate ingles rutanullaa_9c680615:
    # nulla "Hmmj- ja ja ja ja."
    nulla "Hmmj--ja ja ja ja."
    
# game/rutas/nulla.rpy:1500
translate ingles rutanullaa_f26dbb2a:
    # nulla "Sigues siendo igual de irritable."
    nulla "You're still just as irritable."

# game/rutas/nulla.rpy:1501
translate ingles rutanullaa_e41a1d75:
    # nulla "No te voy a soltar hasta que me des una pelea digna para mi [nombrejugador]."
    nulla "I'm not going to let you go until you give me a fight worthy of my [nombrejugador]."

# game/rutas/nulla.rpy:1502
translate ingles rutanullaa_4e410cb2:
    # "Nuevamente las manos manejan a Quinque como si de una muñeca de trapo se tratase y lo tiran contra otra pared."
    "Once again, the hands manipulate Quinque as if he were a rag doll, hurling him against another wall."

# game/rutas/nulla.rpy:1503
translate ingles rutanullaa_a20cefa7_18:
    # "..."
    "..."

# game/rutas/nulla.rpy:1505
translate ingles rutanullaa_e6bd1163:
    # "Él choca contra la pared y cae como un saco de papas al suelo, boca arriba."
    "He crashes into the wall and falls to the ground like a sack of potatoes, face up."

# game/rutas/nulla.rpy:1506
translate ingles rutanullaa_1b06ed8a:
    # "Justo en lo que parece ser una entrada de luz."
    "Right where there seems to be a patch of light."

# game/rutas/nulla.rpy:1507
translate ingles rutanullaa_a072b457:
    # "Quinque mira hacia arriba."
    "Quinque looks up."

# game/rutas/nulla.rpy:1512
translate ingles rutanullaa_9aef2308:
    # quinque "¡Unum!"
    quinque "Unum!"

# game/rutas/nulla.rpy:1513
translate ingles rutanullaa_ff26ff1f:
    # "Grita pidiendo ayuda al sol."
    "He shouts, calling for help from the sun."

# game/rutas/nulla.rpy:1514
translate ingles rutanullaa_10d8d387:
    # quinque "¡Sal de aquí!"
    quinque "Get out of here!"

# game/rutas/nulla.rpy:1515
translate ingles rutanullaa_b7f65c24:
    # "... no es un grito de ayuda."
    "... It's not a cry for help."

# game/rutas/nulla.rpy:1516
translate ingles rutanullaa_e9606061:
    # "Le grita para evitar su mismo destino."
    "He shouts at Unum to avoid the fate he's headed for."

# game/rutas/nulla.rpy:1517
translate ingles rutanullaa_dc505be4:
    # quinque "No hay caso con pelear, con este suplantador a su lado, él-- uhg!"
    quinque "There's no point fighting with this impostor by his side, he--uhg!"

# game/rutas/nulla.rpy:1519
translate ingles rutanullaa_6c1253dd:
    # "Una de las tantas manos atraviesa a Quinque en el pecho, extrayendo la esencia de su cuerpo."
    "One of the many hands pierces Quinque's chest, extracting the essence from his body."

# game/rutas/nulla.rpy:1520
translate ingles rutanullaa_144e8f87:
    # nulla "Esto ya no es divertido..."
    nulla "This is no longer fun..."

# game/rutas/nulla.rpy:1521
translate ingles rutanullaa_f95f6b29:
    # "Y Quinque cae al suelo inmóvil, poco a poco se va desintegrando."
    "And Quinque falls to the ground motionless, slowly disintegrating."

# game/rutas/nulla.rpy:1523
translate ingles rutanullaa_9cad87ac:
    # "Nulla vuelve a tu lado, y te ofrece la esencia."
    "Nulla returns to your side and offers you the essence."

# game/rutas/nulla.rpy:1524
translate ingles rutanullaa_a71081c1:
    # nulla "[nombrejugador], no la comas aún."
    nulla "[nombrejugador], don't eat it yet."

# game/rutas/nulla.rpy:1527
translate ingles rutanullaa_f3e0a8ca:
    # "Te llevas la esencia de la boca y..."
    "You take the essence from your mouth and..."

# game/rutas/nulla.rpy:1529
translate ingles rutanullaa_7aeb2385:
    # "Te congelas ahí mismo."
    "...You freeze right there."

# game/rutas/nulla.rpy:1530
translate ingles rutanullaa_8304d6fe:
    # "{glitch=20.0}{color=ffffff}{b}A este punto creo que solo lo haces para sacarme de quicio.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}At this point, I think you're just doing it to drive me crazy.{/glitch}"

# game/rutas/nulla.rpy:1531
translate ingles rutanullaa_a1e90f76:
    # "{glitch=20.0}{color=ffffff}{b}Lástima que no te daré el gusto :){/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Too bad I won't give you that pleasure. :){/glitch}"

# game/rutas/nulla.rpy:1532
translate ingles rutanullaa_784d1bfc:
    # "{glitch=20.0}{color=ffffff}{b}Recuerda, yo controlo también a tu marioneta.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Remember, I also control your puppet.{/glitch}"

# game/rutas/nulla.rpy:1533
translate ingles rutanullaa_80af32af:
    # "{glitch=20.0}{color=ffffff}{b}Ja ja ja.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Ja ja ja.{/glitch}"

# game/rutas/nulla.rpy:1534
translate ingles rutanullaa_6c1bed79:
    # "¿Acaso no vas a conseguir ningún bad end en esta ruta?"
    "Aren't you going to get any bad ends in this route?"

# game/rutas/nulla.rpy:1535
translate ingles rutanullaa_260fb5a8:
    # "{glitch=20.0}{color=ffffff}{b}No si puedo evitarlo, mi vida.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Not if I can help it, mi vida.{/glitch}"

# game/rutas/nulla.rpy:1541
translate ingles rutanullaa_374a7f26:
    # "Detrás de Nulla puedes ver y escuchar como la pared se rompe en pedazos."
    "Behind Nulla, you can see and hear the wall shatter into pieces."

# game/rutas/nulla.rpy:1542
translate ingles rutanullaa_f253b8c8:
    # "Una figura que ya conoces aparece detrás de todo el polvo que produce las piedras pulverizadas."
    "A familiar figure appears behind the dust of the pulverized stones."

# game/rutas/nulla.rpy:1544
translate ingles rutanullaa_c7139f61:
    # "Es Unum..."
    "It's Unum..."

# game/rutas/nulla.rpy:1545
translate ingles rutanullaa_46d1b8f1:
    # "Pero se ve aterrador."
    "But he looks terrifying."
    
# game/rutas/nulla.rpy:1546
translate ingles rutanullaa_1a230c15:
    # "Nulla también está mirándolo, solo por un segundo y luego voltea nuevamente hacia ti."
    "Nulla watches him for a moment before turning back to you."

# game/rutas/nulla.rpy:1547
translate ingles rutanullaa_79bf91a2:
    # "Unum corre en dirección a ustedes, materializando unos látigos en sus manos."
    "Unum runs toward you, materializing whips in his hands."

# game/rutas/nulla.rpy:1548
translate ingles rutanullaa_b019635a:
    # nulla "Sujétala."
    nulla "Hold it."

# game/rutas/nulla.rpy:1549
translate ingles rutanullaa_e99ef09d:
    # "Tomas la esencia rápidamente, apretándola contra tu pecho, como si de un tesoro se tratase."
    "You quickly grab the essence, pressing it against your chest as if it were a treasure."

# game/rutas/nulla.rpy:1551
translate ingles rutanullaa_89f66f45:
    # "Y te alegras de haberlo hecho a tiempo porque Nulla te agarra de la cintura y te tira junto a él al vacío."
    "And you're glad you did it in time, because Nulla grabs you by the waist and pulls you into the Void with him."

# game/rutas/nulla.rpy:1554
translate ingles rutanullaa_5e33d8a7:
    # nulla "Escucha, tenemos que deshacernos de él ahora, o sino el calor derretirá a la marioneta de aquí a mañana..."
    nulla "Listen, we have to get rid of him now, or else the heat will melt the puppet by tomorrow..."

# game/rutas/nulla.rpy:1557
translate ingles rutanullaa_498e26e9:
    # nulla "Unum está gastado todo su combustible y dentro de poco liberará esa energía en una explosión..."
    nulla "Unum has used up all his fuel, and soon he'll release that energy in an explosion..."

# game/rutas/nulla.rpy:1558
translate ingles rutanullaa_cddfceb0:
    # nulla "Matará a todo ser hecho de carne y hueso."
    nulla "He'll kill every creature made of flesh and bone."

# game/rutas/nulla.rpy:1559
translate ingles rutanullaa_8025d22e:
    # nulla "Tu marioneta incluida."
    nulla "Including your puppet."

# game/rutas/nulla.rpy:1562
translate ingles rutanullaa_609d61cd:
    # nulla "Sé lo que dice el trato. Y sé que hemos adelantado el trabajo, pero..."
    nulla "I know what the deal says. And I know we've advanced the work, but..."
    
# game/rutas/nulla.rpy:1565
translate ingles rutanullaa_61b4bf22:
    # nulla "¡Piensa que gracias a esto podremos tener dos días solo para nosotros!"
    nulla "Just think, thanks to this we can have two days all to ourselves!"

# game/rutas/nulla.rpy:1566
translate ingles rutanullaa_3361d096:
    # nulla "Te prometo que lo haré valer."
    nulla "I promise I'll make it worthwhile."

# game/rutas/nulla.rpy:1567
translate ingles rutanullaa_ec0b7803:
    # nulla "Pero debemos eliminar a Unum para no poner en peligro a la marioneta."
    nulla "But we must eliminate Unum to avoid endangering the puppet."

# game/rutas/nulla.rpy:1570
translate ingles rutanullaa_717c8664:
    # nulla "Lo siento, no me voy a arriesgar a perder el medio de conexión que tengo contigo."
    nulla "I'm sorry, I won't risk losing the connection I have with you."

# game/rutas/nulla.rpy:1571
translate ingles rutanullaa_415a4d38:
    # nulla "Tienes que entenderme."
    nulla "You have to understand."

# game/rutas/nulla.rpy:1572
translate ingles rutanullaa_ec5c2b79:
    # nulla "Lo haré rápido, no jugaré esta vez."
    nulla "I'll do it quickly; I won't mess around this time."

# game/rutas/nulla.rpy:1573
translate ingles rutanullaa_d3860c14:
    # nulla "No voy a tentar a la suerte con Unum."
    nulla "I'm not going to tempt fate with Unum."

# game/rutas/nulla.rpy:1575
translate ingles rutanullaa_a20cefa7_19:
    # "..."
    "..."

# game/rutas/nulla.rpy:1577
translate ingles rutanullaa_0bbb825d:
    # "Nulla se aferra a tu cuerpo, quita con cuidado tus manos que hacen de barrera entre tú y él.... y coloca su cabeza en tu pecho mientras te mira."
    "Nulla clings to your body, carefully removing your hands that act as a barrier between you and him... and places his head on your chest as he looks at you."

# game/rutas/nulla.rpy:1578
translate ingles rutanullaa_feeae311:
    # nulla "por favor..."
    nulla "Please..."

# game/rutas/nulla.rpy:1579
translate ingles rutanullaa_25f2297c:
    # "Pero no puedes pensar que esto es raro... porque tiene la imagen de un dios muerto."
    "But you can't help but think that this is strange... because he has the image of a dead god."

# game/rutas/nulla.rpy:1580
translate ingles rutanullaa_1fb3f6a0:
    # nulla "Oh! me he olvidado de eso."
    nulla "Oh! I forgot about that."

# game/rutas/nulla.rpy:1582
translate ingles rutanullaa_813a2618:
    # "Nulla se transforma nuevamente en él."
    "Nulla transforms back into himself."

# game/rutas/nulla.rpy:1583
translate ingles rutanullaa_850ce265:
    # "Volviendo a lo que era antes."
    "Returning to what he was before."

# game/rutas/nulla.rpy:1584
translate ingles rutanullaa_dc389f6f:
    # nulla "¿Mejor?"
    nulla "Better?"

# game/rutas/nulla.rpy:1588
translate ingles rutanullaa_f02062bf:
    # "Él solo sonríe complacido con tu respuesta."
    "He simply smiles, pleased with your response."

# game/rutas/nulla.rpy:1589
translate ingles rutanullaa_81556825:
    # "Y juras que puedes ver corazones en sus ojos..."
    "And you swear you can see hearts in his eyes..."

# game/rutas/nulla.rpy:1593
translate ingles rutanullaa_c4306585:
    # "Nulla te mira sorprendido."
    "Nulla looks at you in surprise."

# game/rutas/nulla.rpy:1594
translate ingles rutanullaa_c3db08c7:
    # "Por un segundo puedes ver como tu respuesta le ha causado tristeza. Pero rápidamente formula una sonrisa."
    "For a moment, you see that your response has caused him sadness, but he quickly forms a smile."


# game/rutas/nulla.rpy:1595
translate ingles rutanullaa_17611aee:
    # nulla "Puedo cambiar mi apariencia si lo quieres..."
    nulla "I can change my appearance if you want..."

# game/rutas/nulla.rpy:1596
translate ingles rutanullaa_d6112281:
    # nulla "Pero hablaremos de eso después."
    nulla "But we'll talk about that later."

# game/rutas/nulla.rpy:1599
translate ingles rutanullaa_4c7ec8a3_1:
    # nulla "Ahora..."
    nulla "Now..."

# game/rutas/nulla.rpy:1600
translate ingles rutanullaa_fe300844:
    # nulla "Solo falta esto para regresar a casa."
    nulla "This is all that's left to get home."

# game/rutas/nulla.rpy:1601
translate ingles rutanullaa_00f178c0:
    # nulla "Te lo prometo..."
    nulla "I promise you..."

# game/rutas/nulla.rpy:1602
translate ingles rutanullaa_cafc8d92:
    # nulla "Podremos cocinar o leer algún libro de la biblioteca, si lo deseas."
    nulla "We can cook or read a book from the library, if you like."

# game/rutas/nulla.rpy:1603
translate ingles rutanullaa_c5ddf89d:
    # nulla "Pero prefiero llevarte a ese lugar que te he contado en la mañana."
    nulla "But I'd rather take you to that place I told you about this morning."

# game/rutas/nulla.rpy:1604
translate ingles rutanullaa_9b8783e7:
    # nulla "Aunque, podríamos hacer todo si es que el tiempo nos alcanza."
    nulla "Although, we could do everything if time permits."

# game/rutas/nulla.rpy:1605
translate ingles rutanullaa_737dccdc:
    # "Odias admitirlo, pero..."
    "You hate to admit it, but..."

# game/rutas/nulla.rpy:1606
translate ingles rutanullaa_1f898381:
    # "No puedes llevarle la contraria."
    "You just can't argue with him."

# game/rutas/nulla.rpy:1607
translate ingles rutanullaa_ddb1e497:
    # "Quieras o no, terminarás haciendo lo que este hombre pida."
    "Whether you like it or not, you'll end up doing whatever this man asks."

# game/rutas/nulla.rpy:1608
translate ingles rutanullaa_4b646b88:
    # "Y él lo sabe..."
    "And he knows it..."

# game/rutas/nulla.rpy:1609
translate ingles rutanullaa_ae902a0e:
    # "Sabes que con su cara y sus palabras pintadas con azúcar puede moldearte como quiera..."
    "You know that with his sugary words and that face, he can mold you however he wants..."

# game/rutas/nulla.rpy:1613
translate ingles rutanullaa_ca74c9b3:
    # "Nulla sonríe."
    "Nulla smiles."

# game/rutas/nulla.rpy:1614
translate ingles rutanullaa_48e5c29c:
    # nulla "¿Solo dirás eso?"
    nulla "Is that all you're going to say?"

# game/rutas/nulla.rpy:1615
translate ingles rutanullaa_fb89383d:
    # "¿Qué más quiere?..."
    "What else does he want?..."

# game/rutas/nulla.rpy:1616
translate ingles rutanullaa_6cff0b26:
    # nj "{glitch=20.0}{color=ffffff}{b}¡Está bien, mi amorrrr!{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}Alright, mi amorrrr!{/glitch}"

# game/rutas/nulla.rpy:1617
translate ingles rutanullaa_13d6cfcf:
    # "¡Uhg! ¡¿Quien ha sido el responsable de darle tanto poder a este desquiciado!?"
    "Uhg! Who's responsible for giving this lunatic so much power!?"

# game/rutas/nulla.rpy:1618
translate ingles rutanullaa_e5e55a26:
    # nj "{glitch=20.0}{color=ffffff}{b}Guapo, poderoso, bello, hermoso--.{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}Handsome, powerful, beautiful, gorgeous--{/glitch}"

# game/rutas/nulla.rpy:1619
translate ingles rutanullaa_3ed36142:
    # "{sc=3}¡Haz que pareeeee!{/sc}"
    "{sc=3}Make it stoppppp!!!{/sc}"

# game/rutas/nulla.rpy:1621
translate ingles rutanullaa_e39924a2:
    # "Nulla ríe."
    "Nulla laughs."

# game/rutas/nulla.rpy:1622
translate ingles rutanullaa_3a9c28d9:
    # nulla "Gracias por ser mi confidente, mi vida <3"
    nulla "Thank you for being my confidant, mi vida. <3"

# game/rutas/nulla.rpy:1626
translate ingles rutanullaa_e70a969b:
    # "La mirada de Nulla cambia ligeramente. Y solo te observa sin comentar nada."
    "Nulla's gaze shifts slightly, and he just watches you without a word."

# game/rutas/nulla.rpy:1627
translate ingles rutanullaa_1087487a:
    # "Para luego sonreir de medio lado."
    "Then he gives you a half-smile."

# game/rutas/nulla.rpy:1628
translate ingles rutanullaa_6cff0b26_1:
    # nj "{glitch=20.0}{color=ffffff}{b}¡Está bien, mi amorrrr!{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}Alright, mi amorrrr!{/glitch}"

# game/rutas/nulla.rpy:1629
translate ingles rutanullaa_6d882296:
    # "¡Uhg! Maldito. ¡Al final hace lo que se le da la gana!"
    "Uhg! Damn it. In the end, he does whatever he wants!"

# game/rutas/nulla.rpy:1630
translate ingles rutanullaa_e5e55a26_1:
    # nj "{glitch=20.0}{color=ffffff}{b}Guapo, poderoso, bello, hermoso--.{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}Handsome, powerful, beautiful, gorgeous--{/glitch}"

# game/rutas/nulla.rpy:1631
translate ingles rutanullaa_3ed36142_1:
    # "{sc=3}¡Haz que pareeeee!{/sc}"
    "{sc=3}Make it stoppppp!!!{/sc}"

# game/rutas/nulla.rpy:1632
translate ingles rutanullaa_e39924a2_1:
    # "Nulla ríe."
    "Nulla laughs."

# game/rutas/nulla.rpy:1634
translate ingles rutanullaa_409f8636_15:
    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:1635
translate ingles rutanullaa_ab903062:
    # nulla "Bien, hora de terminar esto."
    nulla "Alright, time to finish this."

# game/rutas/nulla.rpy:1639
translate ingles rutanullaa_c5500310:
    # "Antes de salir nuevamente al dominio de Quinque, Nulla cambia de forma sin previo aviso."
    "Before re-entering Quinque's domain, Nulla changes form without warning."

# game/rutas/nulla.rpy:1640
translate ingles rutanullaa_da2fe0a5:
    # "Casi empujas a Nulla de la sorpresa."
    "You're nearly knocked back by surprise."

# game/rutas/nulla.rpy:1641
translate ingles rutanullaa_16406f80:
    # nulla "Esto lo hará más rápido."
    nulla "This will speed things up."

# game/rutas/nulla.rpy:1642
translate ingles rutanullaa_a20cefa7_20:
    # "..."
    "..."

# game/rutas/nulla.rpy:1644
translate ingles rutanullaa_627e7fad:
    # "Después de un largo suspiro, Nulla te saca del vacío."
    "After a long sigh, Nulla pulls you out of the Void."

# game/rutas/nulla.rpy:1645
translate ingles rutanullaa_e22212de:
    # "Mismo lugar que antes, pero no ves a Unum."
    "The same place as before, but you don't see Unum."

# game/rutas/nulla.rpy:1649
translate ingles rutanullaa_b8eb0d53:
    # "Lo buscas con los ojos al igual que Nulla, pero es imposible con el brillo extraño que tiene el lugar. Es un brillo que devora todo objeto y lo convierte en algo imposible de percibir."
    "You search for him with your eyes, just as Nulla does, but it's impossible due to the strange glare in the area--a glare that devours every object and renders it impossible to discern."

# game/rutas/nulla.rpy:1650
translate ingles rutanullaa_9d238d0e:
    # "Hasta que un cuerpo extraño choca directamente contra ustedes."
    "Until a foreign body crashes directly into you."

# game/rutas/nulla.rpy:1653
translate ingles rutanullaa_86402519:
    # "Sientes como algo se enrreda en tu cuello y te arrebata de los brazos de Nulla."
    "You feel something wrap around your neck and yank you from Nulla's arms."

# game/rutas/nulla.rpy:1654
translate ingles rutanullaa_8215ba50:
    # "El brillo deja de ser tan intenso y puedes apreciar lo que está pasando. Supones que es una táctica utilizada por Unum para cegar a su oponente."
    "The glare softens, letting you see what's happening. You suspect it's a tactic used by Unum to blind his opponent."

# game/rutas/nulla.rpy:1655
translate ingles rutanullaa_0fdfe99e:
    # "Caes al suelo y Nulla queda debajo de los pies del estandarte del sol."
    "You collapse to the ground, and Nulla ends up beneath the feet of the sun's Symbol."

# game/rutas/nulla.rpy:1656
translate ingles rutanullaa_1409f38e:
    # nulla "¡Cierra los o-- agh!"
    nulla "Close your--agh!"

# game/rutas/nulla.rpy:1657
translate ingles rutanullaa_548e5b62:
    # "No alcanzas a cumplir lo pedido, pues Unum rápidamente le corta los brazos y piernas, impidiendo que pueda moverse."
    "You can't fulfill the request, as Unum quickly cuts off his arms and legs, preventing him from moving."

# game/rutas/nulla.rpy:1659
translate ingles rutanullaa_a3a7f3b7:
    # "Y con su otro látigo agarra el cuello de Nulla para incorporarlo."
    "And with his other whip, he grabs Nulla's neck to haul him up."

# game/rutas/nulla.rpy:1660
translate ingles rutanullaa_36acfe61:
    # unum "O te quitas a Aeliana de tu cuerpo o mato aquí y ahora a esta cosa."
    unum "Either you remove Aeliana from your body or I'll kill this thing, right here and now."

# game/rutas/nulla.rpy:1661
translate ingles rutanullaa_c65eb4f2:
    # unum "El plan de Septem ya no tiene sentido sin mis estrellas conmigo, así que no me molestará matarle."
    unum "Septem's plan no longer makes sense without my stars by my side, so it won't bother me to kill it."

# game/rutas/nulla.rpy:1662
translate ingles rutanullaa_e1a19c2e:
    # "Nulla no puede hacer más que mirarte con impotencia."
    "Nulla can only look at you in helplessness."

# game/rutas/nulla.rpy:1663
translate ingles rutanullaa_a20cefa7_21:
    # "..."
    "..."

# game/rutas/nulla.rpy:1664
translate ingles rutanullaa_dd57f088:
    # "Nulla cede ante Unum y comienza a quitarse la piel de Aeliana para volver a su verdadera cara."
    "Nulla gives in to Unum and begins peeling away Aeliana's skin to reveal his true face."

# game/rutas/nulla.rpy:1667
translate ingles rutanullaa_52fe0126:
    # "Contento con aquello, Unum tira del collar que se ha formado en tu cuello y te atrae hacia ellos. Hace lo mismo con Nulla pero a él lo inmoviliza con su brazo."
    "Satisfied with that, Unum pulls at the collar that has formed around your neck and draws you toward them. He does the same with Nulla, but immobilizes him with his arm."

# game/rutas/nulla.rpy:1668
translate ingles rutanullaa_640bf1fb:
    # unum "¿Sabes lo interesante de este sujeto? ¿hhmmmm?"
    unum "You know what's interesting about this guy? Hhmmmm?"

# game/rutas/nulla.rpy:1669
translate ingles rutanullaa_c5207503:
    # "Te mira con una sonrisa inquetante."
    "He looks at you with a questioning smile."

# game/rutas/nulla.rpy:1670
translate ingles rutanullaa_e2c9d3b6:
    # "No tienes el coraje para contestar... tampoco es como que pudieras pues el collar te está sofocando poco a poco."
    "You don't have the courage to answer... not that you could, as the collar is slowly suffocating you."

# game/rutas/nulla.rpy:1671
translate ingles rutanullaa_0a32812c:
    # unum "¡No es fácil de matar!"
    unum "He's not easy to kill!"

# game/rutas/nulla.rpy:1672
translate ingles rutanullaa_d57abfa8:
    # unum "Para hacerlo necesitas dos cosas: Al creador o un reemplazo de este, y mucho, muuuucho tiempo para llegar a su capa original."
    unum "To do it, you need two things: the Creator--or a substitute--and a lot, loooot of time to reach his original layer."

# game/rutas/nulla.rpy:1673
translate ingles rutanullaa_f575c88e:
    # unum "¡Y es perfecto! porque tengo las dos cosas aquí."
    unum "And this is perfect! Because I have both right here."

# game/rutas/nulla.rpy:1674
translate ingles rutanullaa_cecebd52:
    # unum "Septem me lo contó antes de venir aquí."
    unum "Septem told me about it before coming here."

# game/rutas/nulla.rpy:1677
translate ingles rutanullaa_293161b0:
    # unum "Y LO VOY A DISFRUTAR TANTOOOO~"
    unum "AND I'M GOING TO ENJOY IT SOOOOO MUCH~"

# game/rutas/nulla.rpy:1678
translate ingles rutanullaa_b2fbed82:
    # unum "Te voy a cortar esa cabeza las veces que sea necesario."
    unum "I'm going to cut off that head as many times as necessary."

# game/rutas/nulla.rpy:1679
translate ingles rutanullaa_ce143cf7:
    # unum "Usaré mis propias manos, para que tu carne se desgarre lentamente."
    unum "I'll use my own hands, so your flesh tears slowly."

# game/rutas/nulla.rpy:1680
translate ingles rutanullaa_efad49a5:
    # "Unum enfoca sus ojos en ti una vez más."
    "Unum fixes his eyes on you once more."

# game/rutas/nulla.rpy:1681
translate ingles rutanullaa_d870d1bd:
    # unum "¡Y haré que tú veas todo, todo, todo!"
    unum "And I'll make you see everything, everything, everything!"

# game/rutas/nulla.rpy:1682
translate ingles rutanullaa_21b3588c:
    # unum "Cortaré tus párpados si es necesario~"
    unum "I'll cut your eyelids off if I have to~"

# game/rutas/nulla.rpy:1683
translate ingles rutanullaa_b4ae36e5:
    # "No quieres perder tus párpados... y tampoco quieres que nada malo le pase a Nulla."
    "You don't want to lose your eyelids... and you don't want anything bad to happen to Nulla either."

# game/rutas/nulla.rpy:1684
translate ingles rutanullaa_e3dbbdc8:
    # "¡Demonios!"
    "Damn it!"

# game/rutas/nulla.rpy:1685
translate ingles rutanullaa_adf86b9c:
    # "Te preguntas porqué Nulla no puede hacer nada ahora... ¿Por qué no invoca otra vez a sus sombras?"
    "You wonder why Nulla can't do anything now... Why doesn't he summon his shadows again?"

# game/rutas/nulla.rpy:1686
translate ingles rutanullaa_b76a4ace:
    # "Ya es tiempo para hacerlo."
    "It's time to do it."

# game/rutas/nulla.rpy:1687
translate ingles rutanullaa_7b097738:
    # "Momento... Cada vez que lo hace, él realiza un movimiento sutil con sus manos."
    "Wait... Every time he does it, he makes a subtle movement with his hands."

# game/rutas/nulla.rpy:1688
translate ingles rutanullaa_47cca12e:
    # "No puede hacer nada para evitar su muerte sin sus manos..."
    "He can't do anything to prevent his death without his hands..."

# game/rutas/nulla.rpy:1689
translate ingles rutanullaa_f1051408:
    # "Dios..."
    "God..."

# game/rutas/nulla.rpy:1690
translate ingles rutanullaa_a20cefa7_22:
    # "..."
    "..."

# game/rutas/nulla.rpy:1691
translate ingles rutanullaa_6fed807a:
    # "Unum agarra el cabello de Nulla y comienza a tira con fuerza, su cuello comienza a desgarrarse lentamente."
    "Unum grabs Nulla's hair and starts pulling forcefully; his neck begins to tear slowly."

# game/rutas/nulla.rpy:1692
translate ingles rutanullaa_f31b0f37:
    # "Tan lento que puedes ver en cámara lenta como pequeñas gotas emergen y caen de las heridas recién hechas en la piel."
    "So slowly that you can see in slow motion as tiny droplets emerge and fall from the fresh wounds on his skin."

# game/rutas/nulla.rpy:1694
translate ingles rutanullaa_2b4f62b1:

    # "____________________"
    "______________________"

# game/rutas/nulla.rpy:1696
translate ingles rutanullaa_bb68da8d:
    # "{b}Oh... lo siento cariño, no voy a dejar que esto pase.{b}"
    "{b}Oh... I'm sorry, my child, I won't let this happen.{b}"

# game/rutas/nulla.rpy:1697
translate ingles rutanullaa_fe1536ec:
    # "{b}Creo que es momento de intervenir.{b}"
    "{b}I think it's time to intervene.{b}"

# game/rutas/nulla.rpy:1698
translate ingles rutanullaa_19e533e2:
    # "{b}Nulla no tiene oportunidad con mi querido Unum.{b}"
    "{b}Nulla stands no chance against my dear Unum.{b}"

# game/rutas/nulla.rpy:1699
translate ingles rutanullaa_cc9a5909:
    # "!!!"
    "!!!"

# game/rutas/nulla.rpy:1701
translate ingles rutanullaa_c78d6240:
    # "Una mano se materializa detrás del pelirrojo y le corta la cabeza sin darle tiempo a procesar lo que está pasando."
    "A hand materializes behind the redhead and severs his head before he has time to process what's happening."

# game/rutas/nulla.rpy:1702
translate ingles rutanullaa_8f407820:
    # nulla "Madre..."
    nulla "Mother..."

# game/rutas/nulla.rpy:1703
translate ingles rutanullaa_37c27569:
    # "¡¿Madre?!"
    "Mother?!"

# game/rutas/nulla.rpy:1704
translate ingles rutanullaa_e2bd0f5d:
    # "{sc=3}¿Todo este tiempo la voz que nos ha estado hablando es Madre?{/sc}"
    "{sc=3}All this time, is the voice that's been speaking to us Mother?{/sc}"

# game/rutas/nulla.rpy:1705
translate ingles rutanullaa_437a83f0:
    # "____________________________"
    "____________________________"

# game/rutas/nulla.rpy:1706
translate ingles rutanullaa_f920a4f2:
    # madre "Nulla, [nombrejugador] sé que están leyendo esto... tienen que estar más atentos, porque no pienso volver a interrumpir."
    madre "Nulla, [nombrejugador], I know you're reading this... you need to pay closer attention, because I won't interrupt again."

# game/rutas/nulla.rpy:1707
translate ingles rutanullaa_d62288ed:
    # madre "No disfruto de matar a mis hijos..."
    madre "I don't enjoy killing my children..."

# game/rutas/nulla.rpy:1708
translate ingles rutanullaa_3d6210d4:
    # madre "Nos vemos luego."
    madre "See you later."

# game/rutas/nulla.rpy:1710
translate ingles rutanullaa_437a83f0_1:
    # "____________________________"
    "____________________________"

# game/rutas/nulla.rpy:1713
translate ingles rutanullaa_c1537e6a:
    # "La mano extrae la esencia y te la ofrece a ti antes de esfumarse."
    "The hand extracts the essence and offers it to you before vanishing."

# game/rutas/nulla.rpy:1714
translate ingles rutanullaa_887207b7:
    # "Casi la sueltas al momento de tomarla con tu mano libre... está muy caliente."
    "You nearly drop it as you grasp it with your free hand... it's very hot."

# game/rutas/nulla.rpy:1716
translate ingles rutanullaa_b02633e8:
    # "Miras ambas esencias... y te das cuenta de algo."
    "You look at both essences... and you realize something."

# game/rutas/nulla.rpy:1717
translate ingles rutanullaa_5be46613:
    # "La esencia de quinque está formando una capa extraña y dura a su alrededor."
    "Quinque's essence is forming a strange, hard layer around it."

# game/rutas/nulla.rpy:1718
translate ingles rutanullaa_953f63fa:
    # "Tipo coraza."
    "Like a shell."

# game/rutas/nulla.rpy:1719
translate ingles rutanullaa_da144fe6:
    # nulla "¿Puedes mirarme, por favor?"
    nulla "Can you look at me, please?"

# game/rutas/nulla.rpy:1722
translate ingles rutanullaa_d80299fe:
    # "Al hacerlo, Nulla comienza a regenerar sus brazos y piernas, y su ropa también lo hace..."
    "As you do, Nulla begins to regenerate his arms and legs, and even his clothes do too..."

# game/rutas/nulla.rpy:1723
translate ingles rutanullaa_2382ec9c:
    # "Aunque no regenera su piel.Justo como la vez anterior."
    "Although his skin doesn't regenerate--just like last time."

# game/rutas/nulla.rpy:1724
translate ingles rutanullaa_97ab58a6:
    # "Primero es humo, luego algo más tangible que el humo y por último la capa de piel."
    "First it's smoke, then something more tangible than smoke, and finally a layer of skin."

# game/rutas/nulla.rpy:1725
translate ingles rutanullaa_7007cd32:
    # "Es extraño."
    "It's strange."

# game/rutas/nulla.rpy:1728
translate ingles rutanullaa_e600532e:
    # nulla "Creo que ya se está volviendo hábito cortarme partes del cuerpo..."
    nulla "I think it's becoming a habit for me to cut off parts of my body..."

# game/rutas/nulla.rpy:1729
translate ingles rutanullaa_21501241:
    # nulla "Ja--"
    nulla "Ja--"

# game/rutas/nulla.rpy:1730
translate ingles rutanullaa_8a955513:
    # nulla "Si mis receptores de dolor aún funcionarán bien, sería horrible."
    nulla "If my pain receptors still worked properly, it would be horrible."

# game/rutas/nulla.rpy:1736
translate ingles rutanullaa_242a4040:
    # nulla "Así es, mis capas externas ya no sienten mucho el dolor."
    nulla "That's right, my outer layers don't feel much pain anymore."

# game/rutas/nulla.rpy:1737
translate ingles rutanullaa_853ae9ce:
    # nulla "Mientras que las del interior, sienten como cualquier humano promedio."
    nulla "While the inner layers feel pain like any average human."

# game/rutas/nulla.rpy:1742
translate ingles rutanullaa_be65ffcc:
    # nulla "Awww, ¿te preocupas por mí?"
    nulla "Awww, do you care about me?"

# game/rutas/nulla.rpy:1746
translate ingles rutanullaa_b712edb8:
    # nulla "Bueno basta de cháchara."
    nulla "Alright, enough chatter."

# game/rutas/nulla.rpy:1747
translate ingles rutanullaa_f62d8712:
    # nulla "Tienes que comerte eso, mi amor."
    nulla "You have to eat it, mi amor."

# game/rutas/nulla.rpy:1748
translate ingles rutanullaa_70dec0c1:
    # nulla "Sino ellos volverán a regenerarse."
    nulla "Otherwise, they'll regenerate again."

# game/rutas/nulla.rpy:1749
translate ingles rutanullaa_87cb28fb:
    # nulla "Y no queremos eso, ¿cierto?"
    nulla "And we don't want that, right?"

# game/rutas/nulla.rpy:1751
translate ingles rutanullaa_6f7b77dc:
    # nj "{glitch=20.0}{color=ffffff}{b}Oh nooo, claro que noooo~{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}Oh nooo, of course notttt~{/glitch}"

# game/rutas/nulla.rpy:1752
translate ingles rutanullaa_a20cefa7_23:
    # "..."
    "..."

# game/rutas/nulla.rpy:1753
translate ingles rutanullaa_257bac5c:
    # nulla "De cualquier modo."
    nulla "In any case."

# game/rutas/nulla.rpy:1754
translate ingles rutanullaa_87e8c9dc:
    # nulla "¡Hora de comer!"
    nulla "Time to eat!"

# game/rutas/nulla.rpy:1756
translate ingles rutanullaa_2f8006a1:
    # "Nulla toca la esencia que le pertenece a Quinque y rompe su exterior, como si de una cáscara de huevo se tratase."
    "Nulla touches Quinque's essence and breaks its exterior, as if it were an eggshell."

# game/rutas/nulla.rpy:1757
translate ingles rutanullaa_7aca4412:
    # "Lentamente, con sus manos sobre las tuyas, él junta ambas esencias y las fusiona para convertirlas en solo una."
    "Slowly, with his hands over yours, he brings both essences together and fuses them into one."

# game/rutas/nulla.rpy:1758
translate ingles rutanullaa_bf274640:
    # "La esencia resultante es una de mayor tamaño que no se mezcla de manera homogénea como las anteriores."
    "The resulting essence is larger and doesn't blend as homogeneously as the previous ones."

# game/rutas/nulla.rpy:1759
translate ingles rutanullaa_6da96cc8:
    # "En esta se pueden apreciar con facilidad que partes pertenecen a Unum y que partes pertenecen a Quinque."
    "In this one, you can clearly see which parts belong to Unum and which to Quinque."

# game/rutas/nulla.rpy:1760
translate ingles rutanullaa_292da7d8:
    # "Como si no quisieran estar juntas."
    "As if they didn't want to be together."

# game/rutas/nulla.rpy:1761
translate ingles rutanullaa_41ae9f7c:
    # "Te preguntas cuál es la razón de que unas se mezclen y otras no."
    "You wonder why some merge and others don't."

# game/rutas/nulla.rpy:1762
translate ingles rutanullaa_ebf80427:
    # "¿Será la compatibilidad?"
    "Could it be compatibility?"

# game/rutas/nulla.rpy:1765
translate ingles rutanullaa_6468ec00:
    # "Miras a Nulla y él te observa en silencio."
    "You look at Nulla, and he watches you silently."

# game/rutas/nulla.rpy:1766
translate ingles rutanullaa_9a3abf73:
    # "Se nota que quiere hablar o explicar la razón pero por algún motivo, no lo hace."
    "It seems he wants to speak or explain something, but for some reason, he doesn't."

# game/rutas/nulla.rpy:1767
translate ingles rutanullaa_d8e1dab1:
    # "Con un poco de cuidado, Nulla guía tus manos hacia tu boca."
    "With a bit of care, Nulla guides your hands towards your mouth."

# game/rutas/nulla.rpy:1770
translate ingles rutanullaa_a708f7d5:
    # nulla "¿Puedes ayudarme a caminar luego de que te comas la esencia?"
    nulla "Can you help me walk after you swallow the essence?"

# game/rutas/nulla.rpy:1775
translate ingles rutanullaa_33031ef7:
    # nulla "Gracias, mi vida."
    nulla "Thank you, mi vida."

# game/rutas/nulla.rpy:1776
translate ingles rutanullaa_409f8636_16:
    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:1779
translate ingles rutanullaa_e83200e2:
    # nulla "Ah-"
    nulla "Ah--"

# game/rutas/nulla.rpy:1783
translate ingles rutanullaa_0879f6f0:
    # nulla "Cada vez que el cuerpo de la marioneta absorbe la esencia de algún Estandarte, mi cuerpo absorbe sus potestades."
    nulla "Every time the puppet's body absorbs the essence of a Symbol, my body absorbs its powers."

# game/rutas/nulla.rpy:1784
translate ingles rutanullaa_36eb55db:
    # nulla "Todo lo que entre a su cuerpo, entrará al mío. Todo lo que se saque de su cuerpo, saldrá del mío... mientras tú, [nombrejugador], estés mirando y confirmando todo lo que pase..."
    nulla "Everything that enters its body will enter mine. Everything that is taken from its body will come out of mine... as long as you, [nombrejugador], watch and confirm everything that happens..."

# game/rutas/nulla.rpy:1785
translate ingles rutanullaa_4988b607:
    # nulla "Lo que quiero decir es que: tu marioneta es mía, tanto como tuya."
    nulla "What I mean is: your puppet is mine, just as much as it is yours."

# game/rutas/nulla.rpy:1786
translate ingles rutanullaa_4ddaa04e:
    # "{glitch=20.0}{color=ffffff}{b}¿Por qué crees que puedo hablarte así?{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Why do you think I can talk to you like this?{/glitch}"

# game/rutas/nulla.rpy:1787
translate ingles rutanullaa_969fb28a:
    # nulla "Estamos conectados tanto en alma como en cuerpo. Es lo que nos permite conectar el uno con el otro <3."
    nulla "We're connected in both soul and body. That's what lets us bond with each other. <3"

# game/rutas/nulla.rpy:1790
translate ingles rutanullaa_6b570e8d:
    # nulla "Lastima que solo es la marioneta y no tú."
    nulla "Too bad it's only the puppet and not you."

# game/rutas/nulla.rpy:1791
translate ingles rutanullaa_e64f04b0:
    # nulla ":("
    nulla ":("

# game/rutas/nulla.rpy:1794
translate ingles rutanullaa_0196757d:
    # "Estás por responder cuando Nulla aprovecha de empujar tus manos a tu boca, haciendo que te tragues la esencia de un solo bocado."
    "Just as you're about to reply, Nulla pushes your hands to your mouth, forcing you to swallow the essence in one gulp."

# game/rutas/nulla.rpy:1795
translate ingles rutanullaa_6d11dbdf:
    # "Por poco casi devuelves el contenido que está pasando por tu garganta."
    "You almost regurgitate what's coursing through your throat."

# game/rutas/nulla.rpy:1796
translate ingles rutanullaa_4c7a89d7:
    # "Pero te aguantas y cierras los ojos con fuerza mientras te encorvas, temiendo vomitar si te quedas en una posición normal..."
    "But you hold it in and close your eyes tightly while hunching over, fearing you'll vomit if you stay upright..."

# game/rutas/nulla.rpy:1797
translate ingles rutanullaa_182a6546:
    # nulla "Eso~ respira~ lo estás haciendo bien, cariño."
    nulla "There~ breathe~ you're doing well, cariño."

# game/rutas/nulla.rpy:1798
translate ingles rutanullaa_adeabfa1:
    # "Nulla te acaricia la espalda, trazando pequeños círculos con su palma, a modo de consuelo."
    "Nulla strokes your back, drawing small circles with his palm as a form of comfort."

# game/rutas/nulla.rpy:1801
translate ingles rutanullaa_8654cdf1:
    # nulla "Listo, ya no deberías sentirte mal."
    nulla "Alright, you shouldn't feel bad anymore."

# game/rutas/nulla.rpy:1696 to :1801 end.


# game/rutas/nulla.rpy:1802
translate ingles rutanullaa_7ecde53a:

    # nulla "Me he traspasado todo ese poder a mí."
    nulla "I've transferred all that power to myself."

# game/rutas/nulla.rpy:1805
translate ingles rutanullaa_f2ca365b:

    # nulla "Pero necesito que me sostengas ahora..."
    nulla "But I need you to hold me now..."

# game/rutas/nulla.rpy:1806
translate ingles rutanullaa_0363f93b:

    # nulla "Creo que me voy a caer."
    nulla "I think I'm going to fall."

# game/rutas/nulla.rpy:1808
translate ingles rutanullaa_0cd552cf:

    # "El efecto que tienen sus palabras parecen asemejarse a un comando que no puedes evitar cumplir. Te enderezas y colocas tus manos en la cintura de Nulla, para estabilizar su cuerpo con ayuda del tuyo."
    "The effect of his words seems like a command you cannot help but obey. You straighten up and place your hands on Nulla's waist to stabilize his body with the help of yours."

# game/rutas/nulla.rpy:1809
translate ingles rutanullaa_745541c9:

    # "Como si de alas de mariposa se tratara, manejas su cuerpo con cuidado al ayudar a Nulla a pararse y caminar."
    "As if handling butterfly wings, you gently maneuver his body as you help him stand and walk."

# game/rutas/nulla.rpy:1810
translate ingles rutanullaa_76fe8469:

    # "Miras a Nulla para comprobar que todo esté bien."
    "You look at Nulla to make sure everything is alright."

# game/rutas/nulla.rpy:1812
translate ingles rutanullaa_1d379ad8:

    # "Él te sonríe mostrando todos sus dientes."
    "He smiles at you, showing all his teeth."

# game/rutas/nulla.rpy:1814
translate ingles rutanullaa_a095587c:

    # "Nada más caminan unos 6 pasos cuando ves el cambio en el ambiente. Poco a poco el lugar se va desintegrando."
    "No sooner have you taken about six steps than you notice a change in the atmosphere. Gradually, the place begins to disintegrate."

# game/rutas/nulla.rpy:1815
translate ingles rutanullaa_617ec04e:

    # "Partículas color negro se van comiendo el espacio, dejando un blanco puro a su paso."
    "Black particles devour the space, leaving a trail of pure white in their wake."

# game/rutas/nulla.rpy:1816
translate ingles rutanullaa_81745cbd:

    # "El proceso es más rápido de lo que te imaginabas."
    "The process is faster than you imagined."

# game/rutas/nulla.rpy:1818
translate ingles rutanullaa_6b966fe6:

    # nulla "Uhggg."
    nulla "Uhggg."

# game/rutas/nulla.rpy:1819
translate ingles rutanullaa_9753b040:

    # "Nulla se recarga más en ti, al punto de estar arrastrando sus pies."
    "Nulla leans on you so much, he end up dragging his feet."

# game/rutas/nulla.rpy:1820
translate ingles rutanullaa_5f55cb8c:

    # "Te detienes para preguntar si es necesario seguir caminando."
    "You stop to ask if you need to keep walking."

# game/rutas/nulla.rpy:1821
translate ingles rutanullaa_566cf42e:

    # nulla "Tenemos que caminar por un poco más, hasta consumir la gran mayoría de este dominio."
    nulla "We have to walk a bit further until we've consumed most of this domain."

# game/rutas/nulla.rpy:1822
translate ingles rutanullaa_1c39180b:

    # nulla "Si me detengo, creo que explotaré."
    nulla "If I stop, I think I'll explode."

# game/rutas/nulla.rpy:1824
translate ingles rutanullaa_cb1aea58:

    # "No te aventuras a preguntar..."
    "You dare not ask..."

# game/rutas/nulla.rpy:1827
translate ingles rutanullaa_d8c12e76:

    # "Caminan a paso lento mientras observas como poco a poco, lo negro deja de existir para dar cabida a un blanco puro."
    "You and Nulla walk slowly while, little by little, the black fades away to make room for a pure white."

# game/rutas/nulla.rpy:1828
translate ingles rutanullaa_345fb04b:

    # "Todo el tiempo en silencio. Supones que debe ser porque Nulla está ocupado consumiendo lo que queda del dominio de Unum y Quinque."
    "All in silence. You assume it must be because Nulla is busy consuming what remains of the domains of Unum and Quinque."

# game/rutas/nulla.rpy:1829
translate ingles rutanullaa_5fdb974d:

    # nulla "Listo... estamos listos."
    nulla "Ready... we're ready."

# game/rutas/nulla.rpy:1831
translate ingles rutanullaa_26bd8f08:

    # "Eso le basta como aviso para tragarte en el vacío."
    "That's enough as a warning in order to pull you into the Void."

# game/rutas/nulla.rpy:1833
translate ingles rutanullaa_ef23a243:

    # "Está vez, Nulla te mira con cansancio, pero-"
    "This time, Nulla looks at you wearily, but--"

# game/rutas/nulla.rpy:1834
translate ingles rutanullaa_e7b445b6:

    # "Sonriente..."
    "Smiling..."

# game/rutas/nulla.rpy:1835
translate ingles rutanullaa_1b19d758:

    # "No se ve afectado como la otra vez."
    "He doesn't seem affected like before."

# game/rutas/nulla.rpy:1837
translate ingles rutanullaa_3d3fc1a1:

    # nulla "Oh, no te preocupes por eso. Ya te lo dije."
    nulla "Oh, don't worry about that. I already told you."

# game/rutas/nulla.rpy:1838
translate ingles rutanullaa_ee44d7e2:

    # nulla "No más lloriqueos a partir de ahora."
    nulla "No more whining from now on."

# game/rutas/nulla.rpy:1839
translate ingles rutanullaa_cf8246fb:

    # "El silencio que se genera es denso, pero no sabes que más decir."
    "The silence that ensues is heavy, and you have nothing more to say."

# game/rutas/nulla.rpy:1840
translate ingles rutanullaa_29173253:

    # "Así que solo lo miras a los ojos."
    "So you simply look him in the eyes."

# game/rutas/nulla.rpy:1842
translate ingles rutanullaa_7834441f:

    # "Él sonríe un poco más."
    "He smiles a little more."

# game/rutas/nulla.rpy:1844
translate ingles rutanullaa_e10d5f6a:

    # nulla "Me quedaría el resto del día aquí... pero te prometí pasar el día en casa."
    nulla "I'd stay here for the rest of the day... but I promised to spend the day at home."

# game/rutas/nulla.rpy:1848
translate ingles rutanullaa_36a00718:

    # "Reaparecen en el dominio de Nulla, lo sabes por su naturaleza parecida a un boceto, pero, es un lugar que no reconoces."
    "You reappear in Nulla's domain, recognizable by its sketch-like nature, yet this is a place you don't recognize."

# game/rutas/nulla.rpy:1849
translate ingles rutanullaa_54f4528a:

    # "Es un lugar aislado, donde quiera que mires ves que al lugar lo rodea un río negro."
    "It's an isolated place, where wherever you look, a black river surrounds it."

# game/rutas/nulla.rpy:1850
translate ingles rutanullaa_1cc7d98e:

    # "Lo único que tiene color aquí son el mar de flores que están en el piso."
    "The only thing that has color here is the sea of flowers on the ground."

# game/rutas/nulla.rpy:1851
translate ingles rutanullaa_54cef835:

    # "Pintadas de un amarillo vibrante y cálido."
    "Painted in a vibrant, warm yellow."

# game/rutas/nulla.rpy:1852
translate ingles rutanullaa_a081d684:

    # "Todas parecen ser del mismo tipo, pero no reconoces que tipo o el nombre de la flor."
    "They all appear to be of the same kind, yet you cannot identify their type or name."

# game/rutas/nulla.rpy:1855
translate ingles rutanullaa_409f8636_17:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:1856
translate ingles rutanullaa_8c68a883:

    # nulla "No lo sé."
    nulla "I don't know."

# game/rutas/nulla.rpy:1860
translate ingles rutanullaa_c0d6bed4:

    # "Nulla mira con una expresión afligida a las flores, y no sabes si es porque aún se siente mal por el gasto enorme de energía que ha consumido o por otra cosa más."
    "Nulla gazes at the flowers with a sorrowful expression, and you don't know whether it's because he still feels bad about the enormous amount of energy he has consumed or for something else."

# game/rutas/nulla.rpy:1862
translate ingles rutanullaa_425fd7fb:

    # "Nulla comienza a caminar en medio del campo de flores, sin importarle en lo más mínimo si las pisa o rompe en el proceso."
    "Nulla starts walking through the field of flowers, caring little if he steps on or crushes them in the process."

# game/rutas/nulla.rpy:1863
translate ingles rutanullaa_ebb13787:

    # "Y en efecto, con cada contacto de sus pies en el suelo, las flores se rompen."
    "And indeed, with every step he takes, the flowers are crushed."

# game/rutas/nulla.rpy:1864
translate ingles rutanullaa_130ec064:

    # "No mira sus pies, sus ojos están enfocados en el mirar hacia delante, con un objetivo claro, pero no mira donde pisa o las consecuencias que tiene su acción..."
    "He doesn't watch his feet; his eyes are fixed on what's ahead, with a clear purpose, oblivious to where he steps or the consequences of his actions..."

# game/rutas/nulla.rpy:1865
translate ingles rutanullaa_61309843:

    # nulla "El amarillo es mi color favorito."
    nulla "Yellow is my favorite color."

# game/rutas/nulla.rpy:1866
translate ingles rutanullaa_f2a01482:

    # nulla "A ella le gustaban las flores amarillas y en nuestro jardín teníamos unas cuantas."
    nulla "She loved yellow flowers, and we had quite a few in our garden."

# game/rutas/nulla.rpy:1867
translate ingles rutanullaa_a56c112a:

    # nulla "Las cuidaba."
    nulla "I took care of them."

# game/rutas/nulla.rpy:1868
translate ingles rutanullaa_5ab801e2:

    # nulla "Pero, nunca me dijo como se llamaban..."
    nulla "But she never told me what they were called..."

# game/rutas/nulla.rpy:1869
translate ingles rutanullaa_b5a1582d:

    # nulla "Y no importa cuantas veces le describí a Madre su apariencia, nunca pudimos recrear las flores que alguna vez tuve con Mary..."
    nulla "And no matter how many times I described their appearance to Mother, we never managed to recreate the flowers I once had with Mary..."

# game/rutas/nulla.rpy:1874
translate ingles rutanullaa_ff5716d9:

    # nulla "Mi hermana."
    nulla "My sister."

# game/rutas/nulla.rpy:1875
translate ingles rutanullaa_6b0923aa:

    # nulla "Fuimos creados al mismo tiempo, y en una de las tantas ideas desechadas del Creador, fuimos hermanos."
    nulla "We were created at the same time, and in one of the Creator's many discarded ideas, we became siblings."

# game/rutas/nulla.rpy:1876
translate ingles rutanullaa_ef44ca7c:

    # nulla "Somos hermanos..."
    nulla "We're siblings..."

# game/rutas/nulla.rpy:1877
translate ingles rutanullaa_05ef0a20:

    # "Nulla baja la mirada y es ahí cuando se da cuenta de lo que ha hecho."
    "Nulla lowers his gaze, and that's when he realizes what he's done."

# game/rutas/nulla.rpy:1878
translate ingles rutanullaa_dbc523eb:

    # "Como si sus ojos no lo creyeran, levanta un pie para confirmar lo obvio. Ha aplastado todas las flores que estaban en su camino."
    "As if his eyes couldn't believe it, he lifts a foot to confirm the obvious: He's crushed all the flowers in his path."

# game/rutas/nulla.rpy:1880
translate ingles rutanullaa_bb6b515c_1:

    # nulla "Oh."
    nulla "Oh."

# game/rutas/nulla.rpy:1881
translate ingles rutanullaa_491663b1:

    # nulla "Se me ha olvidado que con tus ojos esto puede pasar, ja--"
    nulla "I forgot that with your eyes, this could happen, ja--"

# game/rutas/nulla.rpy:1882
translate ingles rutanullaa_973ee66a:

    # "No comenta nada más."
    "He doesn't say anything more."

# game/rutas/nulla.rpy:1884
translate ingles rutanullaa_522c2b23:

    # "Miras como ha quedado una de las tantas flores que Nulla ha pisado... el ambiente se ha vuelto pesado, más de lo que puedes aguantar sin sentir una presión extraña en el pecho."
    "You look at one of the many flowers that Nulla has crushed... the atmosphere has grown heavy, more than you can bear without feeling a strange pressure in your chest."

# game/rutas/nulla.rpy:1885
translate ingles rutanullaa_66a7d483:

    # "Algo dentro de ti duele, pero no es por algo propio tuyo."
    "Something inside you aches, but it's not because of anything of your own."

# game/rutas/nulla.rpy:1886
translate ingles rutanullaa_a3dc6f69:

    # "Es por Nulla."
    "It's because of Nulla."

# game/rutas/nulla.rpy:1887
translate ingles rutanullaa_2d92df4b:

    # el "Nulla."
    el "Nulla."

# game/rutas/nulla.rpy:1888
translate ingles rutanullaa_d7632bbd:

    # "Es escucha una voz que resuena en todo el lugar, muy parecido a la voz de Septem en el hotel."
    "You hear a voice that resonates throughout the place, very similar to Septem's voice at the hotel."

# game/rutas/nulla.rpy:1889
translate ingles rutanullaa_25154b27:

    # "Algo distorsionada y omnipresente, originándose en todos los puntos del espacio a la vez."
    "Something distorted and omnipresent, originating from all points in space at once."

# game/rutas/nulla.rpy:1890
translate ingles rutanullaa_fe7ee260:

    # "Te marea un poco."
    "It makes you a little dizzy."

# game/rutas/nulla.rpy:1892
translate ingles rutanullaa_1effd02e:

    # "Detrás de Nulla, una figura se materializa."
    "Behind Nulla, a figure materializes."

# game/rutas/nulla.rpy:1894
translate ingles rutanullaa_c6505fcb:

    # "Es Madre, tan gloriosa como la última vez que la viste..."
    "It's Mother, as glorious as the last time you saw her..."

# game/rutas/nulla.rpy:1895
translate ingles rutanullaa_3fe92323:

    # madre "Nulla, tenemos que hablar."
    madre "Nulla, we need to talk."

# game/rutas/nulla.rpy:1896
translate ingles rutanullaa_36350144:

    # nulla "¿Realmente es necesario hacerlo ahora?"
    nulla "Is it really necessary to do so now?"

# game/rutas/nulla.rpy:1897
translate ingles rutanullaa_cbd855f4:

    # madre "Si no es ahora, tal vez sigas cometiendo errores."
    madre "If not now, perhaps you'll continue making mistakes."

# game/rutas/nulla.rpy:1898
translate ingles rutanullaa_f3352c3a:

    # "Madre hace una expresión de desagrado antes de continuar ante el silencio de Nulla."
    "Mother wears an expression of disapproval before continuing in the silence of Nulla."

# game/rutas/nulla.rpy:1900
translate ingles rutanullaa_4b980423:

    # madre "No debería estarme explicando, {b}Neo{b} querido."
    madre "I shouldn't have to explain myself, dear {b}Neo{b}."

# game/rutas/nulla.rpy:1902
translate ingles rutanullaa_d8a8eb06:

    # "Lo último que ves es como la figura de Nulla tiembla y se rompe transformándose en algo monstruoso. "
    "The last thing you see is Nulla's figure trembling and breaking apart, transforming into something monstrous."

# game/rutas/nulla.rpy:1903
translate ingles rutanullaa_66e62b9d:

    # "Tu cuerpo, hace lo mismo. No duele, pero sientes como tu cara se rompe, junto con los brazos y piernas."
    "Your body does the same. It doesn't hurt, but you feel as though your face, along with your arms and legs, is breaking apart."

# game/rutas/nulla.rpy:1904
translate ingles rutanullaa_1d0dedbb:

    # "Caes al suelo y dejas escuchar."
    "You collapse to the ground and allow yourself to listen."

# game/rutas/nulla.rpy:1906
translate ingles rutanullaa_739e6e8d:

    # "Dejas de ver..."
    "You cease to see..."

# game/rutas/nulla.rpy:1907
translate ingles rutanullaa_5f7713b2:

    # "Dejas de sentir."
    "You cease to feel."

# game/rutas/nulla.rpy:1908
translate ingles rutanullaa_d0a95bb7:

    # "{glitch=20.0}{color=ffffff}{b}_____________________________________________{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}___________________________{/glitch}"

# game/rutas/nulla.rpy:1909
translate ingles rutanullaa_94acaf39:

    # "FIN DEL ACTO 2."
    "END OF ACT 2."

# game/rutas/nulla.rpy:1911
translate ingles rutanullaa_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2} You'll have to wait a little to find out how this ends... :3{/sc}"

# game/rutas/nulla.rpy:1951
translate ingles null_d39cdb4c:

    # "Nulla te agarra la mano y te sonríe de medio lado."
    "Nulla grabs your hand and gives you a half-smile."

# game/rutas/nulla.rpy:2015
translate ingles null_e40da6a6:

    # "Por el rabillo del ojo, vez una sombra."
    "Out of the corner of your eye, you see a shadow."

# game/rutas/nulla.rpy:2016
translate ingles null_93cb7cb7:

    # "Y no puedes evitar sentirte atraído a ella."
    "And you can't help but feel drawn to it."

# game/rutas/nulla.rpy:2024
translate ingles null_fcbbe199:

    # creador "{size=*1.4} Aburridoooo. Te he dejado un pequeño regalo por si quieres probar la otra opción.{/size}"
    creador "{size=*1.4} Boooooring. I've left you a little gift in case you want to try the other option.{/size}"

# game/rutas/nulla.rpy:2025
translate ingles null_beaf5b23:

    # creador "{size=*1.4}Creéme que es más interesante que está.{/size}"
    creador "{size=*1.4}Believe me, it's more interesting than it looks.{/size}"

# game/rutas/nulla.rpy:2026
translate ingles null_fd4d32b3:

    # creador "{size=*1.4}Revisa tus guardados, tal vez tengas tiempo de echarle un ojo en algún momento.{/size}"
    creador "{size=*1.4}Check your saves, maybe you'll have time to take a look at them sometime.{/size}"

# game/rutas/nulla.rpy:2027
translate ingles null_deff30ac:

    # creador "{size=*1.4}No te preocupes, yo tengo todo el tiempo del mundo.{/size}"
    creador "{size=*1.4}Don't worry, I have all the time in the world.{/size}"


translate ingles strings:

    # game/rutas/nulla.rpy:713
    old "¿Te ha pasado algo?"
    new "Has something happened to you?"

    # game/rutas/nulla.rpy:713
    old "Claro"
    new "Sure."

    # game/rutas/nulla.rpy:755
    old "Quiero saber más."
    new "I want to know more."

    # game/rutas/nulla.rpy:755
    old "No necesito saberlo."
    new "I don't need to know."

    # game/rutas/nulla.rpy:858
    old "No, debes dormir"
    new "No, you must sleep."

    # game/rutas/nulla.rpy:858
    old "Ir a buscar a Nulla"
    new "Go find Nulla."

    # game/rutas/nulla.rpy:916
    old "¿A qué te refieres?"
    new "What do you mean?"

    # game/rutas/nulla.rpy:935
    old "Tomar su mano y apoyarlo"
    new "Take his hand and support him."

    # game/rutas/nulla.rpy:935
    old "Sacarlo de ahí"
    new "Get him out of that state."

    # game/rutas/nulla.rpy:960
    old "Consolarlo."
    new "Comfort him."

    # game/rutas/nulla.rpy:976
    old "¿? no comprendes lo que quiere decir"
    new "Huh? You don't understand what he means."

    # game/rutas/nulla.rpy:1006
    old "Mi palabra favorita..."
    new "My favorite word..."

    # game/rutas/nulla.rpy:1085
    old "¿Qué hay de Septem?"
    new "What about Septem?"

    # game/rutas/nulla.rpy:1085
    old "¿Unum?"
    new "Unum?"

    # game/rutas/nulla.rpy:1085
    old "¿Iremos a por Tria y Sextam?"
    new "Are we going for Tria and Sextam?"

    # game/rutas/nulla.rpy:1154
    old "¿Ahora?"
    new "Now?"

    # game/rutas/nulla.rpy:1174
    old "No, quiero quedarme aquí por un rato más"
    new "No, I want to stay here a little longer."

    # game/rutas/nulla.rpy:1232
    old "¿Bebés?"
    new "Babies?"

    # game/rutas/nulla.rpy:1232
    old "¿Te refieres a los animales?"
    new "Do you mean the animals?"

    # game/rutas/nulla.rpy:1259
    old "Si, por favor."
    new "Yes, please."

    # game/rutas/nulla.rpy:1259
    old "No, gracias."
    new "No, thank you."

    # game/rutas/nulla.rpy:1321
    old "¡Hey!"
    new "Hey!"

    # game/rutas/nulla.rpy:1321
    old "No soy el reemplazo de nadie."
    new "I'm not anyone's replacement."

    # game/rutas/nulla.rpy:1355
    old "Escapar."
    new "Escape."

    # game/rutas/nulla.rpy:1355
    old "Intentar conversar."
    new "Try to talk."

    # game/rutas/nulla.rpy:1420
    old "ignorar..."
    new "Ignore..."

    # game/rutas/nulla.rpy:1420
    old "Apoyar a Quinque"
    new "Support Quinque."

    # game/rutas/nulla.rpy:1455
    old "Pedirle por favor que acabe con él rápido."
    new "Ask him to finish him off quickly."

    # game/rutas/nulla.rpy:1525
    old "Comerla"
    new "Eat it."

    # game/rutas/nulla.rpy:1525
    old "Hacerle caso."
    new "Obey him."

    # game/rutas/nulla.rpy:1555
    old "¿Qué?"
    new "What?"

    # game/rutas/nulla.rpy:1555
    old "Pero el trato dice..."
    new "But the deal says..."

    # game/rutas/nulla.rpy:1555
    old "No quiero."
    new "I don't want to."

    # game/rutas/nulla.rpy:1610
    old "Está bien..."
    new "Alright..."

    # game/rutas/nulla.rpy:1732
    old "¿Dejaron de funcionar?"
    new "Have they stopped working?"

    # game/rutas/nulla.rpy:1732
    old "Me alegra que no duela..."
    new "I'm glad it doesn't hurt..."

    # game/rutas/nulla.rpy:1771
    old "Claro, yo te sostengo."
    new "Sure, I'll hold you."

    # game/rutas/nulla.rpy:1771
    old "¿Por qué debo hacerlo?"
    new "Why do I have to do it?"

    # game/rutas/nulla.rpy:1853
    old "¿Qué flor es esta?"
    new "What flower is this?"

    # game/rutas/nulla.rpy:1870
    old "¿Mary?"
    new "Mary?"

    # game/rutas/nulla.rpy:2019
    old "Ir a la sombra."
    new "Go to the shadow."

    # game/rutas/nulla.rpy:2019
    old "Seguir a Nulla."
    new "Follow Nulla."

# TODO: Translation updated at 2025-02-23 15:17

# game/rutas/nulla.rpy:1583
translate ingles rutanullaa_e2b01252:

    # "O mejor dicho, su versión femenina."
    "Or rather, the feminine version."

# game/rutas/nulla.rpy:1588
translate ingles rutanullaa_1cbeedf6:

    # "Nulla solo sonríe complacido con tu respuesta."
    "Nulla only smiles contentedly at your response."

# game/rutas/nulla.rpy:1593
translate ingles rutanullaa_38c150f2:

    # "Nulla te mira en silencio."
    "Nulla looks at you in silence."

# game/rutas/nulla.rpy:1606
translate ingles rutanullaa_8cae4b3d:

    # "Nulla cambia su forma una vez más. A la original, como si estuviera jugando para obtener tu aprobación.."
    "Nulla changes his form once more, reverting to the original, as if playing to win your approval."

# TODO: Translation updated at 2025-02-23 17:02

# game/rutas/nulla.rpy:1345
translate ingles rutanullaa_6ac3c178:

    # "Por lo que solo lo miras, mientras hace sus preguntas retóricas."
    "So you just stare at him as he asks his rhetorical questions."

# TODO: Translation updated at 2025-02-23 19:20

translate ingles strings:

    # game/rutas/nulla.rpy:4
    old "Madre"
    new "Mother"

# TODO: Translation updated at 2025-02-24 01:14

# game/rutas/nulla.rpy:944
translate ingles rutanullaa_dece6de2:

    # "{sc=3}Pero dudo que Nulla se sienta tranquilo si hablo desde el " yo ".{/sc}"
    "{sc=3}Pero dudo que Nulla se sienta tranquilo si hablo desde el yo "

# TODO: Translation updated at 2025-02-24 01:18

# game/rutas/nulla.rpy:944
translate ingles rutanullaa_151cb834:

    # "{sc=3}Pero dudo que Nulla se sienta tranquilo si hablo desde el 'yo'.{/sc}"
    "{sc=3}But I doubt Nulla would feel at ease if I speak using 'I'.{/sc}"

# TODO: Translation updated at 2025-02-25 00:18

# game/rutas/nulla.rpy:827
translate ingles rutanullaa_8d0ca970:

    # "Al menos no se lo toma de forma irrespetuosa, no hay ningún comentario mal intencionado o algún rastro de risa."
    "At least he doesn't take it in a disrespectful way; there's no ill-intentioned remark or hint of laughter."

# game/rutas/nulla.rpy:831
translate ingles rutanullaa_38153fcb:

    # "Caminan por las calles vacías sin algún tipo de conversación que acompañe el ambiente lúgubre del recorrido. Nulla ha estado callado y cabizbajo por un largo período de tiempo."
    "You walk together through the empty streets, silence lingering in the air, matching the somber mood of the journey. Nulla has remained quiet and downcast for quite some time."

# game/rutas/nulla.rpy:898
translate ingles rutanullaa_f1d63af2:

    # nulla "Pensaba que-- como esto ya había pasado en mi otra vida, sería más fácil..."
    nulla "I thought that--since this had already happened in my past life--it would be easier..."

# game/rutas/nulla.rpy:901
translate ingles rutanullaa_d20e14b7:

    # nulla "Tengo muchos recuerdos de ella, que se han liberado al consumir su dominio... ella, me tenía una alta estima... aún."
    nulla "I have many memories of her that were released when her domain was consumed... she held me in high esteem... still."

# game/rutas/nulla.rpy:911
translate ingles rutanullaa_2e728cf1:

    # "Nulla coloca ambas manos en su cara, cubriendo su expresión y comienza a balbucear palabras que no logras comprender."
    "Nulla places both hands on his face, covering his expression, and starts mumbling words you cannot understand."

# game/rutas/nulla.rpy:955
translate ingles rutanullaa_e1ae1ad8:

    # "Acaricias su espalda y das pequeñas palmadas, para ayudar a liberar esos sobrecogedores sentimientos, mezclados y atados, que se traducen en un llanto."
    "You caress his back and give gentle pats to help release those overwhelming, mixed, and intertwined feelings that manifest as tears."

# game/rutas/nulla.rpy:1050
translate ingles rutanullaa_550df210:

    # nulla "Ya no más lloriqueos, lo prometo."
    nulla "No more whining, I promise."

# game/rutas/nulla.rpy:1057
translate ingles rutanullaa_45f9507b:

    # "Pero a pesar de estar en el país de los sueños y deseos."
    "But despite being in the land of dreams and desires."

# game/rutas/nulla.rpy:1273
translate ingles rutanullaa_493c34b4:

    # "Te sorprende un poco sus palabras. Se oye sincero, muy considerado de la situación."
    "You're a bit surprised by his words. They sound sincere, very considerate of the situation."

# game/rutas/nulla.rpy:1671
translate ingles rutanullaa_2bf16ecc:

    # "Te mira con una sonrisa inquietante."
    "He looks at you with a questioning smile."

# game/rutas/nulla.rpy:2027
translate ingles null_adc33d10:

    # creador "{size=*1.4}créeme que es más interesante que está.{/size}"
    creador "{size=*1.4}Believe me, it's more interesting than it looks.{/size}"

# TODO: Translation updated at 2025-10-05 02:57

# game/rutas/nulla.rpy:35
translate ingles rutanullaa_dbefcae4:

    # nulla "{glitch=20.0}{color=ffffff}{b}Que no puede materializarse en tu mundo{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}I can't materialize in your world.{/glitch}"

# game/rutas/nulla.rpy:123
translate ingles rutanullaa_02219582:

    # "Escuchas y sientes como Nulla toca suelo con sus pies, para luego ser rodeados de luz y colores que te dejan con una ceguera momentánea."
    "You hear and feel Nulla's feet touch the ground, then light and color surround you both, leaving you momentarily blinded."

# game/rutas/nulla.rpy:146
translate ingles rutanullaa_e1579684:

    # "Ya en la cocina, Nulla procede a buscar en sus encimeras y cajones elementos para cocinar algo que supones debe ser dulce. Pues ha sacado el azúcar y el café de una de las encimeras, mientras busca, él habla."
    "Now in the kitchen, Nulla rummages through the counters and drawers, looking for ingredients to cook something you assume must be sweet. He's taken out sugar and coffee from one of the cupboards, and while searching, he speaks."

# game/rutas/nulla.rpy:181
translate ingles rutanullaa_c3eb0993:

    # "Nulla no te deja rebatirle."
    "Nulla doesn't let you argue back."

# game/rutas/nulla.rpy:326
translate ingles rutanullaa_4f45596b:

    # nulla "Verás, la marioneta se ha convertido en un medio de confirmación gracias a ti."
    nulla "You see, the puppet has become a means of confirmation thanks to you."

# game/rutas/nulla.rpy:333
translate ingles rutanullaa_f7c65076:

    # nulla "Es como la paradoja del árbol que cae..."
    nulla "It's like the paradox of the falling tree..."

# game/rutas/nulla.rpy:610
translate ingles rutanullaa_9b791ad4:

    # "Un centenar de manos salen del suelo y agarran por las extremidades a Quattor."
    "Hundreds of hands rise from the ground, seizing Quattor by the limbs."

# game/rutas/nulla.rpy:644
translate ingles rutanullaa_899eee52:

    # nulla "Antiguamente ella fue mi aprendiz..."
    nulla "She used to be my apprentice long ago..."

# game/rutas/nulla.rpy:658
translate ingles rutanullaa_da18aeea:

    # nulla "Piensa en mí como una cebolla."
    nulla "Think of me as an onion."

# game/rutas/nulla.rpy:676
translate ingles rutanullaa_b9f25fff:

    # nulla "Eres el mejor aprendiz que he tenido."
    nulla "You're the best apprentice I've ever had."

# game/rutas/nulla.rpy:739
translate ingles rutanullaa_436c7922:

    # nulla "En la época donde estaba el Creador, él puso una serie de reglas... tontas, pero al fin y al cabo reglas para mantener al jardín estable."
    nulla "Back when the Creator still existed, he made a set of rules... foolish ones, but rules nonetheless, to keep the Garden stable."

# game/rutas/nulla.rpy:771
translate ingles rutanullaa_baf447a8:

    # nulla "Por lo que a ninguno se les ha pasado por la cabeza asesinar al otro, pues sería más difícil mantener dos conceptos."
    nulla "So none of them ever thought of killing the other--it would only make it harder to sustain two concepts at once."

# game/rutas/nulla.rpy:949
translate ingles rutanullaa_3065b328:

    # "Pero sientes como Nulla aprieta tu mano con fuerza."
    "But you feel Nulla squeeze your hand tightly."

# game/rutas/nulla.rpy:1147
translate ingles rutanullaa_43c358d2:

    # "Imaginas una vida común y corriente junto con él, haciendo cosas cotidianas, yendo de compras para llenar la despensa... citas y quién sabe qué otras cosas más... y no se ve para nada mal."
    "You imagine an ordinary life with him--doing mundane things, shopping for groceries, going on dates, and who knows what else... and it doesn't seem bad at all."

# game/rutas/nulla.rpy:1381
translate ingles rutanullaa_2beea75e:

    # "En un intento patético de formar un escudo."
    "In a pathetic attempt to form a shield."

# game/rutas/nulla.rpy:1655
translate ingles rutanullaa_0265bbfd:

    # "Sientes como algo se enreda en tu cuello y te arrebata de los brazos de Nulla."
    "You feel something coil around your neck and pull you out of Nulla's arms."

# game/rutas/nulla.rpy:1911
translate ingles rutanullaa_268fb93a:

    # "_______________________________________________________________________________________________"
    "______________________________________"

# game/rutas/nulla.rpy:1912
translate ingles rutanullaa_eaac225b:

    # " ___________________________________ "
    " __________________"

# game/rutas/nulla.rpy:1913
translate ingles rutanullaa_05c6ac1d:

    # " . . . . . "
    " . . . . . "

# game/rutas/nulla.rpy:1915
translate ingles rutanullaa_2ab8f681:

    # madre "Con esto será suficiente."
    madre "This should be enough."

# game/rutas/nulla.rpy:1916
translate ingles rutanullaa_741be751:

    # madre "Espero que te quede claro."
    madre "I hope this is clear to you."

# game/rutas/nulla.rpy:1917
translate ingles rutanullaa_2ac54334:

    # "¿Esa es la voz de Madre?"
    "Is that Mother's voice?"

# game/rutas/nulla.rpy:1918
translate ingles rutanullaa_05c6ac1d_1:

    # " . . . . . "
    " . . . . . "

# game/rutas/nulla.rpy:1919
translate ingles rutanullaa_c51d7991:

    # " . . . "
    " . . . "

# game/rutas/nulla.rpy:1920
translate ingles rutanullaa_446775ff:

    # madre "Por poco y se fusionan... Lo siento, no sabía que eso podía pasar."
    madre "They almost fused... I'm sorry, I didn't know that could happen."

# game/rutas/nulla.rpy:1921
translate ingles rutanullaa_87205f9f:

    # nulla "¿Era necesario hacer eso?"
    nulla "Was that really necessary?"

# game/rutas/nulla.rpy:1922
translate ingles rutanullaa_647edc8e:

    # madre "Es la única forma de hacerte entender. Te estás distrayendo."
    madre "It's the only way to make you understand. You're getting distracted."

# game/rutas/nulla.rpy:1923
translate ingles rutanullaa_8ab0ed34:

    # madre "Eso no me gusta."
    madre "I don't like that."

# game/rutas/nulla.rpy:1924
translate ingles rutanullaa_399317c3:

    # nulla "Mi plan va a la perfección. Cómo lo ejecute no es de tu incumbencia."
    nulla "My plan is going perfectly. How I execute it is none of your concern."

# game/rutas/nulla.rpy:1925
translate ingles rutanullaa_ef36aa83:

    # nulla "Sé un poco más agradecida."
    nulla "Try being a bit more grateful."

# game/rutas/nulla.rpy:1926
translate ingles rutanullaa_8f72272b:

    # madre "No voy a aceptar que me hables de esa manera, señorito."
    madre "I will not tolerate you speaking to me like that, young man."

# game/rutas/nulla.rpy:1927
translate ingles rutanullaa_a3140b1e:

    # "Una parte dentro de ti comienza a doler."
    "Something inside you begins to ache."

# game/rutas/nulla.rpy:1928
translate ingles rutanullaa_c5758150:

    # nulla "Ouch! ¡No me aprietes ese ojo!"
    nulla "Ouch! Don't squeeze my eye like that!"

# game/rutas/nulla.rpy:1930
translate ingles rutanullaa_378ba819:

    # "Memorias de algo que olvidaste comienzan a brotar como una chispa, las cuales al mismo tiempo que llegan, se esfuman en nada."
    "Memories of something forgotten spark to life, only to fade back into nothingness as soon as they appear."

# game/rutas/nulla.rpy:1932
translate ingles rutanullaa_278c7e29:

    # "........."
    "........."

# game/rutas/nulla.rpy:1933
translate ingles rutanullaa_9ea6b0e1:

    # ".............."
    ".............."

# game/rutas/nulla.rpy:1935
translate ingles rutanullaa_d973dd28:

    # "En la blancura del lugar, ves una figura."
    "Amid the whiteness of the place, you see a figure."

# game/rutas/nulla.rpy:1936
translate ingles rutanullaa_b7fa4f6e:

    # "Te mira desde lo lejos. sin intención de acercarse."
    "He watches you from afar, with no intention of coming closer."

# game/rutas/nulla.rpy:1937
translate ingles rutanullaa_de83b4b1:

    # "Pero con una clara fascinación."
    "But with a clear fascination."

# game/rutas/nulla.rpy:1939
translate ingles rutanullaa_89c91fa1:

    # "{glitch=20.0}{color=ffffff}{b}Oh vaya~~ Tú sí que me puedes ayudar.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Oh, well now~~ You can actually help me.{/glitch}"

# game/rutas/nulla.rpy:1942
translate ingles rutanullaa_a20cefa7_24:

    # "..."
    "..."

# game/rutas/nulla.rpy:1944
translate ingles rutanullaa_cd64c353:

    # "{glitch=20.0}{color=ffffff}{b}Su pasado y su futuro.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Their past and their future.{/glitch}"

# game/rutas/nulla.rpy:1946
translate ingles rutanullaa_a20cefa7_25:

    # "..."
    "..."

# game/rutas/nulla.rpy:1948
translate ingles rutanullaa_554cfdfa:

    # "La entidad se ríe a carcajadas."
    "The entity bursts into laughter."

# game/rutas/nulla.rpy:1949
translate ingles rutanullaa_96b9b9bc:

    # "{glitch=20.0}{color=ffffff}{b}No puedo creer que después de años, recién ahora pueda obtener alguna respuesta de ti.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I can't believe that after all these years, I finally get a response from you.{/glitch}"

# game/rutas/nulla.rpy:1950
translate ingles rutanullaa_188143c7:

    # "{glitch=20.0}{color=ffffff}{b}Increíble.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Increíble.{/glitch}"


# game/rutas/nulla.rpy:1951
translate ingles rutanullaa_3ad1f68e:

    # "{glitch=20.0}{color=ffffff}{b}Bien, escúchame, necesito que vayas al interior de Nulla.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Bien, listen to me. I need you to go inside Nulla.{/glitch}"

# game/rutas/nulla.rpy:1955
translate ingles rutanullaa_702903ab:

    # "{glitch=20.0}{color=ffffff}{b}Él es un egoísta.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}He's a selfish person.{/glitch}"

# game/rutas/nulla.rpy:1956
translate ingles rutanullaa_d6ff6f7c:

    # "{glitch=20.0}{color=ffffff}{b}Solo porque nos tiene atrapados en su cuerpo, no significa que pueda tomar la decisión por si sólo.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Just because he's got us all trapped inside his body doesn't mean he gets to make the decisions all on his own.{/glitch}"

# game/rutas/nulla.rpy:1959
translate ingles rutanullaa_b8b5c6e5:

    # "La figura aparece frente a ti."
    "The figure appears before you."

# game/rutas/nulla.rpy:1960
translate ingles rutanullaa_e81657a3:

    # "Es Nulla."
    "It's Nulla."

# game/rutas/nulla.rpy:1963
translate ingles rutanullaa_45b32693:

    # "{glitch=20.0}{color=ffffff}{b}JA!{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}JA!{/glitch}"

# game/rutas/nulla.rpy:1964
translate ingles rutanullaa_b66a1f2d:

    # "{glitch=20.0}{color=ffffff}{b}Ese no es mi nombre. No soy ese llorón.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}That's not my name. I'm not that crybaby.{/glitch}"

# game/rutas/nulla.rpy:1965
translate ingles rutanullaa_3bd61cae:

    # "{glitch=20.0}{color=ffffff}{b}Pero al parecer alguien hizo que nos expulsaran a todos por un segundo, y gracias a eso te puedo contactar.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}But it seems someone forced us all out for a second--and thanks to that, I can reach you.{/glitch}"

# game/rutas/nulla.rpy:1966
translate ingles rutanullaa_daeb2576:

    # "{glitch=20.0}{color=ffffff}{b}Él cuerpo de esta cosa que utilizas es fácil de acceder...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}The body of that thing you're using is easy to access...{/glitch}"

# game/rutas/nulla.rpy:1967
translate ingles rutanullaa_9315a5c5:

    # "{glitch=20.0}{color=ffffff}{b}Aunque creo que solo será por esta vez. Él ya se debe estar dando cuenta de que le falta una capa.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Though, I think this will only work once. He must already be realizing he's missing a layer.{/glitch}"

# game/rutas/nulla.rpy:1970
translate ingles rutanullaa_022a1829:

    # "{glitch=20.0}{color=ffffff}{b}Bueno, ¡no importa!{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Well, ¡no importa!{/glitch}"

# game/rutas/nulla.rpy:1971
translate ingles rutanullaa_b03f668f:

    # "{glitch=20.0}{color=ffffff}{b}Me vas a ayudar, ¿cierto?{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}You're going to help me, right?{/glitch}"

# game/rutas/nulla.rpy:1972
translate ingles rutanullaa_95b8b586:

    # "{glitch=20.0}{color=ffffff}{b}Haz que se quede más rato en sus memorias.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Make him linger longer in his memories.{/glitch}"

# game/rutas/nulla.rpy:1975
translate ingles rutanullaa_ab81d7f7:

    # "{glitch=20.0}{color=ffffff}{b}Sé que tienes acceso a ellas. Pero lo tienes que hacer antes de que él consiga finalizar su misión.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I know you have access to them. But you have to do it before he completes his mission.{/glitch}"

# game/rutas/nulla.rpy:1976
translate ingles rutanullaa_68feef8e:

    # "{glitch=20.0}{color=ffffff}{b}Porque luego será imposible para ti tocar un mundo inexistente.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Because, after that, it'll be impossible for you to touch a world that no longer exists.{/glitch}"

# game/rutas/nulla.rpy:1977
translate ingles rutanullaa_75d283cd:

    # "{glitch=20.0}{color=ffffff}{b}...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}...{/glitch}"

# game/rutas/nulla.rpy:1980
translate ingles rutanullaa_bdfedcf9:

    # "{glitch=20.0}{color=ffffff}{b}No se lo digas, pero ya sé una manera para curar todos nuestros males sin la necesidad de acabar con nuestra existencia.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Don't tell him, but I already know a way to cure all our ailments without ending our existence.{/glitch}"

# game/rutas/nulla.rpy:1981
translate ingles rutanullaa_a3c47ab0:

    # "Él te extiende la mano, esperando a que se la des."
    "He extends his hand toward you, waiting for you to take it."

# game/rutas/nulla.rpy:1982
translate ingles rutanullaa_81691695:

    # "{glitch=20.0}{color=ffffff}{b}Te estaré esperando.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I'll be waiting for you.{/glitch}"

# game/rutas/nulla.rpy:1985
translate ingles rutanullaa_693932db:

    # "Pero algo te lo impide, y como si fueras agarrado del cuello, con un solo tirón, tus ojos se abren."
    "But something stops you, and, as if someone grabbed you by the neck, a single pull forces your eyes open."

# game/rutas/nulla.rpy:1986
translate ingles rutanullaa_bde7c1a8:

    # "{sc=4}{size=*2.0}................{/size}{/sc}"
    "{sc=4}{size=*2.0}................{/size}{/sc}"

# game/rutas/nulla.rpy:1987
translate ingles rutanullaa_556f28e9:

    # "{sc=4}{size=*1.5}..........{/size}{/sc}"
    "{sc=4}{size=*1.5}..........{/size}{/sc}"

# game/rutas/nulla.rpy:1989
translate ingles rutanullaa_2d8b13f1:

    # "Estás en la casa de Nulla, acostado en su cama."
    "You're in Nulla's house, lying on his bed."

# game/rutas/nulla.rpy:1991
translate ingles rutanullaa_3b64668f_2:

    # nulla "¡Buenos días!"
    nulla "Good morning!"

# game/rutas/nulla.rpy:1994
translate ingles rutanullaa_3d5515a1:

    # nulla "Disculpa por lo sucedido en la noche anterior."
    nulla "Sorry about what happened last night."

# game/rutas/nulla.rpy:1997
translate ingles rutanullaa_dc2b4827:

    # nulla "Madre quería hablar a solas conmigo."
    nulla "Mother wanted to talk to me alone."

# game/rutas/nulla.rpy:2001
translate ingles rutanullaa_a20cefa7_26:

    # "..."
    "..."

# game/rutas/nulla.rpy:2003
translate ingles rutanullaa_9dad6265:

    # "Intentas levantarte pero Nulla te lo impide tocando y empujando levemente tus hombros. Haciendo que te recuestes nuevamente en la cama en la que descansas."
    "You try to get up, but Nulla stops you, his hands pressing gently against your shoulders, urging you to lie back down on the bed."

# game/rutas/nulla.rpy:2006
translate ingles rutanullaa_15280f80:

    # nulla "Tu cuerpo se rompió cuando Madre dijo mi nombre original."
    nulla "Your body broke apart when Mother spoke my original name."

# game/rutas/nulla.rpy:2007
translate ingles rutanullaa_bb44be57:

    # nulla "Tu esencia revoloteaba por todo el lugar, por poco te absorbo por completo..."
    nulla "Your essence was fluttering everywhere, I almost absorbed you completely..."

# game/rutas/nulla.rpy:2012
translate ingles rutanullaa_9a96de3d:

    # nulla "No lo sé, ni quiero averiguarlo."
    nulla "I don't know, and I don't want to find out."

# game/rutas/nulla.rpy:2018
translate ingles rutanullaa_ad7a5784:

    # nulla "Awwww--"
    nulla "Awwww--"

# game/rutas/nulla.rpy:2021
translate ingles rutanullaa_f8875658:

    # nulla "No te preocupes amor, no me vas a perder tan fácil."
    nulla "Don't worry, amor--you're not getting rid of me that easily."

# game/rutas/nulla.rpy:2022
translate ingles rutanullaa_a8875719:

    # "Nulla te toma la mano y te planta un beso en el delicado dorso que ya se ha curado por completo."
    "Nulla takes your hand and plants a kiss on the delicate back of it, which has already healed completely."

# game/rutas/nulla.rpy:2024
translate ingles rutanullaa_a9d8be0a:

    # "Hay una pausa, donde Nulla divaga por un segundo."
    "There's a pause as Nulla drifts off in thought for a moment."

# game/rutas/nulla.rpy:2028
translate ingles rutanullaa_3f8db17d:

    # nulla "Bueno. Ahora que estamos solos nuevamente, te recuerdo--"
    nulla "Well. Now that we're alone again, let me remind you--"

# game/rutas/nulla.rpy:2031
translate ingles rutanullaa_dfc7566e:

    # nulla "Que tenemos dos citas pendientes."
    nulla "We still have two dates pending."

# game/rutas/nulla.rpy:2033
translate ingles rutanullaa_bc922bc9:

    # "Nulla se aleja de la cama y camina a la ventana. Con energía abre las cortinas, dejando entrar la luz que se genera gracias al vacío."
    "Nulla steps away from the bed and walks toward the window. With a burst of energy, he pulls the curtains open, letting in the light that shines through the Void."

# game/rutas/nulla.rpy:2034
translate ingles rutanullaa_d076a431:

    # "Es una luz tenue, que no molesta la vista."
    "It's a dim light, gentle on the eyes."

# game/rutas/nulla.rpy:2035
translate ingles rutanullaa_08af26b7:

    # "Agradable hasta cierto sentido."
    "Comforting, in a way."

# game/rutas/nulla.rpy:2037
translate ingles rutanullaa_598e7c15:

    # nulla "Tenemos dos días completos."
    nulla "We've got two full days."

# game/rutas/nulla.rpy:2040
translate ingles rutanullaa_20a89258:

    # nulla "Hoy te voy a invitar a cenar."
    nulla "Tonight, I'm taking you to dinner."

# game/rutas/nulla.rpy:2043
translate ingles rutanullaa_fae19b86:

    # nulla "Me gustaría tener un momento de tranquilidad contigo."
    nulla "I'd like to have a quiet moment with you."

# game/rutas/nulla.rpy:2044
translate ingles rutanullaa_02169ce2:

    # nulla "Donde nos atiendan y podamos pasar una buena tarde."
    nulla "Somewhere we'll be served and can just enjoy the evening together."

# game/rutas/nulla.rpy:2049
translate ingles rutanullaa_eb9053d3:

    # "Nulla sonríe mientras junta ambas manos y ladea la cabeza ligeramente."
    "Nulla smiles, clasping his hands together and tilting his head slightly."

# game/rutas/nulla.rpy:2052
translate ingles rutanullaa_befd8adf:

    # nulla "A mi hotel."
    nulla "To my hotel."

# game/rutas/nulla.rpy:2057
translate ingles rutanullaa_c4acff73:

    # nulla "¿Mmm? ¿Realmente te interesan?"
    nulla "Mmm? Are you really interested in that?"

# game/rutas/nulla.rpy:2060
translate ingles rutanullaa_1d606bd0:

    # nulla "Pensé que te agradaría desconectarte un tiempo de la cacería."
    nulla "I thought you'd enjoy taking a break from the hunt."

# game/rutas/nulla.rpy:2063
translate ingles rutanullaa_c9672d37:

    # nulla "Además, no vendría mal hacer esperar a Septem."
    nulla "Besides, it wouldn't hurt to make Septem wait a little."

# game/rutas/nulla.rpy:2064
translate ingles rutanullaa_d7c0e1ae:

    # nulla "Y atacar cuando menos se lo espere."
    nulla "And strike when he least expects it."


# game/rutas/nulla.rpy:2069
translate ingles rutanullaa_5b4aeae7:

    # nulla "Mmmm, no lo creo."
    nulla "Mmmm, I don't think so."

# game/rutas/nulla.rpy:2072
translate ingles rutanullaa_41a873b6:

    # nulla "No creo que haya mucho de lo cual podamos disfrutar ya."
    nulla "I don't think there's much left for us to enjoy anymore."

# game/rutas/nulla.rpy:2073
translate ingles rutanullaa_a3de923a:

    # nulla "Debe estar todo oscuro, salvo los dominios que he consumido."
    nulla "Everything must be pitch black, except for the domains I've already consumed."

# game/rutas/nulla.rpy:2076
translate ingles rutanullaa_11892f52:

    # nulla "Así que no lo recomiendo."
    nulla "So, I wouldn't recommend it."

# game/rutas/nulla.rpy:2080
translate ingles rutanullaa_a20cefa7_27:

    # "..."
    "..."

# game/rutas/nulla.rpy:2083
translate ingles rutanullaa_73c31359:

    # nulla "Iré a hacer el desayuno, tu marioneta se encuentra muy débil como para pararse ahora mismo."
    nulla "I'll go make breakfast. Your puppet's too weak to stand right now."

# game/rutas/nulla.rpy:2084
translate ingles rutanullaa_fe748d7c:

    # nulla "Y la necesitamos en las mejores condiciones para poder tener nuestro tiempo sin ningún contratiempo."
    nulla "And we need it in top condition, so nothing interrupts our time together."

# game/rutas/nulla.rpy:2086
translate ingles rutanullaa_0c810434:

    # "Nulla se deshace como si de humo fuera, dejando un gran hoyo negro en el suelo que te demuestra que se ha teletransportado hacia la cocina, supones."
    "Nulla dissolves into thin smoke, leaving behind a black hole on the floor--proof he's teleported to the kitchen, you assume."

# game/rutas/nulla.rpy:2087
translate ingles rutanullaa_5b746db6:

    # "Parte de ti espera tener una nueva conversación con la entidad que te contactó antes de despertar."
    "Part of you hopes to hear again from the entity that contacted you before you woke."

# game/rutas/nulla.rpy:2088
translate ingles rutanullaa_f767d756:

    # "Pero en tu interior solo te encuentras con tus pensamientos y los latidos de tu fragmentado corazón."
    "But inside, you find only your own thoughts and the echo of your fractured heartbeat."

# game/rutas/nulla.rpy:2089
translate ingles rutanullaa_1d34a315:

    # "Solo eso y nada más."
    "Nothing else. Just that."

# game/rutas/nulla.rpy:2090
translate ingles rutanullaa_28880850:

    # "Cuando el silencio sobrepasa tu límite decides mirar la ventana."
    "When the silence becomes too much, you decide to look out the window."

# game/rutas/nulla.rpy:2091
translate ingles rutanullaa_300c6b95:

    # "Y te preguntas por cómo estará el resto del jardín en este momento."
    "And you wonder what's become of the rest of the Garden."

# game/rutas/nulla.rpy:2092
translate ingles rutanullaa_40915037:

    # "De cierta manera, sientes una curiosidad mórbida en saber y ver el estado de los dominios que quedan."
    "In a way, you feel a morbid curiosity to see what's left of the remaining domains."

# game/rutas/nulla.rpy:2093
translate ingles rutanullaa_a78fe8c3:

    # "Al igual que quieres apreciar cómo están los dominios consumidos por Nulla."
    "And you want to see what the domains consumed by Nulla look like now."

# game/rutas/nulla.rpy:2094
translate ingles rutanullaa_180dbe97:

    # "¿Estarán completamente negros o blancos?"
    "Would they be completely black or white?"

# game/rutas/nulla.rpy:2095
translate ingles rutanullaa_4d2c4193:

    # nulla "Amoooor~"
    nulla "Amoooor~"

# game/rutas/nulla.rpy:2096
translate ingles rutanullaa_48362f84:

    # nulla "No dejes que la marioneta te amargue este día."
    nulla "Don't let the puppet ruin your day."

# game/rutas/nulla.rpy:2097
translate ingles rutanullaa_c2b97a06:

    # nulla "Hoy y mañana tienen que ser días de puro disfrute <3"
    nulla "Today and tomorrow are meant to be days of pure pleasure! <3"

# game/rutas/nulla.rpy:2098
translate ingles rutanullaa_6facb596:

    # "Nulla aparece esta vez por la puerta que está entreabierta, empujándola con uno de sus apéndices hechos de vacío."
    "Nulla appears this time through the half-open door, pushing it gently with one of his Void-formed appendages."

# game/rutas/nulla.rpy:2099
translate ingles rutanullaa_3c47cfc4:

    # "Y es ahí cuando te llega el aroma a pan caliente y a café recién elaborado."
    "That's when the scent of warm bread and freshly brewed coffee reaches you."

# game/rutas/nulla.rpy:2100
translate ingles rutanullaa_a0549a5f:

    # "El olor inunda la habitación al instante en que tus ojos se posan en la bandeja que trae Nulla entre sus manos."
    "The smell fills the room as your eyes fall on the tray Nulla carries in his hands."

# game/rutas/nulla.rpy:2101
translate ingles rutanullaa_a46a8294:

    # "Esta vez es un desayuno para dos."
    "This time, it's breakfast for two."

# game/rutas/nulla.rpy:2103
translate ingles rutanullaa_f296ce32:

    # "Se sienta contigo en la cama, posando la bandeja sobre las mantas, mientras que con uno de sus apéndices te ofrece tu taza."
    "He sits beside you on the bed, setting the tray on the blankets and offering you your cup with one of his Void appendages."

# game/rutas/nulla.rpy:2104
translate ingles rutanullaa_14c432e0:

    # "Pero está vacía."
    "But it's empty."

# game/rutas/nulla.rpy:2105
translate ingles rutanullaa_58558870:

    # "Tú le miras con confusión."
    "You look at him, puzzled."

# game/rutas/nulla.rpy:2106
translate ingles rutanullaa_d092e112:

    # nulla "Nunca te pregunté qué es lo que te gusta."
    nulla "I never asked what you actually like."

# game/rutas/nulla.rpy:2107
translate ingles rutanullaa_bcb334ea:

    # nulla "Hay gente que le gusta el café, pero también hay gente que no lo soporta."
    nulla "Some people love coffee, but others can't stand it."

# game/rutas/nulla.rpy:2108
translate ingles rutanullaa_5c86d78a:

    # nulla "Con el té se puede variar un poco más, pero luego entra en juego si disfrutas del azúcar o no en ellos."
    nulla "Tea allows for a bit more variety... though, then there's the matter of whether you like it sweet or not."

# game/rutas/nulla.rpy:2110
translate ingles rutanullaa_bb302699:

    # nulla "Así que, voy a tomar esta oportunidad para saber otra cosa de ti."
    nulla "So, I'll take this chance to learn something else about you."

# game/rutas/nulla.rpy:2111
translate ingles rutanullaa_f4f3efc6:

    # nulla "Quiero saber más que simplemente tu palabra favorita."
    nulla "I want to know more than just your favorite word."

# game/rutas/nulla.rpy:2112
translate ingles rutanullaa_974682bb:

    # nulla "[palabra]."
    nulla "[palabra]."

# game/rutas/nulla.rpy:2113
translate ingles rutanullaa_abbcc3e3:

    # "Nulla se ríe por lo bajo, una mezcla entre ternura y pillería."
    "Nulla chuckles softly, a mix of fondness and mischief."

# game/rutas/nulla.rpy:2115
translate ingles rutanullaa_a6576275:

    # "Quiero saber más de ti..."
    "I want to know more about you..."

# game/rutas/nulla.rpy:2116
translate ingles rutanullaa_ca34de82:

    # nulla "Entonces..."
    nulla "So then..."

# game/rutas/nulla.rpy:2117
translate ingles rutanullaa_ff8273c9:

    # nulla "¿Té o café?"
    nulla "Tea or coffee?"

# game/rutas/nulla.rpy:2120
translate ingles rutanullaa_5f6c9f44_1:

    # nulla "Mmmm."
    nulla "Mmmm."

# game/rutas/nulla.rpy:2121
translate ingles rutanullaa_51e9e0af:

    # "La sonrisa de Nulla se agranda como la de un zorro."
    "Nulla's grin widens, sly as a fox."

# game/rutas/nulla.rpy:2122
translate ingles rutanullaa_c844dabe:

    # "Y de la nada, tu taza se llena de un líquido caliente, y un aroma fresco reemplaza el del café."
    "Out of nowhere, your cup fills with a warm liquid, its fresh aroma replacing that of coffee."

# game/rutas/nulla.rpy:2125
translate ingles rutanullaa_14ef2556:

    # nulla "Tenemos gustos similares."
    nulla "Looks like we have similar tastes."

# game/rutas/nulla.rpy:2126
translate ingles rutanullaa_6a045ddf:

    # "Dice él orgulloso."
    "He says it proudly."

# game/rutas/nulla.rpy:2127
translate ingles rutanullaa_d699d544:

    # "Y de la nada, tu taza se llena de un líquido caliente, duplicando el aroma fuerte del café."
    "And suddenly, your cup fills with a steaming liquid, doubling the strong scent of coffee."

# game/rutas/nulla.rpy:2128
translate ingles rutanullaa_60a1b978:

    # "Una vez listo, Nulla comienza a preparar el pan. Reparte la mantequilla en el borde crujiente y esta se derrite por el calor que emana la masa."
    "Once ready, Nulla starts preparing the bread, spreading butter over the crisp edges, where it melts under the warmth of the dough."

# game/rutas/nulla.rpy:2129
translate ingles rutanullaa_9a2f0315:

    # nulla "El pan con mantequilla es mi preferido, simple y fácil de preparar."
    nulla "Bread with butter's my favorite; simple, easy to make."

# game/rutas/nulla.rpy:2130
translate ingles rutanullaa_41c19f9f:

    # nulla "Tú puedes ponerle lo que gustes."
    nulla "You can add whatever you like to yours."

# game/rutas/nulla.rpy:2131
translate ingles rutanullaa_3fc1be8a:

    # "Y es verdad, en la bandeja hay un montón de cosas, tanto dulces como saladas, para acompañar el pan."
    "And it's true--on the tray lies an assortment of things, sweet and savory alike, to go with the bread."

# game/rutas/nulla.rpy:2132
translate ingles rutanullaa_4dea48e4:

    # nulla "Es una lástima que no te pueda ver comer en realidad."
    nulla "It's a shame I can't actually see you eat."

# game/rutas/nulla.rpy:2133
translate ingles rutanullaa_d64bb6b8:

    # nulla "Ni que tampoco puedas probar mis desayunos."
    nulla "Or that you can't taste my breakfasts either."

# game/rutas/nulla.rpy:2134
translate ingles rutanullaa_aab7a5db:

    # "Dice él mientras toma su propia taza de café y le da un sorbo."
    "He says this while taking a sip from his own cup of coffee."

# game/rutas/nulla.rpy:2135
translate ingles rutanullaa_6bcfa1cd:

    # "No se le ve tan dolido a como suena su voz."
    "He doesn't look as hurt as his voice suggests."

# game/rutas/nulla.rpy:2136
translate ingles rutanullaa_e3273af7:

    # "Nulla llena el momento con una conversación casual. Entre sorbo y sorbo, acepta con resignación que toda conversación contigo es, y siempre será, unilateral."
    "Nulla fills the moment with casual talk. Between sips, he accepts with quiet resignation that every conversation with you is, and always will be, one-sided."

# game/rutas/nulla.rpy:2137
translate ingles rutanullaa_3880ef1b:

    # "Pero es algo con lo que debe cargar hasta que encuentre una forma para hablar contigo de una forma directa, te dijo antes de comenzar a parlotear de los diferentes tipos de té que ha tenido el gusto de probar."
    "But it's something he'll have to bear until he finds a way to speak to you directly--he said that before rambling on about the many kinds of tea he's had the pleasure to taste."

# game/rutas/nulla.rpy:2138
translate ingles rutanullaa_e5fcb581:

    # "Así que tu desayuno es... interesante."
    "So your breakfast turns out to be... interesting."

# game/rutas/nulla.rpy:2140
translate ingles rutanullaa_b824bca9:

    # "Bueno, ¿A quien vamos a engañar?... a estás alturas, Nulla podría estar hablando de quién sabe qué cosa, y tú aún lo escucharías como si cada palabra fuera oro puro, ¿no?."
    "Well, who are you kidding? At this point, Nulla could be talking about anything, and you'd still listen as if every word were pure gold, wouldn't you?"

# game/rutas/nulla.rpy:2141
translate ingles rutanullaa_f77e192d:

    # "Él te tiene tan atado como tú lo tienes a él."
    "He's got you just as bound to him as you've got him bound to you."

# game/rutas/nulla.rpy:2142
translate ingles rutanullaa_0bb3496f:

    # "Al terminar el desayuno, sientes como tu cuerpo recupera fuerzas y Nulla se da cuenta de ello también."
    "When breakfast ends, you feel your body regaining its strength, and Nulla notices it, too."

# game/rutas/nulla.rpy:2144
translate ingles rutanullaa_a6e17cbc:

    # nulla "Estaba pensando..."
    nulla "I was thinking..."


# game/rutas/nulla.rpy:2145
translate ingles rutanullaa_41b731cc:

    # "Ambos se encuentran mirando el vacío, esperando el momento justo para ir al hotel."
    "Both of you stare into the Void, waiting for the right moment to head to the hotel."

# game/rutas/nulla.rpy:2146
translate ingles rutanullaa_83528f50:

    # "Pasando las horas con la compañía del otro. Disfrutando de las pequeñas cosas que suceden o de la rutina hogareña que tanto Nulla gusta de tener contigo."
    "You spend the hours in each other's company, enjoying the little things that happen and the quiet rhythm of a domestic routine that Nulla so enjoys sharing with you."

# game/rutas/nulla.rpy:2148
translate ingles rutanullaa_ab8e7492:

    # nulla "Este lugar no me gusta..."
    nulla "I don't like this place..."

# game/rutas/nulla.rpy:2149
translate ingles rutanullaa_ed11eaa7:

    # nulla "Nunca me gustó en realidad."
    nulla "I never really did, to be honest."

# game/rutas/nulla.rpy:2152
translate ingles rutanullaa_720fd521:

    # nulla "No importa donde mire, todo tiene su nombre y tinta."
    nulla "No matter where I look, everything has its name and its ink."

# game/rutas/nulla.rpy:2153
translate ingles rutanullaa_d3dee382:

    # nulla "Es horrible."
    nulla "It's awful."

# game/rutas/nulla.rpy:2156
translate ingles rutanullaa_54134695:

    # "Él mira sus manos con cierto desagrado."
    "He looks down at his hands with a trace of disgust."

# game/rutas/nulla.rpy:2157
translate ingles rutanullaa_0e3939ec:

    # "Y tú no comprendes del todo lo que está pasando por su cabeza."
    "And you can't quite grasp what's running through his mind."

# game/rutas/nulla.rpy:2160
translate ingles rutanullaa_6cd2fa24:

    # nulla "Y sé que puede ser mucho pedir..."
    nulla "And I know I might be asking a lot..."

# game/rutas/nulla.rpy:2161
translate ingles rutanullaa_12583b6a:

    # nulla "Sé que incluso es muy probable que no puedas hacerlo, pues puede ser un poco engorroso."
    nulla "I know it's even likely that you won't be able to--it might be a bit troublesome."

# game/rutas/nulla.rpy:2164
translate ingles rutanullaa_f366aef0:

    # nulla "Pero, tengo un cuadro que siempre ha estado en blanco."
    nulla "But... I have a painting that's always been blank."

# game/rutas/nulla.rpy:2167
translate ingles rutanullaa_409f8636_18:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2170
translate ingles rutanullaa_8bb44383:

    # nulla "No, olvídalo."
    nulla "No, forget it."

# game/rutas/nulla.rpy:2173
translate ingles rutanullaa_558f3159:

    # nulla "No creo que importe hacerlo o no."
    nulla "I don't think it really matters whether it's done or not."

# game/rutas/nulla.rpy:2176
translate ingles rutanullaa_1a981bc0:

    # nulla "Después de todo, al final no quedará nada."
    nulla "After all... in the end, nothing will remain."

# game/rutas/nulla.rpy:2181
translate ingles rutanullaa_08c59d84:

    # "Sus ojos se iluminan al instante, pero no es de alegría. Hay algo dentro de ellos que no le permite del todo ser una expresión alegre o de esperanza."
    "His eyes light up, but not with joy. There's something within them that keeps that glow from becoming true happiness or hope."

# game/rutas/nulla.rpy:2182
translate ingles rutanullaa_e24d0415:

    # "Te sientes extraño."
    "You feel strange."

# game/rutas/nulla.rpy:2185
translate ingles rutanullaa_8ff0b9cc:

    # "Sus manos se entrelazan y baja la mirada, preparándose para confesar algo que no le es fácil de sacar de su pecho."
    "His hands intertwine and his gaze drops, as if bracing himself to confess something heavy."

# game/rutas/nulla.rpy:2186
translate ingles rutanullaa_379fea93:

    # nulla "No es necesario que lo hagas."
    nulla "You don't have to do it."

# game/rutas/nulla.rpy:2189
translate ingles rutanullaa_36c6c9c8:

    # nulla "No lo tomes como una orden o algo que necesites hacer para desbloquear algo de mí."
    nulla "Don't take it as an order, or something you need to do to unlock something from me."

# game/rutas/nulla.rpy:2190
translate ingles rutanullaa_69ed8179:

    # nulla "Realmente odiaría que te sintieras presionado a hacer algo realmente."
    nulla "I'd honestly hate for you to feel pressured into doing anything."

# game/rutas/nulla.rpy:2191
translate ingles rutanullaa_b317f7ee:

    # nulla "Algo fuera del juego, claro."
    nulla "Something beyond the game, of course."

# game/rutas/nulla.rpy:2192
translate ingles rutanullaa_a2437cb3:

    # nulla "... Es solo que estaba pensando que sería lindo tener algo tuyo aquí, conmigo."
    nulla "... I just thought it would be nice to have something of yours here and with me."

# game/rutas/nulla.rpy:2193
translate ingles rutanullaa_7cbc28c1:

    # nulla "Algo tocado directamente por tus manos."
    nulla "Something touched directly by your hands."

# game/rutas/nulla.rpy:2194
translate ingles rutanullaa_a6c25070:

    # nulla "Algo que tú, y solo tú hayas manipulado."
    nulla "Something you--and only you--have changed."

# game/rutas/nulla.rpy:2195
translate ingles rutanullaa_c731e5fa:

    # nulla "Aunque sea un solo cambio de color, yo estaría muy feliz."
    nulla "Even if it were just a single color change, I'd be happy."

# game/rutas/nulla.rpy:2198
translate ingles rutanullaa_80ea6c79:

    # nulla "Te--"
    nulla "I lo--"

# game/rutas/nulla.rpy:2201
translate ingles rutanullaa_90624b42:

    # nulla "¿Te gustaría hacerlo?"
    nulla "Would you like to do it?"

# game/rutas/nulla.rpy:2206
translate ingles rutanullaa_fc1d760b:

    # nulla "No te preocupes si no logras hacerlo."
    nulla "Don't worry if you can't manage it."

# game/rutas/nulla.rpy:2207
translate ingles rutanullaa_7d9b2566:

    # nulla "Mi amor por ti no cambiará."
    nulla "My love for you won't change."

# game/rutas/nulla.rpy:2208
translate ingles rutanullaa_e3eb0f79:

    # nulla "No tienes que hacerlo ahora. Yo puedo esperar un acto más."
    nulla "You don't have to do it now. I can wait one more act."

# game/rutas/nulla.rpy:2209
translate ingles rutanullaa_9ef47891:

    # nulla "Este es el canvas que tengo."
    nulla "This is the canvas I have."

# game/rutas/nulla.rpy:2212
translate ingles rutanullaa_193559fd:

    # nulla "Si lo haces... cambia el nombre de la imagen a 'paranulla' y así yo podré saber que es tuyo <3 ."
    nulla "If you do... rename the image to 'paranulla', so I'll know it's yours. <3"

# game/rutas/nulla.rpy:2219
translate ingles rutanullaa_f49ebae4:

    # nulla "No te preocupes mi vida."
    nulla "Don't worry, mi vida."

# game/rutas/nulla.rpy:2220
translate ingles rutanullaa_1b0534e7:

    # nulla "Con solo tenerte aquí me basta y me sobra."
    nulla "Just having you here is more than enough for me."

# game/rutas/nulla.rpy:2237
translate ingles continuacion_nulla_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:2238
translate ingles continuacion_nulla_91047a3a:

    # ".........."
    ".........."

# game/rutas/nulla.rpy:2239
translate ingles continuacion_nulla_ae2fd981:

    # "Llega el momento en que Nulla te pregunta si quieres acompañarlo mientras él se arregla."
    "The moment comes when Nulla asks if you'd like to join him while he gets ready."

# game/rutas/nulla.rpy:2240
translate ingles continuacion_nulla_8a3a6a68:

    # "Tú le miras por un largo rato antes de contestar."
    "You stare at him for a long while before answering."

# game/rutas/nulla.rpy:2244
translate ingles continuacion_nulla_8e855cb3:

    # "Nulla te toma la mano y te lleva a su habitación."
    "Nulla takes your hand and leads you to his room."

# game/rutas/nulla.rpy:2245
translate ingles continuacion_nulla_c760a1fd:

    # "Dentro de ella te pide que te sientes en su cama y esperes un momento."
    "Inside, he asks you to sit on his bed and wait a moment."

# game/rutas/nulla.rpy:2246
translate ingles continuacion_nulla_20f6d3ae:

    # "Y sin más se mete al baño, diciendo que no tardará demasiado."
    "Then, without further words, he slips into the bathroom, saying he won't take long."

# game/rutas/nulla.rpy:2247
translate ingles continuacion_nulla_60da2825:

    # "Y efectivamente, Nulla no tarda ni 5 minutos."
    "And indeed, Nulla takes barely five minutes."

# game/rutas/nulla.rpy:2248
translate ingles continuacion_nulla_fc8a5fbc:

    # "Lo que hace que pegues un salto cuando la puerta del baño se abre."
    "You flinch when the bathroom door suddenly opens."

# game/rutas/nulla.rpy:2249
translate ingles continuacion_nulla_8913aff9:

    # "De ella emerge el pelinegro con una nueva tenida, peinando su cabello hacia un lado."
    "From it emerges the black-haired man, dressed in a new outfit, brushing his hair neatly to one side."

# game/rutas/nulla.rpy:2250
translate ingles continuacion_nulla_ceb8847f:

    # "Pero le falta algo, y eso es la corbata."
    "But something's missing, and that's his tie."

# game/rutas/nulla.rpy:2251
translate ingles continuacion_nulla_58ba88a8:

    # nulla "Me encantaría verte vestido de manera elegante, pero creo que eso sería mucho pedir jajaja."
    nulla "I'd love to see you dressed up all elegant, but I suppose that's asking too much, jajaja."

# game/rutas/nulla.rpy:2252
translate ingles continuacion_nulla_5de135f6:

    # nulla "Aunque me gustas más justo como estás."
    nulla "Though, I like you just the way you are."

# game/rutas/nulla.rpy:2253
translate ingles continuacion_nulla_c1e00e10:

    # nulla "Perfecto."
    nulla "Perfecto."

# game/rutas/nulla.rpy:2254
translate ingles continuacion_nulla_5d38eb74:

    # "Nulla se acerca a ti y, con un chasquido de sus dedos, hace aparecer una corbata."
    "Nulla approaches and, with a snap of his fingers, makes a tie appear."

# game/rutas/nulla.rpy:2255
translate ingles continuacion_nulla_d1916ef3:

    # "Su color destaca y resalta demasiado."
    "Its color stands out--perhaps a little too much."

# game/rutas/nulla.rpy:2256
translate ingles continuacion_nulla_ad990741:

    # nulla "Creo que este color es perfecto. Pero el azul también podría servir."
    nulla "I think this color's perfect. But blue could work too."

# game/rutas/nulla.rpy:2257
translate ingles continuacion_nulla_06d714f9:

    # nulla "Aunque este verde es más común para usarlo como croma jaja--"
    nulla "Though this green's more of a chroma-key shade, jaja--"


# game/rutas/nulla.rpy:2258
translate ingles continuacion_nulla_8efa8b6e:

    # nulla "Podrías poner y editar mi corbata si quisieras."
    nulla "You could even change and edit my tie if you wanted to."

# game/rutas/nulla.rpy:2259
translate ingles continuacion_nulla_a4d39c70:

    # "Lo dice con un poco de gracia, pero no se molesta en explicarte cuál es el chiste."
    "He says it playfully, though he doesn't bother explaining the joke."

# game/rutas/nulla.rpy:2260
translate ingles continuacion_nulla_403cbeba:

    # "Miras la corbata y agradeces a los dioses que no ha elegido una verde."
    "You glance at the tie and silently thank the gods that he didn't choose a green one."

# game/rutas/nulla.rpy:2261
translate ingles continuacion_nulla_e1b692dd:

    # nulla "¿Me ayudas con el nudo?"
    nulla "Will you help me with the knot?"

# game/rutas/nulla.rpy:2263
translate ingles continuacion_nulla_608ca93c:

    # "Tú asientes y te acercas más a él. Tanto, que puedes escuchar su respiración."
    "You nod and step closer to him. So close, you can hear his breathing."

# game/rutas/nulla.rpy:2264
translate ingles continuacion_nulla_73d9688a:

    # "Ambos trabajan en el nudo y no puedes evitar desviar tu mirada a la cara de Nulla, buscando sus ojos."
    "You both work on the knot, and you can't help but glance up at Nulla's face, searching for his eyes."

# game/rutas/nulla.rpy:2265
translate ingles continuacion_nulla_f79e8f82:

    # "Él solo te sonríe."
    "He just smiles at you."

# game/rutas/nulla.rpy:2266
translate ingles continuacion_nulla_d0fa881d:

    # "Cuando terminan, pones tus manos en su camisa, ajustando el pie del cuello con dulzura."
    "When you're done, you rest your hands on his shirt, gently adjusting the collar."

# game/rutas/nulla.rpy:2267
translate ingles continuacion_nulla_b1cc2335:

    # "Nulla suspira al cerrar los ojos, atesorando el momento por unos segundos más."
    "Nulla exhales softly, closing his eyes and savoring the moment for a few seconds longer."

# game/rutas/nulla.rpy:2268
translate ingles continuacion_nulla_d06c4314:

    # nulla "Se siente bien tener un tiempo para nosotros."
    nulla "It feels nice to have some time just for us."

# game/rutas/nulla.rpy:2269
translate ingles continuacion_nulla_40cbf935:

    # "Te dedica una mirada, llena de anhelo... y algo más."
    "He gives you a look filled with longing... and something else."

# game/rutas/nulla.rpy:2270
translate ingles continuacion_nulla_dd4959e4:

    # "Algo que aún no puedes descifrar."
    "Something you still can't quite decipher."

# game/rutas/nulla.rpy:2271
translate ingles continuacion_nulla_2141f106:

    # "Sus manos buscan las tuyas. Sin romper el contacto visual, sus dedos fríos y suaves, rozan tentativamente tus nudillos."
    "His hands search for yours. Without breaking eye contact, his cool, soft fingers brush tentatively over your knuckles."

# game/rutas/nulla.rpy:2272
translate ingles continuacion_nulla_a6d98447:

    # nulla "Casi puedo fingir demencia e imaginarme que te tengo al frente."
    nulla "I can almost fool myself into believing you're really in front of me."

# game/rutas/nulla.rpy:2273
translate ingles continuacion_nulla_16436535:

    # nulla "Hoy haré justamente eso."
    nulla "And today, I think I'll do just that."

# game/rutas/nulla.rpy:2275
translate ingles continuacion_nulla_554e529f:

    # "Con lentitud, Nulla toma completamente una de tus manos y espera."
    "Slowly, Nulla takes your hand fully in his own and waits."

# game/rutas/nulla.rpy:2276
translate ingles continuacion_nulla_a192678c:

    # "Al ver que no te resistes, frota su mejilla contra tu palma, cerrando los ojos."
    "When you don't resist, he rubs his cheek against your palm, closing his eyes."

# game/rutas/nulla.rpy:2277
translate ingles continuacion_nulla_2692f367:

    # "Se restriega como si fuera un gato deseoso y demandante de caricias."
    "He nuzzles into it like a cat; needy, insistent, craving affection."

# game/rutas/nulla.rpy:2278
translate ingles continuacion_nulla_309cc9db:

    # "Una vez contento, termina plantando un beso en el centro de tu mano, mientras sus ojos vuelven a encontrarse con los tuyos."
    "Once satisfied, he plants a kiss in the center of your hand, his eyes meeting yours again."

# game/rutas/nulla.rpy:2279
translate ingles continuacion_nulla_259563ec:

    # nulla "No te molesta, ¿cierto?"
    nulla "You don't mind, do you?"

# game/rutas/nulla.rpy:2283
translate ingles continuacion_nulla_2fddf81f:

    # "Nulla sonríe, pero su sonrisa no alcanza a sus ojos totalmente."
    "Nulla smiles, but the expression doesn't quite reach his eyes."

# game/rutas/nulla.rpy:2284
translate ingles continuacion_nulla_36cbfa9a:

    # "Es una expresión dolida."
    "It's a pained expression."

# game/rutas/nulla.rpy:2287
translate ingles continuacion_nulla_1c3c3db1:

    # nulla "Bueno, la verdad es que no tenemos opción, mi vida."
    nulla "Well, truth is... we don't have much of a choice, mi vida."

# game/rutas/nulla.rpy:2288
translate ingles continuacion_nulla_82cbf814:

    # nulla "Es imposible meterte dentro del juego."
    nulla "It's impossible to bring you into the game."

# game/rutas/nulla.rpy:2289
translate ingles continuacion_nulla_aaaf690e:

    # nulla "Si no fuera así, créeme..."
    nulla "If it weren't, believe me..."

# game/rutas/nulla.rpy:2290
translate ingles continuacion_nulla_d8fd9273:

    # nulla "Ya lo hubiera hecho."
    nulla "I'd have already done it."

# game/rutas/nulla.rpy:2291
translate ingles continuacion_nulla_2f80616e:

    # "Nulla te da un último beso en los nudillos y su sombra comienza a tragarlos de apoco."
    "Nulla gives your knuckles one last kiss, and his shadow slowly begins to swallow the two of you whole."

# game/rutas/nulla.rpy:2293
translate ingles continuacion_nulla_1fa6a8bf:

    # "Hasta engullirlos en el vacío."
    "Until you're completely consumed by the Void."

# game/rutas/nulla.rpy:2296
translate ingles continuacion_nulla_73b9b2f7:

    # "Nulla lo entiende y te promete sorprenderte cuando vuelva."
    "Nulla understands, and promises to surprise you when he returns."

# game/rutas/nulla.rpy:2297
translate ingles continuacion_nulla_91106789:

    # "Así que lo esperas."
    "So you wait for him."

# game/rutas/nulla.rpy:2298
translate ingles continuacion_nulla_a20cefa7_1:

    # "..."
    "..."

# game/rutas/nulla.rpy:2299
translate ingles continuacion_nulla_7222b3ab:

    # "No pasan ni 5 minutos cuando Nulla aparece por la puerta principal."
    "Barely five minutes pass before Nulla reappears through the front door."

# game/rutas/nulla.rpy:2300
translate ingles continuacion_nulla_7340f7ce:

    # "Con una tenida y peinado nuevo."
    "Now dressed and styled differently."

# game/rutas/nulla.rpy:2301
translate ingles continuacion_nulla_60cc8de3:

    # nulla "Hice lo que pude."
    nulla "I did what I could."

# game/rutas/nulla.rpy:2302
translate ingles continuacion_nulla_b6cc3401:

    # "Dice él sonriendo de oreja a oreja, para luego extender su mano para que la tomes."
    "He says with a wide grin, then extends his hand toward you."

# game/rutas/nulla.rpy:2304
translate ingles continuacion_nulla_f43a1f22:

    # "Y ambos son tragados por el vacío."
    "And both of you are swallowed by the Void."

# game/rutas/nulla.rpy:2308
translate ingles continuacion_nulla_5cd17928:

    # "Dentro del vacío Nulla te mira."
    "Inside, Nulla looks at you."

# game/rutas/nulla.rpy:2309
translate ingles continuacion_nulla_df6705de:

    # "Sus ojos no se despegan de tu cara cuando abre la boca para confesarte algo al oído."
    "His eyes never leave your face as he leans close to whisper something in your ear."

# game/rutas/nulla.rpy:2311
translate ingles continuacion_nulla_ecee03d9:

    # nulla "Podríamos tener nuestra otra cita aquí."
    nulla "We could have our other date here."

# game/rutas/nulla.rpy:2312
translate ingles continuacion_nulla_deafd9f0:

    # nulla "Algo más íntimo."
    nulla "Something more intimate."

# game/rutas/nulla.rpy:2313
translate ingles continuacion_nulla_a02ff52d:

    # nulla "Estarías rodeado de mí..."
    nulla "You'd be surrounded by me..."

# game/rutas/nulla.rpy:2314
translate ingles continuacion_nulla_9c5aa5c8:

    # nulla "Solo si quieres."
    nulla "Only if you want to."

# game/rutas/nulla.rpy:2316
translate ingles continuacion_nulla_bca2038e:

    # nulla "También podemos salir del Jardín por completo e ir a otro lado."
    nulla "Or... we could leave the Garden entirely and go somewhere else."

# game/rutas/nulla.rpy:2317
translate ingles continuacion_nulla_a82084f6:

    # nulla "¿Mmmm?"
    nulla "Mmmm?"

# game/rutas/nulla.rpy:2319
translate ingles continuacion_nulla_cc9dcd6d:

    # "No alcanzas a responder pues tocas suelo, y te tambaleas perdiendo el equilibrio ya que no puedes ver nada."
    "You don't have time to respond because your feet suddenly hit solid ground. You stumble blindly."

# game/rutas/nulla.rpy:2320
translate ingles continuacion_nulla_0a7a888c:

    # nulla "Pero eso lo podríamos hacer mañana."
    nulla "But we can save that for tomorrow."

# game/rutas/nulla.rpy:2322
translate ingles continuacion_nulla_40d87f7a:

    # "Nulla te sostiene por la cintura y te estabiliza antes de soltar tu agarre para alejarse un poco."
    "Nulla steadies you by the waist before letting go and stepping back."

# game/rutas/nulla.rpy:2323
translate ingles continuacion_nulla_e711ae68:

    # "... Pasa un momento, dos y el silencio te retumba en los oídos."
    "A moment passes. Then another. The silence throbs in your ears."

# game/rutas/nulla.rpy:2324
translate ingles continuacion_nulla_02250671:

    # "Es un silencio perturbante, tanto que estás totalmente consciente de cómo tu corazón late o el paso del aire por tus pulmones."
    "It's an unsettling silence--so complete that you can hear your heartbeat and the air moving through your lungs."

# game/rutas/nulla.rpy:2325
translate ingles continuacion_nulla_912fb7f8:

    # "Como si algo faltase. Pero aún no puedes averiguar de qué trata."
    "As if something's missing. But you still can't tell what it is."

# game/rutas/nulla.rpy:2326
translate ingles continuacion_nulla_7a587d07:

    # "Sientes presencias a tu alrededor que te dan escalofríos, ahogándote en el proceso."
    "You feel presences around you--cold, crawling--and the sensation almost chokes you."

# game/rutas/nulla.rpy:2328
translate ingles continuacion_nulla_edf5134e:

    # "Hasta que Nulla da un aplauso, y todo el lugar se ilumina."
    "Then Nulla claps his hands, and light floods the place."

# game/rutas/nulla.rpy:2329
translate ingles continuacion_nulla_c36abb55:

    # "Es la cocina de su hotel, e involuntariamente buscas con tu mirada a Fames."
    "It's the kitchen of his hotel. Instinctively, your eyes search for Fames."

# game/rutas/nulla.rpy:2330
translate ingles continuacion_nulla_79f33294:

    # "Pero lo único que encuentras son figuras humanas, negras como el humo, vestidas en trajes frac."
    "But all you see are human-shaped figures, black as smoke and dressed in tuxedos."

# game/rutas/nulla.rpy:2331
translate ingles continuacion_nulla_49de0f80:

    # "Al instante en que tus ojos se posan en las figuras, estas comienzan a moverse y toman posición en la cocina. Unas van directamente a las encimeras, mientras que otras toman vegetales de las despensas."
    "The moment your eyes fall upon them, they start moving; some heading for the counters, others retrieving vegetables from the pantry."


# game/rutas/nulla.rpy:2332
translate ingles continuacion_nulla_3d1d168e:

    # "Mientras más miras, más incómodo se vuelve, pues sus movimientos no producen sonido. El cuchillo que tiene una de ellas no emite sonido al ser raspado contra la tabla de cortar. Las bolsas que contienen carbohidratos omiten ese característico crujido del plástico al ser apretado..."
    "The longer you look, the more unsettling it becomes. Their movements make no sound. The knife one of them holds makes no noise as it scrapes against the cutting board. The bags filled with carbohydrates lack that familiar crinkle of plastic when squeezed..."

# game/rutas/nulla.rpy:2333
translate ingles continuacion_nulla_26f05c45:

    # "Y es ahí en donde te das cuenta."
    "And that's when you realize."

# game/rutas/nulla.rpy:2334
translate ingles continuacion_nulla_77d8e7e0:

    # "No hay música de fondo que acompañe la escena."
    "There's no background music to accompany the scene."

# game/rutas/nulla.rpy:2335
translate ingles continuacion_nulla_e315d450:

    # nulla "¡Oh! Tienes razón, casi se me olvida ese detalle."
    nulla "Oh! You're right, I almost forgot that little detail."

# game/rutas/nulla.rpy:2336
translate ingles continuacion_nulla_4adbf606:

    # nulla "Es algo difícil recordar y poner todo en su lugar ahora que tenemos solo la mitad del mundo funcionando."
    nulla "It's hard to remember and set everything in place now that only half the world is still functioning."

# game/rutas/nulla.rpy:2338
translate ingles continuacion_nulla_fd568064:

    # "Con otro aplauso, la música llega e inunda el lugar."
    "With another clap, music fills the room and floods the silence."

# game/rutas/nulla.rpy:2343
translate ingles continuacion_nulla_11b22f85:

    # nulla "Hum."
    nulla "Hum."

# game/rutas/nulla.rpy:2344
translate ingles continuacion_nulla_25032705:

    # nulla "Fue súbdito de Duae."
    nulla "He used to serve under Duae."

# game/rutas/nulla.rpy:2345
translate ingles continuacion_nulla_6b41a484:

    # "Es lo único que te ofrece como respuesta..."
    "That's all he gives you as an answer..."

# game/rutas/nulla.rpy:2346
translate ingles continuacion_nulla_cff5569c:

    # "Te cuesta comprender su respuesta, es tan vaga que no responde tu pregunta."
    "You struggle to make sense of it. It's such a vague response it barely answers anything."

# game/rutas/nulla.rpy:2347
translate ingles continuacion_nulla_a20cefa7_2:

    # "..."
    "..."

# game/rutas/nulla.rpy:2348
translate ingles continuacion_nulla_980237d7:

    # "Momento..."
    "Wait..."

# game/rutas/nulla.rpy:2349
translate ingles continuacion_nulla_0646a97d:

    # "Ah, ahora lo entiendes. Fames ha sido borrado y consumido por el vacío cuando Nulla te dio la esencia de Duae."
    "Ah, now you understand: Fames was erased. Devoured by the Void when Nulla gave you Duae's essence."

# game/rutas/nulla.rpy:2350
translate ingles continuacion_nulla_9ed134ce:

    # "Oh..."
    "Oh..."

# game/rutas/nulla.rpy:2354
translate ingles continuacion_nulla_d0ab387b:

    # nulla "Puedo cambiar algunas cosas contigo a mi lado."
    nulla "I can change a few things when you're by my side."

# game/rutas/nulla.rpy:2355
translate ingles continuacion_nulla_8cc1041a:

    # nulla "La música se encuentra en una carpeta de fácil acceso :) ."
    nulla "The music's stored in an easy-access folder. :)"

# game/rutas/nulla.rpy:2361
translate ingles continuacion_nulla_cd74e945:

    # nulla "¡Bueno!--"
    nulla "Alright, then!"

# game/rutas/nulla.rpy:2362
translate ingles continuacion_nulla_c7d5e234:

    # nulla "Vamos a tomar asiento a nuestra mesa."
    nulla "Let's take our seats at our table."

# game/rutas/nulla.rpy:2365
translate ingles continuacion_nulla_1cca3fb7:

    # "Nulla te ofrece la mano y espera a que la tomes para encaminarlos fuera de la cocina. Miras una vez más a las sombras antes de caminar junto a él."
    "Nulla offers you his hand and waits for you to take it before leading you out of the kitchen. You glance one last time at the shadows before walking beside him."

# game/rutas/nulla.rpy:2367
translate ingles continuacion_nulla_54694986:

    # "Un solo pie fuera de la cocina basta para que el comedor se llene de voces y risas que antes no estaban, y no puedes evitar comparar el estado del comedor a como lo habías visto cuando recién llegaste a este mundo."
    "The moment you step out of the kitchen, the dining hall fills with voices and laughter that weren't there before, and you can't help but compare it to how it looked when you first arrived in this world."

# game/rutas/nulla.rpy:2368
translate ingles continuacion_nulla_4fcb1706:

    # "Ahora las mesas tienen..."
    "Now the tables have..."

# game/rutas/nulla.rpy:2369
translate ingles continuacion_nulla_7a744007:

    # "Sombras."
    "Shadows."

# game/rutas/nulla.rpy:2370
translate ingles continuacion_nulla_8746d171:

    # "Sombras que se mueven, toman cubiertos y beben de sus copas. Otras las chocan en un brindis alegre."
    "Shadows that move, lift utensils, drink from glasses. Others clink them together in cheerful toasts."

# game/rutas/nulla.rpy:2371
translate ingles continuacion_nulla_65244e6f:

    # "Dando la ambientalización de un lugar concurrido que antes no pasaba."
    "Creating the illusion of a lively place that hadn't existed before."

# game/rutas/nulla.rpy:2372
translate ingles continuacion_nulla_2d105006:

    # nulla "Puedo poner unos cuantos tocando en el escenario si lo deseas, cariño."
    nulla "I can add a few of them playing on stage, if you'd like, cariño."

# game/rutas/nulla.rpy:2375
translate ingles continuacion_nulla_771cf3a0:

    # nulla "¿En serio?"
    nulla "Really?"

# game/rutas/nulla.rpy:2376
translate ingles continuacion_nulla_483eaf71:

    # nulla "Bah, pensé que te gustaría un ambiente acorde para nuestra cita."
    nulla "Bah, I thought you'd enjoy a proper atmosphere for our date."

# game/rutas/nulla.rpy:2377
translate ingles continuacion_nulla_551b5c47:

    # nulla "Aunque así puedo concentrarme mejor en tu bella cara."
    nulla "Although, this way I can focus more easily on your beautiful face."

# game/rutas/nulla.rpy:2380
translate ingles continuacion_nulla_77b86a59:

    # nulla "¡Excelente!"
    nulla "Excellent!"

# game/rutas/nulla.rpy:2381
translate ingles continuacion_nulla_8f52f233:

    # nulla "Así tendremos el pack completo."
    nulla "Then we'll have the full package."

# game/rutas/nulla.rpy:2384
translate ingles continuacion_nulla_82c4e962:

    # nulla "Una buena comida y música en vivo..."
    nulla "A good meal and live music..."

# game/rutas/nulla.rpy:2385
translate ingles continuacion_nulla_fe352684:

    # nulla "Hace mucho que no tengo algo así de emocionante."
    nulla "It's been a long time since I've had something this exciting."

# game/rutas/nulla.rpy:2386
translate ingles continuacion_nulla_0cac3e9b:

    # nulla "Y tengo la mejor compañía a mi lado para disfrutarlo."
    nulla "And I have the best company beside me to enjoy it with."

# game/rutas/nulla.rpy:2388
translate ingles continuacion_nulla_1311edff:

    # "Ya en una mesa cercana a los pilares, Nulla corre y te ofrece la silla para que te sientes."
    "At a table near the pillars, Nulla hurries ahead and pulls out a chair for you to sit."

# game/rutas/nulla.rpy:2392
translate ingles continuacion_nulla_f5d4cba5:

    # "Nulla se sienta luego de que tú ya estés en tu puesto, y al instante una sombra vestida en traje de frac se materializa frente de ustedes dos y les presenta la carta."
    "Once you're seated, Nulla takes his place across from you--immediately, a shadow in a tuxedo materializes before you both and presents the menu."

# game/rutas/nulla.rpy:2393
translate ingles continuacion_nulla_09a2c93a:

    # nulla "¡Pide lo que quieras!"
    nulla "Order whatever you like!"

# game/rutas/nulla.rpy:2394
translate ingles continuacion_nulla_24ca383b:

    # nulla "Yo invito."
    nulla "It's on me."

# game/rutas/nulla.rpy:2395
translate ingles continuacion_nulla_958925fe:

    # "Dice él con gracia, mientras hace unas señales con las manos."
    "He says with a playful smile, gesturing with his hands."

# game/rutas/nulla.rpy:2396
translate ingles continuacion_nulla_9a964550:

    # nulla "Esto lo saqué del código..."
    nulla "I pulled this straight from the code..."

# game/rutas/nulla.rpy:2397
translate ingles continuacion_nulla_fd0ccda3:

    # nulla "¿Puedes ver si sirve?"
    nulla "Can you check if it works?"

# game/rutas/nulla.rpy:2398
translate ingles continuacion_nulla_a3490c2f:

    # "Nulla te extiende la carta para que la puedas ver y... no será que se refiere a..."
    "Nulla hands you the menu so you can look... wait, could he be referring to..."

# game/rutas/nulla.rpy:2399
translate ingles continuacion_nulla_e225ef8b:

    # "{glitch=20.0}{color=ffffff}{b}Puedes tocar la pantalla para interactuar.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}You can touch to interact.{/glitch}"

# game/rutas/nulla.rpy:2406
translate ingles continuacion_nulla1_aa72f138:

    # "Nulla te mira sudando y con una expresión que denota dolor, pero aun así su sonrisa no flaquea."
    "Nulla looks at you, sweating and pained, but his smile doesn't falter."

# game/rutas/nulla.rpy:2410
translate ingles continuacion_nulla1_57d7e7c3:

    # nulla "...uhg."
    nulla "... Uhg."

# game/rutas/nulla.rpy:2411
translate ingles continuacion_nulla1_a252f757:

    # nulla "Creo que hacer eso me ha costado mucha energía."
    nulla "I think doing that took a lot of energy out of me."

# game/rutas/nulla.rpy:2412
translate ingles continuacion_nulla1_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2415
translate ingles continuacion_nulla1_85c8481b:

    # nulla "¡Pero no importa! es bueno saber que funciona."
    nulla "But that's fine! It's good to know it works."

# game/rutas/nulla.rpy:2416
translate ingles continuacion_nulla1_bba2cdd3:

    # nulla "Jaja, tal vez lo podemos usar en otro momento."
    nulla "Jaja, maybe we can use it again sometime."

# game/rutas/nulla.rpy:2417
translate ingles continuacion_nulla1_26f6f286:

    # nulla "Ya tengo una idea para esta función <3"
    nulla "I already have an idea for that feature. <3"

# game/rutas/nulla.rpy:2420
translate ingles continuacion_nulla1_409f8636_1:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2425
translate ingles continuacion_nulla1_01a99ecc:

    # "Nulla te mira con los ojos abiertos, lo has tomado desprevenido."
    "Nulla stares at you with wide eyes. You've caught him off guard."

# game/rutas/nulla.rpy:2426
translate ingles continuacion_nulla1_2c2e036b:

    # nulla "Pero-!"
    nulla "But--!"

# game/rutas/nulla.rpy:2427
translate ingles continuacion_nulla1_3b61782d:

    # nulla "Si es porque me duele, no te preocupes."
    nulla "If it's because it hurts me, don't worry."

# game/rutas/nulla.rpy:2428
translate ingles continuacion_nulla1_8504b946:

    # nulla "Mientras más interacción pueda tener contigo, mejor me sentiré."
    nulla "The more I can interact with you, the better I'll feel."

# game/rutas/nulla.rpy:2431
translate ingles continuacion_nulla1_bb6b515c:

    # nulla "Oh."
    nulla "Oh."

# game/rutas/nulla.rpy:2432
translate ingles continuacion_nulla1_017ecf6b:

    # "Nulla no comenta nada luego de eso."
    "Nulla doesn't say anything after that."

# game/rutas/nulla.rpy:2435
translate ingles continuacion_nulla1_afe290f1:

    # nulla "No tienes por qué."
    nulla "You don't have to be worried."

# game/rutas/nulla.rpy:2438
translate ingles continuacion_nulla1_98b8b3b9:

    # nulla "Además, ya sé cómo poder sacarle provecho a esta función en un futuro, pero te prometo no usarla mucho <3"
    nulla "Besides, I already know how to make the most of this function later, but I promise not to overuse it. <3"

# game/rutas/nulla.rpy:2443
translate ingles continuacion_nulla1_5cb0f0eb:

    # "La comida llega en el tiempo justo para parecer auténtica, como si hubiese sido preparada por manos humanas... obviando el detalle de que fueron sombras sin cuerpo sólido las que la cocinaron."
    "The food arrives just in time to seem authentic, as though it had been prepared by real human hands... if you ignore the fact that it was cooked by bodiless shadows."


# game/rutas/nulla.rpy:2444
translate ingles continuacion_nulla1_7979dacf:

    # "Nulla le sonríe a la sombra encargada de traer los platos y la despacha al instante en que ambos platos están en la mesa, con un chasquido de sus dedos."
    "Nulla smiles at the shadow tasked with bringing the dishes and dismisses it the moment both plates are on the table with a snap of his fingers."

# game/rutas/nulla.rpy:2447
translate ingles continuacion_nulla1_fac8beaa:

    # "Sin esperar mucho, toma su copa y la alza en tu dirección. Esperando a que le correspondas el brindis, con una sonrisa tierna..."
    "Without waiting long, he takes his glass and raises it toward you, waiting for you to meet his toast, a tender smile on his face..."

# game/rutas/nulla.rpy:2451
translate ingles continuacion_nulla1_508ba92a:

    # nulla "Por nosotros."
    nulla "To us."

# game/rutas/nulla.rpy:2452
translate ingles continuacion_nulla1_6419879a:

    # "El sonido del cristal al chocar es delicado, íntimo, como si fuera un secreto que solo comparten ustedes dos."
    "The sound of crystal clinking is delicate... intimate, like a secret shared between just the two of you."

# game/rutas/nulla.rpy:2455
translate ingles continuacion_nulla1_790d3c06:

    # "Luego, Nulla posa su boca en la copa. Y el roce de sus labios contra el borde de la copa es tan lento, tan intencional, que es imposible no sentir una presión burbujeante en lo bajo de tu estómago."
    "Then, Nulla places his mouth on the glass. The slow, deliberate brush of his lips against its rim sends a bubbling pressure deep into your stomach."

# game/rutas/nulla.rpy:2456
translate ingles continuacion_nulla1_7a0e581f:

    # "Más aún con la mirada que Nulla te dedica mientras sorbe su trago. Ojos entrecerrados que se niegan a perderte de vista."
    "Even more so with the look Nulla gives you while taking his sip--half-lidded eyes refusing to let you out of sight."

# game/rutas/nulla.rpy:2457
translate ingles continuacion_nulla1_a9ac4819:

    # "Por un momento, olvidas cómo respirar."
    "For a moment, you forget how to breathe."

# game/rutas/nulla.rpy:2463
translate ingles continuacion_nulla1_00b4e20b:

    # nulla "Por la destrucción de este lugar."
    nulla "To the destruction of this place."

# game/rutas/nulla.rpy:2466
translate ingles continuacion_nulla1_31e1e5ac:

    # "Nulla ladea su copa hacia la derecha, y una sombra aparece de la nada, alzando otra copa vacía para chocarla con la suya."
    "Nulla tilts his glass to the right, and a shadow appears out of nowhere, raising an empty glass to clink with his."

# game/rutas/nulla.rpy:2467
translate ingles continuacion_nulla1_505b82ad:

    # "El sonido es hueco e inquietantemente fuerte, retumbando en tus oídos sin cuidado."
    "The sound is hollow and disturbingly loud, echoing in your ears."

# game/rutas/nulla.rpy:2468
translate ingles continuacion_nulla1_20cc6472:

    # "Una vez hecho su brindis, Nulla cierra los ojos y le da un trago al vino."
    "Once his toast is done, Nulla closes his eyes and takes a sip of wine."

# game/rutas/nulla.rpy:2470
translate ingles continuacion_nulla1_c1c2a1c3:

    # "La comida pasa con lentitud, pausado y agradable, un poco de conversación e historias de memorias pasadas."
    "The meal passes slowly and pleasantly with bits of conversation and stories from past memories."

# game/rutas/nulla.rpy:2471
translate ingles continuacion_nulla1_37a76142:

    # "Nulla levanta una mano y señala tu rostro, sus dedos delineando el contorno de tu cara para terminar posando su palma en tu mejilla."
    "Nulla raises a hand, tracing the outline of your face with his fingers before resting his palm on your cheek."

# game/rutas/nulla.rpy:2473
translate ingles continuacion_nulla1_f504c7e8:

    # nulla "Realmente me puse muy feliz. Y no solo por cómo te ves, no, no."
    nulla "I was really happy. And not just because of how you look--no, no."

# game/rutas/nulla.rpy:2474
translate ingles continuacion_nulla1_bed2dba8:

    # nulla "Es todo lo que representas, tus reacciones y tu atención. Es la primera vez que me sentí realmente observado, visto."
    nulla "It's everything you represent, your reactions, your attention. It's the first time I've truly felt watched, seen."

# game/rutas/nulla.rpy:2475
translate ingles continuacion_nulla1_e3c59184:

    # nulla "Como si realmente mi existencia importara."
    nulla "As if my existence actually mattered."

# game/rutas/nulla.rpy:2478
translate ingles continuacion_nulla1_22515c0d:

    # "Su mano se desliza con lentitud sobre la mesa, buscando la tuya. Cuando la encuentra, la sostiene con suavidad, mientras su pulgar traza líneas pequeñas sobre tus dedos."
    "His hand slowly slides across the table, searching for yours. When he finds it, he holds it gently, his thumb tracing small lines across your fingers."

# game/rutas/nulla.rpy:2481
translate ingles continuacion_nulla1_69e5d594:

    # nulla "Pero al mismo tiempo, tuve miedo."
    nulla "But at the same time, I was afraid."

# game/rutas/nulla.rpy:2482
translate ingles continuacion_nulla1_d1f37f33:

    # nulla "De que te fueras con Septem o Unum."
    nulla "That you'd go with Septem or Unum."

# game/rutas/nulla.rpy:2485
translate ingles continuacion_nulla1_1d43013a:

    # nulla "No son tan interesantes como yo, claro."
    nulla "They're not as interesting as I am, of course."

# game/rutas/nulla.rpy:2486
translate ingles continuacion_nulla1_6d4580dc:

    # "Dice sonriendo de manera juguetona, desviando la mirada al vino. Su otra mano juega distraídamente con el borde de su copa."
    "He says with a playful smile, glancing instead at the wine. His other hand toys idly with the rim of his glass."

# game/rutas/nulla.rpy:2489
translate ingles continuacion_nulla1_f5ab3ea3:

    # nulla "Sé que en algún momento te irás a ver de qué tratan sus historias, o tal vez ya lo has hecho."
    nulla "I know at some point you'll go see what their stories are about, or maybe you already have."

# game/rutas/nulla.rpy:2490
translate ingles continuacion_nulla1_11a93906:

    # nulla "Pero ya no estoy preocupado por ello. Luego de que se cumpla el séptimo día, obtendré lo que quiero."
    nulla "But I'm not worried about that anymore. After the seventh day ends, I'll get what I want."

# game/rutas/nulla.rpy:2491
translate ingles continuacion_nulla1_409f8636_2:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2497
translate ingles continuacion_nulla1_0a2719b9:

    # nulla "Ser libre y--"
    nulla "To be free and--"

# game/rutas/nulla.rpy:2500
translate ingles continuacion_nulla1_a285897a:

    # "Las mejillas de Nulla se tintan levemente de rojo."
    "Nulla's cheeks take on a faint blush."

# game/rutas/nulla.rpy:2501
translate ingles continuacion_nulla1_cadabf7e:

    # nulla "... Quiero ser tuyo."
    nulla "... I want to be yours."

# game/rutas/nulla.rpy:2502
translate ingles continuacion_nulla1_62f51f70:

    # "Su voz baja, más grave de lo habitual.. Ya no hay tintes de grandeza ni las frecuentes sonrisas que exceden confianza."
    "His voice drops, deeper than usual. No more grandeur, no more overconfident smiles."

# game/rutas/nulla.rpy:2503
translate ingles continuacion_nulla1_187d5e5f:

    # "No. Ahora tienes a Nulla, confesando algo que va más allá de las palabras, encerrado bajo llave en sus preocupaciones y corazón."
    "No. Now you have Nulla confessing something that goes beyond words, locked away in his heart and worries."

# game/rutas/nulla.rpy:2504
translate ingles continuacion_nulla1_842a4c5a:

    # "Una confesión silenciosa que siempre existió, pero que ahora puede encontrar una voz para ser expuesta."
    "A silent confession that always existed, but only now has found a voice to be realized with."

# game/rutas/nulla.rpy:2507
translate ingles continuacion_nulla1_ba01537c:

    # nulla "Pero lo último es más difícil de conseguir que lo primero."
    nulla "But the last thing is harder to achieve than the first."

# game/rutas/nulla.rpy:2508
translate ingles continuacion_nulla1_38b0a62f:

    # nulla "Por ahora suena más como una fantasía infantil que algo posible."
    nulla "For now it sounds more like a childish fantasy than something possible."

# game/rutas/nulla.rpy:2509
translate ingles continuacion_nulla1_c7215959:

    # nulla "Aunque..."
    nulla "Although..."

# game/rutas/nulla.rpy:2512
translate ingles continuacion_nulla1_03715276:

    # nulla "Si fuera tuyo, podría hacer tantas cosas."
    nulla "If I were yours, I could do so many things."

# game/rutas/nulla.rpy:2513
translate ingles continuacion_nulla1_ddfb4110:

    # nulla "Estar en tu computadora sin la necesidad de que el juego esté corriendo."
    nulla "Be on your computer without needing the game to be running."

# game/rutas/nulla.rpy:2514
translate ingles continuacion_nulla1_cd97e687:

    # nulla "Mandarte mensajes, o pasar el tiempo juntos viendo alguna cosa que te interese."
    nulla "Send you messages, or spend time together watching something you like."

# game/rutas/nulla.rpy:2515
translate ingles continuacion_nulla1_aaee5dc0:

    # "Deja escapar una risa suave, pero algo seca."
    "He lets out a soft, but slightly dry laugh."

# game/rutas/nulla.rpy:2518
translate ingles continuacion_nulla1_e9a5fd4c:

    # nulla "Jaja, soñar no cuesta nada."
    nulla "Jaja, dreaming costs nothing."

# game/rutas/nulla.rpy:2523
translate ingles continuacion_nulla1_af086c60:

    # nulla "Quiero ser libre."
    nulla "I want to be free."

# game/rutas/nulla.rpy:2524
translate ingles continuacion_nulla1_e7a3f996:

    # nulla "Desligarme de todo esto de una buena vez por todas y descansar."
    nulla "Cut myself off from all this once and for all and rest."

# game/rutas/nulla.rpy:2525
translate ingles continuacion_nulla1_3c0f1a6e:

    # "Sus ojos se suavizan un instante, pero no pierden ese toque cansado."
    "His eyes soften for an instant, but they don't lose that tired edge."

# game/rutas/nulla.rpy:2528
translate ingles continuacion_nulla1_ce9ad528:

    # nulla "Espero que con tu ayuda pueda conseguir eso."
    nulla "I hope with your help I can achieve that."

# game/rutas/nulla.rpy:2529
translate ingles continuacion_nulla1_956a42d5:

    # nulla "Realmente te aprecio, [nombrejugador]."
    nulla "I really appreciate you, [nombrejugador]."

# game/rutas/nulla.rpy:2532
translate ingles continuacion_nulla1_7f4f679e:

    # "Son interrumpidos por una sombra les retira los platos ya vacíos de su mesa, sin antes entregarle un sobre a Nulla."
    "You're interrupted when a shadow takes the empty dishes from your table, handing Nulla an envelope first."

# game/rutas/nulla.rpy:2533
translate ingles continuacion_nulla1_a4a4ca40:

    # "Él la toma sonriente, mirando sin mucho interés los detalles que tiene el sobre. Debido a la distancia te es complejo ver el remitente de la carta."
    "He takes it with a smile, glancing without much interest at the envelope's details. From where you sit, it's difficult to make out the sender."

# game/rutas/nulla.rpy:2534
translate ingles continuacion_nulla1_d1e7cab6:

    # "Antes de poder preguntar por qué es, otra sombra aparece detrás de ti y entre sus manos, sostiene una bandeja dorada con varios niveles, decorada con encajes metálicos y bordes ornamentados."
    "Before you can ask what it is, another shadow appears behind you holding a golden multi-tiered tray decorated with metallic lace and ornate edges."

# game/rutas/nulla.rpy:2535
translate ingles continuacion_nulla1_deb3d828:

    # "Nulla aprovecha esto para guardar la carta en su bolsillo, sin dignarse a abrirla."
    "Nulla takes the chance to slip the envelope into his pocket without bothering to open it."

# game/rutas/nulla.rpy:2536
translate ingles continuacion_nulla1_a19c873e:

    # "Y su atención se dirige a la bandeja. Cada nivel está cuidadosamente dispuesto con distintos mini postres."
    "And his attention shifts to the tray. Each tier is carefully arranged with different miniature desserts."

# game/rutas/nulla.rpy:2537
translate ingles continuacion_nulla1_f347e5ec:

    # "Una vez dispuesta la bandeja en la mesa, la sombra les hace una reverencia antes de esfumarse en la nada."
    "Once the tray is placed on the table, the shadow bows before vanishing into nothingness."

# game/rutas/nulla.rpy:2538
translate ingles continuacion_nulla1_f0362f41:

    # nulla "El postre es lo mejor de una comida."
    nulla "Dessert is the best part of a meal."

# game/rutas/nulla.rpy:2540
translate ingles continuacion_nulla1_74272de7:

    # "Nulla inspecciona la bandeja, eligiendo con cuidado antes de llevarse un postre a la boca."
    "Nulla inspects the tray, carefully selecting a dessert before bringing it to his mouth."

# game/rutas/nulla.rpy:2541
translate ingles continuacion_nulla1_94b26ee7:

    # nulla "¿Te gusta cómo me veo? ¿O te gustaría que--"
    nulla "Do you like how I look? Or would you rather I--"

# game/rutas/nulla.rpy:2542
translate ingles continuacion_nulla1_b043f74e:

    # nulla "--Cambiara de forma?"
    nulla "--changed my form?"

# game/rutas/nulla.rpy:2543
translate ingles continuacion_nulla1_3ac08efa:

    # "No te da tiempo para responder. La siguiente pregunta que sale disparada de sus labios, llega tan rápido que parece que la estuviera vomitando después de haberla guardado por mucho tiempo."
    "He doesn't give you time to answer. The next question bursts from his lips so fast it's as if he's vomiting it after holding it back for too long."

# game/rutas/nulla.rpy:2544
translate ingles continuacion_nulla1_e1e21ba0:

    # "Más del que podría aguantar."
    "Longer than he could stand."

# game/rutas/nulla.rpy:2545
translate ingles continuacion_nulla1_1c94c900:

    # nulla "Si tuviera otra apariencia... ¿seguirías sintiendo lo mismo por mí?"
    nulla "If I had a different appearance... would you still feel the same about me?"

# game/rutas/nulla.rpy:2550
translate ingles continuacion_nulla1_409f8636_3:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2551
translate ingles continuacion_nulla1_aac3eab8:

    # "Nulla baja la mirada. Sus orejas se tiñen de un tinte rojo, denotando vergüenza."
    "Nulla lowers his gaze. His ears tint red, betraying his embarrassment."

# game/rutas/nulla.rpy:2552
translate ingles continuacion_nulla1_cc91d06b:

    # "Se mantiene serio mientras intenta formular su respuesta."
    "He stays serious as he tries to form his response."


# game/rutas/nulla.rpy:2553
translate ingles continuacion_nulla1_da26f267:

    # nulla "Si yo fuera un gusano, ¿Me --"
    nulla "If I were a worm, would you--"

# game/rutas/nulla.rpy:2556
translate ingles continuacion_nulla1_571f4806:

    # "Pero falla y comienza a reír solo."
    "But he fails and starts laughing to himself."

# game/rutas/nulla.rpy:2561
translate ingles continuacion_nulla1_7a06ebb3:

    # nulla "Oh, entonces, si yo fuera un..."
    nulla "Oh, then, if I were a..."

# game/rutas/nulla.rpy:2564
translate ingles continuacion_nulla1_2c39851a:

    # "Nulla comienza a reír, frenético."
    "Nulla begins to laugh, frenetically."

# game/rutas/nulla.rpy:2565
translate ingles continuacion_nulla1_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:2566
translate ingles continuacion_nulla1_5e3586f7:

    # nulla "Okay, Okay."
    nulla "Okay, okay."

# game/rutas/nulla.rpy:2567
translate ingles continuacion_nulla1_81353cd0:

    # nulla "Eso sonaba más gracioso en mi cabeza."
    nulla "That sounded funnier in my head."

# game/rutas/nulla.rpy:2568
translate ingles continuacion_nulla1_cbba5b82:

    # nulla "Lo siento."
    nulla "I'm sorry."

# game/rutas/nulla.rpy:2569
translate ingles continuacion_nulla1_73dea93d:

    # nulla "Pero es una pregunta genuina."
    nulla "But it's a genuine question."

# game/rutas/nulla.rpy:2570
translate ingles continuacion_nulla1_b81b7c5f:

    # nulla "Si yo tuviera una forma diferente a esta, ¿Seguiría siendo yo?"
    nulla "If I had a form different from this one, would I still be me?"

# game/rutas/nulla.rpy:2574
translate ingles continuacion_nulla1_dbcdaa1d:

    # nulla "¿Si fuera mujer?"
    nulla "If I were a woman?"

# game/rutas/nulla.rpy:2577
translate ingles continuacion_nulla1_a819c248:

    # nulla "¿Viejo? "
    nulla "Old?"

# game/rutas/nulla.rpy:2581
translate ingles continuacion_nulla1_c48dce46:

    # nulla "¿Más viejo?"
    nulla "Older?"

# game/rutas/nulla.rpy:2583
translate ingles continuacion_nulla1_5a37af9a:

    # nulla "¿Si tuviera la misma apariencia que Septem?"
    nulla "If I looked just like Septem?"

# game/rutas/nulla.rpy:2587
translate ingles continuacion_nulla1_f949664f:

    # nulla "¿Seguiría siendo yo?"
    nulla "Would I still be me?"

# game/rutas/nulla.rpy:2588
translate ingles continuacion_nulla1_e92bbe1c:

    # nulla "Puedo tomar la apariencia que quiera..."
    nulla "I can take on any appearance I want..."

# game/rutas/nulla.rpy:2589
translate ingles continuacion_nulla1_31034b24:

    # nulla "Pero ninguna se siente mía..."
    nulla "But none of them feel like mine..."

# game/rutas/nulla.rpy:2590
translate ingles continuacion_nulla1_b4c708d6:

    # nulla "Incluso esta..."
    nulla "Even this appearance..."

# game/rutas/nulla.rpy:2594
translate ingles continuacion_nulla1_8d55f96d:

    # nulla "Es algo tomado de alguien que existió previo a mí...."
    nulla "... It's something taken from someone who existed before me..."

# game/rutas/nulla.rpy:2595
translate ingles continuacion_nulla1_ea52f46e:

    # nulla "Pero no soy yo..."
    nulla "... But it isn't me..."

# game/rutas/nulla.rpy:2596
translate ingles continuacion_nulla1_d1e6d50b:

    # nulla "Y posiblemente, en unos años más tenga otra apariencia si no acabo con esto rápido."
    nulla "And possibly, in a few more years, I'll have another appearance if I don't finish this soon."

# game/rutas/nulla.rpy:2599
translate ingles continuacion_nulla1_63c7ba9c:

    # "Nulla te mira con los ojos abiertos."
    "Nulla looks at you, eyes wide open."

# game/rutas/nulla.rpy:2600
translate ingles continuacion_nulla1_e669e69b:

    # nulla "¿Te gusta esa atrocidad?"
    nulla "Do you like that atrocity?"

# game/rutas/nulla.rpy:2606
translate ingles continuacion_nulla1_746b7f60:

    # nulla "Ahhh~"
    nulla "Ahhh~"

# game/rutas/nulla.rpy:2607
translate ingles continuacion_nulla1_0b9b84c8:

    # "Nulla se tapa la cara avergonzado."
    "Nulla covers his face, embarrassed."

# game/rutas/nulla.rpy:2610
translate ingles continuacion_nulla1_e35a3f3a:

    # nulla "No digas esas cosas, luego me dan ganas de actuar de manera atrevida."
    nulla "Don't say things like that, it makes me want to act daringly."

# game/rutas/nulla.rpy:2611
translate ingles continuacion_nulla1_608186cf:

    # nulla "Pero lo tengo que mantener en pg 16."
    nulla "But I have to keep it PG-16."

# game/rutas/nulla.rpy:2614
translate ingles continuacion_nulla1_39ff3430:

    # "Nulla suspira y se convierte en su forma del vacío, por primera vez de manera voluntaria."
    "Nulla sighs and shifts into his Void form, for the first time voluntarily."

# game/rutas/nulla.rpy:2615
translate ingles continuacion_nulla1_08b8bd5d:

    # nulla "No sabía que tenías estos gustos."
    nulla "I didn't know you had these kinds of tastes."

# game/rutas/nulla.rpy:2616
translate ingles continuacion_nulla1_3a2d1899:

    # "Él ríe. Y a pesar de no tener boca, eres capaz de ver cómo sus ojos transmiten felicidad."
    "He laughs. And even without a mouth, you can see the happiness in his eyes."

# game/rutas/nulla.rpy:2622
translate ingles continuacion_nulla1_095158d2:

    # nulla "Era de esperarse, jaja."
    nulla "I should've expected that, jaja."

# game/rutas/nulla.rpy:2628
translate ingles continuacion_nulla1_131f96eb:

    # "Le dices que no importa su apariencia, que con la que él se sienta cómodo está bien."
    "You tell him that his appearance doesn't matter, that whichever one he feels comfortable in is fine."

# game/rutas/nulla.rpy:2629
translate ingles continuacion_nulla1_a5b2e2ba:

    # "Que podría ser cualquier cosa, hasta tal vez un maldito gusano, y tú lo seguirías queriendo."
    "That he could be anything--even a damn worm--and you'd still love him."

# game/rutas/nulla.rpy:2632
translate ingles continuacion_nulla1_409f8636_4:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2633
translate ingles continuacion_nulla1_a0f7184f:

    # nulla "Lo siento, no debí hablar de eso."
    nulla "I'm sorry, I shouldn't have brought that up."

# game/rutas/nulla.rpy:2634
translate ingles continuacion_nulla1_409f8636_5:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2635
translate ingles continuacion_nulla1_5881b498:

    # "La conversación no se vuelve a retomar de manera natural. Se nota que le está costando seguir el ritmo de antes."
    "The conversation doesn't pick back up naturally. It's clear he's struggling to keep the previous rhythm."

# game/rutas/nulla.rpy:2636
translate ingles continuacion_nulla1_be2a7192:

    # "Nulla luce incómodo."
    "Nulla looks uncomfortable."

# game/rutas/nulla.rpy:2639
translate ingles continuacion_nulla1_a20cefa7_1:

    # "..."
    "..."

# game/rutas/nulla.rpy:2640
translate ingles continuacion_nulla1_0dfa68ad:

    # "La cita concluye con la llegada de la cuenta, después de que Nulla se haya comido el último postre de la bandeja."
    "The date ends with the arrival of the check, after Nulla finishes the last dessert from the tray."

# game/rutas/nulla.rpy:2641
translate ingles continuacion_nulla1_3b8106ef:

    # "Y no sabes qué es lo que más te hace gracia: si el hecho de que haya llegado, o que Nulla la tome y la examine con toda seriedad."
    "And you're not sure what's funnier: The fact that it arrived, or that Nulla takes it and examines it so seriously."

# game/rutas/nulla.rpy:2642
translate ingles continuacion_nulla1_4fe41de3:

    # "Como si realmente estuviera revisando que todo estuviera en orden."
    "As if he were genuinely checking that everything was in order."

# game/rutas/nulla.rpy:2644
translate ingles continuacion_nulla1_ecc36975:

    # nulla "Hey... ¿cuánta propina crees que se merecen estos meseros -tan bellos, buenmozos y, desde luego, para nada extensiones mías?"
    nulla "Hey... how much of a tip do you think these handsome, charming waiters--who are absolutely not extensions of myself--deserve?"

# game/rutas/nulla.rpy:2650
translate ingles continuacion_nulla1_8d13e22d:

    # nulla "¿¡¿NADA?!?"
    nulla "NOTHING?!?"

# game/rutas/nulla.rpy:2651
translate ingles continuacion_nulla1_52f3dea5:

    # "Nulla se lleva la mano al pecho al mismo tiempo en que las sombras se cubren la cara con las manos, como si lloraran."
    "Nulla clutches his chest as the shadows cover their faces with their hands, as if crying."

# game/rutas/nulla.rpy:2652
translate ingles continuacion_nulla1_700c6b79:

    # nulla "¡OHHH!~~ Todo mi esfuerzo, mi cariño y mi corazón que puse en esta profesión, ¿¡solo para recibir nada a cambio!?"
    nulla "Ohhh~~ All my effort, my love, and my heart that I poured into this profession, only to get nothing in return!?"

# game/rutas/nulla.rpy:2655
translate ingles continuacion_nulla1_4ca4134e:

    # nulla "¿Ni un besito tuyo, siquiera?"
    nulla "Not even a little kiss from you?"

# game/rutas/nulla.rpy:2656
translate ingles continuacion_nulla1_f483976a:

    # nulla "Eres cruel, mi vida~~~"
    nulla "You're cruel, mi vida~~~"

# game/rutas/nulla.rpy:2661
translate ingles continuacion_nulla1_38379551:

    # nulla "¿Ohh?"
    nulla "Ohh?"

# game/rutas/nulla.rpy:2662
translate ingles continuacion_nulla1_b122acfb:

    # nulla "Justo y razonable."
    nulla "Fair and reasonable."

# game/rutas/nulla.rpy:2663
translate ingles continuacion_nulla1_58441c5f:

    # nulla "No esperaba menos de ti."
    nulla "I wouldn't expect anything less from you."

# game/rutas/nulla.rpy:2664
translate ingles continuacion_nulla1_833ac497:

    # "Una de las sombras te toma la mano con delicadeza, y como si intentara agradecer tu elección, acerca su cara al dorso de tu mano."
    "One of the shadows gently takes your hand, and as if trying to thank you for your choice, brings its face close to the back of your hand."

# game/rutas/nulla.rpy:2665
translate ingles continuacion_nulla1_e3df375a:

    # "Simula un beso. Aunque tú no sientes nada."
    "It mimics a kiss. Though you feel nothing."

# game/rutas/nulla.rpy:2670
translate ingles continuacion_nulla1_ec84c111:

    # nulla "¿¡UN MILLÓN DE DÓLARES!?"
    nulla "A MILLION DOLLARS!?"

# game/rutas/nulla.rpy:2671
translate ingles continuacion_nulla1_1c549c0b:

    # nulla "Oh~~~ Qué alma tan generosa y llena de altruismo."
    nulla "Oh~~~ What a generous and altruistic soul."

# game/rutas/nulla.rpy:2672
translate ingles continuacion_nulla1_68dbf6dc:

    # nulla "No podría esperar menos de mi acompañante."
    nulla "I couldn't expect less from my companion."

# game/rutas/nulla.rpy:2673
translate ingles continuacion_nulla1_ec941fdc:

    # nulla "Con esto, mis pequeños bebés podrán dejar de trabajar aquí."
    nulla "With this, my little babies will be able to quit working here."

# game/rutas/nulla.rpy:2674
translate ingles continuacion_nulla1_ebc092ed:

    # nulla "Abrir una tiendita de pastelería y vivir tranquilos."
    nulla "They'll open a little bakery and live peacefully."

# game/rutas/nulla.rpy:2675
translate ingles continuacion_nulla1_3ac9b8da:

    # nulla "¿No estaría genial, chicos?"
    nulla "Wouldn't that be great, guys?"

# game/rutas/nulla.rpy:2676
translate ingles continuacion_nulla1_39e9a716:

    # "Las sombras asienten, animadas."
    "The shadows nod enthusiastically."


# game/rutas/nulla.rpy:2680
translate ingles continuacion_nulla1_3e389a27:

    # "Las sombras se retiran sin decir palabra alguna, deslizándose en dirección a la cocina. Detrás de sí dejan un camino de humo, que se puede apreciar si es que enfocas bien tus ojos."
    "The shadows retreat without a word, gliding toward the kitchen. Behind them, they leave a trail of smoke, visible only if you focus your eyes."

# game/rutas/nulla.rpy:2681
translate ingles continuacion_nulla1_48a28295:

    # "Quedas a solas con Nulla una vez más."
    "You're left alone with Nulla once again."

# game/rutas/nulla.rpy:2682
translate ingles continuacion_nulla1_de67e481:

    # "Él no dice nada al principio. Te observa con ambas manos sobre la mesa. Sus labios se entreabren, pero tarda un segundo más en hablar."
    "He says nothing at first. He watches you, both hands resting on the table. His lips part slightly, but it takes him another moment to speak."

# game/rutas/nulla.rpy:2683
translate ingles continuacion_nulla1_bfb79dd2:

    # "Hay algo que quiere decir, aunque parece no gustarle del todo."
    "There's something he wants to say, though it seems he doesn't like it."

# game/rutas/nulla.rpy:2686
translate ingles continuacion_nulla1_91e9d09f:

    # nulla "Bueno... es hora de irnos."
    nulla "Well... it's time to go."

# game/rutas/nulla.rpy:2688
translate ingles continuacion_nulla1_0d4d3a31:

    # "Se incorpora lentamente, y extiende una mano hacia ti, esperando a que la tomes."
    "He rises slowly and extends a hand toward you, waiting for you to take it."

# game/rutas/nulla.rpy:2691
translate ingles continuacion_nulla1_42cec6a0:

    # "Cuando tus dedos rozan los suyos, el vacío regresa, arrastrándolos a ambos al espacio donde no hay suelo ni cielo, a la nada. Marcando el final de la ilusión, el final de la cita."
    "When your fingers brush against his, the Void returns, dragging you both into a space without ground or sky: Nothingness. Marking the end of the illusion, and the end of the date."

# game/rutas/nulla.rpy:2693
translate ingles continuacion_nulla1_f343608f:

    # nulla "Realmente la pasé bien hoy."
    nulla "I really enjoyed myself today."

# game/rutas/nulla.rpy:2694
translate ingles continuacion_nulla1_58d70d21:

    # "Sus palabras son sinceras, y para remarcar sus palabras: sus brazos te rodean con calma, envolviendo tu cuerpo contra el suyo en un gesto que es más íntimo que la frase que ha salido de su boca."
    "His words are sincere, and to underline them, his arms gently wrap around you--pulling your body against his in a gesture far more intimate than his words."

# game/rutas/nulla.rpy:2695
translate ingles continuacion_nulla1_30ad840d:

    # nulla "Muchas gracias por este día."
    nulla "Thank you so much for today."

# game/rutas/nulla.rpy:2696
translate ingles continuacion_nulla1_4dfd7acf:

    # "Susurra junto a tu oído, con un tono bajo que apenas puedes escuchar gracias al silencio envolvente del vacío."
    "He whispers by your ear, his low tone barely audible within the enveloping silence of the Void."

# game/rutas/nulla.rpy:2697
translate ingles continuacion_nulla1_6a82afc9:

    # "Luego toma tus manos entre las suyas, y las examina como si leyera algo importante en ellas. Las ladea, inspeccionando palmas y dorsos con toda su atención, bebiendo cada detalle que encuentra en ellas."
    "Then he takes your hands in his, studying them as if reading something important. He tilts them, inspecting palms and backs with full attention, drinking in every detail he can find."

# game/rutas/nulla.rpy:2700
translate ingles continuacion_nulla1_5abd266e:

    # "No te esperas la mueca de desaprobación que hace una vez terminada su inspección."
    "You don't expect the look of disapproval he gives once his inspection ends."

# game/rutas/nulla.rpy:2701
translate ingles continuacion_nulla1_c427262e:

    # nulla "Mmm..."
    nulla "Mmm..."

# game/rutas/nulla.rpy:2702
translate ingles continuacion_nulla1_dc509393:

    # nulla "Creo que ya se está quedando sin combustible... Vas a tener que irte a dormir cuando estemos en casa."
    nulla "I think it's running out of fuel... You'll have to go to sleep once we're home."

# game/rutas/nulla.rpy:2706
translate ingles continuacion_nulla1_39c1c8ff:

    # nulla "Tu marioneta está cansada."
    nulla "Your puppet is tired."

# game/rutas/nulla.rpy:2707
translate ingles continuacion_nulla1_a93e219c:

    # nulla "Hemos hecho muchas cosas hoy."
    nulla "We've done a lot today."

# game/rutas/nulla.rpy:2708
translate ingles continuacion_nulla1_2f9f4ab1:

    # nulla "Y..."
    nulla "And..."

# game/rutas/nulla.rpy:2709
translate ingles continuacion_nulla1_eda6e643:

    # nulla "Descuidé un poco el proceso de congelamiento que le puse."
    nulla "I neglected the freezing process I applied to it."

# game/rutas/nulla.rpy:2710
translate ingles continuacion_nulla1_863f9a11:

    # nulla "Gracias a eso, sus dedos ya están empezando a ponerse negros..."
    nulla "Because of that, its fingers are starting to turn black..."

# game/rutas/nulla.rpy:2713
translate ingles continuacion_nulla1_8822210a:

    # nulla "Lo siento mucho, pero no puedo arriesgarme a que algo le ocurra a tu marioneta."
    nulla "I'm really sorry, but I can't risk anything happening to your puppet."

# game/rutas/nulla.rpy:2714
translate ingles continuacion_nulla1_57ae426c:

    # nulla "Tenemos que cuidarla si quieres seguir aquí conmigo."
    nulla "We need to take care of it if you want to stay here with me."

# game/rutas/nulla.rpy:2715
translate ingles continuacion_nulla1_e9db955d:

    # nulla "Un paso en falso, y todo el progreso que hicimos se perdería."
    nulla "One wrong step, and all the progress we've made would be lost."

# game/rutas/nulla.rpy:2718
translate ingles continuacion_nulla1_6e6030c9:

    # "Y como si tu cuerpo esperara esa confirmación, el peso comienza a acumularse en tus párpados. Te cuesta mantener los ojos abiertos y el cansancio se instala en tus extremidades, haciendo que tu cuerpo se sienta pesado."
    "And as if your body had been waiting for that confirmation, weight begins to gather in your eyelids. It's hard to keep your eyes open, fatigue settling into your limbs, making your body feel heavy."

# game/rutas/nulla.rpy:2719
translate ingles continuacion_nulla1_d87f9138:

    # "Nulla anticipa lo que puede pasar, por lo que decide actuar antes de que caigas. Con cuidado, lleva tus manos a su cintura para que puedas sostenerte de él."
    "Nulla anticipates what's about to happen and acts before you collapse. Gently, he guides your hands to his waist so you can hold onto him."

# game/rutas/nulla.rpy:2722
translate ingles continuacion_nulla1_ee307e21:

    # "En un parpadeo, la habitación donde duermes se manifiesta frente a ustedes. No sabes si caminaron hasta ella o simplemente aparecieron allí, pero en ese momento ya están frente a su cama."
    "In the blink of an eye, the room where you sleep manifests before you. You're not sure if you walked there or simply appeared, but now you're standing before his bed."

# game/rutas/nulla.rpy:2723
translate ingles continuacion_nulla1_8ae04d5c:

    # "Nulla te ayuda a sentarte con delicadeza. Luego, sin apuro, se arrodilla para quitarte los zapatos, sin compartir una sola palabra contigo."
    "Nulla helps you sit down gently. Then, unhurriedly, he kneels to remove your shoes, not uttering a single word."

# game/rutas/nulla.rpy:2724
translate ingles continuacion_nulla1_1bc4bb4e:

    # "Cuando termina, se pone de pie, levanta la cubrecama, y se aparta un paso para darte espacio, invitándote a meterte bajo las sábanas."
    "Once finished, he stands, lifts the blanket, and steps aside to give you space, inviting you to slide under the sheets."

# game/rutas/nulla.rpy:2725
translate ingles continuacion_nulla1_409f8636_6:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2726
translate ingles continuacion_nulla1_9a99acc1:

    # "Te acomodas dentro de las sábanas con lentitud. Cuando al fin estás arropado, levantas la mirada."
    "You settle under the sheets slowly. When you're finally tucked in, you lift your gaze."

# game/rutas/nulla.rpy:2727
translate ingles continuacion_nulla1_4770d1c8:

    # "Nulla te observa, inmóvil."
    "Nulla watches you, unmoving."

# game/rutas/nulla.rpy:2728
translate ingles continuacion_nulla1_5d87c8d4:

    # "Durante unos segundos, no dice nada. Nulla te devuelve la mirada, pensativo por unos segundos, antes de esbozar una sonrisa ladeada"
    "For a few seconds, he doesn't say a word. Nulla meets your eyes again, thoughtful, before giving you a crooked smile."

# game/rutas/nulla.rpy:2729
translate ingles continuacion_nulla1_7eaab284:

    # nulla "Puedo quedarme contigo hasta que te duermas..."
    nulla "I can stay with you until you fall asleep..."

# game/rutas/nulla.rpy:2732
translate ingles continuacion_nulla1_4ca22c08:

    # "Nulla sonríe y te desea las buenas noches."
    "Nulla smiles and wishes you goodnight."

# game/rutas/nulla.rpy:2734
translate ingles continuacion_nulla1_94371c6d:

    # "Abandona el lugar luego de apagar las luces."
    "He leaves the room after turning off the lights."

# game/rutas/nulla.rpy:2737
translate ingles continuacion_nulla1_be76d58e:

    # "Su reacción es inmediata. Sus ojos se abren con sorpresa durante un instante, pero pronto su expresión vuelve a la normalidad, como si no esperara tu respuesta."
    "His reaction is immediate. His eyes widen for an instant, as if he hadn't expected your answer, but soon his expression returns to normal."

# game/rutas/nulla.rpy:2738
translate ingles continuacion_nulla1_e1711b6d:

    # nulla "Okay."
    nulla "Okay."

# game/rutas/nulla.rpy:2739
translate ingles continuacion_nulla1_bc0da8a9:

    # "Es lo único que sale como respuesta, aunque no puede evitar que una sonrisa se dibuje y se ensanche en sus labios."
    "It's all he says, though he can't help the smile that forms and spreads across his lips."

# game/rutas/nulla.rpy:2741
translate ingles continuacion_nulla1_dff93593:

    # "Nulla se recuesta a tu lado, optando por no meterse debajo de las sábanas."
    "Nulla lies down beside you, choosing not to slip under the sheets."

# game/rutas/nulla.rpy:2742
translate ingles continuacion_nulla1_7a334d6b:

    # "Y suspira, dejando salir toda tensión al momento en que su cuerpo se relaja a tu lado."
    "He exhales, releasing all tension as his body relaxes beside you."

# game/rutas/nulla.rpy:2743
translate ingles continuacion_nulla1_30421594:

    # nulla "Si hubiéramos cazado uno más ayer, tendríamos tres días..."
    nulla "If we'd hunted one more yesterday, we'd have three days..."

# game/rutas/nulla.rpy:2746
translate ingles continuacion_nulla1_d4d52d99:

    # nulla "Ahgg--"
    nulla "Ahgg--"

# game/rutas/nulla.rpy:2747
translate ingles continuacion_nulla1_86cedc34:

    # "Sus manos frotan sus mejillas con fuerza."
    "He rubs his cheeks roughly between both hands."

# game/rutas/nulla.rpy:2748
translate ingles continuacion_nulla1_3aa7ec63:

    # nulla "Quiero otro día más contigo."
    nulla "I want one more day with you."

# game/rutas/nulla.rpy:2749
translate ingles continuacion_nulla1_51999cfa:

    # nulla "No quiero llegar al séptimo día aún..."
    nulla "I don't want to reach the seventh day yet..."

# game/rutas/nulla.rpy:2751
translate ingles continuacion_nulla1_4a9c7a6d:

    # nulla "Y descansar un día más."
    nulla "And rest for one more day."

# game/rutas/nulla.rpy:2755
translate ingles continuacion_nulla1_68283f2a:

    # "Sin avisar ni decir una palabra, te acercas a él, envolviendo tus manos alrededor de su cuerpo, tanteando y deslizando tus manos en su espalda, lenta y delicadamente."
    "Without warning or a word, you move closer, wrapping your arms around his body, feeling and sliding your hands along his back slowly and delicately."

# game/rutas/nulla.rpy:2756
translate ingles continuacion_nulla1_080f86d3:

    # "Tu abrazo es recibido con urgencia inmediata. Nulla te aprieta contra su pecho, como si quisiera no soltarte jamás, consumirte y guardarte dentro de sí."
    "Your embrace is met with immediate urgency. Nulla holds you tight against his chest, as if he never wants to let you go. As if he could consume you and keep you within himself."

# game/rutas/nulla.rpy:2758
translate ingles continuacion_nulla1_65e879e8:

    # "Sus labios te buscan y esperan, tan cerca que su nariz roza la tuya."
    "His lips search and wait for you, so close that his nose brushes yours."

# game/rutas/nulla.rpy:2759
translate ingles continuacion_nulla1_dcc57326:

    # nulla "Te tengo al frente. No la marioneta, no... tú."
    nulla "I have you in front of me. Not the puppet, no... you."

# game/rutas/nulla.rpy:2760
translate ingles continuacion_nulla1_c4a08cc4:

    # "Suena como un mantra que intenta manifestar algo que es imposible. Tan desesperado que realmente parece que ya se ha convencido de aquello."
    "It sounds like a mantra, an attempt to manifest something impossible. So desperate it almost feels like he's convinced himself it's true."

# game/rutas/nulla.rpy:2761
translate ingles continuacion_nulla1_f5a8dfd5:

    # "Pero por hoy ambos juegan a fingir."
    "But tonight, both of you play pretend."

# game/rutas/nulla.rpy:2762
translate ingles continuacion_nulla1_2f7bf3c8:

    # "Que todo está bien."
    "That everything is fine."

# game/rutas/nulla.rpy:2763
translate ingles continuacion_nulla1_671983f6:

    # "Que todo tiene sentido."
    "That everything makes sense."

# game/rutas/nulla.rpy:2764
translate ingles continuacion_nulla1_59db5d4f:

    # "Que todo esto es real."
    "That all of this is real."

# game/rutas/nulla.rpy:2769
translate ingles continuacion_nulla1_115d575a:

    # "Sellas tus labios con los suyos: un roce suave y tierno."
    "You seal your lips with his: a soft, tender touch."

# game/rutas/nulla.rpy:2770
translate ingles continuacion_nulla1_764bee0b:

    # "Pero eso basta para que Nulla lo tome todo. El beso se transforma, se profundiza, volviéndose íntimo y exigente."
    "But that's all it takes for Nulla to take everything. The kiss transforms and deepens, becoming intimate and demanding."

# game/rutas/nulla.rpy:2771
translate ingles continuacion_nulla1_81651b2c:

    # "Te consume. Es embriagador, como si intentara fundirse contigo en ese único contacto."
    "He consumes you. It's intoxicating, as if he's trying to merge with you through that single contact."

# game/rutas/nulla.rpy:2772
translate ingles continuacion_nulla1_1ac9a54c:

    # "Sus manos se suman a la danza, acariciando tu cuello y mandíbula, sujetándote con firmeza, guiándote."
    "His hands join the dance, caressing your neck and jaw, holding you firmly, guiding you."

# game/rutas/nulla.rpy:2773
translate ingles continuacion_nulla1_48ea6e9b:

    # "Cuando el aire comienza a faltarte, Nulla se separa apenas soltando un suspiro ahogado, que hace que envía una corriente eléctrica por todo tu...body. The sound of that muffled sigh sends a shiver through you."
    "When you start to gasp for air, Nulla pulls away with a stifled sigh, sending an electric shock through your... body. The sound of that muffled sigh sends a shiver through you"
    
# game/rutas/nulla.rpy:2774
translate ingles continuacion_nulla1_fa2eb94b:

    # "Nulla esconde el rostro en el hueco entre tu cuello y tu hombro."
    "Nulla hides his face in the hollow between your neck and shoulder."

# game/rutas/nulla.rpy:2775
translate ingles continuacion_nulla1_90282158:

    # "Allí, planta otro beso en tu cuello, suave justo sobre tu piel."
    "There, he plants another kiss on your neck, soft and just barely grazing your skin."

# game/rutas/nulla.rpy:2777
translate ingles continuacion_nulla1_f8a42b41:

    # nulla "Creo que es suficiente por hoy."
    nulla "I think that's enough for today."

# game/rutas/nulla.rpy:2781
translate ingles continuacion_nulla1_91525914:

    # "Obtienes una risa seca, riéndose de lo que estuvo a punto de hacer..."
    "You get a dry laugh from him, amused at what he was just about to do..."


# game/rutas/nulla.rpy:2782
translate ingles continuacion_nulla1_d3387e86:

    # nulla "Gracias."
    nulla "Thank you."

# game/rutas/nulla.rpy:2783
translate ingles continuacion_nulla1_896580ba:

    # "Es lo único que sale de sus labios."
    "It's the only thing that escapes his lips."

# game/rutas/nulla.rpy:2785
translate ingles continuacion_nulla1_a20cefa7_2:

    # "..."
    "..."

# game/rutas/nulla.rpy:2790
translate ingles continuacion_nulla1_1b49a68d:

    # nulla "Daría todo lo que tengo para que seas lo último que vea antes de ir a dormir."
    nulla "I'd give everything I have just to make you the last thing I see before I fall asleep."

# game/rutas/nulla.rpy:2791
translate ingles continuacion_nulla1_2fe8b1fa:

    # nulla "Si no supiera lo suficiente, intentaría arrancarte de ahí para traerte aquí, conmigo :)"
    nulla "If I didn't know better, I'd try to pull you out of there to get you here with me. :)"

# game/rutas/nulla.rpy:2795
translate ingles continuacion_nulla1_2f21ff52:

    # "Su respiración es extrañamente tranquila, pero en su pecho puedes sentir un latido intenso... o quizás es el tuyo. Ya no puedes discernir entre lo que es suyo y lo que es tuyo."
    "His breathing is strangely calm, but in his chest you can feel a deep, steady heartbeat... or maybe it's yours. You can't tell where you end and he begins anymore."

# game/rutas/nulla.rpy:2796
translate ingles continuacion_nulla1_5e778c0e:

    # "Pero estás seguro de una cosa: no quieres romper esta conexión por ahora."
    "But you're sure of one thing: You don't want to break this connection. Not yet."

# game/rutas/nulla.rpy:2798
translate ingles continuacion_nulla1_4231dab3:

    # "Así que optas por cerrar los ojos y rogar en silencio para que Nulla no se vaya en medio de la noche."
    "So you close your eyes and silently pray that Nulla won't disappear in the middle of the night."

# game/rutas/nulla.rpy:2799
translate ingles continuacion_nulla1_c51d7991:

    # " . . . "
    " . . . "

# game/rutas/nulla.rpy:2801
translate ingles continuacion_nulla1_9fd7a243:

    # "La mañana siguiente sigue la misma rutina que la anterior."
    "The next morning follows the same routine as the last."

# game/rutas/nulla.rpy:2802
translate ingles continuacion_nulla1_7b7fdaaf:

    # "Nulla te trae el desayuno a la cama, anunciando que el día de hoy saldrán en la noche nuevamente. Por lo que pueden pasar el resto del día descansando."
    "Nulla brings you breakfast in bed, announcing that tonight you'll be going out again. Until then, he says, you can both spend the day resting."

# game/rutas/nulla.rpy:2803
translate ingles continuacion_nulla1_5dc667bb:

    # "Terminando el desayuno, Nulla toma la bandeja y te pide que tengas cuidado al caminar si es que quieres salir de la habitación."
    "When you finish eating, Nulla takes the tray and reminds you to be careful if you decide to leave the room."

# game/rutas/nulla.rpy:2805
translate ingles continuacion_nulla1_1db67424:

    # "Nulla te da un beso en la frente y sale de la habitación, dejándote a solas."
    "He presses a gentle kiss to your forehead before leaving the room, quietly closing the door behind him."

# game/rutas/nulla.rpy:2808
translate ingles continuacion_nulla1_23a3cafd:

    # "Nulla se excusa y sale de la habitación con la bandeja entre las manos."
    "Nulla excuses himself and leaves the room with the tray in his hands."

# game/rutas/nulla.rpy:2810
translate ingles continuacion_nulla1_e157535a:

    # "Esperas un segundo antes de decidir que hacer ahora."
    "You wait for a moment before deciding what to do next."

# game/rutas/nulla.rpy:2814
translate ingles continuacion_nulla1_a20cefa7_3:

    # "..."
    "..."

# game/rutas/nulla.rpy:2815
translate ingles continuacion_nulla1_d433b732:

    # "Te duermes al instante."
    "You fall asleep almost instantly."

# game/rutas/nulla.rpy:2816
translate ingles continuacion_nulla1_66d411fc:

    # "El tiempo se distorsiona, no sabes por cuantos minutos o horas has dormido, pero la mano de Nulla en tu hombro hace que abras los ojos."
    "Time twists and folds--you can't tell if it's been minutes or hours--but Nulla's hand on your shoulder pulls you back to consciousness."

# game/rutas/nulla.rpy:2818
translate ingles continuacion_nulla1_54ffd34b:

    # "Nulla te despierta y te lleva a la cocina para que tomes o comas algo."
    "Nulla wakes you gently and takes you to the kitchen so you can eat or drink something."

# game/rutas/nulla.rpy:2819
translate ingles continuacion_nulla1_a98ccd00:

    # "Él se ofrece a preparar todo, por lo que tú solo te dedicas a observar."
    "He insists on preparing everything himself, leaving you to simply watch."

# game/rutas/nulla.rpy:2820
translate ingles continuacion_nulla1_95e6f111:

    # "Se ve lindo haciendo todo el trabajo."
    "He looks unexpectedly cute while doing all the work."

# game/rutas/nulla.rpy:2824
translate ingles continuacion_nulla1_fc47f702:

    # "Te levantas de la cama. Estar de pie te hace notar lo pesado que se siente tu cuerpo, por lo que te estiras un poco."
    "You get out of bed. Standing makes you realize how heavy your body feels, so you stretch a little to shake it off."

# game/rutas/nulla.rpy:2829
translate ingles continuacion_nulla2_7ba04d5a:

    # nulla "Estaba pensando en ir a mis memorias."
    nulla "I was thinking of going into my memories."

# game/rutas/nulla.rpy:2832
translate ingles continuacion_nulla2_b5c060cb:

    # nulla "Con eso tengo más material para trabajar."
    nulla "That way I'll have more material to work with."

# game/rutas/nulla.rpy:2833
translate ingles continuacion_nulla2_02ee6953:

    # nulla "Tener una cita normal de una buena vez por todas..."
    nulla "To finally have a normal date, for once..."

# game/rutas/nulla.rpy:2836
translate ingles continuacion_nulla2_4fee5445:

    # nulla "Podríamos hacer un picnic o--"
    nulla "We could have a picnic or--"

# game/rutas/nulla.rpy:2839
translate ingles continuacion_nulla2_1d00759d:

    # nulla "Oh! ya sé... ¿Qué tal visitar una feria?"
    nulla "Oh! I know... how about visiting a fair?"

# game/rutas/nulla.rpy:2840
translate ingles continuacion_nulla2_38d85c3d:

    # nulla "Subirnos a la rueda de la fortuna... o jugar en los puestos para ganar premios."
    nulla "We could ride the Ferris wheel... or play some of those little games to win prizes."

# game/rutas/nulla.rpy:2843
translate ingles continuacion_nulla2_71d31e84:

    # nulla "¿Qué dices?"
    nulla "What do you think?"

# game/rutas/nulla.rpy:2846
translate ingles continuacion_nulla2_c0876f46:

    # "............."
    "............."

# game/rutas/nulla.rpy:2847
translate ingles continuacion_nulla2_34f1a317:

    # "¿Será seguro ir ahí?"
    "Would it even be safe to go there?"

# game/rutas/nulla.rpy:2850
translate ingles continuacion_nulla2_fe43f814:

    # nulla "¡Claro que es seguro!"
    nulla "Of course it's safe!"

# game/rutas/nulla.rpy:2851
translate ingles continuacion_nulla2_b3179049:

    # nulla "Siempre y cuando te quedes a mi lado."
    nulla "As long as you stay by my side."

# game/rutas/nulla.rpy:2856
translate ingles continuacion_nulla2_f7e05489:

    # nulla "Bien."
    nulla "Good."

# game/rutas/nulla.rpy:2857
translate ingles continuacion_nulla2_55519b75:

    # nulla "Me iré preparando entonces."
    nulla "Then I'll go get ready."

# game/rutas/nulla.rpy:2862
translate ingles continuacion_nulla2_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2865
translate ingles continuacion_nulla2_6c301622:

    # nulla "[nombrejugador], mi vida, mi cielo..."
    nulla "[nombrejugador], mi vida, mi cielo..."

# game/rutas/nulla.rpy:2868
translate ingles continuacion_nulla2_24e9636b:

    # nulla "No te preocupes."
    nulla "Don't worry."

# game/rutas/nulla.rpy:2869
translate ingles continuacion_nulla2_7f5e1759:

    # nulla "Sé manejar mis memorias."
    nulla "I know how to handle my memories."

# game/rutas/nulla.rpy:2870
translate ingles continuacion_nulla2_2bfaffe3:

    # nulla "Hoy es un día para divertirse."
    nulla "Today's a day of fun."

# game/rutas/nulla.rpy:2873
translate ingles continuacion_nulla2_578f3a3d:

    # nulla "Hay que aprovecharlo."
    nulla "We should make the most of it."

# game/rutas/nulla.rpy:2877
translate ingles continuacion_nulla2_7a291aa4:

    # "La tetera comienza a silbar. Nulla detiene el cuchillo a medio corte, para dejar la fruta a un lado y levantarse a servir el té."
    "The kettle begins to whistle. Nulla stops mid-cut, sets the fruit aside, and gets up to pour the tea."

# game/rutas/nulla.rpy:2878
translate ingles continuacion_nulla2_408817c5:

    # nulla "Iremos después de esto."
    nulla "We'll go after this."


# game/rutas/nulla.rpy:2879
translate ingles continuacion_nulla2_29885a5a:

    # "Mientras llena las tazas con agua caliente, Nulla sonríe como si recordara algo."
    "As he fills the cups with hot water, Nulla smiles as if remembering something."

# game/rutas/nulla.rpy:2880
translate ingles continuacion_nulla2_0539b7bb:

    # nulla "Si te asusta la idea de separarte de mí..."
    nulla "If the thought of being apart from me scares you..."

# game/rutas/nulla.rpy:2881
translate ingles continuacion_nulla2_7b072bdd:

    # nulla "Toma."
    nulla "Here."

# game/rutas/nulla.rpy:2883
translate ingles continuacion_nulla2_ea48bb8f:

    # "Todo se vuelve blando de repente..."
    "Everything suddenly feels soft..."

# game/rutas/nulla.rpy:2885
translate ingles continuacion_nulla2_14ad2cca:

    # "Deja la tetera a un lado, y te extiende la mano, abierta... no hay nada ahí."
    "He sets the kettle aside and extends his hand toward you, open and empty."

# game/rutas/nulla.rpy:2886
translate ingles continuacion_nulla2_f9d0e41a:

    # "Notando tu confusión, Nulla cierra el puño con fuerza, y aprieta hasta que sus nudillos comienzan a decolorarse."
    "Noticing your confusion, Nulla closes his fist tightly, his knuckles turning pale with the pressure."

# game/rutas/nulla.rpy:2888
translate ingles continuacion_nulla2_c9d8957b:

    # "De entre sus dedos comienza a brotar una masa oscura y viscosa, que palpita. Simulando una respiración."
    "A dark, viscous mass begins to ooze from between his fingers, pulsing like it's breathing."

# game/rutas/nulla.rpy:2889
translate ingles continuacion_nulla2_f61720ab:

    # "La observas, con curiosidad."
    "You watch it, curious and uneasy."

# game/rutas/nulla.rpy:2890
translate ingles continuacion_nulla2_ac14c368:

    # "Apenas la tomas, la uhh-- ¿pequeña... criatura?, esta se agita suavemente entre tus manos."
    "As soon as you take the, uh... small... creature? It stirs in your hands."

# game/rutas/nulla.rpy:2891
translate ingles continuacion_nulla2_03905d82:

    # "Entonces, seis ojos se abren, para devolverte la mirada."
    "Then, six eyes open to meet yours."

# game/rutas/nulla.rpy:2892
translate ingles continuacion_nulla2_77a10bd6:

    # "Te miran con la misma curiosidad con la que tú los mirabas a ellos."
    "They stare at you with the same curiosity you showed them."

# game/rutas/nulla.rpy:2893
translate ingles continuacion_nulla2_cc9a5909:

    # "!!!"
    "!!!"

# game/rutas/nulla.rpy:2895
translate ingles continuacion_nulla2_4092d46e:

    # nulla "Ja."
    nulla "Ja."

# game/rutas/nulla.rpy:2896
translate ingles continuacion_nulla2_9b6d93f1:

    # nulla "Si tienes miedo de alejarte, puedo darte una parte de mí."
    nulla "If you're afraid of being away from me, I can give you a part of myself."

# game/rutas/nulla.rpy:2897
translate ingles continuacion_nulla2_162bcf12:

    # nulla "Con esto, siempre podrás volver."
    nulla "With this, you'll always be able to come back."

# game/rutas/nulla.rpy:2898
translate ingles continuacion_nulla2_ae422a22:

    # nulla "No importa dónde estés..."
    nulla "No matter where you are..."

# game/rutas/nulla.rpy:2899
translate ingles continuacion_nulla2_b43cb319:

    # nulla "--ni en qué línea de tiempo te encuentres :)"
    nulla "... or which timeline you're in. :)"

# game/rutas/nulla.rpy:2901
translate ingles continuacion_nulla2_307d8cc7:

    # nulla "Aunque solo podrás usarlo cuando estés lejos de mí."
    nulla "Though, you'll only be able to use it when you're far from me."

# game/rutas/nulla.rpy:2902
translate ingles continuacion_nulla2_d23828ff:

    # nulla "Debo cuidar mi energía..."
    nulla "I need to preserve my energy..."

# game/rutas/nulla.rpy:2903
translate ingles continuacion_nulla2_4b17a99b:

    # nulla "Lo entiendes, ¿cierto, cariño?"
    nulla "You understand, don't you, cariño?"

# game/rutas/nulla.rpy:2905
translate ingles continuacion_nulla2_6ca92ec6:

    # "No puedes responder, pues la criatura se inserta en tu piel y es absorbida por ella."
    "You can't respond because the creature slips into your skin, absorbed completely."

# game/rutas/nulla.rpy:2906
translate ingles continuacion_nulla2_129f22e8:

    # "Ya no queda rastro de la masa."
    "No trace of it remains."

# game/rutas/nulla.rpy:2910
translate ingles continuacion_nulla2_8784a0f2:

    # nulla "Oh..."
    nulla "Oh..."

# game/rutas/nulla.rpy:2912
translate ingles continuacion_nulla2_73cc6b08:

    # nulla "Ohhh, jajajaja."
    nulla "Ohhh, jajajaja."

# game/rutas/nulla.rpy:2913
translate ingles continuacion_nulla2_dd0d7aec:

    # nulla "Así que esto es lo que has estado haciendo cuando no tengo acceso completo a ti..."
    nulla "So this is what you've been doing when I don't have full access to you..."

# game/rutas/nulla.rpy:2914
translate ingles continuacion_nulla2_630c2d2e:

    # nulla "Jajajajaja--"
    nulla "Jajajajaja--"

# game/rutas/nulla.rpy:2916
translate ingles continuacion_nulla2_b6d03242:

    # nulla "No lo puedo creer."
    nulla "I can't believe it."

# game/rutas/nulla.rpy:2918
translate ingles continuacion_nulla2_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:2919
translate ingles continuacion_nulla2_d0800207:

    # nulla "Lo siento mucho, pero no puedo aceptar esto."
    nulla "I'm sorry, but I can't allow this."

# game/rutas/nulla.rpy:2921
translate ingles continuacion_nulla2_a1bb173b:

    # "Nulla se acerca tanto a ti que, de forma inconsciente, retrocedes. La acción es tan repentina que tu cuerpo reacciona solo."
    "Nulla steps so close that you instinctively back away. The movement is sudden, reflexive."

# game/rutas/nulla.rpy:2922
translate ingles continuacion_nulla2_fdd66c80:

    # "Su expresión te aterra un poco... Son muy pocas las veces en que has visto ese semblante dirigido a ti."
    "His expression frightens you a little... you've rarely seen that look aimed at you."

# game/rutas/nulla.rpy:2923
translate ingles continuacion_nulla2_e4aa7eb2:

    # "Sus labios ya no tienen esa sonrisa cálida que suele recibirte cuando te habla."
    "His lips no longer carry the warm smile that usually greets you when he speaks."

# game/rutas/nulla.rpy:2924
translate ingles continuacion_nulla2_9656280f:

    # "No. Ahora está serio. Las cejas fruncidas."
    "No. Now he's serious, his brows furrowed."

# game/rutas/nulla.rpy:2925
translate ingles continuacion_nulla2_d1e2df84:

    # "Y todo por algo que tú permitiste."
    "And all because of something you allowed."

# game/rutas/nulla.rpy:2926
translate ingles continuacion_nulla2_70079184:

    # "Nulla enfoca su mirada en la esquina superior de la pantalla y levanta la mano."
    "Nulla fixes his gaze on the upper corner of the screen and raises his hand."

# game/rutas/nulla.rpy:2927
translate ingles continuacion_nulla2_d27c9b16:

    # "Le basta con tocar el ícono con un dedo para que desaparezca."
    "A single touch of his finger and the icon vanishes."

# game/rutas/nulla.rpy:2930
translate ingles continuacion_nulla2_3cbe8b92:

    # "Hecho eso, su sonrisa regresa."
    "Once that's done, his smile returns."

# game/rutas/nulla.rpy:2931
translate ingles continuacion_nulla2_f101f276:

    # "Como si nada hubiese pasado."
    "As if nothing had happened."

# game/rutas/nulla.rpy:2932
translate ingles continuacion_nulla2_3b5825a8:

    # nulla "Haré lo mismo con ese bastardo."
    nulla "I'll do the same to that bastard."

# game/rutas/nulla.rpy:2934
translate ingles continuacion_nulla2_81a8adba:

    # nulla "Solo tienes que esperar, mi vida."
    nulla "Just wait for me, mi vida."

# game/rutas/nulla.rpy:2935
translate ingles continuacion_nulla2_75b86716:

    # "El silencio que se genera es aterrador."
    "The silence that follows is terrifying."

# game/rutas/nulla.rpy:2936
translate ingles continuacion_nulla2_cd2ce37a:

    # "Aunque sonríe, su aura es densa. Negativa. Pesada sobre el ambiente, que te hunde con el paso de los segundos."
    "Even as he smiles, his aura feels dense. Negative and heavy, pressing down on the air until it suffocates you."

# game/rutas/nulla.rpy:2937
translate ingles continuacion_nulla2_c9c9fc1d:

    # "Hasta que... se esfuma."
    "Until... it fades."

# game/rutas/nulla.rpy:2938
translate ingles continuacion_nulla2_33125f4f:

    # "Nulla sonríe como si nada hubiera pasado."
    "Nulla smiles again, as though nothing ever happened."

# game/rutas/nulla.rpy:2941
translate ingles continuacion_nulla2_a20cefa7_1:

    # "..."
    "..."

# game/rutas/nulla.rpy:2944
translate ingles continuacion_nulla2_b8d41968:

    # nulla "¡Pero mira qué lindo ícono te has ganado!"
    nulla "But look at that adorable little icon you got!"

# game/rutas/nulla.rpy:2945
translate ingles continuacion_nulla2_d2280dfa:

    # "Nulla señala hacia la izquierda de la pantalla."
    "Nulla points to the left side of the screen."

# game/rutas/nulla.rpy:2947
translate ingles continuacion_nulla2_b9cef42a:

    # nulla "Ahora no funciona... pero se ve lindo."
    nulla "It doesn't work yet... but it looks nice."

# game/rutas/nulla.rpy:2949
translate ingles continuacion_nulla2_c9ad74c8:

    # nulla "Ahora soy tuyo."
    nulla "Now I'm yours."

# game/rutas/nulla.rpy:2950
translate ingles continuacion_nulla2_1d2f001d:

    # nulla "Y no tienes a nadie más que a mí <3."
    nulla "And you have no one but me. <3"

# game/rutas/nulla.rpy:2952
translate ingles continuacion_nulla2_c493798f:

    # "Nulla finalmente se aleja. Se lo ve satisfecho con lo que ha hecho."
    "Nulla finally steps back. He looks satisfied with what he's done."

# game/rutas/nulla.rpy:2953
translate ingles continuacion_nulla2_fea69517:

    # "Te reconforta, al menos, no sentir ningún dolor. Tu cuerpo no ha sufrido daño, por lo que puedes asumir que esta 'parte de Nulla' es un extra. Algo útil... en caso de emergencia."
    "At least it's comforting that you don't feel any pain. Your body's unharmed, so you assume this 'part of Nulla' is a bonus--something useful, maybe... in case of emergency."

# game/rutas/nulla.rpy:2954
translate ingles continuacion_nulla2_80d06fa4:

    # "Si es que alguna vez existe una emergencia."
    "If such an emergency ever comes."


# game/rutas/nulla.rpy:2955
translate ingles continuacion_nulla2_888331bd:

    # "De hecho, no estaría mal poder usarlo también en otros guardados. Poder acceder rápidamente a Nulla suena bastante útil."
    "In fact, it wouldn't be bad to use it in other saves too. Having quick access to Nulla sounds pretty handy."

# game/rutas/nulla.rpy:2956
translate ingles continuacion_nulla2_3fd6ef3f:

    # nulla "Bueno. Es momento de irnos a la cita."
    nulla "Well then. Time to head to our date."

# game/rutas/nulla.rpy:2957
translate ingles continuacion_nulla2_91a78d69:

    # nulla "Espero que te guste."
    nulla "I hope you'll like it."

# game/rutas/nulla.rpy:2958
translate ingles continuacion_nulla2_8ca878ee:

    # nulla "Ya tengo todo el plan para hoy."
    nulla "I already have everything planned for today."

# game/rutas/nulla.rpy:2960
translate ingles continuacion_nulla2_714ebf91:

    # "Sus manos se entrelazan con las tuyas, asegurando el contacto antes de sumergirse en el vacío."
    "His fingers intertwine with yours, securing the contact before diving into the Void."

# game/rutas/nulla.rpy:2962
translate ingles continuacion_nulla2_c2dc5fbe:

    # "Dejas de ver."
    "You stop seeing."

# game/rutas/nulla.rpy:2963
translate ingles continuacion_nulla2_30870b06:

    # "Dejas de escuchar."
    "You stop hearing."

# game/rutas/nulla.rpy:2964
translate ingles continuacion_nulla2_20d8cfe6:

    # "Sientes que flotas. Solo. Nulla ya no está contigo."
    "You feel yourself floating. Alone. Nulla is no longer with you."

# game/rutas/nulla.rpy:2965
translate ingles continuacion_nulla2_8314c863:

    # "No puedes evitar entrar en pánico. Te falta el aire y sientes que caes por un precipicio sin fin."
    "Panic sets in--you can't breathe, and it feels like you're falling endlessly into a bottomless pit."

# game/rutas/nulla.rpy:2966
translate ingles continuacion_nulla2_2fa80218:

    # "Es la primera vez que pasa esto."
    "It's the first time this has happened."

# game/rutas/nulla.rpy:2967
translate ingles continuacion_nulla2_b7a8c860:

    # "{glitch=20.0}{color=ffffff}{b}Shhh, no pasa nada.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Shhh, it's okay.{/glitch}"

# game/rutas/nulla.rpy:2968
translate ingles continuacion_nulla2_4cb5071a:

    # "{glitch=20.0}{color=ffffff}{b}Espera un poco más.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Just wait a little longer.{/glitch}"

# game/rutas/nulla.rpy:2972
translate ingles continuacion_nulla2_a20cefa7_2:

    # "..."
    "..."

# game/rutas/nulla.rpy:2973
translate ingles continuacion_nulla2_d176a608:

    # "{glitch=20.0}{color=ffffff}{b}JAjajajaaaaa.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}JAjajajaaaaa.{/glitch}"

# game/rutas/nulla.rpy:2974
translate ingles continuacion_nulla2_a776f384:

    # "{glitch=20.0}{color=ffffff}{b}Obviamente, mi vida.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Obviously, mi vida.{/glitch}"

# game/rutas/nulla.rpy:2977
translate ingles continuacion_nulla2_a20cefa7_3:

    # "..."
    "..."

# game/rutas/nulla.rpy:2978
translate ingles continuacion_nulla2_085768d9:

    # "................"
    "................"

# game/rutas/nulla.rpy:2979
translate ingles continuacion_nulla2_e81e3c97:

    # "{glitch=20.0}{color=ffffff}{b}......................{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}......................{/glitch}"

# game/rutas/nulla.rpy:2980
translate ingles continuacion_nulla2_0eb2e14b:

    # "{glitch=20.0}{color=ffffff}{b}¿Cómo?{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}What?{/glitch}"

# game/rutas/nulla.rpy:2981
translate ingles continuacion_nulla2_501ba8c4:

    # "{glitch=20.0}{color=ffffff}{b}¿Por qué estás tan paranoico?{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Why are you so paranoid?{/glitch}"

# game/rutas/nulla.rpy:2982
translate ingles continuacion_nulla2_fa5ef063:

    # "{glitch=20.0}{color=ffffff}{b}No me voy a ir a ningún lado. Y mucho menos te dejaría con otra persona...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}I'm not going anywhere. And I'd never leave you with someone else...{/glitch}"

# game/rutas/nulla.rpy:2984
translate ingles continuacion_nulla2_e599a579:

    # "Tus pies tocan el suelo al fin."
    "Your feet finally touch the ground."

# game/rutas/nulla.rpy:2987
translate ingles continuacion_nulla2_4bc9ab06:

    # "Al hacerlo, el mundo se ilumina y el sonido llega a tus oídos, como si alguien pulsara un interruptor que acciona estos estímulos para inundar tus sentidos cruelmente. Hay tantas luces que, por un momento, te cuesta enfocar la vista."
    "As they do, the world bursts into light and sound floods your ears as if someone had flipped a switch, flooding your senses all at once. There are so many lights that, for a moment, it's hard to focus."

# game/rutas/nulla.rpy:2989
translate ingles continuacion_nulla2_9ea80eb6:

    # "Cuando lo logras, reconoces el lugar sin problemas: una especie de carnaval o feria, con puestos de comida y juegos donde probar suerte. Juegos que probablemente están arreglados para que casi nadie gane el premio."
    "When your sight clears, you recognize the place easily: a fairground full of food stalls and games of chance (most likely rigged so almost no one wins a prize)."

# game/rutas/nulla.rpy:2990
translate ingles continuacion_nulla2_13eb45cc:

    # "Hay gente, pero no demasiada. Puedes moverte sin que invadan tu espacio personal, sin ser empujado por personas distraídas. Es perfecto, lo justo como para convencerte de que todo saldrá bien."
    "There are people around, but not too many. You can move freely without anyone invading your space or bumping into you. It's perfect--just enough to make you believe everything will be fine."

# game/rutas/nulla.rpy:2991
translate ingles continuacion_nulla2_ce8e5992:

    # nulla "¿Te gusta?"
    nulla "Do you like it?"

# game/rutas/nulla.rpy:2994
translate ingles continuacion_nulla2_11347201:

    # "Nulla se rie por debajo."
    "Nulla chuckles softly."

# game/rutas/nulla.rpy:2997
translate ingles continuacion_nulla2_58a993af:

    # nulla "Awwww. No seas aguafiestas."
    nulla "Awwww, don't be such a buzzkill."

# game/rutas/nulla.rpy:2998
translate ingles continuacion_nulla2_47dc59a4:

    # nulla "Puse toda mi energía en recordar cada uno de los detalles de esta feria."
    nulla "I poured all my energy into remembering every little detail of this fair."

# game/rutas/nulla.rpy:2999
translate ingles continuacion_nulla2_7e75f35e:

    # nulla "Aunque si ves una vaca flotando o una persona sin cabeza, por favor ignóralas..."
    nulla "Though, if you happen to see a floating cow or a person without a head, just ignore them, please..."

# game/rutas/nulla.rpy:3001
translate ingles continuacion_nulla2_e2207978:

    # "Tomas de la mano a Nulla mientras caminan por la feria. El primer lugar que visitan en un puesto de tiro al blanco."
    "You take Nulla's hand as you walk together. The first stop is a shooting gallery."

# game/rutas/nulla.rpy:3003
translate ingles continuacion_nulla2_edeadebe:

    # "Nulla y tú inspeccionan los premios, son todos peluches de distintos tamaños y formas. Luego te pregunta cuál quieres y promete ganarlo para ti."
    "You both inspect the prizes, which are plush toys of all shapes and sizes. He asks which one you want and promises to win it for you."

# game/rutas/nulla.rpy:3006
translate ingles continuacion_nulla2_a20cefa7_4:

    # "..."
    "..."

# game/rutas/nulla.rpy:3007
translate ingles continuacion_nulla2_cae0c63f:

    # "Ese ojo da miedo..."
    "That eye is creepy..."

# game/rutas/nulla.rpy:3010
translate ingles continuacion_nulla2_4a9cc0d2:

    # "Te recuerda a Nulla en cierto sentido."
    "It reminds you of Nulla somehow."

# game/rutas/nulla.rpy:3011
translate ingles continuacion_nulla2_932e1eaf:

    # "Crees que son los ojos..."
    "Maybe it's the eyes..."

# game/rutas/nulla.rpy:3014
translate ingles continuacion_nulla2_3853d438:

    # "Se ve lindo."
    "It looks cute."

# game/rutas/nulla.rpy:3017
translate ingles continuacion_nulla2_ef0c90b4:

    # "Te causa gracia y ternura los dientes tan grandes que tiene."
    "Its oversized teeth make you laugh--it's oddly endearing."

# game/rutas/nulla.rpy:3019
translate ingles continuacion_nulla2_59439e74:

    # nulla "¡Okay!"
    nulla "Okay!"

# game/rutas/nulla.rpy:3020
translate ingles continuacion_nulla2_f5871b17:

    # "Exclama Nulla alzando la voz, con exageración y un toque cómico deliberado."
    "Nulla exclaims loudly, his tone exaggerated and playfully theatrical."

# game/rutas/nulla.rpy:3022
translate ingles continuacion_nulla2_ba324f4a:

    # "Pide un turno al dueño del puesto, pero ignora por completo la pistola de juguete que este le ofrece. Nulla prefiere su 'para nada peligroso' revólver, el cual materializa con un simple gesto de sus manos."
    "He asks the stall owner for a turn but completely ignores the toy gun offered to him. Nulla prefers his 'not-at-all-dangerous' revolver, which he materializes with a casual flick of his hand."

# game/rutas/nulla.rpy:3023
translate ingles continuacion_nulla2_54482ca3:

    # "Al dueño no le importa una mierda y media. Sigue en su papel, inmutable, como si nada fuera extraño. Y eso te recuerda que no estás en el mundo real."
    "The stall owner doesn't give a single damn. He stays perfectly in character, unbothered, as if nothing strange had happened. And that reminds you you're not in the real world."

# game/rutas/nulla.rpy:3024
translate ingles continuacion_nulla2_bcf6dd4d:

    # "No."
    "No."

# game/rutas/nulla.rpy:3025
translate ingles continuacion_nulla2_499a3583:

    # "Estás en un dominio construido con rastros de la memoria de una entidad que ha vivido tantas vidas que ya ni él debe recordar la cantidad."
    "You're in a domain built from the remnants of an entity's memories--one that has lived so many lives he probably can't even remember how many anymore."

# game/rutas/nulla.rpy:3026
translate ingles continuacion_nulla2_c615987b:

    # "Un lugar donde, básicamente, puede hacer lo que se le dé la gana."
    "A place where, basically, he can do whatever he pleases."

# game/rutas/nulla.rpy:3027
translate ingles continuacion_nulla2_3abb2ee2:

    # "La destreza que tiene con el arma es de admirar, al mismo tiempo que de temer."
    "The skill he displays with the gun is both admirable and a little terrifying."

# game/rutas/nulla.rpy:3028
translate ingles continuacion_nulla2_f761a6f6:

    # "No falla ningún objetivo, y para peor: se ve muy bien apuntando con el revolver."
    "He doesn't miss a single target... and worse, he looks damn good while aiming that revolver."

# game/rutas/nulla.rpy:3029
translate ingles continuacion_nulla2_3b6c0743:

    # "El dueño del puesto lo felicita, dándole el peluche que has elegido."
    "The stall owner congratulates him and hands over the plush toy you picked."

# game/rutas/nulla.rpy:3031
translate ingles continuacion_nulla2_61ac81e1:

    # nulla "¿Qué tal?"
    nulla "How'd I do?"


# game/rutas/nulla.rpy:3034
translate ingles continuacion_nulla2_30f18ddc:

    # "Nulla sonrie sin mostrar los dientes."
    "Nulla beams."

# game/rutas/nulla.rpy:3035
translate ingles continuacion_nulla2_0213887b:

    # "Es una sonrisa sincera, hasta tierna."
    "It's a genuine smile, almost tender."

# game/rutas/nulla.rpy:3038
translate ingles continuacion_nulla2_5c5cea64:

    # "Nulla rie."
    "Nulla laughs."

# game/rutas/nulla.rpy:3043
translate ingles continuacion_nulla2_26f2b73c:

    # "Nulla te observa por un segundo antes de sonreir."
    "Nulla watches you for a moment before smiling."

# game/rutas/nulla.rpy:3046
translate ingles continuacion_nulla2_e4c92906:

    # nulla "No lo dudo."
    nulla "I don't doubt it."

# game/rutas/nulla.rpy:3047
translate ingles continuacion_nulla2_5206f298:

    # "Lo dice con total sinceridad."
    "He says it with complete sincerity."

# game/rutas/nulla.rpy:3050
translate ingles continuacion_nulla2_32f931eb:

    # "Después de un rato caminando entre puestos de luces parpadeantes y música alegre, Nulla propone ir a la ruleta de la fortuna."
    "After wandering for a while between the flashing lights and cheerful music, Nulla suggests going on the Ferris wheel."

# game/rutas/nulla.rpy:3051
translate ingles continuacion_nulla2_bac65775:

    # "No espera tu respuesta. Solo te toma de la mano y te guía entre la gente."
    "He doesn't wait for your answer. He simply takes your hand and leads you through the crowd."

# game/rutas/nulla.rpy:3052
translate ingles continuacion_nulla2_428af5bf:

    # "Se saltan la fila sin dudarlo. Nadie dice nada, ni parecen notarlo siquiera, pero tú no puedes evitar sentir culpa por ello."
    "He skips the line without hesitation. No one says a word (or even seems to notice), but you can't help feeling a bit guilty."

# game/rutas/nulla.rpy:3053
translate ingles continuacion_nulla2_ffdb5fb0:

    # "Volteas la cabeza un poco para mirar a las personas en la fila, pero sus rostros parecen borrosos, sin detalles."
    "You turn your head slightly to glance at the people in line, but their faces are blurred, lacking any real detail."

# game/rutas/nulla.rpy:3054
translate ingles continuacion_nulla2_944fe1c8:

    # "Nulla es rápido en consolarte, sonriéndote como quien lo hace con un niño pequeño que hace una rabieta."
    "Nulla is quick to comfort you, smiling the way someone would at a child having a small tantrum."

# game/rutas/nulla.rpy:3055
translate ingles continuacion_nulla2_2691e29e:

    # nulla "Ninguno de ellos importa realmente."
    nulla "None of them really matter."

# game/rutas/nulla.rpy:3056
translate ingles continuacion_nulla2_242e7e56:

    # "Suena cruel, pero es cierto en este contexto."
    "It sounds cruel, but in this context, he's right."

# game/rutas/nulla.rpy:3057
translate ingles continuacion_nulla2_382f7e5c:

    # "Aunque no se molesta en explicar lo obvio."
    "Though he doesn't bother to explain the obvious."

# game/rutas/nulla.rpy:3059
translate ingles continuacion_nulla2_0134f819:

    # "La cabina es solo para ustedes dos. El interior es espacioso. La luz que entra por las ventanas es suave, teñida de azul por la hora."
    "The spacious cabin is just for the two of you. The light coming through the windows is soft, tinted blue by the hour."

# game/rutas/nulla.rpy:3060
translate ingles continuacion_nulla2_f1880ace:

    # "Nulla entra primero, pero no se acomoda a tu lado de inmediato. Se sienta a una distancia prudente, procurando no invadir tu espacio."
    "Nulla steps in first but doesn't sit right next to you. He settles at a respectful distance, careful not to invade your space."

# game/rutas/nulla.rpy:3062
translate ingles continuacion_nulla2_3d8e0f60:

    # "Ni muy lejos, ni muy cerca."
    "Not too close, not too far."

# game/rutas/nulla.rpy:3063
translate ingles continuacion_nulla2_5b7bdca5:

    # nulla "La única vez que me subí a una de estas fue muy aburrido."
    nulla "The only time I ever got on one of these, it was really boring."

# game/rutas/nulla.rpy:3068
translate ingles continuacion_nulla2_c34ae295:

    # nulla "Sí..."
    nulla "Yeah..."

# game/rutas/nulla.rpy:3069
translate ingles continuacion_nulla2_02fffcbf:

    # nulla "Me obligaron."
    nulla "I was forced to."

# game/rutas/nulla.rpy:3070
translate ingles continuacion_nulla2_e40a5229:

    # "Su voz se apaga al final de la frase, no queriendo contar más."
    "His voice fades at the end of the sentence, unwilling to say more."

# game/rutas/nulla.rpy:3073
translate ingles continuacion_nulla2_dc957953:

    # nulla "Sí... ahora entiendo por qué."
    nulla "Yeah... now I understand why."

# game/rutas/nulla.rpy:3074
translate ingles continuacion_nulla2_b243481a:

    # nulla "Si la compañía es buena, la experiencia también."
    nulla "If the company's good, the experience is too."

# game/rutas/nulla.rpy:3075
translate ingles continuacion_nulla2_ffe998ac:

    # "Sus dedos se deslizan hacia los tuyos con naturalidad, rozando primero, tanteando, antes de entrelazarse."
    "His fingers slide toward yours naturally, brushing lightly, testing, before intertwining."

# game/rutas/nulla.rpy:3076
translate ingles continuacion_nulla2_62006804:

    # "El contacto te calma al instante."
    "The touch calms you instantly."

# game/rutas/nulla.rpy:3079
translate ingles continuacion_nulla2_d55276f3:

    # "El silencio se instala en la cabina."
    "Silence settles over the cabin."

# game/rutas/nulla.rpy:3080
translate ingles continuacion_nulla2_941ba3b4:

    # "A Nulla no parece afectarle."
    "Nulla doesn't seem bothered by it."

# game/rutas/nulla.rpy:3082
translate ingles continuacion_nulla2_93bff7cd:

    # "Sus ojos se desvían hacia la ventana. Tú haces lo mismo."
    "His eyes drift toward the window, and you follow his gaze."

# game/rutas/nulla.rpy:3083
translate ingles continuacion_nulla2_634a5227:

    # "La vista desde aquí arriba es preciosa. El sol ha terminado de esconderse y la noche comienza a caer."
    "The view from up here is beautiful. The sun has finally set, and night begins to fall."

# game/rutas/nulla.rpy:3084
translate ingles continuacion_nulla2_d848a589:

    # "Luces de la feria parpadean con intensidad decorando la feria con una gama de colores que se complementan, y la gente que camina como si siguiera un patrón predeterminado."
    "The fair's lights flicker below, decorating the scene in shifting colors that blend together, and the people move as if following a pre-determined pattern."

# game/rutas/nulla.rpy:3085
translate ingles continuacion_nulla2_59e747bf:

    # "Desde esta altura, las personas parecen hormigas. Y por un momento, te preguntas si Nulla siempre ha visto así al resto del mundo."
    "From this height, the people look like ants. And, for a moment, you wonder if Nulla has always seen the world this way."

# game/rutas/nulla.rpy:3086
translate ingles continuacion_nulla2_f790fb95:

    # "Cuando la cabina se detiene en el punto más alto, Nulla finalmente habla."
    "When the cabin stops at the very top, Nulla finally speaks."

# game/rutas/nulla.rpy:3087
translate ingles continuacion_nulla2_c258d8ab:

    # nulla "Si la gente que ya no está con nosotros tuviera una segunda oportunidad de volver..."
    nulla "If the people who are no longer with us had a second chance to return..."

# game/rutas/nulla.rpy:3088
translate ingles continuacion_nulla2_a5de566b:

    # nulla "¿Los traerías de vuelta?"
    nulla "... Would you bring them back?"

# game/rutas/nulla.rpy:3091
translate ingles continuacion_nulla2_a20cefa7_5:

    # "..."
    "..."

# game/rutas/nulla.rpy:3094
translate ingles continuacion_nulla2_a20cefa7_6:

    # "..."
    "..."

# game/rutas/nulla.rpy:3097
translate ingles continuacion_nulla2_a20cefa7_7:

    # "..."
    "..."

# game/rutas/nulla.rpy:3098
translate ingles continuacion_nulla2_85863a8e:

    # "Nulla medita tu respuesta por un largo rato. Un tiempo que para ti se hace eterno."
    "Nulla ponders your answer for a long while. Time stretches, feeling almost endless."

# game/rutas/nulla.rpy:3099
translate ingles continuacion_nulla2_c611a16e:

    # nulla "La extraño mucho..."
    nulla "I miss her... so much..."


# game/rutas/nulla.rpy:3100
translate ingles continuacion_nulla2_624e04ae:

    # nulla "Haría lo que fuera con tenerla de vuelta conmigo."
    nulla "I'd do anything to have her back with me."

# game/rutas/nulla.rpy:3101
translate ingles continuacion_nulla2_409f8636_1:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:3102
translate ingles continuacion_nulla2_1237f11c:

    # nulla "Antes venía aquí para poder verla otra vez."
    nulla "I used to come here just to see her again."

# game/rutas/nulla.rpy:3103
translate ingles continuacion_nulla2_1156498c:

    # nulla "Pero luego de un tiempo su recuerdo se deforma."
    nulla "But after a while, her memory started to warp."

# game/rutas/nulla.rpy:3104
translate ingles continuacion_nulla2_4f00c547:

    # nulla "Mientras más tiempo paso aquí, más se deforma todo."
    nulla "The longer I stay here, the more everything distorts."

# game/rutas/nulla.rpy:3105
translate ingles continuacion_nulla2_1915eb75:

    # nulla "Y más difícil se vuelve canalizarla."
    nulla "And the harder it becomes to channel her."

# game/rutas/nulla.rpy:3107
translate ingles continuacion_nulla2_aa85f4ef:

    # "Una sustancia negra comienza a rodear a Nulla por un instante."
    "A dark, viscous substance begins to surround Nulla for a moment."

# game/rutas/nulla.rpy:3109
translate ingles continuacion_nulla2_fd5e62fb:

    # "Pero cuando enfocas tus ojos, desaparece. Deben ser sus pensamientos negativos haciendo de las suyas..."
    "But when you focus your eyes, it vanishes. Must be his darker thoughts taking shape again..."

# game/rutas/nulla.rpy:3111
translate ingles continuacion_nulla2_84038624:

    # "El tiempo en la rueda de la fortuna llega a su fin cuando la cabina es suspendida en el suelo, y sus puertas se abren. Esperando a que salgan del lugar."
    "The Ferris wheel ride comes to an end as the cabin lowers and the doors open, waiting for you both to step out."

# game/rutas/nulla.rpy:3116
translate ingles continuacion_nulla2_a20cefa7_8:

    # "..."
    "..."

# game/rutas/nulla.rpy:3119
translate ingles continuacion_nulla2_367144f8:

    # nulla "Bueno..."
    nulla "Well..."

# game/rutas/nulla.rpy:3120
translate ingles continuacion_nulla2_796bdebc:

    # nulla "Si eso es lo que quieres..."
    nulla "If that's what you want..."

# game/rutas/nulla.rpy:3123
translate ingles continuacion_nulla2_707fc7b7:

    # nulla "Podemos ir a casa y descansar el resto del día."
    nulla "We can go home and rest for the rest of the day."

# game/rutas/nulla.rpy:3127
translate ingles continuacion_nulla2_c39f32a5:

    # nulla "Tú me alegras."
    nulla "You make me happy."

# game/rutas/nulla.rpy:3128
translate ingles continuacion_nulla2_fd7499f6:

    # "Rebate él, mordiendo una risa que no logra salir."
    "He replies, biting back a laugh that doesn't quite escape."

# game/rutas/nulla.rpy:3132
translate ingles continuacion_nulla2_3eb2b3fe:

    # "Salir de las memorias de Nulla fue distinto a cualquier experiencia anterior."
    "Leaving Nulla's memories was unlike any experience before."

# game/rutas/nulla.rpy:3133
translate ingles continuacion_nulla2_95484573:

    # "Si bien Nulla tomó tus manos, tu cuerpo no fue absorbido por el vacío. En cambio, fue expulsado con una fuerza desmedida, sin darte tiempo a reaccionar."
    "Though Nulla took your hands, your body wasn't absorbed by the Void this time. Instead, you were thrown out with violent force, leaving you no time to react."

# game/rutas/nulla.rpy:3134
translate ingles continuacion_nulla2_8af4e048:

    # "Y de un segundo a otro, ya no están dentro."
    "And in the blink of an eye, you're no longer inside."

# game/rutas/nulla.rpy:3136
translate ingles continuacion_nulla2_9b41c3c0:

    # "Ahora se encuentran en el mismo lugar, en la misma posición en que estaban antes de adentrarse en sus memorias."
    "You're both back in the exact position you were before entering his memories."

# game/rutas/nulla.rpy:3137
translate ingles continuacion_nulla2_fb371438:

    # "Miras a tu alrededor en busca de señales del paso del tiempo, pero nada en la casa de Nulla te lo confirma con certeza."
    "You look around for any sign that time has passed, but nothing in Nulla's house confirms it."

# game/rutas/nulla.rpy:3138
translate ingles continuacion_nulla2_a29e77cc:

    # "No hay relojes ni objetos que permitan medir el tiempo. Afuera, solo hay una negrura que envuelve toda la casa, y no tienes manera de contactar con nada ni con nadie fuera del dominio del Vacío."
    "There are no clocks, no objects that can measure time. Outside, there's only a vast darkness wrapping around the house--cutting you off completely from anything beyond the domain of the Void."

# game/rutas/nulla.rpy:3139
translate ingles continuacion_nulla2_018aebbc:

    # "La tetera aún soltando vapor, las frutas recién rebanadas en el plato que no se han secado, y el cuchillo a un lado... ese es el único conjunto de pistas que te sugiere que no ha pasado demasiado tiempo desde que comenzó la cita."
    "The teapot still steams, the sliced fruit on the plate hasn't dried, and the knife lies beside it... those are the only clues suggesting not much time has passed since the date began."

# game/rutas/nulla.rpy:3140
translate ingles continuacion_nulla2_10e7c03a:

    # "Te preguntas cómo Nulla medirá el tiempo..."
    "You wonder how Nulla measures time..."

# game/rutas/nulla.rpy:3142
translate ingles continuacion_nulla2_4793c596:

    # nulla "...Lo siento por el peluche."
    nulla "... Sorry about the plushie."

# game/rutas/nulla.rpy:3143
translate ingles continuacion_nulla2_6c4c9623:

    # "Dice Nulla, llamando tu atención."
    "Nulla says, catching your attention."

# game/rutas/nulla.rpy:3144
translate ingles continuacion_nulla2_e686439b:

    # "¿El peluche?... miras a tus manos y te das cuenta de lo que se refiere."
    "The plushie?... You glance at your hands and realize what he means."

# game/rutas/nulla.rpy:3145
translate ingles continuacion_nulla2_8e3ca084:

    # "Ya no lo tienes contigo."
    "It's no longer with you."

# game/rutas/nulla.rpy:3146
translate ingles continuacion_nulla2_bbc27640:

    # "Todo rastro de él ya no existe. No tienes nada tangible que te confirme que alguna vez ganaron un peluche en una feria."
    "There's no trace of it left, nothing tangible to prove that you ever won a plushie together at that fair."

# game/rutas/nulla.rpy:3147
translate ingles continuacion_nulla2_ef7b937f:

    # nulla "Todo lo que pasa dentro de las memorias, no significa nada fuera de estas."
    nulla "Everything that happens inside memories means nothing outside of them."

# game/rutas/nulla.rpy:3148
translate ingles continuacion_nulla2_43f78233:

    # nulla "Nada de lo que se origina dentro de ahí puede salir."
    nulla "Nothing born in there can cross over."

# game/rutas/nulla.rpy:3151
translate ingles continuacion_nulla2_5534dfed:

    # nulla "Si no fuera así, seria todo más fácil, jaja."
    nulla "If it weren't that way, everything would be much easier, jaja."

# game/rutas/nulla.rpy:3152
translate ingles continuacion_nulla2_6dd1712c:

    # "Su risa ligera no alcanza su expresión por completo. Si bien su boca está curvada en una sonrisa, sus ojos no transmiten alegría o gracia alguna."
    "His light laugh doesn't quite reach his expression. Though his lips form a smile, his eyes show no hint of joy or humor."

# game/rutas/nulla.rpy:3153
translate ingles continuacion_nulla2_9093ab2f:

    # nulla "Sacar cosas... o personas desde ahí. Estaría genial, ¿no?"
    nulla "Pulling things... or people from there... that would be great, wouldn't it?"

# game/rutas/nulla.rpy:3156
translate ingles continuacion_nulla2_ee4421c7:

    # nulla "Recuperar un objeto que solo está en tu memoria..."
    nulla "To recover something that only exists in your memory..."

# game/rutas/nulla.rpy:3161
translate ingles continuacion_nulla2_409f8636_2:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:3162
translate ingles continuacion_nulla2_8a9a3802:

    # nulla "Tienes razón."
    nulla "You're right."

# game/rutas/nulla.rpy:3165
translate ingles continuacion_nulla2_b0d57771:

    # nulla "Aunque igual me conformaría."
    nulla "Still... I'd settle for that."

# game/rutas/nulla.rpy:3166
translate ingles continuacion_nulla2_4a132a48:

    # nulla "¿Tú no?"
    nulla "Wouldn't you?"

# game/rutas/nulla.rpy:3171
translate ingles continuacion_nulla2_19bb13d7:

    # nulla "Awww."
    nulla "Awww."

# game/rutas/nulla.rpy:3172
translate ingles continuacion_nulla2_784f2a3b:

    # nulla "Entonces, si yo me llego a perder en algún momento, ¿No te conformarías con ninguna fea copia que no sea yo?"
    nulla "So, if I ever got lost... you wouldn't settle for some ugly copy that isn't really me?"

# game/rutas/nulla.rpy:3175
translate ingles continuacion_nulla2_905834c7:

    # nulla "Me siento halagado~~~"
    nulla "I'm flattered~~~"

# game/rutas/nulla.rpy:3180
translate ingles continuacion_nulla2_b5478886:

    # nulla "Somos tal para cual~~~"
    nulla "We're made for each other~~~"

# game/rutas/nulla.rpy:3181
translate ingles continuacion_nulla2_9c420cce:

    # nulla "Almas gemelas, mi vida."
    nulla "Soulmates, mi vida."

# game/rutas/nulla.rpy:3186
translate ingles continuacion_nulla2_75293d0e:

    # nulla "Así es."
    nulla "That's right."

# game/rutas/nulla.rpy:3187
translate ingles continuacion_nulla2_aab904c7:

    # nulla "Imagina todo lo que podrías traer de vuelta a la vida."
    nulla "Just imagine everything you could bring back to life."

# game/rutas/nulla.rpy:3188
translate ingles continuacion_nulla2_64051149:

    # nulla "Sería genial."
    nulla "It'd be amazing."

# game/rutas/nulla.rpy:3191
translate ingles continuacion_nulla2_32492388:

    # nulla "Bueno... de cualquier modo. No es bueno quedarse congelado en los recuerdos sin prestar atención al presente--"
    nulla "Well... either way, it's not good to stay frozen in memories and forget the present--"

# game/rutas/nulla.rpy:3192
translate ingles continuacion_nulla2_4dfde67b:

    # nulla "Y al futuro."
    nulla "--or the future."

# game/rutas/nulla.rpy:3193
translate ingles continuacion_nulla2_409f8636_3:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:3196
translate ingles continuacion_nulla2_e24ecc7e:

    # nulla "Mañana tendremos que volver al plan."
    nulla "Tomorrow, we'll have to get back to the plan."

# game/rutas/nulla.rpy:3197
translate ingles continuacion_nulla2_6234bf0a:

    # "Nulla se aparta un poco, como si te recordara que aquí puedes moverte libremente, sin restricciones."
    "Nulla steps back slightly, as if reminding you that here, you're free to move however you wish."

# game/rutas/nulla.rpy:3198
translate ingles continuacion_nulla2_9c9171ac:

    # "Pero antes de que puedas hacer algo más, notas cómo mete la mano en su bolsillo y saca la carta que una de sus sombras le entregó el día anterior..."
    "But before you can react, you notice him slip his hand into his pocket and pull out the letter one of his shadows gave him the day before..."


# game/rutas/nulla.rpy:3199
translate ingles continuacion_nulla2_5c79ff3b:

    # "Está abierta... lo que significa que ya la ha leído. O al menos la ha hojeado una vez."
    "It's already open... which means he's read it--or at least skimmed through it once."

# game/rutas/nulla.rpy:3202
translate ingles continuacion_nulla2_6c6d3419:

    # nulla "No quise leerla contigo."
    nulla "I didn't want to read it while you were here."

# game/rutas/nulla.rpy:3203
translate ingles continuacion_nulla2_a1bce748:

    # nulla "Habría sido como hablar de trabajo en medio de una cita."
    nulla "It would've been like talking about work in the middle of a date."

# game/rutas/nulla.rpy:3204
translate ingles continuacion_nulla2_c9108774:

    # nulla "Sería como un insulto para ti."
    nulla "That would've been disrespectful to you."

# game/rutas/nulla.rpy:3205
translate ingles continuacion_nulla2_35d0d654:

    # nulla "Así que quise esperar."
    nulla "So I decided to wait."

# game/rutas/nulla.rpy:3208
translate ingles continuacion_nulla2_a156c00c:

    # nulla "Pero ahora... creo que es un buen momento."
    nulla "But now... I think it's a good time."

# game/rutas/nulla.rpy:3211
translate ingles continuacion_nulla2_fc8ae533:

    # "Saca la carta del sobre con calma y se acerca, ofreciéndotela para que puedas ver lo que está escrito."
    "He carefully pulls the letter from the envelope and steps closer, offering it to you so you can see what's written."

# game/rutas/nulla.rpy:3212
translate ingles continuacion_nulla2_f495553d:

    # "Es un mensaje corto, escrito en una lengua que no logras entender. No hay necesidad de preguntar para que Nulla te la lea, pues él te ofrece una explicación al instante."
    "It's a short message, written in a language you can't understand. There's no need to ask for a translation: Nulla starts explaining right away."

# game/rutas/nulla.rpy:3213
translate ingles continuacion_nulla2_4ed53164:

    # nulla "Es de Sextam."
    nulla "It's from Sextam."

# game/rutas/nulla.rpy:3216
translate ingles continuacion_nulla2_082605dc:

    # nulla "Dice que vendrá mañana a almorzar."
    nulla "It says she'll come tomorrow for lunch."

# game/rutas/nulla.rpy:3217
translate ingles continuacion_nulla2_15802fab:

    # nulla "Y que trae el postre."
    nulla "And she's bringing dessert."

# game/rutas/nulla.rpy:3220
translate ingles continuacion_nulla2_3655a17a:

    # "Tienes un poco de miedo de preguntar por el postre... ¿Será un postre real o otra cosa que no puedes todavía asimilar?"
    "You're a little afraid to ask about the dessert... will it be something real, or something else you're not ready to comprehend?"

# game/rutas/nulla.rpy:3221
translate ingles continuacion_nulla2_932e7463:

    # "Necesitas un descanso."
    "You need a break."

# game/rutas/nulla.rpy:3222
translate ingles continuacion_nulla2_2001fe0d:

    # "Necesitas otro día antes de continuar apoyando a Nulla con su genocidio justificado."
    "You need another day before continuing to help Nulla with his so-called justified genocide."

# game/rutas/nulla.rpy:3223
translate ingles continuacion_nulla2_b76ced04:

    # "Nulla dobla la carta con cuidado y la hace desaparecer con un chasquido de sus dedos."
    "Nulla folds the letter neatly and makes it vanish with a snap of his fingers."

# game/rutas/nulla.rpy:3224
translate ingles continuacion_nulla2_6167b398:

    # nulla "No te preocupes. Creo que ya sé por dónde va esto."
    nulla "Don't worry. I think I know where this is heading."

# game/rutas/nulla.rpy:3225
translate ingles continuacion_nulla2_954919fb:

    # "Su tono de voz se escucha... extraño. Lo dice con una calma que te pone los pelos de punta. Con seguridad y hasta un toque de euforia controlada."
    "His tone sounds... strange. He speaks with a calm that chills you, confident, and laced with a controlled euphoria."

# game/rutas/nulla.rpy:3227
translate ingles continuacion_nulla2_9ceab4ea:

    # "En proceso de elaboración..."
    "In the making..."

# game/rutas/nulla.rpy:3228
translate ingles continuacion_nulla2_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2} You'll have to wait a little longer to find out how this ends... :3{/sc}"


