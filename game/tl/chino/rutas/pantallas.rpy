    # nulla "Es osobuco de vacuno."
    nulla "那是牛肉奥索布科。"

# game/rutas/pantallas.rpy:757
translate chino carne_e4c7075b:

    # nulla "No quiero alardear, pero es uno de los platos que más sabrosos me quedan."
    nulla "不是我想炫耀，但这确实是我做得最好吃的菜之一。"

# game/rutas/pantallas.rpy:758
translate chino carne_7a9713d4:

