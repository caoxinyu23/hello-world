    nulla "那是一个覆盆子芝士蛋糕。"

# game/rutas/pantallas.rpy:741
translate chino pastel_2d5ff562:

    # nulla "Es muy dulce y rico."
    nulla "它非常香甜可口。"

# game/rutas/pantallas.rpy:742
translate chino pastel_423fa429:

    # nulla "¿Quieres pedir eso?"
    nulla "你想点这个吗？"

# game/rutas/pantallas.rpy:745
