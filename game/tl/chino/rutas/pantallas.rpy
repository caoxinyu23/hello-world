    # septem "Sí..."
    septem "嗯……"

# game/rutas/pantallas.rpy:454
translate chino mejilla_db552fd1:

    # septem "Es el rostro de Rafael."
    septem "这是 Rafael 的脸。"

# game/rutas/pantallas.rpy:458
translate chino mejilla_31924e0f_1:

    # septem "..."
    septem "……"

# game/rutas/pantallas.rpy:459
translate chino mejilla_5a9787c2:

    # septem "Sí, después de todo es el rostro de Rafael."
    septem "是的……毕竟这是 Rafael 的脸。"

# game/rutas/pantallas.rpy:462
translate chino mejilla_25b168fa:

    # septem "{size=*0.7}...no mío.{/size}"
    septem "{size=*0.7}……不是我的。{/size}"

# game/rutas/pantallas.rpy:463
translate chino mejilla_31924e0f_2:

    # septem "..."
    septem "……"

# game/rutas/pantallas.rpy:464
translate chino mejilla_d06dc205:

    # septem "Olvídalo."
    septem "算了。"

# game/rutas/pantallas.rpy:465
translate chino mejilla_c7e4039d:

    # "Septem desvía su mirada, decepcionado."
    "Septem 失望地移开了目光。"

# game/rutas/pantallas.rpy:466
translate chino mejilla_d1c3676c:

    # "Te cuesta un poco comprender porqué se siente extraño, buscas y buscas en su interior pero Septem de alguna manera u otra no te permite entrar."
    "你难以理解他为何如此异样。你在他体内反复搜寻，可 Septem 就是不让你进去。"

# game/rutas/pantallas.rpy:467
translate chino mejilla_35290d67:

    # "Aunque no te rindes e intentas con más fuerza, y cuando sientes que por fin agarras su sentir para poder analizarlo, este se retuerce y escapa de tus manos."
    "你没有放弃，反而更加用力。就在你以为自己终于抓住他的感受、可以开始分析时，那感受却一扭转，从你手中溜走了。"

# game/rutas/pantallas.rpy:468
translate chino mejilla_e7794cc7:

    # "Pero esos segundos son más que suficientes para entender..."
    "但那短短几秒，已经足够你明白……"

# game/rutas/pantallas.rpy:469
translate chino mejilla_528850b0:

    # "Él no se siente completamente satisfecho con su cuerpo."
    "……他并不完全接受自己的身体。"

# game/rutas/pantallas.rpy:477
translate chino ala_ecae0f53:

    # "Pasas tus dedos por las plumas, lento y suave."
    "你的手指沿着羽毛缓缓、轻柔地抚过。"


# game/rutas/pantallas.rpy:478
translate chino ala_973d31af:

    # "Tocarlas tiene un efecto calmante en Septem. Las plumas que se ubican más lejos de la base son menos sensibles que las que están en la base."
    "触碰它们能让 Septem 平静下来。离根部远的羽毛比靠近根部的要迟钝一些。"

# game/rutas/pantallas.rpy:479
translate chino ala_d098a346:

    # "Cuando tus dedos tocan esas pequeñas plumas, Septem se retuerce, inquieto."
    "当你的手指拂过那些细小的羽毛时，Septem 不安地扭动起来。"

# game/rutas/pantallas.rpy:480
translate chino ala_cc052e53:

    # septem "...."
    septem "……"

# game/rutas/pantallas.rpy:482
translate chino ala_f94b0ac9:

    # septem "Lo estás disfrutando más de lo que pensé..."
    septem "你比我想象的更乐在其中……"

# game/rutas/pantallas.rpy:483
translate chino ala_9729cd83:

    # septem "Agradece que ahora mismo estoy cumpliendo mi palabra y estamos probando tus manos..."
    septem "你该感谢我说话算话，现在才让你测试双手……"

# game/rutas/pantallas.rpy:484
translate chino ala_96f05303:

    # septem "Si no fuera por eso, no tendrías el derecho de tocarme."
    septem "若不是这样，你根本没有资格碰我。"

# game/rutas/pantallas.rpy:485
translate chino ala_e583685f:

    # septem "Nadie lo tiene."
    septem "任何人都没有。"

# game/rutas/pantallas.rpy:491
translate chino stop_a8419c2b:

    # septem "¿Ya has terminado?"
    septem "够了吗？"

# game/rutas/pantallas.rpy:492
translate chino stop_18ad0b8e:

    # septem "No te voy a dar otra oportunidad de hacer esto."
    septem "我不会再给你第二次机会。"

# game/rutas/pantallas.rpy:495
translate chino stop_cd037468:

    # septem "Okay..."
    septem "好吧……"

# game/rutas/pantallas.rpy:509
translate chino interactuar2_4c4f09a5:

    # septem "Gracias..."
    septem "谢谢你……"

# game/rutas/pantallas.rpy:510
translate chino interactuar2_79ba41dc:

    # "Ambos salen al jardín."
    "你们两人走向花园。"

# game/rutas/pantallas.rpy:524
translate chino flor_c1526738:

    # septem "Estas flores son energía pura..."
    septem "这些花是纯粹的能量……"

# game/rutas/pantallas.rpy:525
translate chino flor_928005d0:

    # septem "Están conectadas a todo el Jardín. Se extienden debajo de la tierra y llegan a cada rincón."
    septem "它们与整座花园相连。它们在地下蔓延，延伸到每一个角落。"

# game/rutas/pantallas.rpy:526
translate chino flor_0cd68b9e:

    # septem "Con ellas siento y así puede percatarme de que hay que arreglar y que es lo que no tiene arreglo."
    septem "通过它们，我能感知什么可以修复，什么无法修复。"

# game/rutas/pantallas.rpy:531
translate chino flor_e87c5670:

    # septem "No."
    septem "不。"

# game/rutas/pantallas.rpy:532
translate chino flor_f7c600ec:

    # septem "No soy una entidad destructiva."
    septem "我不是破坏性的存在。"

# game/rutas/pantallas.rpy:533
translate chino flor_a10bc3c6:

    # "Sus palabras hacen un cosquilleo en tu estómago... o tal vez es su estómago. Recuerdas lo fácil que fue para Septem hacerte daño físico a ti o a Nulla."
    "他的话让你胃里一阵发紧……或许那是他的感觉。你想起 Septem 曾经多么轻易就能伤害你，还有 Nulla。"

# game/rutas/pantallas.rpy:534
translate chino flor_816f7713:

    # septem "Perdona. Dejame planterarlo de nuevo."
    septem "请原谅。我换个说法。"

# game/rutas/pantallas.rpy:535
translate chino flor_370f1788:

    # septem "No puedo dañar a nada proveniente del Jardín."
    septem "我无法伤害任何诞生于花园的东西。"

# game/rutas/pantallas.rpy:540
translate chino flor_a77e302d:

    # "Ahora tiene otro rango después de todo..."
    "毕竟，他现在的地位不同了……"

# game/rutas/pantallas.rpy:542
translate chino flor_6a20d1c2:

    # "Septem medita por un minuto... y la curiosidad entra como una rata. Escurridiza y quisquillosa logra posarse en su cabeza..."
    "Septem 沉默了片刻……好奇心像一只鬼鬼祟祟又执拗的老鼠，钻进了他的脑海……"

# game/rutas/pantallas.rpy:543
translate chino flor_e5d06fc5:

    # "Septem toma la flor por el tallo y tira de ella, esperando a que nada suceda."
    "Septem 抓住花茎一拉，本以为什么都不会发生。"

# game/rutas/pantallas.rpy:545
translate chino flor_5f9b772e:

    # "...."
    "……"

# game/rutas/pantallas.rpy:546
translate chino flor_52a6644f:

    # "¡¡¡!!!"
    "！！！"

# game/rutas/pantallas.rpy:547
translate chino flor_5ba6d0c0:

    # "La acaba de romper. La flor comienza a "
    "他竟然折断了它。那朵花开始——"

# game/rutas/pantallas.rpy:551
translate chino flor_0fb69b6a:

    # "Septem mira con horror la zona donde estaba la flor."
    "Septem 惊恐地盯着那朵花原本所在的地方。"

# game/rutas/pantallas.rpy:552
translate chino flor_81cda30f:

    # "Más no comenta palabra alguna."
    "但他一言不发。"

# game/rutas/pantallas.rpy:556
translate chino flor_278c7e29:

    # "........."
    "…………"

# game/rutas/pantallas.rpy:562
translate chino pez_31924e0f:

    # septem "..."
    septem "……"

# game/rutas/pantallas.rpy:563
translate chino pez_06925d42:

    # "Septem mira los peces en silencio."
    "Septem 静静地看着那些鱼。"

# game/rutas/pantallas.rpy:564
translate chino pez_4bd31a71:

    # septem "Me gustaría tener más cosas en mi jardín..."
    septem "我希望我的花园里能有更多东西……"

# game/rutas/pantallas.rpy:565
translate chino pez_22c82db2:

    # septem "Entidades vivas... no simplemente energía."
    septem "活着的生灵……不只是能量。"

# game/rutas/pantallas.rpy:566
translate chino pez_29f30d2b:

    # "No comenta nada después de eso. Ambos observan las pequeñas figuras de energía en silencio."
    "此后他再没说什么。你们两人默默望着那些小小的能量身影。"

# game/rutas/pantallas.rpy:572
translate chino place_31924e0f:

    # septem "..."
    septem "……"

# game/rutas/pantallas.rpy:573
translate chino place_8145a900:

    # septem "En otra ocasión iremos allá."
    septem "我们改天再去那里。"

# game/rutas/pantallas.rpy:574
translate chino place_dfd35f84:

    # septem "Hoy no..."
    septem "今天不去了……"

# game/rutas/pantallas.rpy:575
translate chino place_25d78c10:

    # septem "No quiero ir allá hoy..."
    septem "我今天不想去那里……"

# game/rutas/pantallas.rpy:581
translate chino cuerpo_adc11a4a:

    # "Septem toma aire, soltando todo el estrés acumulado."
    "Septem 深吸一口气，释放了一直紧绷着的所有压力。"

# game/rutas/pantallas.rpy:582
translate chino cuerpo_626b6814:

    # septem "Ya me encuentro mejor"
    septem "我现在感觉好多了。"

# game/rutas/pantallas.rpy:583
translate chino cuerpo_41d7164e:

    # septem "¿Quieres volver al templo?"
    septem "你想回神殿吗？"


# game/rutas/pantallas.rpy:586
translate chino cuerpo_cd037468:

    # septem "Okay..."
    septem "好……"

# game/rutas/pantallas.rpy:597
translate chino interactuar3_05312b73:

    # "Septem junta ambas manos y recita unas palabras en latín."
    "Septem 双手合十，用拉丁文念了几句。"

# game/rutas/pantallas.rpy:599
translate chino interactuar3_43a7f616:

    # "Al terminas su cántico ambos se transportan a un lugar puro, manchado solamente por ustedes dos."
    "他的吟唱结束时，你们两人被带到一处纯净之地，唯有你们的存在使其染上污痕。"

# game/rutas/pantallas.rpy:600
translate chino interactuar3_265dc507:

    # septem "Venir aquí siempre me calma."
    septem "来这里总能让我平静下来。"

# game/rutas/pantallas.rpy:601
translate chino interactuar3_0bc6d2a4:

    # "Dice al aire, no esperando a obtener una respuesta tuya, Septem hace una señal con las manos."
    "他对着空气说道，并不期待回应。接着，Septem 用手做了一个示意。"

# game/rutas/pantallas.rpy:602
translate chino interactuar3_4baf1bd2:

    # "Una esfera del tamaño de una pelota comienzan a emerger del suelo, levitando hasta estar al frente de tu campo de visión."
    "一颗球大小的球体从地面升起，悬浮着，直到停在你眼前。"

# game/rutas/pantallas.rpy:603
translate chino interactuar3_82e04db9:

    # "A esa se le suman dos, luego tres. Hasta tener 8 esferas rodeando tu espacio y el de Septem."
    "然后一颗又一颗接连出现，直到八颗球体环绕着你与 Septem 共有的空间。"

# game/rutas/pantallas.rpy:604
translate chino interactuar3_6f6195f8:

    # septem "Puedes tocarlas si deseas."
    septem "你若愿意，可以触碰它们。"

# game/rutas/pantallas.rpy:615
translate chino sol_a726d244:

    # septem "Ese es el dominio del Sol, Unum ahora mismo está en la residencia de sus 'esposas'."
    septem "那是太阳的领域。Unum 此刻正待在他“妻子们”的住所。"

# game/rutas/pantallas.rpy:616
translate chino sol_252914d7:

    # "Septem apunta a la estrella de ocho puntas de color rojo, la cual está al lado de tres estrellas más pequeñas."
    "Septem 指向那颗红色的八芒星，它旁边还有三颗更小的星。"

# game/rutas/pantallas.rpy:617
translate chino sol_32b8840f:

    # septem "El resto---"
    septem "其余的——"

# game/rutas/pantallas.rpy:618
translate chino sol_fbffe205:

    # "Septem mueve su dedo a las otras estrellas que se reparten en el resto de la esfera, son un montón."
    "Septem 的手指移向散布在球体其余部分的其他星辰。有很多。"

# game/rutas/pantallas.rpy:619
translate chino sol_eafeb89c:

    # septem "Son sus súbditos."
    septem "它们是他的臣民。"

# game/rutas/pantallas.rpy:625
translate chino estrella_0196bb8c:

    # septem "Aquí reside Duae..."
    septem "Duae 居住在这里……"

# game/rutas/pantallas.rpy:626
translate chino estrella_0f7c3ab4:

    # septem "Siempre está trabajando, entrenando a sus estrellas."
    septem "她总是在忙碌，训练着她的星辰。"

# game/rutas/pantallas.rpy:627
translate chino estrella_e6b3c6b1:

    # septem "Ahí está ella."
    septem "她就在那儿。"

# game/rutas/pantallas.rpy:628
translate chino estrella_8d2b6878:

    # "Septem guia tu mano con la suya, en búsqueda de Duae. Te das cuenta de que ella es la estrella de ocho puntas más grande de la zona."
    "Septem 用自己的手引着你的手，带你去往 Duae。你这才意识到，她就是这片区域里最大的那颗八芒星。"

# game/rutas/pantallas.rpy:629
translate chino estrella_605fd595:

    # septem "Es uno de los pocos dominios que aún no presenta problemas."
    septem "这是少数几个尚未出现任何麻烦迹象的领域之一。"

# game/rutas/pantallas.rpy:630
translate chino estrella_0f47939e:

    # septem "Y todo el mérito lo tiene ella."
    septem "这全都归功于她。"

# game/rutas/pantallas.rpy:636
translate chino luna_b19ee29a:

    # septem "Este es Quattor..."
    septem "这颗是 Quattor……"

# game/rutas/pantallas.rpy:637
translate chino luna_955e3284:

    # septem "Es uno de los dominios más bellos."
    septem "这是最美丽的领域之一。"

# game/rutas/pantallas.rpy:643
translate chino planta_a56650ae:

    # septem "Es un dominio muerto."
    septem "这是一个死去的领域。"

# game/rutas/pantallas.rpy:644
translate chino planta_35c0248a:

    # septem "No queda mucho de él.."
    septem "它已经所剩无几……"

# game/rutas/pantallas.rpy:645
translate chino planta_88cc6d90:

    # septem "Y Tria no puede hacer nada hasta que el Jardín mejore."
    septem "在花园痊愈之前，Tria 什么也做不了。"

# game/rutas/pantallas.rpy:646
translate chino planta_c526478d:

    # septem "Hemos hablado, y luego de mucho buscar, Tria asumió que la maldición es autoimpuesta."
    septem "我们谈过了，在反复探查之后，Tria 得出结论：这诅咒是她自己施加的。"

# game/rutas/pantallas.rpy:647
translate chino planta_1daf35bf:

    # septem "La maldición seguirá hasta que ella sane."
    septem "诅咒会一直存在，直到她痊愈。"

# game/rutas/pantallas.rpy:651
translate chino planta_e83233af:

    # "Septem te observa en silencio antes de contestar."
    "Septem 沉默地看了你一会儿，才开口回答。"

# game/rutas/pantallas.rpy:652
translate chino planta_7ed130df:

    # septem "Todo fruto producido en el Jardín contiene un veneno y le pertenece a Tria."
    septem "花园里结出的每一枚果实都带有剧毒，且属于 Tria。"

# game/rutas/pantallas.rpy:653
translate chino planta_e7b702c1:

    # septem "No pueden ser comidos a menos que rompas su sello."
    septem "不解除封印就不能食用。"

# game/rutas/pantallas.rpy:654
translate chino planta_a20cefa7:

    # "..."
    "……"

# game/rutas/pantallas.rpy:655
translate chino planta_69f73bf9:

    # "Sientes un poco de pena por la situación. Supones que ella no puede controlar su pena o rabia, entonces su estado emocional afecta a su dominio de esta manera."
    "你为她的处境感到些许难过。你想是她无法控制自己的悲痛与愤怒，于是她的情绪状态把自己的领域塑造成了这样。"

# game/rutas/pantallas.rpy:656
translate chino planta_709fa0cd:

    # "Que complicado. Ahora ves que el Jardín no tiene un solo problema."
    "真是复杂。现在你明白了，花园的问题不只有一个。"

# game/rutas/pantallas.rpy:657
translate chino planta_0b7fb937:

    # "Sino que es un cúmulo de cosas que se entrelazan y afectan tanto a nivel micro como macro."
    "相反，它是一张由许多事物交织而成的网——彼此缠绕，从最细微到最宏大的层面影响着一切。"

# game/rutas/pantallas.rpy:658
translate chino planta_bd97b024:

    # "El Jardín es como si de un cuerpo enfermo se tratase, del cual sus partes vitales hacen lo que pueden para mantenerlo con vida... agonizando."
    "花园就像一具病躯，它的要害部位竭尽全力维持着生命……勉力支撑。"

# game/rutas/pantallas.rpy:659
translate chino planta_cd03b3e7:

    # "Pero esa defensa no es suficiente. Necesitan ayuda de un agente externo."
    "但那样的防御还不够。花园需要来自外部的帮助。"

# game/rutas/pantallas.rpy:660
translate chino planta_7301c83a:

    # "Una medicina, una píldora que les de lo justo y necesario para volver a retomar sus funciones."
    "一剂药：一颗能给予它所需、让它重新运转起来的药丸。"

# game/rutas/pantallas.rpy:665
translate chino animales_e7e8987a:

    # "En esta esfera, hay dos estrellas de ocho puntas."
    "这颗球体里有两颗八芒星。"

# game/rutas/pantallas.rpy:666
translate chino animales_f4874508:

    # septem "A Quinque le hace falta ayuda... por eso Tria pasa la mayor parte del tiempo ahí."
    septem "Quinque 需要帮助……所以 Tria 把大部分时间都花在那里。"

# game/rutas/pantallas.rpy:667
translate chino animales_3d3db5f4:

    # septem "Cada vez que vengo, lo veo sanando a algún animal."
    septem "我每次来，都看见他在治疗某种动物。"

# game/rutas/pantallas.rpy:668
translate chino animales_a1d62cf5:

    # septem "La maldición de Tria no se detendrá."
    septem "Tria 的诅咒不会停止。"

# game/rutas/pantallas.rpy:673
translate chino humanos_31924e0f:

    # septem "..."
    septem "……"

# game/rutas/pantallas.rpy:674
translate chino humanos_8235e8a2:

    # "Hay solo una estrella en esta esfera..."
    "这颗球体里只有一颗星……"

# game/rutas/pantallas.rpy:675
translate chino humanos_fd19acb3:

    # "No brilla tanto como las demás, y tiene un pulso lento."
    "它没有其他星辰那样明亮，脉动也很缓慢。"

# game/rutas/pantallas.rpy:676
translate chino humanos_cc2dee24:

    # "Se ve fatal."
    "它看起来糟透了。"

# game/rutas/pantallas.rpy:677
translate chino humanos_44946446:

    # "Y Septem no dice nada, solo la mira en silencio. Con una expresión que parece querer romperse en pedazos."
    "而 Septem 什么也没说……只是沉默地盯着它，神情仿佛随时会崩裂。"

# game/rutas/pantallas.rpy:678
translate chino humanos_6f5847c4:

    # "Es pena."
    "是悲伤。"

# game/rutas/pantallas.rpy:685
translate chino septimo_e4453a77:

    # "Este es el dominio de Septem, si te fijas bien, no hay rastro alguno de súbditos."
    "这是 Septem 的领域。若你仔细看，这里没有任何臣民的痕迹。"

# game/rutas/pantallas.rpy:686
translate chino septimo_1fcbd51c:

    # "Solamente tu alma y la de Septem se encuentran dentro del dominio."
    "在这个空间里，只存在你的灵魂和 Septem 的灵魂。"

# game/rutas/pantallas.rpy:687
translate chino septimo_3215caae:

    # septem "Estos somos nosotros."
    septem "这就是我们。"

# game/rutas/pantallas.rpy:690
translate chino septimo_e69ae9d7:

    # septem "No es un súbdito."
    septem "他不是臣民。"

# game/rutas/pantallas.rpy:691
translate chino septimo_5602598f:

    # septem "Según el mapa el no existe."
    septem "按地图来看，他并不存在。"

# game/rutas/pantallas.rpy:692
translate chino septimo_44738ce9:

    # septem "Según las reglas... el no debería existir aquí."
    septem "按规则来说……他不该存在在这里。"

# game/rutas/pantallas.rpy:693
translate chino septimo_1b32da4c:

    # "Septem suspira, agotado."
    "Septem 疲惫地叹了口气。"

# game/rutas/pantallas.rpy:694
translate chino septimo_1a5bafe4:

    # septem "¿Creo que ya es suficiente, quieres volver?"
    septem "我觉得这样就够了……你想回去吗？"

# game/rutas/pantallas.rpy:697
translate chino septimo_cd037468:

    # septem "Okay..."
    septem "好……"

# game/rutas/pantallas.rpy:704
translate chino vacio_0a782ae4:

    # "Es momento de parar. Pero..."
    "该停下了。但是……"

# game/rutas/pantallas.rpy:705
translate chino vacio_e2333b05:

    # "No puedes evitar darte cuenta del negro voraz que sostiene las esferas."
    "你忍不住注意到，托住这些球体的那片贪婪的漆黑。"

# game/rutas/pantallas.rpy:706
translate chino vacio_6ab37535:

    # "Cuando posas tu mano encima de ella, la energía que transmite es abismal."
    "当你把手覆上去时，它散发的能量深不见底。"


# game/rutas/pantallas.rpy:707
translate chino vacio_addb8ce8:

    # "Te llama a meter tu mano dentro, te susurra palabras que sin aun reconocer el idioma, entiendes a la perfección lo que te dicen..."
    "它呼唤你把手掌探进去，低语着那些话——即便你认不出那种语言，却完全明白它在说什么……"

# game/rutas/pantallas.rpy:708
translate chino vacio_155c052c:

    # "Entra... Entra... Entra..."
    "进来……进来……进来……"

# game/rutas/pantallas.rpy:709
translate chino vacio_7b4bbe7e:

    # septem "Bien, eso es todo por hoy."
    septem "好了，今天就到这里。"

# game/rutas/pantallas.rpy:712
translate chino vacio_d86685c6:

    # "Le dices que quieres seguir viendo los dominios."
    "你告诉他，你想继续看看这些领域。"

# game/rutas/pantallas.rpy:713
translate chino vacio_e6340169:

    # "Y septem te deja."
    "Septem 便允许了你。"

# game/rutas/pantallas.rpy:726
translate chino interactuar5_a20cefa7:

    # "..."
    "……"

# game/rutas/pantallas.rpy:727
translate chino interactuar5_d4978928:

    # "No eres capaz de leer nada de lo que dice debajo de las imágenes."
    "你读不懂图片下方写着的任何内容。"

# game/rutas/pantallas.rpy:728
translate chino interactuar5_57dfbd4d:

    # nulla "No te procupes cariño, yo te ayudaré <3"
    nulla "别担心，cariño，我来帮你。<3"

# game/rutas/pantallas.rpy:729
translate chino interactuar5_9e8ab96a:

    # nulla "Pincha lo que quieras y yo te diré que trae cada cosa."
    nulla "随便点你想点的，我告诉你那是什么。"

