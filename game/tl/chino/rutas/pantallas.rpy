    "所以你趁 Septem 禁止之前，轻轻抚摸他的眼睛。"

# game/rutas/pantallas.rpy:403
translate chino ojo_204a0e37:

    # septem "Oye..."
    septem "喂……"

# game/rutas/pantallas.rpy:404
translate chino ojo_73461e0d:

