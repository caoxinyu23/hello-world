    nulla "好！"

# game/rutas/pantallas.rpy:749
translate chino pastel_d7f3b5ef:

    # nulla "Aja ja~~ Creo que te voy a copiar."
    nulla "啊哈哈~~ 我觉得我也来一份一样的。"

# game/rutas/pantallas.rpy:750
translate chino pastel_271aadc1:

    # nulla "Se me antoja algo dulce."
    nulla "我想吃点甜的。"

# game/rutas/pantallas.rpy:755
translate chino carne_eedaf02d:

    # nulla "Eso se ve rico."
    nulla "那个看起来好好吃。"

# game/rutas/pantallas.rpy:756
