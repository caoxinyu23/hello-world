    # musae "No voy a perder mi tiempo con alguien así."
    musae "我不会在这种人身上浪费时间。"

# game/rutas/pantallas.rpy:1619
translate chino musae_cita_fa973e69:

    # musae "<333333"
    musae "<333333"


