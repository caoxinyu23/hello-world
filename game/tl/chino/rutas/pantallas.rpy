# game/rutas/pantallas.rpy:1542
translate chino clave_81bcac6a:

    # creador "Tengo que agradecerle a Cinco cuando la vea---"
    creador "等见到 Cinco，我一定要谢谢她——"

# game/rutas/pantallas.rpy:1545
translate chino clave_66d2e24f:

    # creador "Bueno..."
    creador "好吧……"

# game/rutas/pantallas.rpy:1546
translate chino clave_a1e995df:

