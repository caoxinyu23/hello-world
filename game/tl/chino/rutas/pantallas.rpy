# game/rutas/pantallas.rpy:794
translate chino salmon_937eaa8d:

    # nulla "Ahhh, salmón ahumado."
    nulla "啊，烟熏三文鱼。"

# game/rutas/pantallas.rpy:795
translate chino salmon_45609441:

    # nulla "Es rico--- le copié la receta a Rafael una vez y jamás la solté."
    nulla "好吃得很——我偷过 Rafael 的配方，之后就一直据为己有了。"

# game/rutas/pantallas.rpy:796
translate chino salmon_3e67eabf:

    # nulla "Haha..."
    nulla "哈哈……"

# game/rutas/pantallas.rpy:797
