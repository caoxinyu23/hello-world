    new "输入它的名字："

    # game/rutas/pantallas.rpy:1588
    old "Volver a intentar"
    new "重试"

    # game/rutas/pantallas.rpy:1588
    old "Rendirse"
    new "放弃"

    # game/rutas/pantallas.rpy:1610
    old "Ew..."
    new "呃……"

    # game/rutas/pantallas.rpy:1610
    old "Gracias <3 ~"
    new "谢谢你 <3 ~"
