# game/rutas/pantallas.rpy:1540
translate chino clave_cc0aa2a0:

    # creador "Es un diseño que mi querida Cinco ha realizado."
    creador "这是我亲爱的 Cinco 设计的造型。"

# game/rutas/pantallas.rpy:1541
translate chino clave_bcb4a6e1:

    # creador "..."
