    # nulla "¡Okay!"
    nulla "好！"

# game/rutas/pantallas.rpy:766
translate chino carne_41ec9247:

    # nulla "Okay..."
    nulla "好吧……"

# game/rutas/pantallas.rpy:767
translate chino carne_30d2edf9:

    # nulla "Para mí, se me antoja algo dulce."
    nulla "至于我，我想吃点甜的。"

# game/rutas/pantallas.rpy:768
translate chino carne_156fcbcb:

    # nulla "Voy a pedir el cheesecake."
    nulla "我点芝士蛋糕。"

# game/rutas/pantallas.rpy:774
translate chino pasta_a786ffa3:

    # nulla "Mmmm~"
    nulla "嗯嗯~"

# game/rutas/pantallas.rpy:775
translate chino pasta_fe54679a:

    # nulla "Pasta boloñesa."
    nulla "博洛尼亚肉酱面。"

# game/rutas/pantallas.rpy:776
translate chino pasta_c3b3cd5c:

    # nulla "Tiene carne picada, cebolla, ajo, tomate y un poco de vino."
    nulla "它有碎肉、洋葱、大蒜、番茄，还有一点葡萄酒。"

# game/rutas/pantallas.rpy:777
translate chino pasta_1caebc6d:

    # nulla "Es una de mis comidas reconfortantes..."
    nulla "这是我的疗愈食物之一……"

# game/rutas/pantallas.rpy:778
translate chino pasta_0d8072c2:

    # nulla "rica y fácil de hacer."
    nulla "好吃又容易做。"

# game/rutas/pantallas.rpy:779
