    # nulla "Tómalo como una pequeña jugarreta, ahora quedamos a mano y no tienes más opción que quedarte conmigo."
    nulla "就当是个小小的恶作剧，现在我们扯平了，而你除了留在我身边也别无选择。"

# game/rutas/nulla.rpy:738
translate chino null_d991e8f4:

    # nulla "Así es..."
    nulla "正是如此……"

# game/rutas/nulla.rpy:742
translate chino null_9bca7c1a:

    # nulla "Hmmm no :)"
    nulla "嗯——不行 :)"

# game/rutas/nulla.rpy:743
translate chino null_c57744e4:

    # nulla "A menos que yo quiera, y ahora no tengo ganas de dejarte ir."
    nulla "除非我愿意，而我现在可没打算放你走。"

# game/rutas/nulla.rpy:747
translate chino null_5f6c9f44:

    # nulla "Mmmm."
    nulla "嗯嗯。"

# game/rutas/nulla.rpy:748
translate chino null_bb684744:

    # nulla "Aunque no podremos acceder al jardín, ya que Madre me eliminará si sigo jugando con el mundo..."
    nulla "虽然我们再也无法进入花园了——要是我再继续玩弄这个世界，母亲会把我抹除……"

# game/rutas/nulla.rpy:749
translate chino null_94593c63:

    # nulla "Tendremos que trabajar con mi memoria..."
    nulla "我们就只能靠我的记忆来想办法了……"

# game/rutas/nulla.rpy:752
translate chino null_599eed85:

    # nulla "No es por alardear pero"
    nulla "倒不是我在吹嘘，"

# game/rutas/nulla.rpy:753
translate chino null_ca52cb04:

    # nulla "Conozco muchos lugares y muchos mundos."
    nulla "但我知道很多地方，也去过很多世界。"

# game/rutas/nulla.rpy:754
translate chino null_add38350:

    # nulla "Vamos a una ciudad normal, ya estoy aburrido de ver tantas figuras con la cara tapada."
    nulla "我们去座正常的城市吧，我已经看腻了这些蒙着脸的人影。"

# game/rutas/nulla.rpy:756
translate chino null_5db50600:

    # "Nulla te agarra la mano y te sonrie de medio lado."
    "Nulla 抓住你的手，微微侧过头冲你一笑。"

# game/rutas/nulla.rpy:758
translate chino null_865f35cd:

    # "Y ambos se hunden en el vacío."
    "随即两人一同沉入虚空。"

# game/rutas/nulla.rpy:759
translate chino null_1eee34af:

    # nulla "Iremos a un parque... creo que esa zona es la más segura..."
    nulla "我们去公园吧……我想那片区域是最安全的……"

# game/rutas/nulla.rpy:760
translate chino null_4613c331:

    # "¿Segura? ¿a qué se refiere con eso?... Eso significa que, ¿habrá zonas que no son seguras?"
    "安全？他指的是什么？……难道说，还存在不安全的区域？"

# game/rutas/nulla.rpy:761
translate chino null_7bf90c93:

    # nulla "No te separes de mí."
    nulla "别离开我身边。"

# game/rutas/nulla.rpy:762
translate chino null_a20cefa7:

    # "..."
    "……"

# game/rutas/nulla.rpy:763
translate chino null_50fdd4c8:

    # nulla "Si ves algo diferente en mi apariencia, no te asustes. Por favor..."
    nulla "如果我的外貌有些不同，别害怕。拜托……"

# game/rutas/nulla.rpy:764
translate chino null_5051dfa9:

    # "Tus pies tocan el suelo y el vacío comienza a desaparecer."
    "你的双脚触到地面，虚空开始消散。"

# game/rutas/nulla.rpy:767
translate chino null_146f5996:

    # "Miras a tu alrededor y el lugar no se encuentra tan concurrido como esperabas."
    "你环顾四周，发现这里并没有你想象中那么拥挤。"

# game/rutas/nulla.rpy:768
translate chino null_f789fc21:

    # nulla "Este era mi lugar preferido."
    nulla "这里曾是我最喜欢的地方。"

# game/rutas/nulla.rpy:771
translate chino null_409f8636:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:774
translate chino null_fd7301b0:

    # nulla "Lo era."
    nulla "曾经是。"

# game/rutas/nulla.rpy:777
translate chino null_938537ab:

    # "Ha perdido color..."
    "它已经失去了色彩……"

# game/rutas/nulla.rpy:778
translate chino null_9b402e38:

    # "Nulla te mira por un momento antes de contestar. Supones que debe estar esperando algún comentario tuyo acerca de su apariencia."
    "Nulla 看了你一会儿才作答。你猜想他一定是在等你对他的外貌发表些评论。"

# game/rutas/nulla.rpy:779
translate chino null_a940b8ae:

    # nulla "...Aquí venía luego de que acabaran las clases."
    nulla "……下课之后我常来这里。"

# game/rutas/nulla.rpy:782
translate chino null_5e382d52:

    # "¿Clases? sinceramente te cuesta un poco imaginar a Nulla joven... mucho más teniendo una rutina tan normal como ir a clases."
    "上课？说实话，你有点难以想象年少时的 Nulla……更别提他还有上课这样正常的日常。"

# game/rutas/nulla.rpy:783
translate chino null_7117f94c:

    # "Momento... esto no tiene nada que ver con el jardín."
    "等等……这和花园毫无关系。"

# game/rutas/nulla.rpy:784
translate chino null_4955c435:

    # "Será..."
    "也许……"

# game/rutas/nulla.rpy:787
translate chino null_cbddfa47:

    # nulla "Uhg."
    nulla "呃……"

# game/rutas/nulla.rpy:788
translate chino null_aacca300:

    # nulla "Odio que la marioneta te da ideas..."
    nulla "我讨厌那个傀儡给你出主意……"

# game/rutas/nulla.rpy:791
translate chino null_4cf02642:

    # nulla "Efectivamente, en mi primera vida yo era un estudiante, inocente y tonto..."
    nulla "的确，在我的第一段人生里，我是个学生，天真又愚蠢……"

# game/rutas/nulla.rpy:792
translate chino null_05106778:

    # nulla "Sin idea de nada."
    nulla "什么也不知道。"

# game/rutas/nulla.rpy:795
translate chino null_151309c6:

    # nulla "uhg."
    nulla "呃……"

# game/rutas/nulla.rpy:796
translate chino null_77c482fd:

    # nulla "Agradece que estoy controlando mi forma para no volver a lo que era antes."
    nulla "你得感谢我正控制着自己的形态，才没有变回从前那副样子。"

# game/rutas/nulla.rpy:797
translate chino null_5af5691d:

    # nulla "Horrible, ¡mi cabello era horrible!"
    nulla "太可怕了，我的头发简直糟透了！"

# game/rutas/nulla.rpy:798
translate chino null_5e16c1eb:

    # "Necesitas ver eso."
    "你需要看看那个。"

# game/rutas/nulla.rpy:801
translate chino null_39210df5:

    # nulla "No... no necesitas ver eso."
    nulla "不……你不需要看那个。"

# game/rutas/nulla.rpy:803
translate chino null_8f11e60f:

    # "Nulla comienza a caminar y te toma de la mano para que lo sigas."
    "Nulla 开始往前走，牵起你的手带你跟上。"

# game/rutas/nulla.rpy:804
translate chino null_f11952f7:

    # "Mientras ambos caminan, sientes como una presencia les sigue, pero cada vez que volteas no ves nada..."
    "你们两人一边走，你一边感觉到有什么东西在跟着，可每次回头都什么也没看见……"

# game/rutas/nulla.rpy:806
translate chino null_b51d46b7:

    # nulla "Lo bueno de este lugar es que, es solo un concepto. Al no tener ningún escrito especifico...Es decir, alguna historia de mi antiguo yo en este periodo."
    nulla "这个地方的好处在于，它只是一个概念。因为没有留下任何具体的文字……也就是说，没有我前生在这段时期的任何故事。"

# game/rutas/nulla.rpy:807
translate chino null_3c286628:

    # nulla "Puedo moldearla a mi antojo."
    nulla "我可以随我心意塑造它。"

# game/rutas/nulla.rpy:808
translate chino null_88c39df0:

    # nulla "Por eso es una de las zonas seguras."
    nulla "所以这里是少数安全的地方之一。"

# game/rutas/nulla.rpy:809
translate chino null_aa99a9bc:

    # nulla "El resto de los lugares, no."
    nulla "其余的地方就不行了。"

# game/rutas/nulla.rpy:811
translate chino null_33eb3898:

    # nulla "Por lo que me disculpo si este lugar no es de tu agrado o resulta aburrido."
    nulla "所以，如果这个地方不合你意，或者让你觉得无聊，我先跟你道歉。"

# game/rutas/nulla.rpy:812
translate chino null_05aeaa0a:

    # nulla "Pues si, el lugar es aburrido pero.... contigo a mi lado,"
    nulla "嗯，这地方确实无聊，可是……有你在身边，"

# game/rutas/nulla.rpy:813
translate chino null_9c580121:

    # nulla "No lo es."
    nulla "并不无聊。"

# game/rutas/nulla.rpy:814
translate chino null_df538503:

    # "Camina por todo el parque, y Nulla te habla de quien sabe que cosa pues no te puedes concentar bien ya que sientes como alguien los sigue..."
    "你们走过整座公园，Nulla 跟你说着些不知是什么的东西，可你没法专心，因为总觉得有人在跟着你们……"

# game/rutas/nulla.rpy:815
translate chino null_0dd594d1:

    # "Aunque cada vez que te das vuelta, no hay nada."
    "可每次你回头，都什么都没有。"

# game/rutas/nulla.rpy:816
translate chino null_05bfd230:

    # "Te debes estar volviendo loco..."
    "你一定是疯了……"

# game/rutas/nulla.rpy:818
translate chino null_1c4a028f:

    # "Llegan a un callejón y estás seguro de que Nulla no es conciente de por donde camina ni a qué dirección va."
    "你们来到一条小巷，你确信 Nulla 并不清楚自己在往哪儿走，也不知道自己正朝着哪个方向。"

# game/rutas/nulla.rpy:819
translate chino null_6368ef85:

    # "Es como si lo estuviera haciendo en automático."
    "他就像是在凭本能自动行走。"

# game/rutas/nulla.rpy:820
translate chino null_55b0b044:

    # el "¡¡¡¡{glitch=20.0}{color=ffffff}{b}|||||||||||{/glitch}!!!"
    el "¡¡¡¡{glitch=20.0}{color=ffffff}{b}|||||||||||{/glitch}!!!"

# game/rutas/nulla.rpy:821
translate chino null_367e2ece:

    # "Escuchas a alguien gritando un nombre..."
    "你听见有人在喊一个名字……"

# game/rutas/nulla.rpy:822
translate chino null_5e8e1918:

    # "Pero no puedes percibir cual es el nombre."
    "可你听不清那个名字是什么。"

# game/rutas/nulla.rpy:823
translate chino null_ce848f9a:

    # "Se escucha con distorsión."
    "那声音带着失真的扭曲。"

# game/rutas/nulla.rpy:824
translate chino null_9c1eaefa:

    # el "¡{glitch=20.0}{color=ffffff}{b}|||||||||||{/glitch}!"
    el "¡{glitch=20.0}{color=ffffff}{b}|||||||||||{/glitch}!"

# game/rutas/nulla.rpy:825
translate chino null_5ff77b21:

    # "Buscas a Nulla con la mirada, y puedes ver como este yace congelado, sin mover ni un solo músculo."
    "你四下寻找 Nulla，只见他僵立在那里，一动不动，连一根肌肉都没有颤动。"

# game/rutas/nulla.rpy:827
translate chino null_b0b77bfd:

    # el "¡{glitch=20.0}{color=ffffff}{b}|||||||||||{/glitch}! ¡Espérame!"
    el "¡{glitch=20.0}{color=ffffff}{b}|||||||||||{/glitch}！等等我！"

# game/rutas/nulla.rpy:828
translate chino null_fd2be636:

    # "Es una chica... y viene corriendo hacia ustedes."
    "是个女孩……她正朝你们跑过来。"

# game/rutas/nulla.rpy:830
translate chino null_1e3fd86c:

    # el "{glitch=20.0}{color=ffffff}{b}|||||||||||{/glitch}, ¿Has visto a Rafael?"
    el "{glitch=20.0}{color=ffffff}{b}|||||||||||{/glitch}，你见过 Rafael 吗？"

# game/rutas/nulla.rpy:831
translate chino null_584d4c12:

    # el "Dijo que estaría aquí a las 2."
    el "他说他两点会来这里。"

# game/rutas/nulla.rpy:832
translate chino null_586bb5f6:

    # el "¿Hmmm? ¿{glitch=20.0}{color=ffffff}{b}N||||{/glitch}?"
    el "嗯……？{glitch=20.0}{color=ffffff}{b}N||||{/glitch}？"

# game/rutas/nulla.rpy:834
translate chino null_695d1dd4:

    # "{glitch=20.0}{color=ffffff}{b}Eso no debería haber pasado{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}这种事本不该发生{/glitch}"

# game/rutas/nulla.rpy:836
translate chino null_d4843bbc:

    # "{glitch=20.0}{color=ffffff}{b}Lo siento pero me tengo que ir.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}对不起，我得走了。{/glitch}"

# game/rutas/nulla.rpy:837
translate chino null_5114ff45:

    # "{glitch=20.0}{color=ffffff}{b}Borraré todo lo que pasó aquí.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}我会抹去这里发生过的一切。{/glitch}"

# game/rutas/nulla.rpy:838
translate chino null_43361b10:

    # "{glitch=20.0}{color=ffffff}{b}nos vemos.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}再见。{/glitch}"

