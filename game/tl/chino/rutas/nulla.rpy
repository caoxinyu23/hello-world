    # game/rutas/nulla.rpy:2765
    old "Besarlo."
    new "亲吻他。"

    # game/rutas/nulla.rpy:2765
    old "Correr la cara."
    new "转过脸去。"

    # game/rutas/nulla.rpy:2811
    old "Dormir un tiempo."
    new "睡一会儿。"

    # game/rutas/nulla.rpy:2811
    old "Explorar la casa de Nulla."
    new "探索 Nulla 的房子。"

    # game/rutas/nulla.rpy:2844
    old "¡Claro!"
    new "当然！"

    # game/rutas/nulla.rpy:2970
    old "¿Nulla?"
    new "Nulla？"

    # game/rutas/nulla.rpy:2970
    old "Tú no eres Nulla..."
    new "你不是 Nulla……"

    # game/rutas/nulla.rpy:3004
    old "El ojo."
