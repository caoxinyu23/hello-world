    # game/rutas/nulla.rpy:2281
    old "Solo un poco."
    new "就一点点。"

    # game/rutas/nulla.rpy:2339
    old "¿Dónde está Fames?"
    new "Fames 在哪里？"

    # game/rutas/nulla.rpy:2339
    old "¿Ahora controlas la música?"
    new "现在由你控制音乐吗？"

    # game/rutas/nulla.rpy:2373
    old "...No es necesario."
    new "……没必要。"

    # game/rutas/nulla.rpy:2373
    old "Sí, por favor!"
    new "好，求你了！"

    # game/rutas/nulla.rpy:2408
    old "¿Estás bien?"
    new "你还好吗？"

    # game/rutas/nulla.rpy:2408
    old "No vuelvas a hacer eso."
    new "别再那样做了。"

    # game/rutas/nulla.rpy:2429
    old "No es eso..."
    new "不是那样的……"

    # game/rutas/nulla.rpy:2429
    old "Me preocupas."
    new "你让我担心。"

    # game/rutas/nulla.rpy:2448
    old "Brindar."
