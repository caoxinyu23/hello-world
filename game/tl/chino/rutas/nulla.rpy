    # game/rutas/nulla.rpy:3004
    old "El gatito."
    new "那只小猫。"

    # game/rutas/nulla.rpy:3004
    old "El pollito."
    new "那只小鸡。"

    # game/rutas/nulla.rpy:3004
    old "El tiburon."
    new "那条鲨鱼。"

    # game/rutas/nulla.rpy:3032
    old "¡Gracias!"
    new "谢谢！"

    # game/rutas/nulla.rpy:3032
    old "Nada mal."
    new "不错。"

    # game/rutas/nulla.rpy:3032
    old "Yo lo hubiera hecho mucho mejor."
    new "我本可以做得更好。"

    # game/rutas/nulla.rpy:3065
    old "¿Sí?"
    new "是吗？"

    # game/rutas/nulla.rpy:3065
    old "A mí me gustan."
    new "我喜欢它们。"

    # game/rutas/nulla.rpy:3113
    old "Sí... deberíamos volver a casa."
    new "嗯……我们该回家了。"

    # game/rutas/nulla.rpy:3113
    old "¿Podríamos hacer algo que te alegre."
    new "我们能不能做些什么，让你开心起来？"

    # game/rutas/nulla.rpy:3157
    old "Pero no sería exactamente {b}ese{/b} objeto..."
    new "但那不会完全是{b}那个{/b}东西……"

    # game/rutas/nulla.rpy:3157
    old "Sería genial tener ese poder..."
    new "拥有那种力量会很棒……"

    # game/rutas/nulla.rpy:3167
