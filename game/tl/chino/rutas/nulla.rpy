    # game/rutas/nulla.rpy:2448
    old "Ignorarlo."
    new "忽略它。"

    # game/rutas/nulla.rpy:2546
    old "Depende..."
    new "看情况……"

    # game/rutas/nulla.rpy:2597
    old "¿Qué tal tu forma del vacío?"
    new "那你的虚空形态呢？"

    # game/rutas/nulla.rpy:2597
    old "Yo te quiero sin importar qué..."
    new "无论如何我都爱你……"

    # game/rutas/nulla.rpy:2646
    old "Nada."
