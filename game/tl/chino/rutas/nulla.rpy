translate chino rutanullaa_6e73ac45:

    # "Antes de pasarte la bandeja, Nulla espera que te sientes para dejarla en tus manos."
    "在你接过托盘前，Nulla 先等你坐好，再把它放到你手里。"

# TODO: Translation updated at 2025-02-22 21:37

# game/rutas/nulla.rpy:75
translate chino rutanullaa_f012cccd:

    # "Mientras Unum ríe, Septem tiene un semblante serio."
    "Unum 在笑，Septem 则神情严肃。"

# game/rutas/nulla.rpy:297
translate chino rutanullaa_292dbffa:

    # nulla "{b}Un lugar desechable luego de terminar de jugarlo{b}.... para ti."
    nulla "{b}一个玩完之后就可以丢弃的地方{b}……给你。"

# game/rutas/nulla.rpy:625
translate chino rutanullaa_e0f52040:

    # nulla "Eres presa fácil cuando estás acompañada, te confías mucho..."
    nulla "有人陪在身边时，你很容易成为猎物，你太容易轻信了……"

# game/rutas/nulla.rpy:700
translate chino rutanullaa_9a4a431b:

    # nulla "Ahh a la mierda."
    nulla "啊，操。"

# game/rutas/nulla.rpy:710
translate chino rutanullaa_aaf1f038:

    # "Nulla se tambalea un poco y te mira directamente a los ojos con una expresión complicada."
    "Nulla 微微踉跄了一下，用复杂的神情直视你的眼睛。"

# game/rutas/nulla.rpy:711
translate chino rutanullaa_2a42c54d:

    # nulla "¿Puedes esperarme un poco?"
    nulla "你能等我一会儿吗？"

# game/rutas/nulla.rpy:712
translate chino rutanullaa_93554086:

    # "Dice Nulla luego de alejarse de ti. Se está tocando la cabeza como si algo le molestase."
    "Nulla 说完便从你身边走开。他揉着脑袋，仿佛有什么东西让他难受。"

# game/rutas/nulla.rpy:721
translate chino rutanullaa_59c02290:

    # nulla "Solo será un momento, te lo prometo."
    nulla "就一会儿，我保证。"

# game/rutas/nulla.rpy:722
translate chino rutanullaa_0eb06432_1:

    # nj "..."
    nj "……"

# game/rutas/nulla.rpy:726
translate chino rutanullaa_1e82a88f:

    # nulla "Necesito calibrar mis sentidos."
    nulla "我需要校准自己的感官。"

# game/rutas/nulla.rpy:727
translate chino rutanullaa_634f344a:

    # nj "¿Qué?"
    nj "什么？"

# game/rutas/nulla.rpy:730
translate chino rutanullaa_56055f1f:

    # nulla "Les que quitado la potestad a Quattor y a Duae."
    nulla "我已经剥夺了 Quattor 和 Duae 的权力。"

# game/rutas/nulla.rpy:731
translate chino rutanullaa_a9fade5d:

    # nulla "Y me está costando un poco mantener mi cuerpo estable..."
    nulla "我有点难以让身体保持稳定……"

# game/rutas/nulla.rpy:733
translate chino rutanullaa_3f20b6a7:

    # "Nulla se tambalea un poco mientras intenta caminar en dirección a la puerta del templo que lleva a la salida."
    "Nulla 微微踉跄着，试图朝通往出口的神庙大门走去。"

# game/rutas/nulla.rpy:734
translate chino rutanullaa_5ddbfa94:

    # "Y tú le sigues de cerca."
    "你紧跟在他身后。"

# game/rutas/nulla.rpy:736
translate chino rutanullaa_19a8a10f:

    # nulla "Casi se me olvida que cualquiera que sea lo suficientemente fuerte, puede tomar el título de un Estandarte."
    nulla "我差点忘了，任何足够强大的人，都可以夺取一面圣旗的称号。"

# game/rutas/nulla.rpy:739
translate chino rutanullaa_9f400c7a:

    # nulla "En la época donde estaba el Creador, él puso un serie de reglas... tontas pero al fin y al cabo reglas para mantener al jardín estable."
    nulla "在造物主还在的时候，他定下了一系列规则……愚蠢，但终究是规则，用来维持花园的稳定。"

# game/rutas/nulla.rpy:740
translate chino rutanullaa_391002f7:

    # nulla "Y se preguntó... ¿Qué pasaría si algún estandarte no está haciendo bien su trabajo?"
    nulla "于是他想……如果某面圣旗没有好好履行职责，会发生什么？"

# game/rutas/nulla.rpy:743
translate chino rutanullaa_94c50a93:

    # nulla "¡Simple! hay que reemplazarlo."
    nulla "简单！换掉它就行了。"

# game/rutas/nulla.rpy:746
translate chino rutanullaa_409f8636_5:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:749
translate chino rutanullaa_233307bd:

    # nulla "Ja- Nuevamente estoy haciendo infodumping de algo que ya no importa... No tengo arreglo, realmente no puedo dejar de hacerlo."
    nulla "哈——我又在对已经无关紧要的事喋喋不休了……没救了，我真的停不下来。"

# game/rutas/nulla.rpy:752
translate chino rutanullaa_c7857491:

    # nulla "Disculpa."
    nulla "抱歉。"

# game/rutas/nulla.rpy:757
translate chino rutanullaa_409f8636_6:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:760
translate chino rutanullaa_771cf3a0:

    # nulla "¿En serio?"
    nulla "真的吗？"

# game/rutas/nulla.rpy:761
translate chino rutanullaa_1f5d9c14:

    # nj "Sí."
    nj "是的。"

# game/rutas/nulla.rpy:764
translate chino rutanullaa_15779771:

    # nulla "Está bien. Quiero que entiendas de manera rápida, para que luego no tengamos mal entendidos."
    nulla "好吧。我想让你尽快明白，免得之后产生误会。"

# game/rutas/nulla.rpy:767
translate chino rutanullaa_abd6b5b6:

    # nulla "Cualquiera puede tomar el título de Estandarte si es que el mundo no está en pausa... entonces, los Estandartes también se pueden matar entre sí, y obtener así más dominios a su poder."
    nulla "只要世界没有暂停，任何人都可以夺取圣旗的称号……也就是说，圣旗之间也可以互相残杀，从而获得更多的领域。"

# game/rutas/nulla.rpy:768
translate chino rutanullaa_36b0876d:

    # nulla "Pero, como cada estandarte está ligado a un concepto del jardín, de los cuales deben mantener en la mejor de sus condiciones, utilizando su energía propia."
    nulla "但是，每面圣旗都与花园的一个概念相连，他们必须用自身的力量，把那些概念维持在最佳状态。"

# game/rutas/nulla.rpy:771
translate chino rutanullaa_f87e5288:

    # nulla "Por lo que a ninguno se les ha pasado por la cabeza asesinar al otro, pues sería más difícil mantener dos conceptos."
    nulla "所以谁也没想过要杀掉对方，因为维持两个概念要困难得多。"

# game/rutas/nulla.rpy:774
translate chino rutanullaa_7713350b:

    # nulla "Ahora mismo yo tengo a la merced el concepto de la luna y las estrellas."
    nulla "此刻，月亮与星辰的概念都任由我摆布。"

# game/rutas/nulla.rpy:775
translate chino rutanullaa_8a5a3ad7:

    # nulla "Y puedo hacer lo que quiera con ellas."
    nulla "我可以随心所动地处置它们。"

# game/rutas/nulla.rpy:776
translate chino rutanullaa_bb22a121:

    # "No te gusta lo que está insinuando."
    "你不喜欢他在暗示的东西。"

# game/rutas/nulla.rpy:782
translate chino rutanullaa_1a5ea0fd:

    # nulla "... está bien."
    nulla "……好吧。"

# game/rutas/nulla.rpy:783
translate chino rutanullaa_7f3b0720:

    # nulla "No tienes porqué leer todo lo que digo."
    nulla "你不必把我的话一字一句都读完。"

# game/rutas/nulla.rpy:787
translate chino rutanullaa_fed4f4ce:

    # "Nulla intenta abrir la puerta del templo pero se cae antes de poder tocar el pomo."
    "Nulla 试图打开神庙大门，却在碰到门把手之前就摔倒了。"

# game/rutas/nulla.rpy:788
translate chino rutanullaa_a37ca3b9:

    # "Y tú, viendo el estado precario en que él se encuentra, corres a socorrerlo."
    "而你见他情形危急，赶紧跑过去扶住他。"

# game/rutas/nulla.rpy:790
translate chino rutanullaa_07c111de:

    # "Te agachas y lo levantas... y te das cuenta de que es increíblemente ligero."
    "你弯下腰把他扶起来……才发现他轻得不可思议。"

# game/rutas/nulla.rpy:792
translate chino rutanullaa_d3387e86:

    # nulla "Gracias."
    nulla "谢谢。"

# game/rutas/nulla.rpy:801
translate chino rutanullaa_3c619be3:

    # "Ambos toman el pomo de la puerta y empujan."
    "你们俩握住门把手，一起推门。"

# game/rutas/nulla.rpy:805
translate chino rutanullaa_8ed28db7:

    # "El escenario que te encuentras afuera es uno totalmente diferente al que anteriormente has visto."
    "门外的景象与你此前见过的截然不同。"

# game/rutas/nulla.rpy:807
translate chino rutanullaa_7826541a:

    # "Ese lugar con una tenue luz morada que cubría todo el paisaje ya no existe, ahora es solo un lugar vacío."
    "那片笼罩着整片景致的淡淡紫光已不复存在，如今只剩一片空茫。"

# game/rutas/nulla.rpy:808
translate chino rutanullaa_3c70859f:

    # "Rodeado de blanco y negro."
    "四周只剩黑与白。"

# game/rutas/nulla.rpy:809
translate chino rutanullaa_0eb06432_2:

    # nj "..."
    nj "……"

# game/rutas/nulla.rpy:810
translate chino rutanullaa_a5107048:

    # "Es ahora donde te das cuenta de las consecuencias de la misión de Nulla."
    "直到此刻，你才意识到 Nulla 的任务会带来什么后果。"

# game/rutas/nulla.rpy:811
translate chino rutanullaa_5dac192b:

    # "Todo volverá a ser nada."
    "一切都将归于虚无。"

# game/rutas/nulla.rpy:812
translate chino rutanullaa_a8708d65:

    # "Todo será devorado por el vacío."
    "一切都将被虚空吞噬。"

# game/rutas/nulla.rpy:814
translate chino rutanullaa_b58cf5e8:

    # "Miras detrás tuyo, buscando inútilmente a la luna... no hay nada allá arriba ni tampoco ahora hay rastro del templo de Quattor."
    "你回头望向身后，徒劳地寻找月亮……天上什么都没有，Quattor 神庙也再无踪迹。"

# game/rutas/nulla.rpy:815
translate chino rutanullaa_18b07ae5:

    # "Y estás seguro que todas las entidades bajo el comando de las antiguas Estandartes ya se encuentran desaparecidas... o en proceso de."
    "你确信，所有曾受昔日圣旗统领的存在都已经消失……或者正在消失。"

# game/rutas/nulla.rpy:817
translate chino rutanullaa_f8a30967:

    # "Caminas apoyando a Nulla, quien todavía presenta dificultades para tener balance."
    "你搀扶着 Nulla 前行，他仍难以站稳。"

# game/rutas/nulla.rpy:818
translate chino rutanullaa_6acd609e:

    # "Pero no te importa. Nulla no pesa nada y... de esta manera puedes estar cerca de él, hasta el punto de poder sentir la colonia que lleva en su cuerpo."
    "可你并不在意。Nulla 轻若无物，这样你还能贴近他，甚至闻到他身上香水的味道。"

# game/rutas/nulla.rpy:819
translate chino rutanullaa_0d31e411:

    # "Es agradable."
    "很好闻。"

# game/rutas/nulla.rpy:821
translate chino rutanullaa_5a9706c9:

    # nulla "Esto tomará un poco. Comer dos dominios a la vez es una tarea difícil."
    nulla "这要花点时间。同时吞噬两个领域可是件难事。"

# game/rutas/nulla.rpy:822
translate chino rutanullaa_a88a26e0:

    # nj "¿Te los estás comiendo?"
    nj "你在吃它们吗？"

# game/rutas/nulla.rpy:823
translate chino rutanullaa_340bb2c6:

    # nulla "Su energía, sí."
    nulla "它们的能量，是的。"

# game/rutas/nulla.rpy:824
translate chino rutanullaa_2dafe537:

    # nulla "Toda la energía puesta en la creación de cada dominio y cada entidad dentro de estos, así como también las memorias de este...."
    nulla "投入在每个领域、其中每个存在身上的全部能量，以及与之相连的记忆……"

# game/rutas/nulla.rpy:826
translate chino rutanullaa_4856ba9b:

    # "Nulla suspira apenado. No parece hacerle mucha gracia lo que está haciendo."
    "Nulla 惆怅地叹了口气。他似乎对自己的所作所为并不怎么愉快。"

# game/rutas/nulla.rpy:827
translate chino rutanullaa_1057b585:

    # "Al menos no se lo toma de forma irrespetuosa, no hay ningún comentario mal intencionado o algún rastro de risa."
    "至少他没有不敬地对待它，没有恶意的评论，也没有丝毫笑意。"

# game/rutas/nulla.rpy:828
translate chino rutanullaa_4cb155e4:

    # "Tienes que darle un punto."
    "在这一点上，你该给他记上一功。"

# game/rutas/nulla.rpy:830
translate chino rutanullaa_a20cefa7_9:

    # "..."
    "……"

# game/rutas/nulla.rpy:831
translate chino rutanullaa_ea375cac:

    # "Caminan por las calles vacías sin algún tipo de conversación que acompañe el ambiente lugubre del recorrido. Nulla ha estado callado y cabizbajo por un largo período de tiempo."
    "你们走在空荡的街道上，没有一句交谈，只有阴郁的气氛陪伴着这段路程。Nulla 已经沉默而垂头丧气了很长一段时间。"

# game/rutas/nulla.rpy:833
translate chino rutanullaa_2220f377:

    # nulla "Duae estuvo genial..."
    nulla "Duae 真棒……"

# game/rutas/nulla.rpy:834
translate chino rutanullaa_e8715fdc:

    # "Por tu mente pasa un pensamiento... {i} si era tan genial, ¿entonces por qué la has matado?{/i}"
    "一个念头掠过你的脑海……{i}如果她那么棒，那你为什么要杀了她？{/i}"

# game/rutas/nulla.rpy:835
translate chino rutanullaa_3a441b99:

    # "Pero supones que es lo que tiene que hacer para obtener lo que quiere. Así que no emites comentario alguno."
    "可你猜想，这是他得到想要之物所必须做的事。于是你什么也没说。"

# game/rutas/nulla.rpy:836
translate chino rutanullaa_3a3d0d13:

    # nulla "Hace mucho tiempo que no la veía."
    nulla "我已经很久没有见过她了。"

# game/rutas/nulla.rpy:838
translate chino rutanullaa_1c9a263a:

    # "Por el rabillo del ojo ves como Nulla coloca una de sus manos en su cabeza y solloza."
    "你从余光里看到 Nulla 把手按在头上，啜泣起来。"

# game/rutas/nulla.rpy:839
translate chino rutanullaa_e7537c2a:

    # nulla "Lo siento [nombrejugador], te dejaré por un momento."
    nulla "对不起，[nombrejugador]，我离开一会儿。"

# game/rutas/nulla.rpy:841
translate chino rutanullaa_8f7d386d:

    # "Y es así, como ambos son tragados por el portal que los lleva al vacío."
    "就这样，你们俩被传送门吞没，卷入了虚空之中。"

# game/rutas/nulla.rpy:843
translate chino rutanullaa_2f9851e2:

    # "Mientras están ahí, Nulla no te mira. Oculta sus ojos de tu mirada y te evita con la cara."
    "在那里时，Nulla 不看你。他躲开你的目光，把脸转了过去。"

# game/rutas/nulla.rpy:844
translate chino rutanullaa_9a1320b1:

    # "... y eso hace que te sientas mal por él."
    "……而这让你觉得为他难过。"

# game/rutas/nulla.rpy:845
translate chino rutanullaa_9cdb2ad5:

    # "Cuando sientes que tocas el suelo, todo pasa muy rápido."
    "当你觉得双脚触地时，一切都过得飞快。"

# game/rutas/nulla.rpy:848
translate chino rutanullaa_c6480566:

    # "Nulla te deja en la habitación de su casa y se despide de ti, deseándote dulces sueños."
    "Nulla 把你送回他家中的房间，向你道别，祝你做个好梦。"

# game/rutas/nulla.rpy:849
translate chino rutanullaa_859d3834:

    # "Apaga la luz y cierra la puerta de la habitación."
    "他关掉灯，关上了房门。"

# game/rutas/nulla.rpy:850
translate chino rutanullaa_a20cefa7_10:

    # "..."
    "……"

# game/rutas/nulla.rpy:851
translate chino rutanullaa_7d2957a9:

    # "Sin saber que está pasando, se sientas en la cama."
    "你不知道发生了什么，坐到床上。"

# game/rutas/nulla.rpy:852
translate chino rutanullaa_b948c955:

    # "Y esperas..."
    "你等待着……"

# game/rutas/nulla.rpy:853
translate chino rutanullaa_15355494:

    # "No sabes cuanto tiempo has estado sentado en la cama."
    "你不知道在这张床上坐了多久。"

# game/rutas/nulla.rpy:854
translate chino rutanullaa_ab8ac23c:

    # "Pero supones que ha sido uno largo, pues los huesos te comienzan a molestar."
    "但你想，一定已经过了很久，因为你的骨头开始酸痛起来。"

# game/rutas/nulla.rpy:855
translate chino rutanullaa_fe01bfc9:

    # "Supones que te debes preparar mentalmente para dormir..."
    "你想，你大概得先在精神上做好入睡的准备……"

# game/rutas/nulla.rpy:856
translate chino rutanullaa_a20cefa7_11:

    # "..."
    "……"

# game/rutas/nulla.rpy:857
translate chino rutanullaa_d0ac6549:

    # "Pero..."
    "可是……"

# game/rutas/nulla.rpy:860
translate chino rutanullaa_a20cefa7_12:

    # "..."
    "……"

# game/rutas/nulla.rpy:864
translate chino rutanullaa_62930489:

    # "No puedes evitarlo."
    "你忍不住。"

# game/rutas/nulla.rpy:865
translate chino rutanullaa_005e8638:

    # "Quieres ir a ver que es lo que pasa con Nulla."
    "你想去看看 Nulla 怎么了。"

# game/rutas/nulla.rpy:866
translate chino rutanullaa_ed22189f:

    # "Así que te levantas de la cama y partes camino al primer piso."
    "于是你下了床，朝一楼走去。"

# game/rutas/nulla.rpy:867
translate chino rutanullaa_a1050169:

    # "Si Nulla no quiere que lo encuentres, no te dejará siquiera salir."
    "如果 Nulla 不想让你找到他，他甚至不会让你出门。"

# game/rutas/nulla.rpy:868
translate chino rutanullaa_627fdc33:

    # "Por lo que cuando intentas abrir la puerta y lo logras con solo girar la manilla, sabes que Nulla te está dejando ir a por él."
    "所以当你试着开门，只一转门把就成功了，你知道 Nulla 是在放你去找他。"

# game/rutas/nulla.rpy:870
translate chino rutanullaa_d257a737:

    # "O tal vez no se ha dado cuenta... cosa que es poco probable."
    "又或者他还没意识到……只是，这不太可能。"

# game/rutas/nulla.rpy:871
translate chino rutanullaa_bec8374f:

    # "Bajas con cuidado las escaleras, te da miedo no pisar bien debido a la falta de luz que hay en el pasillo y por consecuencia, en las escaleras."
    "你小心翼翼地下楼，因为走廊里一片漆黑，楼梯也随之昏暗，你怕一脚踩空。"

# game/rutas/nulla.rpy:873
translate chino rutanullaa_7615929e:

    # "Cuando llegas al último escalón escuchas un estruendo."
    "当你走到最后一级台阶时，你听见一声巨响。"

# game/rutas/nulla.rpy:875
translate chino rutanullaa_d6b13ebb:

    # "Se escucha algo caer y romperse, el ruido es muy parecido a vidrios estallando y chocando contra el suelo."
    "有什么东西摔碎在地上，那声音像是玻璃炸裂后砸在地板上。"

# game/rutas/nulla.rpy:876
translate chino rutanullaa_49d61ba9:

    # nulla "¡Mierda!"
    nulla "操！"

# game/rutas/nulla.rpy:877
translate chino rutanullaa_b09a1e3c:

    # "Su voz se origina en la cocina. Te acercas al lugar con algo de apuro."
    "他的声音从厨房传来。你快步朝那边赶去。"

# game/rutas/nulla.rpy:879
translate chino rutanullaa_d4659345:

    # "Y ahí está él, sentado en la mesa... ha estado bebiendo."
    "他就坐在那里，坐在餐桌旁……他已经喝了不少。"

# game/rutas/nulla.rpy:882
translate chino rutanullaa_cc2dee24:

    # "Se ve fatal."
    "他看起来糟透了。"

# game/rutas/nulla.rpy:885
translate chino rutanullaa_2b18aa85:

    # nulla "Debí suponer que ibas a venir, ja ja."
    nulla "我早该想到你会来的，哈哈。"

# game/rutas/nulla.rpy:886
translate chino rutanullaa_46560092:

    # nulla "Después de todo esa opción maldita es la única interesante de las dos que te han dado."
    nulla "说到底，那个该死的选项才是给你的这两个里唯一有意思的那个。"

# game/rutas/nulla.rpy:887
translate chino rutanullaa_39e599d4:

    # "Colocas ambas manos en tus caderas y lo miras a los ojos."
    "你双手叉腰，直视他的眼睛。"

# game/rutas/nulla.rpy:888
translate chino rutanullaa_c40ef4fe:

    # nj "¿Qué pasa?"
    nj "怎么了？"

# game/rutas/nulla.rpy:889
translate chino rutanullaa_6dcda270:

    # "Nulla desvía la mirada, sin ánimos de contestar."
    "Nulla 移开视线，毫无应答的兴致。"

# game/rutas/nulla.rpy:892
translate chino rutanullaa_c0aac483:

    # "Suspira entrecortadamente, como si aguantara un llanto."
    "他断断续续地叹息，像是在忍住哭泣。"

# game/rutas/nulla.rpy:893
translate chino rutanullaa_409f8636_7:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:896
translate chino rutanullaa_b674cb49:

    # nulla "¡No creí que sería tan difícil esto!"
    nulla "我没料到这会这么难！"

# game/rutas/nulla.rpy:897
translate chino rutanullaa_1d5f9c3f:

    # nulla "Haber matado a Duae ha sido horrible, más de lo que pensaba."
    nulla "杀了 Duae 这件事太可怕了，比我预想的还要可怕。"

# game/rutas/nulla.rpy:898
translate chino rutanullaa_77c85709:

    # nulla "Pensanba que-- como esto ya había pasado en mi otra vida, sería más fácil..."
    nulla "我以为——既然这事在我另一段人生里已经发生过，会更容易些……"

# game/rutas/nulla.rpy:899
translate chino rutanullaa_07f03e75:

    # nulla "Ya la he matado ahí, ¿cuál es la diferencia esta vez?"
    nulla "我已经在那里杀过她了，这次又有什么区别？"

# game/rutas/nulla.rpy:900
translate chino rutanullaa_14ddf2b8:

    # nulla "¡Son las memorias! Implantadas o no, las tengo ahora conmigo!"
    nulla "是记忆！不管是不是植入的，它们现在就在我这里！"

# game/rutas/nulla.rpy:901
translate chino rutanullaa_7c6cba17:

    # nulla "Tengo muchos recuerdos de ella, que se han liberado al consumir su dominio... ella, me tenia una alta estima... aún."
    nulla "我对她有许多记忆，在吞噬她的领域时全都释放了出来……她曾经很看重我……即使到了现在。"

# game/rutas/nulla.rpy:902
translate chino rutanullaa_f55055d2:

    # nulla "Fui al que más confianza le depositó ¿¡y como se lo he pagado?!"
    nulla "我是她最信任的人，可我又是怎么回报她的？！"

# game/rutas/nulla.rpy:903
translate chino rutanullaa_5da9e831:

    # nulla "Elimi--"
    nulla "杀——"

# game/rutas/nulla.rpy:906
translate chino rutanullaa_07c9aa64_1:

    # nulla "No."
    nulla "不。"

# game/rutas/nulla.rpy:907
translate chino rutanullaa_58eb4f81:

    # nulla "--no, no. Le he liberado de este infierno."
    nulla "——不，不。我把她从这地狱里解放了出来。"

# game/rutas/nulla.rpy:908
translate chino rutanullaa_0aeae753:

    # nulla "Le he hecho un favor."
    nulla "我帮了她一个忙。"

# game/rutas/nulla.rpy:910
translate chino rutanullaa_f3933791:

    # "Te sientas a su lado, y ahora es muy notorio el olor a alcohol que despide su cuerpo."
    "你坐到他身旁，他身上散出的酒气此刻再明显不过。"

# game/rutas/nulla.rpy:911
translate chino rutanullaa_cf04b33f:

    # "Nulla coloca ambas manos en su cara, cubriendo su expresión y comienza a balbusear palabras que no logras comprender."
    "Nulla 用双手捂住脸，掩去自己的表情，开始含混不清地低语，你听不懂那些话。"

# game/rutas/nulla.rpy:912
translate chino rutanullaa_fd6b86e2:

    # "El cuerpo de Nulla comienza a cambiar de formas, unas líneas extrañas aparecen y desaparecen de su figura. Haciendo parecer que su cuerpo está perdiendo su forma original."
    "Nulla 的身体开始变形，一道道诡异的线条在他的轮廓上时隐时现，仿佛他的身体正在失去原本的形态。"

# game/rutas/nulla.rpy:913
translate chino rutanullaa_dc59bab0:

    # "Su estado emocional está por los suelos."
    "他的情绪已经跌到了谷底。"

# game/rutas/nulla.rpy:914
translate chino rutanullaa_7ec72945:

    # "Necesitas sacarlo de ese estado."
    "你得把他从这种状态里拉出来。"

# game/rutas/nulla.rpy:915
translate chino rutanullaa_ea318467:

    # nulla "--Pero no ¡y ahora no tengo ninguna guía para absolutamente nada!"
    nulla "——可是不行，我现在对一切都完全没有指引了！"

# game/rutas/nulla.rpy:919
translate chino rutanullaa_73a73f75:

    # nulla "Tengo documentos de lo que se ha escrito anteriormente de mis yos antiguos..."
    nulla "我有关于我前生们此前被写下来的文献……"

# game/rutas/nulla.rpy:920
translate chino rutanullaa_db2cddc0:

    # nulla "Pero el documento que estoy siguiendo ya no tiene nada más."
    nulla "可我正在遵循的这份文献，已经没有别的内容了。"

# game/rutas/nulla.rpy:921
translate chino rutanullaa_75f47946:

    # nulla "Solo páginas en blanco."
    nulla "只剩空白页。"

# game/rutas/nulla.rpy:922
translate chino rutanullaa_8b033598:

    # nulla "No sé cómo proseguir."
    nulla "我不知道该怎么继续。"

# game/rutas/nulla.rpy:923
translate chino rutanullaa_a5dcd2cf:

    # nulla "No sé si resultará esto o no."
    nulla "我不知道这到底会不会成功。"

# game/rutas/nulla.rpy:924
translate chino rutanullaa_cf0dde1f:

    # nulla "No sé si Septem me dejará una vez más encerrado en el vacío o no."
    nulla "我不知道 Septem 会不会再一次把我关进虚空。"

# game/rutas/nulla.rpy:925
translate chino rutanullaa_ddba3f04:

    # nulla "¡Por primera vez en mucho que no tengo idea de nada de lo que ocurrirá!"
    nulla "这么久以来，我第一次对即将发生的一切一无所知！"

# game/rutas/nulla.rpy:926
translate chino rutanullaa_8c4e2b4d:

    # nulla "Y tengo miedo."
    nulla "我很害怕。"

# game/rutas/nulla.rpy:927
translate chino rutanullaa_2413112f:

    # nulla "No quiero desperdiciar esta oportunidad."
    nulla "我不想浪费这个机会。"

# game/rutas/nulla.rpy:928
translate chino rutanullaa_413b56b0:

    # nulla "No quiero volver nuevamente ahí."
    nulla "我不想再回到那里。"

# game/rutas/nulla.rpy:929
translate chino rutanullaa_e278f195:

    # nulla "En cualquier momento este mundo será abandonado nuevamente."
    nulla "这个世界随时会再次被抛弃。"

# game/rutas/nulla.rpy:930
translate chino rutanullaa_308019c8:

    # nulla "Como siempre ha pasado con los anteriores mundos..."
    nulla "就像之前所有世界那样……"

# game/rutas/nulla.rpy:931
translate chino rutanullaa_3a53bcf8:

    # nulla "No puedo."
    nulla "我做不到。"

# game/rutas/nulla.rpy:932
translate chino rutanullaa_144d03b2:

    # nulla "No puedo dejar que Rafael siga así..."
    nulla "我不能让 Rafael 继续这样下去……"

# game/rutas/nulla.rpy:933
translate chino rutanullaa_5ff1c93a:

    # nulla "Todo es mi culpa."
    nulla "都是我的错。"

# game/rutas/nulla.rpy:934
translate chino rutanullaa_881eb602:

    # "Tienes que intervenir antes de que Nulla logre descompensarse completamente."
    "你必须在 Nulla 彻底失控之前介入。"

# game/rutas/nulla.rpy:938
translate chino rutanullaa_5f9b772e_1:

    # "...."
    "……"

# game/rutas/nulla.rpy:939
translate chino rutanullaa_779ea428:

    # "Realmente consideras que apoyarlo es lo mejor."
    "你真心认为，支持他是最好的选择。"

# game/rutas/nulla.rpy:940
translate chino rutanullaa_5f2d8c79:

    # "No sacas nada con decir que todo estará bien, porque siendo sinceros... dudas que todo estará bien."
    "说“一切都会好起来”没有任何用，因为说实话……你并不相信一切都会好起来。"

# game/rutas/nulla.rpy:942
translate chino rutanullaa_4069b723:

    # nj "[nombrejugador] está aquí para acompañarte, tienes toda su atención."
    nj "[nombrejugador] 就在这里陪着你，他全部的注意力都在你身上。"

# game/rutas/nulla.rpy:943
translate chino rutanullaa_01cbd358:

    # "{sc=3}Debo hacer esta separación, mil disculpas [nombrejugador]{/sc}"
    "{sc=3}我必须做出这样的分离，万分抱歉，[nombrejugador]{/sc}"

# game/rutas/nulla.rpy:944
translate chino rutanullaa_01b61442:

    # "{sc=3}Pero dudo que Nulla se sienta tranquilo si hablo él desde el yo.{/sc}"
    "{sc=3}但我怀疑，如果我用“我”来自称，Nulla 会不会觉得自在。{/sc}"

# game/rutas/nulla.rpy:945
translate chino rutanullaa_a20cefa7_13:

    # "..."
    "……"

# game/rutas/nulla.rpy:947
translate chino rutanullaa_821691cd:

    # nulla "Hah, ni siquiera puedo quitarle la voluntad a tu marioneta..."
    nulla "哈，我甚至无法夺走你那傀儡的意志……"

# game/rutas/nulla.rpy:948
translate chino rutanullaa_e653862b:

    # "Nulla no se digna a mirarte a los ojos."
    "Nulla 不屑于看你的眼睛。"

# game/rutas/nulla.rpy:949
translate chino rutanullaa_fcfcb08a:

    # "Pero sientes como Nulla aprieta tu mano con fuerza."
    "可你感觉 Nulla 紧紧握住了你的手。"

# game/rutas/nulla.rpy:950
translate chino rutanullaa_99ed1b91:

    # "No habla ni reacciona a hacer nada más que eso."
    "他不说话，也不作反应，除了紧握之外什么也不做。"

# game/rutas/nulla.rpy:952
translate chino rutanullaa_43d2951a:

    # "Hasta que comienza a llorar."
    "直到他开始哭泣。"

# game/rutas/nulla.rpy:953
translate chino rutanullaa_8fb60e98:

    # "Es extraño verlo así, pero supones que ha estado rodeado de tanta agonía impuesta, ya sea por un ser superior o por sí mismo, que es una reacción que cualquier ser sintiente tendría en su situación."
    "见他如此有些奇怪，可你猜想，他被如此多的强加痛苦包围着——无论那是来自更高位的存在还是他自己——任何有感知的生命处在他的位置都会有这样的反应。"

# game/rutas/nulla.rpy:954
translate chino rutanullaa_1af2535b:

    # "Envuelves ambas manos en la suya, la cual se ve tan pequeña ahora mismo, que te llega a espantar por un segundo."
    "你把双手都包覆在他的手上，那双手此刻看起来小得让你一瞬间心头一紧。"

# game/rutas/nulla.rpy:955
translate chino rutanullaa_92eedd82:

    # "Acaricias su espalda y das pequeñas palmadas, para ayudar a liberar esos sobrecojedores sentimientos, mezclados y atados, que se traducen en un llanto."
    "你轻抚他的后背，轻轻拍着，帮助他释放那些汹涌、混杂又纠缠的情绪——它们最终化作了哭泣。"

# game/rutas/nulla.rpy:956
translate chino rutanullaa_af24f8bf:

    # "Lo único que se escucha son los sollozos de un hombre desesperado por la validación de su propia existencia."
    "耳中只剩一个男人的啜泣，他迫切地渴求着对自己存在的认同。"

# game/rutas/nulla.rpy:957
translate chino rutanullaa_4b44c0d9:

    # "Es tortuoso, pero debes aguantarlo."
    "这很折磨人，但你必须撑住。"

# game/rutas/nulla.rpy:958
translate chino rutanullaa_6e3ff76c:

    # "Pues si no lo haces, estás seguro que comenzarás a llorar junto a él."
    "因为如果你不撑住，你确定自己会跟着他一起哭出来。"

# game/rutas/nulla.rpy:959
translate chino rutanullaa_0db85788:

    # nulla "Soy patético..."
    nulla "我真可悲……"

# game/rutas/nulla.rpy:962
translate chino rutanullaa_61cd9492:

    # "Tú no lo corriges."
    "你没有反驳他。"

# game/rutas/nulla.rpy:966
translate chino rutanullaa_f63cf671:

    # nj "¡No digas eso!"
    nj "别这么说！"

# game/rutas/nulla.rpy:968
translate chino rutanullaa_afed012d:

    # "Le dices todo lo que sabes de él, le aseguras que no es un hombre patético. Le hablas con sinceridad, cada palabra que sale de ti lleva un tono de sincera ternura."
    "你把自己所知道的关于他的一切都告诉他，让他确信他并不是一个可悲的人。你说的都是真心话，每个字都带着真切的温柔。"

# game/rutas/nulla.rpy:969
translate chino rutanullaa_8d1b2680:

    # "Nulla no responde, ni discute. Simplemente te escucha en silencio."
    "Nulla 没有回应，也没有反驳。他只是沉默地听着。"

# game/rutas/nulla.rpy:970
translate chino rutanullaa_73e819bc:

    # "Mientras hablas, deslizas tu mano con suavidad sobre su cabeza, apartando delicadamente la capa de gel para llegar hasta su cuero cabelludo."
    "你一边说，一边把手轻轻抚过他的发间，温柔地拨开那层发胶，触碰到他的头皮。"

# game/rutas/nulla.rpy:971
translate chino rutanullaa_30f1c18b:

    # "Su cabello es suave en las puntas, suave y delgado..."
    "他的头发在发梢处很软，又柔又细……"

# game/rutas/nulla.rpy:972
translate chino rutanullaa_677c47a6:

    # "Si tan solo no tuviera gel en su cabello..."
    "要是他头发上没有发胶就好了……"

# game/rutas/nulla.rpy:974
translate chino rutanullaa_c71de4fe:

    # "Nulla suelta un suspiro, que tiene un aire de añoramiento."
    "Nulla 叹了口气，那叹息里带着一丝怅惘。"

# game/rutas/nulla.rpy:975
translate chino rutanullaa_70ca0d24:

    # nulla "... nanai."
    nulla "……nanai。"

# game/rutas/nulla.rpy:978
translate chino rutanullaa_a48a9ead:

    # "No reconoces esa palabra. Por lo que le preguntas que es lo que acaba de decir."
    "你不认识这个词。于是你问他，他刚才说的是什么。"

# game/rutas/nulla.rpy:980
translate chino rutanullaa_a1a57b7b:

    # nulla "Ah!"
    nulla "啊！"

# game/rutas/nulla.rpy:981
translate chino rutanullaa_45839004:

    # "Nulla suena casi que avergonzado y se levanta para poder evitar completamente tu mirada, como si tuviera miedo de ver tu reacción."
    "Nulla 的声音听起来几乎有些羞赧，他站起身，好彻底避开你的目光，仿佛害怕看到你的反应。"

# game/rutas/nulla.rpy:984
translate chino rutanullaa_75b44174:

    # nulla "Me he acordado de una vieja memoria."
    nulla "我想起来了一段旧日的记忆。"

# game/rutas/nulla.rpy:985
translate chino rutanullaa_33377585:

    # nulla "Es... lo que se dice cuando alguien consuela a otro. Cuando era niño, solía decirlo mucho... cuando Ma-"
    nulla "这是……安慰别人时说的话。我小时候常常这样说……当妈——"

# game/rutas/nulla.rpy:986
translate chino rutanullaa_4e92c148:

    # "Nulla se detiene en seco y una risa se escapa de sus labios, pero no es una risa alegre... esta pesada, casi rota."
    "Nulla 猛地停下脚步，嘴角逸出一声笑，但那不是愉快的笑……那笑声沉重，几乎破碎。"

# game/rutas/nulla.rpy:987
translate chino rutanullaa_5eae0f59:

    # nulla "...Significa 'acariciar con el corazón'."
    nulla "……意思是“用心去爱抚”。"

# game/rutas/nulla.rpy:988
translate chino rutanullaa_77eeb9a7:

    # nulla "Es una de mis palabras favoritas."
    nulla "这是我最喜欢的词之一。"

# game/rutas/nulla.rpy:989
translate chino rutanullaa_409f8636_8:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:992
translate chino rutanullaa_5151da4e:

    # nulla "¿Cómo puede ser que mientras más tiempo pasa, más aprendes de mí y yo no puedo tener nada más que el reflejo de tus ojos?"
    nulla "为什么随着时间流逝，你越来越了解我，而我拥有的却只有你双眼的倒影？"

# game/rutas/nulla.rpy:993
translate chino rutanullaa_0e500403:

    # nulla "No es justo."
    nulla "这不公平。"

# game/rutas/nulla.rpy:994
translate chino rutanullaa_409f8636_9:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:997
translate chino rutanullaa_4f44afc8:

    # nulla "Prometí no involucrarme tanto para que la despedida no sea más terrible de lo que será."
    nulla "我答应过不要介入得太深，好让离别不至于比它本身更令人痛苦。"

# game/rutas/nulla.rpy:998
translate chino rutanullaa_bc2430ae:

    # nulla "Pero al menos quiero tener algo de ti conmigo."
    nulla "但至少我想拥有一点你，留在我身边。"

# game/rutas/nulla.rpy:1001
translate chino rutanullaa_17023d32:

    # nulla "... dicen que las palabras son el reflejo del alma."
    nulla "……人们说，语言是灵魂的映照。"

# game/rutas/nulla.rpy:1004
translate chino rutanullaa_28c759e5:

    # nulla "Me gustaría poder saber tu palabra favorita."
    nulla "我希望能知道你最喜欢的词。"

# game/rutas/nulla.rpy:1005
translate chino rutanullaa_63988e39:

    # nulla "Tú sabes la mía... ¿Cuál es la tuya?"
    nulla "你知道我最喜欢的词……你的呢？"

# game/rutas/nulla.rpy:1007
translate chino rutanullaa_409f8636_10:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:1009
translate chino rutanullaa_9a220f99:

    # "Nulla no dice nada, pero baja la mirada y ves como sonríe levemente. Como si hubiera obtenido algo tan secretamente preciado que no quisiera dejarle notar al mundo lo que ha ganado."
    "Nulla 什么也没说，只是垂下眼帘，你看见他轻轻笑了。仿佛他得到了某种秘密而珍贵的事物，不想让任何人察觉到他究竟收获了什么。"

# game/rutas/nulla.rpy:1012
translate chino rutanullaa_a20cefa7_14:

    # "..."
    "……"

# game/rutas/nulla.rpy:1013
translate chino rutanullaa_578c3ed9:

    # "El tiempo pasa rápido."
    "时间过得很快。"

# game/rutas/nulla.rpy:1015
translate chino rutanullaa_b4e7599e:

    # "Tan rápido que no te das cuenta de que Nulla te deja en la cama y se despide con la voz ronca, único vestigio de que estuvo llorando."
    "快到你甚至没察觉 Nulla 把你留在床上，用沙哑的声音跟你道别——那是他哭过的唯一痕迹。"

# game/rutas/nulla.rpy:1016
translate chino rutanullaa_d7502db5:

    # "Ya que no te deja ver su cara en ningún momento."
    "因为他始终没有让你看到他的脸。"

# game/rutas/nulla.rpy:1017
translate chino rutanullaa_fe66bcbb:

    # "Meditas por un tiempo lo ocurrido..."
    "你沉湎了一阵子刚才发生的事……"

# game/rutas/nulla.rpy:1018
translate chino rutanullaa_e69df51e:

    # "Y realmente piensas que..."
    "而你真心认为……"

# game/rutas/nulla.rpy:1019
translate chino rutanullaa_09cc57ec:

    # "{sc=3}{i} Nulla es un hombre complicado... ¿no lo crees, [nombrejugador]?{i} {/sc}"
    "{sc=3}{i} Nulla 是个很复杂的人……你不觉得吗，[nombrejugador]？{i} {/sc}"

# game/rutas/nulla.rpy:1022
translate chino rutanullaa_21cc7f20:

    # "No te gusta verlo en este estado tan deplorable."
    "你不喜欢看到他处在这样凄惨的状态里。"

# game/rutas/nulla.rpy:1023
translate chino rutanullaa_059c9a75:

    # "¡Por lo que lo sacarás de ese estado a la fuerza!"
    "所以，你要把他从这状态里硬拽出来！"

# game/rutas/nulla.rpy:1025
translate chino rutanullaa_88fc05b2:

    # "Te acercas lo suficiente como para poder tomar su corbata y tirar fuertemente de ella hacia tu dirección."
    "你靠得足够近，一把抓住他的领带，用力把它朝自己这边拉。"

# game/rutas/nulla.rpy:1026
translate chino rutanullaa_5eb7d55f:

    # "Sus ojos por fin se enfocan completamente en los tuyos, ahora tienes toda su atención."
    "他的眼睛终于完全聚焦在你身上，此刻你拥有了他全部的注意力。"

# game/rutas/nulla.rpy:1028
translate chino rutanullaa_0a7bceda:

    # nj "¡Lloriqueando no vas a resolver nada!"
    nj "哭哭啼啼解决不了任何问题！"

# game/rutas/nulla.rpy:1029
translate chino rutanullaa_f427ed99:

    # nj "Y menos hundiendo tus penas en alcohol."
    nj "更别提借酒浇愁了。"

# game/rutas/nulla.rpy:1030
translate chino rutanullaa_d9b6d1ec:

    # nj "Si quieres conversar como te sientes, me tienes aquí."
    nj "如果你想聊聊你的感受，我就在这里。"

# game/rutas/nulla.rpy:1031
translate chino rutanullaa_a12e19a9:

    # nj "Pero este discurso unilateral no te hará más que hundir más en el hoyo que has cavado con tus propias manos."
    nj "可这番单方面的倾诉，只会让你更深地陷进自己亲手挖下的坑里。"

# game/rutas/nulla.rpy:1034
translate chino rutanullaa_6be639f6:

    # nj "Enano de pacotilla..."
    nj "小矮子……"

# game/rutas/nulla.rpy:1035
translate chino rutanullaa_65efaa49:

    # "Te detienes antes de continuar..."
    "你在继续之前停顿了一下……"

# game/rutas/nulla.rpy:1036
translate chino rutanullaa_d1373a83:

    # "{sc=3} Lo siento, [nombrejugador], no he podido aguantarme...{sc=3}"
    "{sc=3} 对不起，[nombrejugador]，我实在忍不住了……{sc=3}"

# game/rutas/nulla.rpy:1037
translate chino rutanullaa_148fad38:

    # "Nulla te mira como si no pudiera creer lo que está pasando."
    "Nulla 看着你，仿佛不敢相信正在发生的事。"

# game/rutas/nulla.rpy:1038
translate chino rutanullaa_409f8636_11:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:1040
translate chino rutanullaa_be456b90:

    # "Una tenue sonrisa comienza a dibujarse en su rostro, para ser remplazada rápidamente por una carcajada forzada."
    "一丝淡淡的笑意在他脸上浮现，随即又被一声勉强的大笑取代。"

# game/rutas/nulla.rpy:1041
translate chino rutanullaa_05dd093a:

    # nulla "JA-- jajajajajaja. Ni siquiera tú te esperabas ese diálogo [nombrejugador]."
    nulla "哈——哈哈哈。连你自己都没料到会说出这种台词吧，[nombrejugador]。"

# game/rutas/nulla.rpy:1042
translate chino rutanullaa_56a045b7:

    # nulla "Te seré sincero, si bien aprecio la intención que has tenido, pensando que esa sería la opción..."
    nulla "说实话，我虽然很感激你的好意，但你以为那会是那个选择……"

# game/rutas/nulla.rpy:1043
translate chino rutanullaa_3b56f735:

    # nulla "Hay una cosa que debes tener clara: Tú estás allá, [nombrejugador]. Detrás de sus ojos."
    nulla "有件事你必须弄清楚：你在那里，[nombrejugador]。在它的双眼背后。"

# game/rutas/nulla.rpy:1044
translate chino rutanullaa_6efc1c0f:

    # nulla "No te tengo aquí, lo único que tengo a mi lado es a la marioneta."
    nulla "我在这里并不拥有你，我身边拥有的只有那个傀儡。"

# game/rutas/nulla.rpy:1045
translate chino rutanullaa_553c695f:

    # nulla "Que parece no aceptar la eliminación de su voluntad."
    nulla "它似乎不接受自己的意志被剥夺。"

# game/rutas/nulla.rpy:1046
translate chino rutanullaa_55655887:

    # nulla "Que linda~"
    nulla "真可爱~"

# game/rutas/nulla.rpy:1047
translate chino rutanullaa_214a9f08:

    # nulla "Tengo que aceptar que esto me ha hecho la noche."
    nulla "我得承认，这真的点亮了我的夜晚。"

# game/rutas/nulla.rpy:1048
translate chino rutanullaa_968020ef:

    # "Nulla quita tus manos de él con delicadeza."
    "Nulla 轻轻把你的手从他身上拿开。"

# game/rutas/nulla.rpy:1050
translate chino rutanullaa_742bee96:

    # nulla "Ya no más lloriquedos, lo prometo."
    nulla "不会再哭哭啼啼了，我保证。"

# game/rutas/nulla.rpy:1052
translate chino rutanullaa_a9f0cae8:

    # "Luego de ello, todo se vuelve incómodo. Nulla no muestra interés en conversar, así que te despides para ir a dormir, excusándote de que tienes sueño. Ambos suben las escaleras y Nulla te deja en la cama."
    "之后，一切都变得尴尬起来。Nulla 没有交谈的兴致，于是你借口困了，道晚安准备睡觉。两人上了楼，Nulla 把你安顿在床上。"

# game/rutas/nulla.rpy:1053
translate chino rutanullaa_bbb99b02:

    # "Dándote las buenas noches."
    "向你道了晚安。"

# game/rutas/nulla.rpy:1055
translate chino rutanullaa_3eb2153a:

    # "Cierras los ojos y te hundes en el país de los sueños."
    "你闭上眼睛，沉入梦乡。"

# game/rutas/nulla.rpy:1057
translate chino rutanullaa_af6c6b90:

    # "Pero a pesar de estar en el país de los sueños y deseos."
    "可尽管身处梦境与欲望的国度。"

# game/rutas/nulla.rpy:1058
translate chino rutanullaa_79fafc64:

    # "No sueñas con nada..."
    "你什么都没梦见……"

# game/rutas/nulla.rpy:1062
translate chino rutanullaa_f71b3735:

    # "Despiertas con mucho calor, tanto calor que cuando tocas tu frente, estás sudando."
    "你醒来时热得厉害，摸了摸额头，全都是汗。"

# game/rutas/nulla.rpy:1063
translate chino rutanullaa_1dfc7032:

    # "El ambiente se siente seco y ahogante por el calor."
    "空气因燥热而干涩、令人窒息。"

# game/rutas/nulla.rpy:1064
translate chino rutanullaa_508878cc:

    # "Como un horno que se está precalentando."
    "就像正在预热的烤箱。"

# game/rutas/nulla.rpy:1067
translate chino rutanullaa_3b64668f_1:

    # nulla "¡Buenos días!"
    nulla "早上好！"

# game/rutas/nulla.rpy:1070
translate chino rutanullaa_53ae4beb:

    # nulla "Quisiera disculparme por lo de ayer..."
    nulla "我想为昨天的事道歉……"

# game/rutas/nulla.rpy:1073
translate chino rutanullaa_cb0afef2:

    # nulla "Se que fue raro y prometo que no volverá a pasar."
    nulla "我知道那很奇怪，我保证不会再发生。"

# game/rutas/nulla.rpy:1076
translate chino rutanullaa_7059a117:

    # nulla "Ya me he deshecho de esos recuerdos... Por lo que no volverá a pasar."
    nulla "我已经摆脱了那些记忆……所以不会再发生了。"

# game/rutas/nulla.rpy:1077
translate chino rutanullaa_c3d86362:

    # "Nulla sonríe, pero a ti no te gusta la implicancia de sus palabras."
    "Nulla 笑了，可你并不喜欢他话里的意味。"

# game/rutas/nulla.rpy:1080
translate chino rutanullaa_d06ac688:

    # nulla "Estuve pensando creo que debemos empezar de una vez la caza del día de hoy..."
    nulla "我在想，我们该立刻开始今天的狩猎了……"

# game/rutas/nulla.rpy:1083
translate chino rutanullaa_07df9560:

    # nulla "Se están empezando a movilizar ya..."
    nulla "他们已经开始行动了……"

# game/rutas/nulla.rpy:1084
translate chino rutanullaa_d9a5ae57:

    # nulla "Supongo que Unum debe estar resguardando a Tria y a Sextam."
    nulla "我猜 Unum 一定是在守护 Tria 和 Sextam。"

# game/rutas/nulla.rpy:1089
translate chino rutanullaa_f310fd1d:

    # nulla "Está en su dominio."
    nulla "他在自己的领域里。"

# game/rutas/nulla.rpy:1092
translate chino rutanullaa_e3f0b983:

    # nulla "Es un blanco fácil, pero él no puede morir por ahora."
    nulla "他是个容易得手的目标，但他现在还不能死。"

# game/rutas/nulla.rpy:1095
translate chino rutanullaa_8b71388f:

    # nulla "No me voy a arriesgar a enfrentarme a él."
    nulla "我不想冒险去面对他。"

# game/rutas/nulla.rpy:1096
translate chino rutanullaa_1aa39f32:

    # nulla "¿Sientes que la temperatura térmica ha aumentado considerablemente?"
    nulla "你感觉到气温明显升高了吗？"

# game/rutas/nulla.rpy:1099
translate chino rutanullaa_af09c7c5:

    # "Asientes con la cabeza. Hace tanto calor que sientes como la ropa se te pega al cuerpo gracias al sudor."
    "你点了点头。天热得厉害，你觉得汗水把衣服都黏在了身上。"

# game/rutas/nulla.rpy:1100
translate chino rutanullaa_bb4a303d:

    # nulla "Unum es el causante."
    nulla "罪魁祸首是 Unum。"

# game/rutas/nulla.rpy:1103
translate chino rutanullaa_080b422a:

    # nulla "Debe estar volviéndose loco por la pérdida de sus estrellas."
    nulla "他大概因为失去自己的星辰而快疯了。"

# game/rutas/nulla.rpy:1106
translate chino rutanullaa_409f8636_12:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:1109
translate chino rutanullaa_637ee36a:

    # nulla "No..."
    nulla "不……"

# game/rutas/nulla.rpy:1112
translate chino rutanullaa_d1b4f789:

    # nulla "Ahora es muy peligroso enfrentarse a tres Estandartes en un espacio limitado."
    nulla "现在，在狭小空间里对抗三面圣旗太危险了。"

# game/rutas/nulla.rpy:1115
translate chino rutanullaa_65bec9e9:

    # nj "¿Por qué?"
    nj "为什么？"

# game/rutas/nulla.rpy:1116
translate chino rutanullaa_bc764515:

    # nulla "Porque muchos conceptos en un lugar alteran el espacio físico..."
    nulla "因为太多概念聚集在同一个地方，会扭曲物理空间……"

# game/rutas/nulla.rpy:1119
translate chino rutanullaa_b2240cbd:

    # nulla "Y no me quiero arriesgar a perderte por ello."
    nulla "我不想为此冒失去你的风险。"

# game/rutas/nulla.rpy:1123
translate chino rutanullaa_ff6b4edb:

    # "Nulla no elabora más en ello."
    "Nulla 没有再就此多说。"

# game/rutas/nulla.rpy:1124
translate chino rutanullaa_b5957e25:

    # "Intentas recordar quien falta, pero no recuerdas todos los nombres."
    "你试着回想还少了谁，却想不起所有的名字。"

# game/rutas/nulla.rpy:1127
translate chino rutanullaa_af4faf37:

    # nulla "Iremos a por Quinque, cariño."
    nulla "我们去找 Quinque，亲爱的。"

# game/rutas/nulla.rpy:1129
translate chino rutanullaa_4c426e14:

    # "Quinque..."
    "Quinque……"

# game/rutas/nulla.rpy:1130
translate chino rutanullaa_9a869b0d:

    # "No sabes mucho de él, lo que supones que es lo mejor."
    "你对他所知不多，而你想这样也好。"

# game/rutas/nulla.rpy:1131
translate chino rutanullaa_b3a41882:

    # "Así se hace más un poco más fácil verlos morir frente a tus ojos."
    "这样，亲眼看着他们死在你面前，就会稍微容易一些。"

# game/rutas/nulla.rpy:1132
translate chino rutanullaa_b7fd27b0:

    # "Supones..."
    "你想……"

# game/rutas/nulla.rpy:1133
translate chino rutanullaa_e82458f8:

    # nulla "Pero antes, debemos tomar desayuno."
    nulla "但在此之前，我们得吃早餐。"

# game/rutas/nulla.rpy:1135
translate chino rutanullaa_63187df1:

    # "Nulla te acompaña a la mesa una vez estás listo."
    "你一准备好，Nulla 便陪你坐到餐桌旁。"

# game/rutas/nulla.rpy:1136
translate chino rutanullaa_e4a2a55d:

    # nulla "Ya está todo servido y listo, así que come sin miedo."
    nulla "一切都备好了，放心吃吧。"

# game/rutas/nulla.rpy:1137
translate chino rutanullaa_ff78d126:

    # "En la mesa hay de todo para ponerle al pan, hay tanta abundancia que te marea un poco."
    "桌上摆满了可以抹在面包上的东西，丰盛得让你有些眩晕。"

# game/rutas/nulla.rpy:1138
translate chino rutanullaa_a20cefa7_15:

    # "..."
    "……"

# game/rutas/nulla.rpy:1140
translate chino rutanullaa_c88f0578:

    # "Luego de terminar Nulla se lleva los platos a la cocina y comienza a lavar y ordenar todo."
    "吃完后，Nulla 把盘子端进厨房，开始清洗和收拾。"

# game/rutas/nulla.rpy:1141
translate chino rutanullaa_ca187bd9:

    # "Insistes en ayudarle, pero él te dice que no es necesario. Luego de insistir un poco más, él cede."
    "你坚持要帮忙，他却说不用。你又多坚持了一会儿，他这才答应。"

# game/rutas/nulla.rpy:1142
translate chino rutanullaa_09969aec:

    # "Tú ayudas secando los cubiertos y platos que Nulla lava, crees que es un buen trabajo en equipo."
    "你帮 Nulla 擦干他洗好的餐具和盘子，觉得这是一次很棒的合作。"

# game/rutas/nulla.rpy:1144
translate chino rutanullaa_52283750:

    # nulla "Los quehaceres de la casa se hacen más divertidos contigo al lado."
    nulla "有你在身边，家务活也变得有趣起来。"

# game/rutas/nulla.rpy:1145
translate chino rutanullaa_e9c71ed5:

    # nulla "ja- Me encantaría poder hacer todo esto contigo el resto de mi vida..."
    nulla "哈——我真希望能在余生里都和你一起做这些事……"

# game/rutas/nulla.rpy:1146
translate chino rutanullaa_b66565af:

    # "Intentas imaginártelo, y te sorprendes de lo fácil que es hacerlo."
    "你试着想象，却惊讶于这竟如此容易。"

# game/rutas/nulla.rpy:1147
translate chino rutanullaa_f7da50ef:

    # "Imaginas una vida común y corriente junto con él, haciendo cosas cotidianas, yendo de compras para llenar la despensa... citas y quien sabe que otras cosas más... y no se ve para nada mal."
    "你想象着与他共度的平凡日常——做着琐事，去采购把储物柜填满……约会，还有谁知道些什么——看起来一点也不坏。"

# game/rutas/nulla.rpy:1148
translate chino rutanullaa_2451d4b6:

    # "Se ve y oye tan bien que te aterra."
    "那画面看起来、听起来都美好得让你害怕。"

# game/rutas/nulla.rpy:1149
translate chino rutanullaa_727d2502:

    # nulla "¡Bien!"
    nulla "好！"

# game/rutas/nulla.rpy:1151
translate chino rutanullaa_af125f38:

    # "Nulla termina de lavar el último plato y voltea a mirarte."
    "Nulla 洗完最后一个盘子，转身看向你。"

# game/rutas/nulla.rpy:1153
translate chino rutanullaa_9754841c:

    # nulla "Hora de ir a por Quinque."
    nulla "该去抓 Quinque 了。"

# game/rutas/nulla.rpy:1159
translate chino rutanullaa_9e2ecf0d:

    # nj "¿No podemos pasar un poco más de tiempo aquí?"
    nj "我们不能再在这里多待一会儿吗？"

# game/rutas/nulla.rpy:1160
translate chino rutanullaa_170f58db:

    # nulla "Mmmmh."
    nulla "嗯……"

# game/rutas/nulla.rpy:1163
translate chino rutanullaa_7efbeaa5:

    # nulla "Realmente prefiero que acabemos con esto de una buena vez."
    nulla "我真心希望能把这件事一劳永逸地了结。"

# game/rutas/nulla.rpy:1166
translate chino rutanullaa_30c9d19f:

    # nulla "¡Además!"
    nulla "而且！"

# game/rutas/nulla.rpy:1167
translate chino rutanullaa_77159484:

    # nulla "Si terminamos con esto rápido, tendremos toda la tarde para pasar el tiempo juntos."
    nulla "如果我们快点把这事结束，就能有整个下午的时间在一起了。"

# game/rutas/nulla.rpy:1168
translate chino rutanullaa_9518ddb3:

    # nulla "Si quieres, luego te llevaré a un lugar que me gusta mucho."
    nulla "如果你愿意，之后我会带你去一个我很喜欢的地方。"

# game/rutas/nulla.rpy:1169
translate chino rutanullaa_a724e0c6:

    # nulla "Y desearía que tú lo vieras."
    nulla "我希望你也能亲眼看看它。"

# game/rutas/nulla.rpy:1172
translate chino rutanullaa_5319a886:

    # nulla "¿Te parece?"
    nulla "你觉得怎么样？"

# game/rutas/nulla.rpy:1173
translate chino rutanullaa_69bb3e0a:

    # "Habla como si de un trámite se tratara..."
    "他说得好像是在走个形式……"

# game/rutas/nulla.rpy:1176
translate chino rutanullaa_ad626db1:

    # nj "Está bien"
    nj "好吧"

# game/rutas/nulla.rpy:1178
translate chino rutanullaa_393bb177:

    # nulla "¡Perfecto!"
    nulla "太好了！"

# game/rutas/nulla.rpy:1182
translate chino rutanullaa_2205b126:

    # nj "{glitch=20.0}{color=ffffff}{b}Está bien.{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}好吧。{/glitch}"

# game/rutas/nulla.rpy:1183
translate chino rutanullaa_b84f2801:

    # "¿¿¿¿????"
    "？？？？？"

# game/rutas/nulla.rpy:1184
translate chino rutanullaa_4a86bf84:

    # "Eso no ha sido lo que querías decir. Tú no quieres ir ahora mismo."
    "那并非你的本意。你现在并不想出发。"

# game/rutas/nulla.rpy:1185
translate chino rutanullaa_d4a4a1ee:

    # "¿Qué está pasando?"
    "发生什么了？"

# game/rutas/nulla.rpy:1187
translate chino rutanullaa_393bb177_1:

    # nulla "¡Perfecto!"
    nulla "太好了！"

# game/rutas/nulla.rpy:1188
translate chino rutanullaa_25e761dd:

    # "Momento--"
    "等等——"

# game/rutas/nulla.rpy:1189
translate chino rutanullaa_b3bc5871:

    # "Intentas abrir la boca, pero no puedes. Algo no te deja hacerlo."
    "你试着张开嘴，却做不到。有什么东西在阻止你。"

# game/rutas/nulla.rpy:1192
translate chino rutanullaa_a82084f6:

    # nulla "¿Mmmm?"
    nulla "嗯？"

# game/rutas/nulla.rpy:1195
translate chino rutanullaa_0aa8c9dd:

    # nulla "¿Pasa algo?"
    nulla "出什么事了？"

# game/rutas/nulla.rpy:1196
translate chino rutanullaa_9d78bea3:

    # "Nulla sonríe, sabiendo exactamente lo que está pasando y lo que está haciendo."
    "Nulla 笑了，他完全清楚正在发生什么，也清楚自己在做什么。"

# game/rutas/nulla.rpy:1198
translate chino rutanullaa_d626eda1:

    # nulla "Ya expliqué mis razones."
    nulla "我已经解释过我的理由。"

# game/rutas/nulla.rpy:1199
translate chino rutanullaa_288c63ce:

    # nulla "Por favor, debemos ir ahora."
    nulla "拜托，我们必须现在走。"

# game/rutas/nulla.rpy:1200
translate chino rutanullaa_edc29c14:

    # nulla "Luego tendremos tiempo para estar juntos y más tranquilos."
    nulla "之后我们就有时间，能更安宁地在一起了。"

# game/rutas/nulla.rpy:1204
translate chino rutanullaa_b77ec9e2:

    # "Nulla toma tu mano, asegurándose de acariciarla por un instante, antes de hundirse en el vacío junto contigo."
    "Nulla 牵起你的手，轻轻摩挲了一瞬，然后和你一起沉入虚空。"

# game/rutas/nulla.rpy:1207
translate chino rutanullaa_763e50cd:

    # "Una vez dentro, te abraza y te habla como si quisiera que nadie más que tú lo escuchase."
    "进去之后，他抱住你，说话的样子仿佛只希望除了你之外谁都听不到。"

# game/rutas/nulla.rpy:1208
translate chino rutanullaa_58756107:

    # "Irónico, pues aquí no hay nada más que ustedes."
    "很讽刺，因为这里除了你们俩，什么都没有。"

# game/rutas/nulla.rpy:1210
translate chino rutanullaa_75e0ad12:

    # nulla "Me encanta venir aquí y mirarte..."
    nulla "我喜欢来这里看着你……"

# game/rutas/nulla.rpy:1211
translate chino rutanullaa_d56791ff:

    # nulla "Con la oscuridad del vacío puedo ver mejor lo que pasa detrás de esa pantalla."
    nulla "借着虚空的黑暗，我能更清楚地看到那层屏幕背后发生的事。"

# game/rutas/nulla.rpy:1212
translate chino rutanullaa_a0cbdf50:

    # nulla "...Espero ser el primero que te lo dice hoy."
    nulla "……我希望我是今天第一个对你说出这句话的人。"

# game/rutas/nulla.rpy:1214
translate chino rutanullaa_9b768edf:

    # "{glitch=20.0}{color=ffffff}{b}Te ves adorable.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}你看起来真可爱。{/glitch}"

# game/rutas/nulla.rpy:1216
translate chino rutanullaa_b483eb6f:

    # "Caminan por la selva hasta llegar a un templo escondido entre plantas y rocas."
    "你们穿过丛林，来到一座隐藏在草木与岩石之间的神庙。"

# game/rutas/nulla.rpy:1217
translate chino rutanullaa_4fc63170:

    # "La estructura del templo es diferente al de Quattor, al igual que su tamaño."
    "这座神庙的结构和大小都与 Quattor 的那座不同。"

# game/rutas/nulla.rpy:1218
translate chino rutanullaa_1988e30e:

    # "Es algo pequeño... muy pequeño como la para el gusto de un Dios...."
    "它很小……小得刚好合一位神明的心意。"

# game/rutas/nulla.rpy:1220
translate chino rutanullaa_f4f3f678:

    # "Cuando se acercan más, pareciera estar hecho de algún tipo de piedra."
    "再走近些，它似乎是由某种石头建成的。"

# game/rutas/nulla.rpy:1222
translate chino rutanullaa_8219848b:

    # nulla "Es piedra caliza."
    nulla "是石灰岩。"

# game/rutas/nulla.rpy:1223
translate chino rutanullaa_01267159:

    # "Te informa Nulla después de leer tu dialogo interno."
    "Nulla 读完你的内心独白后，向你说明。"

# game/rutas/nulla.rpy:1224
translate chino rutanullaa_c181d676:

    # "¡Intruso!"
    "入侵者！"

# game/rutas/nulla.rpy:1227
translate chino rutanullaa_705096be:

    # nulla "Jaja!"
    nulla "哈哈！"

# game/rutas/nulla.rpy:1228
translate chino rutanullaa_042ead06:

    # "Y al sabandija no le causa nada más que gracia..."
    "而那个小混蛋只觉得这好玩……"

# game/rutas/nulla.rpy:1231
translate chino rutanullaa_488bd16f:

    # nulla "Quinque hizo este templo pequeño para no quitarle espacio a sus bebés."
    nulla "Quinque 建这座小神庙，是为了不占他孩子们的地盘。"

# game/rutas/nulla.rpy:1234
translate chino rutanullaa_412dac29:

    # nulla "Sí, todos los animales que ves aquí son sus bebés."
    nulla "是的，你在这里看到的所有动物都是他的孩子们。"

# game/rutas/nulla.rpy:1237
translate chino rutanullaa_75293d0e:

    # nulla "Así es."
    nulla "正是如此。"

# game/rutas/nulla.rpy:1239
translate chino rutanullaa_defd59b7:

    # nulla "Y todos tienen nombres... sigo sin entender como Quinque recuerda cada uno de ellos."
    nulla "而且它们都有名字……我还是不明白 Quinque 是怎么记住每一个的。"

# game/rutas/nulla.rpy:1240
translate chino rutanullaa_a2107e32:

    # "Adorable..."
    "太可爱了……"

# game/rutas/nulla.rpy:1243
translate chino rutanullaa_198c64f1:

    # nulla "Este es el único domino que ha sido intervenido por el trabajo de dos Estandartes en conjunto."
    nulla "这是唯一一个由两面圣旗合力改造过的领域。"

# game/rutas/nulla.rpy:1244
translate chino rutanullaa_b452d37b:

    # nulla "Tria y Quinque trabajaban juntos en la organización de ambos dominios cuando el Creador aún estaba aquí."
    nulla "造物主还在的时候，Tria 和 Quinque 曾一起整理这两个领域。"

# game/rutas/nulla.rpy:1247
translate chino rutanullaa_5408a3f8:

    # "Siendo completamente sinceros, te apena escuchar esto."
    "说实话，听到这些让你心里发酸。"

# game/rutas/nulla.rpy:1248
translate chino rutanullaa_8fa734c3:

    # "Te apena escuchar de estos dioses que serán asesinados tarde o temprano."
    "听到这些神明迟早会被杀死，让你心里发酸。"

# game/rutas/nulla.rpy:1249
translate chino rutanullaa_184234b2:

    # "Piensas que sería mucho mejor no tener idea de nada y hacer este genocidio más fácil."
    "你想，要是一无所知，这场大屠杀或许会容易得多。"

# game/rutas/nulla.rpy:1250
translate chino rutanullaa_5066ff5d:

    # "No entiendes la finalidad que tiene Nulla al contarte esto."
    "你不明白 Nulla 告诉你这些的用意。"

# game/rutas/nulla.rpy:1251
translate chino rutanullaa_a20cefa7_16:

    # "..."
    "……"

# game/rutas/nulla.rpy:1252
translate chino rutanullaa_174f0612:

    # "¿Ahora se va a hacer el que no lee lo que piensas?"
    "现在你要装作看不见自己在想什么吗？"

# game/rutas/nulla.rpy:1253
translate chino rutanullaa_6f3d18ff:

    # "Ja!"
    "哈！"

# game/rutas/nulla.rpy:1256
translate chino rutanullaa_d78d4b43:

    # nulla "¿Quieres que te explique, [nombrejugador]?"
    nulla "你想让我解释吗，[nombrejugador]？"

# game/rutas/nulla.rpy:1257
translate chino rutanullaa_4cf8a9fd:

    # "He ahí él, confirmando una vez más que sabe todo lo que pasa en esta caja de diálogo, que se supone que es exclusivamente para tus ojos."
    "他又一次印证了这一点：他知道这个本该只属于你一个人的对话框里发生的一切。"

# game/rutas/nulla.rpy:1258
translate chino rutanullaa_23b83c00:

    # "Maldita rata..."
    "该死的老鼠……"

# game/rutas/nulla.rpy:1263
translate chino rutanullaa_18371a06:

    # nulla "No tengo problema en darte una explicación, mi vida."
    nulla "给你解释没问题，我的宝贝。"

# game/rutas/nulla.rpy:1266
translate chino rutanullaa_409f8636_13:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:1269
translate chino rutanullaa_62e85fdf:

    # nulla "Solo creo que merece la pena recordarlos."
    nulla "我只是觉得，值得让他们被记住。"

# game/rutas/nulla.rpy:1270
translate chino rutanullaa_2ced236d:

    # nulla "No les estaría haciendo justicia si los eliminara sin al menos intentar que sean recordados por algo."
    nulla "如果我连让他们因某种事被记住都不做，就直接抹除他们，那对他们并不公平。"

# game/rutas/nulla.rpy:1271
translate chino rutanullaa_c3f4063e:

    # nulla "Hacer que su vida tenga algún impacto allá, en tu plano."
    nulla "让他们的生命在你的世界、你的领域里留下些许影响。"

# game/rutas/nulla.rpy:1272
translate chino rutanullaa_ada3cca3:

    # nulla "Y que se quede en tu memoria es una buena forma de hacer aquello..."
    nulla "而让他们留在你的记忆里，就是实现此事的好办法……"

# game/rutas/nulla.rpy:1273
translate chino rutanullaa_43e84ad1:

    # "Te sorprende un poco sus palabras. Se oyen sinceras, muy consideradas de la situación."
    "他的话让你有些惊讶。听起来很真诚，也很顾及当下的处境。"

# game/rutas/nulla.rpy:1276
translate chino rutanullaa_5997b66d:

    # nulla "Pero no quiero que te encariñes con ellos, solo lo suficiente para rendirles un último favor."
    nulla "但我不想让你对他们产生太多牵挂，只要够为他们做最后一件事的程度就好。"

# game/rutas/nulla.rpy:1279
translate chino rutanullaa_ae8769da:

    # nulla "Además... sirve como combustible para el show que quiero darte :)."
    nulla "而且……这恰好能为我为你准备的这场好戏添把火 :)"

# game/rutas/nulla.rpy:1280
translate chino rutanullaa_cc220e55:

    # "Retiras lo dicho."
    "你收回刚才的话。"

# game/rutas/nulla.rpy:1281
translate chino rutanullaa_fbaea027:

    # nulla "Jaa--"
    nulla "Ja--"

# game/rutas/nulla.rpy:1286
translate chino rutanullaa_9b84c2c2:

    # nulla "Está bien, mi vida."
    nulla "好吧，我的宝贝。"

# game/rutas/nulla.rpy:1288
translate chino rutanullaa_9aebdc0d:

    # "Están por entrar al templo, cuando das un paso en falso."
    "你们正要踏入神庙，就在这时脚下一滑。"

# game/rutas/nulla.rpy:1290
translate chino rutanullaa_6bc0ce19:

    # "Tus pies pisan una baldosa que se hunde. Accionando algún tipo de mecanismo que te traga en el proceso."
    "你的双脚踩上一块下陷的地砖，触发了某种机关，把你一并吞了进去。"

# game/rutas/nulla.rpy:1292
translate chino rutanullaa_87f6559f:

    # "Y Nulla no es lo suficientemente rápido para agarrarte."
    "而 Nulla 不够快，没能抓住你。"

# game/rutas/nulla.rpy:1293
translate chino rutanullaa_e2c83acc:

    # "Mientras caes, ves como algo rojo lo embiste, impidiéndole ir en tu búsqueda."
    "坠落之际，你看见一团红色的东西冲撞了他，使他无法追你。"

# game/rutas/nulla.rpy:1294
translate chino rutanullaa_0fbef67a:

    # "Estás solo en esto."
    "这件事上，你只能靠自己。"

# game/rutas/nulla.rpy:1295
translate chino rutanullaa_e960d587:

    # "Y tienes miedo."
    "而你很害怕。"

# game/rutas/nulla.rpy:1296
translate chino rutanullaa_bb7d117b:

    # "{glitch=20.0}{color=ffffff}{b}No te preocupes...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}别担心……{/glitch}"

# game/rutas/nulla.rpy:1297
translate chino rutanullaa_23324768:

    # "{glitch=20.0}{color=ffffff}{b}Iré en cuanto pueda.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}我会尽快赶来。{/glitch}"

# game/rutas/nulla.rpy:1299
translate chino rutanullaa_b46fb51a:

    # "Al aterrizar en el suelo, no hay evidencia de golpe, pues unas manos te atrapan y te dejan suavemente en el suelo."
    "落地时，你并未感到撞击——有一双双手接住了你，轻轻将你放下。"

# game/rutas/nulla.rpy:1300
translate chino rutanullaa_3e07da15:

    # "{glitch=20.0}{color=ffffff}{b}Por favor, ten cuidado.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}拜托，小心一点。{/glitch}"

# game/rutas/nulla.rpy:1301
translate chino rutanullaa_7dd78e46:

    # "El lugar es espacioso, no hay nada aquí."
    "这里很空旷，什么都没有。"

# game/rutas/nulla.rpy:1302
translate chino rutanullaa_2b24c5db:

    # "Es una gran sala delimitada por cuatro paredes sin ventanas ni puertas."
    "这是一间大厅，四面墙壁围拢，既无窗，也无门。"

# game/rutas/nulla.rpy:1303
translate chino rutanullaa_3b9ff284:

    # "Estás atrapado hasta nuevo aviso."
    "你被困在这里了，只能等另行通知。"

# game/rutas/nulla.rpy:1304
translate chino rutanullaa_c255b0ab:

    # "Caminas por todo el perímetro, buscando algún rastro que indique una salida o un escondite, porque aquí estás demasiado expuesto."
    "你沿着整个周界走动，寻找任何可能的出口或藏身之处，因为你在这里实在太过暴露。"

# game/rutas/nulla.rpy:1305
translate chino rutanullaa_fb274991:

    # "Eres un blanco fácil."
    "你就是个活靶子。"

# game/rutas/nulla.rpy:1306
translate chino rutanullaa_725596ed:

    # "Si la figura que ha atacado a Nulla te encuentra, estarás perdido."
    "如果袭击 Nulla 的那个身影找到你，你就完了。"

# game/rutas/nulla.rpy:1307
translate chino rutanullaa_401a1851:

    # "Y el calor no hace más que aumentar, es un calor que sofoca y no hace más que aumentar tu pánico."
    "热气只增不减——那是一种令人窒息的热，只会加剧你的恐慌。"

# game/rutas/nulla.rpy:1308
translate chino rutanullaa_08f4ebbf:

    # el "¿Así que eres tú?"
    el "原来就是你？"

# game/rutas/nulla.rpy:1309
translate chino rutanullaa_b1114440:

    # "¿¡!?"
    "？！"

# game/rutas/nulla.rpy:1311
translate chino rutanullaa_55094076:

    # "Giras tu cabeza para buscar a quién ha hablado."
    "你转过头，寻找刚才开口的人。"

# game/rutas/nulla.rpy:1313
translate chino rutanullaa_b6a3dc5d:

    # "Un hombre de cabello azul te mira con una expresión de aburrimiento desde la otra esquina de la sala."
    "房间的另一角，一个蓝发男人带着无聊的神情看着你。"

# game/rutas/nulla.rpy:1314
translate chino rutanullaa_b6fe0bcb:

    # "Debe ser Quinque..."
    "一定是 Quinque……"

# game/rutas/nulla.rpy:1315
translate chino rutanullaa_e90df7c2:

    # quinque "¿...El reemplazo del Creador?"
    quinque "……造物主的替代品？"

# game/rutas/nulla.rpy:1316
translate chino rutanullaa_dd9b8cc0:

    # "¿Qué? Tú no eres el reemplazo de nadie..."
    "什么？你谁也不是替代品……"

# game/rutas/nulla.rpy:1319
translate chino rutanullaa_eb9601a2:

    # quinque "Pensé que tendrías una apariencia más poderosa."
    quinque "我还以为你会有更威严的样貌。"

# game/rutas/nulla.rpy:1320
translate chino rutanullaa_50d78a88:

    # quinque "Decepcionante."
    quinque "真令人失望。"

# game/rutas/nulla.rpy:1323
translate chino rutanullaa_6b4e18aa:

    # "Le llamas la atención, será un dios, pero no dejarás que te hable de esa forma."
    "你出声制止他——他或许是神，但你绝不会让他那样跟你说话。"

# game/rutas/nulla.rpy:1326
translate chino rutanullaa_1d70949b:

    # quinque "Heh."
    quinque "哼。"

# game/rutas/nulla.rpy:1329
translate chino rutanullaa_a129f648:

    # quinque "Pues Nulla no cree lo mismo."
    quinque "可 Nulla 并不这么认为。"

# game/rutas/nulla.rpy:1330
translate chino rutanullaa_146865e9:

    # quinque "Solo te está utilizando."
    quinque "他只是在利用你。"

# game/rutas/nulla.rpy:1331
translate chino rutanullaa_ed0a15df:

    # nj "{sc=3}¡Eso no es cierto!{/sc}"
    nj "{sc=3}那不是真的！{/sc}"

# game/rutas/nulla.rpy:1337
translate chino rutanullaa_1d70949b_1:

    # quinque "Heh."
    quinque "哼。"

# game/rutas/nulla.rpy:1339
translate chino rutanullaa_073277ed:

    # quinque "..."
    quinque "……"

# game/rutas/nulla.rpy:1342
translate chino rutanullaa_59dbab68:

    # quinque "¿Qué cosa te dijo Nulla como para que estés haciendo esto?"
    quinque "Nulla 到底跟你说了什么，让你做出这种事？"

# game/rutas/nulla.rpy:1343
translate chino rutanullaa_f14e254f:

    # quinque "¿O es que esto es tu idea, y le prometiste a Nulla dejarlo con vida si es que te ayudaba?"
    quinque "又或者这是你的主意，你还向 Nulla 许诺，只要他帮你，就放他活命？"

# game/rutas/nulla.rpy:1344
translate chino rutanullaa_d5fc85a5:

    # "No entiendes lo que está hablando, pero no tienes ganas de tentar tu suerte y hacerlo enojar."
    "你听不懂他在说什么，但也无意拿运气去赌、惹怒他。"

# game/rutas/nulla.rpy:1345
translate chino rutanullaa_e4d57340:

    # "Por lo que solo lo miras, mientras hace sus preguntas retóricas."
    "于是你只是看着他，任他说着那些反问。"

# game/rutas/nulla.rpy:1346
translate chino rutanullaa_25f883ff:

    # quinque "¿Crees que el trabajo del Creador y de Septem no es digno?"
    quinque "你以为造物主和 Septem 的工作不值得尊重吗？"

# game/rutas/nulla.rpy:1347
translate chino rutanullaa_382e1254:

    # quinque "¿Quieres borrar y empezar de nuevo?"
    quinque "你想把一切抹去，重新开始吗？"

# game/rutas/nulla.rpy:1348
translate chino rutanullaa_d7160260:

    # quinque "Me das asco."
    quinque "你让我恶心。"

# game/rutas/nulla.rpy:1349
translate chino rutanullaa_073277ed:

    # "Woah, okay... eso está de más."
    "哇，行了……过了。"

# game/rutas/nulla.rpy:1350
translate chino rutanullaa_0529ac9a:

    # "Grosero."
    "粗鲁。"

# game/rutas/nulla.rpy:1351
translate chino rutanullaa_99dc63e6:

    # quinque "Entidades como tú y Nulla, no deberían existir..."
    quinque "像你和 Nulla 这样的存在，本就不该存在……"

# game/rutas/nulla.rpy:1352
translate chino rutanullaa_279cbfc7:

    # quinque "Ugh."
    quinque "啧。"

# game/rutas/nulla.rpy:1353
translate chino rutanullaa_2205429b:

    # quinque "Lástima que Septem te quiere vivo."
    quinque "可惜 Septem 要你活着。"

# game/rutas/nulla.rpy:1357
translate chino rutanullaa_4faf53f2:

    # "El instinto de correr te llama."
    "逃跑的本能在召唤你。"

# game/rutas/nulla.rpy:1358
translate chino rutanullaa_bb5f198d:

    # "Aunque no tengas a donde ir más allá de las 4 paredes, no importa."
    "哪怕这四壁之外无处可去，也无所谓。"

# game/rutas/nulla.rpy:1359
translate chino rutanullaa_d76e8e03:

    # "Tus piernas te comandan a correr de él."
    "你的双腿命令你逃离他。"

# game/rutas/nulla.rpy:1360
translate chino rutanullaa_f3cb5555:

    # "Pero antes de poder hacer algún movimiento, te congelas al ver a Quinque."
    "可你还没来得及动，看到 Quinque 的那一刻便僵住了。"

# game/rutas/nulla.rpy:1363
translate chino rutanullaa_cb80de16:

    # "Necesitas ganar tiempo de alguna u otra forma, ya que no puedes hacer nada para defenderte o pelear contra este Dios."
    "你必须无论如何拖延时间，因为你毫无还手之力，更无法与这位神对抗。"

# game/rutas/nulla.rpy:1364
translate chino rutanullaa_00cc51a2:

    # nj "¿Qué quieres de mí?"
    nj "你想从我这里得到什么？"

# game/rutas/nulla.rpy:1365
translate chino rutanullaa_54f67a57:

    # "Crees que hacerlo hablar de su plan malévolo funcionará para ganar tiempo..."
    "你觉得让他聊聊那个邪恶的计划，就能争取到时间……"

# game/rutas/nulla.rpy:1366
translate chino rutanullaa_742087df:

    # "Funciona en las películas, así que puede que funcione aquí."
    "电影里都这么演，或许在这里也行得通。"

# game/rutas/nulla.rpy:1367
translate chino rutanullaa_15b24ad6:

    # "Quinque te mira con cara de pocos amigos."
    "Quinque 板着脸看着你。"

# game/rutas/nulla.rpy:1368
translate chino rutanullaa_22deaa80:

    # quinque "¿Crees que soy imbécil?"
    quinque "你以为我是白痴？"

# game/rutas/nulla.rpy:1369
translate chino rutanullaa_df2befcd:

    # quinque "No voy a perder el tiempo en esto."
    quinque "我可没功夫陪你耗。"

# game/rutas/nulla.rpy:1372
translate chino rutanullaa_2039c057:

    # "Quinque toma posición de ataque."
    "Quinque 摆出了攻击架势。"

# game/rutas/nulla.rpy:1373
translate chino rutanullaa_80eaf054:

    # quinque "Prometo no hacerte daño."
    quinque "我保证不会伤你。"

# game/rutas/nulla.rpy:1375
translate chino rutanullaa_e3bea074:

    # quinque "Así que quédate quieto."
    quinque "所以，别动。"

# game/rutas/nulla.rpy:1378
translate chino rutanullaa_f490af3d:

    # "Cuando ves que Quinque se abalanza hacia ti de un solo salto, ya es demasiado tarde. Tus pies no responden a tiempo, estás congelado en el lugar sin opción real a moverte."
    "当你看见 Quinque 一跃向你扑来时，一切都太迟了。你的双脚来不及反应，整个人僵在原地，根本无从挪动。"

# game/rutas/nulla.rpy:1379
translate chino rutanullaa_86ddc45e:

    # "Al ver sus colmillos acercarse peligrosamente a tu campo de visión, antepones tus brazos entre tu cuerpo y Quinque."
    "看见他的獠牙逼近你的视线，你把双臂横在身前，挡在自己和 Quinque 之间。"

# game/rutas/nulla.rpy:1381
translate chino rutanullaa_39d5ca59:

    # "En un intento patético de formar un escudo."
    "妄图以此筑起一道可悲的屏障。"

# game/rutas/nulla.rpy:1384
translate chino rutanullaa_070c23c3:

    # "Y cierras los ojos por miedo a lo que pueda pasar."
    "你紧闭双眼，不敢想象接下来会发生什么。"

# game/rutas/nulla.rpy:1386
translate chino rutanullaa_31d30660:

    # "{glitch=20.0}{color=ffffff}{b}No dejes que la marioneta cierre sus ojos, mi vida.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}别让傀儡合上眼睛，我的宝贝。{/glitch}"

# game/rutas/nulla.rpy:1392
translate chino rutanullaa_254c21d5:

    # "Es... ¿Nulla?"
    "是……Nulla？"

# game/rutas/nulla.rpy:1394
translate chino rutanullaa_36e4c2f3:

    # "Ambos caen al suelo, Nulla con una forma diferente y Quinque parece estar totalmente mortificado por esto."
    "两人一同摔倒在地——Nulla 变成了另一种形态，Quinque 则显得无比惊骇。"

# game/rutas/nulla.rpy:1395
translate chino rutanullaa_733e40d6:

    # "Se le ve atrerrado."
    "看得出他吓坏了。"

# game/rutas/nulla.rpy:1397
translate chino rutanullaa_eb6d702c:

    # quinque "Duae..."
    quinque "Duae……"

# game/rutas/nulla.rpy:1399
translate chino rutanullaa_293921d1:

    # nulla "¿Qué pasa, querido?"
    nulla "怎么了，亲爱的？"

# game/rutas/nulla.rpy:1400
translate chino rutanullaa_3e298d3f:

    # "Incluso la voz de Nulla ha cambiado, se parece a la voz dura de la entidad que Nulla ha matado en el templo de Quattor."
    "连 Nulla 的声音都变了——那声音酷似他在 Quattor 神庙中杀死的那个存在的低沉嗓音。"

# game/rutas/nulla.rpy:1401
translate chino rutanullaa_db80c73a:

    # "Duae... Nulla está en el cuerpo de Duae."
    "Duae……Nulla 在 Duae 的身体里。"

# game/rutas/nulla.rpy:1402
translate chino rutanullaa_578bd358:

    # "Las palabras de Nulla hacen reaccionar a Quinque, quien empuja sin mucha fuerza a Nulla y se aleja saltando hacia atrás."
    "Nulla 的话让 Quinque 回过神来，他轻轻推了 Nulla 一下，随即向后跳开。"

# game/rutas/nulla.rpy:1405
translate chino rutanullaa_c588aa6f:

    # quinque "¡Maldito enfermo!"
    quinque "该死的变态！"

# game/rutas/nulla.rpy:1406
translate chino rutanullaa_c4211f61:

    # "Le grita rechinando los dientes. Él intenta mostrarse enojado pero la expresión de terror no deja su cara."
    "他咬着牙冲你吼道。他努力想摆出愤怒的样子，可脸上的惊恐却怎么也藏不住。"

# game/rutas/nulla.rpy:1407
translate chino rutanullaa_c220d1ee:

    # "Tiene miedo."
    "他害怕了。"

# game/rutas/nulla.rpy:1408
translate chino rutanullaa_9ff26c82:

    # quinque "¿¡Qué mierda crees que haces!?"
    quinque "你他妈以为自己在干什么！？"

# game/rutas/nulla.rpy:1409
translate chino rutanullaa_acfa2719:

    # quinque "No tienes dignidad."
    quinque "你毫无尊严。"

# game/rutas/nulla.rpy:1410
translate chino rutanullaa_1f18e025:

    # "Luego te busca a ti con la mirada."
    "接着他用目光搜寻着你。"

# game/rutas/nulla.rpy:1413
translate chino rutanullaa_306c31a1:

    # quinque "¿¡Es que no lo ves!?"
    quinque "你难道看不见吗！？"

# game/rutas/nulla.rpy:1414
translate chino rutanullaa_ee93f94b:

    # quinque "¡Estás ayudando a un enfermo!"
    quinque "你在帮一个变态！"

# game/rutas/nulla.rpy:1415
translate chino rutanullaa_0dec8832:

    # quinque "¡Este mundo aún puede recuperarse!"
    quinque "这个世界还能挽回！"

# game/rutas/nulla.rpy:1418
translate chino rutanullaa_fd76b9a2:

    # quinque "Por favor..."
    quinque "求你……"

# game/rutas/nulla.rpy:1419
translate chino rutanullaa_d2ba17a3:

    # "Te grita ahora suplicando..."
    "他此刻冲你吼着，带着恳求……"

# game/rutas/nulla.rpy:1426
translate chino rutanullaa_b098b5d5:

    # "{glitch=20.0}{color=ffffff}{b}¿De verdad has seleccionado esto?...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}你真的选了这条路吗？……{/glitch}"

# game/rutas/nulla.rpy:1427
translate chino rutanullaa_1d3f18cf:

    # "{glitch=20.0}{color=ffffff}{b}Ja--{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}Ja--{/glitch}"

# game/rutas/nulla.rpy:1428
translate chino rutanullaa_9be418c3:

    # "{glitch=20.0}{color=ffffff}{b}Supongo que ha sido para saber que pasaría, para llevarme la contraria... que lindo.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}我猜，你只是想看看会发生什么，想跟我作对……真是可爱啊。{/glitch}"

# game/rutas/nulla.rpy:1429
translate chino rutanullaa_f0610074:

    # "{glitch=20.0}{color=ffffff}{b}Bueno, de igual manera no te voy a dejar hacer eso, [nombrejugador].{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}总之，我不会让你得逞的，[nombrejugador]。{/glitch}"

# game/rutas/nulla.rpy:1430
translate chino rutanullaa_9bbab849:

    # "{glitch=20.0}{color=ffffff}{b}Pues la marioneta la controlas tanto tú como yo.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}毕竟，这具傀儡由你和我共同操控。{/glitch}"

# game/rutas/nulla.rpy:1431
translate chino rutanullaa_7f2faad1:

    # "{glitch=20.0}{color=ffffff}{b}:){/glitch}"
    "{glitch=20.0}{color=ffffff}{b}:){/glitch}"

# game/rutas/nulla.rpy:1435
translate chino rutanullaa_c12e95b4:

    # quinque "No te quedes ahí parado mirando como un idiota, ¡haz algo! ¡Detenlo!"
    quinque "别站在那儿像个傻子一样看着，做点什么！拦住他！"

# game/rutas/nulla.rpy:1436
translate chino rutanullaa_45bb95fa:

    # quinque "Un ser con tu poder puede-- ¡UHG!"
    quinque "以你的力量，一个存在可以——呃啊！"

# game/rutas/nulla.rpy:1437
translate chino rutanullaa_dc5015a4:

    # "Nulla hace un gesto con sus manos y una sombra con forma de mano sale del suelo y agarra a Quinque del brazo lanzándolo contra la pared."
    "Nulla 抬手打了个手势，一只手掌形状的阴影从地面钻出，抓住 Quinque 的手臂，将他甩向墙壁。"

# game/rutas/nulla.rpy:1438
translate chino rutanullaa_61d159fc:

    # "Nulla ríe un poco antes de gritar de vuelta."
    "Nulla 轻笑一声，随即回吼过去。"

# game/rutas/nulla.rpy:1440
translate chino rutanullaa_23597a11:

    # nulla "Vamos! no te quedes ahí parado y ladrando como un perro, ¡haz algo!"
    nulla "来吧！别站在那儿像条狗一样乱吠，做点什么！"

# game/rutas/nulla.rpy:1441
translate chino rutanullaa_92a3ce62:

    # "Se burla el pelinegro."
    "黑发的那个嘲弄道。"

# game/rutas/nulla.rpy:1442
translate chino rutanullaa_eb468ee9:

    # quinque "¡Púdrete!"
    quinque "去死吧！"

# game/rutas/nulla.rpy:1443
translate chino rutanullaa_61fa11be:

    # "Quinque toma posición de defensa, pero aun así no hace nada para enfrentar y atacar a Nulla."
    "Quinque 摆出防御姿态，却依然没有对 Nulla 做出任何反击。"

# game/rutas/nulla.rpy:1444
translate chino rutanullaa_63209e44:

    # nulla "¡¡¡Ohh!!! Ya entiendo..."
    nulla "哦哦哦！！！我明白了……"

# game/rutas/nulla.rpy:1445
translate chino rutanullaa_11ae90e2:

    # nulla "Tienes miedo."
    nulla "你害怕了。"

# game/rutas/nulla.rpy:1446
translate chino rutanullaa_25ed641a:

    # "Suelta una risita."
    "他发出一声轻笑。"

# game/rutas/nulla.rpy:1447
translate chino rutanullaa_e18190c6:

    # nulla "Jajajaja-- Me encanta saber que no puedes hacer nada al respecto."
    nulla "哈哈哈——我就喜欢看你对此无能为力的样子。"
#EDITAR
# game/rutas/nulla.rpy:1448
translate chino rutanullaa_24794333:
    # nulla "Pero vamos~ dame un poco de contenido al menos..."
    nulla "不过嘛~至少给我一点内容吧……"

# game/rutas/nulla.rpy:1449
translate chino rutanullaa_a20cefa7_17:
    # "..."
    "……"

# game/rutas/nulla.rpy:1450
translate chino rutanullaa_542f87fc:
    # "¿Realmente este es Nulla?"
    "这真的是 Nulla 吗？"

# game/rutas/nulla.rpy:1451
translate chino rutanullaa_18dd1b28:
    # "{sc=3}No... él no es así.{/sc}"
    "{sc=3}不……他不是这样的。{/sc}"

# game/rutas/nulla.rpy:1452
translate chino rutanullaa_d7c4af77:
    # "{sc=3} ¿Cierto?"
    "{sc=3} 对吧？"

# game/rutas/nulla.rpy:1453
translate chino rutanullaa_63427f16:
    # "No vas a mentir, te cuesta un poco comprender el cambio de actitud que está teniendo..."
    "说实话，你有些难以理解他态度上的剧变……"

# game/rutas/nulla.rpy:1457
translate chino rutanullaa_049825bb:
    # "No te gusta que se esté burlando..."
    "你不喜欢他这样嘲弄他……"

# game/rutas/nulla.rpy:1458
translate chino rutanullaa_ac21dd96:
    # "Y parece estar fuera de sí..."
    "而他看起来已经彻底失控……"

# game/rutas/nulla.rpy:1460
translate chino rutanullaa_077af11d:
    # "Gritas su nombre y le dices que por favor trate esta muerte con respeto."
    "你喊出他的名字，请求他务必对这场死亡抱以尊重。"

# game/rutas/nulla.rpy:1461
translate chino rutanullaa_a2df4916:
    # "Nulla te mira mientras intenta calmar su respiración."
    "Nulla 看着你，努力平复着自己的呼吸。"

# game/rutas/nulla.rpy:1462
translate chino rutanullaa_efe6273f:
    # "Sus ojos se ven extraños."
    "他的双眼看起来有些奇怪。"

# game/rutas/nulla.rpy:1463
translate chino rutanullaa_cf39dac2:
    # "Poco a poco pestañea y su expresión se torna más normal."
    "他缓缓眨了眨眼，神情渐渐恢复了正常。"

# game/rutas/nulla.rpy:1464
translate chino rutanullaa_48f2e0a6:
    # nulla "¿Ah? pero.."
    nulla "啊？可是……"

# game/rutas/nulla.rpy:1465
translate chino rutanullaa_f0c6c7f0:
    # nulla "Pensé que querías leer algo más interesante..."
    nulla "我还以为你想读些更有意思的……"

# game/rutas/nulla.rpy:1466
translate chino rutanullaa_76e0fd44:
    # nulla "Ya sabes, para no hacerlo tan corto."
    nulla "你懂的，免得写得太短。"

# game/rutas/nulla.rpy:1467
translate chino rutanullaa_137b62da:
    # nulla "¿No te está gustando?"
    nulla "你不喜欢吗？"

# game/rutas/nulla.rpy:1468
translate chino rutanullaa_dc455a4d:
    # "No respondes, simplemente lo miras con incredulidad."
    "你没有回答，只是难以置信地看着他。"

# game/rutas/nulla.rpy:1469
translate chino rutanullaa_c0f405f2:
    # "{sc=3} Debe ser la influencia del cuerpo.... ¿cierto?{sc=3}"
    "{sc=3} 一定是这具身体的影响……对吧？{sc=3}"

# game/rutas/nulla.rpy:1470
translate chino rutanullaa_409f8636_14:
    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:1471
translate chino rutanullaa_8a9a3802:
    # nulla "Tienes razón."
    nulla "你说得对。"

# game/rutas/nulla.rpy:1473
translate chino rutanullaa_815827fe:
    # "Sin más, con sus manos agarran nuevamente a la entidad, que más que un Dios, se asemeja a un animal atrapado."
    "不再多言，他用双手重新抓住了那个存在——比起神，它更像一只被困住的动物。"

# game/rutas/nulla.rpy:1474
translate chino rutanullaa_f66689de:
    # "Algo hace que el Estandarte mire hacia arriba."
    "有什么让圣旗抬头望去。"

# game/rutas/nulla.rpy:1479
translate chino rutanullaa_8ba8ead0:
    # "No crees necesario limitar a Nulla en sus acciones."
    "你觉得没有必要限制 Nulla 的行动。"

# game/rutas/nulla.rpy:1480
translate chino rutanullaa_94e35cd3:
    # "Después de todo, nada de esto importa."
    "毕竟，这一切都不重要。"

# game/rutas/nulla.rpy:1481
translate chino rutanullaa_44f358f4:
    # "Solo es un personaje más que decora esta escena."
    "他不过是为这场戏添彩的又一个角色罢了。"

# game/rutas/nulla.rpy:1482
translate chino rutanullaa_4d43ad3b:
    # "Sin mucho trasfondo..."
    "没有太多铺垫……"

# game/rutas/nulla.rpy:1484
translate chino rutanullaa_3db5bb49:
    # "Nulla invoca nuevamente a sus manos, tomando por todas las extremidades a Quinque."
    "Nulla 再次唤出双手，抓住了 Quinque 的所有肢体。"

# game/rutas/nulla.rpy:1485
translate chino rutanullaa_8e55c4af:
    # "Las garras de sus manos hacen hoyos en la piel del Estandarte."
    "他双手的利爪在圣旗的皮肤上凿出孔洞。"

# game/rutas/nulla.rpy:1486
translate chino rutanullaa_08fd3227:
    # "Y un líquido similar a la sangre sale de sus heridas."
    "一种类似血液的液体从伤口中流出。"

# game/rutas/nulla.rpy:1488
translate chino rutanullaa_b636d1c4:
    # "Quinque sisea, lo que hace que Nulla ría nuevamente."
    "Quinque 发出嘶声，引得 Nulla 再次笑了起来。"

# game/rutas/nulla.rpy:1490
translate chino rutanullaa_8e121b41:
    # "Nulla se materializa al lado de Quinque, quien aún se encuentra en el suelo, contra la pared."
    "Nulla 出现在 Quinque 身旁，后者仍瘫在地上，背靠着墙。"

# game/rutas/nulla.rpy:1491
translate chino rutanullaa_6d0d6972:
    # quinque "No te voy a dar el gusto."
    quinque "我不会让你称心的。"

# game/rutas/nulla.rpy:1492
translate chino rutanullaa_282cc1ba:
    # quinque "Si quieres pelear, hazlo con tu cara."
    quinque "想打架，就用你自己的脸来打。"

# game/rutas/nulla.rpy:1493
translate chino rutanullaa_e3242bd5:
    # quinque "Cobarde."
    quinque "懦夫。"

# game/rutas/nulla.rpy:1494
translate chino rutanullaa_5c08f590:
    # "Nulla lo mira por un segundo, antes de susurrarle algo al oído."
    "Nulla 看了他一秒，随即在他耳边低语了几句。"

# game/rutas/nulla.rpy:1495
translate chino rutanullaa_9fdf8ed6:
    # "El cambio de expresión es inmediato, Quinque frunce el ceño y cruje los dientes."
    "他的神情瞬间变了——Quinque 皱起眉头，咬紧牙关。"

# game/rutas/nulla.rpy:1496
translate chino rutanullaa_db9ce95c:
    # "Esta vez si reacciona con un ataque, optando por pegarle una cachetada que resuena en toda la sala."
    "这一次他果然出手反击，一巴掌甩在对方脸上，声音在整个大厅里回荡。"

# game/rutas/nulla.rpy:1497
translate chino rutanullaa_abd5c394:
    # nulla "Ouch~ ¿por qué me haces esto?"
    nulla "哎哟~你为什么要这样对我？"

# game/rutas/nulla.rpy:1498
translate chino rutanullaa_e3c99938:
    # quinque "¡Qué te calles, maldita escoria sin dignidad!"
    quinque "闭嘴，你这毫无尊严的该死的渣滓！"

# game/rutas/nulla.rpy:1499
translate chino rutanullaa_9c680615:
    # nulla "Hmmj- ja ja ja ja."
    nulla "嗯哼- 哈哈哈哈。"
    
# game/rutas/nulla.rpy:1500
translate chino rutanullaa_f26dbb2a:
    # nulla "Sigues siendo igual de irritable."
    nulla "你还是一样易怒。"

# game/rutas/nulla.rpy:1501
translate chino rutanullaa_e41a1d75:
    # nulla "No te voy a soltar hasta que me des una pelea digna para mi [nombrejugador]."
    nulla "在我得到一场配得上我的 [nombrejugador] 的对决之前，我绝不会松手。"

# game/rutas/nulla.rpy:1502
translate chino rutanullaa_4e410cb2:
    # "Nuevamente las manos manejan a Quinque como si de una muñeca de trapo se tratase y lo tiran contra otra pared."
    "双手再度把 Quinque 当破布娃娃般摆弄，将他摔向另一面墙。"

# game/rutas/nulla.rpy:1503
translate chino rutanullaa_a20cefa7_18:
    # "..."
    "……"

# game/rutas/nulla.rpy:1505
translate chino rutanullaa_e6bd1163:
    # "Él choca contra la pared y cae como un saco de papas al suelo, boca arriba."
    "他撞在墙上，像一袋土豆般仰面摔倒在地。"

# game/rutas/nulla.rpy:1506
translate chino rutanullaa_1b06ed8a:
    # "Justo en lo que parece ser una entrada de luz."
    "正砸在一处似乎透着光的地方。"

# game/rutas/nulla.rpy:1507
translate chino rutanullaa_a072b457:
    # "Quinque mira hacia arriba."
    "Quinque 抬头望去。"

# game/rutas/nulla.rpy:1512
translate chino rutanullaa_9aef2308:
    # quinque "¡Unum!"
    quinque "Unum！"

# game/rutas/nulla.rpy:1513
translate chino rutanullaa_ff26ff1f:
    # "Grita pidiendo ayuda al sol."
    "他朝着太阳呼救。"

# game/rutas/nulla.rpy:1514
translate chino rutanullaa_10d8d387:
    # quinque "¡Sal de aquí!"
    quinque "滚开！"

# game/rutas/nulla.rpy:1515
translate chino rutanullaa_b7f65c24:
    # "... no es un grito de ayuda."
    "……这不是在求救。"

# game/rutas/nulla.rpy:1516
translate chino rutanullaa_e9606061:
    # "Le grita para evitar su mismo destino."
    "他是在喊叫，想让 Unum 躲开他即将面对的命运。"

# game/rutas/nulla.rpy:1517
translate chino rutanullaa_dc505be4:
    # quinque "No hay caso con pelear, con este suplantador a su lado, él-- uhg!"
    quinque "打下去没有意义，身边还站着这个冒充者，他——呃！"

# game/rutas/nulla.rpy:1519
translate chino rutanullaa_6c1253dd:
    # "Una de las tantas manos atraviesa a Quinque en el pecho, extrayendo la esencia de su cuerpo."
    "无数只手中的一只刺穿了 Quinque 的胸口，从他体内抽出了本质。"

# game/rutas/nulla.rpy:1520
translate chino rutanullaa_144e8f87:
    # nulla "Esto ya no es divertido..."
    nulla "这已经不有趣了……"

# game/rutas/nulla.rpy:1521
translate chino rutanullaa_f95f6b29:
    # "Y Quinque cae al suelo inmóvil, poco a poco se va desintegrando."
    "Quinque 一动不动地倒在地上，身体正缓缓崩解。"

# game/rutas/nulla.rpy:1523
translate chino rutanullaa_9cad87ac:
    # "Nulla vuelve a tu lado, y te ofrece la esencia."
    "Nulla 回到你身边，把本质递给你。"

# game/rutas/nulla.rpy:1524
translate chino rutanullaa_a71081c1:
    # nulla "[nombrejugador], no la comas aún."
    nulla "[nombrejugador]，先别吃。"

# game/rutas/nulla.rpy:1527
translate chino rutanullaa_f3e0a8ca:
    # "Te llevas la esencia de la boca y..."
    "你把本质从口中取出……"

# game/rutas/nulla.rpy:1529
translate chino rutanullaa_7aeb2385:
    # "Te congelas ahí mismo."
    "然后整个人僵在了原地。"

# game/rutas/nulla.rpy:1530
translate chino rutanullaa_8304d6fe:
    # "{glitch=20.0}{color=ffffff}{b}A este punto creo que solo lo haces para sacarme de quicio.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}到这个地步，我看你是故意想逼疯我。{/glitch}"

# game/rutas/nulla.rpy:1531
translate chino rutanullaa_a1e90f76:
    # "{glitch=20.0}{color=ffffff}{b}Lástima que no te daré el gusto :){/glitch}"
    "{glitch=20.0}{color=ffffff}{b}可惜我不会给你这个痛快 :){/glitch}"

# game/rutas/nulla.rpy:1532
translate chino rutanullaa_784d1bfc:
    # "{glitch=20.0}{color=ffffff}{b}Recuerda, yo controlo también a tu marioneta.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}记住，你的傀儡，我也操控得动。{/glitch}"

# game/rutas/nulla.rpy:1533
translate chino rutanullaa_80af32af:
    # "{glitch=20.0}{color=ffffff}{b}Ja ja ja.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}哈哈哈。{/glitch}"

# game/rutas/nulla.rpy:1534
translate chino rutanullaa_6c1bed79:
    # "¿Acaso no vas a conseguir ningún bad end en esta ruta?"
    "难道你这条线不会走向任何坏结局吗？"

# game/rutas/nulla.rpy:1535
translate chino rutanullaa_260fb5a8:
    # "{glitch=20.0}{color=ffffff}{b}No si puedo evitarlo, mi vida.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}只要我能做到，就绝不会，我的宝贝。{/glitch}"

# game/rutas/nulla.rpy:1541
translate chino rutanullaa_374a7f26:
    # "Detrás de Nulla puedes ver y escuchar como la pared se rompe en pedazos."
    "Nulla 身后，你能看见并听见墙壁碎裂成片的声音。"

# game/rutas/nulla.rpy:1542
translate chino rutanullaa_f253b8c8:
    # "Una figura que ya conoces aparece detrás de todo el polvo que produce las piedras pulverizadas."
    "碎石扬起的尘雾之后，出现了一个你熟悉的身影。"

# game/rutas/nulla.rpy:1544
translate chino rutanullaa_c7139f61:
    # "Es Unum..."
    "是 Unum……"

# game/rutas/nulla.rpy:1545
translate chino rutanullaa_46d1b8f1:
    # "Pero se ve aterrador."
    "但他看起来令人毛骨悚然。"
    
# game/rutas/nulla.rpy:1546
translate chino rutanullaa_1a230c15:
    # "Nulla también está mirándolo, solo por un segundo y luego voltea nuevamente hacia ti."
    "Nulla 也看了他片刻，随即再次转头望向你。"

# game/rutas/nulla.rpy:1547
translate chino rutanullaa_79bf91a2:
    # "Unum corre en dirección a ustedes, materializando unos látigos en sus manos."
    "Unum 朝你们跑来，手中具现出几根鞭子。"

# game/rutas/nulla.rpy:1548
translate chino rutanullaa_b019635a:
    # nulla "Sujétala."
    nulla "接住它。"

# game/rutas/nulla.rpy:1549
translate chino rutanullaa_e99ef09d:
    # "Tomas la esencia rápidamente, apretándola contra tu pecho, como si de un tesoro se tratase."
    "你迅速接过本质，将它按在胸前，如视珍宝。"

# game/rutas/nulla.rpy:1551
translate chino rutanullaa_89f66f45:
    # "Y te alegras de haberlo hecho a tiempo porque Nulla te agarra de la cintura y te tira junto a él al vacío."
    "你庆幸自己及时接住——因为 Nulla 揽住你的腰，把你和他一起拽进了虚空。"

# game/rutas/nulla.rpy:1554
translate chino rutanullaa_5e33d8a7:
    # nulla "Escucha, tenemos que deshacernos de él ahora, o sino el calor derretirá a la marioneta de aquí a mañana..."
    nulla "听着，我们必须现在就除掉他，否则到了明天，这股高温就会把傀儡融化……"

# game/rutas/nulla.rpy:1557
translate chino rutanullaa_498e26e9:
    # nulla "Unum está gastado todo su combustible y dentro de poco liberará esa energía en una explosión..."
    nulla "Unum 的燃料已经耗尽，很快就会把那份能量释放成一场爆炸……"

# game/rutas/nulla.rpy:1558
translate chino rutanullaa_cddfceb0:
    # nulla "Matará a todo ser hecho de carne y hueso."
    nulla "他会杀死每一个血肉之躯。"

# game/rutas/nulla.rpy:1559
translate chino rutanullaa_8025d22e:
    # nulla "Tu marioneta incluida."
    nulla "你的傀儡也包括在内。"

# game/rutas/nulla.rpy:1562
translate chino rutanullaa_609d61cd:
    # nulla "Sé lo que dice el trato. Y sé que hemos adelantado el trabajo, pero..."
    nulla "我知道约定上是怎么写的。我也知道我们已经推进了工作，但是……"
    
# game/rutas/nulla.rpy:1565
translate chino rutanullaa_61b4bf22:
    # nulla "¡Piensa que gracias a esto podremos tener dos días solo para nosotros!"
    nulla "你想想，这样一来我们就能拥有整整两天只属于我们的时间！"

# game/rutas/nulla.rpy:1566
translate chino rutanullaa_3361d096:
    # nulla "Te prometo que lo haré valer."
    nulla "我保证，这会值得。"

# game/rutas/nulla.rpy:1567
translate chino rutanullaa_ec0b7803:
    # nulla "Pero debemos eliminar a Unum para no poner en peligro a la marioneta."
    nulla "但我们必须除掉 Unum，以免危及傀儡。"

# game/rutas/nulla.rpy:1570
translate chino rutanullaa_717c8664:
    # nulla "Lo siento, no me voy a arriesgar a perder el medio de conexión que tengo contigo."
    nulla "对不起，我不愿冒失去与你连接的代价。"

# game/rutas/nulla.rpy:1571
translate chino rutanullaa_415a4d38:
    # nulla "Tienes que entenderme."
    nulla "你得理解我。"

# game/rutas/nulla.rpy:1572
translate chino rutanullaa_ec5c2b79:
    # nulla "Lo haré rápido, no jugaré esta vez."
    nulla "我会速战速决，这次不再玩了。"

# game/rutas/nulla.rpy:1573
translate chino rutanullaa_d3860c14:
    # nulla "No voy a tentar a la suerte con Unum."
    nulla "我不会拿 Unum 来赌运气。"

# game/rutas/nulla.rpy:1575
translate chino rutanullaa_a20cefa7_19:
    # "..."
    "……"

# game/rutas/nulla.rpy:1577
translate chino rutanullaa_0bbb825d:
    # "Nulla se aferra a tu cuerpo, quita con cuidado tus manos que hacen de barrera entre tú y él.... y coloca su cabeza en tu pecho mientras te mira."
    "Nulla 紧贴着你，小心地拿开你横在你和他之间的手……然后把头枕在你胸口，望着你。"

# game/rutas/nulla.rpy:1578
translate chino rutanullaa_feeae311:
    # nulla "por favor..."
    nulla "求你……"

# game/rutas/nulla.rpy:1579
translate chino rutanullaa_25f2297c:
    # "Pero no puedes pensar que esto es raro... porque tiene la imagen de un dios muerto."
    "但你难免觉得这有些奇怪……因为他顶着一张已死之神的脸。"

# game/rutas/nulla.rpy:1580
translate chino rutanullaa_1fb3f6a0:
    # nulla "Oh! me he olvidado de eso."
    nulla "哦！我忘了这茬。"

# game/rutas/nulla.rpy:1582
translate chino rutanullaa_813a2618:
    # "Nulla se transforma nuevamente en él."
    "Nulla 重新变回了他自己。"

# game/rutas/nulla.rpy:1583
translate chino rutanullaa_850ce265:
    # "Volviendo a lo que era antes."
    "回到了先前的模样。"

# game/rutas/nulla.rpy:1584
translate chino rutanullaa_dc389f6f:
    # nulla "¿Mejor?"
    nulla "好些了吗？"

# game/rutas/nulla.rpy:1588
translate chino rutanullaa_f02062bf:
    # "Él solo sonríe complacido con tu respuesta."
    "他只是望着你笑，对你的回答十分满意。"

# game/rutas/nulla.rpy:1589
translate chino rutanullaa_81556825:
    # "Y juras que puedes ver corazones en sus ojos..."
    "你发誓，能看见他眼中飘出的爱心……"

# game/rutas/nulla.rpy:1593
translate chino rutanullaa_c4306585:
    # "Nulla te mira sorprendido."
    "Nulla 惊讶地看着你。"

# game/rutas/nulla.rpy:1594
translate chino rutanullaa_c3db08c7:
    # "Por un segundo puedes ver como tu respuesta le ha causado tristeza. Pero rápidamente formula una sonrisa."
    "有那么一秒，你看到他因你的回答而流露出悲伤。但他很快又挂上了笑容。"


# game/rutas/nulla.rpy:1595
translate chino rutanullaa_17611aee:
    # nulla "Puedo cambiar mi apariencia si lo quieres..."
    nulla "如果你想的话，我可以换一副样子……"

# game/rutas/nulla.rpy:1596
translate chino rutanullaa_d6112281:
    # nulla "Pero hablaremos de eso después."
    nulla "不过这事我们之后再谈。"

# game/rutas/nulla.rpy:1599
translate chino rutanullaa_4c7ec8a3_1:
    # nulla "Ahora..."
    nulla "现在……"

# game/rutas/nulla.rpy:1600
translate chino rutanullaa_fe300844:
    # nulla "Solo falta esto para regresar a casa."
    nulla "只要拿到这个，我们就能回家了。"

# game/rutas/nulla.rpy:1601
translate chino rutanullaa_00f178c0:
    # nulla "Te lo prometo..."
    nulla "我向你保证……"

# game/rutas/nulla.rpy:1602
translate chino rutanullaa_cafc8d92:
    # nulla "Podremos cocinar o leer algún libro de la biblioteca, si lo deseas."
    nulla "我们可以下厨，或者去图书馆读本书，如果你愿意的话。"

# game/rutas/nulla.rpy:1603
translate chino rutanullaa_c5ddf89d:
    # nulla "Pero prefiero llevarte a ese lugar que te he contado en la mañana."
    nulla "不过我更想带你去早上跟你说过的那个地方。"

# game/rutas/nulla.rpy:1604
translate chino rutanullaa_9b8783e7:
    # nulla "Aunque, podríamos hacer todo si es que el tiempo nos alcanza."
    nulla "当然，如果时间够的话，我们什么都能做。"

# game/rutas/nulla.rpy:1605
translate chino rutanullaa_737dccdc:
    # "Odias admitirlo, pero..."
    "你不愿承认，但……"

# game/rutas/nulla.rpy:1606
translate chino rutanullaa_1f898381:
    # "No puedes llevarle la contraria."
    "你根本无法反驳他。"

# game/rutas/nulla.rpy:1607
translate chino rutanullaa_ddb1e497:
    # "Quieras o no, terminarás haciendo lo que este hombre pida."
    "无论你愿不愿意，最终你都会照这个男人的话去做。"

# game/rutas/nulla.rpy:1608
translate chino rutanullaa_4b646b88:
    # "Y él lo sabe..."
    "而他对此心知肚明……"

# game/rutas/nulla.rpy:1609
translate chino rutanullaa_ae902a0e:
    # "Sabes que con su cara y sus palabras pintadas con azúcar puede moldearte como quiera..."
    "你知道，凭着那张脸和那些裹着糖衣的话语，他能随心所欲地塑造你……"

# game/rutas/nulla.rpy:1613
translate chino rutanullaa_ca74c9b3:
    # "Nulla sonríe."
    "Nulla 笑了。"

# game/rutas/nulla.rpy:1614
translate chino rutanullaa_48e5c29c:
    # nulla "¿Solo dirás eso?"
    nulla "你只会说这些吗？"

# game/rutas/nulla.rpy:1615
translate chino rutanullaa_fb89383d:
    # "¿Qué más quiere?..."
    "他还想要什么？……"

# game/rutas/nulla.rpy:1616
translate chino rutanullaa_6cff0b26:
    # nj "{glitch=20.0}{color=ffffff}{b}¡Está bien, mi amorrrr!{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}好吧，我的爱爱爱爱！{/glitch}"

# game/rutas/nulla.rpy:1617
translate chino rutanullaa_13d6cfcf:
    # "¡Uhg! ¡¿Quien ha sido el responsable de darle tanto poder a este desquiciado!?"
    "呃！到底是谁给了这个疯子这么大的力量！？"

# game/rutas/nulla.rpy:1618
translate chino rutanullaa_e5e55a26:
    # nj "{glitch=20.0}{color=ffffff}{b}Guapo, poderoso, bello, hermoso--.{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}英俊、强大、俊美、绝色——{/glitch}"

# game/rutas/nulla.rpy:1619
translate chino rutanullaa_3ed36142:
    # "{sc=3}¡Haz que pareeeee!{/sc}"
    "{sc=3}快让它停下啊啊啊！{/sc}"

# game/rutas/nulla.rpy:1621
translate chino rutanullaa_e39924a2:
    # "Nulla ríe."
    "Nulla 笑了。"

# game/rutas/nulla.rpy:1622
translate chino rutanullaa_3a9c28d9:
    # nulla "Gracias por ser mi confidente, mi vida <3"
    nulla "谢谢你做我的知己，我的宝贝 <3"

# game/rutas/nulla.rpy:1626
translate chino rutanullaa_e70a969b:
    # "La mirada de Nulla cambia ligeramente. Y solo te observa sin comentar nada."
    "Nulla 的目光微微一转，只是静静注视着你，一言不发。"

# game/rutas/nulla.rpy:1627
translate chino rutanullaa_1087487a:
    # "Para luego sonreir de medio lado."
    "随后嘴角一扬，露出半个笑容。"

# game/rutas/nulla.rpy:1628
translate chino rutanullaa_6cff0b26_1:
    # nj "{glitch=20.0}{color=ffffff}{b}¡Está bien, mi amorrrr!{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}好吧，我的爱爱爱爱！{/glitch}"

# game/rutas/nulla.rpy:1629
translate chino rutanullaa_6d882296:
    # "¡Uhg! Maldito. ¡Al final hace lo que se le da la gana!"
    "呃！可恶。到头来他还不是想干什么就干什么！"

# game/rutas/nulla.rpy:1630
translate chino rutanullaa_e5e55a26_1:
    # nj "{glitch=20.0}{color=ffffff}{b}Guapo, poderoso, bello, hermoso--.{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}英俊、强大、俊美、绝色——{/glitch}"

# game/rutas/nulla.rpy:1631
translate chino rutanullaa_3ed36142_1:
    # "{sc=3}¡Haz que pareeeee!{/sc}"
    "{sc=3}快让它停下啊啊啊！{/sc}"

# game/rutas/nulla.rpy:1632
translate chino rutanullaa_e39924a2_1:
    # "Nulla ríe."
    "Nulla 笑了。"

# game/rutas/nulla.rpy:1634
translate chino rutanullaa_409f8636_15:
    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:1635
translate chino rutanullaa_ab903062:
    # nulla "Bien, hora de terminar esto."
    nulla "好了，该结束这一切了。"

# game/rutas/nulla.rpy:1639
translate chino rutanullaa_c5500310:
    # "Antes de salir nuevamente al dominio de Quinque, Nulla cambia de forma sin previo aviso."
    "在再次踏出 Quinque 的领域之前，Nulla 毫无预兆地变了形。"

# game/rutas/nulla.rpy:1640
translate chino rutanullaa_da2fe0a5:
    # "Casi empujas a Nulla de la sorpresa."
    "你差点因为惊讶而一把推开 Nulla。"

# game/rutas/nulla.rpy:1641
translate chino rutanullaa_16406f80:
    # nulla "Esto lo hará más rápido."
    nulla "这样会快一些。"

# game/rutas/nulla.rpy:1642
translate chino rutanullaa_a20cefa7_20:
    # "..."
    "……"

# game/rutas/nulla.rpy:1644
translate chino rutanullaa_627e7fad:
    # "Después de un largo suspiro, Nulla te saca del vacío."
    "一声长叹后，Nulla 把你拉出了虚空。"

# game/rutas/nulla.rpy:1645
translate chino rutanullaa_e22212de:
    # "Mismo lugar que antes, pero no ves a Unum."
    "还是那个地方，但你看不到 Unum。"

# game/rutas/nulla.rpy:1649
translate chino rutanullaa_b8eb0d53:
    # "Lo buscas con los ojos al igual que Nulla, pero es imposible con el brillo extraño que tiene el lugar. Es un brillo que devora todo objeto y lo convierte en algo imposible de percibir."
    "你和 Nulla 一样用目光搜寻着他，但这里奇异的强光让这一切成了徒劳——那光芒吞噬万物，令一切难以辨认。"

# game/rutas/nulla.rpy:1650
translate chino rutanullaa_9d238d0e:
    # "Hasta que un cuerpo extraño choca directamente contra ustedes."
    "直到一个陌生的身体径直撞上你们。"

# game/rutas/nulla.rpy:1653
translate chino rutanullaa_86402519:
    # "Sientes como algo se enrreda en tu cuello y te arrebata de los brazos de Nulla."
    "你感到有什么东西缠上了你的脖颈，把你从 Nulla 的臂弯中拽走。"

# game/rutas/nulla.rpy:1654
translate chino rutanullaa_8215ba50:
    # "El brillo deja de ser tan intenso y puedes apreciar lo que está pasando. Supones que es una táctica utilizada por Unum para cegar a su oponente."
    "强光不再那么刺眼，你得以看清局势。你猜想这是 Unum 用来蒙蔽对手的战术。"

# game/rutas/nulla.rpy:1655
translate chino rutanullaa_0fdfe99e:
    # "Caes al suelo y Nulla queda debajo de los pies del estandarte del sol."
    "你摔倒在地，Nulla 则被压在太阳圣旗的脚下。"

# game/rutas/nulla.rpy:1656
translate chino rutanullaa_1409f38e:
    # nulla "¡Cierra los o-- agh!"
    nulla "闭上——呃啊！"

# game/rutas/nulla.rpy:1657
translate chino rutanullaa_548e5b62:
    # "No alcanzas a cumplir lo pedido, pues Unum rápidamente le corta los brazos y piernas, impidiendo que pueda moverse."
    "你来不及回应，因为 Unum 已迅速斩断了他的四肢，让他动弹不得。"

# game/rutas/nulla.rpy:1659
translate chino rutanullaa_a3a7f3b7:
    # "Y con su otro látigo agarra el cuello de Nulla para incorporarlo."
    "他的另一条鞭子缠住 Nulla 的脖子，将他吊了起来。"

# game/rutas/nulla.rpy:1660
translate chino rutanullaa_36acfe61:
    # unum "O te quitas a Aeliana de tu cuerpo o mato aquí y ahora a esta cosa."
    unum "要么你把 Aeliana 从你身体里弄走，要么我现在就杀了这个东西。"

# game/rutas/nulla.rpy:1661
translate chino rutanullaa_c65eb4f2:
    # unum "El plan de Septem ya no tiene sentido sin mis estrellas conmigo, así que no me molestará matarle."
    unum "没有我的星辰在身边，Septem 的计划已毫无意义，所以杀了他我也不会感到困扰。"

# game/rutas/nulla.rpy:1662
translate chino rutanullaa_e1a19c2e:
    # "Nulla no puede hacer más que mirarte con impotencia."
    "Nulla 只能无力地望着你。"

# game/rutas/nulla.rpy:1663
translate chino rutanullaa_a20cefa7_21:
    # "..."
    "……"

# game/rutas/nulla.rpy:1664
translate chino rutanullaa_dd57f088:
    # "Nulla cede ante Unum y comienza a quitarse la piel de Aeliana para volver a su verdadera cara."
    "Nulla 屈服于 Unum，开始剥下 Aeliana 的皮，露出自己真正的脸。"

# game/rutas/nulla.rpy:1667
translate chino rutanullaa_52fe0126:
    # "Contento con aquello, Unum tira del collar que se ha formado en tu cuello y te atrae hacia ellos. Hace lo mismo con Nulla pero a él lo inmoviliza con su brazo."
    "对此感到满意的 Unum 拽住你脖子上的项圈，把你拉近。他对 Nulla 也做了同样的事，却用手臂将他牢牢钳住。"

# game/rutas/nulla.rpy:1668
translate chino rutanullaa_640bf1fb:
    # unum "¿Sabes lo interesante de este sujeto? ¿hhmmmm?"
    unum "你知道这家伙有趣的地方在哪里吗？嗯嗯嗯嗯？"

# game/rutas/nulla.rpy:1669
translate chino rutanullaa_c5207503:
    # "Te mira con una sonrisa inquetante."
    "他带着令人不安的笑容看着你。"

# game/rutas/nulla.rpy:1670
translate chino rutanullaa_e2c9d3b6:
    # "No tienes el coraje para contestar... tampoco es como que pudieras pues el collar te está sofocando poco a poco."
    "你没有勇气回答……其实就算有也说不出口，因为项圈正一点点勒紧你的喉咙。"

# game/rutas/nulla.rpy:1671
translate chino rutanullaa_0a32812c:
    # unum "¡No es fácil de matar!"
    unum "他可不容易杀！"

# game/rutas/nulla.rpy:1672
translate chino rutanullaa_d57abfa8:
    # unum "Para hacerlo necesitas dos cosas: Al creador o un reemplazo de este, y mucho, muuuucho tiempo para llegar a su capa original."
    unum "要做到这一点需要两样东西：造物主，或他的替代品，再加上很长很长、长到离谱的时间，才能触及他的本源。"

# game/rutas/nulla.rpy:1673
translate chino rutanullaa_f575c88e:
    # unum "¡Y es perfecto! porque tengo las dos cosas aquí."
    unum "而这简直完美！因为两样东西我都有，就在这里。"

# game/rutas/nulla.rpy:1674
translate chino rutanullaa_cecebd52:
    # unum "Septem me lo contó antes de venir aquí."
    unum "Septem 在来这里之前告诉我了。"

# game/rutas/nulla.rpy:1677
translate chino rutanullaa_293161b0:
    # unum "Y LO VOY A DISFRUTAR TANTOOOO~"
    unum "而我会无比享受这个过程~"

# game/rutas/nulla.rpy:1678
translate chino rutanullaa_b2fbed82:
    # unum "Te voy a cortar esa cabeza las veces que sea necesario."
    unum "我会把你那颗脑袋砍下，需要多少次就砍多少次。"

# game/rutas/nulla.rpy:1679
translate chino rutanullaa_ce143cf7:
    # unum "Usaré mis propias manos, para que tu carne se desgarre lentamente."
    unum "我会用自己的双手，让你的血肉一寸寸撕裂开来。"

# game/rutas/nulla.rpy:1680
translate chino rutanullaa_efad49a5:
    # "Unum enfoca sus ojos en ti una vez más."
    "Unum 的目光再次锁定在你身上。"

# game/rutas/nulla.rpy:1681
translate chino rutanullaa_d870d1bd:
    # unum "¡Y haré que tú veas todo, todo, todo!"
    unum "而且我会让你看见一切，一切，一切！"

# game/rutas/nulla.rpy:1682
translate chino rutanullaa_21b3588c:
    # unum "Cortaré tus párpados si es necesario~"
    unum "必要的话，我连你的眼皮也一并割掉~"

# game/rutas/nulla.rpy:1683
translate chino rutanullaa_b4ae36e5:
    # "No quieres perder tus párpados... y tampoco quieres que nada malo le pase a Nulla."
    "你不想失去眼皮……也不想让 Nulla 遭遇任何不测。"

# game/rutas/nulla.rpy:1684
translate chino rutanullaa_e3dbbdc8:
    # "¡Demonios!"
    "该死！"

# game/rutas/nulla.rpy:1685
translate chino rutanullaa_adf86b9c:
    # "Te preguntas porqué Nulla no puede hacer nada ahora... ¿Por qué no invoca otra vez a sus sombras?"
    "你不禁疑惑，Nulla 现在为何无能为力……他为什么不再次唤出他的影子？"

# game/rutas/nulla.rpy:1686
translate chino rutanullaa_b76a4ace:
    # "Ya es tiempo para hacerlo."
    "是时候动手了。"

# game/rutas/nulla.rpy:1687
translate chino rutanullaa_7b097738:
    # "Momento... Cada vez que lo hace, él realiza un movimiento sutil con sus manos."
    "等等……每次他这么做时，手都会做一个细微的动作。"

# game/rutas/nulla.rpy:1688
translate chino rutanullaa_47cca12e:
    # "No puede hacer nada para evitar su muerte sin sus manos..."
    "没有双手，他根本无法阻止自己的死亡……"

# game/rutas/nulla.rpy:1689
translate chino rutanullaa_f1051408:
    # "Dios..."
    "天哪……"

# game/rutas/nulla.rpy:1690
translate chino rutanullaa_a20cefa7_22:
    # "..."
    "……"

# game/rutas/nulla.rpy:1691
translate chino rutanullaa_6fed807a:
    # "Unum agarra el cabello de Nulla y comienza a tira con fuerza, su cuello comienza a desgarrarse lentamente."
    "Unum 抓住 Nulla 的头发开始用力拉扯，他的脖颈开始缓缓撕裂。"

# game/rutas/nulla.rpy:1692
translate chino rutanullaa_f31b0f37:
    # "Tan lento que puedes ver en cámara lenta como pequeñas gotas emergen y caen de las heridas recién hechas en la piel."
    "慢到你几乎能以慢镜头看见细小的血珠从他皮肤上新裂的伤口中渗出、滴落。"

# game/rutas/nulla.rpy:1694
translate chino rutanullaa_2b4f62b1:

    # "____________________"
    "____________________"

# game/rutas/nulla.rpy:1696
translate chino rutanullaa_bb68da8d:
    # "{b}Oh... lo siento cariño, no voy a dejar que esto pase.{b}"
    "{b}噢……抱歉，我的孩子，我不会让这种事发生。{b}"

# game/rutas/nulla.rpy:1697
translate chino rutanullaa_fe1536ec:
    # "{b}Creo que es momento de intervenir.{b}"
    "{b}我想，是时候出手干预了。{b}"

# game/rutas/nulla.rpy:1698
translate chino rutanullaa_19e533e2:
    # "{b}Nulla no tiene oportunidad con mi querido Unum.{b}"
    "{b}Nulla 在我亲爱的 Unum 面前毫无胜算。{b}"

# game/rutas/nulla.rpy:1699
translate chino rutanullaa_cc9a5909:
    # "!!!"
    "！！！"

# game/rutas/nulla.rpy:1701
translate chino rutanullaa_c78d6240:
    # "Una mano se materializa detrás del pelirrojo y le corta la cabeza sin darle tiempo a procesar lo que está pasando."
    "一只手在红发男人身后具现，在他还没来得及反应之前，便斩下了他的头颅。"

# game/rutas/nulla.rpy:1702
translate chino rutanullaa_8f407820:
    # nulla "Madre..."
    nulla "母亲……"

# game/rutas/nulla.rpy:1703
translate chino rutanullaa_37c27569:
    # "¡¿Madre?!"
    "母亲？！}"

# game/rutas/nulla.rpy:1704
translate chino rutanullaa_e2bd0f5d:
    # "{sc=3}¿Todo este tiempo la voz que nos ha estado hablando es Madre?{/sc}"
    "{sc=3}一直以来，跟我们说话的那个声音，是母亲吗？{/sc}"

# game/rutas/nulla.rpy:1705
translate chino rutanullaa_437a83f0:
    # "____________________________"
    "____________________________"

# game/rutas/nulla.rpy:1706
translate chino rutanullaa_f920a4f2:
    # madre "Nulla, [nombrejugador] sé que están leyendo esto... tienen que estar más atentos, porque no pienso volver a interrumpir."
    madre "Nulla、[nombrejugador]，我知道你们在读这些……你们要多加留心，因为我不会再打断第二次了。"

# game/rutas/nulla.rpy:1707
translate chino rutanullaa_d62288ed:
    # madre "No disfruto de matar a mis hijos..."
    madre "我并不享受杀戮我的孩子们……"

# game/rutas/nulla.rpy:1708
translate chino rutanullaa_3d6210d4:
    # madre "Nos vemos luego."
    madre "回头见。"

# game/rutas/nulla.rpy:1710
translate chino rutanullaa_437a83f0_1:
    # "____________________________"
    "____________________________"

# game/rutas/nulla.rpy:1713
translate chino rutanullaa_c1537e6a:
    # "La mano extrae la esencia y te la ofrece a ti antes de esfumarse."
    "那只手抽出本质，递给你，随后消散无踪。"

# game/rutas/nulla.rpy:1714
translate chino rutanullaa_887207b7:
    # "Casi la sueltas al momento de tomarla con tu mano libre... está muy caliente."
    "你用空着的手去接时差点没拿稳……它滚烫无比。"

# game/rutas/nulla.rpy:1716
translate chino rutanullaa_b02633e8:
    # "Miras ambas esencias... y te das cuenta de algo."
    "你看着两份本质……忽然意识到了一件事。"

# game/rutas/nulla.rpy:1717
translate chino rutanullaa_5be46613:
    # "La esencia de quinque está formando una capa extraña y dura a su alrededor."
    "Quinque 的本质周围，正形成一层怪异而坚硬的物质。"

# game/rutas/nulla.rpy:1718
translate chino rutanullaa_953f63fa:
    # "Tipo coraza."
    "像一层甲壳。"

# game/rutas/nulla.rpy:1719
translate chino rutanullaa_da144fe6:
    # nulla "¿Puedes mirarme, por favor?"
    nulla "求你看看我，好吗？"

# game/rutas/nulla.rpy:1722
translate chino rutanullaa_d80299fe:
    # "Al hacerlo, Nulla comienza a regenerar sus brazos y piernas, y su ropa también lo hace..."
    "你照做之后，Nulla 开始再生他的双臂与双腿，连衣物也跟着复原……"

# game/rutas/nulla.rpy:1723
translate chino rutanullaa_2382ec9c:
    # "Aunque no regenera su piel.Justo como la vez anterior."
    "唯独皮肤没有再生——和上次一模一样。"

# game/rutas/nulla.rpy:1724
translate chino rutanullaa_97ab58a6:
    # "Primero es humo, luego algo más tangible que el humo y por último la capa de piel."
    "先是烟雾，接着是比烟雾更具体的东西，最后才化作那层皮肤。"

# game/rutas/nulla.rpy:1725
translate chino rutanullaa_7007cd32:
    # "Es extraño."
    "真奇怪。"

# game/rutas/nulla.rpy:1728
translate chino rutanullaa_e600532e:
    # nulla "Creo que ya se está volviendo hábito cortarme partes del cuerpo..."
    nulla "我想，切掉自己身体的一部分已经快成习惯了……"

# game/rutas/nulla.rpy:1729
translate chino rutanullaa_21501241:
    # nulla "Ja--"
    nulla "Ja--"

# game/rutas/nulla.rpy:1730
translate chino rutanullaa_8a955513:
    # nulla "Si mis receptores de dolor aún funcionarán bien, sería horrible."
    nulla "如果我的痛觉感受器还能正常工作，那会很可怕。"

# game/rutas/nulla.rpy:1736
translate chino rutanullaa_242a4040:
    # nulla "Así es, mis capas externas ya no sienten mucho el dolor."
    nulla "确实，我的外层已经不太感觉到疼痛了。"

# game/rutas/nulla.rpy:1737
translate chino rutanullaa_853ae9ce:
    # nulla "Mientras que las del interior, sienten como cualquier humano promedio."
    nulla "而内层的感受，则和寻常人类一般无二。"

# game/rutas/nulla.rpy:1742
translate chino rutanullaa_be65ffcc:
    # nulla "Awww, ¿te preocupas por mí?"
    nulla "哎呀，你在担心我吗？"

# game/rutas/nulla.rpy:1746
translate chino rutanullaa_b712edb8:
    # nulla "Bueno basta de cháchara."
    nulla "好了，别闲聊了。"

# game/rutas/nulla.rpy:1747
translate chino rutanullaa_f62d8712:
    # nulla "Tienes que comerte eso, mi amor."
    nulla "你得把它吃下去，我的爱。"

# game/rutas/nulla.rpy:1748
translate chino rutanullaa_70dec0c1:
    # nulla "Sino ellos volverán a regenerarse."
    nulla "否则它们还会再次再生。"

# game/rutas/nulla.rpy:1749
translate chino rutanullaa_87cb28fb:
    # nulla "Y no queremos eso, ¿cierto?"
    nulla "我们可不想那样，对吧？"

# game/rutas/nulla.rpy:1751
translate chino rutanullaa_6f7b77dc:
    # nj "{glitch=20.0}{color=ffffff}{b}Oh nooo, claro que noooo~{/glitch}"
    nj "{glitch=20.0}{color=ffffff}{b}哦不不不，当然不会啦~~{/glitch}"

# game/rutas/nulla.rpy:1752
translate chino rutanullaa_a20cefa7_23:
    # "..."
    "……"

# game/rutas/nulla.rpy:1753
translate chino rutanullaa_257bac5c:
    # nulla "De cualquier modo."
    nulla "无论如何。"

# game/rutas/nulla.rpy:1754
translate chino rutanullaa_87e8c9dc:
    # nulla "¡Hora de comer!"
    nulla "开饭啦！"

# game/rutas/nulla.rpy:1756
translate chino rutanullaa_2f8006a1:
    # "Nulla toca la esencia que le pertenece a Quinque y rompe su exterior, como si de una cáscara de huevo se tratase."
    "Nulla 碰了碰属于 Quinque 的本质，敲碎了它的外壳，那外壳薄得像蛋壳一般。"

# game/rutas/nulla.rpy:1757
translate chino rutanullaa_7aca4412:
    # "Lentamente, con sus manos sobre las tuyas, él junta ambas esencias y las fusiona para convertirlas en solo una."
    "他双手覆在你的手上，缓缓将两份本质并到一起，融合成一份。"

# game/rutas/nulla.rpy:1758
translate chino rutanullaa_bf274640:
    # "La esencia resultante es una de mayor tamaño que no se mezcla de manera homogénea como las anteriores."
    "融合后的本质更大，却不像先前那样融合得均匀。"

# game/rutas/nulla.rpy:1759
translate chino rutanullaa_6da96cc8:
    # "En esta se pueden apreciar con facilidad que partes pertenecen a Unum y que partes pertenecen a Quinque."
    "在这份本质中，你能清楚分辨哪些部分属于 Unum，哪些属于 Quinque。"

# game/rutas/nulla.rpy:1760
translate chino rutanullaa_292da7d8:
    # "Como si no quisieran estar juntas."
    "仿佛它们并不情愿待在一起。"

# game/rutas/nulla.rpy:1761
translate chino rutanullaa_41ae9f7c:
    # "Te preguntas cuál es la razón de que unas se mezclen y otras no."
    "你不禁好奇，为什么有的能融合，有的却不能。"

# game/rutas/nulla.rpy:1762
translate chino rutanullaa_ebf80427:
    # "¿Será la compatibilidad?"
    "是相性的问题吗？"

# game/rutas/nulla.rpy:1765
translate chino rutanullaa_6468ec00:
    # "Miras a Nulla y él te observa en silencio."
    "你望向 Nulla，他也正沉默地看着你。"

# game/rutas/nulla.rpy:1766
translate chino rutanullaa_9a3abf73:
    # "Se nota que quiere hablar o explicar la razón pero por algún motivo, no lo hace."
    "看得出他想开口解释些什么，但出于某种原因，他没有。"

# game/rutas/nulla.rpy:1767
translate chino rutanullaa_d8e1dab1:
    # "Con un poco de cuidado, Nulla guía tus manos hacia tu boca."
    "Nulla 小心地引着你的双手，移向你的嘴边。"

# game/rutas/nulla.rpy:1770
translate chino rutanullaa_a708f7d5:
    # nulla "¿Puedes ayudarme a caminar luego de que te comas la esencia?"
    nulla "等你吞下本质之后，能扶我走一段吗？"

# game/rutas/nulla.rpy:1775
translate chino rutanullaa_33031ef7:
    # nulla "Gracias, mi vida."
    nulla "谢谢你，我的宝贝。"

# game/rutas/nulla.rpy:1776
translate chino rutanullaa_409f8636_16:
    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:1779
translate chino rutanullaa_e83200e2:
    # nulla "Ah-"
    nulla "啊——"

# game/rutas/nulla.rpy:1783
translate chino rutanullaa_0879f6f0:
    # nulla "Cada vez que el cuerpo de la marioneta absorbe la esencia de algún Estandarte, mi cuerpo absorbe sus potestades."
    nulla "每当傀儡的身体吸收某位圣旗的本质时，我的身体也会同时吸收其权能。"

# game/rutas/nulla.rpy:1784
translate chino rutanullaa_36eb55db:
    # nulla "Todo lo que entre a su cuerpo, entrará al mío. Todo lo que se saque de su cuerpo, saldrá del mío... mientras tú, [nombrejugador], estés mirando y confirmando todo lo que pase..."
    nulla "进入它身体的，也会进入我的；从它身体取出的，也会从我的身上出来……只要你，[nombrejugador]，注视着并确认着发生的一切……"

# game/rutas/nulla.rpy:1785
translate chino rutanullaa_4988b607:
    # nulla "Lo que quiero decir es que: tu marioneta es mía, tanto como tuya."
    nulla "我想说的是：你的傀儡是我的，就像它也是你的一样。"

# game/rutas/nulla.rpy:1786
translate chino rutanullaa_4ddaa04e:
    # "{glitch=20.0}{color=ffffff}{b}¿Por qué crees que puedo hablarte así?{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}你以为我为什么能这样跟你说话？{/glitch}"

# game/rutas/nulla.rpy:1787
translate chino rutanullaa_969fb28a:
    # nulla "Estamos conectados tanto en alma como en cuerpo. Es lo que nos permite conectar el uno con el otro <3."
    nulla "我们身与魂都相连。正因如此，我们才能彼此相通。 <3"

# game/rutas/nulla.rpy:1790
translate chino rutanullaa_6b570e8d:
    # nulla "Lastima que solo es la marioneta y no tú."
    nulla "可惜连接的只是傀儡，而不是你。"

# game/rutas/nulla.rpy:1791
translate chino rutanullaa_e64f04b0:
    # nulla ":("
    nulla ":("

# game/rutas/nulla.rpy:1794
translate chino rutanullaa_0196757d:
    # "Estás por responder cuando Nulla aprovecha de empujar tus manos a tu boca, haciendo que te tragues la esencia de un solo bocado."
    "你正要回答，Nulla 却趁机把你手中的本质推向你嘴边，逼你一口吞了下去。"

# game/rutas/nulla.rpy:1795
translate chino rutanullaa_6d11dbdf:
    # "Por poco casi devuelves el contenido que está pasando por tu garganta."
    "你差点把正滑过喉咙的东西吐出来。"

# game/rutas/nulla.rpy:1796
translate chino rutanullaa_4c7a89d7:
    # "Pero te aguantas y cierras los ojos con fuerza mientras te encorvas, temiendo vomitar si te quedas en una posición normal..."
    "但你硬是忍住了，紧闭双眼弓下身，生怕保持直立的姿势就会呕吐……"

# game/rutas/nulla.rpy:1797
translate chino rutanullaa_182a6546:
    # nulla "Eso~ respira~ lo estás haciendo bien, cariño."
    nulla "好了~呼吸~你做得很好，亲爱的。"

# game/rutas/nulla.rpy:1798
translate chino rutanullaa_adeabfa1:
    # "Nulla te acaricia la espalda, trazando pequeños círculos con su palma, a modo de consuelo."
    "Nulla 轻抚你的后背，手掌画着小小的圈，以此安抚你。"

# game/rutas/nulla.rpy:1801
translate chino rutanullaa_8654cdf1:
    # nulla "Listo, ya no deberías sentirte mal."
    nulla "好了，不用再难过了。"

# game/rutas/nulla.rpy:1696 to :1801 end.


# game/rutas/nulla.rpy:1802
translate chino rutanullaa_7ecde53a:

    # nulla "Me he traspasado todo ese poder a mí."
    nulla "那份力量，我已经全部转移到我自己身上了。"

# game/rutas/nulla.rpy:1805
translate chino rutanullaa_f2ca365b:

    # nulla "Pero necesito que me sostengas ahora..."
    nulla "但现在，我需要你扶住我……"

# game/rutas/nulla.rpy:1806
translate chino rutanullaa_0363f93b:

    # nulla "Creo que me voy a caer."
    nulla "我想我要倒下了。"

# game/rutas/nulla.rpy:1808
translate chino rutanullaa_0cd552cf:

    # "El efecto que tienen sus palabras parecen asemejarse a un comando que no puedes evitar cumplir. Te enderezas y colocas tus manos en la cintura de Nulla, para estabilizar su cuerpo con ayuda del tuyo."
    "他话语的效果仿佛一道你无法违抗的命令。你直起身，将手扶在 Nulla 腰间，用自己的身体支撑住他。"

# game/rutas/nulla.rpy:1809
translate chino rutanullaa_745541c9:

    # "Como si de alas de mariposa se tratara, manejas su cuerpo con cuidado al ayudar a Nulla a pararse y caminar."
    "你如同对待蝶翼般，小心翼翼地扶起 Nulla，帮他站稳、迈步。"

# game/rutas/nulla.rpy:1810
translate chino rutanullaa_76fe8469:

    # "Miras a Nulla para comprobar que todo esté bien."
    "你望向 Nulla，确认他一切安好。"

# game/rutas/nulla.rpy:1812
translate chino rutanullaa_1d379ad8:

    # "Él te sonríe mostrando todos sus dientes."
    "他冲你咧嘴一笑，露出满口牙齿。"

# game/rutas/nulla.rpy:1814
translate chino rutanullaa_a095587c:

    # "Nada más caminan unos 6 pasos cuando ves el cambio en el ambiente. Poco a poco el lugar se va desintegrando."
    "刚走了约六步，你便察觉气氛发生了变化。这个地方正一点点崩解。"

# game/rutas/nulla.rpy:1815
translate chino rutanullaa_617ec04e:

    # "Partículas color negro se van comiendo el espacio, dejando un blanco puro a su paso."
    "黑色颗粒吞噬着空间，所过之处只留下一片纯白。"

# game/rutas/nulla.rpy:1816
translate chino rutanullaa_81745cbd:

    # "El proceso es más rápido de lo que te imaginabas."
    "这个过程比你想象中更快。"

# game/rutas/nulla.rpy:1818
translate chino rutanullaa_6b966fe6:

    # nulla "Uhggg."
    nulla "呃啊——"

# game/rutas/nulla.rpy:1819
translate chino rutanullaa_9753b040:

    # "Nulla se recarga más en ti, al punto de estar arrastrando sus pies."
    "Nulla 越靠越紧，最后几乎双脚拖地。"

# game/rutas/nulla.rpy:1820
translate chino rutanullaa_5f55cb8c:

    # "Te detienes para preguntar si es necesario seguir caminando."
    "你停下脚步，问他是否还要继续走。"

# game/rutas/nulla.rpy:1821
translate chino rutanullaa_566cf42e:

    # nulla "Tenemos que caminar por un poco más, hasta consumir la gran mayoría de este dominio."
    nulla "我们还得再走一段，直到把这处领域的大部分都吞噬殆尽。"

# game/rutas/nulla.rpy:1822
translate chino rutanullaa_1c39180b:

    # nulla "Si me detengo, creo que explotaré."
    nulla "如果我停下来，我想我会爆炸的。"

# game/rutas/nulla.rpy:1824
translate chino rutanullaa_cb1aea58:

    # "No te aventuras a preguntar..."
    "你不敢再问……"

# game/rutas/nulla.rpy:1827
translate chino rutanullaa_d8c12e76:

    # "Caminan a paso lento mientras observas como poco a poco, lo negro deja de existir para dar cabida a un blanco puro."
    "你们缓步前行，你看着黑色渐渐消失，让位于一片纯白。"

# game/rutas/nulla.rpy:1828
translate chino rutanullaa_345fb04b:

    # "Todo el tiempo en silencio. Supones que debe ser porque Nulla está ocupado consumiendo lo que queda del dominio de Unum y Quinque."
    "一路沉默。你猜想，大概是 Nulla 正忙于吞噬 Unum 与 Quinque 残余的领域。"

# game/rutas/nulla.rpy:1829
translate chino rutanullaa_5fdb974d:

    # nulla "Listo... estamos listos."
    nulla "好了……我们准备好了。"

# game/rutas/nulla.rpy:1831
translate chino rutanullaa_26bd8f08:

    # "Eso le basta como aviso para tragarte en el vacío."
    "这句话足够作为预告，随后便将你吞入了虚空。"

# game/rutas/nulla.rpy:1833
translate chino rutanullaa_ef23a243:

    # "Está vez, Nulla te mira con cansancio, pero-"
    "这一次，Nulla 疲惫地望着你，但——"

# game/rutas/nulla.rpy:1834
translate chino rutanullaa_e7b445b6:

    # "Sonriente..."
    "面带微笑……"

# game/rutas/nulla.rpy:1835
translate chino rutanullaa_1b19d758:

    # "No se ve afectado como la otra vez."
    "他看起来并不像上次那样受到影响。"

# game/rutas/nulla.rpy:1837
translate chino rutanullaa_3d3fc1a1:

    # nulla "Oh, no te preocupes por eso. Ya te lo dije."
    nulla "哦，别担心那个。我早跟你说过了。"

# game/rutas/nulla.rpy:1838
translate chino rutanullaa_ee44d7e2:

    # nulla "No más lloriqueos a partir de ahora."
    nulla "从今以后，不要再哭哭啼啼了。"

# game/rutas/nulla.rpy:1839
translate chino rutanullaa_cf8246fb:

    # "El silencio que se genera es denso, pero no sabes que más decir."
    "随之而来的沉默沉重无比，而你也想不出还能说什么。"

# game/rutas/nulla.rpy:1840
translate chino rutanullaa_29173253:

    # "Así que solo lo miras a los ojos."
    "于是你只是直直望进他的双眼。"

# game/rutas/nulla.rpy:1842
translate chino rutanullaa_7834441f:

    # "Él sonríe un poco más."
    "他的笑容又多了一分。"

# game/rutas/nulla.rpy:1844
translate chino rutanullaa_e10d5f6a:

    # nulla "Me quedaría el resto del día aquí... pero te prometí pasar el día en casa."
    nulla "我本想今天剩下的时间都留在这里……但我答应过要陪你在家过一整天。"

# game/rutas/nulla.rpy:1848
translate chino rutanullaa_36a00718:

    # "Reaparecen en el dominio de Nulla, lo sabes por su naturaleza parecida a un boceto, pero, es un lugar que no reconoces."
    "你们重新出现在 Nulla 的领域中——从那如草图般的特质你便认得出来，但这地方你从未见过。"

# game/rutas/nulla.rpy:1849
translate chino rutanullaa_54f4528a:

    # "Es un lugar aislado, donde quiera que mires ves que al lugar lo rodea un río negro."
    "这是个与世隔绝的地方，无论你望向何处，都能看到一条黑色的河流环绕着它。"

# game/rutas/nulla.rpy:1850
translate chino rutanullaa_1cc7d98e:

    # "Lo único que tiene color aquí son el mar de flores que están en el piso."
    "这里唯一有颜色的，是地面上那一片花海。"

# game/rutas/nulla.rpy:1851
translate chino rutanullaa_54cef835:

    # "Pintadas de un amarillo vibrante y cálido."
    "它们被染成了鲜亮而温暖的黄色。"

# game/rutas/nulla.rpy:1852
translate chino rutanullaa_a081d684:

    # "Todas parecen ser del mismo tipo, pero no reconoces que tipo o el nombre de la flor."
    "它们似乎属于同一品种，可你认不出是什么花，也叫不出它的名字。"

# game/rutas/nulla.rpy:1855
translate chino rutanullaa_409f8636_17:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:1856
translate chino rutanullaa_8c68a883:

    # nulla "No lo sé."
    nulla "我不知道。"

# game/rutas/nulla.rpy:1860
translate chino rutanullaa_c0d6bed4:

    # "Nulla mira con una expresión afligida a las flores, y no sabes si es porque aún se siente mal por el gasto enorme de energía que ha consumido o por otra cosa más."
    "Nulla 望着那片花，神情哀伤。你不知道他是在为刚才消耗的庞大能量而难受，还是因为别的什么。"

# game/rutas/nulla.rpy:1862
translate chino rutanullaa_425fd7fb:

    # "Nulla comienza a caminar en medio del campo de flores, sin importarle en lo más mínimo si las pisa o rompe en el proceso."
    "Nulla 开始穿行于花田之中，丝毫不在乎是否会踩到或碾碎它们。"

# game/rutas/nulla.rpy:1863
translate chino rutanullaa_ebb13787:

    # "Y en efecto, con cada contacto de sus pies en el suelo, las flores se rompen."
    "果然，他的脚每触碰一次地面，花朵便碎裂一片。"

# game/rutas/nulla.rpy:1864
translate chino rutanullaa_130ec064:

    # "No mira sus pies, sus ojos están enfocados en el mirar hacia delante, con un objetivo claro, pero no mira donde pisa o las consecuencias que tiene su acción..."
    "他不看自己的脚下，目光坚定地投向前方，心无旁骛，既不看踩到了哪里，也不顾自己行为的后果……"

# game/rutas/nulla.rpy:1865
translate chino rutanullaa_61309843:

    # nulla "El amarillo es mi color favorito."
    nulla "黄色是我最喜欢的颜色。"

# game/rutas/nulla.rpy:1866
translate chino rutanullaa_f2a01482:

    # nulla "A ella le gustaban las flores amarillas y en nuestro jardín teníamos unas cuantas."
    nulla "她喜欢黄色的花，我们的花园里就种了不少。"

# game/rutas/nulla.rpy:1867
translate chino rutanullaa_a56c112a:

    # nulla "Las cuidaba."
    nulla "我照料它们。"

# game/rutas/nulla.rpy:1868
translate chino rutanullaa_5ab801e2:

    # nulla "Pero, nunca me dijo como se llamaban..."
    nulla "可她从未告诉我它们的名字……"

# game/rutas/nulla.rpy:1869
translate chino rutanullaa_b5a1582d:

    # nulla "Y no importa cuantas veces le describí a Madre su apariencia, nunca pudimos recrear las flores que alguna vez tuve con Mary..."
    nulla "无论我向母亲描述过多少次它们的样貌，我们都没能重现当年我与 Mary 一起拥有的那些花……"

# game/rutas/nulla.rpy:1874
translate chino rutanullaa_ff5716d9:

    # nulla "Mi hermana."
    nulla "我的姐姐。"

# game/rutas/nulla.rpy:1875
translate chino rutanullaa_6b0923aa:

    # nulla "Fuimos creados al mismo tiempo, y en una de las tantas ideas desechadas del Creador, fuimos hermanos."
    nulla "我们同时被创造出来，在造物主众多被弃置的想法之一中，我们成了兄妹。"

# game/rutas/nulla.rpy:1876
translate chino rutanullaa_ef44ca7c:

    # nulla "Somos hermanos..."
    nulla "我们是兄妹……"

# game/rutas/nulla.rpy:1877
translate chino rutanullaa_05ef0a20:

    # "Nulla baja la mirada y es ahí cuando se da cuenta de lo que ha hecho."
    "Nulla 垂下目光，就在那时，他意识到自己做了什么。"

# game/rutas/nulla.rpy:1878
translate chino rutanullaa_dbc523eb:

    # "Como si sus ojos no lo creyeran, levanta un pie para confirmar lo obvio. Ha aplastado todas las flores que estaban en su camino."
    "仿佛双眼不愿相信，他抬起一只脚，证实了显而易见的事实：他踩碎了沿途所有的花。"

# game/rutas/nulla.rpy:1880
translate chino rutanullaa_bb6b515c_1:

    # nulla "Oh."
    nulla "哦。"

# game/rutas/nulla.rpy:1881
translate chino rutanullaa_491663b1:

    # nulla "Se me ha olvidado que con tus ojos esto puede pasar, ja--"
    nulla "我忘了，用你这双眼睛看着，是会出这种事的，哈——"

# game/rutas/nulla.rpy:1882
translate chino rutanullaa_973ee66a:

    # "No comenta nada más."
    "他再没说什么。"

# game/rutas/nulla.rpy:1884
translate chino rutanullaa_522c2b23:

    # "Miras como ha quedado una de las tantas flores que Nulla ha pisado... el ambiente se ha vuelto pesado, más de lo que puedes aguantar sin sentir una presión extraña en el pecho."
    "你看着 Nulla 踩过的无数花朵中，某一朵如今的模样……气氛沉重得超出你能承受的限度，胸口涌起一种异样的压迫感。"

# game/rutas/nulla.rpy:1885
translate chino rutanullaa_66a7d483:

    # "Algo dentro de ti duele, pero no es por algo propio tuyo."
    "你身体里的某个地方在痛，但那并非源自你自己。"

# game/rutas/nulla.rpy:1886
translate chino rutanullaa_a3dc6f69:

    # "Es por Nulla."
    "那痛是因为 Nulla。"

# game/rutas/nulla.rpy:1887
translate chino rutanullaa_2d92df4b:

    # el "Nulla."
    el "Nulla。"

# game/rutas/nulla.rpy:1888
translate chino rutanullaa_d7632bbd:

    # "Es escucha una voz que resuena en todo el lugar, muy parecido a la voz de Septem en el hotel."
    "你听见一个声音在整个空间中回荡，与 Septem 在酒店里的声音十分相似。"

# game/rutas/nulla.rpy:1889
translate chino rutanullaa_25154b27:

    # "Algo distorsionada y omnipresente, originándose en todos los puntos del espacio a la vez."
    "那声音扭曲而无处不在，仿佛同时从空间的每一个点上涌出。"

# game/rutas/nulla.rpy:1890
translate chino rutanullaa_fe7ee260:

    # "Te marea un poco."
    "有点头晕。"

# game/rutas/nulla.rpy:1892
translate chino rutanullaa_1effd02e:

    # "Detrás de Nulla, una figura se materializa."
    "Nulla身后，一个身影显现出来。"

# game/rutas/nulla.rpy:1894
translate chino rutanullaa_c6505fcb:

    # "Es Madre, tan gloriosa como la última vez que la viste..."
    "是母亲，和你上次见到她时一样光彩照人……"

# game/rutas/nulla.rpy:1895
translate chino rutanullaa_3fe92323:

    # madre "Nulla, tenemos que hablar."
    madre "Nulla，我们得谈谈。"

# game/rutas/nulla.rpy:1896
translate chino rutanullaa_36350144:

    # nulla "¿Realmente es necesario hacerlo ahora?"
    nulla "现在就非得这么做吗？"

# game/rutas/nulla.rpy:1897
translate chino rutanullaa_cbd855f4:

    # madre "Si no es ahora, tal vez sigas cometiendo errores."
    madre "现在不做，你也许还会继续犯错。"

# game/rutas/nulla.rpy:1898
translate chino rutanullaa_f3352c3a:

    # "Madre hace una expresión de desagrado antes de continuar ante el silencio de Nulla."
    "母亲露出不悦的神情，随后在Nulla的沉默中继续说道。"

# game/rutas/nulla.rpy:1900
translate chino rutanullaa_4b980423:

    # madre "No debería estarme explicando, {b}Neo{b} querido."
    madre "我本不必解释的，亲爱的{b}Neo{b}。"

# game/rutas/nulla.rpy:1902
translate chino rutanullaa_d8a8eb06:

    # "Lo último que ves es como la figura de Nulla tiembla y se rompe transformándose en algo monstruoso. "
    "你最后看到的，是Nulla的身影颤抖着碎裂开来，化作某种怪物。"

# game/rutas/nulla.rpy:1903
translate chino rutanullaa_66e62b9d:

    # "Tu cuerpo, hace lo mismo. No duele, pero sientes como tu cara se rompe, junto con los brazos y piernas."
    "你的身体也一样。不疼，但你能感觉到自己的脸，连同双臂双腿一起碎裂开来。"

# game/rutas/nulla.rpy:1904
translate chino rutanullaa_1d0dedbb:

    # "Caes al suelo y dejas escuchar."
    "你瘫倒在地，任由自己去聆听。"

# game/rutas/nulla.rpy:1906
translate chino rutanullaa_739e6e8d:

    # "Dejas de ver..."
    "你看不见了……"

# game/rutas/nulla.rpy:1907
translate chino rutanullaa_5f7713b2:

    # "Dejas de sentir."
    "你再也感觉不到了。"

# game/rutas/nulla.rpy:1908
translate chino rutanullaa_d0a95bb7:

    # "{glitch=20.0}{color=ffffff}{b}_____________________________________________{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}_____________________________________________{/glitch}"

# game/rutas/nulla.rpy:1909
translate chino rutanullaa_94acaf39:

    # "FIN DEL ACTO 2."
    "第二幕结束。"

# game/rutas/nulla.rpy:1911
translate chino rutanullaa_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2}你还得再等等，才能知道这个故事如何收场……:3{/sc}"

# game/rutas/nulla.rpy:1951
translate chino null_d39cdb4c:

    # "Nulla te agarra la mano y te sonríe de medio lado."
    "Nulla抓住你的手，冲你露出一个半边嘴角的笑。"

# game/rutas/nulla.rpy:2015
translate chino null_e40da6a6:

    # "Por el rabillo del ojo, vez una sombra."
    "余光里，你瞥见一道阴影。"

# game/rutas/nulla.rpy:2016
translate chino null_93cb7cb7:

    # "Y no puedes evitar sentirte atraído a ella."
    "你无法抗拒地被它吸引。"

# game/rutas/nulla.rpy:2024
translate chino null_fcbbe199:

    # creador "{size=*1.4} Aburridoooo. Te he dejado un pequeño regalo por si quieres probar la otra opción.{/size}"
    creador "{size=*1.4}无聊死了。我给你留了份小礼物，如果你想试试另一个选项的话。{/size}"

# game/rutas/nulla.rpy:2025
translate chino null_beaf5b23:

    # creador "{size=*1.4}Creéme que es más interesante que está.{/size}"
    creador "{size=*1.4}相信我，它比看上去要有趣得多。{/size}"

# game/rutas/nulla.rpy:2026
translate chino null_fd4d32b3:

    # creador "{size=*1.4}Revisa tus guardados, tal vez tengas tiempo de echarle un ojo en algún momento.{/size}"
    creador "{size=*1.4}看看你的存档，说不定哪天你有空可以翻一翻。{/size}"

# game/rutas/nulla.rpy:2027
translate chino null_deff30ac:

    # creador "{size=*1.4}No te preocupes, yo tengo todo el tiempo del mundo.{/size}"
    creador "{size=*1.4}别担心，我拥有世上所有的时间。{/size}"


translate chino strings:

    # game/rutas/nulla.rpy:713
    old "¿Te ha pasado algo?"
    new "你出什么事了吗？"

    # game/rutas/nulla.rpy:713
    old "Claro"
    new "当然。"

    # game/rutas/nulla.rpy:755
    old "Quiero saber más."
    new "我想多知道一些。"

    # game/rutas/nulla.rpy:755
    old "No necesito saberlo."
    new "我不想知道。"

    # game/rutas/nulla.rpy:858
    old "No, debes dormir"
    new "不，你得睡觉。"

    # game/rutas/nulla.rpy:858
    old "Ir a buscar a Nulla"
    new "去找Nulla"

    # game/rutas/nulla.rpy:916
    old "¿A qué te refieres?"
    new "你指的是什么？"

    # game/rutas/nulla.rpy:935
    old "Tomar su mano y apoyarlo"
    new "握住他的手，扶住他"

    # game/rutas/nulla.rpy:935
    old "Sacarlo de ahí"
    new "把他从那里拉出来"

    # game/rutas/nulla.rpy:960
    old "Consolarlo."
    new "安慰他。"

    # game/rutas/nulla.rpy:976
    old "¿? no comprendes lo que quiere decir"
    new "嗯？你不明白他想说什么。"

    # game/rutas/nulla.rpy:1006
    old "Mi palabra favorita..."
    new "我最喜欢的词……"

    # game/rutas/nulla.rpy:1085
    old "¿Qué hay de Septem?"
    new "那Septem呢？"

    # game/rutas/nulla.rpy:1085
    old "¿Unum?"
    new "Unum呢？"

    # game/rutas/nulla.rpy:1085
    old "¿Iremos a por Tria y Sextam?"
    new "我们去找Tria和Sextam吗？"

    # game/rutas/nulla.rpy:1154
    old "¿Ahora?"
    new "现在？"

    # game/rutas/nulla.rpy:1174
    old "No, quiero quedarme aquí por un rato más"
    new "不，我想再多待一会儿。"

    # game/rutas/nulla.rpy:1232
    old "¿Bebés?"
    new "宝宝们？"

    # game/rutas/nulla.rpy:1232
    old "¿Te refieres a los animales?"
    new "你是指动物吗？"

    # game/rutas/nulla.rpy:1259
    old "Si, por favor."
    new "好，拜托了。"

    # game/rutas/nulla.rpy:1259
    old "No, gracias."
    new "不了，谢谢。"

    # game/rutas/nulla.rpy:1321
    old "¡Hey!"
    new "喂！"

    # game/rutas/nulla.rpy:1321
    old "No soy el reemplazo de nadie."
    new "我不是任何人的替代品。"

    # game/rutas/nulla.rpy:1355
    old "Escapar."
    new "逃离。"

    # game/rutas/nulla.rpy:1355
    old "Intentar conversar."
    new "试着交谈。"

    # game/rutas/nulla.rpy:1420
    old "ignorar..."
    new "无视……"

    # game/rutas/nulla.rpy:1420
    old "Apoyar a Quinque"
    new "支持Quinque"

    # game/rutas/nulla.rpy:1455
    old "Pedirle por favor que acabe con él rápido."
    new "拜托他快点了结他。"

    # game/rutas/nulla.rpy:1525
    old "Comerla"
    new "吃了它"

    # game/rutas/nulla.rpy:1525
    old "Hacerle caso."
    new "听他的话。"

    # game/rutas/nulla.rpy:1555
    old "¿Qué?"
    new "什么？"

    # game/rutas/nulla.rpy:1555
    old "Pero el trato dice..."
    new "可交易里说……"

    # game/rutas/nulla.rpy:1555
    old "No quiero."
    new "我不想。"

    # game/rutas/nulla.rpy:1610
    old "Está bien..."
    new "好吧……"

    # game/rutas/nulla.rpy:1732
    old "¿Dejaron de funcionar?"
    new "它们停止运转了吗？"

    # game/rutas/nulla.rpy:1732
    old "Me alegra que no duela..."
    new "还好不疼……"

    # game/rutas/nulla.rpy:1771
    old "Claro, yo te sostengo."
    new "当然，我会抱着你。"

    # game/rutas/nulla.rpy:1771
    old "¿Por qué debo hacerlo?"
    new "为什么我非得这么做？"

    # game/rutas/nulla.rpy:1853
    old "¿Qué flor es esta?"
    new "这是什么花？"

    # game/rutas/nulla.rpy:1870
    old "¿Mary?"
    new "Mary？"

    # game/rutas/nulla.rpy:2019
    old "Ir a la sombra."
    new "走向那道阴影。"

    # game/rutas/nulla.rpy:2019
    old "Seguir a Nulla."
    new "跟着Nulla。"

# TODO: Translation updated at 2025-02-23 15:17

# game/rutas/nulla.rpy:1583
translate chino rutanullaa_e2b01252:

    # "O mejor dicho, su versión femenina."
    "或者更准确地说，是她的女性版本。"

# game/rutas/nulla.rpy:1588
translate chino rutanullaa_1cbeedf6:

    # "Nulla solo sonríe complacido con tu respuesta."
    "Nulla只是对你的回答心满意足地笑了笑。"

# game/rutas/nulla.rpy:1593
translate chino rutanullaa_38c150f2:

    # "Nulla te mira en silencio."
    "Nulla沉默地看着你。"

# game/rutas/nulla.rpy:1606
translate chino rutanullaa_8cae4b3d:

    # "Nulla cambia su forma una vez más. A la original, como si estuviera jugando para obtener tu aprobación.."
    "Nulla又一次变换了形态，变回最初的样子，像是在努力博取你的认可。"

# TODO: Translation updated at 2025-02-23 17:02

# game/rutas/nulla.rpy:1345
translate chino rutanullaa_6ac3c178:

    # "Por lo que solo lo miras, mientras hace sus preguntas retóricas."
    "于是你只是看着他，听他问那些明知故问的问题。"

# TODO: Translation updated at 2025-02-23 19:20

translate chino strings:

    # game/rutas/nulla.rpy:4
    old "Madre"
    new "母亲"

# TODO: Translation updated at 2025-02-24 01:14

# game/rutas/nulla.rpy:944
translate chino rutanullaa_dece6de2:

    # "{sc=3}Pero dudo que Nulla se sienta tranquilo si hablo desde el " yo ".{/sc}"
    "{sc=3}但我怀疑，若我以“我”自称，Nulla能否安心。{/sc}"

# TODO: Translation updated at 2025-02-24 01:18

# game/rutas/nulla.rpy:944
translate chino rutanullaa_151cb834:

    # "{sc=3}Pero dudo que Nulla se sienta tranquilo si hablo desde el 'yo'.{/sc}"
    "{sc=3}但我怀疑，若我以“我”自称，Nulla能否安心。{/sc}"

# TODO: Translation updated at 2025-02-25 00:18

# game/rutas/nulla.rpy:827
translate chino rutanullaa_8d0ca970:

    # "Al menos no se lo toma de forma irrespetuosa, no hay ningún comentario mal intencionado o algún rastro de risa."
    "至少他没有以轻慢的态度对待，没有恶意的评论，也没有一丝笑意。"

# game/rutas/nulla.rpy:831
translate chino rutanullaa_38153fcb:

    # "Caminan por las calles vacías sin algún tipo de conversación que acompañe el ambiente lúgubre del recorrido. Nulla ha estado callado y cabizbajo por un largo período de tiempo."
    "两人穿过空荡的街道，一路沉默，正合这阴郁的气氛。Nulla已经沉默而垂头丧气了很久。"

# game/rutas/nulla.rpy:898
translate chino rutanullaa_f1d63af2:

    # nulla "Pensaba que-- como esto ya había pasado en mi otra vida, sería más fácil..."
    nulla "我原以为——既然这些在我上一世就已经发生过——会更容易些……"

# game/rutas/nulla.rpy:901
translate chino rutanullaa_d20e14b7:

    # nulla "Tengo muchos recuerdos de ella, que se han liberado al consumir su dominio... ella, me tenía una alta estima... aún."
    nulla "关于她，我有很多记忆，都在吞噬她的领域时释放了出来……她……至今依然十分看重我……"

# game/rutas/nulla.rpy:911
translate chino rutanullaa_2e728cf1:

    # "Nulla coloca ambas manos en su cara, cubriendo su expresión y comienza a balbucear palabras que no logras comprender."
    "Nulla把双手覆在脸上，遮住自己的神情，开始含糊不清地嘟囔着你听不懂的话。"

# game/rutas/nulla.rpy:955
translate chino rutanullaa_e1ae1ad8:

    # "Acaricias su espalda y das pequeñas palmadas, para ayudar a liberar esos sobrecogedores sentimientos, mezclados y atados, que se traducen en un llanto."
    "你轻抚他的背，又轻轻拍着，帮他释放那些汹涌、纷乱、纠缠在一起、最终化作泪水的情绪。"

# game/rutas/nulla.rpy:1050
translate chino rutanullaa_550df210:

    # nulla "Ya no más lloriqueos, lo prometo."
    nulla "我不抱怨了，我保证。"

# game/rutas/nulla.rpy:1057
translate chino rutanullaa_45f9507b:

    # "Pero a pesar de estar en el país de los sueños y deseos."
    "尽管身处这梦与欲望的国度。"

# game/rutas/nulla.rpy:1273
translate chino rutanullaa_493c34b4:

    # "Te sorprende un poco sus palabras. Se oye sincero, muy considerado de la situación."
    "他的话让你有些意外。听起来很真诚，也很体谅当下的处境。"

# game/rutas/nulla.rpy:1671
translate chino rutanullaa_2bf16ecc:

    # "Te mira con una sonrisa inquietante."
    "他看着你，笑容令人不安。"

# game/rutas/nulla.rpy:2027
translate chino null_adc33d10:

    # creador "{size=*1.4}créeme que es más interesante que está.{/size}"
    creador "{size=*1.4}相信我，它比看上去要有趣得多。{/size}"

# TODO: Translation updated at 2025-10-05 02:57

# game/rutas/nulla.rpy:35
translate chino rutanullaa_dbefcae4:

    # nulla "{glitch=20.0}{color=ffffff}{b}Que no puede materializarse en tu mundo{/glitch}"
    nulla "{glitch=20.0}{color=ffffff}{b}我无法在你的世界中实体化{/glitch}"

# game/rutas/nulla.rpy:123
translate chino rutanullaa_02219582:

    # "Escuchas y sientes como Nulla toca suelo con sus pies, para luego ser rodeados de luz y colores que te dejan con una ceguera momentánea."
    "你听见并感觉到Nulla的双脚落地，紧接着光与色彩将你们包围，让你瞬间眼前一片空白。"

# game/rutas/nulla.rpy:146
translate chino rutanullaa_e1579684:

    # "Ya en la cocina, Nulla procede a buscar en sus encimeras y cajones elementos para cocinar algo que supones debe ser dulce. Pues ha sacado el azúcar y el café de una de las encimeras, mientras busca, él habla."
    "到了厨房，Nulla开始在台面和抽屉里翻找食材，想做些你猜应该是甜的东西。他从某个柜子里取出糖和咖啡，一边找一边开口说话。"

# game/rutas/nulla.rpy:181
translate chino rutanullaa_c3eb0993:

    # "Nulla no te deja rebatirle."
    "Nulla不让你反驳。"

# game/rutas/nulla.rpy:326
translate chino rutanullaa_4f45596b:

    # nulla "Verás, la marioneta se ha convertido en un medio de confirmación gracias a ti."
    nulla "你要知道，多亏了你，这具傀儡才成了一种验证的手段。"

# game/rutas/nulla.rpy:333
translate chino rutanullaa_f7c65076:

    # nulla "Es como la paradoja del árbol que cae..."
    nulla "就像倒掉的树的那个悖论……"

# game/rutas/nulla.rpy:610
translate chino rutanullaa_9b791ad4:

    # "Un centenar de manos salen del suelo y agarran por las extremidades a Quattor."
    "上百只手从地底升起，抓住Quattor的四肢。"

# game/rutas/nulla.rpy:644
translate chino rutanullaa_899eee52:

    # nulla "Antiguamente ella fue mi aprendiz..."
    nulla "很久以前，她是我的学徒……"

# game/rutas/nulla.rpy:658
translate chino rutanullaa_da18aeea:

    # nulla "Piensa en mí como una cebolla."
    nulla "就把我想象成一颗洋葱。"

# game/rutas/nulla.rpy:676
translate chino rutanullaa_b9f25fff:

    # nulla "Eres el mejor aprendiz que he tenido."
    nulla "你是我教过最好的学徒。"

# game/rutas/nulla.rpy:739
translate chino rutanullaa_436c7922:

    # nulla "En la época donde estaba el Creador, él puso una serie de reglas... tontas, pero al fin y al cabo reglas para mantener al jardín estable."
    nulla "在造物主还在的时候，他定下了一系列规则……愚蠢，但终究是规则，为了让花园保持稳定。"

# game/rutas/nulla.rpy:771
translate chino rutanullaa_baf447a8:

    # nulla "Por lo que a ninguno se les ha pasado por la cabeza asesinar al otro, pues sería más difícil mantener dos conceptos."
    nulla "所以谁也没动过杀死对方的念头，因为那样要同时维持两个概念只会更难。"

# game/rutas/nulla.rpy:949
translate chino rutanullaa_3065b328:

    # "Pero sientes como Nulla aprieta tu mano con fuerza."
    "但你感觉到Nulla紧紧握住了你的手。"

# game/rutas/nulla.rpy:1147
translate chino rutanullaa_43c358d2:

    # "Imaginas una vida común y corriente junto con él, haciendo cosas cotidianas, yendo de compras para llenar la despensa... citas y quién sabe qué otras cosas más... y no se ve para nada mal."
    "你想象着与他共度平凡的一生——做些日常小事，去采购填满储物柜……约会，还有谁知道些什么……看起来一点也不坏。"

# game/rutas/nulla.rpy:1381
translate chino rutanullaa_2beea75e:

    # "En un intento patético de formar un escudo."
    "一次可悲的、想要撑起护盾的尝试。"

# game/rutas/nulla.rpy:1655
translate chino rutanullaa_0265bbfd:

    # "Sientes como algo se enreda en tu cuello y te arrebata de los brazos de Nulla."
    "你感觉到有什么东西缠住了你的脖子，把你从Nulla的怀里拽了出去。"

# game/rutas/nulla.rpy:1911
translate chino rutanullaa_268fb93a:

    # "_______________________________________________________________________________________________"
    "_______________________________________________________________________________________________"

# game/rutas/nulla.rpy:1912
translate chino rutanullaa_eaac225b:

    # " ___________________________________ "
    " ___________________________________ "

# game/rutas/nulla.rpy:1913
translate chino rutanullaa_05c6ac1d:

    # " . . . . . "
    " . . . . . "

# game/rutas/nulla.rpy:1915
translate chino rutanullaa_2ab8f681:

    # madre "Con esto será suficiente."
    madre "这样就够了。"

# game/rutas/nulla.rpy:1916
translate chino rutanullaa_741be751:

    # madre "Espero que te quede claro."
    madre "希望你明白了。"

# game/rutas/nulla.rpy:1917
translate chino rutanullaa_2ac54334:

    # "¿Esa es la voz de Madre?"
    "那是母亲的声音吗？"

# game/rutas/nulla.rpy:1918
translate chino rutanullaa_05c6ac1d_1:

    # " . . . . . "
    " . . . . . "

# game/rutas/nulla.rpy:1919
translate chino rutanullaa_c51d7991:

    # " . . . "
    " . . . "

# game/rutas/nulla.rpy:1920
translate chino rutanullaa_446775ff:

    # madre "Por poco y se fusionan... Lo siento, no sabía que eso podía pasar."
    madre "它们差点就融合了……对不起，我不知道会发生那种事。"

# game/rutas/nulla.rpy:1921
translate chino rutanullaa_87205f9f:

    # nulla "¿Era necesario hacer eso?"
    nulla "有必要做到这种地步吗？"

# game/rutas/nulla.rpy:1922
translate chino rutanullaa_647edc8e:

    # madre "Es la única forma de hacerte entender. Te estás distrayendo."
    madre "这是让你明白的唯一办法。你走神了。"

# game/rutas/nulla.rpy:1923
translate chino rutanullaa_8ab0ed34:

    # madre "Eso no me gusta."
    madre "我不喜欢那样。"

# game/rutas/nulla.rpy:1924
translate chino rutanullaa_399317c3:

    # nulla "Mi plan va a la perfección. Cómo lo ejecute no es de tu incumbencia."
    nulla "我的计划进行得非常顺利。我如何执行与你无关。"

# game/rutas/nulla.rpy:1925
translate chino rutanullaa_ef36aa83:

    # nulla "Sé un poco más agradecida."
    nulla "稍微多些感激吧。"

# game/rutas/nulla.rpy:1926
translate chino rutanullaa_8f72272b:

    # madre "No voy a aceptar que me hables de esa manera, señorito."
    madre "我不允许你用那种口气跟我说话，小少爷。"

# game/rutas/nulla.rpy:1927
translate chino rutanullaa_a3140b1e:

    # "Una parte dentro de ti comienza a doler."
    "你体内的某个地方开始疼痛。"

# game/rutas/nulla.rpy:1928
translate chino rutanullaa_c5758150:

    # nulla "Ouch! ¡No me aprietes ese ojo!"
    nulla "哎哟！别这样挤我那只眼睛！"

# game/rutas/nulla.rpy:1930
translate chino rutanullaa_378ba819:

    # "Memorias de algo que olvidaste comienzan a brotar como una chispa, las cuales al mismo tiempo que llegan, se esfuman en nada."
    "关于某个被你遗忘的事物的记忆，如同火花般闪现，却又在浮现的瞬间消散为虚无。"

# game/rutas/nulla.rpy:1932
translate chino rutanullaa_278c7e29:

    # "........."
    "........."

# game/rutas/nulla.rpy:1933
translate chino rutanullaa_9ea6b0e1:

    # ".............."
    ".............."

# game/rutas/nulla.rpy:1935
translate chino rutanullaa_d973dd28:

    # "En la blancura del lugar, ves una figura."
    "在这片纯粹的白中，你看见了一个身影。"

# game/rutas/nulla.rpy:1936
translate chino rutanullaa_b7fa4f6e:

    # "Te mira desde lo lejos. sin intención de acercarse."
    "他从远处望着你，并不打算靠近。"

# game/rutas/nulla.rpy:1937
translate chino rutanullaa_de83b4b1:

    # "Pero con una clara fascinación."
    "却带着毫不掩饰的着迷。"

# game/rutas/nulla.rpy:1939
translate chino rutanullaa_89c91fa1:

    # "{glitch=20.0}{color=ffffff}{b}Oh vaya~~ Tú sí que me puedes ayudar.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}哦呀~~看来你确实能帮我。{/glitch}"

# game/rutas/nulla.rpy:1942
translate chino rutanullaa_a20cefa7_24:

    # "..."
    "..."

# game/rutas/nulla.rpy:1944
translate chino rutanullaa_cd64c353:

    # "{glitch=20.0}{color=ffffff}{b}Su pasado y su futuro.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}它的过去，与它的未来。{/glitch}"

# game/rutas/nulla.rpy:1946
translate chino rutanullaa_a20cefa7_25:

    # "..."
    "..."

# game/rutas/nulla.rpy:1948
translate chino rutanullaa_554cfdfa:

    # "La entidad se ríe a carcajadas."
    "那个存在放声大笑。"

# game/rutas/nulla.rpy:1949
translate chino rutanullaa_96b9b9bc:

    # "{glitch=20.0}{color=ffffff}{b}No puedo creer que después de años, recién ahora pueda obtener alguna respuesta de ti.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}真不敢相信，过了这么多年，我直到现在才终于得到你的回应。{/glitch}"

# game/rutas/nulla.rpy:1950
translate chino rutanullaa_188143c7:

    # "{glitch=20.0}{color=ffffff}{b}Increíble.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}不可思议。{/glitch}"


# game/rutas/nulla.rpy:1951
translate chino rutanullaa_3ad1f68e:

    # "{glitch=20.0}{color=ffffff}{b}Bien, escúchame, necesito que vayas al interior de Nulla.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}好，听我说，我要你进入Nulla的内心。{/glitch}"

# game/rutas/nulla.rpy:1955
translate chino rutanullaa_702903ab:

    # "{glitch=20.0}{color=ffffff}{b}Él es un egoísta.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}他是个自私鬼。{/glitch}"

# game/rutas/nulla.rpy:1956
translate chino rutanullaa_d6ff6f7c:

    # "{glitch=20.0}{color=ffffff}{b}Solo porque nos tiene atrapados en su cuerpo, no significa que pueda tomar la decisión por si sólo.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}仅仅因为他把我们囚禁在他的身体里，并不代表他就能独自做决定。{/glitch}"

# game/rutas/nulla.rpy:1959
translate chino rutanullaa_b8b5c6e5:

    # "La figura aparece frente a ti."
    "那身影出现在你面前。"

# game/rutas/nulla.rpy:1960
translate chino rutanullaa_e81657a3:

    # "Es Nulla."
    "是Nulla。"

# game/rutas/nulla.rpy:1963
translate chino rutanullaa_45b32693:

    # "{glitch=20.0}{color=ffffff}{b}JA!{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}哈！{/glitch}"

# game/rutas/nulla.rpy:1964
translate chino rutanullaa_b66a1f2d:

    # "{glitch=20.0}{color=ffffff}{b}Ese no es mi nombre. No soy ese llorón.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}那不是我的名字。我可不是那个爱哭鬼。{/glitch}"

# game/rutas/nulla.rpy:1965
translate chino rutanullaa_3bd61cae:

    # "{glitch=20.0}{color=ffffff}{b}Pero al parecer alguien hizo que nos expulsaran a todos por un segundo, y gracias a eso te puedo contactar.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}不过看来，是有人让我们所有人被短暂地挤出去了一次，多亏如此，我才能联系到你。{/glitch}"

# game/rutas/nulla.rpy:1966
translate chino rutanullaa_daeb2576:

    # "{glitch=20.0}{color=ffffff}{b}Él cuerpo de esta cosa que utilizas es fácil de acceder...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}你所用的这个躯体……很容易进入……{/glitch}"

# game/rutas/nulla.rpy:1967
translate chino rutanullaa_9315a5c5:

    # "{glitch=20.0}{color=ffffff}{b}Aunque creo que solo será por esta vez. Él ya se debe estar dando cuenta de que le falta una capa.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}不过我想，大概只有这一次了。他应该已经意识到自己少了一层。{/glitch}"

# game/rutas/nulla.rpy:1970
translate chino rutanullaa_022a1829:

    # "{glitch=20.0}{color=ffffff}{b}Bueno, ¡no importa!{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}算了，没关系！{/glitch}"

# game/rutas/nulla.rpy:1971
translate chino rutanullaa_b03f668f:

    # "{glitch=20.0}{color=ffffff}{b}Me vas a ayudar, ¿cierto?{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}你会帮我的，对吧？{/glitch}"

# game/rutas/nulla.rpy:1972
translate chino rutanullaa_95b8b586:

    # "{glitch=20.0}{color=ffffff}{b}Haz que se quede más rato en sus memorias.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}让他在自己的记忆里多停留一会儿。{/glitch}"

# game/rutas/nulla.rpy:1975
translate chino rutanullaa_ab81d7f7:

    # "{glitch=20.0}{color=ffffff}{b}Sé que tienes acceso a ellas. Pero lo tienes que hacer antes de que él consiga finalizar su misión.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}我知道你能接触到它们。但你必须在他完成任务之前动手。{/glitch}"

# game/rutas/nulla.rpy:1976
translate chino rutanullaa_68feef8e:

    # "{glitch=20.0}{color=ffffff}{b}Porque luego será imposible para ti tocar un mundo inexistente.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}因为在那之后，你将不可能触及一个已经不存在的世界。{/glitch}"

# game/rutas/nulla.rpy:1977
translate chino rutanullaa_75d283cd:

    # "{glitch=20.0}{color=ffffff}{b}...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}……{/glitch}"

# game/rutas/nulla.rpy:1980
translate chino rutanullaa_bdfedcf9:

    # "{glitch=20.0}{color=ffffff}{b}No se lo digas, pero ya sé una manera para curar todos nuestros males sin la necesidad de acabar con nuestra existencia.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}别告诉他，但我已经知道一种方法，可以治愈我们所有的病症，而不必终结我们的存在。{/glitch}"

# game/rutas/nulla.rpy:1981
translate chino rutanullaa_a3c47ab0:

    # "Él te extiende la mano, esperando a que se la des."
    "他向你伸出手，等你握住。"

# game/rutas/nulla.rpy:1982
translate chino rutanullaa_81691695:

    # "{glitch=20.0}{color=ffffff}{b}Te estaré esperando.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}我会等你的。{/glitch}"

# game/rutas/nulla.rpy:1985
translate chino rutanullaa_693932db:

    # "Pero algo te lo impide, y como si fueras agarrado del cuello, con un solo tirón, tus ojos se abren."
    "但有什么东西阻止了你；就像被人掐住脖子，被猛地一拽，你的眼睛睁大了。"

# game/rutas/nulla.rpy:1986
translate chino rutanullaa_bde7c1a8:

    # "{sc=4}{size=*2.0}................{/size}{/sc}"
    "{sc=4}{size=*2.0}................{/size}{/sc}"

# game/rutas/nulla.rpy:1987
translate chino rutanullaa_556f28e9:

    # "{sc=4}{size=*1.5}..........{/size}{/sc}"
    "{sc=4}{size=*1.5}..........{/size}{/sc}"

# game/rutas/nulla.rpy:1989
translate chino rutanullaa_2d8b13f1:

    # "Estás en la casa de Nulla, acostado en su cama."
    "你躺在Nulla家里的床上。"

# game/rutas/nulla.rpy:1991
translate chino rutanullaa_3b64668f_2:

    # nulla "¡Buenos días!"
    nulla "早安！"

# game/rutas/nulla.rpy:1994
translate chino rutanullaa_3d5515a1:

    # nulla "Disculpa por lo sucedido en la noche anterior."
    nulla "真抱歉昨晚发生了那样的事。"

# game/rutas/nulla.rpy:1997
translate chino rutanullaa_dc2b4827:

    # nulla "Madre quería hablar a solas conmigo."
    nulla "母亲想和我单独谈谈。"

# game/rutas/nulla.rpy:2001
translate chino rutanullaa_a20cefa7_26:

    # "..."
    "..."

# game/rutas/nulla.rpy:2003
translate chino rutanullaa_9dad6265:

    # "Intentas levantarte pero Nulla te lo impide tocando y empujando levemente tus hombros. Haciendo que te recuestes nuevamente en la cama en la que descansas."
    "你想起身，Nulla却轻轻按住你的肩膀，把你推回去，让你重新躺回床上。"

# game/rutas/nulla.rpy:2006
translate chino rutanullaa_15280f80:

    # nulla "Tu cuerpo se rompió cuando Madre dijo mi nombre original."
    nulla "母亲说出我本来的名字时，你的身体碎裂了。"

# game/rutas/nulla.rpy:2007
translate chino rutanullaa_bb44be57:

    # nulla "Tu esencia revoloteaba por todo el lugar, por poco te absorbo por completo..."
    nulla "你的精髓在四处飘散，我差点就把你完全吸收了……"

# game/rutas/nulla.rpy:2012
translate chino rutanullaa_9a96de3d:

    # nulla "No lo sé, ni quiero averiguarlo."
    nulla "我不知道，也不想知道。"

# game/rutas/nulla.rpy:2018
translate chino rutanullaa_ad7a5784:

    # nulla "Awwww--"
    nulla "呜呜……"

# game/rutas/nulla.rpy:2021
translate chino rutanullaa_f8875658:

    # nulla "No te preocupes amor, no me vas a perder tan fácil."
    nulla "别担心，亲爱的，你不会轻易失去我的。"

# game/rutas/nulla.rpy:2022
translate chino rutanullaa_a8875719:

    # "Nulla te toma la mano y te planta un beso en el delicado dorso que ya se ha curado por completo."
    "Nulla握住你的手，在你已经完全愈合的纤细手背上印下一个吻。"

# game/rutas/nulla.rpy:2024
translate chino rutanullaa_a9d8be0a:

    # "Hay una pausa, donde Nulla divaga por un segundo."
    "出现了片刻的停顿，Nulla走神了一秒。"

# game/rutas/nulla.rpy:2028
translate chino rutanullaa_3f8db17d:

    # nulla "Bueno. Ahora que estamos solos nuevamente, te recuerdo--"
    nulla "好了。现在我们又单独在一起了，提醒你一下——"

# game/rutas/nulla.rpy:2031
translate chino rutanullaa_dfc7566e:

    # nulla "Que tenemos dos citas pendientes."
    nulla "我们还有两次约会。"

# game/rutas/nulla.rpy:2033
translate chino rutanullaa_bc922bc9:

    # "Nulla se aleja de la cama y camina a la ventana. Con energía abre las cortinas, dejando entrar la luz que se genera gracias al vacío."
    "Nulla离开床，走向窗边。他一把拉开窗帘，让虚空中生出的光芒照进来。"

# game/rutas/nulla.rpy:2034
translate chino rutanullaa_d076a431:

    # "Es una luz tenue, que no molesta la vista."
    "那光线微弱，并不刺眼。"

# game/rutas/nulla.rpy:2035
translate chino rutanullaa_08af26b7:

    # "Agradable hasta cierto sentido."
    "某种意义上，令人安心。"

# game/rutas/nulla.rpy:2037
translate chino rutanullaa_598e7c15:

    # nulla "Tenemos dos días completos."
    nulla "我们有整整两天。"

# game/rutas/nulla.rpy:2040
translate chino rutanullaa_20a89258:

    # nulla "Hoy te voy a invitar a cenar."
    nulla "今晚我请你吃饭。"

# game/rutas/nulla.rpy:2043
translate chino rutanullaa_fae19b86:

    # nulla "Me gustaría tener un momento de tranquilidad contigo."
    nulla "我想和你拥有一段安静的时光。"

# game/rutas/nulla.rpy:2044
translate chino rutanullaa_02169ce2:

    # nulla "Donde nos atiendan y podamos pasar una buena tarde."
    nulla "一个有人服务、我们可以一起度过美好傍晚的地方。"

# game/rutas/nulla.rpy:2049
translate chino rutanullaa_eb9053d3:

    # "Nulla sonríe mientras junta ambas manos y ladea la cabeza ligeramente."
    "Nulla微笑着双手交握，轻轻歪了歪头。"

# game/rutas/nulla.rpy:2052
translate chino rutanullaa_befd8adf:

    # nulla "A mi hotel."
    nulla "去我的酒店。"

# game/rutas/nulla.rpy:2057
translate chino rutanullaa_c4acff73:

    # nulla "¿Mmm? ¿Realmente te interesan?"
    nulla "嗯？你真的很感兴趣吗？"

# game/rutas/nulla.rpy:2060
translate chino rutanullaa_1d606bd0:

    # nulla "Pensé que te agradaría desconectarte un tiempo de la cacería."
    nulla "我还以为你会想暂时从狩猎中抽身歇一歇。"

# game/rutas/nulla.rpy:2063
translate chino rutanullaa_c9672d37:

    # nulla "Además, no vendría mal hacer esperar a Septem."
    nulla "而且，让Septem等一等也没什么不好。"

# game/rutas/nulla.rpy:2064
translate chino rutanullaa_d7c0e1ae:

    # nulla "Y atacar cuando menos se lo espere."
    nulla "然后在最意想不到的时候出手。"


# game/rutas/nulla.rpy:2069
translate chino rutanullaa_5b4aeae7:

    # nulla "Mmmm, no lo creo."
    nulla "嗯……我不这么觉得。"

# game/rutas/nulla.rpy:2072
translate chino rutanullaa_41a873b6:

    # nulla "No creo que haya mucho de lo cual podamos disfrutar ya."
    nulla "我想我们已经没有多少东西可以享受了。"

# game/rutas/nulla.rpy:2073
translate chino rutanullaa_a3de923a:

    # nulla "Debe estar todo oscuro, salvo los dominios que he consumido."
    nulla "一切都该漆黑一片，除了我吞噬的那些领域。"

# game/rutas/nulla.rpy:2076
translate chino rutanullaa_11892f52:

    # nulla "Así que no lo recomiendo."
    nulla "所以我不建议你这么做。"

# game/rutas/nulla.rpy:2080
translate chino rutanullaa_a20cefa7_27:

    # "..."
    "..."

# game/rutas/nulla.rpy:2083
translate chino rutanullaa_73c31359:

    # nulla "Iré a hacer el desayuno, tu marioneta se encuentra muy débil como para pararse ahora mismo."
    nulla "我去准备早餐，你的傀儡现在太虚弱了，还站不起来。"

# game/rutas/nulla.rpy:2084
translate chino rutanullaa_fe748d7c:

    # nulla "Y la necesitamos en las mejores condiciones para poder tener nuestro tiempo sin ningún contratiempo."
    nulla "而且我们需要它保持在最佳状态，才能不被打扰地共度我们的时光。"

# game/rutas/nulla.rpy:2086
translate chino rutanullaa_0c810434:

    # "Nulla se deshace como si de humo fuera, dejando un gran hoyo negro en el suelo que te demuestra que se ha teletransportado hacia la cocina, supones."
    "Nulla像烟雾般消散，地板上留下一个巨大的黑洞，你猜想那证明他传送去了厨房。"

# game/rutas/nulla.rpy:2087
translate chino rutanullaa_5b746db6:

    # "Parte de ti espera tener una nueva conversación con la entidad que te contactó antes de despertar."
    "你的一部分期待着，能再次与那个在你醒来前联系过你的存在对话。"

# game/rutas/nulla.rpy:2088
translate chino rutanullaa_f767d756:

    # "Pero en tu interior solo te encuentras con tus pensamientos y los latidos de tu fragmentado corazón."
    "但在你体内，你只找到自己的思绪，以及那颗破碎心脏的跳动。"

# game/rutas/nulla.rpy:2089
translate chino rutanullaa_1d34a315:

    # "Solo eso y nada más."
    "仅此而已，再没有别的。"

# game/rutas/nulla.rpy:2090
translate chino rutanullaa_28880850:

    # "Cuando el silencio sobrepasa tu límite decides mirar la ventana."
    "当沉默超过你的承受限度，你决定望向窗外。"

# game/rutas/nulla.rpy:2091
translate chino rutanullaa_300c6b95:

    # "Y te preguntas por cómo estará el resto del jardín en este momento."
    "你想知道此刻花园其余的部分是什么样子。"

# game/rutas/nulla.rpy:2092
translate chino rutanullaa_40915037:

    # "De cierta manera, sientes una curiosidad mórbida en saber y ver el estado de los dominios que quedan."
    "某种程度上，你怀着一种病态的好奇，想知道并看看剩下的领域是什么状态。"

# game/rutas/nulla.rpy:2093
translate chino rutanullaa_a78fe8c3:

    # "Al igual que quieres apreciar cómo están los dominios consumidos por Nulla."
    "同样，你也想看看被Nulla吞噬的领域如今是什么样。"

# game/rutas/nulla.rpy:2094
translate chino rutanullaa_180dbe97:

    # "¿Estarán completamente negros o blancos?"
    "它们会是完全漆黑，还是一片雪白？"

# game/rutas/nulla.rpy:2095
translate chino rutanullaa_4d2c4193:

    # nulla "Amoooor~"
    nulla "亲爱的~~"

# game/rutas/nulla.rpy:2096
translate chino rutanullaa_48362f84:

    # nulla "No dejes que la marioneta te amargue este día."
    nulla "别让这具傀儡毁了你的一天。"

# game/rutas/nulla.rpy:2097
translate chino rutanullaa_c2b97a06:

    # nulla "Hoy y mañana tienen que ser días de puro disfrute <3"
    nulla "今天和明天都该是尽情享受的日子 <3"

# game/rutas/nulla.rpy:2098
translate chino rutanullaa_6facb596:

    # "Nulla aparece esta vez por la puerta que está entreabierta, empujándola con uno de sus apéndices hechos de vacío."
    "这次Nulla出现在半掩的门边，用一只由虚空构成的附肢轻轻把门推开。"

# game/rutas/nulla.rpy:2099
translate chino rutanullaa_3c47cfc4:

    # "Y es ahí cuando te llega el aroma a pan caliente y a café recién elaborado."
    "就在这时，热面包和现煮咖啡的香气飘了过来。"

# game/rutas/nulla.rpy:2100
translate chino rutanullaa_a0549a5f:

    # "El olor inunda la habitación al instante en que tus ojos se posan en la bandeja que trae Nulla entre sus manos."
    "当你的目光落在Nulla手中端着的托盘上时，香气瞬间充满了整个房间。"

# game/rutas/nulla.rpy:2101
translate chino rutanullaa_a46a8294:

    # "Esta vez es un desayuno para dos."
    "这一次，是两个人的早餐。"

# game/rutas/nulla.rpy:2103
translate chino rutanullaa_f296ce32:

    # "Se sienta contigo en la cama, posando la bandeja sobre las mantas, mientras que con uno de sus apéndices te ofrece tu taza."
    "他和你一起坐在床上，把托盘放在毯子上，用一只附肢把属于你的杯子递给你。"

# game/rutas/nulla.rpy:2104
translate chino rutanullaa_14c432e0:

    # "Pero está vacía."
    "但杯子是空的。"

# game/rutas/nulla.rpy:2105
translate chino rutanullaa_58558870:

    # "Tú le miras con confusión."
    "你困惑地看着他。"

# game/rutas/nulla.rpy:2106
translate chino rutanullaa_d092e112:

    # nulla "Nunca te pregunté qué es lo que te gusta."
    nulla "我从没问过你到底喜欢什么。"

# game/rutas/nulla.rpy:2107
translate chino rutanullaa_bcb334ea:

    # nulla "Hay gente que le gusta el café, pero también hay gente que no lo soporta."
    nulla "有人喜欢咖啡，但也有人受不了它。"

# game/rutas/nulla.rpy:2108
translate chino rutanullaa_5c86d78a:

    # nulla "Con el té se puede variar un poco más, pero luego entra en juego si disfrutas del azúcar o no en ellos."
    nulla "茶可以有更多变化，但之后就得看你是否喜欢加糖了。"

# game/rutas/nulla.rpy:2110
translate chino rutanullaa_bb302699:

    # nulla "Así que, voy a tomar esta oportunidad para saber otra cosa de ti."
    nulla "所以，我想趁这个机会再多了解你一些。"

# game/rutas/nulla.rpy:2111
translate chino rutanullaa_f4f3efc6:

    # nulla "Quiero saber más que simplemente tu palabra favorita."
    nulla "我想知道的不止是你最喜欢的词。"

# game/rutas/nulla.rpy:2112
translate chino rutanullaa_974682bb:

    # nulla "[palabra]."
    nulla "[palabra]."

# game/rutas/nulla.rpy:2113
translate chino rutanullaa_abbcc3e3:

    # "Nulla se ríe por lo bajo, una mezcla entre ternura y pillería."
    "Nulla低声笑了，那笑意里既有温柔，又带着几分顽劣。"

# game/rutas/nulla.rpy:2115
translate chino rutanullaa_a6576275:

    # "Quiero saber más de ti..."
    "我想更多地了解你……"

# game/rutas/nulla.rpy:2116
translate chino rutanullaa_ca34de82:

    # nulla "Entonces..."
    nulla "那么……"

# game/rutas/nulla.rpy:2117
translate chino rutanullaa_ff8273c9:

    # nulla "¿Té o café?"
    nulla "茶还是咖啡？"

# game/rutas/nulla.rpy:2120
translate chino rutanullaa_5f6c9f44_1:

    # nulla "Mmmm."
    nulla "嗯……"

# game/rutas/nulla.rpy:2121
translate chino rutanullaa_51e9e0af:

    # "La sonrisa de Nulla se agranda como la de un zorro."
    "Nulla的笑容更灿烂了，像狐狸一样狡黠。"

# game/rutas/nulla.rpy:2122
translate chino rutanullaa_c844dabe:

    # "Y de la nada, tu taza se llena de un líquido caliente, y un aroma fresco reemplaza el del café."
    "凭空之间，你的杯子里注满了温热的液体，一股清新的香气取代了咖啡的味道。"

# game/rutas/nulla.rpy:2125
translate chino rutanullaa_14ef2556:

    # nulla "Tenemos gustos similares."
    nulla "我们的口味很相似。"

# game/rutas/nulla.rpy:2126
translate chino rutanullaa_6a045ddf:

    # "Dice él orgulloso."
    "他骄傲地说。"

# game/rutas/nulla.rpy:2127
translate chino rutanullaa_d699d544:

    # "Y de la nada, tu taza se llena de un líquido caliente, duplicando el aroma fuerte del café."
    "又是凭空，你的杯子里注满了滚烫的液体，咖啡的浓烈香气也翻了一倍。"

# game/rutas/nulla.rpy:2128
translate chino rutanullaa_60a1b978:

    # "Una vez listo, Nulla comienza a preparar el pan. Reparte la mantequilla en el borde crujiente y esta se derrite por el calor que emana la masa."
    "准备好之后，Nulla开始处理面包。他把黄油涂在酥脆的边缘，黄油在面团散出的热气中融化。"

# game/rutas/nulla.rpy:2129
translate chino rutanullaa_9a2f0315:

    # nulla "El pan con mantequilla es mi preferido, simple y fácil de preparar."
    nulla "黄油面包是我的最爱，简单又好做。"

# game/rutas/nulla.rpy:2130
translate chino rutanullaa_41c19f9f:

    # nulla "Tú puedes ponerle lo que gustes."
    nulla "你的那份你想加什么都可以。"

# game/rutas/nulla.rpy:2131
translate chino rutanullaa_3fc1be8a:

    # "Y es verdad, en la bandeja hay un montón de cosas, tanto dulces como saladas, para acompañar el pan."
    "确实，托盘上摆着一大堆东西，甜咸都有，配着面包吃。"

# game/rutas/nulla.rpy:2132
translate chino rutanullaa_4dea48e4:

    # nulla "Es una lástima que no te pueda ver comer en realidad."
    nulla "真可惜我没法亲眼看你吃东西。"

# game/rutas/nulla.rpy:2133
translate chino rutanullaa_d64bb6b8:

    # nulla "Ni que tampoco puedas probar mis desayunos."
    nulla "你也没法尝到我做的早餐。"

# game/rutas/nulla.rpy:2134
translate chino rutanullaa_aab7a5db:

    # "Dice él mientras toma su propia taza de café y le da un sorbo."
    "他一边说着，一边端起自己的咖啡喝了一小口。"

# game/rutas/nulla.rpy:2135
translate chino rutanullaa_6bcfa1cd:

    # "No se le ve tan dolido a como suena su voz."
    "他看上去并不像声音里听出来的那么难过。"

# game/rutas/nulla.rpy:2136
translate chino rutanullaa_e3273af7:

    # "Nulla llena el momento con una conversación casual. Entre sorbo y sorbo, acepta con resignación que toda conversación contigo es, y siempre será, unilateral."
    "Nulla用闲聊填补了这段沉默。他一口一口啜饮着，认命地接受与你的每一次交谈都永远是单方面的。"

# game/rutas/nulla.rpy:2137
translate chino rutanullaa_3880ef1b:

    # "Pero es algo con lo que debe cargar hasta que encuentre una forma para hablar contigo de una forma directa, te dijo antes de comenzar a parlotear de los diferentes tipos de té que ha tenido el gusto de probar."
    "但这是他一直不得不忍受的事，直到他找到直接与你交谈的办法——他之前这么说过，然后便滔滔不绝地讲起他有幸品尝过的各种茶。"

# game/rutas/nulla.rpy:2138
translate chino rutanullaa_e5fcb581:

    # "Así que tu desayuno es... interesante."
    "所以你这份早餐……挺有意思的。"

# game/rutas/nulla.rpy:2140
translate chino rutanullaa_b824bca9:

    # "Bueno, ¿A quien vamos a engañar?... a estás alturas, Nulla podría estar hablando de quién sabe qué cosa, y tú aún lo escucharías como si cada palabra fuera oro puro, ¿no?."
    "得了吧，我们骗得了谁呢……到了现在这个地步，Nulla就算在聊些不知所云的东西，你也会把他说的每句话都当成至理名言来听，不是吗？"

# game/rutas/nulla.rpy:2141
translate chino rutanullaa_f77e192d:

    # "Él te tiene tan atado como tú lo tienes a él."
    "他把你拴得有多紧，你把他拴得就有多紧。"

# game/rutas/nulla.rpy:2142
translate chino rutanullaa_0bb3496f:

    # "Al terminar el desayuno, sientes como tu cuerpo recupera fuerzas y Nulla se da cuenta de ello también."
    "早餐结束时，你感觉身体恢复了力气，Nulla也察觉到了。"

# game/rutas/nulla.rpy:2144
translate chino rutanullaa_a6e17cbc:

    # nulla "Estaba pensando..."
    nulla "我本来在想……"


# game/rutas/nulla.rpy:2145
translate chino rutanullaa_41b731cc:

    # "Ambos se encuentran mirando el vacío, esperando el momento justo para ir al hotel."
    "两人都望着虚空，等待出发去酒店的最佳时机。"

# game/rutas/nulla.rpy:2146
translate chino rutanullaa_83528f50:

    # "Pasando las horas con la compañía del otro. Disfrutando de las pequeñas cosas que suceden o de la rutina hogareña que tanto Nulla gusta de tener contigo."
    "在彼此的陪伴中消磨时光。享受着那些发生的小事，以及Nulla如此享受与你共度的家常日常。"

# game/rutas/nulla.rpy:2148
translate chino rutanullaa_ab8e7492:

    # nulla "Este lugar no me gusta..."
    nulla "我不喜欢这个地方……"

# game/rutas/nulla.rpy:2149
translate chino rutanullaa_ed11eaa7:

    # nulla "Nunca me gustó en realidad."
    nulla "说实话，我从来都不喜欢。"

# game/rutas/nulla.rpy:2152
translate chino rutanullaa_720fd521:

    # nulla "No importa donde mire, todo tiene su nombre y tinta."
    nulla "不管我望向哪里，一切都写着它的名字，沾着它的墨。"

# game/rutas/nulla.rpy:2153
translate chino rutanullaa_d3dee382:

    # nulla "Es horrible."
    nulla "太可怕了。"

# game/rutas/nulla.rpy:2156
translate chino rutanullaa_54134695:

    # "Él mira sus manos con cierto desagrado."
    "他略带嫌恶地看着自己的双手。"

# game/rutas/nulla.rpy:2157
translate chino rutanullaa_0e3939ec:

    # "Y tú no comprendes del todo lo que está pasando por su cabeza."
    "而你无法完全理解他脑中正在翻涌的是什么。"

# game/rutas/nulla.rpy:2160
translate chino rutanullaa_6cd2fa24:

    # nulla "Y sé que puede ser mucho pedir..."
    nulla "我知道这可能要求太多了……"

# game/rutas/nulla.rpy:2161
translate chino rutanullaa_12583b6a:

    # nulla "Sé que incluso es muy probable que no puedas hacerlo, pues puede ser un poco engorroso."
    nulla "我也知道，你很可能做不到，因为那可能有点麻烦。"

# game/rutas/nulla.rpy:2164
translate chino rutanullaa_f366aef0:

    # nulla "Pero, tengo un cuadro que siempre ha estado en blanco."
    nulla "但是，我有一幅一直空白着的画。"

# game/rutas/nulla.rpy:2167
translate chino rutanullaa_409f8636_18:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2170
translate chino rutanullaa_8bb44383:

    # nulla "No, olvídalo."
    nulla "不，算了。"

# game/rutas/nulla.rpy:2173
translate chino rutanullaa_558f3159:

    # nulla "No creo que importe hacerlo o no."
    nulla "我觉得做不做都无所谓。"

# game/rutas/nulla.rpy:2176
translate chino rutanullaa_1a981bc0:

    # nulla "Después de todo, al final no quedará nada."
    nulla "毕竟……到头来什么都不会留下。"

# game/rutas/nulla.rpy:2181
translate chino rutanullaa_08c59d84:

    # "Sus ojos se iluminan al instante, pero no es de alegría. Hay algo dentro de ellos que no le permite del todo ser una expresión alegre o de esperanza."
    "他的眼睛瞬间亮了起来，却并非因为喜悦。眼底有什么东西，让他无法完全露出快乐或充满希望的神情。"

# game/rutas/nulla.rpy:2182
translate chino rutanullaa_e24d0415:

    # "Te sientes extraño."
    "你感到一阵异样。"

# game/rutas/nulla.rpy:2185
translate chino rutanullaa_8ff0b9cc:

    # "Sus manos se entrelazan y baja la mirada, preparándose para confesar algo que no le es fácil de sacar de su pecho."
    "他双手交握，垂下目光，像是在准备开口，把什么难以启齿的话从心底挖出来。"

# game/rutas/nulla.rpy:2186
translate chino rutanullaa_379fea93:

    # nulla "No es necesario que lo hagas."
    nulla "你不必这么做。"

# game/rutas/nulla.rpy:2189
translate chino rutanullaa_36c6c9c8:

    # nulla "No lo tomes como una orden o algo que necesites hacer para desbloquear algo de mí."
    nulla "别把它当成命令，或是你必须做什么才能从我这里解锁的东西。"

# game/rutas/nulla.rpy:2190
translate chino rutanullaa_69ed8179:

    # nulla "Realmente odiaría que te sintieras presionado a hacer algo realmente."
    nulla "我真的不想你因为压力而勉强自己做什么。"

# game/rutas/nulla.rpy:2191
translate chino rutanullaa_b317f7ee:

    # nulla "Algo fuera del juego, claro."
    nulla "当然，是游戏之外的东西。"

# game/rutas/nulla.rpy:2192
translate chino rutanullaa_a2437cb3:

    # nulla "... Es solo que estaba pensando que sería lindo tener algo tuyo aquí, conmigo."
    nulla "……我只是在想，如果有一样属于你的东西在这里陪着我，会很好。"

# game/rutas/nulla.rpy:2193
translate chino rutanullaa_7cbc28c1:

    # nulla "Algo tocado directamente por tus manos."
    nulla "被你的双手直接触碰过的东西。"

# game/rutas/nulla.rpy:2194
translate chino rutanullaa_a6c25070:

    # nulla "Algo que tú, y solo tú hayas manipulado."
    nulla "由你——而且只由你——改变过的东西。"

# game/rutas/nulla.rpy:2195
translate chino rutanullaa_c731e5fa:

    # nulla "Aunque sea un solo cambio de color, yo estaría muy feliz."
    nulla "哪怕只是换了一种颜色，我也会很开心。"

# game/rutas/nulla.rpy:2198
translate chino rutanullaa_80ea6c79:

    # nulla "Te--"
    nulla "我爱你——"

# game/rutas/nulla.rpy:2201
translate chino rutanullaa_90624b42:

    # nulla "¿Te gustaría hacerlo?"
    nulla "你想这么做吗？"

# game/rutas/nulla.rpy:2206
translate chino rutanullaa_fc1d760b:

    # nulla "No te preocupes si no logras hacerlo."
    nulla "如果你做不到，也别担心。"

# game/rutas/nulla.rpy:2207
translate chino rutanullaa_7d9b2566:

    # nulla "Mi amor por ti no cambiará."
    nulla "我对你的爱不会改变。"

# game/rutas/nulla.rpy:2208
translate chino rutanullaa_e3eb0f79:

    # nulla "No tienes que hacerlo ahora. Yo puedo esperar un acto más."
    nulla "你不必现在做。我可以再等一幕。"

# game/rutas/nulla.rpy:2209
translate chino rutanullaa_9ef47891:

    # nulla "Este es el canvas que tengo."
    nulla "这就是我拥有的画布。"

# game/rutas/nulla.rpy:2212
translate chino rutanullaa_193559fd:

    # nulla "Si lo haces... cambia el nombre de la imagen a 'paranulla' y así yo podré saber que es tuyo <3 ."
    nulla "如果你做了……就把图片的名字改成'paranulla'，这样我就能知道那是你的了 <3"

# game/rutas/nulla.rpy:2219
translate chino rutanullaa_f49ebae4:

    # nulla "No te preocupes mi vida."
    nulla "别担心，亲爱的。"

# game/rutas/nulla.rpy:2220
translate chino rutanullaa_1b0534e7:

    # nulla "Con solo tenerte aquí me basta y me sobra."
    nulla "只要拥有你在这里，对我来说就已经足够有余了。"

# game/rutas/nulla.rpy:2237
translate chino continuacion_nulla_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:2238
translate chino continuacion_nulla_91047a3a:

    # ".........."
    ".........."

# game/rutas/nulla.rpy:2239
translate chino continuacion_nulla_ae2fd981:

    # "Llega el momento en que Nulla te pregunta si quieres acompañarlo mientras él se arregla."
    "到了Nulla问你要不要陪他一起准备的时候。"

# game/rutas/nulla.rpy:2240
translate chino continuacion_nulla_8a3a6a68:

    # "Tú le miras por un largo rato antes de contestar."
    "你久久地注视着他，才开口回答。"

# game/rutas/nulla.rpy:2244
translate chino continuacion_nulla_8e855cb3:

    # "Nulla te toma la mano y te lleva a su habitación."
    "Nulla牵起你的手，带你去了他的房间。"

# game/rutas/nulla.rpy:2245
translate chino continuacion_nulla_c760a1fd:

    # "Dentro de ella te pide que te sientes en su cama y esperes un momento."
    "进房间后，他请你坐在他的床上稍等一会儿。"

# game/rutas/nulla.rpy:2246
translate chino continuacion_nulla_20f6d3ae:

    # "Y sin más se mete al baño, diciendo que no tardará demasiado."
    "然后他二话不说进了浴室，说自己不会太久。"

# game/rutas/nulla.rpy:2247
translate chino continuacion_nulla_60da2825:

    # "Y efectivamente, Nulla no tarda ni 5 minutos."
    "果然，Nulla不到五分钟就出来了。"

# game/rutas/nulla.rpy:2248
translate chino continuacion_nulla_fc8a5fbc:

    # "Lo que hace que pegues un salto cuando la puerta del baño se abre."
    "因此，当浴室门打开时，你吓了一跳。"

# game/rutas/nulla.rpy:2249
translate chino continuacion_nulla_8913aff9:

    # "De ella emerge el pelinegro con una nueva tenida, peinando su cabello hacia un lado."
    "从门里走出来的是那个黑发男子，一身崭新的装束，头发整齐地梳向一侧。"

# game/rutas/nulla.rpy:2250
translate chino continuacion_nulla_ceb8847f:

    # "Pero le falta algo, y eso es la corbata."
    "但他少了点什么——是领带。"

# game/rutas/nulla.rpy:2251
translate chino continuacion_nulla_58ba88a8:

    # nulla "Me encantaría verte vestido de manera elegante, pero creo que eso sería mucho pedir jajaja."
    nulla "我很想看你穿得优雅体面的样子，但我想那要求太高了，哈哈。"

# game/rutas/nulla.rpy:2252
translate chino continuacion_nulla_5de135f6:

    # nulla "Aunque me gustas más justo como estás."
    nulla "不过我还是更喜欢你现在的样子。"

# game/rutas/nulla.rpy:2253
translate chino continuacion_nulla_c1e00e10:

    # nulla "Perfecto."
    nulla "完美。"

# game/rutas/nulla.rpy:2254
translate chino continuacion_nulla_5d38eb74:

    # "Nulla se acerca a ti y, con un chasquido de sus dedos, hace aparecer una corbata."
    "Nulla走近你，打了个响指，一条领带便凭空出现了。"

# game/rutas/nulla.rpy:2255
translate chino continuacion_nulla_d1916ef3:

    # "Su color destaca y resalta demasiado."
    "那条领带的颜色太显眼，有些过于张扬。"

# game/rutas/nulla.rpy:2256
translate chino continuacion_nulla_ad990741:

    # nulla "Creo que este color es perfecto. Pero el azul también podría servir."
    nulla "我觉得这个颜色完美。但蓝色也可以。"

# game/rutas/nulla.rpy:2257
translate chino continuacion_nulla_06d714f9:

    # nulla "Aunque este verde es más común para usarlo como croma jaja--"
    nulla "不过这个绿色更适合当抠图用的色度键，哈哈——"


# game/rutas/nulla.rpy:2258
translate chino continuacion_nulla_8efa8b6e:

    # nulla "Podrías poner y editar mi corbata si quisieras."
    nulla "如果你想的话，甚至可以替换和编辑我的领带。"

# game/rutas/nulla.rpy:2259
translate chino continuacion_nulla_a4d39c70:

    # "Lo dice con un poco de gracia, pero no se molesta en explicarte cuál es el chiste."
    "他说得有些俏皮，却懒得解释这个玩笑是什么意思。"

# game/rutas/nulla.rpy:2260
translate chino continuacion_nulla_403cbeba:

    # "Miras la corbata y agradeces a los dioses que no ha elegido una verde."
    "你看着那条领带，暗暗感谢诸神——还好他没挑一条绿色的。"

# game/rutas/nulla.rpy:2261
translate chino continuacion_nulla_e1b692dd:

    # nulla "¿Me ayudas con el nudo?"
    nulla "你能帮我打领带吗？"

# game/rutas/nulla.rpy:2263
translate chino continuacion_nulla_608ca93c:

    # "Tú asientes y te acercas más a él. Tanto, que puedes escuchar su respiración."
    "你点点头，向他靠近了些，近到能听见他的呼吸。"

# game/rutas/nulla.rpy:2264
translate chino continuacion_nulla_73d9688a:

    # "Ambos trabajan en el nudo y no puedes evitar desviar tu mirada a la cara de Nulla, buscando sus ojos."
    "两人一起打着领带，你忍不住抬眼看向Nulla的脸，寻找他的双眼。"

# game/rutas/nulla.rpy:2265
translate chino continuacion_nulla_f79e8f82:

    # "Él solo te sonríe."
    "他只是对你微笑。"

# game/rutas/nulla.rpy:2266
translate chino continuacion_nulla_d0fa881d:

    # "Cuando terminan, pones tus manos en su camisa, ajustando el pie del cuello con dulzura."
    "打好后，你把双手搭在他的衬衫上，温柔地整理领口。"

# game/rutas/nulla.rpy:2267
translate chino continuacion_nulla_b1cc2335:

    # "Nulla suspira al cerrar los ojos, atesorando el momento por unos segundos más."
    "Nulla闭上眼睛轻叹一声，将这一刻再多珍藏几秒。"

# game/rutas/nulla.rpy:2268
translate chino continuacion_nulla_d06c4314:

    # nulla "Se siente bien tener un tiempo para nosotros."
    nulla "能拥有一段只属于我们的时光，感觉真好。"

# game/rutas/nulla.rpy:2269
translate chino continuacion_nulla_40cbf935:

    # "Te dedica una mirada, llena de anhelo... y algo más."
    "他望向你的目光里满是渴望……以及别的什么。"

# game/rutas/nulla.rpy:2270
translate chino continuacion_nulla_dd4959e4:

    # "Algo que aún no puedes descifrar."
    "某种你至今仍无法解读的东西。"

# game/rutas/nulla.rpy:2271
translate chino continuacion_nulla_2141f106:

    # "Sus manos buscan las tuyas. Sin romper el contacto visual, sus dedos fríos y suaves, rozan tentativamente tus nudillos."
    "他的双手寻找着你的。视线未曾离开，他冰凉柔软的手指试探性地掠过你的指节。"

# game/rutas/nulla.rpy:2272
translate chino continuacion_nulla_a6d98447:

    # nulla "Casi puedo fingir demencia e imaginarme que te tengo al frente."
    nulla "我几乎可以装傻，假装你就在我面前。"

# game/rutas/nulla.rpy:2273
translate chino continuacion_nulla_16436535:

    # nulla "Hoy haré justamente eso."
    nulla "今天，我就要这么做。"

# game/rutas/nulla.rpy:2275
translate chino continuacion_nulla_554e529f:

    # "Con lentitud, Nulla toma completamente una de tus manos y espera."
    "Nulla缓缓地、完完全全地握住你的一只手，静静等待。"

# game/rutas/nulla.rpy:2276
translate chino continuacion_nulla_a192678c:

    # "Al ver que no te resistes, frota su mejilla contra tu palma, cerrando los ojos."
    "见你没有抗拒，他把脸颊贴在你的掌心蹭着，闭上了眼睛。"

# game/rutas/nulla.rpy:2277
translate chino continuacion_nulla_2692f367:

    # "Se restriega como si fuera un gato deseoso y demandante de caricias."
    "他像个渴望抚爱、贪得无厌的猫咪一样蹭着。"

# game/rutas/nulla.rpy:2278
translate chino continuacion_nulla_309cc9db:

    # "Una vez contento, termina plantando un beso en el centro de tu mano, mientras sus ojos vuelven a encontrarse con los tuyos."
    "心满意足之后，他在你手心中央印下一个吻，目光再次与你的交汇。"

# game/rutas/nulla.rpy:2279
translate chino continuacion_nulla_259563ec:

    # nulla "No te molesta, ¿cierto?"
    nulla "你不会介意吧？"

# game/rutas/nulla.rpy:2283
translate chino continuacion_nulla_2fddf81f:

    # "Nulla sonríe, pero su sonrisa no alcanza a sus ojos totalmente."
    "Nulla微笑着，但那笑意并没有完全抵达他的眼睛。"

# game/rutas/nulla.rpy:2284
translate chino continuacion_nulla_36cbfa9a:

    # "Es una expresión dolida."
    "那是一种痛苦的表情。"

# game/rutas/nulla.rpy:2287
translate chino continuacion_nulla_1c3c3db1:

    # nulla "Bueno, la verdad es que no tenemos opción, mi vida."
    nulla "好吧，说实话我们别无选择，亲爱的。"

# game/rutas/nulla.rpy:2288
translate chino continuacion_nulla_82cbf814:

    # nulla "Es imposible meterte dentro del juego."
    nulla "让你进入游戏是不可能的。"

# game/rutas/nulla.rpy:2289
translate chino continuacion_nulla_aaaf690e:

    # nulla "Si no fuera así, créeme..."
    nulla "如果不是这样，相信我……"

# game/rutas/nulla.rpy:2290
translate chino continuacion_nulla_d8fd9273:

    # nulla "Ya lo hubiera hecho."
    nulla "我早就那么做了。"

# game/rutas/nulla.rpy:2291
translate chino continuacion_nulla_2f80616e:

    # "Nulla te da un último beso en los nudillos y su sombra comienza a tragarlos de apoco."
    "Nulla在你的指节上留下最后一吻，他的影子开始一点一点吞噬你们两人。"

# game/rutas/nulla.rpy:2293
translate chino continuacion_nulla_1fa6a8bf:

    # "Hasta engullirlos en el vacío."
    "直到将你们吞没于虚空之中。"

# game/rutas/nulla.rpy:2296
translate chino continuacion_nulla_73b9b2f7:

    # "Nulla lo entiende y te promete sorprenderte cuando vuelva."
    "Nulla理解了，他承诺回来时会给你一个惊喜。"

# game/rutas/nulla.rpy:2297
translate chino continuacion_nulla_91106789:

    # "Así que lo esperas."
    "于是你等着他。"

# game/rutas/nulla.rpy:2298
translate chino continuacion_nulla_a20cefa7_1:

    # "..."
    "..."

# game/rutas/nulla.rpy:2299
translate chino continuacion_nulla_7222b3ab:

    # "No pasan ni 5 minutos cuando Nulla aparece por la puerta principal."
    "没过五分钟，Nulla就从正门出现了。"

# game/rutas/nulla.rpy:2300
translate chino continuacion_nulla_7340f7ce:

    # "Con una tenida y peinado nuevo."
    "穿着一身新装，发型也换了。"

# game/rutas/nulla.rpy:2301
translate chino continuacion_nulla_60cc8de3:

    # nulla "Hice lo que pude."
    nulla "我尽力了。"

# game/rutas/nulla.rpy:2302
translate chino continuacion_nulla_b6cc3401:

    # "Dice él sonriendo de oreja a oreja, para luego extender su mano para que la tomes."
    "他咧着嘴说道，然后向你伸出手，让你牵住。"

# game/rutas/nulla.rpy:2304
translate chino continuacion_nulla_f43a1f22:

    # "Y ambos son tragados por el vacío."
    "然后两人都被虚空吞没。"

# game/rutas/nulla.rpy:2308
translate chino continuacion_nulla_5cd17928:

    # "Dentro del vacío Nulla te mira."
    "虚空之中，Nulla望着你。"

# game/rutas/nulla.rpy:2309
translate chino continuacion_nulla_df6705de:

    # "Sus ojos no se despegan de tu cara cuando abre la boca para confesarte algo al oído."
    "他凑近你的耳边开口低语时，目光始终没有离开你的脸。"

# game/rutas/nulla.rpy:2311
translate chino continuacion_nulla_ecee03d9:

    # nulla "Podríamos tener nuestra otra cita aquí."
    nulla "我们可以在这里赴另一次约会。"

# game/rutas/nulla.rpy:2312
translate chino continuacion_nulla_deafd9f0:

    # nulla "Algo más íntimo."
    nulla "更私密一些的。"

# game/rutas/nulla.rpy:2313
translate chino continuacion_nulla_a02ff52d:

    # nulla "Estarías rodeado de mí..."
    nulla "你会完全被我包围……"

# game/rutas/nulla.rpy:2314
translate chino continuacion_nulla_9c5aa5c8:

    # nulla "Solo si quieres."
    nulla "只要你愿意。"

# game/rutas/nulla.rpy:2316
translate chino continuacion_nulla_bca2038e:

    # nulla "También podemos salir del Jardín por completo e ir a otro lado."
    nulla "我们也可以彻底离开花园，去别的地方。"

# game/rutas/nulla.rpy:2317
translate chino continuacion_nulla_a82084f6:

    # nulla "¿Mmmm?"
    nulla "嗯？"

# game/rutas/nulla.rpy:2319
translate chino continuacion_nulla_cc9dcd6d:

    # "No alcanzas a responder pues tocas suelo, y te tambaleas perdiendo el equilibrio ya que no puedes ver nada."
    "你还没来得及回应，双脚就踩到了地面；你什么也看不见，踉跄着失去了平衡。"

# game/rutas/nulla.rpy:2320
translate chino continuacion_nulla_0a7a888c:

    # nulla "Pero eso lo podríamos hacer mañana."
    nulla "但那事我们可以明天做。"

# game/rutas/nulla.rpy:2322
translate chino continuacion_nulla_40d87f7a:

    # "Nulla te sostiene por la cintura y te estabiliza antes de soltar tu agarre para alejarse un poco."
    "Nulla扶住你的腰让你站稳，然后松开手退开了一点。"

# game/rutas/nulla.rpy:2323
translate chino continuacion_nulla_e711ae68:

    # "... Pasa un momento, dos y el silencio te retumba en los oídos."
    "……一刻，两刻，沉默在你耳中轰鸣。"

# game/rutas/nulla.rpy:2324
translate chino continuacion_nulla_02250671:

    # "Es un silencio perturbante, tanto que estás totalmente consciente de cómo tu corazón late o el paso del aire por tus pulmones."
    "那是一种令人不安的寂静，让你完全能听见自己的心跳，以及空气流过肺腑的动静。"

# game/rutas/nulla.rpy:2325
translate chino continuacion_nulla_912fb7f8:

    # "Como si algo faltase. Pero aún no puedes averiguar de qué trata."
    "仿佛缺了什么。但你还无法弄明白缺的是什么。"

# game/rutas/nulla.rpy:2326
translate chino continuacion_nulla_7a587d07:

    # "Sientes presencias a tu alrededor que te dan escalofríos, ahogándote en el proceso."
    "你感觉到周围有某种存在，令你脊背发凉，几乎窒息。"

# game/rutas/nulla.rpy:2328
translate chino continuacion_nulla_edf5134e:

    # "Hasta que Nulla da un aplauso, y todo el lugar se ilumina."
    "直到Nulla拍了下手，整个地方骤然亮起。"

# game/rutas/nulla.rpy:2329
translate chino continuacion_nulla_c36abb55:

    # "Es la cocina de su hotel, e involuntariamente buscas con tu mirada a Fames."
    "这里是他酒店的厨房，你不由自主地用目光寻找Fames。"

# game/rutas/nulla.rpy:2330
translate chino continuacion_nulla_79f33294:

    # "Pero lo único que encuentras son figuras humanas, negras como el humo, vestidas en trajes frac."
    "但你找到的只有人形的剪影，黑如烟雾，身穿燕尾服。"

# game/rutas/nulla.rpy:2331
translate chino continuacion_nulla_49de0f80:

    # "Al instante en que tus ojos se posan en las figuras, estas comienzan a moverse y toman posición en la cocina. Unas van directamente a las encimeras, mientras que otras toman vegetales de las despensas."
    "你的目光一落到那些身影上，它们便开始移动，在厨房里各就各位。一些直接走向台面，另一些则从储藏室里取出蔬菜。"


# game/rutas/nulla.rpy:2332
translate chino continuacion_nulla_3d1d168e:

    # "Mientras más miras, más incómodo se vuelve, pues sus movimientos no producen sonido. El cuchillo que tiene una de ellas no emite sonido al ser raspado contra la tabla de cortar. Las bolsas que contienen carbohidratos omiten ese característico crujido del plástico al ser apretado..."
    "你越看，越是不安——它们的动作毫无声响。其中一只手里握着的刀在砧板上刮擦，却没有发出一点声音。那些装着碳水化合物的袋子被挤压时，也省略了塑料特有的那种窸窣声……"

# game/rutas/nulla.rpy:2333
translate chino continuacion_nulla_26f05c45:

    # "Y es ahí en donde te das cuenta."
    "就在那一刻，你意识到了。"

# game/rutas/nulla.rpy:2334
translate chino continuacion_nulla_77d8e7e0:

    # "No hay música de fondo que acompañe la escena."
    "没有背景音乐来烘托这一幕。"

# game/rutas/nulla.rpy:2335
translate chino continuacion_nulla_e315d450:

    # nulla "¡Oh! Tienes razón, casi se me olvida ese detalle."
    nulla "哦！你说得对，我差点忘了这个细节。"

# game/rutas/nulla.rpy:2336
translate chino continuacion_nulla_4adbf606:

    # nulla "Es algo difícil recordar y poner todo en su lugar ahora que tenemos solo la mitad del mundo funcionando."
    nulla "在世界只剩下一半还在运转的时候，要记起并把所有东西都归位确实有些困难。"

# game/rutas/nulla.rpy:2338
translate chino continuacion_nulla_fd568064:

    # "Con otro aplauso, la música llega e inunda el lugar."
    "又是一拍手，音乐便响起来，充满了整个空间。"

# game/rutas/nulla.rpy:2343
translate chino continuacion_nulla_11b22f85:

    # nulla "Hum."
    nulla "嗯。"

# game/rutas/nulla.rpy:2344
translate chino continuacion_nulla_25032705:

    # nulla "Fue súbdito de Duae."
    nulla "他曾是Duae的部下。"

# game/rutas/nulla.rpy:2345
translate chino continuacion_nulla_6b41a484:

    # "Es lo único que te ofrece como respuesta..."
    "这就是他给你的全部回答……"

# game/rutas/nulla.rpy:2346
translate chino continuacion_nulla_cff5569c:

    # "Te cuesta comprender su respuesta, es tan vaga que no responde tu pregunta."
    "你难以理解他的回答——它太过含糊，等于什么都没答。"

# game/rutas/nulla.rpy:2347
translate chino continuacion_nulla_a20cefa7_2:

    # "..."
    "..."

# game/rutas/nulla.rpy:2348
translate chino continuacion_nulla_980237d7:

    # "Momento..."
    "等等……"

# game/rutas/nulla.rpy:2349
translate chino continuacion_nulla_0646a97d:

    # "Ah, ahora lo entiendes. Fames ha sido borrado y consumido por el vacío cuando Nulla te dio la esencia de Duae."
    "啊，现在你明白了。当Nulla把Duae的精髓交给你时，Fames就被抹去了，被虚空吞噬了。"

# game/rutas/nulla.rpy:2350
translate chino continuacion_nulla_9ed134ce:

    # "Oh..."
    "哦……"

# game/rutas/nulla.rpy:2354
translate chino continuacion_nulla_d0ab387b:

    # nulla "Puedo cambiar algunas cosas contigo a mi lado."
    nulla "有你陪在身边，我可以改变一些东西。"

# game/rutas/nulla.rpy:2355
translate chino continuacion_nulla_8cc1041a:

    # nulla "La música se encuentra en una carpeta de fácil acceso :) ."
    nulla "音乐放在一个很容易找到的文件夹里 :)"

# game/rutas/nulla.rpy:2361
translate chino continuacion_nulla_cd74e945:

    # nulla "¡Bueno!--"
    nulla "好！——"

# game/rutas/nulla.rpy:2362
translate chino continuacion_nulla_c7d5e234:

    # nulla "Vamos a tomar asiento a nuestra mesa."
    nulla "我们入座吧。"

# game/rutas/nulla.rpy:2365
translate chino continuacion_nulla_1cca3fb7:

    # "Nulla te ofrece la mano y espera a que la tomes para encaminarlos fuera de la cocina. Miras una vez más a las sombras antes de caminar junto a él."
    "Nulla向你伸出手，等你握住后，便带着你走出厨房。你最后又看了一眼那些阴影，然后才走到他身边。"

# game/rutas/nulla.rpy:2367
translate chino continuacion_nulla_54694986:

    # "Un solo pie fuera de la cocina basta para que el comedor se llene de voces y risas que antes no estaban, y no puedes evitar comparar el estado del comedor a como lo habías visto cuando recién llegaste a este mundo."
    "一只脚刚踏出厨房，餐厅里便充满了先前所没有的谈笑声，你忍不住把餐厅此刻的模样，与你刚来到这个世界时所见的做对比。"

# game/rutas/nulla.rpy:2368
translate chino continuacion_nulla_4fcb1706:

    # "Ahora las mesas tienen..."
    "现在餐桌上有了……"

# game/rutas/nulla.rpy:2369
translate chino continuacion_nulla_7a744007:

    # "Sombras."
    "阴影。"

# game/rutas/nulla.rpy:2370
translate chino continuacion_nulla_8746d171:

    # "Sombras que se mueven, toman cubiertos y beben de sus copas. Otras las chocan en un brindis alegre."
    "这些阴影会走动、拿起餐具、举杯饮酒；另一些则兴高采烈地碰杯。"

# game/rutas/nulla.rpy:2371
translate chino continuacion_nulla_65244e6f:

    # "Dando la ambientalización de un lugar concurrido que antes no pasaba."
    "营造出一种热闹场所的氛围，而那先前并不存在。"

# game/rutas/nulla.rpy:2372
translate chino continuacion_nulla_2d105006:

    # nulla "Puedo poner unos cuantos tocando en el escenario si lo deseas, cariño."
    nulla "如果你愿意，我可以在舞台上安排几个人演奏，亲爱的。"

# game/rutas/nulla.rpy:2375
translate chino continuacion_nulla_771cf3a0:

    # nulla "¿En serio?"
    nulla "真的吗？"

# game/rutas/nulla.rpy:2376
translate chino continuacion_nulla_483eaf71:

    # nulla "Bah, pensé que te gustaría un ambiente acorde para nuestra cita."
    nulla "切，我还以为你会喜欢一个配得上我们约会的氛围呢。"

# game/rutas/nulla.rpy:2377
translate chino continuacion_nulla_551b5c47:

    # nulla "Aunque así puedo concentrarme mejor en tu bella cara."
    nulla "不过这样我反而能更专注地看你漂亮的脸蛋。"

# game/rutas/nulla.rpy:2380
translate chino continuacion_nulla_77b86a59:

    # nulla "¡Excelente!"
    nulla "太好了！"

# game/rutas/nulla.rpy:2381
translate chino continuacion_nulla_8f52f233:

    # nulla "Así tendremos el pack completo."
    nulla "这样我们就有了完整的套餐。"

# game/rutas/nulla.rpy:2384
translate chino continuacion_nulla_82c4e962:

    # nulla "Una buena comida y música en vivo..."
    nulla "一顿美餐，还有现场音乐……"

# game/rutas/nulla.rpy:2385
translate chino continuacion_nulla_fe352684:

    # nulla "Hace mucho que no tengo algo así de emocionante."
    nulla "我很久没有这样令人兴奋的事了。"

# game/rutas/nulla.rpy:2386
translate chino continuacion_nulla_0cac3e9b:

    # nulla "Y tengo la mejor compañía a mi lado para disfrutarlo."
    nulla "而我身旁有最好的陪伴，与我一同享受。"

# game/rutas/nulla.rpy:2388
translate chino continuacion_nulla_1311edff:

    # "Ya en una mesa cercana a los pilares, Nulla corre y te ofrece la silla para que te sientes."
    "在靠近立柱的一张桌旁，Nulla快步上前，为你拉开椅子请你入座。"

# game/rutas/nulla.rpy:2392
translate chino continuacion_nulla_f5d4cba5:

    # "Nulla se sienta luego de que tú ya estés en tu puesto, y al instante una sombra vestida en traje de frac se materializa frente de ustedes dos y les presenta la carta."
    "等你坐定，Nulla才坐下；紧接着，一个身穿燕尾服的阴影出现在你们二人面前，呈上菜单。"

# game/rutas/nulla.rpy:2393
translate chino continuacion_nulla_09a2c93a:

    # nulla "¡Pide lo que quieras!"
    nulla "想点什么就点什么！"

# game/rutas/nulla.rpy:2394
translate chino continuacion_nulla_24ca383b:

    # nulla "Yo invito."
    nulla "我请客。"

# game/rutas/nulla.rpy:2395
translate chino continuacion_nulla_958925fe:

    # "Dice él con gracia, mientras hace unas señales con las manos."
    "他俏皮地说道，同时用手比划了几下。"

# game/rutas/nulla.rpy:2396
translate chino continuacion_nulla_9a964550:

    # nulla "Esto lo saqué del código..."
    nulla "这是我从代码里直接弄出来的……"

# game/rutas/nulla.rpy:2397
translate chino continuacion_nulla_fd0ccda3:

    # nulla "¿Puedes ver si sirve?"
    nulla "你能看看管不管用吗？"

# game/rutas/nulla.rpy:2398
translate chino continuacion_nulla_a3490c2f:

    # "Nulla te extiende la carta para que la puedas ver y... no será que se refiere a..."
    "Nulla把菜单递给你让你看……难道他指的是……"

# game/rutas/nulla.rpy:2399
translate chino continuacion_nulla_e225ef8b:

    # "{glitch=20.0}{color=ffffff}{b}Puedes tocar la pantalla para interactuar.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}你可以触摸屏幕进行互动。{/glitch}"

# game/rutas/nulla.rpy:2406
translate chino continuacion_nulla1_aa72f138:

    # "Nulla te mira sudando y con una expresión que denota dolor, pero aun así su sonrisa no flaquea."
    "Nulla看着你，额头冒汗，神情痛苦，但即便如此，他的笑容也没有动摇。"

# game/rutas/nulla.rpy:2410
translate chino continuacion_nulla1_57d7e7c3:

    # nulla "...uhg."
    nulla "……呃。"

# game/rutas/nulla.rpy:2411
translate chino continuacion_nulla1_a252f757:

    # nulla "Creo que hacer eso me ha costado mucha energía."
    nulla "我想做那件事耗费了我不少力气。"

# game/rutas/nulla.rpy:2412
translate chino continuacion_nulla1_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2415
translate chino continuacion_nulla1_85c8481b:

    # nulla "¡Pero no importa! es bueno saber que funciona."
    nulla "不过没关系！知道它管用就好。"

# game/rutas/nulla.rpy:2416
translate chino continuacion_nulla1_bba2cdd3:

    # nulla "Jaja, tal vez lo podemos usar en otro momento."
    nulla "哈哈，也许我们改天还能再用。"

# game/rutas/nulla.rpy:2417
translate chino continuacion_nulla1_26f6f286:

    # nulla "Ya tengo una idea para esta función <3"
    nulla "对于这个功能，我已经有想法了 <3"

# game/rutas/nulla.rpy:2420
translate chino continuacion_nulla1_409f8636_1:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2425
translate chino continuacion_nulla1_01a99ecc:

    # "Nulla te mira con los ojos abiertos, lo has tomado desprevenido."
    "Nulla睁大眼睛看着你，你把他弄得猝不及防。"

# game/rutas/nulla.rpy:2426
translate chino continuacion_nulla1_2c2e036b:

    # nulla "Pero-!"
    nulla "但是——！"

# game/rutas/nulla.rpy:2427
translate chino continuacion_nulla1_3b61782d:

    # nulla "Si es porque me duele, no te preocupes."
    nulla "如果是因为怕我疼，那你别担心。"

# game/rutas/nulla.rpy:2428
translate chino continuacion_nulla1_8504b946:

    # nulla "Mientras más interacción pueda tener contigo, mejor me sentiré."
    nulla "能和你互动得越多，我就感觉越好。"

# game/rutas/nulla.rpy:2431
translate chino continuacion_nulla1_bb6b515c:

    # nulla "Oh."
    nulla "哦。"

# game/rutas/nulla.rpy:2432
translate chino continuacion_nulla1_017ecf6b:

    # "Nulla no comenta nada luego de eso."
    "Nulla 此后什么也没说。"

# game/rutas/nulla.rpy:2435
translate chino continuacion_nulla1_afe290f1:

    # nulla "No tienes por qué."
    nulla "你不必担心。"

# game/rutas/nulla.rpy:2438
translate chino continuacion_nulla1_98b8b3b9:

    # nulla "Además, ya sé cómo poder sacarle provecho a esta función en un futuro, pero te prometo no usarla mucho <3"
    nulla "而且，我已经知道今后要如何充分利用这个功能了，但我保证不会过度使用。<3"

# game/rutas/nulla.rpy:2443
translate chino continuacion_nulla1_5cb0f0eb:

    # "La comida llega en el tiempo justo para parecer auténtica, como si hubiese sido preparada por manos humanas... obviando el detalle de que fueron sombras sin cuerpo sólido las que la cocinaron."
    "食物来得正是时候，看起来相当地道，仿佛出自真正的人类双手……只要你忽略一个细节：烹饪它的，是些没有实体的阴影。"


# game/rutas/nulla.rpy:2444
translate chino continuacion_nulla1_7979dacf:

    # "Nulla le sonríe a la sombra encargada de traer los platos y la despacha al instante en que ambos platos están en la mesa, con un chasquido de sus dedos."
    "Nulla 朝负责端菜的阴影微微一笑，等两只盘子都落上桌的瞬间，他一个响指便把它打发走了。"

# game/rutas/nulla.rpy:2447
translate chino continuacion_nulla1_fac8beaa:

    # "Sin esperar mucho, toma su copa y la alza en tu dirección. Esperando a que le correspondas el brindis, con una sonrisa tierna..."
    "没等你太久，他便拿起酒杯，朝你举了过来，脸上带着温柔的笑意，等你与他碰杯……"

# game/rutas/nulla.rpy:2451
translate chino continuacion_nulla1_508ba92a:

    # nulla "Por nosotros."
    nulla "为我们。"

# game/rutas/nulla.rpy:2452
translate chino continuacion_nulla1_6419879a:

    # "El sonido del cristal al chocar es delicado, íntimo, como si fuera un secreto que solo comparten ustedes dos."
    "水晶相碰的声音轻柔而亲密，仿佛是一个只属于你们二人的秘密。"

# game/rutas/nulla.rpy:2455
translate chino continuacion_nulla1_790d3c06:

    # "Luego, Nulla posa su boca en la copa. Y el roce de sus labios contra el borde de la copa es tan lento, tan intencional, que es imposible no sentir una presión burbujeante en lo bajo de tu estómago."
    "接着，Nulla 将嘴唇贴上杯沿。他双唇在那杯口缓缓摩挲，那样缓慢，那样刻意，让你不由自主地感到胃深处一阵翻涌的灼热。"

# game/rutas/nulla.rpy:2456
translate chino continuacion_nulla1_7a0e581f:

    # "Más aún con la mirada que Nulla te dedica mientras sorbe su trago. Ojos entrecerrados que se niegan a perderte de vista."
    "尤其是 Nulla 啜饮时投向你的目光——那双半垂的眼眸，怎么都不肯从你身上移开。"

# game/rutas/nulla.rpy:2457
translate chino continuacion_nulla1_a9ac4819:

    # "Por un momento, olvidas cómo respirar."
    "有那么一瞬间，你忘了该怎么呼吸。"

# game/rutas/nulla.rpy:2463
translate chino continuacion_nulla1_00b4e20b:

    # nulla "Por la destrucción de este lugar."
    nulla "为这座地方的毁灭。"

# game/rutas/nulla.rpy:2466
translate chino continuacion_nulla1_31e1e5ac:

    # "Nulla ladea su copa hacia la derecha, y una sombra aparece de la nada, alzando otra copa vacía para chocarla con la suya."
    "Nulla 把酒杯向右倾斜，一道阴影凭空出现，举起一只空杯与他相碰。"

# game/rutas/nulla.rpy:2467
translate chino continuacion_nulla1_505b82ad:

    # "El sonido es hueco e inquietantemente fuerte, retumbando en tus oídos sin cuidado."
    "那声音空洞而刺耳地响着，毫不留情地在双耳间轰鸣。"

# game/rutas/nulla.rpy:2468
translate chino continuacion_nulla1_20cc6472:

    # "Una vez hecho su brindis, Nulla cierra los ojos y le da un trago al vino."
    "祝酒完毕，Nulla 闭上眼睛，饮了一口酒。"

# game/rutas/nulla.rpy:2470
translate chino continuacion_nulla1_c1c2a1c3:

    # "La comida pasa con lentitud, pausado y agradable, un poco de conversación e historias de memorias pasadas."
    "这顿饭过得缓慢、从容而愉快，其间夹杂着零星的交谈与关于过往记忆的故事。"

# game/rutas/nulla.rpy:2471
translate chino continuacion_nulla1_37a76142:

    # "Nulla levanta una mano y señala tu rostro, sus dedos delineando el contorno de tu cara para terminar posando su palma en tu mejilla."
    "Nulla 抬起手，用手指描摹你的面庞轮廓，最后将掌心覆在你的脸颊上。"

# game/rutas/nulla.rpy:2473
translate chino continuacion_nulla1_f504c7e8:

    # nulla "Realmente me puse muy feliz. Y no solo por cómo te ves, no, no."
    nulla "我真的很高兴。而且不只是因为你怎么好看，不，不是的。"

# game/rutas/nulla.rpy:2474
translate chino continuacion_nulla1_bed2dba8:

    # nulla "Es todo lo que representas, tus reacciones y tu atención. Es la primera vez que me sentí realmente observado, visto."
    nulla "是你所代表的一切，你的反应，你的关注。这是我第一次真正感到被人注视，被人看见。"

# game/rutas/nulla.rpy:2475
translate chino continuacion_nulla1_e3c59184:

    # nulla "Como si realmente mi existencia importara."
    nulla "仿佛我的存在真的有什么意义。"

# game/rutas/nulla.rpy:2478
translate chino continuacion_nulla1_22515c0d:

    # "Su mano se desliza con lentitud sobre la mesa, buscando la tuya. Cuando la encuentra, la sostiene con suavidad, mientras su pulgar traza líneas pequeñas sobre tus dedos."
    "他的手缓缓沿桌面滑过，寻找着你的手。找到后，他轻轻握住，拇指在你指间描出细碎的线条。"

# game/rutas/nulla.rpy:2481
translate chino continuacion_nulla1_69e5d594:

    # nulla "Pero al mismo tiempo, tuve miedo."
    nulla "但与此同时，我也害怕。"

# game/rutas/nulla.rpy:2482
translate chino continuacion_nulla1_d1f37f33:

    # nulla "De que te fueras con Septem o Unum."
    nulla "怕你跟 Septem 或 Unum 走了。"

# game/rutas/nulla.rpy:2485
translate chino continuacion_nulla1_1d43013a:

    # nulla "No son tan interesantes como yo, claro."
    nulla "当然，他们没有我这么有趣。"

# game/rutas/nulla.rpy:2486
translate chino continuacion_nulla1_6d4580dc:

    # "Dice sonriendo de manera juguetona, desviando la mirada al vino. Su otra mano juega distraídamente con el borde de su copa."
    "他说着，笑容带有几分玩闹，目光却偏向了酒。他的另一只手漫不经心地拨弄着杯沿。"

# game/rutas/nulla.rpy:2489
translate chino continuacion_nulla1_f5ab3ea3:

    # nulla "Sé que en algún momento te irás a ver de qué tratan sus historias, o tal vez ya lo has hecho."
    nulla "我知道，总有一天你会去看看他们的故事讲的是些什么，也许你已经去过了。"

# game/rutas/nulla.rpy:2490
translate chino continuacion_nulla1_11a93906:

    # nulla "Pero ya no estoy preocupado por ello. Luego de que se cumpla el séptimo día, obtendré lo que quiero."
    nulla "但我已经不为此事担心了。等第七天结束，我会得到我想要的。"

# game/rutas/nulla.rpy:2491
translate chino continuacion_nulla1_409f8636_2:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2497
translate chino continuacion_nulla1_0a2719b9:

    # nulla "Ser libre y--"
    nulla "获得自由，还有——"

# game/rutas/nulla.rpy:2500
translate chino continuacion_nulla1_a285897a:

    # "Las mejillas de Nulla se tintan levemente de rojo."
    "Nulla 的脸颊微微染上一抹红晕。"

# game/rutas/nulla.rpy:2501
translate chino continuacion_nulla1_cadabf7e:

    # nulla "... Quiero ser tuyo."
    nulla "……我想成为你的。"

# game/rutas/nulla.rpy:2502
translate chino continuacion_nulla1_62f51f70:

    # "Su voz baja, más grave de lo habitual.. Ya no hay tintes de grandeza ni las frecuentes sonrisas que exceden confianza."
    "他的声音沉了下去，比往常更加低沉。再也没有了那种宏大的气派，也没有了那些过于自信的笑容。"

# game/rutas/nulla.rpy:2503
translate chino continuacion_nulla1_187d5e5f:

    # "No. Ahora tienes a Nulla, confesando algo que va más allá de las palabras, encerrado bajo llave en sus preocupaciones y corazón."
    "不。此刻你面前的 Nulla，正在吐露某种言语之外的东西，那东西被他锁在自己的忧虑与心深处。"

# game/rutas/nulla.rpy:2504
translate chino continuacion_nulla1_842a4c5a:

    # "Una confesión silenciosa que siempre existió, pero que ahora puede encontrar una voz para ser expuesta."
    "这是一份沉默的告白，它一直存在，如今却终于找到了可以发声、得以吐露的途径。"

# game/rutas/nulla.rpy:2507
translate chino continuacion_nulla1_ba01537c:

    # nulla "Pero lo último es más difícil de conseguir que lo primero."
    nulla "但后者比前者更难实现。"

# game/rutas/nulla.rpy:2508
translate chino continuacion_nulla1_38b0a62f:

    # nulla "Por ahora suena más como una fantasía infantil que algo posible."
    nulla "至少眼下，这听起来更像某种孩子气的幻想，而非可能成真的事。"

# game/rutas/nulla.rpy:2509
translate chino continuacion_nulla1_c7215959:

    # nulla "Aunque..."
    nulla "不过……"

# game/rutas/nulla.rpy:2512
translate chino continuacion_nulla1_03715276:

    # nulla "Si fuera tuyo, podría hacer tantas cosas."
    nulla "如果我属于你，我就能做很多事。"

# game/rutas/nulla.rpy:2513
translate chino continuacion_nulla1_ddfb4110:

    # nulla "Estar en tu computadora sin la necesidad de que el juego esté corriendo."
    nulla "可以待在你的电脑里，不必非得让游戏在运行。"

# game/rutas/nulla.rpy:2514
translate chino continuacion_nulla1_cd97e687:

    # nulla "Mandarte mensajes, o pasar el tiempo juntos viendo alguna cosa que te interese."
    nulla "给你发消息，或者一起消磨时光，看些你感兴趣的东西。"

# game/rutas/nulla.rpy:2515
translate chino continuacion_nulla1_aaee5dc0:

    # "Deja escapar una risa suave, pero algo seca."
    "他轻笑了一声，那笑声温柔，却有些干涩。"

# game/rutas/nulla.rpy:2518
translate chino continuacion_nulla1_e9a5fd4c:

    # nulla "Jaja, soñar no cuesta nada."
    nulla "哈哈，做梦又不花钱。"

# game/rutas/nulla.rpy:2523
translate chino continuacion_nulla1_af086c60:

    # nulla "Quiero ser libre."
    nulla "我想获得自由。"

# game/rutas/nulla.rpy:2524
translate chino continuacion_nulla1_e7a3f996:

    # nulla "Desligarme de todo esto de una buena vez por todas y descansar."
    nulla "彻底摆脱这一切，然后安歇。"

# game/rutas/nulla.rpy:2525
translate chino continuacion_nulla1_3c0f1a6e:

    # "Sus ojos se suavizan un instante, pero no pierden ese toque cansado."
    "他的双眼柔和了一瞬，却始终没有褪去那抹疲惫。"

# game/rutas/nulla.rpy:2528
translate chino continuacion_nulla1_ce9ad528:

    # nulla "Espero que con tu ayuda pueda conseguir eso."
    nulla "我希望有你的帮助，我能做到。"

# game/rutas/nulla.rpy:2529
translate chino continuacion_nulla1_956a42d5:

    # nulla "Realmente te aprecio, [nombrejugador]."
    nulla "我真的很喜欢你，[nombrejugador]。"

# game/rutas/nulla.rpy:2532
translate chino continuacion_nulla1_7f4f679e:

    # "Son interrumpidos por una sombra les retira los platos ya vacíos de su mesa, sin antes entregarle un sobre a Nulla."
    "一道阴影撤走了你们桌上空了的盘子，顺手先将一个信封递给了 Nulla，打断了你们的交谈。"

# game/rutas/nulla.rpy:2533
translate chino continuacion_nulla1_a4a4ca40:

    # "Él la toma sonriente, mirando sin mucho interés los detalles que tiene el sobre. Debido a la distancia te es complejo ver el remitente de la carta."
    "他笑着接过，漫不经心地瞥了一眼信封上的细节。隔着这段距离，你很难看清寄信人是谁。"

# game/rutas/nulla.rpy:2534
translate chino continuacion_nulla1_d1e7cab6:

    # "Antes de poder preguntar por qué es, otra sombra aparece detrás de ti y entre sus manos, sostiene una bandeja dorada con varios niveles, decorada con encajes metálicos y bordes ornamentados."
    "你还没来得及开口询问，另一道阴影便出现在你身后，双手托着一只金色多层托盘，托盘上缀着金属蕾丝与华丽的边饰。"

# game/rutas/nulla.rpy:2535
translate chino continuacion_nulla1_deb3d828:

    # "Nulla aprovecha esto para guardar la carta en su bolsillo, sin dignarse a abrirla."
    "Nulla 顺势把信收进口袋，连拆开都不屑一顾。"

# game/rutas/nulla.rpy:2536
translate chino continuacion_nulla1_a19c873e:

    # "Y su atención se dirige a la bandeja. Cada nivel está cuidadosamente dispuesto con distintos mini postres."
    "他的注意力随即转向那只托盘。每一层都精心摆放着各不相同的迷你甜点。"

# game/rutas/nulla.rpy:2537
translate chino continuacion_nulla1_f347e5ec:

    # "Una vez dispuesta la bandeja en la mesa, la sombra les hace una reverencia antes de esfumarse en la nada."
    "托盘在桌上摆好后，那道阴影躬身一礼，随即消散于虚无。"

# game/rutas/nulla.rpy:2538
translate chino continuacion_nulla1_f0362f41:

    # nulla "El postre es lo mejor de una comida."
    nulla "甜点是整顿饭里最棒的部分。"

# game/rutas/nulla.rpy:2540
translate chino continuacion_nulla1_74272de7:

    # "Nulla inspecciona la bandeja, eligiendo con cuidado antes de llevarse un postre a la boca."
    "Nulla 仔细端详着托盘，审慎地挑了一款甜点，才送进嘴里。"

# game/rutas/nulla.rpy:2541
translate chino continuacion_nulla1_94b26ee7:

    # nulla "¿Te gusta cómo me veo? ¿O te gustaría que--"
    nulla "你喜欢我这个样子吗？还是你希望我——"

# game/rutas/nulla.rpy:2542
translate chino continuacion_nulla1_b043f74e:

    # nulla "--Cambiara de forma?"
    nulla "——换个形态？"

# game/rutas/nulla.rpy:2543
translate chino continuacion_nulla1_3ac08efa:

    # "No te da tiempo para responder. La siguiente pregunta que sale disparada de sus labios, llega tan rápido que parece que la estuviera vomitando después de haberla guardado por mucho tiempo."
    "他没给你回答的时间。下一个问题从他唇间脱口而出，快得仿佛是憋了太久，终于吐了出来。"

# game/rutas/nulla.rpy:2544
translate chino continuacion_nulla1_e1e21ba0:

    # "Más del que podría aguantar."
    "久得超出了他所能忍受的程度。"

# game/rutas/nulla.rpy:2545
translate chino continuacion_nulla1_1c94c900:

    # nulla "Si tuviera otra apariencia... ¿seguirías sintiendo lo mismo por mí?"
    nulla "如果我换一副模样……你对我的心意还会一样吗？"

# game/rutas/nulla.rpy:2550
translate chino continuacion_nulla1_409f8636_3:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2551
translate chino continuacion_nulla1_aac3eab8:

    # "Nulla baja la mirada. Sus orejas se tiñen de un tinte rojo, denotando vergüenza."
    "Nulla 垂下目光。他的耳尖染上一抹绯红，泄露了他的窘迫。"

# game/rutas/nulla.rpy:2552
translate chino continuacion_nulla1_cc91d06b:

    # "Se mantiene serio mientras intenta formular su respuesta."
    "他努力组织着回答，神情却依旧严肃。"


# game/rutas/nulla.rpy:2553
translate chino continuacion_nulla1_da26f267:

    # nulla "Si yo fuera un gusano, ¿Me --"
    nulla "如果我是一条虫子，你会不会——"

# game/rutas/nulla.rpy:2556
translate chino continuacion_nulla1_571f4806:

    # "Pero falla y comienza a reír solo."
    "但他失败了，自顾自地笑了起来。"

# game/rutas/nulla.rpy:2561
translate chino continuacion_nulla1_7a06ebb3:

    # nulla "Oh, entonces, si yo fuera un..."
    nulla "哦，那，如果我成了……"

# game/rutas/nulla.rpy:2564
translate chino continuacion_nulla1_2c39851a:

    # "Nulla comienza a reír, frenético."
    "Nulla 开始大笑，笑得近乎癫狂。"

# game/rutas/nulla.rpy:2565
translate chino continuacion_nulla1_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:2566
translate chino continuacion_nulla1_5e3586f7:

    # nulla "Okay, Okay."
    nulla "好吧，好吧。"

# game/rutas/nulla.rpy:2567
translate chino continuacion_nulla1_81353cd0:

    # nulla "Eso sonaba más gracioso en mi cabeza."
    nulla "这话在我脑子里听起来可好笑多了。"

# game/rutas/nulla.rpy:2568
translate chino continuacion_nulla1_cbba5b82:

    # nulla "Lo siento."
    nulla "抱歉。"

# game/rutas/nulla.rpy:2569
translate chino continuacion_nulla1_73dea93d:

    # nulla "Pero es una pregunta genuina."
    nulla "但这是句真心话。"

# game/rutas/nulla.rpy:2570
translate chino continuacion_nulla1_b81b7c5f:

    # nulla "Si yo tuviera una forma diferente a esta, ¿Seguiría siendo yo?"
    nulla "如果我拥有一副与现在不同的形态，我还是我吗？"

# game/rutas/nulla.rpy:2574
translate chino continuacion_nulla1_dbcdaa1d:

    # nulla "¿Si fuera mujer?"
    nulla "如果是女人呢？"

# game/rutas/nulla.rpy:2577
translate chino continuacion_nulla1_a819c248:

    # nulla "¿Viejo? "
    nulla "老了？"

# game/rutas/nulla.rpy:2581
translate chino continuacion_nulla1_c48dce46:

    # nulla "¿Más viejo?"
    nulla "更老？"

# game/rutas/nulla.rpy:2583
translate chino continuacion_nulla1_5a37af9a:

    # nulla "¿Si tuviera la misma apariencia que Septem?"
    nulla "如果长得和 Septem 一模一样呢？"

# game/rutas/nulla.rpy:2587
translate chino continuacion_nulla1_f949664f:

    # nulla "¿Seguiría siendo yo?"
    nulla "我还是我吗？"

# game/rutas/nulla.rpy:2588
translate chino continuacion_nulla1_e92bbe1c:

    # nulla "Puedo tomar la apariencia que quiera..."
    nulla "我可以变成任何我想要的模样……"

# game/rutas/nulla.rpy:2589
translate chino continuacion_nulla1_31034b24:

    # nulla "Pero ninguna se siente mía..."
    nulla "但没有哪一种让我觉得自己是它……"

# game/rutas/nulla.rpy:2590
translate chino continuacion_nulla1_b4c708d6:

    # nulla "Incluso esta..."
    nulla "就连现在这一副……"

# game/rutas/nulla.rpy:2594
translate chino continuacion_nulla1_8d55f96d:

    # nulla "Es algo tomado de alguien que existió previo a mí...."
    nulla "也是从某个早于我存在的人那里拿来的……"

# game/rutas/nulla.rpy:2595
translate chino continuacion_nulla1_ea52f46e:

    # nulla "Pero no soy yo..."
    nulla "但它不是我……"

# game/rutas/nulla.rpy:2596
translate chino continuacion_nulla1_d1e6d50b:

    # nulla "Y posiblemente, en unos años más tenga otra apariencia si no acabo con esto rápido."
    nulla "而且如果我不能尽快了结此事，或许再过多少年，我又会有另一副模样。"

# game/rutas/nulla.rpy:2599
translate chino continuacion_nulla1_63c7ba9c:

    # "Nulla te mira con los ojos abiertos."
    "Nulla 睁大双眼望着你。"

# game/rutas/nulla.rpy:2600
translate chino continuacion_nulla1_e669e69b:

    # nulla "¿Te gusta esa atrocidad?"
    nulla "你喜欢那副可怖的模样吗？"

# game/rutas/nulla.rpy:2606
translate chino continuacion_nulla1_746b7f60:

    # nulla "Ahhh~"
    nulla "啊hhh~"

# game/rutas/nulla.rpy:2607
translate chino continuacion_nulla1_0b9b84c8:

    # "Nulla se tapa la cara avergonzado."
    "Nulla 窘迫地捂住了脸。"

# game/rutas/nulla.rpy:2610
translate chino continuacion_nulla1_e35a3f3a:

    # nulla "No digas esas cosas, luego me dan ganas de actuar de manera atrevida."
    nulla "别这么说，你一说这种话，我就想放肆一点。"

# game/rutas/nulla.rpy:2611
translate chino continuacion_nulla1_608186cf:

    # nulla "Pero lo tengo que mantener en pg 16."
    nulla "但我得把分寸控制在 PG-16。"

# game/rutas/nulla.rpy:2614
translate chino continuacion_nulla1_39ff3430:

    # "Nulla suspira y se convierte en su forma del vacío, por primera vez de manera voluntaria."
    "Nulla 叹了口气，转而化作他的虚空形态——这还是他第一次自愿如此。"

# game/rutas/nulla.rpy:2615
translate chino continuacion_nulla1_08b8bd5d:

    # nulla "No sabía que tenías estos gustos."
    nulla "我不知道你还有这种喜好。"

# game/rutas/nulla.rpy:2616
translate chino continuacion_nulla1_3a2d1899:

    # "Él ríe. Y a pesar de no tener boca, eres capaz de ver cómo sus ojos transmiten felicidad."
    "他笑了。尽管没有嘴巴，你仍能从他的双眼中读出幸福。"

# game/rutas/nulla.rpy:2622
translate chino continuacion_nulla1_095158d2:

    # nulla "Era de esperarse, jaja."
    nulla "早该料到是这样，哈哈。"

# game/rutas/nulla.rpy:2628
translate chino continuacion_nulla1_131f96eb:

    # "Le dices que no importa su apariencia, que con la que él se sienta cómodo está bien."
    "你告诉他，他的外表无关紧要，他舒服自在的那副模样就是最好的。"

# game/rutas/nulla.rpy:2629
translate chino continuacion_nulla1_a5b2e2ba:

    # "Que podría ser cualquier cosa, hasta tal vez un maldito gusano, y tú lo seguirías queriendo."
    "他可以是任何东西，哪怕只是一条该死的虫子，你也会依旧爱他。"

# game/rutas/nulla.rpy:2632
translate chino continuacion_nulla1_409f8636_4:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2633
translate chino continuacion_nulla1_a0f7184f:

    # nulla "Lo siento, no debí hablar de eso."
    nulla "对不起，我不该提起那件事。"

# game/rutas/nulla.rpy:2634
translate chino continuacion_nulla1_409f8636_5:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2635
translate chino continuacion_nulla1_5881b498:

    # "La conversación no se vuelve a retomar de manera natural. Se nota que le está costando seguir el ritmo de antes."
    "对话没能自然地重新接上。你看得出，他正艰难地想找回先前的节奏。"

# game/rutas/nulla.rpy:2636
translate chino continuacion_nulla1_be2a7192:

    # "Nulla luce incómodo."
    "Nulla 看起来有些不自在。"

# game/rutas/nulla.rpy:2639
translate chino continuacion_nulla1_a20cefa7_1:

    # "..."
    "..."

# game/rutas/nulla.rpy:2640
translate chino continuacion_nulla1_0dfa68ad:

    # "La cita concluye con la llegada de la cuenta, después de que Nulla se haya comido el último postre de la bandeja."
    "这次约会随着账单的到来结束——Nulla 吃完了托盘上最后一份甜点。"

# game/rutas/nulla.rpy:2641
translate chino continuacion_nulla1_3b8106ef:

    # "Y no sabes qué es lo que más te hace gracia: si el hecho de que haya llegado, o que Nulla la tome y la examine con toda seriedad."
    "你不确定哪件事更可笑：账单竟然真的送来了，还是 Nulla 接过它，一脸严肃地仔细端详。"

# game/rutas/nulla.rpy:2642
translate chino continuacion_nulla1_4fe41de3:

    # "Como si realmente estuviera revisando que todo estuviera en orden."
    "仿佛他真的在确认一切都分毫不差。"

# game/rutas/nulla.rpy:2644
translate chino continuacion_nulla1_ecc36975:

    # nulla "Hey... ¿cuánta propina crees que se merecen estos meseros -tan bellos, buenmozos y, desde luego, para nada extensiones mías?"
    nulla "嘿……你觉得这些英俊迷人的侍者——他们绝对不是我的延伸——该拿多少小费？"

# game/rutas/nulla.rpy:2650
translate chino continuacion_nulla1_8d13e22d:

    # nulla "¿¡¿NADA?!?"
    nulla "一分钱都没有？！"

# game/rutas/nulla.rpy:2651
translate chino continuacion_nulla1_52f3dea5:

    # "Nulla se lleva la mano al pecho al mismo tiempo en que las sombras se cubren la cara con las manos, como si lloraran."
    "阴影们用手捂住脸，像是在哭泣；Nulla 则按住自己的胸口。"

# game/rutas/nulla.rpy:2652
translate chino continuacion_nulla1_700c6b79:

    # nulla "¡OHHH!~~ Todo mi esfuerzo, mi cariño y mi corazón que puse en esta profesión, ¿¡solo para recibir nada a cambio!?"
    nulla "哦～～我把全部的努力、热爱和心血都倾注进了这份职业，结果竟然一无所得？！"

# game/rutas/nulla.rpy:2655
translate chino continuacion_nulla1_4ca4134e:

    # nulla "¿Ni un besito tuyo, siquiera?"
    nulla "连你的一个小吻都没有吗？"

# game/rutas/nulla.rpy:2656
translate chino continuacion_nulla1_f483976a:

    # nulla "Eres cruel, mi vida~~~"
    nulla "你真残忍，我的爱人～～"

# game/rutas/nulla.rpy:2661
translate chino continuacion_nulla1_38379551:

    # nulla "¿Ohh?"
    nulla "哦？"

# game/rutas/nulla.rpy:2662
translate chino continuacion_nulla1_b122acfb:

    # nulla "Justo y razonable."
    nulla "公平合理。"

# game/rutas/nulla.rpy:2663
translate chino continuacion_nulla1_58441c5f:

    # nulla "No esperaba menos de ti."
    nulla "对你，这一点都不意外。"

# game/rutas/nulla.rpy:2664
translate chino continuacion_nulla1_833ac497:

    # "Una de las sombras te toma la mano con delicadeza, y como si intentara agradecer tu elección, acerca su cara al dorso de tu mano."
    "一道阴影轻轻握住你的手，仿佛想感谢你的选择，将脸凑近你的手背。"

# game/rutas/nulla.rpy:2665
translate chino continuacion_nulla1_e3df375a:

    # "Simula un beso. Aunque tú no sientes nada."
    "它模仿了一个吻。但你什么都感觉不到。"

# game/rutas/nulla.rpy:2670
translate chino continuacion_nulla1_ec84c111:

    # nulla "¿¡UN MILLÓN DE DÓLARES!?"
    nulla "一百万美元？！"

# game/rutas/nulla.rpy:2671
translate chino continuacion_nulla1_1c549c0b:

    # nulla "Oh~~~ Qué alma tan generosa y llena de altruismo."
    nulla "哦～～多么慷慨无私的灵魂。"

# game/rutas/nulla.rpy:2672
translate chino continuacion_nulla1_68dbf6dc:

    # nulla "No podría esperar menos de mi acompañante."
    nulla "对我的同伴，这一点都不意外。"

# game/rutas/nulla.rpy:2673
translate chino continuacion_nulla1_ec941fdc:

    # nulla "Con esto, mis pequeños bebés podrán dejar de trabajar aquí."
    nulla "有了这笔钱，我的宝贝们就能离开这里了。"

# game/rutas/nulla.rpy:2674
translate chino continuacion_nulla1_ebc092ed:

    # nulla "Abrir una tiendita de pastelería y vivir tranquilos."
    nulla "他们会开一家小面包店，安安静静地过日子。"

# game/rutas/nulla.rpy:2675
translate chino continuacion_nulla1_3ac9b8da:

    # nulla "¿No estaría genial, chicos?"
    nulla "那不是很棒吗，伙计们？"

# game/rutas/nulla.rpy:2676
translate chino continuacion_nulla1_39e9a716:

    # "Las sombras asienten, animadas."
    "阴影们热切地点头。"


# game/rutas/nulla.rpy:2680
translate chino continuacion_nulla1_3e389a27:

    # "Las sombras se retiran sin decir palabra alguna, deslizándose en dirección a la cocina. Detrás de sí dejan un camino de humo, que se puede apreciar si es que enfocas bien tus ojos."
    "阴影们一言不发地退去，滑向厨房。身后留下一道烟迹，只有你凝神细看时才能察觉。"

# game/rutas/nulla.rpy:2681
translate chino continuacion_nulla1_48a28295:

    # "Quedas a solas con Nulla una vez más."
    "你又一次只剩下和 Nulla 独处。"

# game/rutas/nulla.rpy:2682
translate chino continuacion_nulla1_de67e481:

    # "Él no dice nada al principio. Te observa con ambas manos sobre la mesa. Sus labios se entreabren, pero tarda un segundo más en hablar."
    "起初他一言不发。他望着你，双手搁在桌上。他的嘴唇微微张开，却又过了一会儿才开口。"

# game/rutas/nulla.rpy:2683
translate chino continuacion_nulla1_bfb79dd2:

    # "Hay algo que quiere decir, aunque parece no gustarle del todo."
    "他有话想说，却似乎并不情愿。"

# game/rutas/nulla.rpy:2686
translate chino continuacion_nulla1_91e9d09f:

    # nulla "Bueno... es hora de irnos."
    nulla "好了……该走了。"

# game/rutas/nulla.rpy:2688
translate chino continuacion_nulla1_0d4d3a31:

    # "Se incorpora lentamente, y extiende una mano hacia ti, esperando a que la tomes."
    "他缓缓起身，向你伸出一只手，等你握住。"

# game/rutas/nulla.rpy:2691
translate chino continuacion_nulla1_42cec6a0:

    # "Cuando tus dedos rozan los suyos, el vacío regresa, arrastrándolos a ambos al espacio donde no hay suelo ni cielo, a la nada. Marcando el final de la ilusión, el final de la cita."
    "当你的指尖擦过他的手，虚空再次降临，将你们一并拖入一个没有天与地的空间：什么也没有。为这场幻象、也为这次约会画上句点。"

# game/rutas/nulla.rpy:2693
translate chino continuacion_nulla1_f343608f:

    # nulla "Realmente la pasé bien hoy."
    nulla "今天我真的很开心。"

# game/rutas/nulla.rpy:2694
translate chino continuacion_nulla1_58d70d21:

    # "Sus palabras son sinceras, y para remarcar sus palabras: sus brazos te rodean con calma, envolviendo tu cuerpo contra el suyo en un gesto que es más íntimo que la frase que ha salido de su boca."
    "他的话语是真诚的，而为了强调这一点，他的手臂轻轻环住你——将你的身体拉近贴着他，这个姿态远比言语更亲密。"

# game/rutas/nulla.rpy:2695
translate chino continuacion_nulla1_30ad840d:

    # nulla "Muchas gracias por este día."
    nulla "非常感谢你今天的陪伴。"

# game/rutas/nulla.rpy:2696
translate chino continuacion_nulla1_4dfd7acf:

    # "Susurra junto a tu oído, con un tono bajo que apenas puedes escuchar gracias al silencio envolvente del vacío."
    "他在你耳边低语，那低沉的声音在虚空的寂静中几不可闻。"

# game/rutas/nulla.rpy:2697
translate chino continuacion_nulla1_6a82afc9:

    # "Luego toma tus manos entre las suyas, y las examina como si leyera algo importante en ellas. Las ladea, inspeccionando palmas y dorsos con toda su atención, bebiendo cada detalle que encuentra en ellas."
    "然后他捧起你的双手，像在读什么重要的东西一样端详。他轻轻翻转，全神贯注地检查掌心与手背，细品他能找出的每一处细节。"

# game/rutas/nulla.rpy:2700
translate chino continuacion_nulla1_5abd266e:

    # "No te esperas la mueca de desaprobación que hace una vez terminada su inspección."
    "你没想到，他检查完后会露出那样不赞同的表情。"

# game/rutas/nulla.rpy:2701
translate chino continuacion_nulla1_c427262e:

    # nulla "Mmm..."
    nulla "嗯……"

# game/rutas/nulla.rpy:2702
translate chino continuacion_nulla1_dc509393:

    # nulla "Creo que ya se está quedando sin combustible... Vas a tener que irte a dormir cuando estemos en casa."
    nulla "我想它快没燃料了……我们到家后你就得去睡了。"

# game/rutas/nulla.rpy:2706
translate chino continuacion_nulla1_39c1c8ff:

    # nulla "Tu marioneta está cansada."
    nulla "你的傀儡累了。"

# game/rutas/nulla.rpy:2707
translate chino continuacion_nulla1_a93e219c:

    # nulla "Hemos hecho muchas cosas hoy."
    nulla "我们今天已经做了很多事了。"

# game/rutas/nulla.rpy:2708
translate chino continuacion_nulla1_2f9f4ab1:

    # nulla "Y..."
    nulla "还有……"

# game/rutas/nulla.rpy:2709
translate chino continuacion_nulla1_eda6e643:

    # nulla "Descuidé un poco el proceso de congelamiento que le puse."
    nulla "我疏忽了施加在它身上的冷冻过程。"

# game/rutas/nulla.rpy:2710
translate chino continuacion_nulla1_863f9a11:

    # nulla "Gracias a eso, sus dedos ya están empezando a ponerse negros..."
    nulla "正因如此，它的手指开始发黑了……"

# game/rutas/nulla.rpy:2713
translate chino continuacion_nulla1_8822210a:

    # nulla "Lo siento mucho, pero no puedo arriesgarme a que algo le ocurra a tu marioneta."
    nulla "我很抱歉，但我不能冒任何让你的傀儡出事的风险。"

# game/rutas/nulla.rpy:2714
translate chino continuacion_nulla1_57ae426c:

    # nulla "Tenemos que cuidarla si quieres seguir aquí conmigo."
    nulla "如果你想继续留在这里陪我，我们就必须照顾好它。"

# game/rutas/nulla.rpy:2715
translate chino continuacion_nulla1_e9db955d:

    # nulla "Un paso en falso, y todo el progreso que hicimos se perdería."
    nulla "只要走错一步，我们所有的进展都会付诸东流。"

# game/rutas/nulla.rpy:2718
translate chino continuacion_nulla1_6e6030c9:

    # "Y como si tu cuerpo esperara esa confirmación, el peso comienza a acumularse en tus párpados. Te cuesta mantener los ojos abiertos y el cansancio se instala en tus extremidades, haciendo que tu cuerpo se sienta pesado."
    "仿佛你的身体一直在等待这个确认，眼皮开始沉甸甸的。你难以睁开双眼，疲倦渗入四肢，让身体变得沉重。"

# game/rutas/nulla.rpy:2719
translate chino continuacion_nulla1_d87f9138:

    # "Nulla anticipa lo que puede pasar, por lo que decide actuar antes de que caigas. Con cuidado, lleva tus manos a su cintura para que puedas sostenerte de él."
    "Nulla 预料到即将发生的事，在你倒下之前采取了行动。他轻柔地把你的双手引到自己腰间，好让你抓住他。"

# game/rutas/nulla.rpy:2722
translate chino continuacion_nulla1_ee307e21:

    # "En un parpadeo, la habitación donde duermes se manifiesta frente a ustedes. No sabes si caminaron hasta ella o simplemente aparecieron allí, pero en ese momento ya están frente a su cama."
    "眨眼之间，你睡觉的房间显现在你面前。你不确定是自己走过去的，还是直接出现在那里——此刻你正站在他的床边。"

# game/rutas/nulla.rpy:2723
translate chino continuacion_nulla1_8ae04d5c:

    # "Nulla te ayuda a sentarte con delicadeza. Luego, sin apuro, se arrodilla para quitarte los zapatos, sin compartir una sola palabra contigo."
    "Nulla 轻轻扶你坐下。随后，他不慌不忙地跪下来替你脱鞋，一句话也没说。"

# game/rutas/nulla.rpy:2724
translate chino continuacion_nulla1_1bc4bb4e:

    # "Cuando termina, se pone de pie, levanta la cubrecama, y se aparta un paso para darte espacio, invitándote a meterte bajo las sábanas."
    "完成后，他站起身，掀开毯子，退开一步给你腾出空间，示意你钻到被单下面。"

# game/rutas/nulla.rpy:2725
translate chino continuacion_nulla1_409f8636_6:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2726
translate chino continuacion_nulla1_9a99acc1:

    # "Te acomodas dentro de las sábanas con lentitud. Cuando al fin estás arropado, levantas la mirada."
    "你慢慢躺进被单里。终于盖好被子后，你抬起了目光。"

# game/rutas/nulla.rpy:2727
translate chino continuacion_nulla1_4770d1c8:

    # "Nulla te observa, inmóvil."
    "Nulla 一动不动地看着你。"

# game/rutas/nulla.rpy:2728
translate chino continuacion_nulla1_5d87c8d4:

    # "Durante unos segundos, no dice nada. Nulla te devuelve la mirada, pensativo por unos segundos, antes de esbozar una sonrisa ladeada"
    "几秒钟里，他一句话也没说。Nulla 再次与你对视，若有所思，随后露出一抹歪斜的微笑。"

# game/rutas/nulla.rpy:2729
translate chino continuacion_nulla1_7eaab284:

    # nulla "Puedo quedarme contigo hasta que te duermas..."
    nulla "我可以陪你，直到你睡着……"

# game/rutas/nulla.rpy:2732
translate chino continuacion_nulla1_4ca22c08:

    # "Nulla sonríe y te desea las buenas noches."
    "Nulla 微笑着向你道晚安。"

# game/rutas/nulla.rpy:2734
translate chino continuacion_nulla1_94371c6d:

    # "Abandona el lugar luego de apagar las luces."
    "他关了灯，离开了房间。"

# game/rutas/nulla.rpy:2737
translate chino continuacion_nulla1_be76d58e:

    # "Su reacción es inmediata. Sus ojos se abren con sorpresa durante un instante, pero pronto su expresión vuelve a la normalidad, como si no esperara tu respuesta."
    "他的反应几乎是瞬间的。他的眼睛瞬间睁大，像是没料到你的回答，但很快神情又恢复了正常。"

# game/rutas/nulla.rpy:2738
translate chino continuacion_nulla1_e1711b6d:

    # nulla "Okay."
    nulla "好。"

# game/rutas/nulla.rpy:2739
translate chino continuacion_nulla1_bc0da8a9:

    # "Es lo único que sale como respuesta, aunque no puede evitar que una sonrisa se dibuje y se ensanche en sus labios."
    "他只回了这么一句，却忍不住笑意在唇边漾开。"

# game/rutas/nulla.rpy:2741
translate chino continuacion_nulla1_dff93593:

    # "Nulla se recuesta a tu lado, optando por no meterse debajo de las sábanas."
    "Nulla 在你身旁躺下，选择不钻进被单。"

# game/rutas/nulla.rpy:2742
translate chino continuacion_nulla1_7a334d6b:

    # "Y suspira, dejando salir toda tensión al momento en que su cuerpo se relaja a tu lado."
    "他呼出一口气，身体在你身旁放松下来，卸下了所有紧绷。"

# game/rutas/nulla.rpy:2743
translate chino continuacion_nulla1_30421594:

    # nulla "Si hubiéramos cazado uno más ayer, tendríamos tres días..."
    nulla "要是昨天我们多猎一只，就有三天了……"

# game/rutas/nulla.rpy:2746
translate chino continuacion_nulla1_d4d52d99:

    # nulla "Ahgg--"
    nulla "啊唔——"

# game/rutas/nulla.rpy:2747
translate chino continuacion_nulla1_86cedc34:

    # "Sus manos frotan sus mejillas con fuerza."
    "他用双手用力揉搓着自己的脸颊。"

# game/rutas/nulla.rpy:2748
translate chino continuacion_nulla1_3aa7ec63:

    # nulla "Quiero otro día más contigo."
    nulla "我想再和你多过一天。"

# game/rutas/nulla.rpy:2749
translate chino continuacion_nulla1_51999cfa:

    # nulla "No quiero llegar al séptimo día aún..."
    nulla "我还没想到达第七天……"

# game/rutas/nulla.rpy:2751
translate chino continuacion_nulla1_4a9c7a6d:

    # nulla "Y descansar un día más."
    nulla "再多休息一天。"

# game/rutas/nulla.rpy:2755
translate chino continuacion_nulla1_68283f2a:

    # "Sin avisar ni decir una palabra, te acercas a él, envolviendo tus manos alrededor de su cuerpo, tanteando y deslizando tus manos en su espalda, lenta y delicadamente."
    "没有预兆，也没有一句话，你向他挪近，双臂环住他的身体，慢慢地、温柔地用双手抚摸并滑过他的后背。"

# game/rutas/nulla.rpy:2756
translate chino continuacion_nulla1_080f86d3:

    # "Tu abrazo es recibido con urgencia inmediata. Nulla te aprieta contra su pecho, como si quisiera no soltarte jamás, consumirte y guardarte dentro de sí."
    "你的拥抱立刻换来同等的急切。Nulla 把你紧紧按在胸前，仿佛永远不愿松手，仿佛要将你吞没，把你藏在自己体内。"

# game/rutas/nulla.rpy:2758
translate chino continuacion_nulla1_65e879e8:

    # "Sus labios te buscan y esperan, tan cerca que su nariz roza la tuya."
    "他的双唇寻找着你、等待着你，近到鼻尖轻轻擦过你的。"

# game/rutas/nulla.rpy:2759
translate chino continuacion_nulla1_dcc57326:

    # nulla "Te tengo al frente. No la marioneta, no... tú."
    nulla "你在我面前。不是傀儡，不……是你。"

# game/rutas/nulla.rpy:2760
translate chino continuacion_nulla1_c4a08cc4:

    # "Suena como un mantra que intenta manifestar algo que es imposible. Tan desesperado que realmente parece que ya se ha convencido de aquello."
    "这听起来像一句咒语，试图让某件不可能的事成真。如此绝望，几乎让你觉得他已经说服自己相信了。"

# game/rutas/nulla.rpy:2761
translate chino continuacion_nulla1_f5a8dfd5:

    # "Pero por hoy ambos juegan a fingir."
    "但今晚，你们俩都假装着。"

# game/rutas/nulla.rpy:2762
translate chino continuacion_nulla1_2f7bf3c8:

    # "Que todo está bien."
    "假装一切都很好。"

# game/rutas/nulla.rpy:2763
translate chino continuacion_nulla1_671983f6:

    # "Que todo tiene sentido."
    "假装一切都有意义。"

# game/rutas/nulla.rpy:2764
translate chino continuacion_nulla1_59db5d4f:

    # "Que todo esto es real."
    "假装这一切都是真的。"

# game/rutas/nulla.rpy:2769
translate chino continuacion_nulla1_115d575a:

    # "Sellas tus labios con los suyos: un roce suave y tierno."
    "你的唇覆上他的：一次柔软而温柔的触碰。"

# game/rutas/nulla.rpy:2770
translate chino continuacion_nulla1_764bee0b:

    # "Pero eso basta para que Nulla lo tome todo. El beso se transforma, se profundiza, volviéndose íntimo y exigente."
    "但仅此就足以让 Nulla 夺走一切。这个吻蜕变、加深，变得亲密而急切。"

# game/rutas/nulla.rpy:2771
translate chino continuacion_nulla1_81651b2c:

    # "Te consume. Es embriagador, como si intentara fundirse contigo en ese único contacto."
    "他吞噬着你。这令人沉醉，仿佛他想通过这唯一的接触与你融为一体。"

# game/rutas/nulla.rpy:2772
translate chino continuacion_nulla1_1ac9a54c:

    # "Sus manos se suman a la danza, acariciando tu cuello y mandíbula, sujetándote con firmeza, guiándote."
    "他的双手加入这场舞，抚过你的脖颈与下颌，稳稳按住你，引导着你。"

# game/rutas/nulla.rpy:2773
translate chino continuacion_nulla1_48ea6e9b:

    # "Cuando el aire comienza a faltarte, Nulla se separa apenas soltando un suspiro ahogado, que hace que envía una corriente eléctrica por todo tu...body. The sound of that muffled sigh sends a shiver through you."
    "当你开始喘息时，Nulla 带着一声压抑的叹息退开，让一股电流窜过你的……身体。那声被压抑的叹息让你浑身一颤"
    
# game/rutas/nulla.rpy:2774
translate chino continuacion_nulla1_fa2eb94b:

    # "Nulla esconde el rostro en el hueco entre tu cuello y tu hombro."
    "Nulla 把脸埋进你颈与肩之间的凹陷处。"

# game/rutas/nulla.rpy:2775
translate chino continuacion_nulla1_90282158:

    # "Allí, planta otro beso en tu cuello, suave justo sobre tu piel."
    "在那里，他又在你的脖颈上落下一个吻，轻柔得几乎只是擦过皮肤。"

# game/rutas/nulla.rpy:2777
translate chino continuacion_nulla1_f8a42b41:

    # nulla "Creo que es suficiente por hoy."
    nulla "我想今天就到此为止吧。"

# game/rutas/nulla.rpy:2781
translate chino continuacion_nulla1_91525914:

    # "Obtienes una risa seca, riéndose de lo que estuvo a punto de hacer..."
    "你听到他发出一声干笑，像是在自嘲刚才差点做出的事……"


# game/rutas/nulla.rpy:2782
translate chino continuacion_nulla1_d3387e86:

    # nulla "Gracias."
    nulla "谢谢你。"

# game/rutas/nulla.rpy:2783
translate chino continuacion_nulla1_896580ba:

    # "Es lo único que sale de sus labios."
    "这是他唇间唯一溢出的话。"

# game/rutas/nulla.rpy:2785
translate chino continuacion_nulla1_a20cefa7_2:

    # "..."
    "..."

# game/rutas/nulla.rpy:2790
translate chino continuacion_nulla1_1b49a68d:

    # nulla "Daría todo lo que tengo para que seas lo último que vea antes de ir a dormir."
    nulla "我愿意付出我拥有的一切，只为让你成为我睡前所见的最后一幕。"

# game/rutas/nulla.rpy:2791
translate chino continuacion_nulla1_2fe8b1fa:

    # nulla "Si no supiera lo suficiente, intentaría arrancarte de ahí para traerte aquí, conmigo :)"
    nulla "如果不是知道得太多，我真想把你从那里拽出来，让你来我这里陪我。 :)"

# game/rutas/nulla.rpy:2795
translate chino continuacion_nulla1_2f21ff52:

    # "Su respiración es extrañamente tranquila, pero en su pecho puedes sentir un latido intenso... o quizás es el tuyo. Ya no puedes discernir entre lo que es suyo y lo que es tuyo."
    "他的呼吸异常平静，可在他的胸膛上，你能感到一声深沉而稳定的心跳……又或许那是你的。你再也无法分辨哪里是你、哪里是他。"

# game/rutas/nulla.rpy:2796
translate chino continuacion_nulla1_5e778c0e:

    # "Pero estás seguro de una cosa: no quieres romper esta conexión por ahora."
    "但你确信一件事：你不想断开这个连接。还不想。"

# game/rutas/nulla.rpy:2798
translate chino continuacion_nulla1_4231dab3:

    # "Así que optas por cerrar los ojos y rogar en silencio para que Nulla no se vaya en medio de la noche."
    "于是你闭上眼睛，默默祈祷 Nulla 不会在半夜消失。"

# game/rutas/nulla.rpy:2799
translate chino continuacion_nulla1_c51d7991:

    # " . . . "
    " . . . "

# game/rutas/nulla.rpy:2801
translate chino continuacion_nulla1_9fd7a243:

    # "La mañana siguiente sigue la misma rutina que la anterior."
    "第二天早晨和前一天一样。"

# game/rutas/nulla.rpy:2802
translate chino continuacion_nulla1_7b7fdaaf:

    # "Nulla te trae el desayuno a la cama, anunciando que el día de hoy saldrán en la noche nuevamente. Por lo que pueden pasar el resto del día descansando."
    "Nulla 把早餐端到床上，宣布今晚你们还要再出去一次。他说在那之前，你们俩可以用整天休息。"

# game/rutas/nulla.rpy:2803
translate chino continuacion_nulla1_5dc667bb:

    # "Terminando el desayuno, Nulla toma la bandeja y te pide que tengas cuidado al caminar si es que quieres salir de la habitación."
    "你吃完后，Nulla 端走托盘，提醒你若决定离开房间就要小心些。"

# game/rutas/nulla.rpy:2805
translate chino continuacion_nulla1_1db67424:

    # "Nulla te da un beso en la frente y sale de la habitación, dejándote a solas."
    "离开房间前，他在你的额头上轻轻印下一吻，然后悄然关上身后的门。"

# game/rutas/nulla.rpy:2808
translate chino continuacion_nulla1_23a3cafd:

    # "Nulla se excusa y sale de la habitación con la bandeja entre las manos."
    "Nulla 告辞一声，端着托盘走出了房间。"

# game/rutas/nulla.rpy:2810
translate chino continuacion_nulla1_e157535a:

    # "Esperas un segundo antes de decidir que hacer ahora."
    "你等了一会儿，才决定接下来该怎么做。"

# game/rutas/nulla.rpy:2814
translate chino continuacion_nulla1_a20cefa7_3:

    # "..."
    "..."

# game/rutas/nulla.rpy:2815
translate chino continuacion_nulla1_d433b732:

    # "Te duermes al instante."
    "你几乎立刻就睡着了。"

# game/rutas/nulla.rpy:2816
translate chino continuacion_nulla1_66d411fc:

    # "El tiempo se distorsiona, no sabes por cuantos minutos o horas has dormido, pero la mano de Nulla en tu hombro hace que abras los ojos."
    "时间扭曲折叠——你分不清过去了几分钟还是几小时——直到 Nulla 的手落在你的肩上，把你拉回了意识。"

# game/rutas/nulla.rpy:2818
translate chino continuacion_nulla1_54ffd34b:

    # "Nulla te despierta y te lleva a la cocina para que tomes o comas algo."
    "Nulla 轻轻叫醒你，带你去了厨房，好让你吃点或喝点什么。"

# game/rutas/nulla.rpy:2819
translate chino continuacion_nulla1_a98ccd00:

    # "Él se ofrece a preparar todo, por lo que tú solo te dedicas a observar."
    "他坚持要自己准备好一切，你只管看着。"

# game/rutas/nulla.rpy:2820
translate chino continuacion_nulla1_95e6f111:

    # "Se ve lindo haciendo todo el trabajo."
    "他做着这一切的时候，意外地显得有些可爱。"

# game/rutas/nulla.rpy:2824
translate chino continuacion_nulla1_fc47f702:

    # "Te levantas de la cama. Estar de pie te hace notar lo pesado que se siente tu cuerpo, por lo que te estiras un poco."
    "你下了床。站起身才发觉身体沉得厉害，于是稍微伸了个懒腰，把沉重感甩掉。"

# game/rutas/nulla.rpy:2829
translate chino continuacion_nulla2_7ba04d5a:

    # nulla "Estaba pensando en ir a mis memorias."
    nulla "我正想着，要去我的记忆里走一趟。"

# game/rutas/nulla.rpy:2832
translate chino continuacion_nulla2_b5c060cb:

    # nulla "Con eso tengo más material para trabajar."
    nulla "那样我就有更多材料可以着手了。"

# game/rutas/nulla.rpy:2833
translate chino continuacion_nulla2_02ee6953:

    # nulla "Tener una cita normal de una buena vez por todas..."
    nulla "总算能好好来一次正常的约会了……"

# game/rutas/nulla.rpy:2836
translate chino continuacion_nulla2_4fee5445:

    # nulla "Podríamos hacer un picnic o--"
    nulla "我们可以去野餐，或者——"

# game/rutas/nulla.rpy:2839
translate chino continuacion_nulla2_1d00759d:

    # nulla "Oh! ya sé... ¿Qué tal visitar una feria?"
    nulla "哦！我知道了……去看看集市怎么样？"

# game/rutas/nulla.rpy:2840
translate chino continuacion_nulla2_38d85c3d:

    # nulla "Subirnos a la rueda de la fortuna... o jugar en los puestos para ganar premios."
    nulla "去坐摩天轮……或者在摊位上玩小游戏赢奖品。"

# game/rutas/nulla.rpy:2843
translate chino continuacion_nulla2_71d31e84:

    # nulla "¿Qué dices?"
    nulla "你说呢？"

# game/rutas/nulla.rpy:2846
translate chino continuacion_nulla2_c0876f46:

    # "............."
    "............."

# game/rutas/nulla.rpy:2847
translate chino continuacion_nulla2_34f1a317:

    # "¿Será seguro ir ahí?"
    "去那里安全吗？"

# game/rutas/nulla.rpy:2850
translate chino continuacion_nulla2_fe43f814:

    # nulla "¡Claro que es seguro!"
    nulla "当然安全！"

# game/rutas/nulla.rpy:2851
translate chino continuacion_nulla2_b3179049:

    # nulla "Siempre y cuando te quedes a mi lado."
    nulla "只要你一直陪在我身边。"

# game/rutas/nulla.rpy:2856
translate chino continuacion_nulla2_f7e05489:

    # nulla "Bien."
    nulla "好。"

# game/rutas/nulla.rpy:2857
translate chino continuacion_nulla2_55519b75:

    # nulla "Me iré preparando entonces."
    nulla "那我先去准备。"

# game/rutas/nulla.rpy:2862
translate chino continuacion_nulla2_409f8636:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:2865
translate chino continuacion_nulla2_6c301622:

    # nulla "[nombrejugador], mi vida, mi cielo..."
    nulla "[nombrejugador]，我的生命，我的蓝天……"

# game/rutas/nulla.rpy:2868
translate chino continuacion_nulla2_24e9636b:

    # nulla "No te preocupes."
    nulla "别担心。"

# game/rutas/nulla.rpy:2869
translate chino continuacion_nulla2_7f5e1759:

    # nulla "Sé manejar mis memorias."
    nulla "我知道怎么应付自己的记忆。"

# game/rutas/nulla.rpy:2870
translate chino continuacion_nulla2_2bfaffe3:

    # nulla "Hoy es un día para divertirse."
    nulla "今天是用来开心的日子。"

# game/rutas/nulla.rpy:2873
translate chino continuacion_nulla2_578f3a3d:

    # nulla "Hay que aprovecharlo."
    nulla "可得好好利用才行。"

# game/rutas/nulla.rpy:2877
translate chino continuacion_nulla2_7a291aa4:

    # "La tetera comienza a silbar. Nulla detiene el cuchillo a medio corte, para dejar la fruta a un lado y levantarse a servir el té."
    "水壶开始呜呜作响。Nulla 停下切到一半的刀，把水果放到一旁，起身去倒茶。"

# game/rutas/nulla.rpy:2878
translate chino continuacion_nulla2_408817c5:

    # nulla "Iremos después de esto."
    nulla "等这个弄完我们就去。"


# game/rutas/nulla.rpy:2879
translate chino continuacion_nulla2_29885a5a:

    # "Mientras llena las tazas con agua caliente, Nulla sonríe como si recordara algo."
    "他往杯子里倒满热水时，Nulla 微笑起来，像是想起了什么。"

# game/rutas/nulla.rpy:2880
translate chino continuacion_nulla2_0539b7bb:

    # nulla "Si te asusta la idea de separarte de mí..."
    nulla "如果你害怕离开我……"

# game/rutas/nulla.rpy:2881
translate chino continuacion_nulla2_7b072bdd:

    # nulla "Toma."
    nulla "拿着。"

# game/rutas/nulla.rpy:2883
translate chino continuacion_nulla2_ea48bb8f:

    # "Todo se vuelve blando de repente..."
    "一切忽然变得柔软……"

# game/rutas/nulla.rpy:2885
translate chino continuacion_nulla2_14ad2cca:

    # "Deja la tetera a un lado, y te extiende la mano, abierta... no hay nada ahí."
    "他把水壶放到一旁，向你伸出手——掌心张开……却什么都没有。"

# game/rutas/nulla.rpy:2886
translate chino continuacion_nulla2_f9d0e41a:

    # "Notando tu confusión, Nulla cierra el puño con fuerza, y aprieta hasta que sus nudillos comienzan a decolorarse."
    "Nulla 察觉到你的困惑，猛地握紧拳头，越攥越紧，直到指节因用力而泛白。"

# game/rutas/nulla.rpy:2888
translate chino continuacion_nulla2_c9d8957b:

    # "De entre sus dedos comienza a brotar una masa oscura y viscosa, que palpita. Simulando una respiración."
    "一道漆黑黏稠的物质从他指缝间渗出，有节奏地搏动着，像是在呼吸。"

# game/rutas/nulla.rpy:2889
translate chino continuacion_nulla2_f61720ab:

    # "La observas, con curiosidad."
    "你看着它，心里好奇又不安。"

# game/rutas/nulla.rpy:2890
translate chino continuacion_nulla2_ac14c368:

    # "Apenas la tomas, la uhh-- ¿pequeña... criatura?, esta se agita suavemente entre tus manos."
    "你刚把它，呃……这个小小的……生物？接过来，它就在你手中轻轻扭动起来。"

# game/rutas/nulla.rpy:2891
translate chino continuacion_nulla2_03905d82:

    # "Entonces, seis ojos se abren, para devolverte la mirada."
    "接着，六只眼睛睁开了，回望着你。"

# game/rutas/nulla.rpy:2892
translate chino continuacion_nulla2_77a10bd6:

    # "Te miran con la misma curiosidad con la que tú los mirabas a ellos."
    "它们望着你的眼神，和你望着它们时一模一样。"

# game/rutas/nulla.rpy:2893
translate chino continuacion_nulla2_cc9a5909:

    # "!!!"
    "!!!"

# game/rutas/nulla.rpy:2895
translate chino continuacion_nulla2_4092d46e:

    # nulla "Ja."
    nulla "呵。"

# game/rutas/nulla.rpy:2896
translate chino continuacion_nulla2_9b6d93f1:

    # nulla "Si tienes miedo de alejarte, puedo darte una parte de mí."
    nulla "如果你害怕离开我，我可以分你一部分自己。"

# game/rutas/nulla.rpy:2897
translate chino continuacion_nulla2_162bcf12:

    # nulla "Con esto, siempre podrás volver."
    nulla "有了它，你随时都能回来。"

# game/rutas/nulla.rpy:2898
translate chino continuacion_nulla2_ae422a22:

    # nulla "No importa dónde estés..."
    nulla "无论你在哪里……"

# game/rutas/nulla.rpy:2899
translate chino continuacion_nulla2_b43cb319:

    # nulla "--ni en qué línea de tiempo te encuentres :)"
    nulla "——也无论你身处哪条时间线 :)"

# game/rutas/nulla.rpy:2901
translate chino continuacion_nulla2_307d8cc7:

    # nulla "Aunque solo podrás usarlo cuando estés lejos de mí."
    nulla "不过，只有当你离我很远的时候，才能用它。"

# game/rutas/nulla.rpy:2902
translate chino continuacion_nulla2_d23828ff:

    # nulla "Debo cuidar mi energía..."
    nulla "我得省着点力气……"

# game/rutas/nulla.rpy:2903
translate chino continuacion_nulla2_4b17a99b:

    # nulla "Lo entiendes, ¿cierto, cariño?"
    nulla "你明白的，对吧，亲爱的？"

# game/rutas/nulla.rpy:2905
translate chino continuacion_nulla2_6ca92ec6:

    # "No puedes responder, pues la criatura se inserta en tu piel y es absorbida por ella."
    "你无法回答，因为那只生物钻进了你的皮肤，被彻底吸收了。"

# game/rutas/nulla.rpy:2906
translate chino continuacion_nulla2_129f22e8:

    # "Ya no queda rastro de la masa."
    "那团物质已消失得无影无踪。"

# game/rutas/nulla.rpy:2910
translate chino continuacion_nulla2_8784a0f2:

    # nulla "Oh..."
    nulla "哦……"

# game/rutas/nulla.rpy:2912
translate chino continuacion_nulla2_73cc6b08:

    # nulla "Ohhh, jajajaja."
    nulla "噢呵呵呵。"

# game/rutas/nulla.rpy:2913
translate chino continuacion_nulla2_dd0d7aec:

    # nulla "Así que esto es lo que has estado haciendo cuando no tengo acceso completo a ti..."
    nulla "原来当我不在你能完全接触到你的时候，你一直在做这种事……"

# game/rutas/nulla.rpy:2914
translate chino continuacion_nulla2_630c2d2e:

    # nulla "Jajajajaja--"
    nulla "哈哈哈哈——"

# game/rutas/nulla.rpy:2916
translate chino continuacion_nulla2_b6d03242:

    # nulla "No lo puedo creer."
    nulla "我简直不敢相信。"

# game/rutas/nulla.rpy:2918
translate chino continuacion_nulla2_a20cefa7:

    # "..."
    "..."

# game/rutas/nulla.rpy:2919
translate chino continuacion_nulla2_d0800207:

    # nulla "Lo siento mucho, pero no puedo aceptar esto."
    nulla "非常抱歉，但这个我不能接受。"

# game/rutas/nulla.rpy:2921
translate chino continuacion_nulla2_a1bb173b:

    # "Nulla se acerca tanto a ti que, de forma inconsciente, retrocedes. La acción es tan repentina que tu cuerpo reacciona solo."
    "Nulla 逼得那么近，你下意识地后退了一步。动作来得太快，身体自己就反应了。"

# game/rutas/nulla.rpy:2922
translate chino continuacion_nulla2_fdd66c80:

    # "Su expresión te aterra un poco... Son muy pocas las veces en que has visto ese semblante dirigido a ti."
    "他的神情让你有些恐惧……你很少见到这样的目光落在自己身上。"

# game/rutas/nulla.rpy:2923
translate chino continuacion_nulla2_e4aa7eb2:

    # "Sus labios ya no tienen esa sonrisa cálida que suele recibirte cuando te habla."
    "他的唇上，再没有往日开口时迎接你的那抹温暖笑容。"

# game/rutas/nulla.rpy:2924
translate chino continuacion_nulla2_9656280f:

    # "No. Ahora está serio. Las cejas fruncidas."
    "没有了。现在的他十分严肃，眉头紧锁。"

# game/rutas/nulla.rpy:2925
translate chino continuacion_nulla2_d1e2df84:

    # "Y todo por algo que tú permitiste."
    "而这一切，都是你允许的。"

# game/rutas/nulla.rpy:2926
translate chino continuacion_nulla2_70079184:

    # "Nulla enfoca su mirada en la esquina superior de la pantalla y levanta la mano."
    "Nulla 将目光锁定在屏幕的右上角，抬起了手。"

# game/rutas/nulla.rpy:2927
translate chino continuacion_nulla2_d27c9b16:

    # "Le basta con tocar el ícono con un dedo para que desaparezca."
    "他只用一根手指碰了碰，那个图标便消失了。"

# game/rutas/nulla.rpy:2930
translate chino continuacion_nulla2_3cbe8b92:

    # "Hecho eso, su sonrisa regresa."
    "做完这一切，他的笑容又回来了。"

# game/rutas/nulla.rpy:2931
translate chino continuacion_nulla2_f101f276:

    # "Como si nada hubiese pasado."
    "仿佛什么都没发生过。"

# game/rutas/nulla.rpy:2932
translate chino continuacion_nulla2_3b5825a8:

    # nulla "Haré lo mismo con ese bastardo."
    nulla "我会用同样的方式对付那个混蛋。"

# game/rutas/nulla.rpy:2934
translate chino continuacion_nulla2_81a8adba:

    # nulla "Solo tienes que esperar, mi vida."
    nulla "你只管等我，我的生命。"

# game/rutas/nulla.rpy:2935
translate chino continuacion_nulla2_75b86716:

    # "El silencio que se genera es aterrador."
    "随后的沉默令人毛骨悚然。"

# game/rutas/nulla.rpy:2936
translate chino continuacion_nulla2_cd2ce37a:

    # "Aunque sonríe, su aura es densa. Negativa. Pesada sobre el ambiente, que te hunde con el paso de los segundos."
    "尽管他微笑着，他的气场却异常沉重，负面而压抑，压在空气里，随着每一秒的流逝将你一点点淹没。"

# game/rutas/nulla.rpy:2937
translate chino continuacion_nulla2_c9c9fc1d:

    # "Hasta que... se esfuma."
    "直到……它消散了。"

# game/rutas/nulla.rpy:2938
translate chino continuacion_nulla2_33125f4f:

    # "Nulla sonríe como si nada hubiera pasado."
    "Nulla 又笑了，好像什么都没发生过。"

# game/rutas/nulla.rpy:2941
translate chino continuacion_nulla2_a20cefa7_1:

    # "..."
    "..."

# game/rutas/nulla.rpy:2944
translate chino continuacion_nulla2_b8d41968:

    # nulla "¡Pero mira qué lindo ícono te has ganado!"
    nulla "不过瞧瞧，你赢得了一个多可爱的小图标啊！"

# game/rutas/nulla.rpy:2945
translate chino continuacion_nulla2_d2280dfa:

    # "Nulla señala hacia la izquierda de la pantalla."
    "Nulla 指向屏幕的左侧。"

# game/rutas/nulla.rpy:2947
translate chino continuacion_nulla2_b9cef42a:

    # nulla "Ahora no funciona... pero se ve lindo."
    nulla "现在它还不能用……但看起来挺好看的。"

# game/rutas/nulla.rpy:2949
translate chino continuacion_nulla2_c9ad74c8:

    # nulla "Ahora soy tuyo."
    nulla "现在，我是属于你的了。"

# game/rutas/nulla.rpy:2950
translate chino continuacion_nulla2_1d2f001d:

    # nulla "Y no tienes a nadie más que a mí <3."
    nulla "而你除了我，谁也没有 <3"

# game/rutas/nulla.rpy:2952
translate chino continuacion_nulla2_c493798f:

    # "Nulla finalmente se aleja. Se lo ve satisfecho con lo que ha hecho."
    "Nulla 终于退开了。他看起来对自己所做的一切相当满意。"

# game/rutas/nulla.rpy:2953
translate chino continuacion_nulla2_fea69517:

    # "Te reconforta, al menos, no sentir ningún dolor. Tu cuerpo no ha sufrido daño, por lo que puedes asumir que esta 'parte de Nulla' es un extra. Algo útil... en caso de emergencia."
    "至少，不感到任何疼痛让你稍稍安心。你的身体没有受损，于是你可以推测，这“Nulla 的一部分”算是一种额外福利——某种有用的、或许……应急的东西。"

# game/rutas/nulla.rpy:2954
translate chino continuacion_nulla2_80d06fa4:

    # "Si es que alguna vez existe una emergencia."
    "假如真的有那么一天需要应急。"


# game/rutas/nulla.rpy:2955
translate chino continuacion_nulla2_888331bd:

    # "De hecho, no estaría mal poder usarlo también en otros guardados. Poder acceder rápidamente a Nulla suena bastante útil."
    "事实上，在其他存档里也能用它倒也不错。能快速接触到 Nulla，听起来相当方便。"

# game/rutas/nulla.rpy:2956
translate chino continuacion_nulla2_3fd6ef3f:

    # nulla "Bueno. Es momento de irnos a la cita."
    nulla "好了。该出发去约会了。"

# game/rutas/nulla.rpy:2957
translate chino continuacion_nulla2_91a78d69:

    # nulla "Espero que te guste."
    nulla "希望你会喜欢。"

# game/rutas/nulla.rpy:2958
translate chino continuacion_nulla2_8ca878ee:

    # nulla "Ya tengo todo el plan para hoy."
    nulla "今天的一切我都已经安排好了。"

# game/rutas/nulla.rpy:2960
translate chino continuacion_nulla2_714ebf91:

    # "Sus manos se entrelazan con las tuyas, asegurando el contacto antes de sumergirse en el vacío."
    "他的手指与你十指相扣，在潜入虚空之前，将这份接触牢牢系住。"

# game/rutas/nulla.rpy:2962
translate chino continuacion_nulla2_c2dc5fbe:

    # "Dejas de ver."
    "你不再看见。"

# game/rutas/nulla.rpy:2963
translate chino continuacion_nulla2_30870b06:

    # "Dejas de escuchar."
    "你不再听见。"

# game/rutas/nulla.rpy:2964
translate chino continuacion_nulla2_20d8cfe6:

    # "Sientes que flotas. Solo. Nulla ya no está contigo."
    "你感到自己在漂浮。孤身一人。Nulla 已不在你身边。"

# game/rutas/nulla.rpy:2965
translate chino continuacion_nulla2_8314c863:

    # "No puedes evitar entrar en pánico. Te falta el aire y sientes que caes por un precipicio sin fin."
    "你无法抑制恐慌袭来。你喘不上气，感觉正坠入一个无底的深渊，永无止境。"

# game/rutas/nulla.rpy:2966
translate chino continuacion_nulla2_2fa80218:

    # "Es la primera vez que pasa esto."
    "这是第一次发生这种事。"

# game/rutas/nulla.rpy:2967
translate chino continuacion_nulla2_b7a8c860:

    # "{glitch=20.0}{color=ffffff}{b}Shhh, no pasa nada.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}嘘——没事的。{/glitch}"

# game/rutas/nulla.rpy:2968
translate chino continuacion_nulla2_4cb5071a:

    # "{glitch=20.0}{color=ffffff}{b}Espera un poco más.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}再多等一会儿。{/glitch}"

# game/rutas/nulla.rpy:2972
translate chino continuacion_nulla2_a20cefa7_2:

    # "..."
    "..."

# game/rutas/nulla.rpy:2973
translate chino continuacion_nulla2_d176a608:

    # "{glitch=20.0}{color=ffffff}{b}JAjajajaaaaa.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}哈哈哈哈啊啊啊。{/glitch}"

# game/rutas/nulla.rpy:2974
translate chino continuacion_nulla2_a776f384:

    # "{glitch=20.0}{color=ffffff}{b}Obviamente, mi vida.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}显而易见，我的生命。{/glitch}"

# game/rutas/nulla.rpy:2977
translate chino continuacion_nulla2_a20cefa7_3:

    # "..."
    "..."

# game/rutas/nulla.rpy:2978
translate chino continuacion_nulla2_085768d9:

    # "................"
    "................"

# game/rutas/nulla.rpy:2979
translate chino continuacion_nulla2_e81e3c97:

    # "{glitch=20.0}{color=ffffff}{b}......................{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}......................{/glitch}"

# game/rutas/nulla.rpy:2980
translate chino continuacion_nulla2_0eb2e14b:

    # "{glitch=20.0}{color=ffffff}{b}¿Cómo?{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}什么？{/glitch}"

# game/rutas/nulla.rpy:2981
translate chino continuacion_nulla2_501ba8c4:

    # "{glitch=20.0}{color=ffffff}{b}¿Por qué estás tan paranoico?{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}你为什么这么偏执？{/glitch}"

# game/rutas/nulla.rpy:2982
translate chino continuacion_nulla2_fa5ef063:

    # "{glitch=20.0}{color=ffffff}{b}No me voy a ir a ningún lado. Y mucho menos te dejaría con otra persona...{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}我哪儿也不会去。我更不可能把你交给别人……{/glitch}"

# game/rutas/nulla.rpy:2984
translate chino continuacion_nulla2_e599a579:

    # "Tus pies tocan el suelo al fin."
    "你的双脚终于触到了地面。"

# game/rutas/nulla.rpy:2987
translate chino continuacion_nulla2_4bc9ab06:

    # "Al hacerlo, el mundo se ilumina y el sonido llega a tus oídos, como si alguien pulsara un interruptor que acciona estos estímulos para inundar tus sentidos cruelmente. Hay tantas luces que, por un momento, te cuesta enfocar la vista."
    "就在你落地的瞬间，世界骤然亮起，声音涌入耳中，仿佛有人按下开关，无情地灌满你的感官。灯光多到让人一时难以聚焦。"

# game/rutas/nulla.rpy:2989
translate chino continuacion_nulla2_9ea80eb6:

    # "Cuando lo logras, reconoces el lugar sin problemas: una especie de carnaval o feria, con puestos de comida y juegos donde probar suerte. Juegos que probablemente están arreglados para que casi nadie gane el premio."
    "等视线恢复，你一眼就认出这个地方：一个集市般的游乐场，摆满了食品摊位和碰运气的游戏（多半早就被做过手脚，几乎没有人能赢到奖品）。"

# game/rutas/nulla.rpy:2990
translate chino continuacion_nulla2_13eb45cc:

    # "Hay gente, pero no demasiada. Puedes moverte sin que invadan tu espacio personal, sin ser empujado por personas distraídas. Es perfecto, lo justo como para convencerte de que todo saldrá bien."
    "周围有人，但不算多。你可以自在地走动，不必忍受别人闯入你的空间，也不会被心不在焉的人撞上。恰到好处——刚好够让你相信一切都会好起来。"

# game/rutas/nulla.rpy:2991
translate chino continuacion_nulla2_ce8e5992:

    # nulla "¿Te gusta?"
    nulla "你喜欢吗？"

# game/rutas/nulla.rpy:2994
translate chino continuacion_nulla2_11347201:

    # "Nulla se rie por debajo."
    "Nulla 轻声笑了。"

# game/rutas/nulla.rpy:2997
translate chino continuacion_nulla2_58a993af:

    # nulla "Awwww. No seas aguafiestas."
    nulla "哎呀。别这么扫兴。"

# game/rutas/nulla.rpy:2998
translate chino continuacion_nulla2_47dc59a4:

    # nulla "Puse toda mi energía en recordar cada uno de los detalles de esta feria."
    nulla "我倾尽所有精力，只为记起这场集市的每一个细节。"

# game/rutas/nulla.rpy:2999
translate chino continuacion_nulla2_7e75f35e:

    # nulla "Aunque si ves una vaca flotando o una persona sin cabeza, por favor ignóralas..."
    nulla "不过，要是你看到一只漂浮的牛，或者一个没有头的人，请务必忽略它们……"

# game/rutas/nulla.rpy:3001
translate chino continuacion_nulla2_e2207978:

    # "Tomas de la mano a Nulla mientras caminan por la feria. El primer lugar que visitan en un puesto de tiro al blanco."
    "你牵起 Nulla 的手，一同在集市间穿行。你们的第一站是射击摊。"

# game/rutas/nulla.rpy:3003
translate chino continuacion_nulla2_edeadebe:

    # "Nulla y tú inspeccionan los premios, son todos peluches de distintos tamaños y formas. Luego te pregunta cuál quieres y promete ganarlo para ti."
    "你和 Nulla 打量着那些奖品——全是各式各样的毛绒玩具。他问你想要哪一个，还许诺要替你赢下来。"

# game/rutas/nulla.rpy:3006
translate chino continuacion_nulla2_a20cefa7_4:

    # "..."
    "……"

# game/rutas/nulla.rpy:3007
translate chino continuacion_nulla2_cae0c63f:

    # "Ese ojo da miedo..."
    "那只眼睛好吓人……"

# game/rutas/nulla.rpy:3010
translate chino continuacion_nulla2_4a9cc0d2:

    # "Te recuerda a Nulla en cierto sentido."
    "某种程度上，它让你想起 Nulla。"

# game/rutas/nulla.rpy:3011
translate chino continuacion_nulla2_932e1eaf:

    # "Crees que son los ojos..."
    "大概是因为那双眼睛吧……"

# game/rutas/nulla.rpy:3014
translate chino continuacion_nulla2_3853d438:

    # "Se ve lindo."
    "它看起来很可爱。"

# game/rutas/nulla.rpy:3017
translate chino continuacion_nulla2_ef0c90b4:

    # "Te causa gracia y ternura los dientes tan grandes que tiene."
    "它那对大得夸张的牙齿让你忍俊不禁——竟有一种莫名的可爱。"

# game/rutas/nulla.rpy:3019
translate chino continuacion_nulla2_59439e74:

    # nulla "¡Okay!"
    nulla "好嘞！"

# game/rutas/nulla.rpy:3020
translate chino continuacion_nulla2_f5871b17:

    # "Exclama Nulla alzando la voz, con exageración y un toque cómico deliberado."
    "Nulla 抬高声音喊道，语气夸张，还带着几分刻意的滑稽。"

# game/rutas/nulla.rpy:3022
translate chino continuacion_nulla2_ba324f4a:

    # "Pide un turno al dueño del puesto, pero ignora por completo la pistola de juguete que este le ofrece. Nulla prefiere su 'para nada peligroso' revólver, el cual materializa con un simple gesto de sus manos."
    "他向摊主要了一局，却对递来的玩具枪完全不看。Nulla 更中意他那把「一点也不危险」的左轮手枪——只见他手腕随意一抖，枪便凭空出现了。"

# game/rutas/nulla.rpy:3023
translate chino continuacion_nulla2_54482ca3:

    # "Al dueño no le importa una mierda y media. Sigue en su papel, inmutable, como si nada fuera extraño. Y eso te recuerda que no estás en el mundo real."
    "摊主对此毫不在意。他依旧维持着自己的角色，面不改色，仿佛一切再正常不过。这也提醒了你：你并不在现实世界。"

# game/rutas/nulla.rpy:3024
translate chino continuacion_nulla2_bcf6dd4d:

    # "No."
    "不是。"

# game/rutas/nulla.rpy:3025
translate chino continuacion_nulla2_499a3583:

    # "Estás en un dominio construido con rastros de la memoria de una entidad que ha vivido tantas vidas que ya ni él debe recordar la cantidad."
    "你身处一个由某个存在的记忆残片构筑而成的领域——它已经活过太多生命，恐怕连它自己都记不清到底有多少次了。"

# game/rutas/nulla.rpy:3026
translate chino continuacion_nulla2_c615987b:

    # "Un lugar donde, básicamente, puede hacer lo que se le dé la gana."
    "在这里，基本上他想做什么都行。"

# game/rutas/nulla.rpy:3027
translate chino continuacion_nulla2_3abb2ee2:

    # "La destreza que tiene con el arma es de admirar, al mismo tiempo que de temer."
    "他持枪的技艺令人赞叹，又让人心惊。"

# game/rutas/nulla.rpy:3028
translate chino continuacion_nulla2_f761a6f6:

    # "No falla ningún objetivo, y para peor: se ve muy bien apuntando con el revolver."
    "他无一落空——更糟的是，他端着那把左轮瞄准的样子还真有魅力。"

# game/rutas/nulla.rpy:3029
translate chino continuacion_nulla2_3b6c0743:

    # "El dueño del puesto lo felicita, dándole el peluche que has elegido."
    "摊主向他祝贺，把你们挑中的那只毛绒玩具递了过来。"

# game/rutas/nulla.rpy:3031
translate chino continuacion_nulla2_61ac81e1:

    # nulla "¿Qué tal?"
    nulla "怎么样？"


# game/rutas/nulla.rpy:3034
translate chino continuacion_nulla2_30f18ddc:

    # "Nulla sonrie sin mostrar los dientes."
    "Nulla 微微笑了。"

# game/rutas/nulla.rpy:3035
translate chino continuacion_nulla2_0213887b:

    # "Es una sonrisa sincera, hasta tierna."
    "那是一个真诚的、近乎温柔的微笑。"

# game/rutas/nulla.rpy:3038
translate chino continuacion_nulla2_5c5cea64:

    # "Nulla rie."
    "Nulla 笑了。"

# game/rutas/nulla.rpy:3043
translate chino continuacion_nulla2_26f2b73c:

    # "Nulla te observa por un segundo antes de sonreir."
    "Nulla 看了你片刻，然后露出微笑。"

# game/rutas/nulla.rpy:3046
translate chino continuacion_nulla2_e4c92906:

    # nulla "No lo dudo."
    nulla "我不怀疑。"

# game/rutas/nulla.rpy:3047
translate chino continuacion_nulla2_5206f298:

    # "Lo dice con total sinceridad."
    "他说得无比真诚。"

# game/rutas/nulla.rpy:3050
translate chino continuacion_nulla2_32f931eb:

    # "Después de un rato caminando entre puestos de luces parpadeantes y música alegre, Nulla propone ir a la ruleta de la fortuna."
    "在闪烁的灯火与欢快的音乐间游荡了一阵之后，Nulla 提议去坐摩天轮。"

# game/rutas/nulla.rpy:3051
translate chino continuacion_nulla2_bac65775:

    # "No espera tu respuesta. Solo te toma de la mano y te guía entre la gente."
    "他没有等你回答。只是牵起你的手，带着你在人群中穿行。"

# game/rutas/nulla.rpy:3052
translate chino continuacion_nulla2_428af5bf:

    # "Se saltan la fila sin dudarlo. Nadie dice nada, ni parecen notarlo siquiera, pero tú no puedes evitar sentir culpa por ello."
    "你们毫不犹豫地插了队。没有人说一句话（甚至似乎没人注意到），可你仍难免有些心虚。"

# game/rutas/nulla.rpy:3053
translate chino continuacion_nulla2_ffdb5fb0:

    # "Volteas la cabeza un poco para mirar a las personas en la fila, pero sus rostros parecen borrosos, sin detalles."
    "你微微偏过头去看排队的人，可他们的面孔一片模糊，看不清任何细节。"

# game/rutas/nulla.rpy:3054
translate chino continuacion_nulla2_944fe1c8:

    # "Nulla es rápido en consolarte, sonriéndote como quien lo hace con un niño pequeño que hace una rabieta."
    "Nulla 很快便来安慰你，那笑容，就像大人对着一个闹小脾气的孩子。"

# game/rutas/nulla.rpy:3055
translate chino continuacion_nulla2_2691e29e:

    # nulla "Ninguno de ellos importa realmente."
    nulla "他们哪一个都无所谓。"

# game/rutas/nulla.rpy:3056
translate chino continuacion_nulla2_242e7e56:

    # "Suena cruel, pero es cierto en este contexto."
    "这话听起来残忍，但在这个情境下，他说得没错。"

# game/rutas/nulla.rpy:3057
translate chino continuacion_nulla2_382f7e5c:

    # "Aunque no se molesta en explicar lo obvio."
    "不过他并不打算解释这显而易见的事。"

# game/rutas/nulla.rpy:3059
translate chino continuacion_nulla2_0134f819:

    # "La cabina es solo para ustedes dos. El interior es espacioso. La luz que entra por las ventanas es suave, teñida de azul por la hora."
    "宽敞的轿厢只留给你们两人。透进窗的光线柔和，此刻被夜色染成了蓝色。"

# game/rutas/nulla.rpy:3060
translate chino continuacion_nulla2_f1880ace:

    # "Nulla entra primero, pero no se acomoda a tu lado de inmediato. Se sienta a una distancia prudente, procurando no invadir tu espacio."
    "Nulla 先一步走进去，却没有立刻坐到你身边。他在一段得体的距离处坐下，刻意不入侵你的空间。"

# game/rutas/nulla.rpy:3062
translate chino continuacion_nulla2_3d8e0f60:

    # "Ni muy lejos, ni muy cerca."
    "不太近，也不太远。"

# game/rutas/nulla.rpy:3063
translate chino continuacion_nulla2_5b7bdca5:

    # nulla "La única vez que me subí a una de estas fue muy aburrido."
    nulla "我第一次坐这种东西的时候，真是无聊透顶。"

# game/rutas/nulla.rpy:3068
translate chino continuacion_nulla2_c34ae295:

    # nulla "Sí..."
    nulla "嗯……"

# game/rutas/nulla.rpy:3069
translate chino continuacion_nulla2_02fffcbf:

    # nulla "Me obligaron."
    nulla "是别人逼我的。"

# game/rutas/nulla.rpy:3070
translate chino continuacion_nulla2_e40a5229:

    # "Su voz se apaga al final de la frase, no queriendo contar más."
    "他的声音在句末渐渐低了下去，不愿再多说。"

# game/rutas/nulla.rpy:3073
translate chino continuacion_nulla2_dc957953:

    # nulla "Sí... ahora entiendo por qué."
    nulla "是啊……我现在明白为什么了。"

# game/rutas/nulla.rpy:3074
translate chino continuacion_nulla2_b243481a:

    # nulla "Si la compañía es buena, la experiencia también."
    nulla "只要身边有对的人，体验自然也不会差。"

# game/rutas/nulla.rpy:3075
translate chino continuacion_nulla2_ffe998ac:

    # "Sus dedos se deslizan hacia los tuyos con naturalidad, rozando primero, tanteando, antes de entrelazarse."
    "他的手指自然地滑向你的，先轻轻擦过，试探着，随后交缠在一起。"

# game/rutas/nulla.rpy:3076
translate chino continuacion_nulla2_62006804:

    # "El contacto te calma al instante."
    "这一触，让你瞬间平静下来。"

# game/rutas/nulla.rpy:3079
translate chino continuacion_nulla2_d55276f3:

    # "El silencio se instala en la cabina."
    "沉默在轿厢中弥漫开来。"

# game/rutas/nulla.rpy:3080
translate chino continuacion_nulla2_941ba3b4:

    # "A Nulla no parece afectarle."
    "Nulla 似乎并不受影响。"

# game/rutas/nulla.rpy:3082
translate chino continuacion_nulla2_93bff7cd:

    # "Sus ojos se desvían hacia la ventana. Tú haces lo mismo."
    "他的目光飘向窗外，你也跟着望去。"

# game/rutas/nulla.rpy:3083
translate chino continuacion_nulla2_634a5227:

    # "La vista desde aquí arriba es preciosa. El sol ha terminado de esconderse y la noche comienza a caer."
    "从高处望去的景色美得惊人。太阳终于沉了下去，夜色开始降临。"

# game/rutas/nulla.rpy:3084
translate chino continuacion_nulla2_d848a589:

    # "Luces de la feria parpadean con intensidad decorando la feria con una gama de colores que se complementan, y la gente que camina como si siguiera un patrón predeterminado."
    "集市的灯火在下方闪烁，用彼此交融的色彩装点着这片场地；人群走动时，仿佛正遵循着某种预设好的模式。"

# game/rutas/nulla.rpy:3085
translate chino continuacion_nulla2_59e747bf:

    # "Desde esta altura, las personas parecen hormigas. Y por un momento, te preguntas si Nulla siempre ha visto así al resto del mundo."
    "从这样的高度看下去，人们小得如同蚂蚁。有那么一刻，你不禁想：Nulla 是否一直都在用这样的眼光看待世界？"

# game/rutas/nulla.rpy:3086
translate chino continuacion_nulla2_f790fb95:

    # "Cuando la cabina se detiene en el punto más alto, Nulla finalmente habla."
    "当轿厢停在最高点时，Nulla 终于开口了。"

# game/rutas/nulla.rpy:3087
translate chino continuacion_nulla2_c258d8ab:

    # nulla "Si la gente que ya no está con nosotros tuviera una segunda oportunidad de volver..."
    nulla "如果那些已经不在我们身边的人，能有第二次回来的机会……"

# game/rutas/nulla.rpy:3088
translate chino continuacion_nulla2_a5de566b:

    # nulla "¿Los traerías de vuelta?"
    nulla "你会让他们回来吗？"

# game/rutas/nulla.rpy:3091
translate chino continuacion_nulla2_a20cefa7_5:

    # "..."
    "……"

# game/rutas/nulla.rpy:3094
translate chino continuacion_nulla2_a20cefa7_6:

    # "..."
    "……"

# game/rutas/nulla.rpy:3097
translate chino continuacion_nulla2_a20cefa7_7:

    # "..."
    "……"

# game/rutas/nulla.rpy:3098
translate chino continuacion_nulla2_85863a8e:

    # "Nulla medita tu respuesta por un largo rato. Un tiempo que para ti se hace eterno."
    "Nulla 长久地沉吟着你的答案。对你而言，这段等待几乎无穷无尽。"

# game/rutas/nulla.rpy:3099
translate chino continuacion_nulla2_c611a16e:

    # nulla "La extraño mucho..."
    nulla "我好想她……"


# game/rutas/nulla.rpy:3100
translate chino continuacion_nulla2_624e04ae:

    # nulla "Haría lo que fuera con tenerla de vuelta conmigo."
    nulla "为了让她回到我身边，我什么都愿意做。"

# game/rutas/nulla.rpy:3101
translate chino continuacion_nulla2_409f8636_1:

    # nulla "..."
    nulla "……"

# game/rutas/nulla.rpy:3102
translate chino continuacion_nulla2_1237f11c:

    # nulla "Antes venía aquí para poder verla otra vez."
    nulla "以前我常来这里，只为能再见她一次。"

# game/rutas/nulla.rpy:3103
translate chino continuacion_nulla2_1156498c:

    # nulla "Pero luego de un tiempo su recuerdo se deforma."
    nulla "可过了一段时间，关于她的记忆就开始扭曲了。"

# game/rutas/nulla.rpy:3104
translate chino continuacion_nulla2_4f00c547:

    # nulla "Mientras más tiempo paso aquí, más se deforma todo."
    nulla "我在这里待得越久，一切都变得越发扭曲。"

# game/rutas/nulla.rpy:3105
translate chino continuacion_nulla2_1915eb75:

    # nulla "Y más difícil se vuelve canalizarla."
    nulla "也就越难引她现身。"

# game/rutas/nulla.rpy:3107
translate chino continuacion_nulla2_aa85f4ef:

    # "Una sustancia negra comienza a rodear a Nulla por un instante."
    "一瞬间，一种黑色的黏稠物质开始环绕在 Nulla 周身。"

# game/rutas/nulla.rpy:3109
translate chino continuacion_nulla2_fd5e62fb:

    # "Pero cuando enfocas tus ojos, desaparece. Deben ser sus pensamientos negativos haciendo de las suyas..."
    "可当你定睛看去，它又消失了。一定是他那些阴暗的念头又在作祟……"

# game/rutas/nulla.rpy:3111
translate chino continuacion_nulla2_84038624:

    # "El tiempo en la rueda de la fortuna llega a su fin cuando la cabina es suspendida en el suelo, y sus puertas se abren. Esperando a que salgan del lugar."
    "摩天轮之旅到此结束：轿厢被降到地面，门缓缓打开，等着你们走出去。"

# game/rutas/nulla.rpy:3116
translate chino continuacion_nulla2_a20cefa7_8:

    # "..."
    "……"

# game/rutas/nulla.rpy:3119
translate chino continuacion_nulla2_367144f8:

    # nulla "Bueno..."
    nulla "嗯……"

# game/rutas/nulla.rpy:3120
translate chino continuacion_nulla2_796bdebc:

    # nulla "Si eso es lo que quieres..."
    nulla "如果你想这样的话……"

# game/rutas/nulla.rpy:3123
translate chino continuacion_nulla2_707fc7b7:

    # nulla "Podemos ir a casa y descansar el resto del día."
    nulla "我们可以回家，安安稳稳地度过今天剩下的时间。"

# game/rutas/nulla.rpy:3127
translate chino continuacion_nulla2_c39f32a5:

    # nulla "Tú me alegras."
    nulla "你让我感到幸福。"

# game/rutas/nulla.rpy:3128
translate chino continuacion_nulla2_fd7499f6:

    # "Rebate él, mordiendo una risa que no logra salir."
    "他反驳道，一边强忍着笑意，却终究还是漏出了一丝。"

# game/rutas/nulla.rpy:3132
translate chino continuacion_nulla2_3eb2b3fe:

    # "Salir de las memorias de Nulla fue distinto a cualquier experiencia anterior."
    "离开 Nulla 的记忆，与以往的任何经历都截然不同。"

# game/rutas/nulla.rpy:3133
translate chino continuacion_nulla2_95484573:

    # "Si bien Nulla tomó tus manos, tu cuerpo no fue absorbido por el vacío. En cambio, fue expulsado con una fuerza desmedida, sin darte tiempo a reaccionar."
    "尽管 Nulla 握住了你的双手，这一次你的身体却没有被虚空吞噬。取而代之的是——你被一股蛮力猛地甩了出去，完全来不及反应。"

# game/rutas/nulla.rpy:3134
translate chino continuacion_nulla2_8af4e048:

    # "Y de un segundo a otro, ya no están dentro."
    "眨眼之间，你们已经不在里面了。"

# game/rutas/nulla.rpy:3136
translate chino continuacion_nulla2_9b41c3c0:

    # "Ahora se encuentran en el mismo lugar, en la misma posición en que estaban antes de adentrarse en sus memorias."
    "你们回到了原处，就是踏入他记忆之前的那个位置。"

# game/rutas/nulla.rpy:3137
translate chino continuacion_nulla2_fb371438:

    # "Miras a tu alrededor en busca de señales del paso del tiempo, pero nada en la casa de Nulla te lo confirma con certeza."
    "你环顾四周，寻找时间流逝的迹象，可 Nulla 的房子里没有任何东西能确证这一点。"

# game/rutas/nulla.rpy:3138
translate chino continuacion_nulla2_a29e77cc:

    # "No hay relojes ni objetos que permitan medir el tiempo. Afuera, solo hay una negrura que envuelve toda la casa, y no tienes manera de contactar con nada ni con nadie fuera del dominio del Vacío."
    "没有时钟，也没有能测量时间的东西。屋外只有一片漆黑，将整栋房子包裹其中——把你与虚空领域之外的一切都彻底隔绝。"

# game/rutas/nulla.rpy:3139
translate chino continuacion_nulla2_018aebbc:

    # "La tetera aún soltando vapor, las frutas recién rebanadas en el plato que no se han secado, y el cuchillo a un lado... ese es el único conjunto de pistas que te sugiere que no ha pasado demasiado tiempo desde que comenzó la cita."
    "茶壶还冒着热气，盘里刚切好的水果没有干瘪，旁边的小刀也原封不动……这些是唯一能让你觉得：从约会开始到现在，其实并没有过去太久。"

# game/rutas/nulla.rpy:3140
translate chino continuacion_nulla2_10e7c03a:

    # "Te preguntas cómo Nulla medirá el tiempo..."
    "你不禁想，Nulla 到底是如何丈量时间的……"

# game/rutas/nulla.rpy:3142
translate chino continuacion_nulla2_4793c596:

    # nulla "...Lo siento por el peluche."
    nulla "……那只毛绒玩具，我很抱歉。"

# game/rutas/nulla.rpy:3143
translate chino continuacion_nulla2_6c4c9623:

    # "Dice Nulla, llamando tu atención."
    "Nulla 说道，把你的注意力拉了回来。"

# game/rutas/nulla.rpy:3144
translate chino continuacion_nulla2_e686439b:

    # "¿El peluche?... miras a tus manos y te das cuenta de lo que se refiere."
    "毛绒玩具？……你低头看向自己的双手，这才意识到他指的是什么。"

# game/rutas/nulla.rpy:3145
translate chino continuacion_nulla2_8e3ca084:

    # "Ya no lo tienes contigo."
    "它已经不在你身边了。"

# game/rutas/nulla.rpy:3146
translate chino continuacion_nulla2_bbc27640:

    # "Todo rastro de él ya no existe. No tienes nada tangible que te confirme que alguna vez ganaron un peluche en una feria."
    "它留下的一切痕迹都不复存在。你没有任何实物可以证明，你们曾在那场集市里一起赢到过一只毛绒玩具。"

# game/rutas/nulla.rpy:3147
translate chino continuacion_nulla2_ef7b937f:

    # nulla "Todo lo que pasa dentro de las memorias, no significa nada fuera de estas."
    nulla "发生在记忆之中的一切，在记忆之外毫无意义。"

# game/rutas/nulla.rpy:3148
translate chino continuacion_nulla2_43f78233:

    # nulla "Nada de lo que se origina dentro de ahí puede salir."
    nulla "在那里诞生的任何东西，都无法跨越过来。"

# game/rutas/nulla.rpy:3151
translate chino continuacion_nulla2_5534dfed:

    # nulla "Si no fuera así, seria todo más fácil, jaja."
    nulla "如果不是这样，一切都会容易得多，哈哈。"

# game/rutas/nulla.rpy:3152
translate chino continuacion_nulla2_6dd1712c:

    # "Su risa ligera no alcanza su expresión por completo. Si bien su boca está curvada en una sonrisa, sus ojos no transmiten alegría o gracia alguna."
    "他轻浅的笑声并没有完全抵达他的神情。虽然嘴角弯成一道笑容，他的双眼却没有丝毫喜悦或幽默。"

# game/rutas/nulla.rpy:3153
translate chino continuacion_nulla2_9093ab2f:

    # nulla "Sacar cosas... o personas desde ahí. Estaría genial, ¿no?"
    nulla "从那里把东西……或者人……带出来。那该多好啊，对吧？"

# game/rutas/nulla.rpy:3156
translate chino continuacion_nulla2_ee4421c7:

    # nulla "Recuperar un objeto que solo está en tu memoria..."
    nulla "把只存在于你记忆中的某个东西找回来……"

# game/rutas/nulla.rpy:3161
translate chino continuacion_nulla2_409f8636_2:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:3162
translate chino continuacion_nulla2_8a9a3802:

    # nulla "Tienes razón."
    nulla "你说得对。"

# game/rutas/nulla.rpy:3165
translate chino continuacion_nulla2_b0d57771:

    # nulla "Aunque igual me conformaría."
    nulla "不过，那样我也会满足的。"

# game/rutas/nulla.rpy:3166
translate chino continuacion_nulla2_4a132a48:

    # nulla "¿Tú no?"
    nulla "你呢？"

# game/rutas/nulla.rpy:3171
translate chino continuacion_nulla2_19bb13d7:

    # nulla "Awww."
    nulla "哎呀。"

# game/rutas/nulla.rpy:3172
translate chino continuacion_nulla2_784f2a3b:

    # nulla "Entonces, si yo me llego a perder en algún momento, ¿No te conformarías con ninguna fea copia que no sea yo?"
    nulla "那么，如果有一天我迷失了……你不会满足于某个丑陋的、并不真正是我的复制品吧？"

# game/rutas/nulla.rpy:3175
translate chino continuacion_nulla2_905834c7:

    # nulla "Me siento halagado~~~"
    nulla "我听了可真受用~~~"

# game/rutas/nulla.rpy:3180
translate chino continuacion_nulla2_b5478886:

    # nulla "Somos tal para cual~~~"
    nulla "我们真是天生一对~~~"

# game/rutas/nulla.rpy:3181
translate chino continuacion_nulla2_9c420cce:

    # nulla "Almas gemelas, mi vida."
    nulla "灵魂伴侣，我亲爱的。"

# game/rutas/nulla.rpy:3186
translate chino continuacion_nulla2_75293d0e:

    # nulla "Así es."
    nulla "正是如此。"

# game/rutas/nulla.rpy:3187
translate chino continuacion_nulla2_aab904c7:

    # nulla "Imagina todo lo que podrías traer de vuelta a la vida."
    nulla "想象一下，你能让多少东西重获新生。"

# game/rutas/nulla.rpy:3188
translate chino continuacion_nulla2_64051149:

    # nulla "Sería genial."
    nulla "那会很棒。"

# game/rutas/nulla.rpy:3191
translate chino continuacion_nulla2_32492388:

    # nulla "Bueno... de cualquier modo. No es bueno quedarse congelado en los recuerdos sin prestar atención al presente--"
    nulla "嗯……不管怎样。一直冻结在回忆里、忽略当下并不是好事——"

# game/rutas/nulla.rpy:3192
translate chino continuacion_nulla2_4dfde67b:

    # nulla "Y al futuro."
    nulla "——还有未来。"

# game/rutas/nulla.rpy:3193
translate chino continuacion_nulla2_409f8636_3:

    # nulla "..."
    nulla "..."

# game/rutas/nulla.rpy:3196
translate chino continuacion_nulla2_e24ecc7e:

    # nulla "Mañana tendremos que volver al plan."
    nulla "明天我们得回到计划上来。"

# game/rutas/nulla.rpy:3197
translate chino continuacion_nulla2_6234bf0a:

    # "Nulla se aparta un poco, como si te recordara que aquí puedes moverte libremente, sin restricciones."
    "Nulla 略微退开，像是提醒你：在这里，你可以随心所欲地活动，不受任何约束。"

# game/rutas/nulla.rpy:3198
translate chino continuacion_nulla2_9c9171ac:

    # "Pero antes de que puedas hacer algo más, notas cómo mete la mano en su bolsillo y saca la carta que una de sus sombras le entregó el día anterior..."
    "但你还没来得及反应，便注意到他把手伸进口袋，取出了前一天他的一个影子交给他的那封信……"


# game/rutas/nulla.rpy:3199
translate chino continuacion_nulla2_5c79ff3b:

    # "Está abierta... lo que significa que ya la ha leído. O al menos la ha hojeado una vez."
    "信封已经拆开了……也就是说，他已经读过——或者至少草草翻过一次。"

# game/rutas/nulla.rpy:3202
translate chino continuacion_nulla2_6c6d3419:

    # nulla "No quise leerla contigo."
    nulla "我不想当着你的面读它。"

# game/rutas/nulla.rpy:3203
translate chino continuacion_nulla2_a1bce748:

    # nulla "Habría sido como hablar de trabajo en medio de una cita."
    nulla "那样就像在约会中谈论工作。"

# game/rutas/nulla.rpy:3204
translate chino continuacion_nulla2_c9108774:

    # nulla "Sería como un insulto para ti."
    nulla "那对你是一种不尊重。"

# game/rutas/nulla.rpy:3205
translate chino continuacion_nulla2_35d0d654:

    # nulla "Así que quise esperar."
    nulla "所以我想等一等。"

# game/rutas/nulla.rpy:3208
translate chino continuacion_nulla2_a156c00c:

    # nulla "Pero ahora... creo que es un buen momento."
    nulla "但现在……我想时机正好。"

# game/rutas/nulla.rpy:3211
translate chino continuacion_nulla2_fc8ae533:

    # "Saca la carta del sobre con calma y se acerca, ofreciéndotela para que puedas ver lo que está escrito."
    "他从容地把信从信封里抽出来，走近一步，把信递给你，好让你看清上面写了什么。"

# game/rutas/nulla.rpy:3212
translate chino continuacion_nulla2_f495553d:

    # "Es un mensaje corto, escrito en una lengua que no logras entender. No hay necesidad de preguntar para que Nulla te la lea, pues él te ofrece una explicación al instante."
    "那是一封短信，用一种你无法理解的文字写成。你不必开口求 Nulla 翻译：他立刻就开口解释起来。"

# game/rutas/nulla.rpy:3213
translate chino continuacion_nulla2_4ed53164:

    # nulla "Es de Sextam."
    nulla "是 Sextam 寄来的。"

# game/rutas/nulla.rpy:3216
translate chino continuacion_nulla2_082605dc:

    # nulla "Dice que vendrá mañana a almorzar."
    nulla "信上说她明天会来吃午饭。"

# game/rutas/nulla.rpy:3217
translate chino continuacion_nulla2_15802fab:

    # nulla "Y que trae el postre."
    nulla "还说她会带甜点来。"

# game/rutas/nulla.rpy:3220
translate chino continuacion_nulla2_3655a17a:

    # "Tienes un poco de miedo de preguntar por el postre... ¿Será un postre real o otra cosa que no puedes todavía asimilar?"
    "你有点害怕问起那份甜点……那会是一份真正的甜点，还是某种你尚无法理解的东西？"

# game/rutas/nulla.rpy:3221
translate chino continuacion_nulla2_932e7463:

    # "Necesitas un descanso."
    "你需要休息一下。"

# game/rutas/nulla.rpy:3222
translate chino continuacion_nulla2_2001fe0d:

    # "Necesitas otro día antes de continuar apoyando a Nulla con su genocidio justificado."
    "在继续帮 Nulla 进行他那所谓“正当”的灭绝之前，你需要再休息一天。"

# game/rutas/nulla.rpy:3223
translate chino continuacion_nulla2_b76ced04:

    # "Nulla dobla la carta con cuidado y la hace desaparecer con un chasquido de sus dedos."
    "Nulla 小心地折好信，只需一个响指，信便消失不见了。"

# game/rutas/nulla.rpy:3224
translate chino continuacion_nulla2_6167b398:

    # nulla "No te preocupes. Creo que ya sé por dónde va esto."
    nulla "别担心。我想我已经猜到这是怎么回事了。"

# game/rutas/nulla.rpy:3225
translate chino continuacion_nulla2_954919fb:

    # "Su tono de voz se escucha... extraño. Lo dice con una calma que te pone los pelos de punta. Con seguridad y hasta un toque de euforia controlada."
    "他的语气听起来……有些奇怪。他说这话时异常平静，平静得让你毛骨悚然，又透着笃定，甚至还带着一丝克制的狂喜。"

# game/rutas/nulla.rpy:3227
translate chino continuacion_nulla2_9ceab4ea:

    # "En proceso de elaboración..."
    "正在酝酿中……"

# game/rutas/nulla.rpy:3228
translate chino continuacion_nulla2_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2} 你还得再等一会儿，才能知道结局如何…… :3{/sc}"


translate chino strings:

    # game/rutas/nulla.rpy:311
    old "Explícame más"
    new "再多说一点。"

    # game/rutas/nulla.rpy:408
    old "Está bien, acepto"
    new "好吧，我接受。"

    # game/rutas/nulla.rpy:1952
