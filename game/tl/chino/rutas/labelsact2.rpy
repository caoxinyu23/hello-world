# game/rutas/labelsact2.rpy:531

translate chino s_preguntas_act3_c918a73f:

    # septem "Puedo hacerle un corazón que funcione... pero necesito arreglar el Jardín antes de hacerlo despertar."
    septem "我可以为他造一颗能跳动的心脏……但在唤醒他之前，我得先修好花园。"

# game/rutas/labelsact2.rpy:532
translate chino s_preguntas_act3_d6b5d5d7:

    # septem "No quiero traerlo de vuelta a un mundo que no está listo aún."
    septem "我不想把他带回一个尚未准备好的世界。"

# game/rutas/labelsact2.rpy:537
translate chino s_preguntas_act3_e1de277f:

    # septem "Sí..."
    septem "是的……"

# game/rutas/labelsact2.rpy:538
translate chino s_preguntas_act3_3c09c18a:

    # septem "Yo también."
    septem "我也是。"

# game/rutas/labelsact2.rpy:542
translate chino s_preguntas_act3_31924e0f:

    # septem "..."
    septem "……"

# game/rutas/labelsact2.rpy:545
translate chino s_preguntas_act3_63542b8f:

    # septem "No lo creo."
    septem "我不这么认为。"

# game/rutas/labelsact2.rpy:548
translate chino s_preguntas_act3_efc155c6:

    # "Baja la mirada, incapaz de darte la cara."
    "他垂下视线，无法直视你。"

# game/rutas/labelsact2.rpy:549
translate chino s_preguntas_act3_9c7b9714:

    # septem "Los humanos deben ir con los humanos..."
    septem "人类就该和人类在一起……"

# game/rutas/labelsact2.rpy:550
translate chino s_preguntas_act3_e9094642:

    # septem "Él perderá todos sus rangos una vez que se desligue completamente de mí."
    septem "一旦他彻底斩断与我的牵连，就会失去所有的位阶。"

# game/rutas/labelsact2.rpy:551
translate chino s_preguntas_act3_93499e05:

    # septem "Vivirá como ellos, y morirá como ellos..."
    septem "他会像他们一样活着，也会像他们一样死去……"

# game/rutas/labelsact2.rpy:553
translate chino s_preguntas_act3_07bdde05:

    # "....."
    "……"

# game/rutas/labelsact2.rpy:559
translate chino s_preguntas_act3_a1767bc3:

    # "Le preguntas por cómo se encuentra. Y cuando él te mira con cara de no entender tu pregunta del todo te explicas diciendo que quieres saber como se siente emocionalmente."
    "你问他最近怎么样。当他用一脸不太理解的表情看着你时，你便解释自己想知道的是他情感上的感受。"

# game/rutas/labelsact2.rpy:560
translate chino s_preguntas_act3_cba3260c:

    # "Que quieres saber si hay algo que le preocupa o algo que quiera compartir contigo para sentirse más liberado. Evitas decir que lo has sentido en tus sueños, para no ponerlo de malas o hacerlo sentir pequeño y expuesto."
    "你想知道他是否有什么烦心事，或是有什么想与你分享、好让他心里松快些的事。你避开了自己在梦里感知到他这件事，免得惹他不痛快，或是让他觉得自己渺小而暴露无遗。"

# game/rutas/labelsact2.rpy:561
translate chino s_preguntas_act3_b97ed780:

    # "Septem frunce el ceño como primera respuesta, sin saber cómo tomarse tu curiosidad, y bebe un poco de su copa antes de responder."
    "Septem 的第一反应是皱起眉头，不知该如何看待你的好奇心，于是先抿了一口杯中的酒，才开口回答。"

# game/rutas/labelsact2.rpy:562
translate chino s_preguntas_act3_75cd6f78:

    # "Al terminar de dar su trago, se aclara la garganta."
    "咽下那口酒后，他清了清嗓子。"

# game/rutas/labelsact2.rpy:565
translate chino s_preguntas_act3_b2675d58:

    # septem "Estoy bien."
    septem "我很好。"

# game/rutas/labelsact2.rpy:568
translate chino s_preguntas_act3_0dbe6153:

    # "Es lo único que te ofrece. Tú sabes que hay más que solo esa respuesta vaga y ensayada, pero no sabes cómo hacerlo escupir todo lo que le persigue en su cabeza."
    "这就是他给你的唯一回答。你知道，绝不止这句含糊而敷衍的套话，可你却不知道该怎么让他把那些萦绕在脑海中的事全吐出来。"

# game/rutas/labelsact2.rpy:569
translate chino s_preguntas_act3_1b179571:

    # "Así que aplicas el silencio, esperando que aquello haga que Septem quiera rellenarlo con más palabras."
    "于是你选择了沉默，指望这能逼 Septem 用更多的话语来填补它。"

# game/rutas/labelsact2.rpy:570
translate chino s_preguntas_act3_a20cefa7:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:571
translate chino s_preguntas_act3_2b1b0c41:

    # "....?"
    "……？"

# game/rutas/labelsact2.rpy:572
translate chino s_preguntas_act3_2cb775c4:

    # "No funciona. Septem no tiene el más mínimo sentido de la incomodidad o presión social en rellenar el silencio incómodo con palabras."
    "没用。Septem 对用话语填补尴尬沉默时那种不自在或社交压力，完全没有半点概念。"

# game/rutas/labelsact2.rpy:573
translate chino s_preguntas_act3_bc7611fb:

    # "Hasta tiene el descaro de sonreír levemente, a sabiendas de que no obtendrás lo que buscas."
    "他甚至还有脸轻轻一笑，明知道你不会得到你想要的。"

# game/rutas/labelsact2.rpy:576
translate chino s_preguntas_act3_98b08b34:

    # "Septem sigue bebiendo de su copa sin darle importancia al silencio que lo acompaña."
    "Septem 继续喝着杯中的酒，对身旁的沉默毫不在意。"

# game/rutas/labelsact2.rpy:577
translate chino s_preguntas_act3_6c9a5586:

    # "Es mejor así, te consuelas mentalmente."
    "这样反而更好，你在心里安慰自己。"

# game/rutas/labelsact2.rpy:580
translate chino s_preguntas_act3_1c40fee6:

    # "Sabes que es riesgoso, pero él jamás te ha dicho que no sigas preguntando. ¡Además se está burlando de ti con esa sonrisa que tiene pegada a los labios!"
    "你知道这很冒险，可他从未让你别再问。更何况，他嘴角挂着的那抹笑分明是在嘲笑你！"

# game/rutas/labelsact2.rpy:581
translate chino s_preguntas_act3_7b8c5ddc:

    # "Se está haciendo él de rogar, no tienes suficientes pruebas, más que esa maldita sonrisa, pero tampoco dudas."
    "他这是在故意吊胃口。除了那该死的笑，你并没有足够的证据，可你也毫不怀疑。"

# game/rutas/labelsact2.rpy:582
translate chino s_preguntas_act3_7b2a7b70:

    # "Así qué lo cuestionas, formulando preguntas para hacerlo hablar más."
    "于是你追问他，抛出一个又一个问题，想让他多说些。"

# game/rutas/labelsact2.rpy:585
translate chino s_preguntas_act3_dc1173b9:

    # septem "¿Realmente te intesesa saber?"
    septem "你真想知道吗？"

# game/rutas/labelsact2.rpy:588
translate chino s_preguntas_act3_ebf17076:

    # "Tú respondes que sí, que si no te interesará ni siquiera le preguntarías nuevamente. Eso gana una expresión de sorpresa por parte de Septem."
    "你答是——若不是真的在意，你根本不会一问再问。这句话换来 Septem 一个惊讶的表情。"

# game/rutas/labelsact2.rpy:591
translate chino s_preguntas_act3_6a403d42:

    # septem "Tengo algunas dudas de lo que está por venir..."
    septem "对于即将到来的事，我有些疑虑……"

# game/rutas/labelsact2.rpy:592
translate chino s_preguntas_act3_9b3fb368:

    # septem "Los cambios no me gustan... romper las reglas tampoco..."
    septem "我不喜欢改变……破坏规则也一样……"

# game/rutas/labelsact2.rpy:593
translate chino s_preguntas_act3_092082ba:

    # septem "Hoy haremos todo lo que me disgusta."
    septem "今天，我们要做尽所有令我不悦的事。"

# game/rutas/labelsact2.rpy:594
translate chino s_preguntas_act3_a074c99c:

    # septem "Pero hay que hacerlo."
    septem "但非做不可。"

# game/rutas/labelsact2.rpy:595
translate chino s_preguntas_act3_a20cefa7_1:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:600
translate chino s_preguntas_act3_691e9d98:

    # septem "¿Qué quieres saber?"
    septem "你想知道什么？"

# game/rutas/labelsact2.rpy:605
translate chino s_preguntas_act3_7e3160ee:

    # septem "Es la única parte que no se puede cambiar."
    septem "那是唯一无法改变的部分。"

# game/rutas/labelsact2.rpy:606
translate chino s_preguntas_act3_a4d59210:

    # septem "Toda la energía que compartes conmigo se acumula ahí."
    septem "你与我共享的全部能量，都汇聚在那里。"

# game/rutas/labelsact2.rpy:609
translate chino s_preguntas_act3_31924e0f_1:

    # septem "..."
    septem "……"

# game/rutas/labelsact2.rpy:610
translate chino s_preguntas_act3_a0bc95a4:

    # "Septem siente la duda invadir tus pensamientos."
    "Septem 察觉到了怀疑正侵入你的思绪。"

# game/rutas/labelsact2.rpy:613
translate chino s_preguntas_act3_5ba39205:

    # septem "Puedo ver evitar que la energía no se manifieste así... cambiarlo."
    septem "我可以阻止这能量以这种方式显现……改变它。"

# game/rutas/labelsact2.rpy:614
translate chino s_preguntas_act3_0679a286:

    # septem "No hay problema en eso, pero---"
    septem "这没问题，但是——"

# game/rutas/labelsact2.rpy:617
translate chino s_preguntas_act3_51a21212:

    # septem "Con estas manos que tienes es más fácil identificarte como mío."
    septem "凭着你拥有的这双手，更容易把你认作我的人。"

# game/rutas/labelsact2.rpy:620
translate chino s_preguntas_act3_dc6f96e6:

    # septem "No habrá humano o Dios que dude de nuestra unión."
    septem "不会有任何人类或神明，会怀疑我们的结合。"

# game/rutas/labelsact2.rpy:625
translate chino s_preguntas_act3_cff623c0:

    # septem "Eres inmortal hasta que yo deje de permitirlo."
    septem "在我收回许可之前，你都是不死的。"

# game/rutas/labelsact2.rpy:628
translate chino s_preguntas_act3_3a44b081:

    # "Septem sonríe con ternura, ignorando lo brutal de sus propias palabras."
    "Septem 温柔地微笑着，浑然不觉自己话中的残忍。"

# game/rutas/labelsact2.rpy:629
translate chino s_preguntas_act3_12bace56:

    # "Pasan los segundos, y nada. Septem no se retracta o termina su comentario con algún chiste liviano..."
    "几秒钟过去了，毫无动静。Septem 既没有收回前言，也没有用某个轻松的玩笑来补上一句……"

# game/rutas/labelsact2.rpy:632
translate chino s_preguntas_act3_ec0e18a2:

    # septem "No te preocupes, [nombrejugador], no pienso hacer eso."
    septem "别担心，[nombrejugador]，我没有那个打算。"

# game/rutas/labelsact2.rpy:635
translate chino s_preguntas_act3_3583cf90:

    # septem "Eres vital para mí. Jamás dejaría que tu cuerpo vasija muera."
    septem "你对我至关重要。我绝不会让你的容器之躯死去。"

# game/rutas/labelsact2.rpy:636
translate chino s_preguntas_act3_1c15829e:

    # septem "Aunque---"
    septem "不过——"

# game/rutas/labelsact2.rpy:637
translate chino s_preguntas_act3_6c0f8ee9:

    # septem "Si llega el momento en que te hartes de este cuerpo, podría fabricar otro con el que te sientas más cómodo."
    septem "倘若哪天你厌倦了这副躯体，我可以再造一副，让你觉得更舒适。"

# game/rutas/labelsact2.rpy:642
translate chino s_preguntas_act3_3e1cab2a:

    # septem "Mhhm---"
    septem "嗯——"

# game/rutas/labelsact2.rpy:643
translate chino s_preguntas_act3_624c9b73:

    # "Septem suelta una risa que no logra escapar de sus labios, los cuales mantiene sellados."
    "Septem 发出一声轻笑，却始终没能逃出他紧抿的双唇。"

# game/rutas/labelsact2.rpy:646
translate chino s_preguntas_act3_3eb74883:

    # septem "Te recomiendo seguir la dieta y las rutinas de un cuerpo mortal..."
    septem "我劝你还是遵循凡人之躯的饮食与作息……"

# game/rutas/labelsact2.rpy:647
translate chino s_preguntas_act3_84ad2c4c:

    # septem "Eres inmortal, pero sigues atado a lo mundano de la vida humana."
    septem "你虽已不死，却依然被绑缚在凡人生活的琐碎之中。"

# game/rutas/labelsact2.rpy:650
translate chino s_preguntas_act3_c8e322b1:

    # septem "Sentirás hambre y sueño. Sufrirás si no sacias tu sed."
    septem "你会感到饥饿与困倦；若不解渴，便会受苦。"

# game/rutas/labelsact2.rpy:651
translate chino s_preguntas_act3_45784221:

    # septem "Pero no podrás morir de ello."
    septem "但你绝不会因此而死。"

# game/rutas/labelsact2.rpy:652
translate chino s_preguntas_act3_ffec716e:

    # "Su sonrisa es inquietante. Algo en sus ojos brilla con una chispa que solo puedes llamarla placer."
    "他的笑容令人不安。他眼底有什么东西在闪光，那抹光芒你只能称之为愉悦。"

# game/rutas/labelsact2.rpy:653
translate chino s_preguntas_act3_acfe4ace:

    # "Septem disfruta de esto."
    "Septem 正乐在其中。"

# game/rutas/labelsact2.rpy:654
translate chino s_preguntas_act3_5f9b772e:

    # "...."
    "……"

# game/rutas/labelsact2.rpy:670
translate chino act3_explorar_septem_35e2380c:

    # "Sales directo al jardín por un poco de aire fresco."
    "你径直走向花园，想呼吸点新鲜空气。"

# game/rutas/labelsact2.rpy:671
translate chino act3_explorar_septem_236d02d6:

    # "Temes que las telas de tu túnica se ensucien por lo que te quedas cerca de la entrada del templo, donde no hay tierra o pasto."
    "你担心长袍的布料被弄脏，便留在了神庙入口附近——那里没有泥土，也没有草地。"

# game/rutas/labelsact2.rpy:672
translate chino act3_explorar_septem_bfaa1b70:

    # "El solo pensar que te puedes tropezar en la tierra o manchar las telas que cuelgan de tu cuerpo te genera estrés. No te gustaría presentarte ante todo el Jardín con tu ropa manchada o rota."
    "光是想到自己可能在泥地上绊倒，或是弄脏了垂落在身上的布料，就让你焦虑不已。你不愿在整座花园面前，穿着污渍斑斑或破损的衣服登场。"

# game/rutas/labelsact2.rpy:673
translate chino act3_explorar_septem_805828bb:

    # "Las primeras impresiones importan, más cuando eres una figura importante."
    "第一印象很重要，何况你是一位重要人物。"

# game/rutas/labelsact2.rpy:674
translate chino act3_explorar_septem_6c2bd8a8:

    # "Aunque, si bien Septem podría darte otro conjunto, quieres demostrarle que tú puedes ser elegante y cuidadoso también."
    "虽然 Septem 可以再给你一套新衣，你却想向他证明，自己也能做到优雅而细心。"

# game/rutas/labelsact2.rpy:675
translate chino act3_explorar_septem_8494b197:

    # "Manchar estas ropas sería como fallar en ello."
    "弄脏这些衣服，就等于在那件事上失败了。"

# game/rutas/labelsact2.rpy:676
translate chino act3_explorar_septem_a20cefa7:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:678
translate chino act3_explorar_septem_187b71ed:

    # "Respiras hondo, cerrando los ojos y canalizando tranquilidad. La obtienes con el sonido de la brisa del lugar, junto con el correr del agua."
    "你深吸一口气，闭上双眼，试图寻得片刻安宁。你从拂过此地的风声，以及潺潺水声中，找到了它。"

# game/rutas/labelsact2.rpy:680
translate chino act3_explorar_septem_6287bc31:

    # "Al abrir los ojos, tu mirada cae en las columnas de piedra que están más allá de la cerca de árboles."
    "睁开眼时，你的视线落在了树篱之外的石柱上。"

# game/rutas/labelsact2.rpy:681
translate chino act3_explorar_septem_589df666:

    # "Quieres ir allí y descubrir que es lo que esconde... recuerdas que Septem no quiso ir a ese lugar cuando lo señalaste."
    "你想去那里，看看它究竟藏着什么……可你记得，当初你指向那里时，Septem 并不想过去。"

# game/rutas/labelsact2.rpy:682
translate chino act3_explorar_septem_602e2dd6:

    # "Hum, luego de la ceremonia le preguntarás si te acompaña allá."
    "嗯，等仪式结束后，你问问他愿不愿陪你去那里。"

# game/rutas/labelsact2.rpy:683
translate chino act3_explorar_septem_5f9b772e:

    # "...."
    "……"

# game/rutas/labelsact2.rpy:691
translate chino act3_explorar_septem_7cb4654c:

    # "Caminas por los pasillos del templo. Al ser una distancia larga entre cada pasillo, tiendes a tropezar con las telas de tu túnica que se enredan en tus pies."
    "你穿行在神庙的回廊之间。回廊之间距离又远，你总是被那绊脚的长袍布料缠住脚，动不动就踉跄。"

# game/rutas/labelsact2.rpy:692
translate chino act3_explorar_septem_1fb851a5:

    # "Es algo que no puedes evitar. No estás acostumbrado a caminar largas distancias con ropaje que toca y se desliza por el suelo con cada paso que das."
    "这是你无法避免的事。你并不习惯穿着那种每走一步都会拂地、拖曳而行的长袍，走上很长的路。"

# game/rutas/labelsact2.rpy:693
translate chino act3_explorar_septem_ed53687d:

    # "Tu caminata es poco productiva, los pasillos no tienen nada nuevo que agregar. Nada nuevo que mirar o conocer."
    "这趟散步毫无收获，回廊里没有任何新东西可看，也没有任何新发现。"

# game/rutas/labelsact2.rpy:697
translate chino act3_explorar_septem_5d01a471:

    # "Estás por desistir tu exploración en los pasillos cuando sientes que algo te llama. No es una voz como tal..."
    "你正打算放弃对回廊的探索，却忽然感觉到有什么在呼唤你。那并不完全是声音……"

# game/rutas/labelsact2.rpy:698
translate chino act3_explorar_septem_f0d33376:

    # "Es una sensación que llama a todo tu cuerpo a ponerse alerta y a prestar atención a lo que te rodea. Como si te tiraran de la manga de tu túnica, pidiendo que pares y escuches."
    "那是一种催促你全身进入警备、留意周遭的感觉。仿佛有人在拽你长袍的袖子，要你停下脚步，侧耳倾听。"

# game/rutas/labelsact2.rpy:699
translate chino act3_explorar_septem_a20cefa7_1:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:702
translate chino act3_explorar_septem_64d64646:

    # centered "{glitch=30.0}{color=ffffff}{b}[nombrejugador]...{b}{/color}"
    centered "{glitch=30.0}{color=ffffff}{b}[nombrejugador]……{b}{/color}"

# game/rutas/labelsact2.rpy:703
translate chino act3_explorar_septem_b1114440:

    # "¿¡!?"
    "啊？！"

# game/rutas/labelsact2.rpy:706
translate chino act3_explorar_septem_1436e2f0:

    # "Tu nombre ha sido llamado por una voz que reconoces muy bien..."
    "一个你再熟悉不过的声音，唤住了你的名字……"

# game/rutas/labelsact2.rpy:707
translate chino act3_explorar_septem_a20cefa7_2:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:710
translate chino act3_explorar_septem_64d64646_1:

    # centered "{glitch=30.0}{color=ffffff}{b}[nombrejugador]...{b}{/color}"
    centered "{glitch=30.0}{color=ffffff}{b}[nombrejugador]……{b}{/color}"

# game/rutas/labelsact2.rpy:713
translate chino act3_explorar_septem_49978d0c:

    # "Esperas por un largo tiempo para que te diga otra cosa, pero eso no sucede, e incluso, su voz se siente más lejana."
    "你等了很久，等它再说点什么，可始终没有。事实上，那声音似乎离得更远了。"

# game/rutas/labelsact2.rpy:714
translate chino act3_explorar_septem_7c69a248:

    # "No quieres perder esa voz, no quieres dejar que él se vaya. Después de todo, tú mismo has dicho que lo necesitabas."
    "你不想失去那个声音，不想放他走。毕竟，是你自己说过你需要他。"

# game/rutas/labelsact2.rpy:715
translate chino act3_explorar_septem_fc1e3505:

    # "Nulla..."
    "Nulla……"

# game/rutas/labelsact2.rpy:718
translate chino act3_explorar_septem_8433967e:

    # "Sí..."
    "是的……"

# game/rutas/labelsact2.rpy:720
translate chino act3_explorar_septem_1d6a6ebe:

    # "Necesitas a tu marioneta... y probablemente él sepa que le ha pasado. Te rehusar a creer que ha muerto. Debe estar por ahí, junto con el dueño del vacío."
    "你需要你的傀儡……而它大概也知道它遭遇了什么。你拒绝相信它已经死了。它一定就在某个地方，与虚空的主人一同。"

# game/rutas/labelsact2.rpy:722
translate chino act3_explorar_septem_366aad6e:

    # "Serás algo lento, pero tonto no eres. Nulla te está llamando y necesitas encontrarlo."
    "你也许有点迟钝，但绝不蠢。Nulla 在呼唤你，你必须找到他。"

# game/rutas/labelsact2.rpy:723
translate chino act3_explorar_septem_44bc645a:

    # "Caminas siguiendo su llamado."
    "你循着他的呼唤前行。"

# game/rutas/labelsact2.rpy:724
translate chino act3_explorar_septem_af7ed50c:

    # "En ciertas ocasiones lo sientes cerca, para luego darte cuenta de que mientras más caminas, más te alejas."
    "有时你觉得他就在近处，可随即又发觉，你走得越远，他反而离你越远。"

# game/rutas/labelsact2.rpy:725
translate chino act3_explorar_septem_ed908e39:

    # "Es como jugar al juego del 'Frío o Caliente', solo que más difícil porque las pistas no están tan claras y dependes solo de una voz que se esfuma cuando cometes un error."
    "这就像在玩『冷还是热』的游戏，只是更难——因为线索并不那么清晰，你只能依靠一个声音，而每当犯错，那声音便会消散。"

# game/rutas/labelsact2.rpy:729
translate chino act3_explorar_septem_b2b3d35a:

    # "Te toma un tiempo para llegar a tu destino... es una puerta entreabierta a la que entras sin chistar."
    "花了些时间，你才抵达目的地……那是一扇半掩的门，你毫不犹豫地走了进去。"

# game/rutas/labelsact2.rpy:733
translate chino act3_explorar_septem_6e924f44:

    # "Hay algo dentro del cuarto... algo que se mueve como si respirase y que no debería estar ahí."
    "房间里有什么东西……一个仿佛在呼吸、本不该存在于此的东西。"

# game/rutas/labelsact2.rpy:734
translate chino act3_explorar_septem_90b56f74:

    # "El pánico te agarra de los pies y te obliga a salir de la habitación sin siquiera procesar que es lo que acabas de ver."
    "恐慌攫住了你的双脚，逼着你逃出房间，甚至来不及消化你刚刚看到的东西。"

# game/rutas/labelsact2.rpy:735
translate chino act3_explorar_septem_3b6fd595:

    # "Pero, tus pies se anclan en el suelo, atrapándote en el lugar. No importa cuanto te muevas o luches por liberarte, no hay caso. No tienes como salir de aquí."
    "然而，你的双脚却像生了根，把你钉在原地。无论你怎么挣扎、怎么试图挣脱，都无济于事。你根本出不去了。"

# game/rutas/labelsact2.rpy:736
translate chino act3_explorar_septem_fac7cdd2:

    # el "[nombrejugador]..."
    el "[nombrejugador]……"

# game/rutas/labelsact2.rpy:737
translate chino act3_explorar_septem_d982d752:

    # "La masa extraña te llama y lloriquea."
    "那团诡异的东西唤着你，呜咽着。"

# game/rutas/labelsact2.rpy:738
translate chino act3_explorar_septem_e470bad8:

    # "Su voz es una horripilante combinación entre la voz de Nulla y tuya, pero sin llegar a ser una copia exacta de ellas."
    "它的声音，是 Nulla 的声音与你的声音的一种令人毛骨悚然的结合，却又算不上其中任何一个的精确复制。"

# game/rutas/labelsact2.rpy:739
translate chino act3_explorar_septem_33e54c77:

    # "Al mirarla con detención te das cuenta de que reconoces lo que representa. Lo has vivido, lo has tocado, has pasado tiempo con ello."
    "仔细凝视之后，你发觉自己认得它所代表的东西。你经历过它，触碰过它，也曾与它共处过一段时间。"

# game/rutas/labelsact2.rpy:740
translate chino act3_explorar_septem_0a11efdf:

    # "Es tu marioneta... o lo que queda de ella."
    "那是你的傀儡……或者说，是它残存的部分。"

# game/rutas/labelsact2.rpy:741
translate chino act3_explorar_septem_7e878e94:

    # "Sus quejidos son como los de un bebé. Tiene miedo y necesita de ti."
    "它的呜咽宛如婴儿。它害怕，它需要你。"

# game/rutas/labelsact2.rpy:742
translate chino act3_explorar_septem_34f77f99:

    # "Necesita que la tomes."
    "它需要你抱住它。"

# game/rutas/labelsact2.rpy:747
translate chino act3_explorar_septem_1cbd20cd:

    # "La tomas."
    "你抱住了它。"

# game/rutas/labelsact2.rpy:748
translate chino act3_explorar_septem_6460eca0:

    # "La masa se pega a ti. Te atrapa, envolviendo sus tentáculos."
    "那团东西黏上了你。它困住了你，卷须缠上你的身躯。"

# game/rutas/labelsact2.rpy:753
translate chino act3_explorar_septem_4fa8780a:

    # "Te retuerces para escapar, con todas tus fuerzas."
    "你扭动着身躯，拼尽全力想要挣脱。"

# game/rutas/labelsact2.rpy:754
translate chino act3_explorar_septem_87cec586:

    # "La masa parece avanzar, buscándote, buscando tocarte."
    "那团东西似乎在向前推进，寻找着你，试图触碰你。"

# game/rutas/labelsact2.rpy:755
translate chino act3_explorar_septem_4a3221af:

    # "Comienzas a lloriquear, aterrado de lo que te pueda hacer esta cosa."
    "你开始呜咽，害怕这个东西会对你做出什么事。"

# game/rutas/labelsact2.rpy:756
translate chino act3_explorar_septem_077e1e91:

    # "Solo unos centímetros más y aquello te comerá... o peor, tomará control de ti."
    "再近几厘米，那东西就会把你吞掉……或者更糟，夺走你的掌控。"

# game/rutas/labelsact2.rpy:758
translate chino act3_explorar_septem_fe9e0926:

    # septem "Con que aquí estaba..."
    septem "原来它在这里……"

# game/rutas/labelsact2.rpy:759
translate chino act3_explorar_septem_4317a0cc:

    # "La voz de Septem se instala en el lugar, imponente y tranquila. Suelta un largo suspiro antes de continuar."
    "Septem 的声音充斥整个房间，威严而平静。他长长地叹了口气，才继续开口。"

# game/rutas/labelsact2.rpy:760
translate chino act3_explorar_septem_9c804da4:

    # septem "Reconozco que me demoré porque quería ver que hacías."
    septem "我承认我耽搁了一会儿，因为我想看看你会怎么做。"

# game/rutas/labelsact2.rpy:761
translate chino act3_explorar_septem_89edb59e:

    # septem "Me disculpo si te aterraste."
    septem "如果我吓到你了，我道歉。"

# game/rutas/labelsact2.rpy:768
translate chino act3_explorar_septem_31924e0f:

    # septem "..."
    septem "……"

# game/rutas/labelsact2.rpy:769
translate chino act3_explorar_septem_51462b9c:

    # septem "Bien. Es momento que salga de aquí."
    septem "很好。是时候离开这里了。"

# game/rutas/labelsact2.rpy:770
translate chino act3_explorar_septem_ae9395b1:

    # septem "Ya he eliminado a esa abominación."
    septem "我已经除掉了那个怪物。"

# game/rutas/labelsact2.rpy:773
translate chino act3_explorar_septem_104f5a8e:

    # septem "Ah no, no, no. Es peligroso."
    septem "啊不，不，不。那很危险。"

# game/rutas/labelsact2.rpy:774
translate chino act3_explorar_septem_072e1e1b:

    # septem "Y no me voy a arriesgar más."
    septem "我也不会再冒任何险了。"

# game/rutas/labelsact2.rpy:777
translate chino act3_explorar_septem_b0035e32:

    # septem "No entrarás más ahí..."
    septem "你不能再进去那里……"

# game/rutas/labelsact2.rpy:778
translate chino act3_explorar_septem_54231ee1:

    # septem "Ve a pasar el tiempo en otro lugar."
    septem "去别处消磨时间吧。"

# game/rutas/labelsact2.rpy:779
translate chino act3_explorar_septem_29a330b6:

    # septem "Si te aburres, ven conmigo."
    septem "要是无聊了，就来找我。"

# game/rutas/labelsact2.rpy:786
translate chino act3_explorar_septem_002fcd97:

    # "Recorres los pasillos una vez más... ya no encuentras la puerta que da a la habitación con el cuarto oscuro..."
    "你又走过了一遍走廊……却再也找不到通往那间暗室的门……"

# game/rutas/labelsact2.rpy:787
translate chino act3_explorar_septem_fa959bff:

    # "Extraño... ¿Será que Septem la ha bloqueado de alguna manera?"
    "奇怪……难道 Septem 用某种方法把它封住了？"

# game/rutas/labelsact2.rpy:793
translate chino act3_explorar_septem_5f9b772e_1:

    # "...."
    "……"

# game/rutas/labelsact2.rpy:800
translate chino act3_explorar_septem_a20cefa7_3:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:804
translate chino act3_explorar_septem_040c52df:

    # "Caminas hasta llegar a la puerta que aísla a Rafael del resto del templo."
    "你一路走到那道将 Rafael 与神庙其余部分隔绝开来的门前。"

# game/rutas/labelsact2.rpy:808
translate chino act3_explorar_septem_1bdbb080:

    # "Entras sin restricción aparente: la puerta está desbloqueada, no hay fuerza invisible que te impida entrar en la habitación, y el lugar te recibe con una cálida energía."
    "你走进去，没有遇到任何明显的阻碍：门没有上锁，没有无形的力量阻止你进入房间，这个地方以一股温暖的能量迎接你。"

# game/rutas/labelsact2.rpy:809
translate chino act3_explorar_septem_3071ee5f:

    # "En la cama está Rafael. Te acercas a paso lento, con miedo a despertarlo."
    "Rafael 躺在床上。你放慢脚步靠近，生怕吵醒他。"

# game/rutas/labelsact2.rpy:810
translate chino act3_explorar_septem_21be97c1:

    # "Sabes que es imposible, pero no puedes evitar en pensar que estás infringiendo en alguna regla que Septem ha dictaminado sin informarte."
    "你知道这不可能，却还是忍不住去想：你是不是正在违背 Septem 某项没有告诉你的规定。"

# game/rutas/labelsact2.rpy:814
translate chino act3_explorar_septem_ddbd2073:

    # "Te quedas a un costado de la cama. Sabes lo suficiente de espacio personal y comportamiento social básico como para no subirte a la cama e invadir su espacio personal."
    "你了解个人空间与基本社交礼仪，足以让你不会爬上床去侵占他的私人空间。"

# game/rutas/labelsact2.rpy:815
translate chino act3_explorar_septem_f35d111c:

    # "Lo observas un buen rato."
    "你注视了他好一会儿。"

# game/rutas/labelsact2.rpy:816
translate chino act3_explorar_septem_06ee9755:

    # "Te da pena verlo sin reaccionar, a sabiendas de que no está dormido ni muerto. Su estado es incierto, a lo único que podrías asimilarlo es a un estado de pausa donde lo único que hace su cuerpo es respirar."
    "看到他毫无反应，你心里难过，因为你知道他没有睡着，也没有死。他的状况并不明朗，你唯一能拿来比拟的，是一种悬置的状态——他的身体除了呼吸，什么都不做。"

# game/rutas/labelsact2.rpy:817
translate chino act3_explorar_septem_7d298c0f:

    # "No hay existencia de micro-movimientos que pasan en el sueño o expresiones de dolor."
    "没有睡眠中那些细微的动静，也没有任何痛苦的表情。"

# game/rutas/labelsact2.rpy:818
translate chino act3_explorar_septem_a5aef67f:

    # "Te quedas para acompañar a esta alma atrapada en un cuerpo que no responde. Desconoces si puede oír lo que pasa a su alrededor, por lo que no te atreves a hablarle."
    "你留下来，陪伴这个被困在一具毫无反应的身体里的灵魂。你不知道他能不能听见周围发生的一切，所以你不敢对他开口。"

# game/rutas/labelsact2.rpy:819
translate chino act3_explorar_septem_1742f7b2:

    # "Los minutos pasan...."
    "时间一分一分过去……"

# game/rutas/labelsact2.rpy:820
translate chino act3_explorar_septem_fbf09984:

    # "Cuando crees que ha sido suficiente, abandonas el lugar."
    "当你觉得已经待得够久，便离开了那个地方。"

# game/rutas/labelsact2.rpy:822
translate chino act3_explorar_septem_bac690d1:

    # "Te preguntas cuando podrás ver a Rafael activo y con un cuerpo que solo le pertenezca a él."
    "你想知道，什么时候才能再见到 Rafael 活动起来，拥有一具只属于他自己的身体。"

# game/rutas/labelsact2.rpy:827
translate chino act3_explorar_septem_ab3e3246:

    # "Quieres verlo y si Septem necesita más tiempo solo, ya que te lo diría. Jamás te prohibió ir a visitarlo a la biblioteca."
    "你想见他，如果 Septem 需要更多独处的时间，他会告诉你的。他从未禁止你去图书馆探望他。"

# game/rutas/labelsact2.rpy:828
translate chino act3_explorar_septem_2f52215c:

    # "Además, quieres mostrarle cómo te queda el conjunto de ropa que él te ha elegido."
    "再说，你也想让他看看，他替你挑的那套衣服穿在你身上是什么样子。"

# game/rutas/labelsact2.rpy:829
translate chino act3_explorar_septem_36541f91:

    # "Entonces, es {b}muy{b} necesario que lo veas antes de que sea el mediodía, ya que necesitas su opinión."
    "所以，在中午之前去见他是{b}非常{/b}必要的，因为你需要他的意见。"

# game/rutas/labelsact2.rpy:833
translate chino act3_explorar_septem_48d22b29:

    # "Subes las escaleras cuidando tus pasos. Mirando donde caen tus pies en cada escalón. Se te dificulta un poco por lo largo de la túnica, que te impide ver dónde aterriza cada pie."
    "你小心地爬上楼梯，留意每一级台阶上脚落的位置。这有点困难，因为你的袍子太长，看不见自己的脚落在哪里。"

# game/rutas/labelsact2.rpy:834
translate chino act3_explorar_septem_b69f52cb:

    # "Cuando llegas al último escalón, celebras en silencio tu logro. Estas ropas no fueron hechas para moverse como uno lo hace cotidianamente. Posiblemente fueron hechas para sentarse y verse bonito."
    "当你踏上最后一级台阶，你在心里悄悄庆祝自己的胜利。这些衣服本不是为日常活动而做的，大概是为了让人静坐、好看地端坐着。"

# game/rutas/labelsact2.rpy:835
translate chino act3_explorar_septem_008c6aaa:

    # "Como una muñeca de mostrador... bien cuidada y destinada solamente a ser observada desde el cristal. Una belleza perpetua que no alcanza a tener un propósito más grande que aquello."
    "就像展示柜里的娃娃……被精心照料，只供人隔着玻璃观赏。一种永恒的美，除此之外再无更大的目的。"

# game/rutas/labelsact2.rpy:836
translate chino act3_explorar_septem_bfd22da7:

    # "Huh..."
    "嗯……"

# game/rutas/labelsact2.rpy:837
translate chino act3_explorar_septem_1e4334bc:

    # "Decides dejar ese pensamiento fuera de tu cabeza. No vale la pena ocasionar una jaqueca con pensar en todas posibilidades que no puedes controlar por ahora..."
    "你决定把那个念头赶出脑海。为那些眼下无法控制的可能性伤神并不值得……"

# game/rutas/labelsact2.rpy:841
translate chino act3_explorar_septem_df1bbf97:

    # "Te detienes en frente de la entrada de la biblioteca."
    "你在图书馆的入口前停下脚步。"

# game/rutas/labelsact2.rpy:842
translate chino act3_explorar_septem_89623bdc:

    # "Te cuestionas si debes entrar... tal vez Septem quiera tener un momento sin tu presencia."
    "你犹豫着该不该进去……也许 Septem 想有一段没有你在身边的独处时光。"

# game/rutas/labelsact2.rpy:843
translate chino act3_explorar_septem_afa7d5bd:

    # "La puerta es la única barrera que hay entre tú y él. Solo tienes que levantar la mano y llamar a la puerta."
    "门是你和他之间唯一的屏障。你只需抬起手，敲一敲。"

# game/rutas/labelsact2.rpy:844
translate chino act3_explorar_septem_94db336b:

    # "Te preparas para tocar la puerta, pero la voz de Septem te hace pausar."
    "你正准备敲门，Septem 的声音却让你停住了。"

# game/rutas/labelsact2.rpy:845
translate chino act3_explorar_septem_a6942ec7:

    # septem "Pasa."
    septem "进来。"

# game/rutas/labelsact2.rpy:846
translate chino act3_explorar_septem_af69cf18:

    # "Tu estómago da un vuelco al escuchar su voz. Si bien es un comando, tú no tienes la obligación de cumplirlo bajo obligaciones de reglas que aún no entiendes."
    "听到他的声音，你的胃猛地一紧。尽管那是命令，但在你还不理解的规则之下，你没有义务服从它。"

# game/rutas/labelsact2.rpy:847
translate chino act3_explorar_septem_4ff0cd05:

    # "No ha dicho tu nombre, por lo que eres libre de tomar la decisión de si pasar o no."
    "他没有叫你的名字，所以你完全可以自行决定要不要进去。"

# game/rutas/labelsact2.rpy:848
translate chino act3_explorar_septem_287fee54:

    # "Te preguntas que pasaría si no lo haces."
    "你想着，要是不进去会发生什么。"

# game/rutas/labelsact2.rpy:851
translate chino act3_explorar_septem_8ff0443a:

    # septem "¿Has cambiado de opinión?"
    septem "你改变主意了吗？"

# game/rutas/labelsact2.rpy:852
translate chino act3_explorar_septem_912b1f5f:

    # septem "Parecías muy decidido a venir antes de llegar aquí."
    septem "在到这里之前，你看起来还那么下定决心要来。"

# game/rutas/labelsact2.rpy:853
translate chino act3_explorar_septem_fc2fbe90:

    # "Septem solo ríe, divertido con tu cambio tan repentino en tu actitud... su risa casi se siente como una burla por su parte."
    "Septem 只是笑，对你态度的突然转变感到有趣……那笑声几乎让你觉得他在嘲弄你。"

# game/rutas/labelsact2.rpy:854
translate chino act3_explorar_septem_01d06a44:

    # septem "Recuerda de que tenemos que salir al mediodía."
    septem "记住，我们中午必须出发。"

# game/rutas/labelsact2.rpy:855
translate chino act3_explorar_septem_2097e277:

    # septem "No te vayas tan lejos. Este lugar es más grande de lo que crees."
    septem "别走得太远。这个地方比你想象的要大。"

# game/rutas/labelsact2.rpy:863
translate chino act3_explorar_septem_dedcd9f9:

    # "La puerta se abre antes de que puedas tocar el pomo y empujar."
    "你还没碰到门把手去推，门就自己开了。"

# game/rutas/labelsact2.rpy:864
translate chino act3_explorar_septem_45b079f9:

    # "Dentro de la biblioteca, Septem se encuentra al frente del ventanal, devolviéndote la mirada. Sus manos yacen entrelazadas detrás de su espalda, con una postura anormalmente recta."
    "图书馆里，Septem 站在那扇大窗前，回望着你。他的双手交握在背后，姿势笔直得有些不自然。"

# game/rutas/labelsact2.rpy:865
translate chino act3_explorar_septem_018264be:

    # "Te esperabas encontrarlo sentado en su escritorio, leyendo algo con el semblante serio, tal vez con las cejas fruncidas y una pequeña mueca en tu boca."
    "你本以为会看到他坐在书桌前，神情严肃地读着什么，也许眉头紧锁，唇边带着一丝浅笑。"

# game/rutas/labelsact2.rpy:866
translate chino act3_explorar_septem_43710aac:

    # "Verlo ahí te confirma que debe haber estado mirando por la ventana antes de que entraras."
    "看到他站在那里，你确信在你进来之前，他一定正望着窗外。"

# game/rutas/labelsact2.rpy:867
translate chino act3_explorar_septem_e11b6472:

    # septem "Ven, siéntate."
    septem "过来，坐下。"

# game/rutas/labelsact2.rpy:871
translate chino act3_explorar_septem_f7a86a75:

    # "Rompe el silencio luego de ver que te has quedado pasmado en la puerta, sin saber que hacer. Septem corre la silla del escritorio, donde él se sienta, ofreciendo el lugar para ti."
    "看到你愣在门口、不知所措之后，他打破了沉默。Septem 拉开他平日里坐的那把椅子，把自己的座位让给你。"

# game/rutas/labelsact2.rpy:872
translate chino act3_explorar_septem_5784d075:

    # "Avanzas y te sientas con cuidado en la silla."
    "你走上前，小心地在椅子上坐下。"

# game/rutas/labelsact2.rpy:875
translate chino act3_explorar_septem_3ab76f72:

    # septem "Te queda bien."
    septem "你穿着很好看。"

# game/rutas/labelsact2.rpy:880
translate chino act3_explorar_septem_7aef4df7:

    # "Cuando le miras para entender a que se refiere, Septem agrega señalando con la mano en tu dirección."
    "你望向他，想弄清楚他指的是什么，Septem 又开口了，用手朝你这边指了指。"

# game/rutas/labelsact2.rpy:885
translate chino act3_explorar_septem_19fbb461:

    # septem "Tus vestimentas."
    septem "你的衣着。"

# game/rutas/labelsact2.rpy:888
translate chino act3_explorar_septem_1bdd86c1:

    # "Oh... sientes tu cara enrojecer..."
    "哦……你感觉脸颊在发烫……"

# game/rutas/labelsact2.rpy:889
translate chino act3_explorar_septem_14af9c47:

    # "Te encojes en la silla, no sabiendo que hacer con el cumplido que te ha hecho Septem. Te obligas a decir un 'gracias' que suena ahogado, delatando tu nerviosismo."
    "你缩在椅子里，不知道该怎么应对 Septem 的称赞。你勉强挤出一声闷闷的“谢谢”，暴露了自己的紧张。"

# game/rutas/labelsact2.rpy:890
translate chino act3_explorar_septem_0e16ac8c:

    # "Septem se acerca un poco más a ti, invadiendo tu espacio personal por un segundo, antes de retomar la distancia previa con una de tus mangas en la mano."
    "Septem 稍微靠近了些，在一瞬间侵入你的个人空间，随后又退回原来的距离，手里捏着你的一只袖子。"

# game/rutas/labelsact2.rpy:894
translate chino act3_explorar_septem_fb4e1281:

    # septem "Las mangas se han ensuciado un poco."
    septem "袖子弄脏了一点。"

# game/rutas/labelsact2.rpy:895
translate chino act3_explorar_septem_f6c44922:

    # "Dice él examinando la tela. Pasa sus dedos por cada hebra que compone la manga, acariciando con suavidad."
    "他说着，仔细查看那块布料。他的手指抚过构成袖子的每一根丝线，轻柔地摩挲着。"

# game/rutas/labelsact2.rpy:900
translate chino act3_explorar_septem_e264e1a7:

    # septem "Al parecer las hice muy largas para ti."
    septem "看来我给你做得太长了。"

# game/rutas/labelsact2.rpy:901
translate chino act3_explorar_septem_64b3fcc6:

    # "Sientes su enojo subir por tu tráquea."
    "你感到他的怒火顺着你的气管往上窜。"

# game/rutas/labelsact2.rpy:902
translate chino act3_explorar_septem_ac05027a:

    # septem "Las arrastras al caminar."
    septem "你走路的时候把它们拖在地上。"

# game/rutas/labelsact2.rpy:907
translate chino act3_explorar_septem_266f67c0:

    # "Las mangas se han ensuciado porque son en extremo largas, claro. No es tu culpa, pero parte de ti espera que Septem te dé un sermón por ensuciar las ropas que te ha cedido, como mínimo."
    "袖子会弄脏，当然是因为它们实在太长了。这不是你的错，但你心里有一部分仍期待着 Septem 至少会为弄脏他给你的衣服而训你一顿。"

# game/rutas/labelsact2.rpy:908
translate chino act3_explorar_septem_1e08577f:

    # "No lo puedes evitar. Más cuando sientes como su enojo bombea por tu sangre."
    "你忍不住这么想。尤其当你感到他的怒火正顺着你的血液泵动。"

# game/rutas/labelsact2.rpy:909
translate chino act3_explorar_septem_5927d8c5:

    # "Él es muy severo con su juicio y expectativas con el resto de las entidades que interactúa... y tú no puedes ser la excepción..."
    "他对自己接触到的其他存在，判断与期望都极其严苛……而你不可能成为例外……"

# game/rutas/labelsact2.rpy:913
translate chino act3_explorar_septem_66e736f8:

    # "El tirón en tu manga hace que cierres los ojos con fuerza."
    "袖子上传来的那一拽让你紧紧闭上了双眼。"

# game/rutas/labelsact2.rpy:914
translate chino act3_explorar_septem_31924e0f_1:

    # septem "..."
    septem "……"

# game/rutas/labelsact2.rpy:915
translate chino act3_explorar_septem_3a474e4b:

    # septem "Listo."
    septem "好了。"

# game/rutas/labelsact2.rpy:916
translate chino act3_explorar_septem_2437573e:

    # "Al no sentir nada en tu cuerpo parecido al dolor, abres tus ojos."
    "当身体里没有感到任何类似疼痛的东西时，你睁开了眼睛。"

# game/rutas/labelsact2.rpy:920
translate chino act3_explorar_septem_d6a28860:

    # "Lo primero vez es la mano de Septem con la mitad de tu manga, perfectamente cortada."
    "映入眼帘的，是 Septem 的手，还有被齐整裁断的半截袖子。"

# game/rutas/labelsact2.rpy:924
translate chino act3_explorar_septem_6af7dc8e:

    # septem "Ese error no volverá a cometerse."
    septem "这个错误不会再犯了。"

# game/rutas/labelsact2.rpy:929
translate chino act3_explorar_septem_fe74f763:

    # septem "Tus próximas vestimentas no tendrán esa falla, mi salvador."
    septem "你下一套衣服不会有这个缺陷，我的救主。"

# game/rutas/labelsact2.rpy:934
translate chino act3_explorar_septem_a0cf66eb:

    # "Ah..."
    "啊……"

# game/rutas/labelsact2.rpy:935
translate chino act3_explorar_septem_6b623f95:

    # "El enojo que estabas sintiendo era por su error... no el tuyo."
    "你刚才感到的愤怒，是因为他的错……不是你的。"

# game/rutas/labelsact2.rpy:936
translate chino act3_explorar_septem_f0d26964:

    # "No sabes si eso es malo y bueno..."
    "你不知道这究竟是好事还是坏事……"

# game/rutas/labelsact2.rpy:940
translate chino act3_explorar_septem_167b29d2:

    # "Pasas el tiempo junto con Septem en la biblioteca. Él te trae un libro que deja en el escritorio. Es grande, de esos que hacen un ruido seco y fuerte cuando los dejas caer en la mesa."
    "你和 Septem 一起在图书馆里待了一阵。他拿来一本书，放在书桌上。书很大，是那种往桌上一扔就会发出一声沉闷巨响的类型。"

# game/rutas/labelsact2.rpy:941
translate chino act3_explorar_septem_147cab8b:

    # "Mientras miras el libro, Septem opta por quedarse erguido detrás de tu silla."
    "你看着那本书时，Septem 选择继续挺直地站在你椅子后方。"

# game/rutas/labelsact2.rpy:942
translate chino act3_explorar_septem_f68868e0:

    # septem "Un líder competente debe saber el idioma de su gente."
    septem "一个称职的领袖必须懂得自己子民的语言。"

# game/rutas/labelsact2.rpy:943
translate chino act3_explorar_septem_d48efa62:

    # "Escuchas su voz detrás se tu oreja, tan cerca que los vellos de tus brazos se erizan al percibir su aliento cerca de tu cuello."
    "你听见他的声音就在耳后，近到当你感到他的呼吸拂过颈侧时，手臂上的汗毛都竖起来了。"

# game/rutas/labelsact2.rpy:944
translate chino act3_explorar_septem_0984a5ff:

    # "No puedes evitar girar tu cabeza para comprobar la distancia que existe entre tú y él."
    "你忍不住转头，想确认你和他之间到底隔了多远。"

# game/rutas/labelsact2.rpy:948
translate chino act3_explorar_septem_7b99523a:

    # "Un pedazo de alma sale por tu boca cuando te encuentras con su cara a centímetros de ti, asomándose por tu hombro derecho."
    "当你发现他的脸离你只有几厘米，正从你的右肩后方探过来看时，你差点魂都从嘴里飞出去了。"

# game/rutas/labelsact2.rpy:949
translate chino act3_explorar_septem_69dad36c:

    # "Septem te sostiene la mirada, sin reacción aparente, y continúa."
    "Septem 毫不躲闪地迎着你的目光，面无表情，然后继续说下去。"

# game/rutas/labelsact2.rpy:952
translate chino act3_explorar_septem_5d7d7187:

    # septem "Quien dirige la palabra, debe saber leerla y hablarla."
    septem "驾驭言语的人，必须懂得如何读懂并说出它们。"

# game/rutas/labelsact2.rpy:953
translate chino act3_explorar_septem_d41a1db6:

    # septem "La lengua madre del Jardín es el latín."
    septem "花园的母语是拉丁语。"

# game/rutas/labelsact2.rpy:954
translate chino act3_explorar_septem_ddc3a000:

    # septem "Tú la usarás para invocar y comandar."
    septem "你会用它来召唤与命令。"

# game/rutas/labelsact2.rpy:959
translate chino act3_explorar_septem_84189069:

    # "Una de sus manos se desliza por tu brazo hasta llegar a tu cuello. Sin apretar su agarre, su dedo índice marca y traza la arteria que se encuentra al lado izquierdo."
    "他的一只手沿着你的手臂滑下，一直来到你的脖颈。他并没有收紧力道，只是用食指描摹左侧那条动脉。"

# game/rutas/labelsact2.rpy:960
translate chino act3_explorar_septem_165eaf04:

    # "Lo hace lento, buscando el bombeo de la sangre que llevan tus venas. Al tragar saliva, Septem siente el movimiento de tu garganta, y aprieta el agarre un poco más, escapándosele un suspiro..."
    "他缓缓地描摹着，寻找你血管中血液搏动的节奏。当你吞咽时，Septem 感觉到你喉部的动静，手指稍微收紧了些，又长长地叹了口气……"

# game/rutas/labelsact2.rpy:961
translate chino act3_explorar_septem_74745db3:

    # "Ahora te es imposible ignorar como sus dedos se clavan en tu piel."
    "现在，他手指掐进你皮肤的方式已经让你无法忽视。"

# game/rutas/labelsact2.rpy:962
translate chino act3_explorar_septem_c4fe784a:

    # septem "El tono al nombrar las palabras tiene que ser exacto. Un solo flaqueo en el, rompe la invocación."
    septem "念出那些词时的语调必须精确无误。哪怕一次停顿，都会让召唤破裂。"

# game/rutas/labelsact2.rpy:963
translate chino act3_explorar_septem_a20cefa7_4:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:964
translate chino act3_explorar_septem_69eeeb14:

    # septem "Abre el libro en la página veinticuatro."
    septem "把书翻到第二十四页。"

# game/rutas/labelsact2.rpy:967
translate chino act3_explorar_septem_68fddb73:

    # "Lo haces como puedes. Tu cabeza está en todos lados menos en la finalidad de la tarea y estás más que seguro que nada de lo que hagas o aprendas se quedará realmente contigo después de esto."
    "你尽力而为。你的心神全不在这项任务的目的上，而且你几乎笃定，无论做什么、学什么，事后都不会真正留在你身上。"
    
# game/rutas/labelsact2.rpy:968
translate chino act3_explorar_septem_c9ddb221:

    # "Hay un montón de sensaciones y sentimientos que se ebullen en tu cuerpo, pero el miedo no es una de ellas."
    "你的身体里翻涌着无数感觉与情绪，但恐惧并不在其中。"

# game/rutas/labelsact2.rpy:969
translate chino act3_explorar_septem_64aa035b:

    # "Y Septem lo sabe."
    "而 Septem 知道这一点。"

# game/rutas/labelsact2.rpy:970
translate chino act3_explorar_septem_687a63aa:

    # septem "No te distraigas."
    septem "不要走神。"

# game/rutas/labelsact2.rpy:971
translate chino act3_explorar_septem_42d8dbf7:

    # "Su llamado de atención no hace más que quieras maldecirlo por ponerte en esta situación."
    "他的训斥只让你更想咒骂他，因为是他把你置于这种境地。"

# game/rutas/labelsact2.rpy:977
translate chino act3_explorar_septem_439922c1:

    # septem "Lo primero que debemos saber antes de hacer una invocación es a quien te refieres."
    septem "在进行召唤之前，我们首先要知道的是，你指的是谁。"

# game/rutas/labelsact2.rpy:978
translate chino act3_explorar_septem_a6db342a:

    # septem "Sea un tú, un yo o un nosotros."
    septem "是你、是我，还是我们。"

# game/rutas/labelsact2.rpy:979
translate chino act3_explorar_septem_c5838158:

    # "Con la mano disponible, Septem te muestra donde salen esas palabras y te hace repetirlas en latín. Cuando detecta que tu voz se rompe o flaquea, sus dedos ayudan apretando o soltando tu garganta para dejar salir la voz justo como él quiere."
    "Septem 用空着的那只手给你指出那些词出现在哪里，让你用拉丁语重复。每当他发现你的声音发颤或停顿，他的手指就会收紧或放松对你的喉部的钳制，好让你的声音恰好按他所希望的方式发出来。"

# game/rutas/labelsact2.rpy:980
translate chino act3_explorar_septem_e0f9d97b:

    # "Así que para eso ha puesto su mano ahí..."
    "原来他把他的手放在那里，是为了这个……"

# game/rutas/labelsact2.rpy:981
translate chino act3_explorar_septem_8ca3fdaf:

    # septem "Cuando pedimos algo que solo te involucre a ti, debes decir---"
    septem "当请求只涉及你自己的事情时，你必须说——"

# game/rutas/labelsact2.rpy:982
translate chino act3_explorar_septem_25f8068f:

    # "Su cuerpo se acerca más al tuyo, rozando tu hombro con su pecho, tomando la oportunidad de colocar su boca directamente en tu oído. Resguardando sus palabras solo para ti, como si alguien más pudiese escuchar y robarte esas palabras de ti."
    "他的身体更靠近你，胸膛擦过你的肩膀，借机把嘴唇直接送到你耳边。他把那些话语只留给你一个人，仿佛旁人会听见、会从你手中夺走它们。"

# game/rutas/labelsact2.rpy:983
translate chino act3_explorar_septem_8374cf11:

    # septem "{i}Sub potestate quae mihi conceditur ego faciam...{i} \n {size=*0.6}Bajo el poder que me confiere, yo hare.{/size}"
    septem "{i}Sub potestate quae mihi conceditur ego faciam...{i} \n {size=*0.6}凭借授予我的力量，我将行事。{/size}"

# game/rutas/labelsact2.rpy:984
translate chino act3_explorar_septem_0745cac8:

    # "Las palabras que salen de su boca son desconocidas, pero las entiendes de alguna manera. El problema reside en poder imitar su vocalización..."
    "从他口中说出的那些词你并不熟悉，但不知怎的你能理解。问题在于，你能否模仿他的发音……"

# game/rutas/labelsact2.rpy:985
translate chino act3_explorar_septem_884244f6:

    # "Dudas que lo puedas hacer a la primera, sin tropezar con la lengua al soltar todas las palabras en una frase."
    "你怀疑自己能不能一次就做到，能不能不在把一整句话说出口时舌头打结。"

# game/rutas/labelsact2.rpy:986
translate chino act3_explorar_septem_1f205ceb:

    # septem "Repite."
    septem "重复。"

# game/rutas/labelsact2.rpy:987
translate chino act3_explorar_septem_8374cf11_1:

    # septem "{i}Sub potestate quae mihi conceditur ego faciam...{i} \n {size=*0.6}Bajo el poder que me confiere, yo hare.{/size}"
    septem "{i}Sub potestate quae mihi conceditur ego faciam...{i} \n {size=*0.6}凭借授予我的力量，我将行事。{/size}"

# game/rutas/labelsact2.rpy:991
translate chino act3_explorar_septem_8e2c6cdd:

    # "Lo intentas una vez, sin lograrlo del todo. Dos veces, te ahogas con tu propia saliva... que Humillante. A la tercera, ya tienes a Septem apretando tu garganta para sacar correctamente las vibraciones de cada comando."
    "试了一次，没有完全成功。第二次，你被自己的口水呛到……真是丢脸。第三次时，Septem 已经在捏你的喉咙，好让你发出每个命令该有的振动。"

# game/rutas/labelsact2.rpy:992
translate chino act3_explorar_septem_3ffcdc11:

    # "Él es estricto y serio, pero cuando ve que te frustras y refunfuñas como un gato enojado, no puede evitar soltar una pequeña risa que oculta con la mano."
    "他严厉又严肃，可当他看到你懊恼地嘟囔，像一只气鼓鼓的猫时，他也忍不住轻轻笑了一声，还用手掩住嘴。"

# game/rutas/labelsact2.rpy:993
translate chino act3_explorar_septem_142cf103:

    # "Intentas nuevamente. Ahora la lengua la tienes suelta de tanto pronunciar cada palabra, lo te permite sacarlas de tu boca con más fluidez"
    "你又试了一遍。如今因为反复念过每个词，舌头已经灵活起来，能让你更流利地把它们说出口。"

# game/rutas/labelsact2.rpy:994
translate chino act3_explorar_septem_7468a116:

    # "Tu avance no pasa desapercibido. Septem se encarga de reconocerlo cada vez que lo haces bien o cuando vas por buen camino."
    "你的进展并没有被忽视。每次你做对了，或是走在正确的道路上，Septem 都会及时给予肯定。"

# game/rutas/labelsact2.rpy:995
translate chino act3_explorar_septem_d0ef6769:

    # "Se ríe cuando fallas, pero no es una risa burlona. No. Es una risa que late con ternura al verte intentarlo, y desborda orgullo al ver progreso en tu pronunciación."
    "你犯错时他会笑，但那不是嘲弄的笑。不是。那是看着你努力尝试时满含温柔的笑，当他看到你的发音进步时，笑意里又满溢着骄傲。"

# game/rutas/labelsact2.rpy:996
translate chino act3_explorar_septem_a54f1628:

    # "Cuando por fin lo logras, Septem te felicita, enfatizando lo perfecto que ha salido."
    "当你终于成功时，Septem 向你祝贺，强调你做得有多么完美。"

# game/rutas/labelsact2.rpy:997
translate chino act3_explorar_septem_6e36546a:

    # "Septem es un buen maestro."
    "Septem 是个好老师。"

# game/rutas/labelsact2.rpy:1001
translate chino act3_explorar_septem_bbe140b7:

    # septem "Para pedir algo que involucre a un otro, un {i}tú{i}, debes decir---"
    septem "若要请求涉及另一个人，一个{i}你{/i}，你必须说——"

# game/rutas/labelsact2.rpy:1002
translate chino act3_explorar_septem_d9282ca6:

    # septem "{i}Sub potestate quae mihi conceditur, tu facies...{i} \n {size=*0.6}Bajo el poder que me confiere, tú harás.{/size}"
    septem "{i}Sub potestate quae mihi conceditur, tu facies...{i} \n {size=*0.6}凭借授予我的力量，你将行事。{/size}"

# game/rutas/labelsact2.rpy:1003
translate chino act3_explorar_septem_84197a25:

    # "Habiendo pronunciado el anterior comando, te es más fácil sacar este. Lo único que cambia son las palabras del final."
    "念过上一个命令后，你觉得这个更容易说出口了。唯一改变的是末尾的几个词。"

# game/rutas/labelsact2.rpy:1004
translate chino act3_explorar_septem_0161b45e:

    # septem "Y para un nosotros, sería---"
    septem "而“我们”的话，会是这样——"

# game/rutas/labelsact2.rpy:1005
translate chino act3_explorar_septem_74648207:

    # septem "{i}Sub potestate quae mihi conceditur, nos faciemu... {i} \n {size=*0.6}Bajo el poder que me confiere, nosotros haremos...{/size}"
    septem "{i}Sub potestate quae mihi conceditur, nos faciemu... {i} \n {size=*0.6}凭借授予我的力量，我们将行事……{/size}"

# game/rutas/labelsact2.rpy:1009
translate chino act3_explorar_septem_dc61691d:

    # "Ya lo tienes dominado. No necesitas la guía de Septem con sus dedos o pausas para pedir que él te lo repita porque tú lo has olvidado."
    "你已经完全掌握了。你不再需要 Septem 用手指引导你，也不需要停下来请他重复那些你已经忘掉的内容。"

# game/rutas/labelsact2.rpy:1010
translate chino act3_explorar_septem_3d2c81bf:

    # "Ya lo manejas, por lo que Septem te deja descansar."
    "你已经很熟练了，于是 Septem 让你休息。"

# game/rutas/labelsact2.rpy:1011
translate chino act3_explorar_septem_9630a409:

    # "Eventually, you begin to wonder whether you should stay here or go out and see what else there is to discover."
    "终于，你开始想，自己该留在这里，还是出去看看还有什么可以发现的。"

# game/rutas/labelsact2.rpy:1015
translate chino act3_explorar_septem_2e716117:

    # "Te despides de Septem, excusándote, diciendo que quieres seguir explorando el templo."
    "你向 Septem 告别，借口说你想继续探索神庙。"

# game/rutas/labelsact2.rpy:1016
translate chino act3_explorar_septem_8d8cbbe1:

    # "Él te desea suerte."
    "他祝你好运。"

# game/rutas/labelsact2.rpy:1020
translate chino act3_explorar_septem_73c1b6c5:

    # "Quedarte con Septem no suena mal. Te gusta pasar el tiempo con él."
    "和 Septem 待在一起听起来并不坏。你享受与他共度的时光。"

# game/rutas/labelsact2.rpy:1021
translate chino act3_explorar_septem_fac649fb:

    # "El tiempo pasa y cuenta no te das cuando Septem te comenta que ya es hora. Te espera para que tú te levantes de su silla y camina junto contigo a la entrada del templo."
    "时间不知不觉地流逝，直到 Septem 告诉你时候到了。他等你从他的椅子上起身，然后陪你一起走向神庙入口。"

# game/rutas/labelsact2.rpy:1026
translate chino act3_explorar_septem_a3424ce1:

    # "No queda otra que esperar..."
    "除了等待，没有别的可做了……"

# game/rutas/labelsact2.rpy:1027
translate chino act3_explorar_septem_0e2d87c9:

    # "Sabes que de mediodía cuando la voz de Septem te llama por tu nombre, haciendo que todo tu cuerpo se enderece."
    "当 Septem 的声音喊出你的名字，让你的整个身体一下子绷直时，你知道中午到了。"

# game/rutas/labelsact2.rpy:1028
translate chino act3_explorar_septem_4354b283:

    # "No esperas mucho para apreciar como su cuerpo se materializa frente de ti. Con esa apariencia tan refinada y gloriosa que no permite la aparición alguna imperfección."
    "你没多久就看见他的身体在你面前显现。带着那副精致而光辉的外表，容不得任何一丝不完美。"

# game/rutas/labelsact2.rpy:1029
translate chino act3_explorar_septem_24a15800:

    # "Septem te pide que camines con él hasta la entrada del templo. Te espera cuando nota que vas atrás, siempre intentando ir a la par tus pasos."
    "Septem 请你陪他走到神庙入口。每当他注意到你落后了，都会停下来等你，始终试着与你的步伐保持一致。"

# game/rutas/labelsact2.rpy:1038
translate chino explorar_unum_act3_87651cf1:

    # "Sabes que Noor se ha ido al patio, lo conoces tan bien que no te cabe duda de ello."
    "你知道 Noor 去了庭院。你太了解他了，对此毫不怀疑。"

# game/rutas/labelsact2.rpy:1039
translate chino explorar_unum_act3_21baa8a5:

    # "Así que vas en su búsqueda."
    "所以你去找他了。"

# game/rutas/labelsact2.rpy:1042
translate chino explorar_unum_act3_428bfbd8:

    # "Apenas sales de la residencia, y ya lo divisas a lo lejos."
    "你刚走出居所，就在远处看见了他。"

# game/rutas/labelsact2.rpy:1043
translate chino explorar_unum_act3_9d24b5ed:

    # "Se encuentra acostado en el suelo, dormitando con ambos brazos encima de su estómago, en posición de descanso. Su cola barre el suelo en un serpenteo constante, buscando cada roce."
    "他躺在地上，双臂搭在肚子上打盹，一副休憩的姿态。他的尾巴在地上不停扫动，蛇一般地扭动着，寻求每一寸触碰。"

# game/rutas/labelsact2.rpy:1045
translate chino explorar_unum_act3_c23ceeea:

    # "Se le ve tan agusto que decides no molestarlo con acercarte. Por lo que lo miras de lejos."
    "他看起来那么惬意，你决定不走近打扰他。于是你远远地看着他。"

# game/rutas/labelsact2.rpy:1047
translate chino explorar_unum_act3_10525044:

    # "Él nota tu presencia, su mirada te lo confirma."
    "他察觉到了你的存在，他的目光证实了这一点。"

# game/rutas/labelsact2.rpy:1048
translate chino explorar_unum_act3_1aeedfd2:

    # noor "Ven."
    noor "过来。"

# game/rutas/labelsact2.rpy:1049
translate chino explorar_unum_act3_0cd2f2bc:

    # "Te pide, palpando el suelo."
    "他拍着地面，向你发出邀请。"

# game/rutas/labelsact2.rpy:1050
translate chino explorar_unum_act3_6713caef:

    # "Vas sin apuro, aunque desearías ir corriendo para saltar en sus brazos y acurrucarte con tu bebé."
    "你慢慢走过去，尽管你多希望自己能跑过去，扑进他怀里，和你的宝贝亲昵一番。"

# game/rutas/labelsact2.rpy:1051
translate chino explorar_unum_act3_db59fc65:

    # "Pero te aguantas... Noor ya está grande, no quiere ser tratado como un bebé."
    "可你克制住了……Noor 已经长大了，他不想被当成小孩子对待。"

# game/rutas/labelsact2.rpy:1052
translate chino explorar_unum_act3_a20cefa7:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:1053
translate chino explorar_unum_act3_e1998f9e:

    # "Te recuestas como puedes a su lado. Copias la misma pose que tiene, mirando al cielo con las manos descansando encima del vientre."
    "你尽可能地在他身旁躺下，学着他的姿势，双手搭在肚子上，仰望天空。"

# game/rutas/labelsact2.rpy:1056
translate chino explorar_unum_act3_ca3bf1a7:

    # "Escuchar su respiración te llena de calma, es tan natural que olvidas que a tu lado tienes a un semidios. No es artificial y vacía como la de Unum, tiene pausas que denotan vida, exalaciones que transmiten una canción llena de vida."
    "听着他的呼吸，你心中充满安宁。那声音如此自然，让你忘了身旁躺着一位半神。它不像 Unum 的那样虚假空洞；它有停顿，彰显着生命；它的呼气里带着一首充满生机的歌。"

# game/rutas/labelsact2.rpy:1057
translate chino explorar_unum_act3_450902ba:

    # "La entidad que tienes aquí a tu lado, es más humano que dios. Un niño con sueños y deseos, que pide a gritos ser contenido por un adulto competente."
    "你身边躺着的这位存在，与其说是神，不如说是人。一个怀有梦想与渴望的孩子，大声渴求着一个有能力的成年人的安抚与指引。"

# game/rutas/labelsact2.rpy:1058
translate chino explorar_unum_act3_38434217:

    # "Tú quieres ser aquel quien lo contenga y cuide del resto de este mundo, al menos por el tiempo que le queda para desarrollarse."
    "你想成为那个安抚他、让他远离这个世界其余一切的人，至少，在他还需要成长的时间里。"

# game/rutas/labelsact2.rpy:1059
translate chino explorar_unum_act3_a20cefa7_1:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:1060
translate chino explorar_unum_act3_d057a113:

    # "Pasas el tiempo mirando el cielo, en compañía silenciosa de tu hijo. Disfrutando el momento junto con él."
    "你望着天空消磨时间，在儿子的安静陪伴里。只是和他一起享受这个时刻。"

# game/rutas/labelsact2.rpy:1061
translate chino explorar_unum_act3_e08bd723:

    # "Cuando te percatas de que Noor se ha dormido, te levantas. Le miras por un tiempo antes de decidir si despertarlo o no."
    "当你意识到 Noor 已经睡着，你站起身。在决定是否叫醒他之前，你看了好一会儿。"

# game/rutas/labelsact2.rpy:1064
translate chino explorar_unum_act3_6298a972:

    # "Es mejor dejarle este tiempo para que descanse, se lo merece."
    "还是让他好好休息一阵子吧。他值得。"

# game/rutas/labelsact2.rpy:1069
translate chino explorar_unum_act3_d9c059c1:

    # "Ir a ver lo que Shams está haciendo junto a Ignis no es mala idea, tienes un poco de curiosidad acerca de las habilidades culinaria de la mayor de los gemelos."
    "去看看 Shams 和 Ignis 在做什么，倒也不是个坏主意。你对那对双胞胎中年纪较长的那个的厨艺有点好奇。"

# game/rutas/labelsact2.rpy:1071
translate chino explorar_unum_act3_2e9a7c6e:

    # "No te sorprende ver a tu hija rezongar cuando erra en las notas más altas o difíciles del cantido, pero aun así es divertido de ver."
    "你的女儿每次唱错圣歌中较高或较难的音符时都会嘟囔，你对此并不意外，但看着依然有趣。"

# game/rutas/labelsact2.rpy:1072
translate chino explorar_unum_act3_bddf2de8:

    # "Finge un llanto que pone a Ignis de pelos de punta, haciendo que la mujer que siempre parece tan compuesta, alce la voz y demande orden en la cocina."
    "她假装哭起来，惹得 Ignis 毛骨悚然，让那个总是显得那么沉稳的女人提高声音，要求厨房里保持秩序。"

# game/rutas/labelsact2.rpy:1073
translate chino explorar_unum_act3_32726770:

    # "Le advierte a Shams que si no deja de llorar, no continuará la lección."
    "她警告 Shams，如果再哭个不停，这堂课就没法继续了。"

# game/rutas/labelsact2.rpy:1074
translate chino explorar_unum_act3_bec334e1:

    # "Eso le basta a la chiquilla para cesar todo llanto y enderece la compostura, sin antes pedir perdón."
    "这句话足够让小姑娘止住哭泣、端正姿态，并且先道了歉。"

# game/rutas/labelsact2.rpy:1075
translate chino explorar_unum_act3_349f451d:

    # "Ignis, por lo bajo, se lamenta el parecido que tiene la niña con Unum."
    "Ignis 低声感叹，这孩子和 Unum 真是像得惊人。"

# game/rutas/labelsact2.rpy:1080
translate chino explorar_unum_act3_4c504a0d:

    # "La residencia de las esposas de Unum es totalmente diferente a la de Unum; no hay pinturas que rozan lo grotesco, o habitaciones amuebladas que intenten simular un hogar típico del mundo real."
    "Unum 的妻子们的居所与 Unum 自己的完全不同；这里没有近乎怪诞的画作，也没有试图模仿现实世界中典型家庭的陈设。"

# game/rutas/labelsact2.rpy:1081
translate chino explorar_unum_act3_5d41a8fc:

    # "Todo aquí tiene un propósito. No existen decoraciones para embellecer la casa, ni menos muebles que puedan servir como comodidades para sentarse a descansar o dormir."
    "这里的一切都有其用途。没有用来装点房屋的装饰品，更没有能让人坐下休息或睡觉的舒适家具。"

# game/rutas/labelsact2.rpy:1083
translate chino explorar_unum_act3_00ef646b:

    # "Es chocante como la residencia no presenta nada de lo que debería existir en un hogar. Lo único remotamente humano es la cocina -la cual es una copia de la que tiene Unum- y una mesa para comer."
    "令人震惊的是，这座居所里没有任何一个家本该有的东西。唯一勉强称得上具有人性的，是厨房——那是 Unum 的厨房的复制品——以及一张餐桌。"

# game/rutas/labelsact2.rpy:1085
translate chino explorar_unum_act3_55c644d1:

    # "El resto, es solo espacio muerto, habitaciones vacías o lugares a los cuales físicamente no puedes acceder por falta de suelo."
    "其余的都只是死寂的空间、空荡的房间，或者因为没有地板而你根本无法到达的地方。"

# game/rutas/labelsact2.rpy:1086
translate chino explorar_unum_act3_a20cefa7_2:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:1087
translate chino explorar_unum_act3_3697839c:

    # "Da miedo."
    "令人害怕。"

# game/rutas/labelsact2.rpy:1110
translate chino explorar_nulla_act3_9aa8b63c:

    # "Llevas a Nulla de la mano por la casa, dirigiéndolo a su habitación."
    "你牵着 Nulla 的手穿过房子，领他去他的房间。"

# game/rutas/labelsact2.rpy:1114
translate chino explorar_nulla_act3_3b926bee:

    # "Nulla es quien te abre la puerta, dejando que pases primero con un gesto de su mano."
    "Nulla 替你开了门，用手一示意，让你先进去。"

# game/rutas/labelsact2.rpy:1115
translate chino explorar_nulla_act3_bdbb0a05:

    # "El escritorio está esperándote junto con la hoja en donde has escrito tu pequeño mensaje."
    "书桌正等着你，旁边还有那张写着你的小留言的纸。"

# game/rutas/labelsact2.rpy:1116
translate chino explorar_nulla_act3_2e12685c:

    # "Sin vacilación en tus movimientos, le entregas la hoja a Nulla para que sea él quien lo lea."
    "你毫不犹豫地把纸递给 Nulla，让他来读。"

# game/rutas/labelsact2.rpy:1117
translate chino explorar_nulla_act3_2d9897de:

    # "Nulla se hace el sorprendido. Sospechas que, al menos, se ha aguantado las ganas de no leer el contenido..."
    "Nulla 装出惊讶的样子。你怀疑，至少他一直在强忍着不去看里面的内容……"

# game/rutas/labelsact2.rpy:1121
translate chino explorar_nulla_act3_3c160677:

    # "Nulla lee tu mensaje en voz alta luego de sentarse en su cama."
    "Nulla 在床上坐下后，把你的留言大声读了出来。"

# game/rutas/labelsact2.rpy:1122
translate chino explorar_nulla_act3_a38a6a88:

    # nulla "[mensaje_guardado]"
    nulla "[mensaje_guardado]"

# game/rutas/labelsact2.rpy:1124
translate chino explorar_nulla_act3_a20cefa7:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:1128
translate chino explorar_nulla_act3_409f8636:

    # nulla "..."
    nulla "……"

# game/rutas/labelsact2.rpy:1129
translate chino explorar_nulla_act3_df6a1a43:

    # nulla "[nombrejugador], corazón."
    nulla "[nombrejugador]，我的宝贝。"

# game/rutas/labelsact2.rpy:1133
translate chino explorar_nulla_act3_9e4ed399:

    # nulla "Pfff--"
    nulla "啧——"

# game/rutas/labelsact2.rpy:1134
translate chino explorar_nulla_act3_e26e3116:

    # "Nulla suelta aire, que se traduce en una risa mal formada. Una que intenta contener, asustado de que se malinterprete su intención. Se le ve nervioso, no sabiendo cómo reaccionar."
    "Nulla 呼出一口气，变成一阵别扭的笑。他努力想忍住，怕自己的意图被误解。他看起来很紧张，不知道该怎么反应。"

# game/rutas/labelsact2.rpy:1135
translate chino explorar_nulla_act3_31150a8c:

    # nulla "No puede ser..."
    nulla "不会吧……"

# game/rutas/labelsact2.rpy:1139
translate chino explorar_nulla_act3_758bb293:

    # "Observas como su mandíbula tiembla por unos segundos, al igual que sus manos que sostienen el papel con tu mensaje."
    "你看到他的下颌颤抖了几秒，握着你那张留言的手也一样。"

# game/rutas/labelsact2.rpy:1144
translate chino explorar_nulla_act3_409f8636_1:

    # nulla "..."
    nulla "……"

# game/rutas/labelsact2.rpy:1145
translate chino explorar_nulla_act3_b435dd31:

    # nulla "No, no es eso."
    nulla "不，不是那样的。"

# game/rutas/labelsact2.rpy:1146
translate chino explorar_nulla_act3_021425df:

    # nulla "Claro que me ha gustado..."
    nulla "当然我很喜欢……"

# game/rutas/labelsact2.rpy:1150
translate chino explorar_nulla_act3_1ffccb32:

    # nulla "¡No!--- no pidas perdón."
    nulla "不！——别道歉。"

# game/rutas/labelsact2.rpy:1151
translate chino explorar_nulla_act3_a20cefa7_1:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:1154
translate chino explorar_nulla_act3_a20cefa7_2:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:1156
translate chino explorar_nulla_act3_2224cafa:

    # nulla "Ay---"
    nulla "哎——"

# game/rutas/labelsact2.rpy:1157
translate chino explorar_nulla_act3_da16815b:

    # "Nulla intenta ocultar su cara con la mano, desviando la mirada al suelo."
    "Nulla 试图用手遮住脸，把目光转向地面。"

# game/rutas/labelsact2.rpy:1161
translate chino explorar_nulla_act3_119db949:

    # nulla "No puedo creer que tenga algo escrito por ti, aquí... conmigo."
    nulla "我不敢相信，这里……在我身边，竟然有你亲手写下的东西。"

# game/rutas/labelsact2.rpy:1162
translate chino explorar_nulla_act3_f752bd0f:

    # nulla "Algo que pueda mirar directamente y tocar..."
    nulla "我能直接看着、亲手触摸的东西……"

# game/rutas/labelsact2.rpy:1163
translate chino explorar_nulla_act3_2f4a7528:

    # nulla "Algo que puedo guardar."
    nulla "我能珍藏起来的东西。"

# game/rutas/labelsact2.rpy:1164
translate chino explorar_nulla_act3_ca6c3027:

    # nulla "¿Es mío? ¿Me lo puedo quedar?"
    nulla "它是我的吗？我可以留着它吗？"

# game/rutas/labelsact2.rpy:1180
translate chino explorar_nulla_act3_a6ebd956:

    # "Su rostro se transforma completamente, totalmente ido."
    "他的表情完全变了，整个人像是神游天外。"

# game/rutas/labelsact2.rpy:1181
translate chino explorar_nulla_act3_02ad5cd5:

    # "Solo falta que lo bese... o se lo coma... huh."
    "接下来就差他亲它一口……或者把它吃掉……呵。"

# game/rutas/labelsact2.rpy:1182
translate chino explorar_nulla_act3_9408b4dc:

    # nulla "Lo llevaré conmigo."
    nulla "我会把它带在身边。"

# game/rutas/labelsact2.rpy:1183
translate chino explorar_nulla_act3_f0d57a3b:

    # nulla "A donde sea que vaya."
    nulla "无论我去哪里。"

# game/rutas/labelsact2.rpy:1193
translate chino explorar_nulla_act3_ca74c9b3:

    # "Nulla sonríe."
    "Nulla 笑了。"

# game/rutas/labelsact2.rpy:1194
translate chino explorar_nulla_act3_7e90ee39:

    # nulla "A ver si mi increible [nombrejugador] ha podido crear algo para mí~~~"
    nulla "来看看我了不起的[nombrejugador]有没有为我做出点什么吧~~~"

# game/rutas/labelsact2.rpy:1197
translate chino explorar_nulla_act3_a20cefa7_3:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:1199
translate chino explorar_nulla_act3_171efc54:

    # nulla "Wow."
    nulla "哇。"

# game/rutas/labelsact2.rpy:1201
translate chino explorar_nulla_act3_5cbfdb14:

    # nulla "Woow---"
    nulla "哇——"

# game/rutas/labelsact2.rpy:1204
translate chino explorar_nulla_act3_4cf5c386:

    # nulla "Este es el mejor regalo que alguien me ha hecho."
    nulla "这是别人送给我的最好的礼物。"

# game/rutas/labelsact2.rpy:1205
translate chino explorar_nulla_act3_34a1e044:

    # nulla "{size=*0.6}Ay--- se me va a salir el corazón-{/size}"
    nulla "{size=*0.6}哎——我的心都要从胸口跳出来了——{/size}"

# game/rutas/labelsact2.rpy:1207
translate chino explorar_nulla_act3_ea8a85f3:

    # nulla "Agradece que estás detrás de esa pantalla---"
    nulla "你得感谢你正隔着那层屏幕——"

# game/rutas/labelsact2.rpy:1208
translate chino explorar_nulla_act3_319e7881:

    # nulla "Porque si no fuera por eso---"
    nulla "因为要不是那样的话——"

# game/rutas/labelsact2.rpy:1217
translate chino explorar_nulla_act3_383b7bce:

    # "Comienzas a sentir una presión ajena en la parte de tu cuerpo inferior. Miras con urgencia hacia abajo, pensando en la posibilidad de que tu cuerpo ya esté cediendo al uso prolongado y esté comenzando a fallar."
    "你开始感到下身有一种陌生的压迫感。你急切地低头，担心自己的身体终于因为长时间的使用而开始衰竭。"

# game/rutas/labelsact2.rpy:1218
translate chino explorar_nulla_act3_050cfa77:

    # "Mas solo te encuentras con 4 apéndices formados por las sombras de Nulla. Se enroscan y contorsionan en tus piernas y cintura, imposibilitando una posible huida."
    "但你只看到四根由 Nulla 的阴影凝成的附肢。它们盘绕扭曲在你的双腿与腰际，让任何逃脱的尝试都变得不可能。"

# game/rutas/labelsact2.rpy:1221
translate chino explorar_nulla_act3_989371ed:

    # "Se lo dices antes de que esas cosas te atrapen la boca."
    "在那些东西堵住你的嘴之前，你对他开了口。"

# game/rutas/labelsact2.rpy:1222
translate chino explorar_nulla_act3_175133bf:

    # nulla "¿Hmm?"
    nulla "嗯？"

# game/rutas/labelsact2.rpy:1225
translate chino explorar_nulla_act3_1e865a3a:

    # "Te devuelve la mirada confundido. Y tú no tienes más opción que agitar tu cuerpo para que él lo note."
    "他困惑地回头看你。而你别无选择，只能挣扎着挪动身体，好让他注意到。"

# game/rutas/labelsact2.rpy:1230
translate chino explorar_nulla_act3_f3200e52:

    # "Los apéndices se deslizan por tu cuerpo, subiendo hasta tu cuello. Envolviéndose entre si, bifurcando su camino con cada toque con otro apéndice."
    "附肢贴着你的身体滑动，一路爬到你的脖颈。它们彼此缠绕，每当碰到另一根附肢，就分叉向不同的方向。"

# game/rutas/labelsact2.rpy:1231
translate chino explorar_nulla_act3_002b2e36:

    # "Con cada segundo pasado, las ramificaciones contraen la piel debajo de tus ropas, llegando a un punto en que sientes como la sangre bombea por tus venas."
    "每一秒过去，那些分支都在收紧你衣料下的皮肤，直到你能感觉到血液在血管里搏动。"

# game/rutas/labelsact2.rpy:1232
translate chino explorar_nulla_act3_90f188e7:

    # nulla "Quiero tenerte."
    nulla "我想要你。"

# game/rutas/labelsact2.rpy:1233
translate chino explorar_nulla_act3_e5f203e6:

    # nulla "Te quiero todo para mí."
    nulla "我想让你完全属于我。"

# game/rutas/labelsact2.rpy:1234
translate chino explorar_nulla_act3_3ac3a73c:

    # nulla "Quiero ser tuyo."
    nulla "我想成为你的。"

# game/rutas/labelsact2.rpy:1235
translate chino explorar_nulla_act3_5ea297d9:

    # "Los apéndices se contraen más en tu cuerpo, como si intentaran perforar la piel y escurrirse dentro de tu carne. Contaminar todo tu sistema con ese negro antinatural que rodea a Nulla."
    "附肢在你身体上收得更紧，仿佛要刺穿皮肤、钻进你的血肉，把你整个系统都染上那环绕着 Nulla 的、不自然的漆黑。"

# game/rutas/labelsact2.rpy:1237
translate chino explorar_nulla_act3_5d7e0601:

    # nulla "Podría engullir a la marioneta y mandar todo a la mierda."
    nulla "我可以把这只傀儡整个吞下去，然后把一切都他娘的不管了。"

# game/rutas/labelsact2.rpy:1238
translate chino explorar_nulla_act3_dfbc3987:

    # "Eso es todo lo que falta para que Nulla decida por fin moverse y tirarse hacia ti. Ambas manos toman tus mejillas para facilitar un feroz beso."
    "只差这一步，Nulla 终于决定动起来，扑向你。他用双手捧住你的脸颊，把你拉进一个激烈的吻里。"

# game/rutas/labelsact2.rpy:1239
translate chino explorar_nulla_act3_0745b9f2:

    # "No te deja respirar, es demandante e intenso, desesperado por un contacto que dificilmente puede llamarse tierno."
    "他不让你呼吸。他索取、炽烈，渴望一种几乎无法称之为温柔的接触。"

# game/rutas/labelsact2.rpy:1240
translate chino explorar_nulla_act3_409f8636_2:

    # nulla "..."
    nulla "……"

# game/rutas/labelsact2.rpy:1241
translate chino explorar_nulla_act3_1116b86d:

    # "Cuando finalmente Nulla decide separar su boca de la tuya, encuentra refugio en tu cuello. Respira hondo, intentando calmarse."
    "当 Nulla 终于决定将嘴唇从你唇上移开时，他把脸埋进你的颈间寻求庇护，深深地吸了一口气，试图让自己平静下来。"

# game/rutas/labelsact2.rpy:1242
translate chino explorar_nulla_act3_ffefae5c:

    # nulla "Gracias---"
    nulla "谢谢——"

# game/rutas/labelsact2.rpy:1243
translate chino explorar_nulla_act3_960a0c01:

    # nulla "No sabes lo feliz que me hace ver que has editado parte del juego por mí."
    nulla "你不知道，看到你为我修改了游戏的一部分，我有多高兴。"

# game/rutas/labelsact2.rpy:1247
translate chino explorar_nulla_act3_a20cefa7_4:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:1248
translate chino explorar_nulla_act3_5efd5e4d:

    # "La presión llega a doler, pero te aguantas."
    "压力变得疼痛，但你忍了下来。"

# game/rutas/labelsact2.rpy:1249
translate chino explorar_nulla_act3_d1ddaffa:

    # "........"
    "……"

# game/rutas/labelsact2.rpy:1250
translate chino explorar_nulla_act3_401414d1:

    # "Duele."
    "疼。"

# game/rutas/labelsact2.rpy:1255
translate chino explorar_nulla_act3_94e3cd57:

    # "Nulla mira abajo, notando cómo sus sombras aún siguen estrujando tus extremidades, peligrando con cortar la circulación de estas mismas."
    "Nulla 低头看去，注意到自己的阴影仍在挤压着你的四肢，快要切断它们的血液循环。"

# game/rutas/labelsact2.rpy:1256
translate chino explorar_nulla_act3_06fb3ab6:

    # nulla "¡Oh!"
    nulla "哦！"

# game/rutas/labelsact2.rpy:1257
translate chino explorar_nulla_act3_cbba5b82:

    # nulla "Lo siento."
    nulla "对不起。"

# game/rutas/labelsact2.rpy:1258
translate chino explorar_nulla_act3_fa7d3198:

    # nulla "Me emocioné de más. Ja ja ja."
    nulla "我有点太激动了。哈哈。"

# game/rutas/labelsact2.rpy:1265
translate chino explorar_nulla_act3_c0622113:

    # "Van afuera. Todo lo que recubre el supuesto jardín de su casa es una negrura que se extiende por todo tu campo de visión. No tienes idea de cuanto sea la magnitud de extensión del vacío, y eso te causa mucha curiosidad."
    "走到外面。笼罩着他家那所谓花园的，是一片延伸至你整个视野的漆黑。你不知道这虚空延伸得有多远，这让你无比好奇。"

# game/rutas/labelsact2.rpy:1266
translate chino explorar_nulla_act3_9e89c3e5:

    # "Nulla se sienta en los escalones y espera en silencio."
    "Nulla 坐在台阶上，安静地等着。"

# game/rutas/labelsact2.rpy:1271
translate chino explorar_nulla_act3_09950f6c:

    # "Optas por quedarte de pie. Al final, sigues estando a su lado, y verlo desde arriba no está tan mal."
    "你选择继续站着。毕竟，你仍在他身边，从上方俯视他也不算太糟。"

# game/rutas/labelsact2.rpy:1272
translate chino explorar_nulla_act3_020b23be:

    # "Se ve tierno. Pequeño."
    "他看起来很可爱。小小的。"

# game/rutas/labelsact2.rpy:1277
translate chino explorar_nulla_act3_a2c6ae4c:

    # nulla "Si no te tuviera a mi lado ahora."
    nulla "如果我现在没有你在身边的话。"

# game/rutas/labelsact2.rpy:1278
translate chino explorar_nulla_act3_807842a9:

    # nulla "Si no te hubiera conocido---"
    nulla "如果我从未遇见你——"

# game/rutas/labelsact2.rpy:1279
translate chino explorar_nulla_act3_bbdfd5e6:

    # nulla "Seguiría sentado aquí, mirando el vacío."
    nulla "我还会坐在这里，凝视虚空。"

# game/rutas/labelsact2.rpy:1280
translate chino explorar_nulla_act3_c5060449:

    # "Sus ojos yacen pegados al horizonte, enfocado en algo que no comprendes del todo aún."
    "他的目光死死钉在地平线上，聚焦于某个你尚不能完全理解的事物。"

# game/rutas/labelsact2.rpy:1285
translate chino explorar_nulla_act3_079e2856:

    # nulla "¿Conoces la ciudad de Valparaíso?"
    nulla "你知道瓦尔帕莱索这座城市吗？"

# game/rutas/labelsact2.rpy:1291
translate chino explorar_nulla_act3_38d1d143:

    # nulla "Ja, supongo que no es muy conocido."
    nulla "哈，我想它并不太出名。"

# game/rutas/labelsact2.rpy:1296
translate chino explorar_nulla_act3_76c1bb44:

    # nulla "Viví ahí."
    nulla "我曾经住在那里。"

# game/rutas/labelsact2.rpy:1297
translate chino explorar_nulla_act3_fc4cd82b:

    # nulla "Hay veces en que me gustaría estar ahí por mí mismo."
    nulla "有些时候，我多希望自己能亲身在那里。"

# game/rutas/labelsact2.rpy:1298
translate chino explorar_nulla_act3_e7bd9d2b:

    # nulla "Oler y escuchar el mar. Caminar por esas calles empinadas. No sé, experimentar realmente la ciudad."
    nulla "闻一闻海的味道，听一听海浪。走过那些陡峭的街道……我不知道，真正地去体验那座城市。"

# game/rutas/labelsact2.rpy:1299
translate chino explorar_nulla_act3_feaf0db8:

    # nulla "A mi yo del pasado no le gustaba tanto."
    nulla "过去的那个我，并不那么喜欢那里。"

# game/rutas/labelsact2.rpy:1304
translate chino explorar_nulla_act3_409f8636_3:

    # nulla "..."
    nulla "……"

# game/rutas/labelsact2.rpy:1305
translate chino explorar_nulla_act3_c6d06276:

    # "Medita por un momento antes de suspirar decepcionado."
    "他沉吟片刻，然后失望地叹了口气。"

# game/rutas/labelsact2.rpy:1310
translate chino explorar_nulla_act3_a41a28ed:

    # nulla "Supongo que es cuestión de gustos y uno sueña con lo que no puede tener."
    nulla "我想这就是品味的问题，人总会梦想着自己得不到的东西。"

# game/rutas/labelsact2.rpy:1311
translate chino explorar_nulla_act3_df8a019b:

    # "Nulla te comenta de memorias maltrechas por el tiempo, hay lagunas en sus historias, las cuales no puede rememorar."
    "Nulla 跟你说起那些被时间磨损的记忆，他的故事里有一些空白，是他已经想不起来的。"

# game/rutas/labelsact2.rpy:1312
translate chino explorar_nulla_act3_7c44e213:

    # "Termina por evitar contar más memorias, frustrado con la dificultad de traer recuerdos no vividos."
    "他最终不再继续讲述那些记忆，因为要想起自己从未经历过的事情实在太难，令他沮丧。"

# game/rutas/labelsact2.rpy:1321
translate chino explorar_nulla_act3_552f687f:

    # nulla "Cualquier cosa que me deje estar mirando tus ojos."
    nulla "任何能让我继续望着你双眼的事。"

# game/rutas/labelsact2.rpy:1322
translate chino explorar_nulla_act3_797d721f:

    # "Le ofreces platicar y él acepta."
    "你提议聊聊天，他答应了。"

# game/rutas/labelsact2.rpy:1323
translate chino explorar_nulla_act3_72896fe2:

    # "Pasan un buen rato hablando de pequeñeces y temas que sirven para matar el tiempo. Aun así, no es tiempo perdido, pues Nulla se asegura de no perder tu atención."
    "你们聊了很久，说的都是些琐碎小事和用来打发时间的话题。即便如此，这也不算白费时间，因为 Nulla 确保着你的注意力始终在他这里。"

# game/rutas/labelsact2.rpy:1327
translate chino explorar_nulla_act3_5f9b772e:

    # "...."
    "……"

# game/rutas/labelsact2.rpy:1334
translate chino septemgana_n_act3_588777c5:

    # "Vas directo a donde se encuentra la vela, no lo dudas mucho. Sabes qué significa esa vela, ya has visto lo que puede hacer cuando estuviste con Septem en su momento..."
    "你径直走向那根蜡烛，几乎没有犹豫。你知道那根蜡烛意味着什么——你早在和 Septem 在一起时，就已经见识过它能做什么……"

# game/rutas/labelsact2.rpy:1335
translate chino septemgana_n_act3_c59323f9:

    # "Esto es traición, lo sabes."
    "这是背叛，你很清楚。"

# game/rutas/labelsact2.rpy:1336
translate chino septemgana_n_act3_261d3599:

    # "Y sabes que Nulla sabe."
    "而且你知道，Nulla 也知道。"

# game/rutas/labelsact2.rpy:1337
translate chino septemgana_n_act3_aa1c761e:

    # centered "{glitch=30.0}{color=ffffff}{size=*4.0}¡[nombrejugador]!{/size}{/color}"
    centered "{glitch=30.0}{color=ffffff}{size=*4.0}！[nombrejugador]！{/size}{/color}"

# game/rutas/labelsact2.rpy:1338
translate chino septemgana_n_act3_f982b127:

    # "Ignoras sus gritos."
    "你无视他的尖叫。"

# game/rutas/labelsact2.rpy:1339
translate chino septemgana_n_act3_458539a9:

    # "Ignoras sus comandos. Tanto piernas como brazos buscan tomar el control de sus deseos; evitar que no llegues, que no la toques. Pero eso no lo vas a permitir."
    "你无视他的命令。你的双腿和双臂都在试图服从他的意愿，阻止你够到那根蜡烛，阻止你触碰它。但你不会允许这种事发生。"

# game/rutas/labelsact2.rpy:1342
translate chino septemgana_n_act3_0b03776d:

    # "Septem no lo permite."
    "Septem 不允许。"

# game/rutas/labelsact2.rpy:1346
translate chino septemgana_n_act3_5c0ef35f:

    # septem "Te lo dije."
    septem "我告诉过你了。"

# game/rutas/labelsact2.rpy:1347
translate chino septemgana_n_act3_00d0216f:

    # septem "Haré que te quedes conmigo el final."
    septem "我会确保你最终留在我身边。"

# game/rutas/labelsact2.rpy:1350
translate chino septemgana_n_act3_cf356954:

    # "Teniendo más libertad en tus movimientos gracias a la intervención de Septem, corres hacia la vela. Rompes el cristal que la protege, no importa cuanto tus manos sangren, tu objetivo es tomar la vela."
    "得益于 Septem 的介入，你的动作更自由了。你朝那根蜡烛跑去，砸碎保护它的玻璃。不管双手流多少血，你的目标都是拿到那根蜡烛。"

# game/rutas/labelsact2.rpy:1351
translate chino septemgana_n_act3_5a88016e:

    # "Cuando por fin la tienes entre tus dedos, la cera se filtra por tus heridas, creando carne divina desde el ardiente dolor."
    "当你终于把它握在指间，蜡液渗进你的伤口，在灼烧的痛楚中生出神圣的血肉。"

# game/rutas/labelsact2.rpy:1353
translate chino septemgana_n_act3_cac6a78c:

    # "Espirales blanquecinos toman posesión de tu cuerpo, volviendo todo estímulo confuso. Ya no ves, no sientes y a penas escuchas. Escuchas sus gritos pero no puedes hacer nada."
    "惨白的螺旋占据了你的身体，让所有感觉都变得混乱。你再也看不见，感觉不到，也几乎听不见。你听见他的尖叫，却无能为力。"

# game/rutas/labelsact2.rpy:1354
translate chino septemgana_n_act3_0cc67d49:

    # "Pronto, los gritos de Nulla se mezclan con el ruido blanco del lugar en que te encuentras. Él maldice, llora y grita por ti."
    "很快，Nulla 的哭喊与你所处之地的白噪声融为一体。他咒骂着、哭泣着，呼唤着你。"

# game/rutas/labelsact2.rpy:1356
translate chino septemgana_n_act3_c203bf9d:

    # "Te pide que vuelvas, pero tú ya no te encuentras en ese lugar."
    "他恳求你回来，但你已不再那个地方。"

# game/rutas/labelsact2.rpy:1357
translate chino septemgana_n_act3_3803780f:

    # "Hasta que no lo escuchas más."
    "直到你再也听不见他。"

# game/rutas/labelsact2.rpy:1358
translate chino septemgana_n_act3_a20cefa7:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:1359
translate chino septemgana_n_act3_a604ebc5:

    # "Tienes la sensación de que tu mano es apretada por otra de mayor tamaño. Al mirar, te das cuenta de que no tienes un cuerpo como tal."
    "你觉得自己的手正被一只更大的手握住。当你看去，才意识到自己已经没有像样的身体了。"

# game/rutas/labelsact2.rpy:1360
translate chino septemgana_n_act3_35d889b2:

    # "Eres algo más. Eres un todo, intangible y hermoso."
    "你成了某种更非凡的东西。你是一个整体，无形，而美丽。"

# game/rutas/labelsact2.rpy:1361
translate chino septemgana_n_act3_014d4c32:

    # septem "Por fin te tengo."
    septem "我终于拥有你了。"

# game/rutas/labelsact2.rpy:1362
translate chino septemgana_n_act3_ea812564:

    # septem "No fue fácil llegar a ti."
    septem "到你身边并不容易。"

# game/rutas/labelsact2.rpy:1363
translate chino septemgana_n_act3_0456a1c8:

    # "Sientes la presencia de Septem a tu lado... dentro y sobre de ti. Su alma rodea la tuya, la abraza y mece mientras te lleva por un flujo de energía que aún no puedes comprender."
    "你感到 Septem 就在你身旁……在你体内，也在你上方。他的灵魂环绕着你的，拥抱着、轻摇着它，带着你穿过一股你仍无法理解的能量之流。"

# game/rutas/labelsact2.rpy:1364
translate chino septemgana_n_act3_99ad0fe3:

    # "El calor que transmite te calma. El alma de Septem tiene un efecto embriagador, evitando que pienses en demasiadas cosas a la vez, eliminando todo dato o persona que te ha hecho algún mal."
    "他传递的暖意让你平静下来。Septem 的灵魂有一种醉人的效果，让你无法同时思考太多事情，抹去每一个曾伤害过你的记忆或那个人。"

# game/rutas/labelsact2.rpy:1365
translate chino septemgana_n_act3_af05cdff:

    # "Y junto a ello, borrando al dueño del vacío de tu alma proyectada en este plano."
    "与此同时，也将那虚空的主人从你投射在此岸的灵魂中抹去。"

# game/rutas/labelsact2.rpy:1366
translate chino septemgana_n_act3_f5e91222:

    # "Septem ríe."
    "Septem 笑了。"

# game/rutas/labelsact2.rpy:1367
translate chino septemgana_n_act3_edf78f59:

    # septem "Podríamos quedarnos así."
    septem "我们可以就这样待着。"

# game/rutas/labelsact2.rpy:1368
translate chino septemgana_n_act3_0576c613:

    # septem "Hasta que decidas volver conmigo por tu cuenta."
    septem "直到你决定自愿回到我身边。"

# game/rutas/labelsact2.rpy:1369
translate chino septemgana_n_act3_5914044b:

    # septem "Mientras... nos quedaremos aquí."
    septem "在此期间……我们会留在这里。"

# game/rutas/labelsact2.rpy:1372
translate chino septemgana_n_act3_049b0a35:

    # centered "{sc=3}{b}BAD END: Reminiscencias.{/b}{/sc}"
    centered "{sc=3}{b}BAD END：往事。{/b}{/sc}"

# game/rutas/labelsact2.rpy:1379
translate chino septemgana2_n_act3_352e921b:

    # "Septem aprovecha de esos segundos de desconcierto. Una de sus manos consigue liberarse del agarre de Nulla y alcanza el cuchillo que está entre tus manos."
    "Septem 趁着那几秒钟的混乱。他的一只手设法从 Nulla 的钳制中挣脱出来，探向你手中握着的刀。"

# game/rutas/labelsact2.rpy:1381
translate chino septemgana2_n_act3_cbfdb97e:

    # "Antes de que puedas reaccionar, o siquiera pestañear, sus dedos se cierran alrededor del mango. Forcejea contigo, tirando del arma con una fuerza descomunal."
    "你还没来得及反应，甚至没眨一下眼，他的手指已经扣住了刀柄。他与你角力，用惊人的力量争夺那把武器。"

# game/rutas/labelsact2.rpy:1382
translate chino septemgana2_n_act3_12e19274:

    # "De la nada, un destello de luz te deja ciego y confundido. Justo el tiempo suficiente para que Septem te arrebate el cuchillo de las manos."
    "毫无征兆地，一道闪光让你目眩神迷、头晕目眩。就在这段时间里，Septem 从你手中夺走了刀。"

# game/rutas/labelsact2.rpy:1390
translate chino septemgana2_n_act3_8921bc6d:

    # "Septem te clava el cuchillo sin piedad en el pecho."
    "Septem 毫不留情地将刀刺入你的胸膛。"

# game/rutas/labelsact2.rpy:1391
translate chino septemgana2_n_act3_df984731:

    # "Hundiendo la hoja en tu carne, haciéndose paso entre tus costillas."
    "刀刃深深没入你的血肉，硬生生挤进肋骨之间。"

# game/rutas/labelsact2.rpy:1392
translate chino septemgana2_n_act3_ee674bc9:

    # "Una vez."
    "一次。"

# game/rutas/labelsact2.rpy:1393
translate chino septemgana2_n_act3_0b920c5c:

    # "Otra."
    "再来。"

# game/rutas/labelsact2.rpy:1394
translate chino septemgana2_n_act3_6b9488e1:

    # "Y otra más."
    "还有一次。"

# game/rutas/labelsact2.rpy:1395
translate chino septemgana2_n_act3_d69ffd8f:

    # "No se detiene. Cada puñalada viene con rabia. Odio."
    "他没有停下。每一刀都饱含着愤怒。与恨。"

# game/rutas/labelsact2.rpy:1396
translate chino septemgana2_n_act3_e774433b:

    # "Perece disbrutar de ver como el rojo tiñe su mano y tu pecho."
    "他似乎在欣赏那红色染红他的手与你的胸膛。"

# game/rutas/labelsact2.rpy:1398
translate chino septemgana2_n_act3_81183d59:

    # centered "{sc=3}{b}BAD END: Muy lento~{/b}{/sc}"
    centered "{sc=3}{b}BAD END：太慢了～{/b}{/sc}"

# game/rutas/labelsact2.rpy:1402
translate chino septemgana2_n_act3_cba45555:

    # "Algo parece poseer a Septem. Agarra a Nulla de la cara, buscando con sus dedos sus ojos... intenta clavarlos ahí."
    "某种东西似乎附了 Septem 的身。他抓住 Nulla 的脸，手指摸索着他的双眼……试图把它们抠出来。"

# game/rutas/labelsact2.rpy:1403
translate chino septemgana2_n_act3_49d8af6e:

    # "Las sombras de Nulla se precipitan a retener al rubio, sin embargo, es inútil... Algo impide que puedan tocarlo. Una fuerza invisible protege a Septem."
    "Nulla 的阴影急忙涌上前去制住那个金发男人，然而毫无用处……有什么东西阻止它们触碰他。一股无形的力量保护着 Septem。"

# game/rutas/labelsact2.rpy:1406
translate chino septemgana2_n_act3_d5d233a3:

    # "Un crujido recorre el piso."
    "一阵碎裂声沿着地面传来。"

# game/rutas/labelsact2.rpy:1407
translate chino septemgana2_n_act3_e4875227:

    # "Bajo de los pies de ambos, el suelo se resquebraja, formando grietas profundas y muy brillantes."
    "两人脚下的地面崩裂开来，形成一道道深邃而耀眼发光的裂缝。"

# game/rutas/labelsact2.rpy:1408
translate chino septemgana2_n_act3_457d0d9d:

    # "De ellas nacen apéndices pálidos que reptan rápidamente por el suelo en dirección a Nulla."
    "从裂缝中生出苍白的附肢，贴着地面迅速爬向 Nulla。"

# game/rutas/labelsact2.rpy:1409
translate chino septemgana2_n_act3_6cad9ac1:

    # "Él a penas tiene tiempo de reaccionar, tomándolo por sorpresa cuando esas masas de luz toman captura de sus extremidades. Suspendiéndolo en el aire."
    "当那些光团抓住他的四肢时，他猝不及防，几乎来不及反应，整个人被悬在半空。"

# game/rutas/labelsact2.rpy:1410
translate chino septemgana2_n_act3_0aaf5ac5:

    # "Septem se incorpora lentamente, tranquillo, ya sabiendo que Nulla está a su merced."
    "Septem 缓缓站起身，气定神闲，早已知道 Nulla 已在他掌控之中。"

# game/rutas/labelsact2.rpy:1411
translate chino septemgana2_n_act3_e7428634:

    # "Escupe un poco de sangre al suelo, mira con atención como el liquido se esparce por el piso, intrigado."
    "他往地上吐出一口血，饶有兴致地注视着那液体在地面蔓延开来。"

# game/rutas/labelsact2.rpy:1412
translate chino septemgana2_n_act3_d30d2fa2:

    # "Luego, con fastidio busca a Nulla con la mirada."
    "然后，他烦躁地用目光搜寻着 Nulla。"

# game/rutas/labelsact2.rpy:1413
translate chino septemgana2_n_act3_7199e454:

    # "Los apéndices se convierten en garras que tiran de las manos y piernas de Nulla. Rompiendo su cuerpo de manera lenta y tortuosa. Septem no le presta atención, en cambio, decide acercarse a ti, bloqueando tu vista con su cuerpo."
    "附肢化作利爪，拉扯着 Nulla 的手脚，缓慢而残忍地撕裂他的身体。Septem 毫不理会，反而选择向你走来，用身体挡住你的视线。"

# game/rutas/labelsact2.rpy:1415
translate chino septemgana2_n_act3_21aaed68:

    # septem "Con que aquí te vas cuando no estás conmigo."
    septem "原来我不在你身边的时候，你就跑到这里来。"

# game/rutas/labelsact2.rpy:1416
translate chino septemgana2_n_act3_bd6b90bc:

    # septem "Eres morboso."
    septem "你真是病态。"

# game/rutas/labelsact2.rpy:1417
translate chino septemgana2_n_act3_348c7378:

    # "Escuchas los quejidos de Nulla, quien te llama... su voz, que habitualmente va cargada con seguridad, se ve reducida a solo un grito roto."
    "你听见 Nulla 的呻吟，他在呼唤你……他那惯常充满自信的声音，如今只剩下破碎的嘶喊。"

# game/rutas/labelsact2.rpy:1418
translate chino septemgana2_n_act3_532c97dd:

    # "Entre sus quejidos, detectas otro sonido, uno humedo y espantoso."
    "在他的呻吟中，你辨出了另一个声音，湿润而骇人。"

# game/rutas/labelsact2.rpy:1419
translate chino septemgana2_n_act3_aaa403be:

    # "Luego de eso, los quejidos cesan."
    "随后，那些呻吟停止了。"

# game/rutas/labelsact2.rpy:1420
translate chino septemgana2_n_act3_b04ec6fe:

    # septem "Eso lo mantendrá callado por un tiempo."
    septem "这能让他安静一阵子。"

# game/rutas/labelsact2.rpy:1421
translate chino septemgana2_n_act3_a1540d72:

    # "Septem no se molesta confirmar que es lo que ha pasado con Nulla."
    "Septem 懒得去确认 Nulla 究竟发生了什么。"

# game/rutas/labelsact2.rpy:1422
translate chino septemgana2_n_act3_4f10c5ba:

    # septem "Ahora---"
    septem "现在——"

# game/rutas/labelsact2.rpy:1423
translate chino septemgana2_n_act3_0897e3bf:

    # septem "Has sido tan bueno--- dejándome ver esta línea temporal."
    septem "你表现得这么好——让我看到这条时间线。"

# game/rutas/labelsact2.rpy:1424
translate chino septemgana2_n_act3_126ec5c5:

    # septem "Eligiéndome a mí al final. Después de todo el trabajo que has hecho."
    septem "在做了那么多之后，最终选择了我。"

# game/rutas/labelsact2.rpy:1426
translate chino septemgana2_n_act3_5ee45a3d:

    # septem "Pero no te voy a perdonar el desastre que has causado al Jardín."
    septem "但我不会原谅你对花园造成的破坏。"

# game/rutas/labelsact2.rpy:1427
translate chino septemgana2_n_act3_5cdca032:

    # septem "Estarás a mi merced hasta que decida que puedes tener más libertades."
    septem "在我决定给予你更多自由之前，你都将任由我摆布。"

# game/rutas/labelsact2.rpy:1429
translate chino septemgana2_n_act3_d6f9eab1:

    # "Septem te observa durante un largo tiempo. Al estar satisfecho con tu reacción, una pequeña sonrisa aparece en sus labios."
    "Septem 长久地注视着你。在对你反应感到满意之后，他的唇边浮起一丝浅笑。"

# game/rutas/labelsact2.rpy:1430
translate chino septemgana2_n_act3_0085d712:

    # septem "Voy a tomarme mi tiempo para domesticarte."
    septem "我会花时间好好驯服你。"

# game/rutas/labelsact2.rpy:1431
translate chino septemgana2_n_act3_9bec7340:

    # septem "No me molesta."
    septem "我不介意。"

# game/rutas/labelsact2.rpy:1432
translate chino septemgana2_n_act3_f6f1137b:

    # septem "Ni en lo más mínimo."
    septem "一点也不。"

# game/rutas/labelsact2.rpy:1434
translate chino septemgana2_n_act3_3d127a6b:

    # centered "{sc=3}{b}BAD END: Si tuvieras que elegir{/b}{/sc}"
    centered "{sc=3}{b}BAD END：如果你必须做出选择{/b}{/sc}"

# game/rutas/labelsact2.rpy:1448
translate chino act3_s_badendnulla_07bdde05:

    # "....."
    "……"

# game/rutas/labelsact2.rpy:1450
translate chino act3_s_badendnulla_d1ddaffa:

    # "........"
    "……"

# game/rutas/labelsact2.rpy:1451
translate chino act3_s_badendnulla_f93a6c2f:

    # centered "Vamos mi vida, tóca el botón~"
    centered "来吧，我的爱人，按下按钮~"

# game/rutas/labelsact2.rpy:1452
translate chino act3_s_badendnulla_99fd4a43:

    # centered "Te esto esperando~"
    centered "我正等着你~"

# game/rutas/labelsact2.rpy:1459
translate chino act3_s_badendnulla_14cbeb85:

    # "Respirar se te hace cada vez más difícil."
    "呼吸变得越来越困难。"

# game/rutas/labelsact2.rpy:1460
translate chino act3_s_badendnulla_f0898928:

    # "Los tentáculos se fusionan contigo, tapando tus vias respiratorias. Buscan cercanía, buscan contacto, y lo toman con fuerza, sin cuidado."
    "触须与你的躯体融合，堵住你的气道。它们寻求靠近，寻求接触，并且不由分说地强行夺取。"

# game/rutas/labelsact2.rpy:1461
translate chino act3_s_badendnulla_5858f125:

    # "Pronto, pierdes la consciencia."
    "很快，你失去了意识。"

# game/rutas/labelsact2.rpy:1462
translate chino act3_s_badendnulla_0b0f0ad2:

    # centered "{sc=3}{b}BAD END: Aún no estás listo.{/b}{/sc}"
    centered "{sc=3}{b}BAD END：你尚未准备好。{/b}{/sc}"

