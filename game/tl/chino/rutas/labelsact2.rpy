    new "你看起来糟透了。"

    # game/rutas/labelsact2.rpy:6
    old "Acerca de Madre"
    new "关于母亲"

    # game/rutas/labelsact2.rpy:6
    old "Despedirse."
    new "告别。"

    # game/rutas/labelsact2.rpy:11
    old "¿Pudrir?"
    new "腐烂？"

    # game/rutas/labelsact2.rpy:11
    old "¿Hay algo que yo pueda hacer?"
    new "我有什么能帮忙的吗？"

    # game/rutas/labelsact2.rpy:45
    old "No."
    new "不。"

    # game/rutas/labelsact2.rpy:63
    old "Decirle a Septem que pare."
    new "叫 Septem 停下。"

    # game/rutas/labelsact2.rpy:63
    old "Dejar que Septem la rompa"
