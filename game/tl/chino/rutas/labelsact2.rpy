    new "什么都不写。"

    # game/rutas/labelsact2.rpy:289
    old "¿Qué quieres escribir?"
    new "你想写什么？"

    # game/rutas/labelsact2.rpy:369
    old "Ir con los niños"
    new "跟孩子们一起去"

    # game/rutas/labelsact2.rpy:369
    old "Ir a la residencia de las esposas de Unum"
    new "去 Unum 妻妾们的住处"

    # game/rutas/labelsact2.rpy:369
    old "Mirar las pinturas"
    new "看那些画"

