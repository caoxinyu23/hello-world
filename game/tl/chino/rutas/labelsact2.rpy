# TODO: Translation updated at 2025-02-22 21:37

# game/rutas/labelsact2.rpy:9
translate chino menupreguntas_septem2_c1c9c24b:

    # septem "That wouldn't be a problem if I could find the solution quickly."
    septem "要是我能快点找到解决办法，就不会有问题了。"

# game/rutas/labelsact2.rpy:10
translate chino menupreguntas_septem2_4b54c932:

    # septem "The more days pass, the more your puppet will rot."
    septem "日子一天天过去，你的傀儡只会越来越腐朽。"

# game/rutas/labelsact2.rpy:14
translate chino menupreguntas_septem2_90b1fb22:

    # septem "The more you use it, the more you drain your life source."
    septem "你用得越多，就越是透支自己的生命之源。"

# game/rutas/labelsact2.rpy:15
translate chino menupreguntas_septem2_6db77f17:

    # septem "You never release the puppet to let it recover."
    septem "你从不放开傀儡，让它恢复。"

# game/rutas/labelsact2.rpy:17
translate chino menupreguntas_septem2_495275bf:

    # septem "Even when your puppet sleeps, you're still connected to it."
    septem "即便傀儡入睡，你依然与它相连。"

# game/rutas/labelsact2.rpy:18
translate chino menupreguntas_septem2_c600211f:

    # septem "Making its time of usefulness pass faster."
    septem "让它的可用时间加速流逝。"

# game/rutas/labelsact2.rpy:22
translate chino menupreguntas_septem2_e87c5670:

    # septem "No."
    septem "不。"

# game/rutas/labelsact2.rpy:24
translate chino menupreguntas_septem2_923e1103:

    # septem "That's why I need to find another solution for the transfusion."
    septem "所以我必须找到另一种输注的方法。"

# game/rutas/labelsact2.rpy:25
translate chino menupreguntas_septem2_b9d24673:

    # septem "If I don't... we'll be condemned."
    septem "要是我做不到……我们都会被定罪。"

# game/rutas/labelsact2.rpy:26
translate chino menupreguntas_septem2_203a5dc3:

    # septem "And you'll be forced to abandon the 'game.'"
    septem "而你将被迫放弃这场『游戏』。"

# game/rutas/labelsact2.rpy:27
translate chino menupreguntas_septem2_c40a08b2:

    # septem "Since the puppet will die."
    septem "因为傀儡会死。"

# game/rutas/labelsact2.rpy:30
translate chino menupreguntas_septem2_31924e0f:

    # septem "..."
    septem "……"

# game/rutas/labelsact2.rpy:31
translate chino menupreguntas_septem2_c23193bc:

    # "Septem takes off the garment covering part of his wrist and arm... for some strange reason, it feels illegal to see that."
    "Septem 脱下遮盖他手腕和手臂的衣物……不知为何，看到这一幕竟让人有种违法感。"

# game/rutas/labelsact2.rpy:32
translate chino menupreguntas_septem2_5b5a3ac5:

    # "His arm is also being consumed by the black color that once only adorned his fingers."
    "他的手臂也正被那曾经只点缀在他指尖的黑色所吞噬。"

# game/rutas/labelsact2.rpy:33
translate chino menupreguntas_septem2_b4090d88:

    # septem "We're in the same condition..."
    septem "我们的处境完全相同……"

# game/rutas/labelsact2.rpy:34
translate chino menupreguntas_septem2_f8a6d224:

    # septem "Give me your hand."
    septem "把手给我。"

# game/rutas/labelsact2.rpy:36
translate chino menupreguntas_septem2_ff227fc6:

    # "It wasn't a question. Septem waits with his hand raised for you to give him yours..."
    "这不是请求。Septem 抬起手，等着你把手掌交给他……"

# game/rutas/labelsact2.rpy:37
translate chino menupreguntas_septem2_4903d82a:

    # "With some fear, you place your palm on his."
    "你带着几分恐惧，把掌心贴到他的手上。"

# game/rutas/labelsact2.rpy:40
translate chino menupreguntas_septem2_a488a064:

    # "The blond man grabs your hand and squeezes it while examining it."
    "金发男子抓住你的手，一边检查一边紧握。"

# game/rutas/labelsact2.rpy:41
translate chino menupreguntas_septem2_34cb892a:

    # "With his thumb, he traces imaginary lines that occasionally stop to trace a new one elsewhere."
    "他用拇指描摹着虚构的线条，偶尔停下，转而在别处重新描过一条。"

# game/rutas/labelsact2.rpy:42
translate chino menupreguntas_septem2_6f1d154b:

    # "You avert your gaze to focus on the face of the seventh."
    "你移开视线，转而专注地看向第七人的面容。"

# game/rutas/labelsact2.rpy:43
translate chino menupreguntas_septem2_82f3d3cc:

    # "His sky-colored eyes are focused intently on the movement of his finger. And despite the pressure his hand exerts on yours, you don't feel the slightest tickle."
    "天青色的双眼紧紧追随着自己手指的动作。尽管他的手压着你的手，你却连一丝麻痒都感觉不到。"

# game/rutas/labelsact2.rpy:44
translate chino menupreguntas_septem2_478214d3:

    # septem "Do you feel that?"
    septem "感觉到了吗？"

# game/rutas/labelsact2.rpy:48
translate chino menupreguntas_septem2_c759ec29:

    # septem "Hmm..."
    septem "嗯……"

# game/rutas/labelsact2.rpy:51
translate chino menupreguntas_septem2_6ca9432e:

    # "A subtle smile graces Septem's lips, causing a shiver to run through your body."
    "Septem 唇边泛起一抹若有若无的笑意，让你浑身窜起一阵战栗。"

# game/rutas/labelsact2.rpy:52
translate chino menupreguntas_septem2_ccd87743:

    # "Gradually, the pressure increases, but you can't move your hand."
    "压力一点点加重，可你的手却动弹不得。"

# game/rutas/labelsact2.rpy:53
translate chino menupreguntas_septem2_9e5f5c94:

    # "You won't give him the satisfaction of seeing your terror, neither on your face nor in your actions."
    "你不会让他如愿看到你的恐惧——无论是在脸上，还是在举动上。"

# game/rutas/labelsact2.rpy:54
translate chino menupreguntas_septem2_61f20aa3:

    # "Since it doesn't hurt."
    "因为根本不疼。"

# game/rutas/labelsact2.rpy:55
translate chino menupreguntas_septem2_2d627cdf:

    # "Septem squeezes harder and harder, slowly but progressively."
    "Septem 一寸寸、不紧不慢地越握越紧。"

# game/rutas/labelsact2.rpy:56
translate chino menupreguntas_septem2_5b017853:

    # "The feeling of pressure slowly morphs into pain."
    "压迫感缓缓化作了疼痛。"

# game/rutas/labelsact2.rpy:57
translate chino menupreguntas_septem2_e5c0e2d3:

    # "You're sure your bones will give in at any moment unless you manage to break free from his grip."
    "你确信，除非挣脱他的桎梏，否则自己的骨头随时都会碎裂。"

# game/rutas/labelsact2.rpy:58
translate chino menupreguntas_septem2_361840b6:

    # "There comes a point where you can't take it anymore and yank your hand away to make it clear that: enough."
    "终于到了某个再也忍受不住的瞬间，你猛地抽回手，分明是在说：够了。"

# game/rutas/labelsact2.rpy:59
translate chino menupreguntas_septem2_4a4785b2:

    # "But Septem doesn't let you."
    "可 Septem 不让你走。"

# game/rutas/labelsact2.rpy:62
translate chino menupreguntas_septem2_b8f944e6:

    # septem "Is something wrong, [nombrejugador]?"
    septem "[nombrejugador]，怎么了？"

# game/rutas/labelsact2.rpy:65
translate chino menupreguntas_septem2_37e87599:

    # septem "Hmmm?"
    septem "嗯嗯？"

# game/rutas/labelsact2.rpy:68
translate chino menupreguntas_septem2_a6fdf324:

    # "Septem lifts his gaze to look at your face, smiling sweetly, stopping the pressure increase but maintaining it."
    "Septem 抬眼望向你的脸，甜甜地笑着，不再加大力道，却依旧维持着那股压迫。"

# game/rutas/labelsact2.rpy:69
translate chino menupreguntas_septem2_62609753:

    # septem "Oh."
    septem "哦。"

# game/rutas/labelsact2.rpy:70
translate chino menupreguntas_septem2_ebf0615d:

    # septem "Sorry, I went a bit too far."
    septem "抱歉，我做得有点过火了。"

# game/rutas/labelsact2.rpy:71
translate chino menupreguntas_septem2_409a323d:

    # "{sc=3}[nombrejugador]... thank you.{/sc}"
    "{sc=3}[nombrejugador]……谢谢你。{/sc}"

# game/rutas/labelsact2.rpy:74
translate chino menupreguntas_septem2_97e23b55:

    # "You'll let Septem break your wrist because you want to know what will happen if he does."
    "你会让 Septem 折断你的手腕，因为你想知道他真的那么做之后会发生什么。"

# game/rutas/labelsact2.rpy:75
translate chino menupreguntas_septem2_86c39ea8:

    # "{sc=3}...{/sc}"
    "{sc=3}……{/sc}"

# game/rutas/labelsact2.rpy:76
translate chino menupreguntas_septem2_f7060d93:

    # "{sc=3}[nombrejugador]...{/sc}"
    "{sc=3}[nombrejugador]……{/sc}"

# game/rutas/labelsact2.rpy:79
translate chino menupreguntas_septem2_a6fdf324_1:

    # "Septem lifts his gaze to look at your face, smiling sweetly, no longer increasing the pressure, but maintaining it."
    "Septem 抬眼望向你的脸，甜甜地笑着，不再加大力道，却依旧维持着那股压迫。"

# game/rutas/labelsact2.rpy:80
translate chino menupreguntas_septem2_11c29a7d:

    # septem "I wish you could see the face your puppet is making right now."
    septem "真希望你也能看到，你的傀儡此刻正露出什么样的表情。"

# game/rutas/labelsact2.rpy:81
translate chino menupreguntas_septem2_faf11f69:

    # septem "It really hurts, and it doesn't want the fate being imposed on it."
    septem "它真的很疼，也不愿接受被强加的命运。"

# game/rutas/labelsact2.rpy:82
translate chino menupreguntas_septem2_74362dff:

    # septem "It's almost as if it were one of ours..."
    septem "简直就像它是我们的同类一样……"

# game/rutas/labelsact2.rpy:83
translate chino menupreguntas_septem2_29238035:

    # septem "But still, it won't do anything to change it, just to please you."
    septem "可即便如此，它也不会为此做出任何改变，只为了让你高兴。"

# game/rutas/labelsact2.rpy:84
translate chino menupreguntas_septem2_31924e0f_1:

    # septem "..."
    septem "……"

# game/rutas/labelsact2.rpy:87
translate chino menupreguntas_septem2_9a1b2120:

    # septem "I'm impressed by your puppet's conviction, [nombrejugador]."
    septem "[nombrejugador]，你的傀儡那份坚定，真让我印象深刻。"

# game/rutas/labelsact2.rpy:88
translate chino menupreguntas_septem2_02e99ef8:

    # septem "Intenta cumplir cada uno de tus comandos, sin importar su integridad..."
    septem "它会尽力完成你的每一条指令，不惜牺牲自身的完好……"

# game/rutas/labelsact2.rpy:89
translate chino menupreguntas_septem2_5889fed6:

    # septem "Tengo que darle ese reconocimiento."
    septem "这一点，我不得不承认。"

# game/rutas/labelsact2.rpy:91
translate chino menupreguntas_septem2_05b2f90a:

    # "Hay un breve silencio antes de que el rubio decida como seguir con esta interacción."
    "金发男子短暂地沉默了片刻，考虑该如何继续这场互动。"

# game/rutas/labelsact2.rpy:93
translate chino menupreguntas_septem2_c1577102:

    # "Septem guia tu mano a su cara, sus labios rosando delicadamente tus nudillos."
    "Septem 把你的手引到自己脸前，双唇轻轻掠过你的指节。"

# game/rutas/labelsact2.rpy:94
translate chino menupreguntas_septem2_05c85f08:

    # "Y te observa."
    "然后，他注视着你。"

# game/rutas/labelsact2.rpy:95
translate chino menupreguntas_septem2_33e9680c:

    # septem "Me pregunto que expresión tendrás..."
    septem "我在想，你究竟会露出什么样的表情……"

# game/rutas/labelsact2.rpy:96
translate chino menupreguntas_septem2_9a1b0a06:

    # septem "¿Asco? ¿Verguenza? ¿Neutal? hmmm."
    septem "厌恶？羞耻？无动于衷？嗯……"

# game/rutas/labelsact2.rpy:98
translate chino menupreguntas_septem2_cc8a8de4:

    # "Septem sonrie y te planta un beso, un contacto tierno y delicado."
    "Septem 微笑着，在你身上落下一个吻——温柔而轻柔的触碰。"

# game/rutas/labelsact2.rpy:100
translate chino menupreguntas_septem2_50931ec4:

    # "Sin más, Septem te suelta y se coloca nuevamente la prenda que le cubre el brazo."
    "不再多言，Septem 松开你，重新穿上那件遮着手臂的衣物。"

# game/rutas/labelsact2.rpy:107
translate chino menupreguntas_septem2_d550ab1d:

    # "Septem te mira con los ojos entrecerrados."
    "Septem 眯起眼睛看着你。"

# game/rutas/labelsact2.rpy:109
translate chino menupreguntas_septem2_a1b648c3:

    # septem "¿Yo?"
    septem "我？"

# game/rutas/labelsact2.rpy:110
translate chino menupreguntas_septem2_e87c5670_1:

    # septem "No."
    septem "不。"

# game/rutas/labelsact2.rpy:111
translate chino menupreguntas_septem2_ca197155:

    # septem "Es culpa de este cuerpo mortal..."
    septem "都怪这副凡人之躯……"

# game/rutas/labelsact2.rpy:112
translate chino menupreguntas_septem2_62cf90f8:

    # septem "Creeme, mi intención no es romperlo, pero estamos contra el tiempo."
    septem "相信我，我并不想弄坏它，但我们是在与时间赛跑。"

# game/rutas/labelsact2.rpy:113
translate chino menupreguntas_septem2_cf2fc140:

    # septem "...Cuando encuentre la solución. Lo dejaré descansar el tiempo que desee."
    septem "……等找到解决办法之后。我会让它想休息多久，就休息多久。"

# game/rutas/labelsact2.rpy:117
translate chino menupreguntas_septem2_33b6bf63:

    # "Le cuentas lo que pasó cuando dormías."
    "你告诉他你睡着时发生了什么。"

# game/rutas/labelsact2.rpy:119
translate chino menupreguntas_septem2_fb26730a:

    # "Septem te escucha sin interrumpir ni opinar. Mientras más explicas, la cara de Septem va tomando un aire de tristeza."
    "Septem 安静地听着，既不打断也不表态。你越说下去，他脸上的神情便越是染上一丝悲伤。"

# game/rutas/labelsact2.rpy:120
translate chino menupreguntas_septem2_30db2a44:

    # "Aunque en cierto punto de tu explicación, Septem levanta la mano."
    "不过在你讲到某个地方时，Septem 抬起了手。"

# game/rutas/labelsact2.rpy:121
translate chino menupreguntas_septem2_041f9d30:

    # "Pidiendo silenciosamente que te detengas."
    "无声地示意你停下。"

# game/rutas/labelsact2.rpy:123
translate chino menupreguntas_septem2_0bd7293a:

    # septem "Hablaremos de eso luego."
    septem "这件事我们之后再谈。"

# game/rutas/labelsact2.rpy:124
translate chino menupreguntas_septem2_7a294f58:

    # septem "Tengo otras cosas que solucionar antes."
    septem "我还有别的事要先处理。"

# game/rutas/labelsact2.rpy:125
translate chino menupreguntas_septem2_8a63a43c:

    # septem "Cuando encuentre una manera de unirnos sin poner en peligro tu experiencia o la mía, solucionaremos el problema que tiene Madre."
    septem "等我找到一种既不危及你的体验、也不危及我的融合方式，我们再去解决母亲的问题。"

# game/rutas/labelsact2.rpy:126
translate chino menupreguntas_septem2_f16c461c:

    # septem "Pero lo tendré en cuenta."
    septem "不过我会记在心里。"

# game/rutas/labelsact2.rpy:132
translate chino menupreguntas_septem2_ad1fe895:

    # septem "¿Eso fue todo?"
    septem "就这些吗？"

# game/rutas/labelsact2.rpy:133
translate chino menupreguntas_septem2_b05fc56b:

    # "... momento."
    "……等等。"

# game/rutas/labelsact2.rpy:134
translate chino menupreguntas_septem2_a1465a8e:

    # "una cosa más."
    "还有一件事。"

# game/rutas/labelsact2.rpy:137
translate chino menupreguntas_septem2_a9f90d2e:

    # "Se le ve aflijido al escucharte."
    "他听着你说话，神色显得十分痛苦。"

# game/rutas/labelsact2.rpy:139
translate chino menupreguntas_septem2_54d57a01:

    # "Se toma un tiempo antes de responder."
    "他花了片刻，才开口回答。"

# game/rutas/labelsact2.rpy:141
translate chino menupreguntas_septem2_da22e196:

    # septem "{size=*0.6}... no sé como resultará.{/size}"
    septem "{size=*0.6}……我不知道结果会怎样。{/size}"

# game/rutas/labelsact2.rpy:142
translate chino menupreguntas_septem2_c178b3f6:

    # "Septem habla tan despacio que te ha costado un poco entenderle. Antes de que puedas preguntarle, él se aclara la garganta para explicarse."
    "Septem 说话太慢，你花了好一会儿才听懂。还没等你再问，他便清了清嗓子，准备解释。"

# game/rutas/labelsact2.rpy:144
translate chino menupreguntas_septem2_380b1f44:

    # septem "Cuando te di uno de mis ojos, no resultó como yo esperaba."
    septem "当我把其中一只眼睛交给你时，结果并不像我预想的那样。"

# game/rutas/labelsact2.rpy:145
translate chino menupreguntas_septem2_bceb7730:

    # septem "{b}Algo{b} dentro de esta cosa me prohibe enlasarme contigo."
    septem "{b}这东西{b}内部的某种存在，禁止我与你融合。"

# game/rutas/labelsact2.rpy:146
translate chino menupreguntas_septem2_3dac244f:

    # septem "Además,te ha quitado la poca libertad que tienes para controlar a la marioneta."
    septem "而且，它还夺走了你操控傀儡仅有的那点自由。"

# game/rutas/labelsact2.rpy:147
translate chino menupreguntas_septem2_bb050f58:

    # septem "Si hacemos la transfusión... no cumpliré con lo que te prometí y ambos seremos absorbidos por la marioneta si continuamos como estaba planeado..."
    septem "如果我们进行输注……我就无法兑现对你的承诺，而我们若照旧进行下去，就会双双被傀儡吞没……"

# game/rutas/labelsact2.rpy:148
translate chino menupreguntas_septem2_e048e386:

    # septem "Será un desastre."
    septem "那将会是一场灾难。"

# game/rutas/labelsact2.rpy:149
translate chino menupreguntas_septem2_31924e0f_2:

    # septem "..."
    septem "……"

# game/rutas/labelsact2.rpy:150
translate chino menupreguntas_septem2_e7a0db87:

    # "Septem guarda silencio por un largo rato. Y tú no sabes como rellenar ese silencio incómodo."
    "Septem 沉默了许久。而你不知该如何填补这令人尴尬的空白。"

# game/rutas/labelsact2.rpy:151
translate chino menupreguntas_septem2_31fbc8fa:

    # septem "Retírate."
    septem "退下吧。"

# game/rutas/labelsact2.rpy:153
translate chino menupreguntas_septem2_73d30947:

    # "Ni siquiera te da la oportunidad de tomar una decisión, pues te teletransporta a la pieza donde duermes."
    "他甚至不给你做决定的机会，直接把你传送回了你睡觉的房间。"

# game/rutas/labelsact2.rpy:158
translate chino menupreguntas_septem2_a20cefa7:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:160
translate chino menupreguntas_septem2_e9c2e1fd:

    # "Septem te mira funciendo el ceño."
    "Septem 皱着眉看着你。"

# game/rutas/labelsact2.rpy:161
translate chino menupreguntas_septem2_8e217852:

    # "Pero en su expresión hay algo más que no puedes identificar."
    "但他的神情里，还有某种你无法辨识的东西。"

# game/rutas/labelsact2.rpy:162
translate chino menupreguntas_septem2_32f08cdd:

    # "Es como si estuviera teniendo un debate interno donde no puede ganar ni pensar en una reacción apta para esta situación."
    "他仿佛正在内心与自己争执，既想不出个所以然，也想不出对这局面该作何反应。"

# game/rutas/labelsact2.rpy:163
translate chino menupreguntas_septem2_9edf4aa4:

    # "Definitivamente no se esperaba esto."
    "他显然没料到会是这样。"

# game/rutas/labelsact2.rpy:164
translate chino menupreguntas_septem2_73b54aa7:

    # "{sc=3}Heh, toma eso anciano.{/sc}"
    "{sc=3}哼，这一下是给你的，老头子。{/sc}"

# game/rutas/labelsact2.rpy:167
translate chino menupreguntas_septem2_d6f13945:

    # "Septem abre la boca para gritar y seguramente hacer explotar todos tus órganos como si de globos rellenos de agua se tratasen."
    "Septem 张开嘴，就要尖叫出声——那无疑会让你的内脏像灌满水的气球一样炸裂开来。"

# game/rutas/labelsact2.rpy:168
translate chino menupreguntas_septem2_c9a440b9:

    # "Te preparas para morir, tomando un último aliento."
    "你做好了赴死的准备，深深吸了最后一口气。"

# game/rutas/labelsact2.rpy:169
translate chino menupreguntas_septem2_9b21543c:

    # septem "Vete."
    septem "滚。"

# game/rutas/labelsact2.rpy:170
translate chino menupreguntas_septem2_d3d2d680:

    # septem "Vete de aquí."
    septem "从这里滚开。"

# game/rutas/labelsact2.rpy:171
translate chino menupreguntas_septem2_76fed55b:

    # septem "Antes de que te corte la cabeza."
    septem "趁我还没砍下你的脑袋。"

# game/rutas/labelsact2.rpy:173
translate chino menupreguntas_septem2_73d30947_1:

    # "Ni siquiera te da la oportunidad de tomar una decisión, pues te teletransporta a la pieza donde duermes."
    "他甚至不给你做决定的机会，直接把你传送回了你睡觉的房间。"

# game/rutas/labelsact2.rpy:174
translate chino menupreguntas_septem2_e75266d1:

    # "{sc=3}Heh, para la próxima podríamos llamarlo buen chico y ver como reacciona.{/sc}"
    "{sc=3}哼，下次咱们可以叫他一声『好孩子』，看看他会怎么反应。{/sc}"

# game/rutas/labelsact2.rpy:175
translate chino menupreguntas_septem2_536c8d93:

    # "{sc=3}Para molestarlo un poquito.{/sc}"
    "{sc=3}好小小地气一气他。{/sc}"

# game/rutas/labelsact2.rpy:183
translate chino badend_septem9_a20cefa7:

    # "..."
    "……"

# game/rutas/labelsact2.rpy:184
translate chino badend_septem9_98844cb5:

    # "No vas a entrar... Quisas que cosas sucedan si lo haces."
    "你不会进去的……也许进去就会出事。"

# game/rutas/labelsact2.rpy:185
translate chino badend_septem9_7e597276:

    # "Así que, sin decir nada, caminas hacia atrás."
    "于是你什么也没说，只是向后倒退着走开。"

# game/rutas/labelsact2.rpy:187
translate chino badend_septem9_678768ae:

    # "Llegas al pasillo."
    "你走到了走廊。"

# game/rutas/labelsact2.rpy:189
translate chino badend_septem9_c354ce8a:

    # septem "Te he dicho que pases."
    septem "我叫你进来。"

# game/rutas/labelsact2.rpy:191
translate chino badend_septem9_09901bd4:

    # septem "Hoy no estoy para juegos. No voy a aceptar este comportamiento."
    septem "我今天没心思玩游戏，也不打算容忍这种行为。"

# game/rutas/labelsact2.rpy:192
translate chino badend_septem9_36b762d5:

    # septem "Tu desobedencia ya no es divertida."
    septem "你的违抗，已经不好玩了。"

# game/rutas/labelsact2.rpy:193
translate chino badend_septem9_a4b9f2c7:

    # septem "Si realmente te tomas esto en serio, volverás."
    septem "要是你真把这当回事，你会回来的。"

# game/rutas/labelsact2.rpy:194
translate chino badend_septem9_0f8f0003:

    # "Septem te agarra por la garganta y comienza a apretar sin cuidado."
    "Septem 一把掐住你的喉咙，漫不经心地开始收紧。"

# game/rutas/labelsact2.rpy:195
translate chino badend_septem9_3756aa30:

    # "Quitandote el aire de a poco, el sonrie."
    "一点点剥夺你的呼吸，他却在微笑。"

# game/rutas/labelsact2.rpy:196
translate chino badend_septem9_b8a3ffca:

    # "BAD END: ..."
    "BAD END：……"

# game/rutas/labelsact2.rpy:202
translate chino badendexplosion_20371e77:

    # "No colocas las manos, no te piensas quemar."
    "你不肯把手放进去，不想被烧伤。"

# game/rutas/labelsact2.rpy:205
translate chino badendexplosion_1756ebe2:

    # "'Que lo haga Unum'.... es tu último pensamiento antes de escuchar un estruendo... como una explosión."
    "『让 Unum 去做吧』……这是你听到那声轰响之前，脑海中的最后一个念头——那声响，就像爆炸一样。"

# game/rutas/labelsact2.rpy:206
translate chino badendexplosion_f0e18c9f:

    # "BAD END: Explosión."
    "BAD END：爆炸。"

# game/rutas/labelsact2.rpy:210
translate chino badendseptemjardin_3e363d17:

    # "Es ahora o nunca."
    "就是现在，否则就再没机会了。"

# game/rutas/labelsact2.rpy:211
translate chino badendseptemjardin_9411d2d9:

    # "Ahora nadie te está vigilando, estás practicamente a unos cuantos metros de tu libertar."
    "现在没人盯着你了，你离自由实际上只差短短几米。"

# game/rutas/labelsact2.rpy:212
translate chino badendseptemjardin_f48b7669:

    # "Que importa los posibles problemas que tengas allá afuera por ser un humano. ¡Lo que importa es que eres libre!"
    "管他作为人类在外面会遇到什么麻烦呢。重要的是，你自由了！"

# game/rutas/labelsact2.rpy:215
translate chino badendseptemjardin_c8aabd87:

    # septem "Realmente eres imbécil..."
    septem "你真是个蠢货……"

# game/rutas/labelsact2.rpy:216
translate chino badendseptemjardin_760d2cba:

    # "Septem te corta la cabeza."
    "Septem 斩下了你的头颅。"

# game/rutas/labelsact2.rpy:217
translate chino badendseptemjardin_02519825:

    # "BAD END: A metros de tu libertad."
    "BAD END：距自由仅几米之遥。"

translate chino strings:

    # game/rutas/labelsact2.rpy:6
    old "Las manos de mi marioneta..."
    new "我傀儡的双手……"

    # game/rutas/labelsact2.rpy:6
