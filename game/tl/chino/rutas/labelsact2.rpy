# game/rutas/labelsact2.rpy:996
translate chino act3_explorar_septem_33ec7907:

    # septem "Ahora. Veamos que si has prestado atención realmente."
    septem "现在。我们来看看你是否真的专心听了。"

# game/rutas/labelsact2.rpy:997
translate chino act3_explorar_septem_59566240:

    # "Septem suelta una risa jugetona justo detrás de tu oreja."
    "Septem 就在你耳后，发出一声带着玩味的轻笑。"

# game/rutas/labelsact2.rpy:1467
translate chino claseslatin_89457f5f:

    # septem "Tú puedes hacerlo..."
    septem "你可以做到的……"

# game/rutas/labelsact2.rpy:1468
translate chino claseslatin_b1d4b50a:

    # septem "Pide algo que te involucre a ti."
    septem "请求一件只涉及你自己的事。"

# game/rutas/labelsact2.rpy:1472
translate chino claseslatin_95015146:

    # "Septem se ríe de tu pronunciación, bajito e intenta aguantarse un poco... no es una risa mal intencionada."
    "Septem 因为你发错的音轻轻笑了，努力想忍住一点……那并不是带着恶意的笑。"

# game/rutas/labelsact2.rpy:1473
translate chino claseslatin_df7ec066:

    # septem "No, no, [nombrejugador]."
    septem "不，不，[nombrejugador]。"

# game/rutas/labelsact2.rpy:1474
translate chino claseslatin_516ea202:

    # septem "Recuerda...... {sc=3}{b}ego faciam{/sc}{b}"
    septem "记住…… {sc=3}{b}ego faciam{/sc}{b}"

# game/rutas/labelsact2.rpy:1481
translate chino claseslatin_63bc4ce3:

    # septem "Tienes que soltar un poco más tu lengua."
    septem "你的舌头还得再放松一点。"

# game/rutas/labelsact2.rpy:1482
translate chino claseslatin_e8baceb3:

    # septem "Y prestar más atención a lo que digo."
    septem "还有要更专心地听我说。"

# game/rutas/labelsact2.rpy:1483
translate chino claseslatin_049b4eea:

    # septem "Sub potestate---"
    septem "Sub potestate——"

# game/rutas/labelsact2.rpy:1484
translate chino claseslatin_5cd3a91d:

    # extend "quae mihi conceditur---"
    extend "quae mihi conceditur——"

# game/rutas/labelsact2.rpy:1485
translate chino claseslatin_f3683a2c:

    # extend "ego faciam."
    extend "ego faciam."

# game/rutas/labelsact2.rpy:1490
translate chino claseslatin_c2ace9b6:

    # septem "Tierno..."
    septem "可爱……"

# game/rutas/labelsact2.rpy:1491
translate chino claseslatin_218bc981:

    # septem "Pero no es exactamente lo que buscamos."
    septem "但这并不是我们想要的。"

# game/rutas/labelsact2.rpy:1492
translate chino claseslatin_e3d96940:

    # "Sus dedos te acarician el cuello, apretando un poquito más tu tráquea, siempre teniendo cuidado de no apretar de más y dañarte la zona."
    "他的手指爱抚着你的脖颈，稍微加重了对你气管的按压，却始终注意着不要用力过猛，以免伤到你。"

# game/rutas/labelsact2.rpy:1501
translate chino claseslatin2_a54f1628:

    # "Cuando por fin lo logras, Septem te felicita, enfatizando lo perfecto que ha salido."
    "当你终于做对时，Septem 向你祝贺，强调你做得有多么完美。"

# game/rutas/labelsact2.rpy:1502
translate chino claseslatin2_6e36546a:

    # "Septem es un buen maestro."
    "Septem 是个好老师。"

# game/rutas/labelsact2.rpy:1506
translate chino claseslatin2_bbe140b7:

    # septem "Para pedir algo que involucre a un otro, un {i}tú{i}, debes decir---"
    septem "若要请求涉及另一个人，一个{i}你{/i}，你必须说——"

# game/rutas/labelsact2.rpy:1507
translate chino claseslatin2_d9282ca6:

    # septem "{i}Sub potestate quae mihi conceditur, tu facies...{i} \n {size=*0.6}Bajo el poder que me confiere, tú harás.{/size}"
    septem "{i}Sub potestate quae mihi conceditur, tu facies...{i} \n {size=*0.6}凭借授予我的力量，你将行事。{/size}"

# game/rutas/labelsact2.rpy:1508
translate chino claseslatin2_84197a25:

    # "Habiendo pronunciado el anterior comando, te es más fácil sacar este. Lo único que cambia son las palabras del final."
    "念过上一个命令后，你觉得这个更容易说出口了。唯一改变的是末尾的几个词。"

# game/rutas/labelsact2.rpy:1509
translate chino claseslatin2_0161b45e:

    # septem "Y para un nosotros, sería---"
    septem "而“我们”的话，会是这样——"

# game/rutas/labelsact2.rpy:1510
translate chino claseslatin2_74648207:

    # septem "{i}Sub potestate quae mihi conceditur, nos faciemu... {i} \n {size=*0.6}Bajo el poder que me confiere, nosotros haremos...{/size}"
    septem "{i}Sub potestate quae mihi conceditur, nos faciemu... {i} \n {size=*0.6}凭借授予我的力量，我们将行事……{/size}"

# game/rutas/labelsact2.rpy:1514
translate chino claseslatin2_dc61691d:

    # "Ya lo tienes dominado. No necesitas la guía de Septem con sus dedos o pausas para pedir que él te lo repita porque tú lo has olvidado."
    "你已经完全掌握了。你不再需要 Septem 用手指引导你，也不需要停下来请他重复那些你已经忘掉的内容。"

# game/rutas/labelsact2.rpy:1515
translate chino claseslatin2_3d2c81bf:

    # "Ya lo manejas, por lo que Septem te deja descansar."
    "你已经很熟练了，于是 Septem 让你休息。"

# game/rutas/labelsact2.rpy:1516
translate chino claseslatin2_9630a409:

    # "Llega un momento en que te preguntas si deberías seguir aquí o salir a ver qué otras cosas hay por ver."
    "终于，你开始想，自己是该继续留在这里，还是出去看看还有没有什么可看的。"

# game/rutas/labelsact2.rpy:1520
translate chino claseslatin2_2e716117:

    # "Te despides de Septem, excusándote, diciendo que quieres seguir explorando el templo."
    "你向 Septem 告别，借口说你想继续探索神庙。"

# game/rutas/labelsact2.rpy:1521
translate chino claseslatin2_8d8cbbe1:

    # "Él te desea suerte."
    "他祝你好运。"

# game/rutas/labelsact2.rpy:1525
translate chino claseslatin2_73c1b6c5:

    # "Quedarte con Septem no suena mal. Te gusta pasar el tiempo con él."
    "和 Septem 待在一起听起来并不坏。你享受与他共度的时光。"

# game/rutas/labelsact2.rpy:1526
translate chino claseslatin2_fac649fb:

    # "El tiempo pasa y cuenta no te das cuando Septem te comenta que ya es hora. Te espera para que tú te levantes de su silla y camina junto contigo a la entrada del templo."
    "时间不知不觉地流逝，直到 Septem 告诉你时候到了。他等你从他的椅子上起身，然后陪你一起走向神庙入口。"

