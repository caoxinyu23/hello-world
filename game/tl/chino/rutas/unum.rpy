# TODO: Translation updated at 2025-02-22 23:13

# game/rutas/unum.rpy:10
translate chino rutaunum2_a20cefa7:

    # "..."
    "..."

# game/rutas/unum.rpy:12
translate chino rutaunum2_b720caa8:

    # "El aumento de la temperatura es lo que te despierta."
    "是温度的升高把你弄醒的。"

# game/rutas/unum.rpy:13
translate chino rutaunum2_114b14ef:

    # "Sientes como una gota gorda de sudor te recorre la frente."
    "你感到一滴浓密的汗珠顺着额头滑落。"

# game/rutas/unum.rpy:14
translate chino rutaunum2_fc93ae33:

    # "... pero quieres volver nuevamente a dormir, estás muy cansado."
    "……可你想再睡一会儿，你太累了。"

# game/rutas/unum.rpy:15
translate chino rutaunum2_6bf00144:

    # el "Deberías agradecer que la biología de esta cosa y los míos son muy parecidas..."
    el "你应该庆幸这东西的生理构造和我们非常相似……"

# game/rutas/unum.rpy:16
translate chino rutaunum2_269d2bd7:

    # unum "¿Ya lo has hecho más veces?"
    unum "你以前做过好几次了？"

# game/rutas/unum.rpy:17
translate chino rutaunum2_813206b4:

    # el "Claro. No puedo estar en todos lados a la vez, siempre existe la posibilidad de que alguno de mis niños coma una fruta que faltó por santificar."
    el "当然。我不可能同时出现在所有地方，总有可能有哪个孩子吃到没经过祝圣的果实。"

# game/rutas/unum.rpy:19
translate chino rutaunum2_f61cbec8:

    # "Abres los ojos para ver que está pasando, pero la luz es muy brillante."
    "你睁开双眼想看看发生了什么，可光线太刺眼了。"

# game/rutas/unum.rpy:20
translate chino rutaunum2_4d8c62b2:

    # unum "¡OH! ¡Quinque, está funcionando!"
    unum "哦！Quinque，成功了！"

# game/rutas/unum.rpy:21
translate chino rutaunum2_78c5ba34:

    # "Unum dice como si no se lo creyera. Quinque chasquea la lengua, exasperado."
    "Unum说得好像连他自己都不敢相信。Quinque恼火地咂了咂舌。"

# game/rutas/unum.rpy:23
translate chino rutaunum2_3ce9a3e0:

    # quinque "¡No grites! aún falta sacar la rosa principal."
    quinque "别喊！主玫瑰还没取出来呢。"

# game/rutas/unum.rpy:24
translate chino rutaunum2_4bde8eab:

    # "Una sensación extraña se forma en la piel que recubre tu vientre. Hay algo que se abre paso desde tu estómago hacía arriba con urgencia, no duele pero se siente molesto."
    "覆在你腹部的皮肤上泛起一阵异样的感觉。有什么东西正急着从你的胃里往上挤，不疼，但很不舒服。"

# game/rutas/unum.rpy:25
translate chino rutaunum2_7f820265:

    # quinque "Escúpelo aquí."
    quinque "吐到这儿来。"

# game/rutas/unum.rpy:27
translate chino rutaunum2_931d64a2:

    # "Tu vista se ve invadida por una mano que espera con la palma abierta algo."
    "映入你眼帘的是一只手，掌心摊开，正等着什么东西。"

# game/rutas/unum.rpy:28
translate chino rutaunum2_224a4607:

    # "Y ese algo no tarda en llegar, pues de tu boca expulsas una rosa en perfecto estado."
    "那东西很快就到了——你从嘴里吐出了一朵完好无损的玫瑰。"

# game/rutas/unum.rpy:29
translate chino rutaunum2_081174ed:

    # "Es asqueroso, pero a juzgar por la cara de Quinque, el no piensa lo mismo... es más, se le ve completamente indiferente, le da igual tener en su mano una rosa llena de saliva y jugos gástricos."
    "真恶心，但从Quinque的表情来看，他显然不这么想……事实上，他看起来完全无所谓，手里捧着一朵沾满唾液和胃液的玫瑰也毫不介意。"

# game/rutas/unum.rpy:30
translate chino rutaunum2_4d38ca30:

    # "Cómo si ya lo hubiera hecho un montón de veces."
    "就仿佛他已经做过无数次了。"

# game/rutas/unum.rpy:31
translate chino rutaunum2_667f031e:

    # quinque "Es exactamente lo mismo..."
    quinque "一模一样……"

# game/rutas/unum.rpy:32
translate chino rutaunum2_f7192d1e:

    # quinque "Realmente no entiendo la diferente entre los míos y los de Sextam."
    quinque "我真的搞不懂我的和Sextam的有什么区别。"

# game/rutas/unum.rpy:33
translate chino rutaunum2_c46ffdc7:

    # quinque "Su biología es muy parecida..."
    quinque "它们的生理构造非常相似……"

# game/rutas/unum.rpy:34
translate chino rutaunum2_78900649:

    # unum "Los tuyos no piensan."
    unum "你的那些不会思考。"

# game/rutas/unum.rpy:35
translate chino rutaunum2_caed5748:

    # "Contesta Unum con gracia."
    "Unum俏皮地回答。"

# game/rutas/unum.rpy:36
translate chino rutaunum2_858abff8:

    # quinque "¡El que no piensa eres tú!"
    quinque "不思考的是你！"

# game/rutas/unum.rpy:38
translate chino rutaunum2_d3fdeb0a:

    # "Quinque se levanta con rapidez para agarrar a Unum de sus ropas. El pelirrojo solo rie, restando importancia al enojo de Quinque."
    "Quinque猛地站起来抓住Unum的衣服。红发家伙只是笑着，把Quinque的怒火当成了耳边风。"

# game/rutas/unum.rpy:39
translate chino rutaunum2_70acde1e:

    # quinque "Te vuelvo a escuchar decir eso una vez más y juro que rompo ese hibrido que tienes guardado."
    quinque "你再让我听到一次这种话，我发誓就弄坏你藏起来的那杂交种。"

# game/rutas/unum.rpy:41
translate chino rutaunum2_3c774f43:

    # "Su sonrisa se desvanece por completo, optando por mirar hacia abajo a Quinque, completamente serio."
    "他的笑容彻底消失了。他低下头看着Quinque，神色冷峻。"

# game/rutas/unum.rpy:42
translate chino rutaunum2_5083a61f:

    # unum "¿Ah? ¿Y tú cómo sabes eso?"
    unum "啊？那你是怎么知道这件事的？"

# game/rutas/unum.rpy:43
translate chino rutaunum2_eaf6b939:

    # quinque "Escucho otro corazón además de el que tiene este humano."
    quinque "除了这个人类有的那颗，我还听见了另一颗心跳。"

# game/rutas/unum.rpy:44
translate chino rutaunum2_387636ff:

    # unum "Hmmm."
    unum "嗯……"

# game/rutas/unum.rpy:45
translate chino rutaunum2_9efc825a:

    # "Unum no se mueve mientras mira fijamente a Quinque."
    "Unum一动不动，死死盯着Quinque。"

# game/rutas/unum.rpy:47
translate chino rutaunum2_11725d59:

    # "Ya sea por la dificultad de sostener la mirada al sol o por simple incomodidad, Quinque chasquea la lengua, soltando y empujándolo."
    "不知是难以与太阳对视，还是单纯觉得不舒服，Quinque咂了咂舌，松开手把他推开。"

# game/rutas/unum.rpy:49
translate chino rutaunum2_20726a14:

    # unum "Supongo que ya Septem les ha dicho que seré yo quien hará el cambio."
    unum "我想Septem应该已经告诉过你们，变化会由我来完成。"

# game/rutas/unum.rpy:51
translate chino rutaunum2_ade8bcb2:

    # quinque "Sí."
    quinque "是的。"

# game/rutas/unum.rpy:52
translate chino rutaunum2_51edbd0e:

    # unum "Entonces..."
    unum "那么……"

# game/rutas/unum.rpy:55
translate chino rutaunum2_1c9a8b6a:

    # "Unum vuelve a sonreir."
    "Unum又笑了。"

# game/rutas/unum.rpy:58
translate chino rutaunum2_c81ebfce:

    # unum "¿Lo quieres ver?"
    unum "你想看看吗？"

# game/rutas/unum.rpy:59
translate chino rutaunum2_b5293d8d:

    # quinque "No gracias. Volveré a mi dominio."
    quinque "不用了，谢谢。我要回我的领地去了。"

# game/rutas/unum.rpy:60
translate chino rutaunum2_bf806542:

    # quinque "Si necesitas ayuda en cualquier situación que desconozcas, puedes llamarme a mi o a Sextam."
    quinque "如果遇到什么不熟悉的状况需要帮忙，可以叫我，或者找Sextam。"

# game/rutas/unum.rpy:61
translate chino rutaunum2_d9b6a9b0:

    # quinque "Todos estamos al tanto."
    quinque "我们都知道的。"

# game/rutas/unum.rpy:64
translate chino rutaunum2_0839915a:

    # "Sin más, Quinque se retira de la habitación."
    "Quinque没有再多说，转身离开了房间。"

# game/rutas/unum.rpy:65
translate chino rutaunum2_dbcb4977:

    # "Unum se queda por un momento pensativo, para luego dedicarte una mirada complice."
    "Unum若有所思地站了一会儿，随后朝你投来一个心照不宣的眼神。"

# game/rutas/unum.rpy:67
translate chino rutaunum2_11ad6c39:

    # unum "Ahora viene lo difícil. Cultivar a un dios."
    unum "接下来才是难的部分——培育一位神明。"

# game/rutas/unum.rpy:70
translate chino rutaunum2_dfea04e0:

    # unum "Tenemos que cultivar a este dios hasta que esté completamente listo."
    unum "我们得把这位神明培育到完全成熟为止。"

# game/rutas/unum.rpy:75
translate chino rutaunum2_c17099d3:

    # unum "¿No es así cómo se dice?"
    unum "不就是这么说的吗？"

# game/rutas/unum.rpy:76
translate chino rutaunum2_11a870c1:

    # nj "¿Que cosa?"
    nj "什么？"

# game/rutas/unum.rpy:77
translate chino rutaunum2_ffa87e1d:

    # unum "Cuando tienes que cuidar algo hasta que esté listo."
    unum "就是得一直照料某样东西，直到它准备就绪。"

# game/rutas/unum.rpy:78
translate chino rutaunum2_b915d907:

    # nj "Eso es criar..."
    nj "那叫养育……"

# game/rutas/unum.rpy:81
translate chino rutaunum2_24d674e0:

    # unum "¡Perfecto! vamos a criar a un dios."
    unum "太棒了！那我们就来养育一位神明吧。"

# game/rutas/unum.rpy:85
translate chino rutaunum2_fad6d44c:

    # unum "Pero voy a necesitar tu ayuda..."
    unum "但我需要你的帮忙……"

# game/rutas/unum.rpy:88
translate chino rutaunum2_7a7c9e9f:

    # unum "Sigo sin entender cómo la vida orgánica pasa por cambios que le permiten crecer y mejorar."
    unum "我还是想不通，有机体的生命究竟是怎样经历那些变化，从而生长和进步的。"

# game/rutas/unum.rpy:89
translate chino rutaunum2_26ce0663:

    # unum "Nunca lo he visto por mi mismo..."
    unum "我自己从没见过……"

# game/rutas/unum.rpy:92
translate chino rutaunum2_57d24dec:

    # unum "Así que supongo que tú sabes un poco más de esto..."
    unum "所以我想，你对此多少懂一点吧……"

# game/rutas/unum.rpy:93
translate chino rutaunum2_07605984:

    # "Harás lo que sea necesario para salvarte el pellejo, y si eso requiere jugar a la familia feliz con el dios del sol, lo harás sin dudarlo."
    "为了保住自己的小命，你会不择手段；就算要同太阳之神扮成幸福家庭，你也会毫不犹豫地去做。"

# game/rutas/unum.rpy:98
translate chino rutaunum2_25cea9cd:

    # "Unum sonríe sin mostrar los dientes."
    "Unum微微一笑，没有露出牙齿。"

# game/rutas/unum.rpy:99
translate chino rutaunum2_64b3b407:

    # "Su expresión es tierna, nada parecida a las miradas que te ha dedicado en el pasado."
    "他的神情温柔，和过去看你的那种目光截然不同。"

# game/rutas/unum.rpy:104
translate chino rutaunum2_89abb2ff:

    # unum "Oh."
    unum "哦。"

# game/rutas/unum.rpy:105
translate chino rutaunum2_ab081901:

    # unum "No te preocupes."
    unum "别担心。"

# game/rutas/unum.rpy:106
translate chino rutaunum2_6e3ff3d7:

    # unum "Ambos nos apoyaremos con esto."
    unum "这件事上，我们会互相支持。"

# game/rutas/unum.rpy:107
translate chino rutaunum2_ac7d9b71:

    # unum "Despues de todo, este dios no es ni humano ni un Estandarte completamente."
    unum "毕竟，这位神明既不完全是人类，也不完全是圣旗。"

# game/rutas/unum.rpy:110
translate chino rutaunum2_4a628198:

    # unum "¡Será lo mejor de dos mundos!"
    unum "那会是两全其美！"

# game/rutas/unum.rpy:113
translate chino rutaunum2_27fbc9be:

    # "El día pasa."
    "白昼匆匆流逝。"

# game/rutas/unum.rpy:115
translate chino rutaunum2_47ac5640:

    # "E increíblemente te encuentras acompañado por Unum y sus esposas."
    "而令人难以置信的是，你发现自己竟有Unum和他的妻子们作伴。"

# game/rutas/unum.rpy:116
translate chino rutaunum2_03c06c37:

    # "A pesar de que el calor se hace cada vez más difícil de soportar, no es nada que te pueda hacer un daño verdadero."
    "尽管热度越来越难以忍受，但这其实并不能真正伤到你。"

# game/rutas/unum.rpy:117
translate chino rutaunum2_139a5d2b:

    # "Un poco de calor no mata a nadie... ¿cierto?"
    "一点点热又不会死人……对吧？"

# game/rutas/unum.rpy:118
translate chino rutaunum2_952945c5:

    # "Miras tu entorno y te encuentras con 3 pares de ojos puestos en ti."
    "你环顾四周，发现有三双眼睛正盯着你。"

# game/rutas/unum.rpy:119
translate chino rutaunum2_ee38209e:

    # "Aeliana, Ignis y Solaris. Quienes a pesar de mirarte como si te quisieran comer, son bastante respetuosas y calmadas, a diferencia de Unum."
    "Aeliana、Ignis和Solaris。尽管她们看你的眼神像是要把你吃掉，却始终相当恭敬而平静，和Unum截然不同。"

# game/rutas/unum.rpy:121
translate chino rutaunum2_19cfec53:

    # "Unum le pide a sus esposas que le enseñen a hacer la purificación de los alimentos, ya que según él tanto tú como el 'bebé' deben alimentarse sin preocuparse por un envenenamiento por parte de Tria."
    "Unum请妻子们教他净化食物的方法，因为按他的说法，你和那个『婴儿』都得安心进食，不必担心被Tria下毒。"

# game/rutas/unum.rpy:122
translate chino rutaunum2_f3a07cfc:

    # ignis "Tienes que juntar tus manos alrededor de la fruta y..."
    ignis "你得把双手合拢，围住果实，然后……"

# game/rutas/unum.rpy:123
translate chino rutaunum2_a77c8288:

    # solaris "Debes cantar a la esencia de Tria."
    solaris "你要向Tria的本质歌唱。"

# game/rutas/unum.rpy:125
translate chino rutaunum2_20e3db58:

    # "Sin más explicación, Ignis comienza a cantar en un idioma que desconoces. Tanto tú, junto con Unum miran con la boca abierta como la fruta comienza a brillar."
    "Ignis不再多解释，直接用一种你听不懂的语言唱了起来。你和Unum都看得目瞪口呆，只见果实开始发光。"

# game/rutas/unum.rpy:126
translate chino rutaunum2_63be3053:

    # "Para luego ser espectadores de como un sello se rompe en el aire."
    "随后，你们亲眼目睹一道封印在半空中碎裂。"

# game/rutas/unum.rpy:127
translate chino rutaunum2_812e887f:

    # aeliana "Cuando el sello de Tria se rompa, la fruta puede ser consumida."
    aeliana "等Tria的封印被打破，果实就能吃了。"

# game/rutas/unum.rpy:128
translate chino rutaunum2_980ecd06:

    # solaris "Hum... puede que el mini dios pueda no tener un riesgo mortal como [nombrejugador] al comer frutas no santificadas, pero el riesgo siempre está."
    solaris "嗯……也许小神明吃下未祝圣的果实不像[nombrejugador]那样有致命风险，但风险终究存在。"

# game/rutas/unum.rpy:129
translate chino rutaunum2_374356f7:

    # ignis "Tal vez sea como nosotros..."
    ignis "也许它和我们一样……"

# game/rutas/unum.rpy:130
translate chino rutaunum2_548e6e94:

    # aeliana "No asuman sin saber, queridas."
    aeliana "亲爱的们，不知道的事情别乱猜。"

# game/rutas/unum.rpy:131
translate chino rutaunum2_94298344:

    # aeliana "Hoy nosotras haremos la comida, pero a partir de mañana tú lo harás."
    aeliana "今天由我们来做饭，但从明天起就轮到你了。"

# game/rutas/unum.rpy:132
translate chino rutaunum2_ab8b8dd9:

    # aeliana "Cocinaras para todos."
    aeliana "你要给所有人做饭。"

# game/rutas/unum.rpy:133
translate chino rutaunum2_55b0f189:

    # "Por un momento crees que te está hablando a ti, pero te das cuenta de que Aeliana tiene los ojos puestos en Unum."
    "那一瞬间你以为她是在对你说话，但你随即发现Aeliana的目光落在Unum身上。"

# game/rutas/unum.rpy:134
translate chino rutaunum2_b1f073ba:

    # aeliana "Así que presta atención."
    aeliana "所以，好好看着。"

# game/rutas/unum.rpy:136
translate chino rutaunum2_efb5ef5c:

    # "Después de una intensa clase de cocina, en la que deben redirigir constantemente la atención de Unum a la explicación, todos se reúnen alrededor de la mesa para comer."
    "一场紧张的烹饪课过后——其间你们还得不断把Unum的注意力拉回讲解上——大家围坐在餐桌旁准备用餐。"

# game/rutas/unum.rpy:137
translate chino rutaunum2_97fe06cb:

    # "Y comienzan a comer."
    "然后大家开始动筷。"

# game/rutas/unum.rpy:138
translate chino rutaunum2_0abc63df:

    # "El ambiente es hogareño, más hogareño de lo que tu mente podría imaginar. Y eso te asusta un poco."
    "气氛温馨得超乎你想象，甚至比你能想到的还要温暖。这让你有点害怕。"

# game/rutas/unum.rpy:139
translate chino rutaunum2_7ee85923:

    # "Las esposas de Unum hablan mucho, demasiado... tanto que te cuesta seguirles el hilo, pero a Unum no."
    "Unum的妻子们话很多，多得过分……多到你根本跟不上她们的思路，但Unum却毫无问题。"

# game/rutas/unum.rpy:140
translate chino rutaunum2_73f7e24f:

    # "Él está atento a todo lo que dicen, preguntando de vez en cuando, pero sin llegar a interrumpirlas."
    "他专注地听着她们说的每一句话，偶尔问上几句，却从不打断。"

# game/rutas/unum.rpy:141
translate chino rutaunum2_fee43e29:

    # "Estás anodadado."
    "你有些茫然。"

# game/rutas/unum.rpy:143
translate chino rutaunum2_b3b3edcc:

    # aeliana "Mañana iremos con Duae a ver cómo está el cinturón de Orión."
    aeliana "明天我们会和Duae一起去查看猎户座的腰带。"

# game/rutas/unum.rpy:145
translate chino rutaunum2_e4329893:

    # unum "Hace mucho tiempo que no van."
    unum "你们已经很久没去那里了。"

# game/rutas/unum.rpy:146
translate chino rutaunum2_a0aa4747:

    # unum "... no me gusta que Duae se refiera a ustedes con sus nombre asignados, ustedes ya no son su propiedad..."
    unum "……我不喜欢Duae用那些被分配的名字称呼你们，你们已经不是她的财产了……"

# game/rutas/unum.rpy:148
translate chino rutaunum2_99dc5cc0:

    # solaris "{size=*0.6}Si lo somos...{/size}"
    solaris "{size=*0.6}我们就是……{/size}"

# game/rutas/unum.rpy:151
translate chino rutaunum2_88050d46:

    # ignis "Unum, ya hemos hablado de esto..."
    ignis "Unum，我们已经谈过这个了……"

# game/rutas/unum.rpy:152
translate chino rutaunum2_994105ca:

    # "Unum suelta un quejido, claramente agustiado y soprepasado por la situación."
    "Unum叹了口气，显然被这局面弄得心烦又疲惫。"

# game/rutas/unum.rpy:153
translate chino rutaunum2_65a89011:

    # unum "Es que sigo sin entender como no les molesta."
    unum "我就是想不通，你们怎么一点都不介意。"

# game/rutas/unum.rpy:154
translate chino rutaunum2_c11362ea:

    # unum "Ustedes son libres, ya no están bajo el mandato de nadie."
    unum "你们是自由的，不再听命于任何人。"

# game/rutas/unum.rpy:155
translate chino rutaunum2_253425cd:

    # solaris "Eso solo aplica cuando no está Duae, y aún tenemos responsabilidades."
    solaris "那只适用于Duae不在的时候，而且我们仍然有责任在身。"

# game/rutas/unum.rpy:156
translate chino rutaunum2_bc5977f2:

    # unum "Pero..."
    unum "可是……"

# game/rutas/unum.rpy:159
translate chino rutaunum2_15460f12:

    # aeliana "No nos molesta, Unum."
    aeliana "我们不介意的，Unum。"

# game/rutas/unum.rpy:161
translate chino rutaunum2_a38ed89a:

    # "Aeliana toma la mano de Unum con ternura, y con su pulgar acaricia el dorso de su mano."
    "Aeliana温柔地握住Unum的手，拇指轻轻摩挲他的手背。"

# game/rutas/unum.rpy:162
translate chino rutaunum2_727580d1:

    # "...Unum en cambio se come sus palabras, optando por no discutirles más."
    "……而Unum则把话咽了回去，选择不再跟她们争辩。"

# game/rutas/unum.rpy:164
translate chino rutaunum2_4a7f44c8:

    # "Para cuando terminan, Unum y tú retiran los platos para lavarlos. Mientras que las esposas se despiden y te dan las buenas noches."
    "等大家吃完，Unum和你一起收拾碗筷去洗。妻子们则向你道别，祝你们晚安。"

# game/rutas/unum.rpy:168
translate chino rutaunum2_48f8e2de:

    # unum "Ah... sí."
    unum "啊……是啊。"

# game/rutas/unum.rpy:171
translate chino rutaunum2_d3a9a388:

    # unum "Duae se los pone al crearlas, por lo general solo les pone un número... pero si son brillantes y tienen un buen desempeño, Duae las nombra con honores."
    unum "Duae在创造她们时会给她们起名字，通常只是编个号码……但如果她们天资聪颖、表现优异，Duae就会用荣耀之名来命名她们。"

# game/rutas/unum.rpy:172
translate chino rutaunum2_4d9fe40c:

    # nj "¿Cómo se llamaban?"
    nj "她们叫什么？"

# game/rutas/unum.rpy:173
translate chino rutaunum2_da9cec97:

    # unum "Alnitak, Alnilam y Mintaka."
    unum "Alnitak、Alnilam和Mintaka。"

# game/rutas/unum.rpy:176
translate chino rutaunum2_a3140217:

    # unum "Son nombres bellos, pero son nombres de propiedad."
    unum "这些名字很美，却都是带着归属权的名字。"

# game/rutas/unum.rpy:177
translate chino rutaunum2_ddd77a80:

    # unum "Cuando vinieron conmigo, les pedí que eligeran sus propios nombres."
    unum "她们跟我来的时候，我让她们自己选名字。"

# game/rutas/unum.rpy:178
translate chino rutaunum2_82f58935:

    # nj "Ya veo."
    nj "原来如此。"

# game/rutas/unum.rpy:181
translate chino rutaunum2_6432c15e:

    # unum "Tu nombre..."
    unum "你的名字……"

# game/rutas/unum.rpy:184
translate chino rutaunum2_20710ca2:

    # unum "¿Te lo han impuesto?"
    unum "是别人强加给你的吗？"

# game/rutas/unum.rpy:185
translate chino rutaunum2_b4498675:

    # "{sc=3}El nombre que me has dado cuando estabas con Nulla.... ¿Cuenta como impuesto?{/sc}"
    "{sc=3}你和Nulla在一起时给我的那个名字……算强加的吗？{/sc}"

# game/rutas/unum.rpy:186
translate chino rutaunum2_db49988a:

    # "... desvias el tema para no tener que responder su pregunta. No sabes si Unum comprende la indirecta o no, pero te sigue el juego."
    "……你岔开了话题，回避了他的问题。你不知道Unum有没有听懂这个暗示，但他很配合地顺着你演了下去。"

# game/rutas/unum.rpy:188
translate chino rutaunum2_f8177a80:

    # "Pasan el tiempo conversando de como santificar la comida, Unum te muestra lo que aprendió con una manzana."
    "你们聊着如何祝圣食物，消磨着时间，Unum还用一颗苹果向你展示了他学到的东西。"

# game/rutas/unum.rpy:189
translate chino rutaunum2_fd2daf82:

    # "E increíblemente, ha podido romper el sello."
    "而且令人难以置信的是，他竟然成功打破了封印。"

# game/rutas/unum.rpy:191
translate chino rutaunum2_71e61dc4:

    # "Con una sonrisa que muestra todos sus dientes, te la ofrece."
    "他咧开嘴露出整排牙齿笑着，把苹果递给了你。"

# game/rutas/unum.rpy:194
translate chino rutaunum2_d901a034:

    # "Tomas la manzana y le das un gran mordisco."
    "你接过苹果，狠狠咬了一大口。"

# game/rutas/unum.rpy:195
translate chino rutaunum2_d10b6264:

    # "Luego de mascar, le sonríes mostrando los dientes, al igual que lo hace él."
    "嚼了几口后，你也像他那样咧开嘴笑了笑。"

# game/rutas/unum.rpy:196
translate chino rutaunum2_d9558b4f:

    # "Unum se sonroja y suelta una carcajada."
    "Unum脸红了，放声大笑起来。"

# game/rutas/unum.rpy:199
translate chino rutaunum2_14778374:

    # nj "No gracias."
    nj "不了，谢谢。"

# game/rutas/unum.rpy:201
translate chino rutaunum2_97575fac:

    # "Claramente tu rechazo le afecta, pues su sonrisa se esfuma para soltar un simple {i}oh{i}."
    "你的拒绝显然让他受到了影响，他的笑容烟消云散，只留下一声简单的{i}哦{/i}。"

# game/rutas/unum.rpy:202
translate chino rutaunum2_89e23df4:

    # unum "La dejaré aquí por si te llega a dar hambre."
    unum "我就把它放在这儿，万一你饿了。"

# game/rutas/unum.rpy:204
translate chino rutaunum2_bd07c23c:

    # "Llega el momento en que te sientes cansado, por lo que Unum te lleva a tu habitación."
    "你终究感到了疲惫，于是Unum把你带回了房间。"

# game/rutas/unum.rpy:206
translate chino rutaunum2_836e0045:

    # "Unum te mira por un segundo cuando ya te encuentras cubierto por las sábanas y se acerca repentinamente a ti."
    "你已经躺在被子里，Unum看了你一秒，然后突然凑到你面前。"

# game/rutas/unum.rpy:207
translate chino rutaunum2_ac882bcf:

    # unum "Cuándo duermes, ¿Que se siente?"
    unum "睡着的时候，是什么感觉？"

# game/rutas/unum.rpy:208
translate chino rutaunum2_b4feb9a6:

    # "... te cuesta un poco responder con su cara tan cerca de la tuya."
    "……他的脸离你这么近，你有点回答不上来。"

# game/rutas/unum.rpy:209
translate chino rutaunum2_28eaf5fa:

    # "¿Cómo responderle eso a alguien que no puede o necesita dormir?"
    "你要怎么回答一个不能睡、也不需要睡的人呢？"

# game/rutas/unum.rpy:212
translate chino rutaunum2_a61a1f4a:

    # "Tomas un poco de aire y comienzas a explicar desde como se siente dormir, porqué debes dormir y que pasa durante el sueño."
    "你深吸了一口气，开始从睡着是什么感觉讲起，讲你为什么必须睡觉，以及睡眠中会发生什么。"

# game/rutas/unum.rpy:213
translate chino rutaunum2_b21bb025:

    # "Le explicas la existencia de los sueños, recalcando que no siempre eres capaz de recordar tus sueños."
    "你向他解释梦境的存在，并强调你并不总是能记住自己的梦。"

# game/rutas/unum.rpy:217
translate chino rutaunum2_3b4a2ed7:

    # "No quieres confundirlo y sacar a tema conceptos rebuscados o difíciles de explicar, como las fases del sueño y el porqué existen los sueños."
    "你不想把他搞糊涂，也不想扯到睡眠阶段、梦为何存在这类晦涩难解的概念。"

# game/rutas/unum.rpy:218
translate chino rutaunum2_58505ee1:

    # "Tal vez eso se lo puedas explicar otro día."
    "这些也许可以改天再跟他解释。"

# game/rutas/unum.rpy:219
translate chino rutaunum2_8c168efb:

    # "Así que le respondes solo que que se siente dormir."
    "所以你只回答了他：睡觉是什么感觉。"

# game/rutas/unum.rpy:221
translate chino rutaunum2_a0dd87a4:

    # "Mientras hablas, notas cómo Unum se recuesta en la cama, observándote con los ojos bien abiertos."
    "你说话的时候，注意到Unum仰靠在床头，睁着大大的眼睛注视着你。"

# game/rutas/unum.rpy:222
translate chino rutaunum2_02a5d525:

    # "Su atención está en todo momento sobre ti, está pendiente de cada palabra que pronuncias, tal como lo hizo mientras sus esposas conversaban en la mesa."
    "他的注意力始终全放在你身上，捕捉你说的每一个字，就像先前他在餐桌上听妻子们说话时那样。"

# game/rutas/unum.rpy:223
translate chino rutaunum2_3853d438:

    # "Se ve lindo."
    "他看起来挺可爱的。"

# game/rutas/unum.rpy:224
translate chino rutaunum2_43102250:

    # unum "..."
    unum "..."

# game/rutas/unum.rpy:225
translate chino rutaunum2_acf74fc2:

    # "En un momento, la expresión de Unum se torna a una expresión angustiada."
    "过了一会儿，Unum的神情变得痛苦起来。"

# game/rutas/unum.rpy:226
translate chino rutaunum2_d5b8e348:

    # unum "¿Crees que él bebé pueda soñar?"
    unum "你觉得那个婴儿会做梦吗？"

# game/rutas/unum.rpy:227
translate chino rutaunum2_0a19f3f0:

    # unum "Me gustaría que pudiera experimentar aquello."
    unum "我希望他也能体验那种感觉。"

# game/rutas/unum.rpy:228
translate chino rutaunum2_60eb8398:

    # unum "Suena... liberador."
    unum "听起来……很自由。"

# game/rutas/unum.rpy:231
translate chino rutaunum2_e0e04066:

    # unum "...no."
    unum "……不。"

# game/rutas/unum.rpy:232
translate chino rutaunum2_8b07b611:

    # unum "No estamos configurados como los humanos."
    unum "我们的构造和人类不同。"

# game/rutas/unum.rpy:233
translate chino rutaunum2_e1ed3ebc:

    # unum "No necesitamos descansar y menos soñar."
    unum "我们不需要休息，更不需要做梦。"

# game/rutas/unum.rpy:234
translate chino rutaunum2_b1d1da41:

    # unum "Nuestro único propósito es mantener el orden del jardín."
    unum "我们唯一的目的，就是维持花园的秩序。"

# game/rutas/unum.rpy:235
translate chino rutaunum2_b61c89aa:

    # unum "Por lo que dormir y soñar es una pérdida de tiempo."
    unum "所以睡觉和做梦都是浪费时间。"

# game/rutas/unum.rpy:236
translate chino rutaunum2_94004a03:

    # "Oh."
    "哦。"

# game/rutas/unum.rpy:240
translate chino rutaunum2_1c7480a1:

    # unum "Waaah."
    unum "哇啊。"

# game/rutas/unum.rpy:241
translate chino rutaunum2_72fc075d:

    # unum "¡¿De verdad lo crees?!"
    unum "你真的这么认为吗？！"

# game/rutas/unum.rpy:242
translate chino rutaunum2_8f52f5b8:

    # "Asientes con la cabeza y Unum se abalanza sobre ti para darte un abrazo junto con un beso."
    "你点了点头，Unum立刻扑到你身上，给了你一个拥抱和一个吻。"

# game/rutas/unum.rpy:243
translate chino rutaunum2_a289e2d5:

    # unum "Estoy tan feliz."
    unum "我太开心了。"

# game/rutas/unum.rpy:244
translate chino rutaunum2_cc6accae:

    # "Te asusta un poco que te crea como si lo que dices es la verdad absoluta..."
    "他把你说的每一句话都当成绝对真理，这让你有点害怕……"

# game/rutas/unum.rpy:249
translate chino rutaunum2_a20cefa7_1:

    # "..."
    "..."

# game/rutas/unum.rpy:251
translate chino rutaunum2_40704a2b:

    # "Unum se aclara la garganta, algo avergonzado con su comentario."
    "Unum清了清嗓子，对自己刚才那番话有点不好意思。"

# game/rutas/unum.rpy:252
translate chino rutaunum2_b43697ae:

    # unum "Deberías descansar ahora."
    unum "你现在该休息了。"

# game/rutas/unum.rpy:253
translate chino rutaunum2_ac2129c0:

    # unum "Nos vemos en unas horas."
    unum "过几个小时再见。"

# game/rutas/unum.rpy:254
translate chino rutaunum2_7a42e23b:

    # unum "¡Buenas noches!"
    unum "晚安！"

# game/rutas/unum.rpy:255
translate chino rutaunum2_7dec6509:

    # "Te besa en la frente y se va de la habitación."
    "他在你额头上印下一吻，然后离开了房间。"

# game/rutas/unum.rpy:256
translate chino rutaunum2_0e3a9f2c:

    # "Meditas por un largo tiempo lo conversado con Unum..."
    "你久久地回味着与Unum的这番谈话……"

# game/rutas/unum.rpy:257
translate chino rutaunum2_6d1fd386:

    # "Los nombres aquí son importantes, más importantes de lo que tu creías."
    "在这里，名字是很重要的，比你以为的还要重要。"

# game/rutas/unum.rpy:258
translate chino rutaunum2_19217d03:

    # "Si las esposas de Unum fueron pertenencia de Duae, entonces... los Estandartes también deben pertenecer a alguien."
    "如果Unum的妻子们曾是Duae的所有物，那么……圣旗们也必定属于某个人。"

# game/rutas/unum.rpy:259
translate chino rutaunum2_bc891fad:

    # "¿Ese alguien será Septem?"
    "那个人会是Septem吗？"

# game/rutas/unum.rpy:260
translate chino rutaunum2_adecc83c:

    # "Tal vez mañana deberías preguntar por qué los nombres son tan importantes y porqué Unum no se siente cómodo con nombrar a sus esposas por sus nombres originales."
    "也许明天你应该问问，为什么名字如此重要，以及为什么Unum不习惯用原名来称呼他的妻子们。"

# game/rutas/unum.rpy:261
translate chino rutaunum2_f9f1084b:

    # "Poco a poco vas cerrando los ojos."
    "眼皮一点点合上。"

# game/rutas/unum.rpy:262
translate chino rutaunum2_0802056c:

    # "Y te dejas caer en un sueño profundo."
    "你沉入了深深的睡梦之中。"

# game/rutas/unum.rpy:267
translate chino rutaunum2_a20cefa7_2:

    # "..."
    "..."

# game/rutas/unum.rpy:269
translate chino rutaunum2_4f20e2a2:

    # unum "¡[nombrejugador]!"
    unum "[nombrejugador]！"

# game/rutas/unum.rpy:272
translate chino rutaunum2_50bc8ca4:

    # unum "{size=*2.5}¡[nombrejugador]!{/size}"
    unum "{size=*2.5}[nombrejugador]！{/size}"

# game/rutas/unum.rpy:273
translate chino rutaunum2_22a9c13d:

    # "Dos manos te agarran por los hombros para sacudirte con urgencia."
    "两只手抓住你的肩膀，急切地摇晃着你。"

# game/rutas/unum.rpy:275
translate chino rutaunum2_b73bb00b:

    # unum "Fui a ver al bebé y hay algo raro en él."
    unum "我去看了看婴儿，发现他有点不对劲。"

# game/rutas/unum.rpy:276
translate chino rutaunum2_68a16c5c:

    # "Tienes que parpadear unas cuantas veces para despertar completamente y entender que demonios está diciendo el pelirrojo."
    "你得眨好几次眼才能完全清醒，听清那个红发家伙到底在说什么。"

# game/rutas/unum.rpy:277
translate chino rutaunum2_ee2c6ac2:

    # nj "¿Q- Que?"
    nj "什……什么？"

# game/rutas/unum.rpy:278
translate chino rutaunum2_cbb2875f:

    # unum "Hay algo raro con el bebé."
    unum "婴儿有点不对劲。"

# game/rutas/unum.rpy:280
translate chino rutaunum2_4645edd5:

    # "Sin más aviso que aquello, Unum toma tu mano y te arrastra fuera de la cama."
    "话音刚落，Unum就抓住你的手，把你从床上拽了起来。"

# game/rutas/unum.rpy:281
translate chino rutaunum2_aef3b425:

    # "Unum te explica como puede, entre el panico y los nervios, lo que está pasando con el bebé."
    "Unum在惊慌与紧张中，尽可能向你解释婴儿到底出了什么事。"

# game/rutas/unum.rpy:282
translate chino rutaunum2_9668e2a3:

    # "Pero tú no comprendes nada."
    "可你一点也听不明白。"

# game/rutas/unum.rpy:283
translate chino rutaunum2_c152a037:

    # "Necesitas solo 5 minutos de paz... por favor."
    "你只需要五分钟的安宁……拜托。"

# game/rutas/unum.rpy:284
translate chino rutaunum2_4e9e2bb4:

    # "Solo 5 minutos, para pensar las decisiones que has tomado para haber llegado hasta aquí..."
    "就五分钟，想想你究竟是因为做了哪些决定，才走到了今天这一步……"

# game/rutas/unum.rpy:286
translate chino rutaunum2_0dd00c9b:

    # unum "¿Es normal que se mueva tanto?"
    unum "他动得这么厉害，正常吗？"

# game/rutas/unum.rpy:287
translate chino rutaunum2_d32adf6a:

    # "... ¿¿¿¿Por qué te pregunta esto, sabiendo que ninguno de ustedes dos TIENE IDEA ALGUNA DE COMO FUNCIONA EL DESARROLLO DE UN BEBÉ CREADO CON COMBINACIÓN DE ALMAS?????"
    "……他明明知道你们俩都完全不知道一个由灵魂融合而成的婴儿是如何发育的，为什么还要问你这种问题？？？？"

# game/rutas/unum.rpy:288
translate chino rutaunum2_95a85584:

    # nj "¿¿¿No lo sé???"
    nj "我……我不知道？？？"

# game/rutas/unum.rpy:289
translate chino rutaunum2_f991ec0d:

    # nj "Acaso Sextam no te ha explicado el proceso de desarrollo de esta cosa?"
    nj "Sextam难道没跟你解释过这东西的发育过程吗？"

# game/rutas/unum.rpy:290
translate chino rutaunum2_d993a634:

    # unum "¡¿Cosa?!"
    unum "东西？！"

# game/rutas/unum.rpy:291
translate chino rutaunum2_c29f910d:

    # unum "¡Es un bebé!"
    unum "这是一个婴儿！"

# game/rutas/unum.rpy:292
translate chino rutaunum2_f2d7899c:

    # "...no sabes que es lo hace que el comentario sea más divertido, la cara de Unum o el hecho de que la cosa que está apuntado claramente, no es un bebé."
    "……你分不清是Unum的表情更滑稽，还是他明显指着的那个东西根本不是婴儿这一点更滑稽。"

# game/rutas/unum.rpy:293
translate chino rutaunum2_7479c0f8:

    # "Es una masa transparente que se mueve como si sintiera incomodidad..."
    "那是一团透明的物质，扭动的样子像是正感到不适……"

# game/rutas/unum.rpy:294
translate chino rutaunum2_60eef718:

    # "Y ni siquiera sabes si eso es capaz de sentir o no algo aún."
    "而且你甚至不知道它是否已经具备感知的能力。"

# game/rutas/unum.rpy:295
translate chino rutaunum2_f55cf9fe:

    # unum "Creo que necesita estabilizarse..."
    unum "我想它需要先稳定下来……"

# game/rutas/unum.rpy:296
translate chino rutaunum2_65d86edb:

    # unum "Ambos tenemos que tomarlo."
    unum "我们俩都得接住它。"

# game/rutas/unum.rpy:297
translate chino rutaunum2_4c0ac603:

    # "Esperas que esto se lo haya dicho Sextam y no se lo esté inventando..."
    "你希望这是Sextam告诉他的，而不是他自己编出来的……"

# game/rutas/unum.rpy:298
translate chino rutaunum2_33c47bec:

    # "A medida que se acercan puedes sentir un golpe de calor inmenso, no es agradeble como el calor que transmite el cuerpo de Unum."
    "随着你们靠近，一股巨大的热浪扑面而来，并不像Unum身体散发出的那种温暖那么令人舒服。"

# game/rutas/unum.rpy:299
translate chino rutaunum2_3606a7fe:

    # "No, este calor es insoportable."
    "不，这种热根本让人无法忍受。"

# game/rutas/unum.rpy:307
translate chino rutaunum2_864bc965:

    # "Junto con Unum, ambos colocan sus manos en la masa."
    "你和Unum一起把手放在了那团物质上。"

# game/rutas/unum.rpy:308
translate chino rutaunum2_2ddc2dbd:

    # "Sientes un hormigueo en tus dedos y brazo, pero no te duele ni quema."
    "你的手指和手臂感到一阵刺痛般的麻痒，但既不疼也不烫。"

# game/rutas/unum.rpy:309
translate chino rutaunum2_02d23b18:

    # unum "Esto es como el nacimiento de una estrella..."
    unum "这就像星辰诞生一样……"

# game/rutas/unum.rpy:311
translate chino rutaunum2_ef68f167:

    # "No eres capaz de responder a Unum cuando un destello te nubla los ojos. Es tan brillante que los tienes que cerrar con fuerza para no quedar ciego."
    "一道强光刺痛了你的眼睛，你根本来不及回答Unum。光芒太盛，你只能紧闭双眼，生怕自己被灼瞎。"

# game/rutas/unum.rpy:312
translate chino rutaunum2_ffc1dfa9:

    # "Un calor intenso te rodea y abraza, es como si los rayos del sol se clavaran en tu piel, besándote suavemente por un prolongado tiempo."
    "一股炽热将你环绕、将你拥抱，仿佛阳光刺入你的肌肤，长久而轻柔地亲吻着你。"

# game/rutas/unum.rpy:313
translate chino rutaunum2_f19b1a2c:

    # "Luego, el brillo cesa."
    "随后，光芒消散了。"

# game/rutas/unum.rpy:315
translate chino rutaunum2_fab7bdf1:

    # "Cuando abres los ojos, Unum grita."
    "你睁开眼时，Unum大叫了一声。"

# game/rutas/unum.rpy:316
translate chino rutaunum2_986c69e6:

    # unum "¿Se partió?"
    unum "它裂开了？！"

# game/rutas/unum.rpy:317
translate chino rutaunum2_75b0a17f:

    # "Efectivamente, la masa ya no es una, sino dos."
    "没错，那团物质不再是一团，而是变成了两团。"

# game/rutas/unum.rpy:319
translate chino rutaunum2_a26d38d2:

    # "Escuchas como la puerta se abre de golpe."
    "你听见门被猛地推开。"

# game/rutas/unum.rpy:321
translate chino rutaunum2_68b55203:

    # aeliana "Mi señora Duae, no puede entrar a esta sala sin avisar."
    aeliana "Duae夫人，您不能不打招呼就进这间屋子。"

# game/rutas/unum.rpy:323
translate chino rutaunum2_ca965efe:

    # duae "No quiero que hables, Alnitak."
    duae "我不想让你说话，Alnitak。"

# game/rutas/unum.rpy:324
translate chino rutaunum2_575b507f:

    # "Aeliana hace una mueca de dolor, y sus labios se sellan con fuerza."
    "Aeliana露出痛苦的表情，嘴唇紧紧抿成了一条线。"

# game/rutas/unum.rpy:325
translate chino rutaunum2_863f0d9a:

    # "Unum se gira para ver a Duae entrar por la puerta, seguida de Aeliana."
    "Unum转过身，看见Duae走进门来，Aeliana跟在她身后。"

# game/rutas/unum.rpy:328
translate chino rutaunum2_262b5448:

    # unum "No tienes permiso de darles órdenes en mi dominio."
    unum "在我的领地里，你没有资格对她们发号施令。"

# game/rutas/unum.rpy:329
translate chino rutaunum2_ac3cf74c:

    # unum "Devuélvele el habla ahora mismo."
    unum "立刻把她的声音还给她。"

# game/rutas/unum.rpy:330
translate chino rutaunum2_144259ed:

    # duae "Hmmm. Luego de esto."
    duae "嗯……等这个做完。"

# game/rutas/unum.rpy:331
translate chino rutaunum2_f5f15802:

    # "Duae ignora la orden, para acercarse a ustedes."
    "Duae无视了这道命令，继续朝你们靠近。"

# game/rutas/unum.rpy:332
translate chino rutaunum2_b8dfb3ed:

    # duae "Debo asistir en el nacimiento de estas estrellas binarias."
    duae "我必须协助这两颗双星的诞生。"

# game/rutas/unum.rpy:333
translate chino rutaunum2_101be476:

    # unum "No son tuyas."
    unum "她们不是你的。"

# game/rutas/unum.rpy:334
translate chino rutaunum2_8778e74e:

    # duae "Septem me ha dado órdenes de asistir en todo lo que sea necesario."
    duae "Septem命令我，凡有必要之事都必须到场协助。"

# game/rutas/unum.rpy:335
translate chino rutaunum2_e9f6241e:

    # duae "Y mi asistencia es necesaria ahora, tú no estás calificado para esto..."
    duae "而我此刻的协助是必须的，你又没有资格做这件事……"

# game/rutas/unum.rpy:336
translate chino rutaunum2_55f847ba:

    # "Unum no tiene la oportunidad de rebatir su comentario cuando Duae agrega con algo de veneno en su voz."
    "Unum还没来得及反驳，Duae又开口了，声音里带着几分恶毒。"

# game/rutas/unum.rpy:339
translate chino rutaunum2_debcf7be:

    # duae "Eres muy egocéntrico, siendo que las que te rodean son incluso mejores que tú."
    duae "你也太以自我为中心了，明明身边的人都比你要出色。"

# game/rutas/unum.rpy:340
translate chino rutaunum2_708eacef:

    # duae "Más fuertes y grandes."
    duae "更强大，也更庞大。"

# game/rutas/unum.rpy:343
translate chino rutaunum2_ca09c7fa:

    # unum "Pero no aptos para dar espacio a la vida orgánica."
    unum "却不适合为有机生命腾出空间。"

# game/rutas/unum.rpy:344
translate chino rutaunum2_5a8a9be7:

    # duae "Ja."
    duae "呵。"

# game/rutas/unum.rpy:345
translate chino rutaunum2_a4080811:

    # "Duae quita tu mano de la masa y le pide a Unum espacio para que ella pueda hacer su trabajo."
    "Duae把你的手从那团物质上移开，并向Unum要了些空间，好让她开始动手。"

# game/rutas/unum.rpy:347
translate chino rutaunum2_258ff61c:

    # "Unum a regañadientes da unos pasos atrás junto contigo, cuando considera que están a una distancia prudente, se coloca delante tuyo, cubriendo tu cuerpo con el suyo."
    "Unum不情愿地陪你退后几步，等他认为距离足够安全后，便站到你身前，用自己的身体护住你。"

# game/rutas/unum.rpy:348
translate chino rutaunum2_0058e9db:

    # "Supones que debe ser por protección."
    "你想这应该是为了保护你。"

# game/rutas/unum.rpy:350
translate chino rutaunum2_28e9f439:

    # "Duae coloca ambas manos en cada una de las masas, y de un solo jalón se forma un brillo mucho más brillante que el anterior."
    "Duae把双手分别按在两团物质上，只一拽，便爆发出一道比之前强烈得多的光芒。"

# game/rutas/unum.rpy:352
translate chino rutaunum2_db3cf2c9:

    # "Unum te cubre los ojos con su brazo."
    "Unum用手臂挡住了你的眼睛。"

# game/rutas/unum.rpy:353
translate chino rutaunum2_8c25c5a2:

    # "Hay un silencio sepulcral luego de aquello, y la temperatura que hay ahora en la sala es insoportable."
    "随后是一片死寂，屋里的温度也变得让人无法忍受。"

# game/rutas/unum.rpy:354
translate chino rutaunum2_a20cefa7_3:

    # "..."
    "..."

# game/rutas/unum.rpy:355
translate chino rutaunum2_43725154:

    # "Y el llanto de un bebe lo rompe, seguido por otro mucho más débil."
    "婴儿的啼哭打破了寂静，紧接着是另一阵更微弱的哭声。"

# game/rutas/unum.rpy:356
translate chino rutaunum2_4735bba0:

    # duae "¿Qué es esto?"
    duae "这是什么东西？"

# game/rutas/unum.rpy:358
translate chino rutaunum2_82d51297:

    # "Como si de un pescador se tratase, Duae sujeta a dos criaturas por los pies, ambas lloran por la posición en la que están."
    "Duae就像个渔夫似的，倒提着两只生物的脚，两只小家伙都因这个姿势哭个不停。"

# game/rutas/unum.rpy:359
translate chino rutaunum2_73c05aa1:

    # "Sientes como sudas, y tu visión comienza a nublarse. El aire que respiras es caliente y no hace más que desesperarte con el pasar de los segundos."
    "你感到自己在出汗，视线也开始模糊。你呼吸的空气滚烫，随着时间流逝，只让你越来越绝望。"

# game/rutas/unum.rpy:360
translate chino rutaunum2_95d37e13:

    # unum "¡Así no se toman, bruta!"
    unum "你这样抱是不对的，蠢货！"

# game/rutas/unum.rpy:361
translate chino rutaunum2_bb1e920e:

    # duae "..."
    duae "..."

# game/rutas/unum.rpy:363
translate chino rutaunum2_6e1f1d65:

    # "Anodadada Duae entrega a las dos entidades en los brazos de Unum. Quien las toma como es debido tomar a un bebé humano."
    "Duae一时呆住了，把两只存在交到了Unum怀里。Unum则像抱着人类婴儿那样，把它们妥帖地接了过来。"

# game/rutas/unum.rpy:364
translate chino rutaunum2_0e3637cf:

    # duae "¿Esto es un humano?"
    duae "这是人类吗？"

# game/rutas/unum.rpy:365
translate chino rutaunum2_d0b6ae07:

    # unum "No, híbridos."
    unum "不，是混血种。"

# game/rutas/unum.rpy:366
translate chino rutaunum2_c148150b:

    # duae "Pensé que de aquí saldría un dios ya listo para tomar su rango."
    duae "我原以为这里会诞生一个已经可以就位的神明。"

# game/rutas/unum.rpy:367
translate chino rutaunum2_ce120adc:

    # duae "No esto."
    duae "不是这种东西。"

# game/rutas/unum.rpy:368
translate chino rutaunum2_aa735c6f:

    # unum "... eso da igual."
    unum "……那都无所谓。"

# game/rutas/unum.rpy:369
translate chino rutaunum2_d626f3c0:

    # duae "Supongo que Septem está al tanto de que jugarás a ser humano..."
    duae "我想Septem知道你在玩扮演人类的游戏……"

# game/rutas/unum.rpy:370
translate chino rutaunum2_3d6e5abc:

    # "Duae observa a las pequeñas entidades en los brazos de Unum. El ambiente está tenso."
    "Duae注视着Unum怀中的两只小存在，气氛一片紧张。"

# game/rutas/unum.rpy:371
translate chino rutaunum2_47c1f104:

    # duae "Son tuyos, debes ponerles un nombre."
    duae "它们是你的，你得给它们起名字。"

# game/rutas/unum.rpy:372
translate chino rutaunum2_ed9e375f:

    # duae "Ahora."
    duae "现在。"

# game/rutas/unum.rpy:374
translate chino rutaunum2_d4db22ac:

    # "Ya no aguantas más y Unum parece darse cuenta de lo mal que te encuentras. Con nervisos asomandose en su voz, te pide salir de la sala por un momento."
    "你再也撑不住了，Unum似乎也察觉到你状态不对。他声音里透着紧张，请你先出去一会儿。"

# game/rutas/unum.rpy:375
translate chino rutaunum2_6f136585:

    # "Indicando que salgas al jardín para que tomes aire."
    "他示意你去花园里透透气。"

# game/rutas/unum.rpy:377
translate chino rutaunum2_db471cc5:

    # "Y tú lo haces sin chistar."
    "而你也照做了，一句话也没抱怨。"

# game/rutas/unum.rpy:379
translate chino rutaunum2_fd85b4ad:

    # "Caminas con dificultad hacia la puerta que conduce al jardín y te sientas en una de las bancas cercanas."
    "你拖着沉重的步伐走向通往花园的门，在附近的一张长椅上坐下。"

# game/rutas/unum.rpy:382
translate chino rutaunum2_7f5832e6:

    # "Respiras hondo y cierras los ojos..."
    "你深吸一口气，闭上了眼睛……"

# game/rutas/unum.rpy:383
translate chino rutaunum2_4ebfd80b:

    # "Aquí el aire es fresco y no te da la sensación de quemarte los pulmones al inspirar."
    "这里空气清新，你吸气时不再觉得肺在燃烧。"

# game/rutas/unum.rpy:386
translate chino rutaunum2_cd5e4065:

    # "Miras tus manos y hay algo que te está comenzando a preocupar..."
    "你望向自己的双手，有什么东西开始让你担心起来……"

# game/rutas/unum.rpy:387
translate chino rutaunum2_bdba6663:

    # "No es el color de ellas, pues Septem también tiene esas marcas, no... lo que te preocupa es que has comenzado a sentir menos en ellas."
    "不是它们的颜色，因为Septem也有那些印记……不，让你担心的是，你开始在它们身上感觉到的东西越来越少了。"

# game/rutas/unum.rpy:388
translate chino rutaunum2_c690ac7e:

    # "No tienes sensación en las yemas de tus dedos, la sensibilidad en esa zona es casi inexistente."
    "你的指尖已经没有感觉了，那一片区域的灵敏度几乎为零。"

# game/rutas/unum.rpy:389
translate chino rutaunum2_428f11f7:

    # "Si bien puedes mover tus dedos, algo dentro de ti te dice que tarde o temprano dejarás de tener ese beneficio."
    "虽然你还能活动手指，但内心有个声音告诉你，迟早你也会失去这种能力。"

# game/rutas/unum.rpy:390
translate chino rutaunum2_4e25c72a:

    # "Si le comunicas esto a Unum, ¿podrá ayudarte?"
    "如果把这件事告诉Unum，他能帮你吗？"

# game/rutas/unum.rpy:391
translate chino rutaunum2_ff491738:

    # "Sinceramente, ahora Unum no parece ser tan aterrador, pero crees que es porque ya llevas algo de tiempo con él, entonces puede que ya te hayas acostumbrado a su extraña presencia y personalidad."
    "说实话，Unum现在看起来已经没那么可怕了。但你觉得，那是因为你已经和他相处了一段时间，可能已经习惯了他那古怪的存在感和性格。"

# game/rutas/unum.rpy:392
translate chino rutaunum2_a0ad42c4:

    # "No es malo... solo extraño y algo violento cuando tiene hambre."
    "他不算坏……只是有点古怪，饿了的时候还会有点暴力……"

# game/rutas/unum.rpy:393
translate chino rutaunum2_5e7edd39:

    # "¿Será viable quedarte aquí?"
    "留在这里，对你来说可行吗？"

# game/rutas/unum.rpy:394
translate chino rutaunum2_59d99da1:

    # "Si intentas escapar... ¿tendrás alguna otra opción de sobrevivir?"
    "如果你试图逃走……还有别的活路吗？"

# game/rutas/unum.rpy:401
translate chino rutaunum2_eecc0134:

    # "Sí, es lo mejor dentro de tus posibilidades."
    "没错，这已经是你所有选择里最好的一条了。"

# game/rutas/unum.rpy:402
translate chino rutaunum2_e5f4e598:

    # "No conoces que hay más allá de este jardín, ni menos como es el mundo o sociedad allá afuera."
    "你不知道这座花园之外是什么，更不清楚外面的世界或社会是什么样子。"

# game/rutas/unum.rpy:403
translate chino rutaunum2_45e2a0d6:

    # "Para colmo: {i}apestas a humano{i}, según lo que has visto y escuchado, y eso no es bueno para ti."
    "更糟糕的是：{i}你浑身都是人类的味道{/i}——这是你亲眼所见、亲耳所闻的——而这对你没好处。"

# game/rutas/unum.rpy:404
translate chino rutaunum2_79ecb2cb:

    # "Eres una presa fácil."
    "你是个容易下手的猎物。"

# game/rutas/unum.rpy:405
translate chino rutaunum2_7635ee51:

    # el "{sc=2}¿Ya tienes permiso de estar afuera?{/sc}"
    el "{sc=2}你已经得到待在外面的许可了吗？{/sc}"

# game/rutas/unum.rpy:406
translate chino rutaunum2_197c8560:

    # "Conoces esa voz..."
    "你认得这个声音……"

# game/rutas/unum.rpy:408
translate chino rutaunum2_ab2187ef:

    # "Subes la mirada y vez como Septem se encuentra parado a tú lado, mirando por sobre tu hombro."
    "你抬起目光，看见Septem正站在你身旁，越过你的肩膀往里看。"

# game/rutas/unum.rpy:413
translate chino rutaunum2_8bce32f2:

    # septem "{sc=2}¿Quien te dio el derecho de hacer preguntas?{/sc}"
    septem "{sc=2}谁给你提问的权利了？{/sc}"

# game/rutas/unum.rpy:414
translate chino rutaunum2_fa5c5550:

    # "Septem sonríe dulcemente, pero su voz no refleja su expresión."
    "Septem温柔地笑着，声音却与他的表情截然不同。"

# game/rutas/unum.rpy:415
translate chino rutaunum2_afbf235b:

    # "Suena molesto."
    "他听起来有些不悦。"

# game/rutas/unum.rpy:418
translate chino rutaunum2_4c46ac4b:

    # septem "{sc=2}Responde mi pregunta.{/sc}"
    septem "{sc=2}回答我的问题。{/sc}"

# game/rutas/unum.rpy:419
translate chino rutaunum2_0eb06432:

    # nj "..."
    nj "..."

# game/rutas/unum.rpy:423
translate chino rutaunum2_69f7c82f:

    # nj "Buenos días..."
    nj "早上好……"

# game/rutas/unum.rpy:424
translate chino rutaunum2_4fee9170:

    # "Septem sonríe complacido."
    "Septem满意地笑了。"

# game/rutas/unum.rpy:427
translate chino rutaunum2_4c46ac4b_1:

    # septem "{sc=2}Responde mi pregunta.{/sc}"
    septem "{sc=2}回答我的问题。{/sc}"

# game/rutas/unum.rpy:428
translate chino rutaunum2_ccbcf73f:

    # "¡Oh! cierto."
    "哦！对。"

# game/rutas/unum.rpy:436
translate chino rutaunum2_916fe3da:

    # nj "Unum me ha pedido que salga a tomar aire."
    nj "Unum让我出来透透气。"

# game/rutas/unum.rpy:437
translate chino rutaunum2_552adf4d:

    # nj "La habitación en que estábamos no era muy agradable."
    nj "我们刚才待的那间屋子不太舒服。"

# game/rutas/unum.rpy:440
translate chino rutaunum2_e9a5f945:

    # septem "{sc=2}Me imagino... {/sc}"
    septem "{sc=2}我想象得到……{/sc}"

# game/rutas/unum.rpy:441
translate chino rutaunum2_dcc95458:

    # septem "{sc=2}Los humanos no pueden resistir el poder de tantas estrellas por mucho tiempo.{/sc}"
    septem "{sc=2}人类承受不住这么多星辰的力量太久。{/sc}"

# game/rutas/unum.rpy:442
translate chino rutaunum2_b38df427:

    # septem "{sc=2}Menos de estrellas recién creadas.{/sc}"
    septem "{sc=2}更别说刚刚诞生的星辰了。{/sc}"

# game/rutas/unum.rpy:443
translate chino rutaunum2_e03130d2:

    # septem "{sc=2}Si no hubieras salido, seguramente estarías ya muerto.{/sc}"
    septem "{sc=2}要是你刚才没出来，现在恐怕已经没命了。{/sc}"

# game/rutas/unum.rpy:444
translate chino rutaunum2_bb3bf3cd:

    # "Quieres preguntar si ha venido a ver a los híbridos, pero tienes miedo de como él pueda reaccionar."
    "你想问是不是他来看那些混血种，但又害怕他会作何反应。"

# game/rutas/unum.rpy:447
translate chino rutaunum2_3b44b3ff:

    # septem "{sc=2}Vamos a verlos.{/sc}"
    septem "{sc=2}我们去看看它们。{/sc}"

# game/rutas/unum.rpy:448
translate chino rutaunum2_df3f0913:

    # nj "¿A los híbridos de Unum?"
    nj "是Unum的混血种？"

# game/rutas/unum.rpy:451
translate chino rutaunum2_0aff9afe:

    # septem "{sc=2}Son tuyos también.{/sc}"
    septem "{sc=2}他们也是你的。{/sc}"

# game/rutas/unum.rpy:460
translate chino rutaunum2_d88846e3:

    # septem "{sc=2}Hmmm, no fue una pregunta.{/sc}"
    septem "{sc=2}嗯……这不是一个问题。{/sc}"

# game/rutas/unum.rpy:461
translate chino rutaunum2_5c9a2061:

    # septem "{sc=2}Vamos.{/sc}"
    septem "{sc=2}走吧。{/sc}"

# game/rutas/unum.rpy:464
translate chino rutaunum2_edbfa336:

    # "El camino de vuelta es incómodo, Septem no hace esfuerzo alguno por entablar una conversación y tú estás seguro de que si hablas primero, y sin permiso, él se enojará."
    "回去的路上气氛很尴尬，Septem完全不打算攀谈，而你确信，如果没得到他的允许你先开口，他会生气。"

# game/rutas/unum.rpy:465
translate chino rutaunum2_3bc70022:

    # "Dentro de la residencia de Unum se encuentran con sus esposas, quienes están fuera de la habitación."
    "在Unum的宅邸里，你们遇见了他的妻子们，她们正守在房间外面。"

# game/rutas/unum.rpy:466
translate chino rutaunum2_d849b822:

    # "Al notar la presencia de Septem, las tres agachan la cabeza a modo de saludo."
    "察觉到Septem的出现，三人都低下头表示问候。"

# game/rutas/unum.rpy:468
translate chino rutaunum2_e8fd37e3:

    # septem "{sc=2}Alnitak ¿Se ha estabilizado la situación?{/sc}"
    septem "{sc=2}Alnitak，情况稳定下来了吗？{/sc}"

# game/rutas/unum.rpy:469
translate chino rutaunum2_09c21fb1:

    # "Aeliana no responde y Septem parece darse cuenta del porqué, ya que con sus manos hace unas señas."
    "Aeliana没有回答，Septem似乎明白了原因，因为他用手势比划了几下。"

# game/rutas/unum.rpy:470
translate chino rutaunum2_f9bb6d4c:

    # "Sus labios dejan de estar tensos y ella responde."
    "她的嘴唇放松下来，开口回答。"

# game/rutas/unum.rpy:472
translate chino rutaunum2_628c3c9e:

    # aeliana "La señora Duae ha estabilizado a las nuevas estrellas."
    aeliana "Duae夫人已经让新的星辰稳定下来了。"

# game/rutas/unum.rpy:473
translate chino rutaunum2_7d182e3a:

    # aeliana "Ya es seguro para [nombrejugador]."
    aeliana "对[nombrejugador]来说已经安全了。"

# game/rutas/unum.rpy:476
translate chino rutaunum2_5064d46d:

    # septem "{sc=2}Bien.{/sc}"
    septem "{sc=2}很好。{/sc}"

# game/rutas/unum.rpy:479
translate chino rutaunum2_7dde6919:

    # "La puerta de la habitación se abre por si sola y Septem se abre paso por la habitación."
    "房间的门自行打开，Septem走进了房间。"

# game/rutas/unum.rpy:481
translate chino rutaunum2_fffe0b43:

    # septem "{sc=2}Duae. Unum.{/sc}"
    septem "{sc=2}Duae。Unum。{/sc}"

# game/rutas/unum.rpy:484
translate chino rutaunum2_57c81642:

    # septem "{sc=2}Les recuerdo que es primordial que [nombrejugador] esté en los momentos más cruciales.{/sc}"
    septem "{sc=2}我提醒你们，[nombrejugador]在最关键的时刻必须在场。{/sc}"

# game/rutas/unum.rpy:485
translate chino rutaunum2_1d39ab6b:

    # septem "{sc=2}No volveré a tolerar que le saparen de ellos.{/sc}"
    septem "{sc=2}我不会再容忍他们再次被从你们身边带走。{/sc}"

# game/rutas/unum.rpy:486
translate chino rutaunum2_b18abea2:

    # "Duae se enderesa completamente, como si de un soldado de bajo rango viera entrar a su general."
    "Duae立刻站得笔直，就像一个低阶士兵见到将军到来。"

# game/rutas/unum.rpy:488
translate chino rutaunum2_46e5c82e:

    # duae "Septem, mil disculpas."
    duae "Septem，万分抱歉。"

# game/rutas/unum.rpy:490
translate chino rutaunum2_b9b0fef5:

    # unum "Le pedí que saliera porque la energía de todos está muy condensada en esta habitación."
    unum "我让她出去，是因为这房间里的能量太过浓重。"

# game/rutas/unum.rpy:493
translate chino rutaunum2_45d16377:

    # septem "{sc=2}Lo sé. Pero yo necesito que [nombrejugador] esté observando el desarrollo de ambos dioses.{/sc}"
    septem "{sc=2}我知道。但我需要[nombrejugador]在场，观察这两位神明的发育。{/sc}"

# game/rutas/unum.rpy:494
translate chino rutaunum2_19423a7c:

    # septem "¿Ya están estables?"
    septem "他们稳定下来了吗？"

# game/rutas/unum.rpy:495
translate chino rutaunum2_739ea829:

    # duae "Sí."
    duae "是的。"

# game/rutas/unum.rpy:496
translate chino rutaunum2_50271c02:

    # septem "{sc=2}Okay. Duae, nos retiramos ahora.{/sc}"
    septem "{sc=2}好。Duae，我们这就走。{/sc}"

# game/rutas/unum.rpy:497
translate chino rutaunum2_32cba2a8:

    # septem "{sc=2}Unum.{/sc}"
    septem "{sc=2}Unum。{/sc}"

# game/rutas/unum.rpy:498
translate chino rutaunum2_67c7a600:

    # unum "¿Sí?"
    unum "什么事？"

# game/rutas/unum.rpy:501
translate chino rutaunum2_2e4c8762:

    # septem "{sc=2}Quiero una audiencia contigo en la noche.{/sc}"
    septem "{sc=2}今晚我要与你单独会面。{/sc}"

# game/rutas/unum.rpy:504
translate chino rutaunum2_07007670:

    # "Sin nada más que agregar, Septem se retira de la habitación con Duae."
    "Septem没有再多说什么，与Duae一同离开了房间。"

# game/rutas/unum.rpy:505
translate chino rutaunum2_c574fa64:

    # "Unum no se mueve hasta sentir que ambos Estandartes se encuentran lejos."
    "Unum一动不动，直到感觉两位圣旗都已经走远。"

# game/rutas/unum.rpy:509
translate chino rutaunum2_afb157d6:

    # "Luego esboza una sonrisa."
    "然后，他露出一丝笑容。"

# game/rutas/unum.rpy:510
translate chino rutaunum2_b8d0b611:

    # unum "¡Mira!"
    unum "看！"

# game/rutas/unum.rpy:513
translate chino rutaunum2_d144f9c5:

    # "Se acerca a ti con ambas criaturas en los brazos."
    "他怀里抱着两只生物，朝你走来。"

# game/rutas/unum.rpy:514
translate chino rutaunum2_3ff20d31:

    # unum "Tienen un pulso al igual que tú."
    unum "它们和你一样，有脉搏。"

# game/rutas/unum.rpy:515
translate chino rutaunum2_caac6f86:

    # unum "Aunque tienen una frecuencia cardiaca muy diferente a la tuya."
    unum "只不过它们的心率和你截然不同。"

# game/rutas/unum.rpy:516
translate chino rutaunum2_498306e6:

    # unum "¡Son tan lindos!"
    unum "它们太可爱了！"

# game/rutas/unum.rpy:517
translate chino rutaunum2_26903031:

    # unum "Aún no los puedes tomar, su cuerpo aún está muy caliente."
    unum "你还暂时不能抱它们，它们的身体还太烫了。"

# game/rutas/unum.rpy:518
translate chino rutaunum2_e079eb2b:

    # unum "Te puedes quemar tus manos."
    unum "会烫伤你的手的。"

# game/rutas/unum.rpy:519
translate chino rutaunum2_94004a03_1:

    # "Oh."
    "哦。"

# game/rutas/unum.rpy:520
translate chino rutaunum2_85e4464a:

    # "Bueno, te conformarás con mirarlos de cerca."
    "好吧，你就只能凑近看看它们了。"

# game/rutas/unum.rpy:521
translate chino rutaunum2_5e99e025:

    # "Cuando acercas tu cara, te das cuenta nuevamente del calor que el cuerpo de ambos bebés transmite."
    "当你凑近脸时，再次感受到了两个婴儿身体散发的热度。"

# game/rutas/unum.rpy:522
translate chino rutaunum2_dfa94138:

    # nj "¿Cómo se llaman?"
    nj "它们叫什么名字？"

# game/rutas/unum.rpy:523
translate chino rutaunum2_43102250_1:

    # unum "..."
    unum "..."

# game/rutas/unum.rpy:524
translate chino rutaunum2_5f486fa5:

    # unum "Me gustaria esperar a que sea lo suficientemente grandes para que elijan sus propios nombres."
    unum "我想等它们大一点，能自己选名字的时候再说。"

# game/rutas/unum.rpy:525
translate chino rutaunum2_65bec9e9:

    # nj "¿Por qué?"
    nj "为什么？"

# game/rutas/unum.rpy:526
translate chino rutaunum2_d9e19abb:

    # unum "Quiero que sean libres."
    unum "我希望它们是自由的。"

# game/rutas/unum.rpy:527
translate chino rutaunum2_5b0636df:

    # unum "Que hagan lo que quieran hasta..."
    unum "让它们随心所欲，直到……"

# game/rutas/unum.rpy:528
translate chino rutaunum2_7887e408:

    # "Unum cierra su boca antes de terminar la frase."
    "Unum没把话说完，就闭了口。"

# game/rutas/unum.rpy:529
translate chino rutaunum2_626a601e:

    # "Y luego ríe nervioso."
    "然后他紧张地笑了笑。"

# game/rutas/unum.rpy:530
translate chino rutaunum2_532d8aa6:

    # unum "Septem dijo que crecerán rápido."
    unum "Septem说它们会长得很快。"

# game/rutas/unum.rpy:531
translate chino rutaunum2_097415b2:

    # unum "Posiblemente mañana ya no sean así de pequeñitos."
    unum "也许到明天，它们就不会这么小小的了。"

# game/rutas/unum.rpy:532
translate chino rutaunum2_a20cefa7_4:

    # "..."
    "..."

# game/rutas/unum.rpy:534
translate chino rutaunum2_49f71e47:

    # "Pasan gran parte del tiempo cuidando de los bebés."
    "你们把大部分时间都花在照顾婴儿上。"

# game/rutas/unum.rpy:535
translate chino rutaunum2_0a771cc9:

    # "Bueno.. tú le das instrucciones a Unum para los cuidados, ya que aún no puedes tocarlos."
    "好吧……你就负责给Unum打下手，告诉他该怎么照顾，因为你还是没法直接碰它们。"

# game/rutas/unum.rpy:536
translate chino rutaunum2_697d208b:

    # "...y lo has comprobado por ti mismo, cuando intentaste tocar la mejilla de uno de ellos. Te quemaste la mano."
    "……这一点你已经亲身验证过了——当你试着去碰其中一个的脸颊时，手就被烫伤了。"

# game/rutas/unum.rpy:537
translate chino rutaunum2_df219f40:

    # "Unum casi llama a Quinque para que viniera a curarte, pero tú le has dicho que no es necesario."
    "Unum差点就要叫Quinque来给你治疗，但你说没必要。"

# game/rutas/unum.rpy:538
translate chino rutaunum2_c89610ab:

    # "Cuando llega la noche, Unum se excusa con que debe hacer algo importante y se lleva a ambos bebés consigo."
    "夜幕降临时，Unum借口有要紧事要做，带着两个婴儿离开了。"

# game/rutas/unum.rpy:539
translate chino rutaunum2_45b8b25e:

    # "Te pide que descanses y duermas para que mañana tengas todas tus energías."
    "他让你好好休息、睡觉，这样明天你才有充足的精力。"

# game/rutas/unum.rpy:540
translate chino rutaunum2_cbc5d701:

    # "Así que descansas."
    "于是你休息了。"

# game/rutas/unum.rpy:542
translate chino rutaunum2_a20cefa7_5:

    # "..."
    "..."

# game/rutas/unum.rpy:544
translate chino rutaunum2_870d17f8:

    # "Hoy sueñas."
    "今天你做梦了。"

# game/rutas/unum.rpy:545
translate chino rutaunum2_f1e3fba5:

    # "Por primera vez en tu corta existencia este mundo."
    "这是你在这个小小世界短暂的存在中，第一次做梦。"

# game/rutas/unum.rpy:546
translate chino rutaunum2_8bacc769:

    # "Estás en un lugar oscuro."
    "你身处一个黑暗的地方。"

# game/rutas/unum.rpy:547
translate chino rutaunum2_60fba90c:

    # "Y se escucha una voz."
    "然后，你听见了一个声音。"

# game/rutas/unum.rpy:548
translate chino rutaunum2_2a0dd69c:

    # "Pero no logras identificar que es lo que dice."
    "但你听不清它在说什么。"

# game/rutas/unum.rpy:549
translate chino rutaunum2_a20cefa7_6:

    # "..."
    "..."

# game/rutas/unum.rpy:551
translate chino rutaunum2_6e2b36cb:

    # "No sabes cómo ni cuándo, pero ya es el otro día."
    "你不知道是怎么、也不知何时，但已经是第二天了。"

# game/rutas/unum.rpy:554
translate chino rutaunum2_695da15a:

    # "Y lo primero que miras al abrir los ojos son tus manos."
    "你睁开眼看见的第一样东西，就是你的双手。"

# game/rutas/unum.rpy:555
translate chino rutaunum2_4513ef06:

    # "El negro se ha comido más piel..."
    "黑色又吞噬了更多皮肤……"

# game/rutas/unum.rpy:557
translate chino rutaunum2_fd0a610d:

    # "Lo segundo que tus ojos ven es a Unum recostado a tu lado, mirándote con mucha atención."
    "你的眼睛看到的第二样东西，是躺在你身旁、正专注凝视着你的Unum。"

# game/rutas/unum.rpy:559
translate chino rutaunum2_52cf7a6d:

    # unum "Eres una criatura asombrosa."
    unum "你真是个惊人的生物。"

# game/rutas/unum.rpy:560
translate chino rutaunum2_4bc84aa1:

    # unum "Jamás creí que podría ser esposo de un humano."
    unum "我从未想过，自己竟能成为一个人类的丈夫。"

# game/rutas/unum.rpy:561
translate chino rutaunum2_853842b0:

    # "¿Esposo?"
    "丈夫？"

# game/rutas/unum.rpy:562
translate chino rutaunum2_95ca30d2:

    # "¿Cuántos pasos se ha saltado este hombre?"
    "这家伙到底跳过了多少个步骤？"

# game/rutas/unum.rpy:563
translate chino rutaunum2_39cb9abf:

    # "¿Desde cuándo él piensa que ustedes están en una relación? ¿Será así con todos los estandartes o es solo Unum quien no tiene idea de como funcionan las relaciones?"
    "他是从什么时候开始认为你们在交往的？是所有圣旗都这样，还是只有Unum一个人完全不懂恋爱是怎么一回事？"

# game/rutas/unum.rpy:564
translate chino rutaunum2_6960d4ae:

    # "Sueltas una risa por lo extraño que te parece estar en esta relación."
    "你觉得身处这段关系中实在太荒诞，不禁笑出了声。"

# game/rutas/unum.rpy:566
translate chino rutaunum2_8f58de10:

    # "Unum te mira confundido."
    "Unum困惑地看着你。"

# game/rutas/unum.rpy:570
translate chino rutaunum2_a431e742:

    # unum "¿No somos ya?"
    unum "我们难道不是吗？"

# game/rutas/unum.rpy:571
translate chino rutaunum2_eeefef64:

    # "No puedes evitar dejar salir la carcajada que se forma en tu garganta."
    "你忍不住让喉咙里涌起的笑声释放了出来。"

# game/rutas/unum.rpy:572
translate chino rutaunum2_4b041256:

    # unum "Pero si hasta ya hemos tenido descendencia... y vives conmigo."
    unum "可我们甚至已经有了后代……你还和我住在一起。"

# game/rutas/unum.rpy:573
translate chino rutaunum2_69b86eb6:

    # unum "Según lo que he leído, eso es más que suficiente para llamarnos esposos."
    unum "照我读过的说法，这已经足够让我们称作夫妻了。"

# game/rutas/unum.rpy:574
translate chino rutaunum2_7c382ca5:

    # "Vuelves a soltar otra risa."
    "你又笑了出来。"

# game/rutas/unum.rpy:575
translate chino rutaunum2_85703d1a:

    # unum "¡No te rias!"
    unum "别笑！"

# game/rutas/unum.rpy:576
translate chino rutaunum2_e6a69475:

    # nj "¡Está bien! ¡está bien!"
    nj "好！好！"

# game/rutas/unum.rpy:577
translate chino rutaunum2_3dcae893:

    # nj "No sé cómo serán las relaciones de la gente del jardín... pero los humanos necesitamos tiempo y acuerdos para llegar a tener ese título."
    nj "我不知道花园里的人们是怎样恋爱的……但我们人类需要时间和约定，才能走到拥有那个名分的地步。"

# game/rutas/unum.rpy:578
translate chino rutaunum2_89abb2ff_1:

    # unum "Oh."
    unum "哦。"

# game/rutas/unum.rpy:579
translate chino rutaunum2_a7e57ce8:

    # unum "¿Me podrías explicar?"
    unum "能跟我解释一下吗？"

# game/rutas/unum.rpy:580
translate chino rutaunum2_8390df35:

    # unum "Aquí no hay ningún libro que te explique eso."
    unum "这里没有任何一本书能向你解释这件事。"

# game/rutas/unum.rpy:581
translate chino rutaunum2_b862c9c2:

    # "No tienes problemas con explicarle lo que se necesita para convertirse en 'esposos' a Unum, aunque recalcas que para todos es distinto."
    "你毫不介意地向Unum解释，要成为『夫妻』需要些什么，同时强调这对每个人来说都不一样。"

# game/rutas/unum.rpy:583
translate chino rutaunum2_8d054313:

    # unum "Mmm."
    unum "嗯。"

# game/rutas/unum.rpy:584
translate chino rutaunum2_9af500f7:

    # unum "Si me esfuerzo... ¿Podría ser yo tu esposo?"
    unum "如果我努力……我能成为你的丈夫吗？"

# game/rutas/unum.rpy:588
translate chino rutaunum2_d4a8f869:

    # "Unum sonríe mostrando todos sus dientes, victorioso."
    "Unum咧开嘴露出所有牙齿，得意地笑了。"

# game/rutas/unum.rpy:591
translate chino rutaunum2_0e6e8397:

    # "Unum sonrie."
    "Unum笑着。"

# game/rutas/unum.rpy:594
translate chino rutaunum2_89abb2ff_2:

    # unum "Oh."
    unum "哦。"

# game/rutas/unum.rpy:597
translate chino rutaunum2_a59e8cb5:

    # "No te da el corazón para corregirlo."
    "你于心不忍，没有去纠正他。"

# game/rutas/unum.rpy:598
translate chino rutaunum2_f345179f:

    # "Que crea lo que quiera creer."
    "就让他想相信什么就相信什么吧。"

# game/rutas/unum.rpy:600
translate chino rutaunum2_43102250_2:

    # unum "..."
    unum "..."

# game/rutas/unum.rpy:603
translate chino rutaunum2_1055a640:

    # unum "Quería mostrarte el resto de mi dominio hoy, pero Septem dijo que es peligroso que salgas."
    unum "我本想今天带你去看看我领地的其他部分，但Septem说你出去太危险了。"

# game/rutas/unum.rpy:604
translate chino rutaunum2_249f6558:

    # unum "Así que nos tendremos que quedar en el templo hasta que las estrellas hayan crecido."
    unum "所以我们只能待在神殿里，直到星辰长大。"

# game/rutas/unum.rpy:605
translate chino rutaunum2_c74f84cd:

    # unum "No quiero perderme nada, ningún momento de su desarrollo."
    unum "我不想错过任何事，不想错过它们发育的任何一刻。"

# game/rutas/unum.rpy:606
translate chino rutaunum2_5a7eead7:

    # nj "¿Estás emocionado?"
    nj "你很兴奋吗？"

# game/rutas/unum.rpy:607
translate chino rutaunum2_3f8d2e0e:

    # unum "¡Claro! Además, te tengo a mi lado, lo que lo hace aún mejor."
    unum "当然！而且有你陪在我身边，就更棒了。"

# game/rutas/unum.rpy:608
translate chino rutaunum2_9867c2bd:

    # unum "Somos como las familias que Sextam adoraba ver crecer."
    unum "我们就像Sextam最喜欢看着成长的那些家庭一样。"

# game/rutas/unum.rpy:609
translate chino rutaunum2_9df6227f:

    # unum "¡Oh! Podríamos invitarla cuando deje sus rezos."
    unum "哦！等她做完祈祷，我们可以邀请她来。"

# game/rutas/unum.rpy:611
translate chino rutaunum2_a8204b60:

    # "Unum se levanta de la cama y te mira con emoción."
    "Unum从床上坐起来，兴奋地看着你。"

# game/rutas/unum.rpy:613
translate chino rutaunum2_83596e2d:

    # unum "Las chicas están cuidando de ellos, mientras, nosotros haremos el desayuno."
    unum "姑娘们在照顾它们，我们呢，去做早餐。"

# game/rutas/unum.rpy:614
translate chino rutaunum2_29681fc1:

    # "Vaya... parece que Unum se está tomando las palabras de Aeliana en serio..."
    "哎呀……看来Unum是把Aeliana的话当真了……"

# game/rutas/unum.rpy:615
translate chino rutaunum2_c166c775:

    # "Increíble."
    "不可思议。"

# game/rutas/unum.rpy:619
translate chino rutaunum2_6d9124ca:

    # "Caminan a la cocina y Unum se encarga de hacer el ritual de santificación antes de comenzar a preparar el desayuno."
    "你们走向厨房，Unum负责先进行祝圣仪式，再开始准备早餐。"

# game/rutas/unum.rpy:620
translate chino rutaunum2_51d69029:

    # "Tú le ayudas en algunas cosas, pero él es quien hace la mayoría de las cosas, copia con exactitud lo preparado por las chicas el día anterior."
    "你帮了点忙，但大部分活都是他做的——他一丝不差地复刻了姑娘们前一天准备的料理。"

# game/rutas/unum.rpy:621
translate chino rutaunum2_1e169274:

    # "Y luego de un tiempo cocinando, el desayuno ya está listo."
    "经过一段时间的烹饪，早餐终于做好了。"

# game/rutas/unum.rpy:622
translate chino rutaunum2_15b6b1f7:

    # "Inflando el pecho, Unum mira con orgullo el resultado."
    "Unum挺起胸膛，自豪地看着成果。"

# game/rutas/unum.rpy:623
translate chino rutaunum2_9028817e:

    # "Pero al instante se desinfla como un globo."
    "但下一秒，他就像泄了气的气球一样垮了下来。"

# game/rutas/unum.rpy:625
translate chino rutaunum2_e8917953:

    # unum "Ahhhhhh- extraño ver a mis esposas cocinar...."
    unum "啊啊啊啊啊——我好怀念看妻子们做饭的样子……"

# game/rutas/unum.rpy:628
translate chino rutaunum2_6e733382:

    # solaris "Veo que lo hiciste bastante bien."
    solaris "我看这做得相当不错嘛。"

# game/rutas/unum.rpy:630
translate chino rutaunum2_01e0f844:

    # "Solaris entra por la puerta, sonriendo de medio lado."
    "Solaris推门而入，嘴角挂着一丝微笑。"

# game/rutas/unum.rpy:631
translate chino rutaunum2_73ff0b14:

    # solaris "Parece que ahora serás tú el encargado de cocinar, querido."
    solaris "看来从现在起，就要由你负责做饭了，亲爱的。"

# game/rutas/unum.rpy:634
translate chino rutaunum2_ee396c73:

    # unum "Solo si me acompañan."
    unum "要你们陪我一起才行。"

# game/rutas/unum.rpy:635
translate chino rutaunum2_311b3238:

    # solaris "Lo pensaremos."
    solaris "我们会考虑的。"

# game/rutas/unum.rpy:636
translate chino rutaunum2_54d494d6:

    # solaris "¿Necesitan ayuda para colocar la mesa?"
    solaris "需要帮忙摆桌子吗？"

# game/rutas/unum.rpy:639
translate chino rutaunum2_222f50fb:

    # unum "Si, por favor."
    unum "要的，麻烦了。"

# game/rutas/unum.rpy:641
translate chino rutaunum2_e3dc3e3e:

    # "Es extraño..."
    "真奇怪……"

# game/rutas/unum.rpy:642
translate chino rutaunum2_82de9e3b:

    # "Esto es totalmente extraño. Jamás te imaginaste que convivir con ellos sería tan.... ¿normal?"
    "这实在太奇怪了。你从未想过，和他们一起生活竟然会这么……「正常」？"

# game/rutas/unum.rpy:643
translate chino rutaunum2_520b4f78:

    # "¿Dónde se fue ese Unum sobreexaltado por cualquier cosa? ¿Ese que intentaba atacarte a la minima reacción de tu cuerpo?"
    "那个对什么都过度兴奋、只要你的身体有一丝反应就要扑上来攻击你的Unum，到底去哪儿了？"

# game/rutas/unum.rpy:644
translate chino rutaunum2_369e8f0d:

    # "¿Dónde está el truco?"
    "这里头有什么猫腻？"

# game/rutas/unum.rpy:645
translate chino rutaunum2_a20cefa7_7:

    # "..."
    "..."

# game/rutas/unum.rpy:646
translate chino rutaunum2_1a730561:

    # "¿Será que luego te comerán? después de todo son entidades que comen carne de humanos..."
    "难道他们最后会把你吃掉吗？毕竟他们是吃人肉的存在……"

# game/rutas/unum.rpy:647
translate chino rutaunum2_9daf6193:

    # "¿Realmente estás jugando a la familia feliz?"
    "你真的是在扮演幸福家庭吗？"

# game/rutas/unum.rpy:648
translate chino rutaunum2_18f24bab:

    # unum "¿[nombrejugador]?"
    unum "[nombrejugador]？"

# game/rutas/unum.rpy:649
translate chino rutaunum2_0fbdf1df:

    # nj "¡Ah! ¿s-sí?"
    nj "啊！嗯……是、是的？"

# game/rutas/unum.rpy:651
translate chino rutaunum2_180b3f67:

    # unum "¿Los bebés humanos pueden comer en la mesa?"
    unum "人类宝宝能上桌吃饭吗？"

# game/rutas/unum.rpy:652
translate chino rutaunum2_634f344a:

    # nj "¿Qué?"
    nj "什么？"

# game/rutas/unum.rpy:655
translate chino rutaunum2_b42efa75:

    # unum "Sinceramente no me los imagino sentados en la mesa con un tenedor y un cuchillo en las manos..."
    unum "说实话，我想象不出他们坐在餐桌前、手里拿着刀叉的样子……"

# game/rutas/unum.rpy:656
translate chino rutaunum2_163eefdf:

    # unum "Sus manos son muy pequeñas y no tienen tanta coordinación con ellas."
    unum "他们的手太小了，也不太协调。"

# game/rutas/unum.rpy:657
translate chino rutaunum2_d0c7dcdd:

    # unum "Bueno... no tiene coordinación en nada."
    unum "嗯……完全一点都不协调。"

# game/rutas/unum.rpy:658
translate chino rutaunum2_644f31ec:

    # "Respiras hondo antes de contestar, y recuerdas que Unum es una entidad totalmente opuesta a ti."
    "你深吸一口气才回答，并想起 Unum 是一个与你完全相反的存在。"

# game/rutas/unum.rpy:659
translate chino rutaunum2_354aa241:

    # "Que solo sabe de los humanos gracias a lo que ha leído."
    "他对人类的了解，只来自他所读过的东西。"

# game/rutas/unum.rpy:660
translate chino rutaunum2_a95b9c53:

    # "Y solo dios sabe que cosas que estado leyendo..."
    "而只有天知道，他到底读过些什么……"

# game/rutas/unum.rpy:662
translate chino rutaunum2_cf0a743e:

    # "Los días pasan rápido, más rápido de lo que te gustaría confesar. Con la presencia de Unum y sus esposas en casa, no hay momento en que te quedes solo."
    "日子过得很快，快得超出你愿意承认的程度。有 Unum 和他的妻子们在，你从没有独处的时刻。"

# game/rutas/unum.rpy:663
translate chino rutaunum2_eaccfd17:

    # "Siempre hay algo que hacer, y siempre resulta ser algo agradable."
    "总有事可做，而且总是令人愉快的事。"

# game/rutas/unum.rpy:664
translate chino rutaunum2_3f66c4ea:

    # "Bueno... no siempre."
    "嗯……也不总是。"

# game/rutas/unum.rpy:666
translate chino rutaunum2_73b3a939:

    # unum "¿Puedes pelar esto?"
    unum "这个能削皮吗？"

# game/rutas/unum.rpy:667
translate chino rutaunum2_1b1f14c0:

    # unum "Tengo que ir a preguntar a Ignis una cosa."
    unum "我得去问 Ignis 一件事。"

# game/rutas/unum.rpy:668
translate chino rutaunum2_b6648de1:

    # nj "Claro."
    nj "当然。"

# game/rutas/unum.rpy:670
translate chino rutaunum2_a078de69:

    # "Cuando tomas el cuchillo y la fruta en tu mano te das cuenta de que tal vez no solo el color de tu piel está cambiando, sino que también tu movilidad en tus dedos."
    "当你拿起刀和水果时，你意识到也许不只是皮肤颜色在变化，连手指的灵活度也在改变。"

# game/rutas/unum.rpy:671
translate chino rutaunum2_2d82248a:

    # "Te cuesta coordinar y ejercer presión, pero aún lo puedes hacer."
    "你很难协调动作，也难以施加力道，但仍能做到。"

# game/rutas/unum.rpy:673
translate chino rutaunum2_a3333c09:

    # "Estás a punto de terminar de pelar cuando Unum aparece por detrás tuya, tocandote los hombros."
    "你快削完皮时，Unum 出现在你身后，碰了碰你的肩膀。"

# game/rutas/unum.rpy:674
translate chino rutaunum2_b4545730:

    # unum "¡HAHA! Lo haces mejor que yo."
    unum "哈哈！你做得比我好。"

# game/rutas/unum.rpy:677
translate chino rutaunum2_7e0ed29c:

    # "Y solo eso basta para desconcentrarte y cortarte con el cuchillo la palma de tu mano."
    "而仅仅这样就够了——你一分神，就用刀割伤了手掌。"

# game/rutas/unum.rpy:678
translate chino rutaunum2_8ea05879:

    # "El corte es profundo."
    "伤口很深。"

# game/rutas/unum.rpy:679
translate chino rutaunum2_0d5d6415:

    # "Y la sangre sale de ahí a cantidades preocupantes."
    "血从那里涌出来，量多得令人担忧。"

# game/rutas/unum.rpy:681
translate chino rutaunum2_0b3625af:

    # "Luego todo es un caos."
    "接着一切都乱作一团。"

# game/rutas/unum.rpy:682
translate chino rutaunum2_fda68762:

    # "Estás agradecido de que Unum no te haya desgarrado la mano de un solo bocado."
    "你很庆幸 Unum 没有一口把你的手撕下来。"

# game/rutas/unum.rpy:683
translate chino rutaunum2_6452d7e0:

    # "Por qué a quien vamos a mentir, sabes que lo único que quería hacer en ese momento era comerte entero."
    "说真的，你很清楚他当时唯一想做的，就是把你整个吃掉。"

# game/rutas/unum.rpy:684
translate chino rutaunum2_3f3ba2ee:

    # "De pies a cabeza."
    "从头到脚。"

# game/rutas/unum.rpy:688
translate chino rutaunum2_1eb10702:

    # "Para el cuarto día, y poco a poco, te vas abriendo a cada una de las esposas de Unum."
    "到了第四天，你一点点地向 Unum 的每位妻子敞开心扉。"

# game/rutas/unum.rpy:689
translate chino rutaunum2_bcb11458:

    # "Y al igual que el pelirrojo, están deseosas de saber más de los humanos."
    "而且和那个红发家伙一样，她们也迫切地想了解人类。"

# game/rutas/unum.rpy:690
translate chino rutaunum2_a8c35fe4:

    # "Gracias a ellas descubres que ambos bebés necesitan estás juntos."
    "多亏了她们，你发现两个宝宝必须待在一起。"

# game/rutas/unum.rpy:691
translate chino rutaunum2_e8a9dc5b:

    # "'Son estrellas binarias, lo que significa que están ligadas permanentemente por una cola en una danza infinita' dijo Ignis una vez."
    "「他们是双星，意味着他们被一条尾巴永久相连，在一场无尽的舞蹈中。」Ignis 曾这样说。"

# game/rutas/unum.rpy:692
translate chino rutaunum2_9fb455e2:

    # "Aunque hay una gran preocupación en las caras de las chicas cuando hablan de ello, pero cada vez que les preguntas por la razón, ellas cambian el tema."
    "虽然她们谈起这件事时，脸上都带着深深的忧虑，但每当你问起原因，她们就会岔开话题。"

# game/rutas/unum.rpy:694
translate chino rutaunum2_ece2d1f0:

    # "Al quinto día descubres el nombre de origen de ambos y si te concentras bien, enfocando tu mirada en los niños, puedes ver una cola."
    "第五天，你发现了他们最初的名字，而且如果你仔细把目光集中在孩子们身上，就能看见一条尾巴。"

# game/rutas/unum.rpy:695
translate chino rutaunum2_eb1cf341:

    # "Sirius, ese es el nombre que ambos comparten, Aeliana te explicó que eso es debido a que ambos nacieron al mismo tiempo."
    "Sirius——那是他们共有的名字。Aeliana 向你解释，这是因为他们同时诞生。"

# game/rutas/unum.rpy:696
translate chino rutaunum2_28fdc2ca:

    # "Pero no debes preocuparte pues solo será un nombre que nadie utilizará luego de que ambos dioses escojan sus propios nombres."
    "但你不必担心，因为等两位神明选出自己的名字后，这就会成为一个没人再用的名字。"

# game/rutas/unum.rpy:697
translate chino rutaunum2_1f23f203:

    # "No puedes pasar mucho tiempo con ellos dentro de una habitación ya que su presencia te quema la piel, y te impide respirar con normalidad."
    "你不能和他们在同一间房里待太久，因为他们的存在会灼烧你的皮肤，让你无法正常呼吸。"

# game/rutas/unum.rpy:698
translate chino rutaunum2_a8e95963:

    # "Al menos ahora los puedes cargar por un pequeño tiempo... y, no puedes evitar pensar que son lindos. Ambos se parecen a Unum, no tienen ningún parecido a ti físicamente. Y cuando le comentas esto a Unum, él solamente suelta una carcajada."
    "至少现在你能抱他们一小会儿了……而且你忍不住觉得他们很可爱。他们两个都像 Unum，外表一点也不像你。你跟 Unum 说起这事时，他只是放声大笑。"

# game/rutas/unum.rpy:700
translate chino rutaunum2_e1617d7e:

    # "Recuerdas vividamente las palabras que salieron del dios del Sol en ese momento."
    "你清楚地记得那一刻太阳之神说出的话。"

# game/rutas/unum.rpy:702
translate chino rutaunum2_0c9aeb02:

    # unum "Ambos comparten un corazón y esencia parecida a la tuya."
    unum "他们拥有和你相似的一颗心与本质。"

# game/rutas/unum.rpy:703
translate chino rutaunum2_a4d0247f:

    # unum "Y eso... es mil veces mejor que si tuvieran una apariencia parecida a la mía."
    unum "而那……比他们长得像我要好上千倍。"

# game/rutas/unum.rpy:704
translate chino rutaunum2_65bec9e9_1:

    # nj "¿Por qué?"
    nj "为什么？"

# game/rutas/unum.rpy:706
translate chino rutaunum2_47f322ed:

    # unum "Porque ahora puedo sentir tu corazón, acompañado de dos melodías más."
    unum "因为现在我能听见你的心跳，还伴着另外两段旋律。"

# game/rutas/unum.rpy:707
translate chino rutaunum2_8c4f09db:

    # unum "Son diferentes, pero... la de ellos nace de la tuya, y juntas hacen la sinfonía más bella que he podido de escuchar."
    unum "它们各不相同，但……他们的来自你，合在一起便成了我听过最美的交响曲。"

# game/rutas/unum.rpy:708
translate chino rutaunum2_3824e4c5:

    # "... aún no puedes creer que Unum te haya dicho aquello."
    "……你仍不敢相信 Unum 竟对你说了那样的话。"

# game/rutas/unum.rpy:709
translate chino rutaunum2_67b9a34d:

    # "Cada vez que lo recuerdas, sientes tus mejillas calentarse."
    "每次回想起来，你都感到脸颊发热。"

# game/rutas/unum.rpy:710
translate chino rutaunum2_a20cefa7_8:

    # "..."
    "..."

# game/rutas/unum.rpy:714
translate chino rutaunum2_ec448326:

    # "Al séptimo día, un domingo, Septem viene a ver a tus bebés."
    "第七天是个星期天，Septem 来看你的宝宝们。"

# game/rutas/unum.rpy:715
translate chino rutaunum2_8a7b8f97:

    # "Los mira por un solo segundo y luego te observa a ti."
    "他只看了他们一秒，便把目光转向你。"

# game/rutas/unum.rpy:717
translate chino rutaunum2_5e6f5a5e:

    # septem "{sc=2}Tus manos...{/sc}"
    septem "{sc=2}你的双手……{/sc}"

# game/rutas/unum.rpy:718
translate chino rutaunum2_b163b27e:

    # nj "Ah... no es nada."
    nj "啊……没什么。"

# game/rutas/unum.rpy:721
translate chino rutaunum2_8d6f2787:

    # septem "{sc=2}Buscaré una solución para eso.{/sc}"
    septem "{sc=2}我会为这件事找到解决办法。{/sc}"

# game/rutas/unum.rpy:723
translate chino rutaunum2_74ed525b:

    # "Sin explicarse, se retira."
    "他什么也没解释，便离开了。"

# game/rutas/unum.rpy:725
translate chino rutaunum2_c5206656:

    # unum "Ahora que Septem lo menciona."
    unum "既然 Septem 提到了这件事。"

# game/rutas/unum.rpy:726
translate chino rutaunum2_d9733823:

    # "Dice Unum mientras se acerca a inspeccionar tus manos."
    "Unum 说着，走近来查看你的双手。"

# game/rutas/unum.rpy:727
translate chino rutaunum2_98b19d64:

    # unum "Tus manos y brazos han cambiado con el tiempo."
    unum "随着时间推移，你的双手和双臂都发生了变化。"

# game/rutas/unum.rpy:728
translate chino rutaunum2_f78de71d:

    # unum "¿Qué pasa con ellas?"
    unum "它们怎么了？"

# game/rutas/unum.rpy:731
translate chino rutaunum2_faa348c5:

    # unum "...no te preocupes."
    unum "……别担心。"

# game/rutas/unum.rpy:734
translate chino rutaunum2_e08f7e5d:

    # unum "Septem siempre cumple su palabra."
    unum "Septem 说话算话。"

# game/rutas/unum.rpy:737
translate chino rutaunum2_e4d5264f:

    # unum "Siempre."
    unum "一直都。"

# game/rutas/unum.rpy:738
translate chino rutaunum2_5f9b772e:

    # "...."
    "...."

# game/rutas/unum.rpy:741
translate chino rutaunum2_5c426c30:

    # unum "Hmmm..."
    unum "嗯……"

# game/rutas/unum.rpy:742
translate chino rutaunum2_5f9b772e_1:

    # "...."
    "...."

# game/rutas/unum.rpy:747
translate chino rutaunum2_142febb5:

    # unum "¡Oh!"
    unum "哦！"

# game/rutas/unum.rpy:748
translate chino rutaunum2_5f9b772e_2:

    # "...."
    "...."

# game/rutas/unum.rpy:752
translate chino rutaunum2_387636ff_1:

    # unum "Hmmm."
    unum "嗯。"

# game/rutas/unum.rpy:753
translate chino rutaunum2_2bd27731:

    # unum "¡Hey!"
    unum "嘿！"

# game/rutas/unum.rpy:754
translate chino rutaunum2_4a75d9ad:

    # nj "¿Si?"
    nj "嗯？"

# game/rutas/unum.rpy:757
translate chino rutaunum2_a9611073:

    # unum "He estado viendo a Sirius dormir... y creo que sueñan."
    unum "我一直在看 Sirius 睡觉……我觉得他们在做梦。"

# game/rutas/unum.rpy:758
translate chino rutaunum2_67f16631:

    # unum "Se mueven y hacen gestos mientras duermen."
    unum "他们睡着时会动，还会做各种表情。"

# game/rutas/unum.rpy:759
translate chino rutaunum2_7647118d:

    # unum "¡Por lo que sueñan!"
    unum "他们究竟梦见了什么啊！"

# game/rutas/unum.rpy:762
translate chino rutaunum2_ed6f95bb:

    # unum "Ah---- muchas gracias por darme este cambio."
    unum "啊----非常感谢你给我这个改变。"

# game/rutas/unum.rpy:763
translate chino rutaunum2_ae269dbb:

    # unum "Realmente eres lo mejor que me ha pasado en un largo tiempo."
    unum "你真的是很久以来发生在我身上最好的事。"

# game/rutas/unum.rpy:765
translate chino rutaunum2_2056d851:

    # "Unum comienza a acercarse para rodearte con sus brazos. Él es tan alto y su complexión es tan grande que no puedes evitar sentirte enano a comparación."
    "Unum 走近来，把你揽进臂弯。他身形高大、体格魁梧，相比之下你不禁觉得自己十分渺小。"

# game/rutas/unum.rpy:766
translate chino rutaunum2_5f69f481:

    # "Su abrazo es cálido, el sentimiento de que en cualquier momento te puede arrandar un trozo de piel con sus dientes no deja tu cabeza por nada del mundo."
    "他的怀抱很温暖，可那份他随时都可能用牙齿咬下你一块皮肉的感觉，无论如何都挥之不去。"

# game/rutas/unum.rpy:767
translate chino rutaunum2_d16c4fd7:

    # unum "Realmente me gusta tenerte aquí."
    unum "我真的喜欢有你在。"

# game/rutas/unum.rpy:768
translate chino rutaunum2_6e81d3ed:

    # unum "Me gusta tu calor, tu olor y tus latidos."
    unum "我喜欢你的温度、你的气味，还有你的心跳。"

# game/rutas/unum.rpy:769
translate chino rutaunum2_0951e3a3:

    # unum "Lo mortal y cambiante que eres."
    unum "你是如此脆弱，又如此易变。"

# game/rutas/unum.rpy:771
translate chino rutaunum2_d1ac4799:

    # "Unum suelta un poco su agarre para tomar una de tus manos."
    "Unum 稍微松开怀抱，握住你的一只手。"

# game/rutas/unum.rpy:772
translate chino rutaunum2_4ea9dffd:

    # "Y la inspecciona mientras traza con su pulgar la costra que se te ha formado."
    "他用拇指抚过你手上结出的痂，仔细查看着。"

# game/rutas/unum.rpy:773
translate chino rutaunum2_bbf1f604:

    # unum "...y lo adaptable que eres."
    unum "……还有你竟如此适应力强。"

# game/rutas/unum.rpy:776
translate chino rutaunum2_2be47149:

    # unum "Mmm, hahaha."
    unum "嗯，哈哈哈。"

# game/rutas/unum.rpy:777
translate chino rutaunum2_83c3ec86:

    # "Unum te ignora."
    "Unum 无视了你。"

# game/rutas/unum.rpy:781
translate chino rutaunum2_36dc803d:

    # "Sin aviso lleva tu mano a su boca para lamerla."
    "他毫无预兆地把你的手送到嘴边，舔了上去。"

# game/rutas/unum.rpy:782
translate chino rutaunum2_586a0678:

    # "Tu corazon late a mil, aunque no sabes si es por miedo o otra cosa..."
    "你的心脏狂跳不止，却分不清是恐惧还是别的什么……"

# game/rutas/unum.rpy:783
translate chino rutaunum2_170c5181:

    # unum "Ahhh~--"
    unum "啊~--"

# game/rutas/unum.rpy:784
translate chino rutaunum2_9f40a949:

    # "Su cara se acerca peligrosamente a la tuya."
    "他的脸危险地贴近你的脸。"

# game/rutas/unum.rpy:787
translate chino rutaunum2_d7ac5292:

    # unum "Pero también me dan ganas de comerte..."
    unum "可这也让我想把你吃掉……"

# game/rutas/unum.rpy:788
translate chino rutaunum2_5c6f6d00:

    # unum "Esa vez que te cortaste con el cuchillo pelando la fruta."
    unum "就是那次你用刀削水果时割伤了自己。"

# game/rutas/unum.rpy:789
translate chino rutaunum2_8c79e1d6:

    # unum "Fue de lo peor."
    unum "糟糕透顶。"

# game/rutas/unum.rpy:790
translate chino rutaunum2_0d7f220a:

    # unum "Si no me gustaras tanto, probablemente te abría destripado ahí mismo."
    unum "要是我没那么喜欢你，大概当场就把你开膛破肚了。"

# game/rutas/unum.rpy:791
translate chino rutaunum2_98ab3d03:

    # "¿¿¿Qué clase de comentario es ese y por qué lo dice como si fuera un cumplido???"
    "这算什么发言？他凭什么说得好像那是在夸你一样？？？"

# game/rutas/unum.rpy:793
translate chino rutaunum2_46b2bd93:

    # unum "Pero no te preocupes."
    unum "不过别担心。"

# game/rutas/unum.rpy:794
translate chino rutaunum2_fddf0792:

    # unum "Te voy a cuidar."
    unum "我会照顾你的。"

# game/rutas/unum.rpy:796
translate chino rutaunum2_ba753bc2:

    # "Sin explicar su razonamiento más allá de una sonrisa, Unum te planta un beso en los labios."
    "Unum 只用一个微笑便解释了他的全部理由，随即吻上了你的唇。"

# game/rutas/unum.rpy:800
translate chino rutaunum2_3181b7d1:

    # "Más días pasan y te cuesta un poco creer lo rápido que crecen los niños... Te has acostumbrado a decirles 'los niños' y no por su nombre de origen"
    "又过了几天，你有点不敢相信孩子们长得有多快……你已经习惯叫他们“孩子们”，而不是他们最初的名字。"

# game/rutas/unum.rpy:801
translate chino rutaunum2_e267311a:

    # "Ahora que pueden caminar sueles pasar gran parte del día en el jardín junto con ellos, ya que aún es peligroso estar mucho tiempo con ellos dentro de un lugar cerrado."
    "既然他们能走路了，你通常大半时间都陪他们在花园里，因为长时间和他们待在密闭空间里仍然危险。"

# game/rutas/unum.rpy:802
translate chino rutaunum2_3d1c0af3:

    # "La energía que ellos liberan es muy inestable y peligrosa para un cuerpo como el tuyo."
    "他们释放的能量非常不稳定，对你的身体来说极其危险。"

# game/rutas/unum.rpy:803
translate chino rutaunum2_a20cefa7_9:

    # "..."
    "..."

# game/rutas/unum.rpy:805
translate chino rutaunum2_1114cc3f:

    # "Son adorables."
    "他们可爱极了。"

# game/rutas/unum.rpy:806
translate chino rutaunum2_a6ed7281:

    # "Es adorable verlos jugar e interactuar entre ellos o con las chicas."
    "看着他们玩耍、彼此互动，或与女孩们相处，实在可爱。"

# game/rutas/unum.rpy:807
translate chino rutaunum2_5a2b846c:

    # "Aunque hay algo que te preocupa desde hace un tiempo ya, algo que ni Unum y las chicas han mostrado interés en explicar o comentar."
    "不过有件事已经让你担心了一阵子，而无论是 Unum 还是女孩们都无意解释或谈论它。"

# game/rutas/unum.rpy:808
translate chino rutaunum2_57e73da8:

    # "Por lo que supones que es algo normal... pero de igual forma te preocupa."
    "所以你猜想这是正常的……但心里依然不安。"

# game/rutas/unum.rpy:809
translate chino rutaunum2_381dc547:

    # "Y es que mientras más crecen más tendencias muestran a estar juntos, entrelazados por sus colas."
    "而且他们越是长大，就越倾向于待在一起，尾巴缠绕着彼此。"

# game/rutas/unum.rpy:810
translate chino rutaunum2_f766abc3:

    # "Pueden pasar días entreros sujetos a sus colas."
    "他们能连续好几天都紧紧缠在彼此的尾巴上。"

# game/rutas/unum.rpy:813
translate chino rutaunum2_fde9fd8b:

    # "Le avisas a los niños que entrarás por un segundo y que volverás luego."
    "你告诉孩子们，你进去一下，马上回来。"

# game/rutas/unum.rpy:815
translate chino rutaunum2_a89ad560:

    # "Buscas a Unum por los pasillos del templo y lo encuentras en la cocina junto con Solaris, quien le está dando consejos de cómo mejorar su última comida que ha hecho."
    "你在神殿的走廊里寻找 Unum，在厨房找到了他；Solaris 正给他出主意，教他如何改进刚做的那顿饭。"

# game/rutas/unum.rpy:817
translate chino rutaunum2_dee5915b:

    # "Por curiosidad te detienes para escuchar un poco de su conversación."
    "出于好奇，你停下脚步，听了一小段他们的谈话。"

# game/rutas/unum.rpy:819
translate chino rutaunum2_64fa63af:

    # solaris "Tienes que mejorar tu canto, mi sol."
    solaris "你得好好练练歌喉了，我的太阳。"

# game/rutas/unum.rpy:820
translate chino rutaunum2_0fb30b27:

    # solaris "Si lo haces desafinado, puede que llegue a afectar el sabor."
    solaris "要是唱走音了，说不定连味道都会受影响。"

# game/rutas/unum.rpy:821
translate chino rutaunum2_80de3ce2:

    # "Su voz oscila entre la risa y la ternura, pero no puede evitar en soltar una pequeña carcajada al final."
    "她的声音在笑意与温柔间摇摆，最后还是忍不住轻笑了一声。"

# game/rutas/unum.rpy:823
translate chino rutaunum2_a009d031:

    # unum "¿Me estás diciendo que canto mal?"
    unum "你是说我唱得很难听吗？"

# game/rutas/unum.rpy:824
translate chino rutaunum2_a0a31c9d:

    # solaris "Tal vez."
    solaris "也许吧。"

# game/rutas/unum.rpy:825
translate chino rutaunum2_8fc051b6:

    # "Y solo eso falta para que Solaris deje salir la gran carcajada que estaba aguantando."
    "只差这一句，Solaris 便爆发出一直憋着的那声大笑。"

# game/rutas/unum.rpy:828
translate chino rutaunum2_90a5565e:

    # unum "[nombrejugador], ¿tú piensas que hago los cánticos mal?"
    unum "[nombrejugador]，你觉得我吟唱得很差吗？"

# game/rutas/unum.rpy:829
translate chino rutaunum2_725474ec:

    # "Te sobresaltar un poco...No sabes cómo Unum pudo detectarte."
    "你吓了一跳……真不知道 Unum 是怎么发现你的。"

# game/rutas/unum.rpy:830
translate chino rutaunum2_7416d2bf:

    # solaris "¡No es que los haces mal! es solo que eres desafinado."
    solaris "不是唱得差！只是你跑调了而已。"

# game/rutas/unum.rpy:833
translate chino rutaunum2_4b9af26f:

    # nj "uh..."
    nj "呃……"

# game/rutas/unum.rpy:839
translate chino rutaunum2_e2c119a8:

    # nj "No.... Unum canta bien."
    nj "不是……Unum 唱得很好。"

# game/rutas/unum.rpy:840
translate chino rutaunum2_89ce823d:

    # "Solaris vuelve a reír, aún más fuerte. Y entre risas dice:"
    "Solaris 又笑了，笑得更大声了。她笑着说道："

# game/rutas/unum.rpy:841
translate chino rutaunum2_71691c07:

    # solaris "¡Tampoco hace falta mentir para convivir!"
    solaris "也不用为了好好相处就撒谎啊！"

# game/rutas/unum.rpy:845
translate chino rutaunum2_8cd36d62:

    # nj "...sí."
    nj "……是。"

# game/rutas/unum.rpy:848
translate chino rutaunum2_b1472776:

    # "Unum hace un quejido, derrotado mientras Solaris ríe con más fuerza."
    "Unum 发出一声哀叹，败下阵来，而 Solaris 笑得更欢了。"

# game/rutas/unum.rpy:850
translate chino rutaunum2_7dd52c23:

    # nj "¿Puedo preguntar algo? es sobre los niños."
    nj "我能问件事吗？是关于孩子们的。"

# game/rutas/unum.rpy:851
translate chino rutaunum2_68cbb899:

    # "Solo eso hace falta para que tengas la atención de ambos nuevamente en ti. Y no hace falta tener una respuesta verbal porque ellos y te miran esperando tu pregunta."
    "仅此一句就让他们的注意力重新回到你身上。你无需开口回应，因为他们正望着你，等着你的问题。"

# game/rutas/unum.rpy:852
translate chino rutaunum2_05fd33fa:

    # nj "¿Es normal que tengan sus colar entrelazadas todo el tiempo?"
    nj "他们的尾巴一直缠在一起，这正常吗？"

# game/rutas/unum.rpy:853
translate chino rutaunum2_d5fd0c0c:

    # unum "Es algo que hacen las estrellas binarias, uh... Solaris sabe más de eso."
    unum "这是双星会做的事，呃……Solaris 比我更懂这个。"

# game/rutas/unum.rpy:856
translate chino rutaunum2_8a6581e0:

    # solaris "Hmmm, nosotros no tenemos cola... pero según lo que nos ha dicho Duae, cuando la acompañabamos a nacimientos de estrellas binarias, la unión de ambas colar es su forma de mantener el equilbrio gravitacional de ambas."
    solaris "嗯……我们没有尾巴……不过据 Duae 所说，她陪我们经历过双星诞生时，两颗星的尾巴相连正是它们维持引力平衡的方式。"

# game/rutas/unum.rpy:857
translate chino rutaunum2_d9e5a70b:

    # solaris "Así que funciona también como ah... ehh- un método de comunicación entre ambas estrellas."
    solaris "所以这也相当于一……呃--一种两颗星之间交流的方法。"

# game/rutas/unum.rpy:862
translate chino rutaunum2_770230cf:

    # unum "Si, eso mismo."
    unum "对，就是这样。"

# game/rutas/unum.rpy:863
translate chino rutaunum2_196bd450:

    # unum "No te preocupes, es normal."
    unum "别担心，这是正常的。"

# game/rutas/unum.rpy:870
translate chino rutaunum2_fde9fd8b_1:

    # "Le avisas a los niños que entrarás por un segundo y que volverás luego."
    "你告诉孩子们，你进去一下，马上回来。"

# game/rutas/unum.rpy:871
translate chino rutaunum2_f03fc6ac:

    # "No te hace falta buscar pues las divisas saliendo de su residencia, así que corres hacía ellas."
    "你不用找，因为远远看见她们正走出住所，于是朝她们跑了过去。"

# game/rutas/unum.rpy:872
translate chino rutaunum2_3fd9877f:

    # "Son Ignis y Aeliana, solamente. Solaris no está con ellas."
    "只有 Ignis 和 Aeliana 两个人。Solaris 不在她们身边。"

# game/rutas/unum.rpy:874
translate chino rutaunum2_f2b7db4a:

    # ignis "Pequeño humano, ¿ha pasado algo?"
    ignis "小人类，发生什么事了吗？"

# game/rutas/unum.rpy:875
translate chino rutaunum2_0af2ec31:

    # "Ignis pregunta con algo de miedo en su voz, ya que verte correr y jadear debe ser algo extraño de ver."
    "Ignis 的声音里带着几分不安；毕竟看到你跑着气喘吁吁，一定是很少见的景象。"

# game/rutas/unum.rpy:876
translate chino rutaunum2_9a1b6449:

    # nj "No, no es nada... es solo que me preocupa algo de los niños."
    nj "不，没什么……只是孩子们身上有件事让我担心。"

# game/rutas/unum.rpy:878
translate chino rutaunum2_68225baa:

    # aeliana "¿Qué es lo que te preocupa cariño?"
    aeliana "你在担心什么呢，亲爱的？"

# game/rutas/unum.rpy:879
translate chino rutaunum2_cc9a2e61:

    # "No importa cuantas veces Aeliana se refiera a ti como 'cariño', cada vez que lo hace sientes un hormigueo en tu estómago."
    "不管 Aeliana 多少次叫你“亲爱的”，每当她这么说，你都会感到胃里一阵酥麻。"

# game/rutas/unum.rpy:880
translate chino rutaunum2_8c0bf320:

    # nj "¿Es normal que tengan sus colas entrelazadas todo el tiempo?"
    nj "他们的尾巴总是缠在一起，这正常吗？"

# game/rutas/unum.rpy:883
translate chino rutaunum2_9cf6c5fa:

    # "Ambas mujeres te observan en silencio antes de contestar, y la sonrisa de Aeliana flaquea por un segundo."
    "两位女性沉默地注视着你，Aeliana 的笑容有一瞬的动摇。"

# game/rutas/unum.rpy:884
translate chino rutaunum2_c514cae3:

    # aeliana "Las estrellas binarias usan su cola para estabilizarse y mantener su campo gravitacional en un buen estado."
    aeliana "双星用尾巴来稳住自身，让引力场保持在良好状态。"

# game/rutas/unum.rpy:885
translate chino rutaunum2_516e1351:

    # aeliana "Si no lo hacen, es posible que uno de ellos sea absorbido por el otro."
    aeliana "如果不这样做，其中一个就有可能被另一个吞噬。"

# game/rutas/unum.rpy:886
translate chino rutaunum2_dc3e6926:

    # aeliana "Al conectar sus colas, su poder se equilibra y reparte en partes iguales."
    aeliana "连接起尾巴后，他们的力量便得到平衡，并被均等地分配。"

# game/rutas/unum.rpy:887
translate chino rutaunum2_2cd5441c:

    # ignis "También les ayuda a mejorar su vínculo emocional."
    ignis "这也有助于加深他们之间的情感纽带。"

# game/rutas/unum.rpy:890
translate chino rutaunum2_64d1d5cd:

    # aeliana "Cierto."
    aeliana "没错。"

# game/rutas/unum.rpy:891
translate chino rutaunum2_89b25a3e:

    # aeliana "No es nada de qué preocuparse, ellos lo hacen instintivamente."
    aeliana "没什么好担心的，他们只是凭本能这样做。"

# game/rutas/unum.rpy:895
translate chino rutaunum2_ca24d937:

    # "No crees que sea nada TAN preocupante como para consultarles a los demás."
    "你并不觉得这件事严重到需要去惊动别人。"

# game/rutas/unum.rpy:896
translate chino rutaunum2_02fe18e1:

    # "Si fuera algún problema, Unum ya lo habría discutido contigo para mantenerte al tanto."
    "如果真有问题，Unum 早就和你谈过，让你知情了。"

# game/rutas/unum.rpy:899
translate chino rutaunum2_5ad2a70f:

    # "El resto del día lo pasas descansando con las chicas mientras Unum se encarga de los niños."
    "剩下的时间你和女孩们一起休息，Unum 则负责照看孩子们。"

# game/rutas/unum.rpy:901
translate chino rutaunum2_75d025d8:

    # "Ya no te da miedo dejarlos con él, pues Unum ha demostrado ser un muy buen cuidador. Increíblemente, contra todo pronóstico."
    "你已经不再害怕把孩子交给他照顾了，因为 Unum 已经证明自己是个非常称职的照护者。令人难以置信地、出乎意料地称职。"

# game/rutas/unum.rpy:904
translate chino rutaunum2_dc5c7e10:

    # "Llega nuevamente el domingo. Y Septem vuelve a aparecer..."
    "星期天再次来临，而 Septem 也再度现身……"

# game/rutas/unum.rpy:905
translate chino rutaunum2_156b29a7:

    # "No te gusta que tú no puedas estar en la revisión del crecimiento de los niños. Pero Unum si, así que no te preocupas más de lo necesario. decidiendo esperar fuera de la sala."
    "你不喜欢自己不能参加孩子们的成长检查，但 Unum 可以，所以你没有过度担心，决定在房间外等候。"

# game/rutas/unum.rpy:906
translate chino rutaunum2_a20cefa7_10:

    # "..."
    "..."

# game/rutas/unum.rpy:907
translate chino rutaunum2_917f49f9:

    # "Pasan alrededor de 30 minutos, y ellos aún no salen."
    "大约过了三十分钟，他们还没有出来。"

# game/rutas/unum.rpy:908
translate chino rutaunum2_1b2ec6a3:

    # "...no es nada de preocuparse."
    "……没什么好担心的。"

# game/rutas/unum.rpy:909
translate chino rutaunum2_cd57ab94:

    # "Cuando se cumple una hora, llegan las chicas a acompañarte. Sin decir nada, lo que hace que comiences a sudar frío."
    "一个小时过去时，女孩们来了，陪在你身边。她们一言不发，这让你开始冒冷汗。"

# game/rutas/unum.rpy:910
translate chino rutaunum2_e2b6b55b:

    # "¿Por qué está acá? ¿Y por qué se ven tan tensas?"
    "她们为什么在这儿？又为什么看起来这么紧张？"

# game/rutas/unum.rpy:912
translate chino rutaunum2_10c4f3b1:

    # solaris "¿si no pasan la revisión...?"
    solaris "如果他们没能通过检查……？"

# game/rutas/unum.rpy:914
translate chino rutaunum2_748a9f48:

    # aeliana "Calla. Ni se te ocurra."
    aeliana "别说了。想都别想。"

# game/rutas/unum.rpy:915
translate chino rutaunum2_ea26f1b1:

    # solaris "Lo siento."
    solaris "对不起。"

# game/rutas/unum.rpy:917
translate chino rutaunum2_68da915b:

    # "¿Qué pasará si no pasan la revisión?"
    "要是他们没通过检查，会发生什么？"

# game/rutas/unum.rpy:919
translate chino rutaunum2_b3d95096:

    # "Estás a punto de entrar en pánico y preguntar a gritos a que se refieren cuando la puerta de la sala se abre."
    "你正要惊慌失措、大声追问她们到底是什么意思，房间的门却打开了。"

# game/rutas/unum.rpy:921
translate chino rutaunum2_f37f6f58:

    # "Los dos niños salen y corren a ustedes riendo, como si festejaran algo que desconoces."
    "两个孩子跑出来，笑着朝你们奔来，像是在庆祝什么你不知道的事。"

# game/rutas/unum.rpy:923
translate chino rutaunum2_c30a4107:

    # "Septem sale con ambos brazos detrás de su espalda, detrás de él viene Unum."
    "Septem 背着双手走出来，Unum 跟在他身后。"

# game/rutas/unum.rpy:925
translate chino rutaunum2_c9cca5d8:

    # unum "¡Ya tienen sus nombres!"
    unum "他们有名字了！"

# game/rutas/unum.rpy:930
translate chino rutaunum2_51c37991:

    # septem "Todos los presentes: Unum; Alnitak; Mintaka y Alnilam, deberán referirse con esos nombres a partir de ahora. Tienen estrictamente prohibido nombrarlos por sus nombres de origen."
    septem "{sc=2}All present--Unum, Alnitak, Mintaka, and Alnilam--must refer to them
by these new\nnames from now on. It is strictly forbidden to call them by their original name.{/sc}"

# game/rutas/unum.rpy:931
translate chino rutaunum2_848c2fe3:

    # "...Una presión inexplicable atraviesa tu cuerpo. Por la tensión en el rostro de Unum, sabes que no has sido el único en sentirla."
    "……一股难以解释的压力穿过你的身体。从 Unum 脸上的紧绷，你知道不止你一个人感觉到了。"

# game/rutas/unum.rpy:934
translate chino rutaunum2_04bc0411:

    # septem "Sirius, pueden presentarse."
    septem "{sc=2}Sirius，你们可以自我介绍了。{/sc}"

# game/rutas/unum.rpy:936
translate chino rutaunum2_e5f4bf6f:

    # noor "¡Mi nombre es Noor!"
    noor "我叫 Noor！"

# game/rutas/unum.rpy:937
translate chino rutaunum2_b0780a8e:

    # shams "Y yo me llamo Shams."
    shams "我叫 Shams。"

# game/rutas/unum.rpy:938
translate chino rutaunum2_350dc1c9:

    # "Complacido y sin agregar nada más, Septem se despide con una voz monótona y distante. Aunque sus movimientos y su rostro mantienen la elegancia propia de su ser..."
    "Septem 满意地不再多言，用一种单调而疏远的声音告别。尽管他的动作与神情仍保持着他与生俱来的优雅……"

# game/rutas/unum.rpy:939
translate chino rutaunum2_a651c5fb:

    # "...¿Por qué él es el único que puede referirse a ellos por su nombre impuesto?"
    "……为什么唯独他能以他们被强加的名字称呼他们？"

# game/rutas/unum.rpy:940
translate chino rutaunum2_ce812e4d:

    # "¿Y Unum no lo tiene permitido?"
    "而 Unum 就不行吗？"

# game/rutas/unum.rpy:941
translate chino rutaunum2_8711795b:

    # "Temes por la razón de tal comando... pero por ahora no puede hacer nada."
    "你害怕这道命令背后的原因……但眼下你什么也做不了。"

# game/rutas/unum.rpy:942
translate chino rutaunum2_ff5a1cce:

    # noor "¿Podemos ir al jardín a jugar?"
    noor "我们能去花园玩吗？"

# game/rutas/unum.rpy:943
translate chino rutaunum2_8a679652:

    # "Tu atención se centra en tus niños, quienes te miran suplicantes y con sus colas entrelazadas."
    "你的注意力落到了孩子们身上，他们恳求地望着你，尾巴缠绕在一起。"

# game/rutas/unum.rpy:946
translate chino rutaunum2_36ea453d:

    # "La respuesta que obtienes es un coro de berrinches infantiles."
    "你得到的回应是一阵孩子气的闹腾。"

# game/rutas/unum.rpy:947
translate chino rutaunum2_1d902425:

    # "Pero aceptan viendo que no sacarán nada haciendo eso."
    "但他们还是接受了，明白再闹也没用。"

# game/rutas/unum.rpy:950
translate chino rutaunum2_7effbeec:

    # "Shams y Noor se van corriendo por el pasillo hacía el jardín."
    "Shams 和 Noor 沿着走廊朝花园跑去。"

# game/rutas/unum.rpy:951
translate chino rutaunum2_06bac1fe:

    # "En todo momento, sus colas yacen entrelazadas."
    "一路上，他们的尾巴始终缠绕在一起。"

# game/rutas/unum.rpy:953
translate chino rutaunum2_4bf650c6:

    # "La vida aquí no es tan mala..."
    "这里的日子也不算太糟……"

# game/rutas/unum.rpy:955
translate chino rutaunum2_94acaf39:

    # "FIN DEL ACTO 2."
    "第二幕完。"

# game/rutas/unum.rpy:956
translate chino rutaunum2_9ceab4ea:

    # "En proceso de elaboración..."
    "制作中……"

# game/rutas/unum.rpy:957
translate chino rutaunum2_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2} 你还得再等一阵子，才能知道这件事会如何收场…… :3{/sc}"

