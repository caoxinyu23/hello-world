# game/script.rpy:568
translate chino start_4255c967:

    # "Miras a Nulla, quien al percatarse tal vez de lo que intentas hacer, procede a mover sus manos realizando señas extrañas."
    "你看向 Nulla，而他似乎察觉到了你想做什么，便开始动手比划出奇怪的手势。"

# TODO: Translation updated at 2025-02-23 19:20

translate chino strings:

    # game/script.rpy:9
    old "tu"
    new "你"

