# game/script.rpy:111
translate chino start_56c14410:

    # "....Por favor no hagas nada que está fuera de lo estipulado, ni invoques el nombre del representante del vacío, lo tienes estrictamente prohibido."
    "……请你不要做任何超出规定的事，也不要唤出虚空之代表的名讳，这是被严令禁止的。"

# game/script.rpy:180
translate chino start_1f174e33:

    # el "Bienvenido, te he estado esperando."
    el "欢迎，我一直在等你。"

# game/script.rpy:294
translate chino start_3f010b45:

    # fames "Pero el último lo ha roto Quinque por completo... pensé que habían quedado en que no se harían más..."
    fames "但上一件已经被 Quinque 彻底弄坏了……我以为你们已经说好不再制作新的了……"

# game/script.rpy:297
translate chino start_a07dac4a:

    # nulla "Eso fue porque Quinque es un animal. No cuida de las cosas... Supongo que Madre no puede dejar a Septem sin su comida semanal..."
    nulla "那是因为 Quinque 就是个畜生，他从不在乎东西……我想母亲总不能让 Septem 没有每周的口粮吧……"

# game/script.rpy:300
translate chino start_13f02c92:

    # fames "Se nota como te arde el favoritismo..."
    fames "那股偏袒的火气，谁都看得出来……"

# game/script.rpy:396
translate chino start_8d3b8d95:

    # el "Este no es un trabajador... ¿No será el regalo que nos hace Madre?"
    el "这个不是工人……难道是母亲送给我们的礼物？"

# game/script.rpy:403
translate chino start_d939b8c3:

    # el "Son los ojos que tiene... y el olor que emana. WOW parece que ahora Madre los está haciendo similares a los humanos."
    el "是那双眼睛……还有散发的气味。哇，看来母亲现在把他们造得越来越像人类了。"

# game/script.rpy:408
translate chino start_1ebd6f84:

    # ell "{sc=1}...{/sc}"
    ell "{sc=1}...{/sc}"

# game/script.rpy:442
translate chino start_deec228e:

    # el "No recordaba que tuvieran tanta autonomía..."
    el "我没料到它们竟然拥有这么高的自主性……"

# game/script.rpy:497
translate chino start_bd84b573:

    # el "Siempre te quejas que lo rompen muy rápido... además, el tiempo que te tomas cuando te toca es eterno."
    el "你总抱怨它们太容易被弄坏……而且轮到你的时候，你花的时间长得要命。"

# game/script.rpy:526
translate chino start_19384c7a:

    # ell "..."
    ell "..."

# game/script.rpy:551
translate chino start_8f464658:

    # nulla "Podrían dejar que el regalo elija e invoque uno de sus nombre..."
    nulla "你们可以让这份礼物自己选择，并唤出它的某一个名字……"

# game/script.rpy:567
translate chino start_1b2b9397:

    # "Intentas decir su nombre pero te es físicamente imposible."
    "你试图说出他的名字，却从生理上根本不可能。"

# game/script.rpy:568
translate chino start_5ef2b63f:

    # "Miras a Nulla, quien al percatarse tal vez de lo que intentas hacer, procede a mover sus manos realizando señas estrañas."
    "你望向 Nulla，他或许察觉到了你想做什么，于是开始比划起一串古怪的手式。"

# game/script.rpy:569
translate chino start_925be7fd:

    # "{glitch=20.0}{color=ffffff}{b}Vamos... Intenta de nuevo.{/glitch}"
    "{glitch=20.0}{color=ffffff}{b}来吧……再试一次。{/glitch}"

# game/script.rpy:570
translate chino start_771c9a24:

    # "Puedes escuchar claramente la voz de Nulla en tu cabeza, y haciendo caso, lo intentas nuevamente."
    "你能清楚地听到 Nulla 的声音在脑海中响起，于是照做了，再次尝试。"

# game/script.rpy:571
translate chino start_0a0ceac9:

    # "Pronuncias su nombre y alcanzas a ver como la cara de Septem se deforma en una mueca extraña..."
    "你念出他的名字，恰好看见 Septem 的脸扭曲成一副怪异的鬼脸……"

# game/script.rpy:572
translate chino start_3819fc42:

    # "Nulla en cambio, sonrie."
    "而 Nulla 则露出了笑容。"

# game/script.rpy:577
translate chino start_f84027c7:

    # "Intentas decir su nombre pero te es físicamente imposible. Por lo que lo apuntas."
    "你试图说出他的名字，却从生理上根本不可能。于是你用手指向了他。"

# game/script.rpy:980
translate chino rutaunum_ebc34089:

    # "Él te mira con la boca abierta, casi que fascinado... Dándose cuenta de tu silencio, habla."
    "他张着嘴看着你，几乎有些着迷……察觉到你的沉默后，他开口了。"

# game/script.rpy:1045
translate chino rutaunum_07bdde05:

    # "....."
    "....."

# game/script.rpy:1065
translate chino rutaunum_68c48d73:

    # "La expresión de Unum demuestra lo exaltado que está, cosa que no te agrada mucho pues sabes por experiencia propia que eso no lleva a nada bueno."
    "Unum 的神情透出他有多么亢奋，这让你很不舒服，因为你深知那不会有什么好下场。"

# game/script.rpy:1398
translate chino rutaunum_da8b47da:

    # unum "Duae ha venido de visita..."
    unum "Duae 来探访了……"

# game/script.rpy:1451
translate chino rutaunum_43102250_4:

    # unum "..."
    unum "..."

# game/script.rpy:1523
translate chino rutaunum_da775502:

    # "Sientes tu cuerpo pesado, como si hubieras corrido 4 kilometros sin descanso..."
    "你感到身体沉重，仿佛刚不停歇地跑了四公里……"

# game/script.rpy:1524
translate chino rutaunum_602062c9:

    # "Es extraño, como si te hubieran sacado parte de tu cuerpo, alguna parte importante."
    "这种感觉很奇怪，仿佛你身体的一部分——某个重要的部分——被抽走了。"

# game/script.rpy:1525
translate chino rutaunum_9f06718a:

    # "Pero estás completo."
    "但你依然完整。"

# game/script.rpy:1526
translate chino rutaunum_d848d579:

    # "No hay nada faltante."
    "什么都没少。"

# game/script.rpy:1528
translate chino rutaunum_4ef4015a:

    # unum "Si quieres puedes descansar aquí un rato."
    unum "如果你想，可以在这里休息一会儿。"

# game/script.rpy:1529
translate chino rutaunum_f74926b3:

    # "Dice Unum mientras se acomoda en la cama."
    "Unum 一边在床上安顿下来，一边说道。"

# game/script.rpy:1530
translate chino rutaunum_389c73d6:

    # "Decides recostarte por un rato, y sin darte cuenta, cierras los ojos por un momento."
    "你决定躺下来歇一会儿，不知不觉间，眼皮合上了。"

# game/script.rpy:1534
translate chino rutaunum_a20cefa7_13:

    # "..."
    "..."

# game/script.rpy:1535
translate chino rutaunum_c9bebfe0:

    # "{sc=4}{b}....{b}{/sc}"
    "{sc=4}{b}....{b}{/sc}"

# game/script.rpy:1536
translate chino rutaunum_f3fad667:

    # "{sc=4}{b}Veo que has ingerido alimentos no santificados...{b}{/sc}"
    "{sc=4}{b}看来你摄入了未经祝圣的食物……{b}{/sc}"

# game/script.rpy:1537
translate chino rutaunum_76b0b6dc:

    # "{sc=4}{b}Dentro de ti hay veneno que se está exparciendo de a poco.{b}{/sc}"
    "{sc=4}{b}你体内有毒，正在一点一点地扩散。{b}{/sc}"

# game/script.rpy:1538
translate chino rutaunum_e2aaaa09:

    # "{sc=4}{b}Mil disculpas, no puedo controlar como es consumido mis frutos.{b}{/sc}"
    "{sc=4}{b}万分抱歉，我无法控制我的果实被如何食用。{b}{/sc}"

# game/script.rpy:1539
translate chino rutaunum_1ab27cff:

    # "{sc=4}{b}Unum es un idiota...{b}{/sc}"
    "{sc=4}{b}Unum 真是个笨蛋……{b}{/sc}"

# game/script.rpy:1540
translate chino rutaunum_a20cefa7_14:

    # "..."
    "..."

# game/script.rpy:1542
translate chino rutaunum_cc9a5909:

    # "!!!"
    "!!!"

# game/script.rpy:1544
translate chino rutaunum_d3e0a825:

    # "Despiertas repentinamente, sintiendo una gota de sudor frío recoriendo tu cuello."
    "你猛地醒来，感到一滴冷汗正沿着脖颈滑落。"

# game/script.rpy:1546
translate chino rutaunum_1f022e2b:

    # "Y lo primero que te encuentras es a Unum mirandote de cerca, casi que inspeccionándote."
    "你首先看到的，是 Unum 近在咫尺的注视，几乎像是在检查你。"

# game/script.rpy:1548
translate chino rutaunum_24a894ac:

    # unum "Tu respiración es constante cuando descansas."
    unum "你休息时的呼吸十分平稳。"

# game/script.rpy:1549
translate chino rutaunum_d668838b:

    # unum "Impresionante."
    unum "令人印象深刻。"

# game/script.rpy:1550
translate chino rutaunum_97b1af78:

    # "Sinceramente, prefieres que haga este tipo de comentarios a que le den los 5 minutos de locura y quiera romperte en pedazos para saber como funciona tu cuerpo."
    "说实话，你宁愿他发表这种评论，也不想他再发疯五分钟、把你拆成碎片好研究你的身体构造。"

# game/script.rpy:1551
translate chino rutaunum_d9ed5370:

    # nj "¿Me has estado mirando mientras duermo?"
    nj "你是不是在我睡着的时候一直盯着我看？"

# game/script.rpy:1552
translate chino rutaunum_25e4832c:

    # unum "...¿Si?"
    unum "……是的？"

# game/script.rpy:1554
translate chino rutaunum_a78420f5:

    # unum "¿Está prohidido hacerlo?"
    unum "这样做是被禁止的吗？"

# game/script.rpy:1555
translate chino rutaunum_844f3df9:

    # nj "No pero..."
    nj "不算，可是……"

# game/script.rpy:1556
translate chino rutaunum_2e63ba8c:

    # "Te detienes cuando sientes que tu estómago se te revuelve."
    "胃里一阵翻搅，你停了下来。"

# game/script.rpy:1558
translate chino rutaunum_89b52ea5:

    # "Algo dentro de ti quema."
    "你体内有什么东西在燃烧。"

# game/script.rpy:1560
translate chino rutaunum_6f4d40d6:

    # "Te levantas rápidamente, pensando que vomitarás."
    "你猛地坐起身，以为自己要吐了。"

# game/script.rpy:1562
translate chino rutaunum_8d55f64c:

    # "Pero lo único que sale de tu boca son pétalos color rojo, meszlados con sangre."
    "可你嘴里吐出的，只有混着鲜血的红色花瓣。"

# game/script.rpy:1563
translate chino rutaunum_24f59be8:

    # "...¿Qué?"
    "……什么？"

# game/script.rpy:1564
translate chino rutaunum_4452456e:

    # "Los miras con detenimiento... parecen tener un símbolo extraño."
    "你仔细端详它们……上面似乎刻着一个古怪的符号。"

# game/script.rpy:1566
translate chino rutaunum_86142590:

    # unum "¿Qué es eso?"
    unum "那是什么？"

# game/script.rpy:1567
translate chino rutaunum_8e0ac83c:

    # "No tienes tiempo para pensar por un momento pues un ataque de tos te detiene."
    "你连一瞬思考的时间都没有，一阵咳嗽打断了你。"

# game/script.rpy:1568
translate chino rutaunum_1643ae8c:

    # "Algo te respa la garganta."
    "有什么东西舒缓了你的喉咙。"

# game/script.rpy:1571
translate chino rutaunum_18f24bab:

    # unum "¿[nombrejugador]?"
    unum "[nombrejugador]？"

# game/script.rpy:1572
translate chino rutaunum_a1c22fb9:

    # ell "¿No me digas que le has dado comida?"
    ell "你不会是给他喂了食物吧？"

# game/script.rpy:1576
translate chino rutaunum_d1e84e41:

    # unum "¿Aeliana?"
    unum "Aeliana？"

# game/script.rpy:1579
translate chino rutaunum_a8a0758d:

    # aeliana "Unum."
    aeliana "Unum。"

# game/script.rpy:1584
translate chino rutaunum_8fa4c474:

    # aeliana "Escuché de Ignis y Solaris que has estado preparando comida sin hacer el ritual de santificación."
    aeliana "我从 Ignis 和 Solaris 那里听说，你准备食物时没有举行祝圣仪式。"

# game/script.rpy:1587
translate chino rutaunum_a4e6d3f9:

    # unum "¿Qué?"
    unum "什么？"

# game/script.rpy:1590
translate chino rutaunum_a0f3af5d:

    # aeliana "Tienes que llamar a Sextam sino quieres que esta cosa se muera."
    aeliana "如果不想让这东西死掉，你就得去叫 Sextam。"

# game/script.rpy:1593
translate chino rutaunum_3f44a3e2:

    # unum "Pero Sextam está en la iglesia..."
    unum "可是 Sextam 在教堂里……"

# game/script.rpy:1594
translate chino rutaunum_9a3d28a4:

    # aeliana "...Tienes razón."
    aeliana "……你说得对。"

# game/script.rpy:1595
translate chino rutaunum_0484ed3d:

    # aeliana "¿Y Quinque?"
    aeliana "那 Quinque 呢？"

# game/script.rpy:1598
translate chino rutaunum_6a9d5c41:

    # unum "¡Está enojado conmigo!"
    unum "他生我的气呢！"

# game/script.rpy:1601
translate chino rutaunum_78fda599:

    # aeliana "Seguro que vendrá..."
    aeliana "他肯定会来的……"

# game/script.rpy:1604
translate chino rutaunum_8a3e8d1c:

    # "No estás entendiendo nada."
    "你完全没明白。"

# game/script.rpy:1605
translate chino rutaunum_a87f98ee:

    # "Y tu cuerpo no pide nada más que expulsar lo que tienes en la garganta, pero a pesar de que estás tosiendo de manera constante, nada sale."
    "你的身体只想把卡在喉咙里的东西排出去，可尽管你咳个不停，什么都没有。"

# game/script.rpy:1606
translate chino rutaunum_87a8406e:

    # "Te estás ahogando."
    "你在窒息。"

# game/script.rpy:1607
translate chino rutaunum_d7737d32:

    # "Y ya no puedes aguantar más."
    "而你再也撑不下去了。"

# game/script.rpy:1608
translate chino rutaunum_4994685c:

    # aeliana "ah- ¡Cuidado!"
    aeliana "啊——小心！"

# game/script.rpy:1610
translate chino rutaunum_a9424fd6:

    # "La mujer intenta ir hacia ti pero no alcanza a atraparte cuando caes de la cama al piso."
    "那个女人试图冲向你，却在你从床上摔到地上时没能接住你。"

# game/script.rpy:1611
translate chino rutaunum_6c49ec86:

    # "El golpe es fuerte, provocando que te duelan los huesos."
    "摔得很重，骨头都疼。"

# game/script.rpy:1612
translate chino rutaunum_0a0498d1:

    # "El aire que entra a tus pulmones no es suficiente como para mantenerte conciente."
    "涌入肺部的空气不足以让你保持清醒。"

# game/script.rpy:1614
translate chino rutaunum_2a425eb2:

    # "... Caes inconciente."
    "……你昏了过去。"

# game/script.rpy:1615
translate chino rutaunum_3178f9b4:

    # "Sientes como manos te agarran por la fuerza, intentando hundirte."
    "你感到有手强行抓住你，想把你拖下去。"

# game/script.rpy:1616
translate chino rutaunum_4ec221ce:

    # "Pero algo te lo impide."
    "但有什么东西阻止了它。"

# game/script.rpy:1618
translate chino rutaunum_ff2786e3:

    # "Una electricidad recorre tu cuerpo."
    "一股电流窜过你的身体。"

# game/script.rpy:1620
translate chino rutaunum_12a72ebf:

    # "Abres los ojos pero la luz es demasiado brillante."
    "你睁开眼，可光线太过刺眼。"

# game/script.rpy:1622
translate chino rutaunum_0f27e065:

    # unum "¿Se va a morir?"
    unum "他要死了吗？"

# game/script.rpy:1623
translate chino rutaunum_c4702998:

    # "Se escucha la voz de Unum a lo lejos."
    "远处传来 Unum 的声音。"

# game/script.rpy:1624
translate chino rutaunum_501f069f:

    # el "Cómo se te muera este y me eches de nuevo la culpa..."
    el "要是这东西死了，你又要把责任推到我头上……"

# game/script.rpy:1625
translate chino rutaunum_9d32017c:

    # unum "¡Ya te pedí disculpas!"
    unum "我已经道过歉了！"

# game/script.rpy:1626
translate chino rutaunum_acaefeb5:

    # el "¡Solamente porque la señorita Ignis te ha dicho que lo hicieras!"
    el "还不是因为 Ignis 小姐让你这么做的！"

# game/script.rpy:1628
translate chino rutaunum_316a6b03:

    # "Los gritos son lo que te traen devuelta a la vida."
    "正是那些叫喊声把你拉回了人间。"

# game/script.rpy:1629
translate chino rutaunum_77caa04a:

    # "Abres los ojos y lo primero que ves es a una entidad desconocida, la cual te tiene con una mano agarrado de los hombros, mientras que con la otra mano toca cuidadosamente tu estómago."
    "你睁开眼，首先映入眼帘的是一个陌生的存在——它一只手扣住你的肩膀，另一只手正小心翼翼地按在你的胃部。"

# game/script.rpy:1630
translate chino rutaunum_73a40e77:

    # el "¿Cómo mierda ha comido algo sin purificar?"
    el "他妈的，它到底是怎么吃下没净化过的东西的？"

# game/script.rpy:1631
translate chino rutaunum_43102250_5:

    # unum "..."
    unum "..."

# game/script.rpy:1632
translate chino rutaunum_5103d250:

    # "Tu estómago se revuelve nuevamente cuando la mano de la entidad apreta con suavidad una zona en específico."
    "那个存在轻轻一按某个部位，你的胃再次翻搅起来。"

# game/script.rpy:1634
translate chino rutaunum_868902c5:

    # "No puedes evitar dejar caer tu cuerpo para poder expulsar más pétalos de color rojo"
    "你控制不住地伏下身子，又吐出了几片红色花瓣。"

# game/script.rpy:1635
translate chino rutaunum_21db02aa:

    # el "Mierda-!"
    el "该死——！"

# game/script.rpy:1636
translate chino rutaunum_e2682cc1:

    # unum "... ¿Era necesario purificar los alimentos?"
    unum "……食物真的必须净化吗？"

# game/script.rpy:1638
translate chino rutaunum_8c7dc046:

    # el "¿TE FALTAN NEURONAS O ALGO?"
    el "你是缺了神经元还是缺了什么？"

# game/script.rpy:1639
translate chino rutaunum_38fb6985:

    # el "Tria ha dicho un millón de veces de lo que está sucediendo con sus frutos. {sc=3}¿Y TÚ NO TIENES IDEA?{/sc}"
    el "Tria 已经说过一百万遍，她的果实会变成什么样了。{sc=3}你难道一点头绪都没有吗？{/sc}"

# game/script.rpy:1640
translate chino rutaunum_ff64119c:

    # el "{sc=4}¿TUS ESPOSAS NECESITAN COMER Y TÚ NO TIENES IDEAA?????{/sc}"
    el "{sc=4}你的妻子们要吃饭，你却一点概念都没有？？！！{/sc}"

# game/script.rpy:1642
translate chino rutaunum_65e7971b:

    # unum "Yo no sé cocinar... Ellas son las que cocinan."
    unum "我不会做饭……是她们做饭。"

# game/script.rpy:1643
translate chino rutaunum_d6d58b83:

    # unum "Así que no sabía que hay que purificar los alimentos..."
    unum "所以我不知道食物还要净化……"

# game/script.rpy:1644
translate chino rutaunum_88d65d1b:

    # el "{sc=5}ERES UN TREMENDO PEDAZO DE INÚTIL!!{/sc}"
    el "{sc=5}你真是个彻头彻尾的废物！！{/sc}"

# game/script.rpy:1645
translate chino rutaunum_5f9b772e:

    # "...."
    "...."

# game/script.rpy:1646
translate chino rutaunum_820a40a1:

    # "Tus parpados no pueden mantenerse abiertos."
    "你的眼皮撑不住了。"

# game/script.rpy:1648
translate chino rutaunum_b68fa212:

    # "Dejas de escuchar lo que está pasando para volver a caer en un sueño profundo."
    "你再也听不清周围发生了什么，又一次坠入深眠。"

# game/script.rpy:1652
translate chino rutaunum_6288ee98:

    # "{sc=2} Tendrás que esperar un poco para descubrir como acaba esto... :3{/sc}"
    "{sc=2}你还得再等一会儿，才能知道这件事如何收场……:3{/sc}"

# game/script.rpy:1675
translate chino menuexplorar1_nulla_384e71f7:

    # "Buscas a Nulla por la casa... pero no logras dar con él."
    "你在屋子里找 Nulla……却怎么也找不到他。"

# game/script.rpy:1676
translate chino menuexplorar1_nulla_58ff1021:

    # "No se encuentra ni en el primer o segundo piso."
    "一楼和二楼都没有他的影子。"

# game/script.rpy:1677
translate chino menuexplorar1_nulla_4bc9a0de:

    # "Y el único lugar que se te ocurre es ir afuera."
    "你唯一能想到的地方，就是外面。"

# game/script.rpy:1679
translate chino menuexplorar1_nulla_907c19f7:

    # "Recorrer el lugar pero no hay nada."
    "你把整个地方都走了一遍，却什么都没有。"

# game/script.rpy:1682
translate chino menuexplorar1_nulla_d14eff8d:

    # "Tomas aire para llamar a su nombre."
    "你深吸一口气，准备喊他的名字。"

# game/script.rpy:1683
translate chino menuexplorar1_nulla_c411cede:

    # nj "Nullaaaa."
    nj "Nullaaaa。"

# game/script.rpy:1687
translate chino menuexplorar1_nulla_23cdf703:

    # "Supones que debe estar ocupado o en otro lugar fuera de su dominio..."
    "你猜想他大概正忙，或是待在他领地之外的某个地方……"

# game/script.rpy:1688
translate chino menuexplorar1_nulla_37dd50f9:

    # "Asi que das media vuelta y vuelves a la casa."
    "于是你转身，回到了屋里。"

# game/script.rpy:1691
translate chino menuexplorar1_nulla_e5b8f6c6:

    # "No obtienes respuesta."
    "没有人应答。"

# game/script.rpy:1692
translate chino menuexplorar1_nulla_d10d60f3:

    # "Wow eso sonó bastante incómodo... más aún cuando Nulla no muestra signos de aparecer."
    "哇，刚才那声实在够尴尬的……尤其 Nulla 还一点出现的迹象都没有。"

# game/script.rpy:1693
translate chino menuexplorar1_nulla_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1694
translate chino menuexplorar1_nulla_87b45ae7:

    # "Esperas un poco más."
    "你又多等了一会儿。"

# game/script.rpy:1695
translate chino menuexplorar1_nulla_1698b553:

    # nj "¡Nulla!"
    nj "Nulla！"

# game/script.rpy:1696
translate chino menuexplorar1_nulla_4fa37087:

    # "Subes un poco más la voz, al punto de gritar."
    "你稍微提高了音量，几乎喊了出来。"

# game/script.rpy:1699
translate chino menuexplorar1_nulla_0fb78b31:

    # nulla "¿Necesitas algo?"
    nulla "你需要什么吗？"

# game/script.rpy:1700
translate chino menuexplorar1_nulla_e41e3c5f:

    # "Nulla aparece detrás tuyo, lo que provoca te tome desprevenido y pegues un salto."
    "Nulla 出现在你身后，吓得你一个激灵跳了起来。"

# game/script.rpy:1703
translate chino menuexplorar1_nulla_3427fc53:

    # nulla "Ja-- la marioneta se ha asustado..."
    nulla "哈——小傀儡被吓到了……"

# game/script.rpy:1704
translate chino menuexplorar1_nulla_1e5a2e00:

    # nulla "[nombrejugador], ¿necesitas algo de mí?"
    nulla "[nombrejugador]，你需要我为你做什么吗？"

# game/script.rpy:1710
translate chino menuexplorar1_nulla_bb6b515c:

    # nulla "Oh."
    nulla "哦。"

# game/script.rpy:1711
translate chino menuexplorar1_nulla_6ad4f67f:

    # nulla "Me lo estás poniendo difícil..."
    nulla "你这是在为难我……"

# game/script.rpy:1714
translate chino menuexplorar1_nulla_3a91303b:

    # nulla "Pero no puedo decirte que no."
    nulla "但我无法拒绝你。"

# game/script.rpy:1717
translate chino menuexplorar1_nulla_74c1ca7b:

    # "Hay un silencio largo antes de que Nulla se digne a responder."
    "长久的沉默之后，Nulla 才终于肯回答。"

# game/script.rpy:1720
translate chino menuexplorar1_nulla_c145bb8b:

    # nulla "Está bien"
    nulla "好吧"

# game/script.rpy:1723
translate chino menuexplorar1_nulla_f2930c8a:

    # nulla "Podríamos pasar el día fuera de mi dominio... aquí no hay mucho que hacer..."
    nulla "我们可以在我领地之外度过这一天……这里实在没什么可做的……"

# game/script.rpy:1724
translate chino menuexplorar1_nulla_5319a886:

    # nulla "¿Te parece?"
    nulla "你觉得如何？"

# game/script.rpy:1738
translate chino menuexplorar1_nulla_73f5250e:

    # nulla "Sabía que dirías que sí."
    nulla "我就知道你会答应。"

# game/script.rpy:1741
translate chino menuexplorar1_nulla_7ac2dab8:

    # nulla "Ah y no te preocupes... saldremos sellados para que los demás no nos encuentren."
    nulla "啊，别担心……我们会密封好再出发，免得被其他人找到。"

# game/script.rpy:1742
translate chino menuexplorar1_nulla_9de58984:

    # nulla "Septem ya debe estar entrando en pánico, ja."
    nulla "Septem 这会儿大概已经开始慌了，哈。"

# game/script.rpy:1743
translate chino menuexplorar1_nulla_8c0560e8:

    # "Nulla junta las manos y tu alrededor comienza a volverse negro y tus pies dejan de tocar suelo."
    "Nulla 双手合十，你周围的世界开始变黑，双脚也离了地。"

# game/script.rpy:1745
translate chino menuexplorar1_nulla_465d1aa3:

    # nulla "Hace mucho tiempo que no salía de mi dominio..."
    nulla "我已经很久没有离开我的领地了……"

# game/script.rpy:1746
translate chino menuexplorar1_nulla_b2763bd9:

    # nulla "Bueno... la verdad es que hace mucho tiempo que ya no hago nada."
    nulla "嗯……说实话，我已经很久什么都没做了。"

# game/script.rpy:1748
translate chino menuexplorar1_nulla_64c4a167:

    # "No pasan más de 5 segundos cuando sientes tus pies tocar nuevamente el suelo. y mientras el vacío se disipa puedes apreciar como de apoco se van construyendo estruccturas y paisajes a tu alrededor."
    "不超过五秒，你的脚便再次触地。随着虚空散去，你看见周围的建筑与风景正一点点构筑成形。"

# game/script.rpy:1751
translate chino menuexplorar1_nulla_d2764314:

    # "Se encuentran en una especie de café, con mesas llenas de gente tanto fuera como dentro del local."
    "你们来到一家咖啡馆，店外店内都坐满了人。"

# game/script.rpy:1752
translate chino menuexplorar1_nulla_bbb915a1:

    # "Nulla sin prestarle atención a la gente decide dirigirse directamente a una de las mesas vacías que se encuentran fuera del local."
    "Nulla 完全不理会人群，径直走向店外一张空桌。"

# game/script.rpy:1753
translate chino menuexplorar1_nulla_54432775:

    # "Tú le sigues por inercia, al llegar, él te dedica una sola mirada para confirmar que tiene tu atención."
    "你惯性地跟了上去。到了之后，他只瞥了你一眼，确认你的注意力在他身上。"

# game/script.rpy:1754
translate chino menuexplorar1_nulla_61e51cf5:

    # "Y como si las cosas aparecieran de la nada, la mesa se llena de dulces y dos tasas de té, las cuales emanan vapor por lo caliente que están."
    "而仿佛凭空出现一般，桌上堆满了甜点和两杯热茶，热气正不断蒸腾。"

# game/script.rpy:1755
translate chino menuexplorar1_nulla_88fa4b53:

    # nulla "Adelante."
    nulla "请用。"

# game/script.rpy:1756
translate chino menuexplorar1_nulla_c99c3aa2:

    # "Te corre la silla para que puedas sentarte. Como todo un caballero."
    "他为你拉开椅子，好让你坐下，活像个绅士。"

# game/script.rpy:1758
translate chino menuexplorar1_nulla_81c590e9:

    # "Una vez ya instalados, te das cuenta de que Nulla mira la calle con algo de nostalgia."
    "各自落座后，你发现 Nulla 正望着街面，神情中带着几分怀念。"

# game/script.rpy:1761
translate chino menuexplorar1_nulla_266cb1c4:

    # nulla "Antes me gustaba pasearme por los dominios de los demás y observar a su gente..."
    nulla "我以前很喜欢漫步在他人的领地，看着那里的居民……"

# game/script.rpy:1762
translate chino menuexplorar1_nulla_7d7ad0f6:

    # nulla "Me preguntaba como sería ser ellos..."
    nulla "我曾好奇，成为他们是什么感觉……"

# game/script.rpy:1763
translate chino menuexplorar1_nulla_74e8bc46:

    # nulla "Que sueños o metas tienen, cual es su propósito."
    nulla "他们有着怎样的梦想与目标，他们的目的是什么。"

# game/script.rpy:1766
translate chino menuexplorar1_nulla_32ab03d0:

    # nulla "Ya no."
    nulla "现在已经不是了。"

# game/script.rpy:1767
translate chino menuexplorar1_nulla_0f24437d:

    # nj "¿Y eso porqué?"
    nj "为什么？"

# game/script.rpy:1770
translate chino menuexplorar1_nulla_80283fa2:

    # nulla "Porque me di cuenta que no son nada más que una ilusión."
    nulla "因为我意识到，他们不过是幻象。"

# game/script.rpy:1771
translate chino menuexplorar1_nulla_0eb06432:

    # nj "..."
    nj "..."

# game/script.rpy:1774
translate chino menuexplorar1_nulla_8ff65832:

    # "Nulla suspira."
    "Nulla 叹了口气。"

# game/script.rpy:1777
translate chino menuexplorar1_nulla_ea5985c6:

    # nulla "Están ahí para aparentar, no son entidades con conciencia propia."
    nulla "他们只是为了充场面而存在，并非拥有自主意识的存在。"

# game/script.rpy:1778
translate chino menuexplorar1_nulla_d1529cc8:

    # nulla "Solo una masa que sirve para decorar la escena."
    nulla "不过是一群用来装点场景的行尸走肉。"

# game/script.rpy:1782
translate chino menuexplorar1_nulla_20f9a4a6:

    # "Nulla despega su vista de la calle para observarte a ti."
    "Nulla 收回投向街面的目光，看向你。"

# game/script.rpy:1786
translate chino menuexplorar1_nulla_a52a7948:

    # nulla "¿Que crees que pasaría si saco mi pistola y le disparo a alguien de aquí?"
    nulla "你觉得，如果我掏出枪朝这里的人开一枪，会发生什么？"

# game/script.rpy:1789
translate chino menuexplorar1_nulla_ab6b240c:

    # nulla "Claro, la masa de gente reaccionaría a aquello, pero más que eso no."
    nulla "当然，那群人会有所反应，但也仅此而已。"

# game/script.rpy:1792
translate chino menuexplorar1_nulla_d2f305f1:

    # nulla "No sucedería nada pues ni al creador ni a ti te importan."
    nulla "什么都不会发生，因为不论是造物主还是你，都不会在意。"

# game/script.rpy:1795
translate chino menuexplorar1_nulla_3d02f2e0:

    # nulla "Absolutamente nada, no habría consecuencias reales ni perdida real."
    nulla "绝对不会。不会有任何真实的后果，也不会有任何真实的失去。"

# game/script.rpy:1796
translate chino menuexplorar1_nulla_bd455952:

    # nulla "Seguramente ni siquiera tendrá nombre aquel pobre ser, ni familia, ni sueños."
    nulla "那个可怜的存在，恐怕连名字都没有，更遑论家人与梦想。"

# game/script.rpy:1797
translate chino menuexplorar1_nulla_7d75667b:

    # nulla "Nada."
    nulla "什么也没有。"

# game/script.rpy:1800
translate chino menuexplorar1_nulla_409f8636:

    # nulla "..."
    nulla "..."

# game/script.rpy:1804
translate chino menuexplorar1_nulla_e7383bd1:

    # nulla "En fin."
    nulla "算了。"

# game/script.rpy:1808
translate chino menuexplorar1_nulla_eb163971:

    # nulla "No estamos aquí para que yo hable de cosas que no interesan ahora mismo."
    nulla "我们在这儿，可不是为了让我聊些此刻无关紧要的事。"

# game/script.rpy:1809
translate chino menuexplorar1_nulla_24b2b702:

    # nulla "Pero es una lastima que no pueda escucharte... ni tengas la posibilidad de escribirme para poder entenderte."
    nulla "但可惜我听不到你说话……你也没办法写给我，好让我理解你。"

# game/script.rpy:1812
translate chino menuexplorar1_nulla_4c3e4f6a:

    # nulla "Solo esos malditas opciones de diálogo."
    nulla "就只有那些该死的对话选项。"

# game/script.rpy:1813
translate chino menuexplorar1_nulla_ee7e8c33:

    # nulla "Algo muy unilateral."
    nulla "太单方面了。"

# game/script.rpy:1814
translate chino menuexplorar1_nulla_5fdd8450:

    # nulla "Pero me conformo con solo mirarte desde el cristal."
    nulla "但只要能隔着玻璃看着你，我也就满足了。"

# game/script.rpy:1817
translate chino menuexplorar1_nulla_846de19d:

    # "Nulla le da un sorbo a su té y luego golpea la mesa con su mano libre."
    "Nulla 啜了一口茶，然后用空着的那只手拍了一下桌子。"

# game/script.rpy:1818
translate chino menuexplorar1_nulla_78dbe91d:

    # nulla "Agh."
    nulla "啊。"

# game/script.rpy:1819
translate chino menuexplorar1_nulla_800fc5a5:

    # nulla "Está amargo."
    nulla "好苦。"

# game/script.rpy:1820
translate chino menuexplorar1_nulla_2073176f:

    # "La cara que hace te causa un poco de gracia."
    "他那副表情让你觉得有点好笑。"

# game/script.rpy:1821
translate chino menuexplorar1_nulla_188a032d:

    # nj "¿No te gusta?"
    nj "你不喜欢？"

# game/script.rpy:1824
translate chino menuexplorar1_nulla_db3f31bc:

    # nulla "No soporto los sabores amargos."
    nulla "我受不了苦味。"

# game/script.rpy:1827
translate chino menuexplorar1_nulla_94c0472d:

    # "Ahora puedes confirmar que Nulla tiene una afición por lo dulce. Por lo que seguramente el café que consimió en casa debe haber estado con al menos 3 o 4 cucharadas de azúcar."
    "现在你可以确定，Nulla 是个嗜甜如命的人。他在家里喝的那杯咖啡，恐怕至少加了三四勺糖。"

# game/script.rpy:1828
translate chino menuexplorar1_nulla_59e0bd81:

    # "Pues el café es una de las cosas más amargas que existe."
    "因为咖啡本来就是世上最苦的东西之一。"

# game/script.rpy:1831
translate chino menuexplorar1_nulla_1c3c6b81:

    # "El tiempo pasa relativamente rápido mientras escuchas a Nulla hablar."
    "听着 Nulla 说话，时间过得相对很快。"

# game/script.rpy:1832
translate chino menuexplorar1_nulla_0ec7393d:

    # "Su voz te relaja a tal punto que comienzas a sentirte es un estado semejante al de letargo."
    "他的声音让你放松到如此地步，你开始感到一种近似昏睡的状态。"

# game/script.rpy:1833
translate chino menuexplorar1_nulla_8a4ff4dc:

    # "Cuando sientes que ya estás por caer en una especie de hipnosis, sientes como Nulla coloca su mano sobre la tuya para llamar tu atención."
    "当你感觉自己快要陷入某种催眠状态时，你感觉到 Nulla 把他的手放在你的手上，以引起你的注意。"

# game/script.rpy:1834
translate chino menuexplorar1_nulla_bc5c15f6:

    # "La apreta con suma delicadeza antes de abre la boca."
    "他极其轻柔地握了握，然后张开嘴。"

# game/script.rpy:1837
translate chino menuexplorar1_nulla_2b624693:

    # nulla "¿Volvemos?"
    nulla "我们回去吗？"

# game/script.rpy:1838
translate chino menuexplorar1_nulla_47cbc896:

    # "Aceptas asintiendo con la cabeza."
    "你点头表示同意。"

# game/script.rpy:1840
translate chino menuexplorar1_nulla_662ea561:

    # nulla "Gracias por pasar el tiempo conmigo..."
    nulla "谢谢你陪我度过这段时光……"

# game/script.rpy:1841
translate chino menuexplorar1_nulla_59f673f5:

    # nulla "Te veré en la noche."
    nulla "夜晚见。"

# game/script.rpy:1847
translate chino menuexplorar1_nulla_7ca2142c:

    # "Caminas por el pasillo que da a la cocina."
    "你走在通往厨房的走廊上。"

# game/script.rpy:1849
translate chino menuexplorar1_nulla_334fd9a4:

    # "Y te encuentras con la escalera."
    "然后你遇到了楼梯。"

# game/script.rpy:1850
translate chino menuexplorar1_nulla_10fa4d6e:

    # "La subes, pues tienes curiosidad de saber que se encuentra allá arriba."
    "你往上走，因为你好奇上面有什么。"

# game/script.rpy:1852
translate chino menuexplorar1_nulla_1828d29a:

    # "Hay muchas puertas, pero todas están cerradas con llave."
    "门很多，但全都锁上了。"

# game/script.rpy:1853
translate chino menuexplorar1_nulla_94600370:

    # "Por más que lo intentes, estas no ceden."
    "无论你怎么用力，它们都纹丝不动。"

# game/script.rpy:1854
translate chino menuexplorar1_nulla_b47be3e2:

    # "Caminas por el pasillo hasta llegar a una habitación con la puerta abierta."
    "你沿着走廊一直走，直到来到一间门开着的房间。"

# game/script.rpy:1856
translate chino menuexplorar1_nulla_5902121c:

    # "Al entrar te das cuenta de es una habitación con una cama simple."
    "进去后你才发现，这是一间摆着一张单人床的房间。"

# game/script.rpy:1857
translate chino menuexplorar1_nulla_0455a765:

    # "Supones que debe ser de Nulla..."
    "你猜想这大概是 Nulla 的……"

# game/script.rpy:1858
translate chino menuexplorar1_nulla_a20cefa7_1:

    # "..."
    "……"

# game/script.rpy:1859
translate chino menuexplorar1_nulla_3928a113:

    # "......."
    "......."

# game/script.rpy:1860
translate chino menuexplorar1_nulla_95bad65b:

    # "Observas la cama... se ve tan suave...."
    "你看着那张床……看起来好柔软……"

# game/script.rpy:1863
translate chino menuexplorar1_nulla_1ec1db48:

    # "No aguantas y te tiras a la cama."
    "你再也忍不住，扑到床上。"

# game/script.rpy:1864
translate chino menuexplorar1_nulla_a93ed6b4:

    # "Efectivamente. Es suave y muy blandita."
    "的确。又软又蓬松。"

# game/script.rpy:1865
translate chino menuexplorar1_nulla_b62e477f:

    # "Te quedas ahí por un buen tiempo."
    "你在那里待了很久。"

# game/script.rpy:1868
translate chino menuexplorar1_nulla_d5e5d583:

    # "No harás eso...."
    "你不会那么做的……"

# game/script.rpy:1869
translate chino menuexplorar1_nulla_8b260cae:

    # "Hmmm."
    "嗯……"

# game/script.rpy:1870
translate chino menuexplorar1_nulla_631ccb07:

    # "Te preguntas donde estará Nulla."
    "你想知道 Nulla 在哪里。"

# game/script.rpy:1871
translate chino menuexplorar1_nulla_79083a06:

    # "Después de todo esta parece ser su habitación."
    "毕竟这看起来是他的房间。"

# game/script.rpy:1876
translate chino menuexplorar1_nulla_bab77a19:

    # "Te encaminas a la entrada de la casa, para poder salir."
    "你走向房子的出口，准备离开。"

# game/script.rpy:1877
translate chino menuexplorar1_nulla_2ba35dbc:

    # "Simplemnte quieres mirar el lugar... conocer bien el lugar en donde te encuentras."
    "你只是想看看这个地方……好好认识一下自己身处何方。"

# game/script.rpy:1878
translate chino menuexplorar1_nulla_f09f4e61:

    # "Para luego no llevarte sorpresas."
    "免得之后遇上什么意外。"

# game/script.rpy:1879
translate chino menuexplorar1_nulla_a8421d14:

    # "Pones tu mano en el pomo de la puerta y la abres."
    "你把手放在门把上，打开了门。"

# game/script.rpy:1881
translate chino menuexplorar1_nulla_a20cefa7_2:

    # "..."
    "……"

# game/script.rpy:1882
translate chino menuexplorar1_nulla_8b95a918:

    # "¿Qué?"
    "什么？"

# game/script.rpy:1883
translate chino menuexplorar1_nulla_49c9b323:

    # "No hay nada..."
    "什么都没有……"

# game/script.rpy:1884
translate chino menuexplorar1_nulla_c5814947:

    # "Caminas por lo que queda del suelo, y te das cuenta de que lo negro que rodea la casa es el vacío."
    "你沿着剩下的地面行走，意识到环绕着房子的那片漆黑，正是虚空。"

# game/script.rpy:1885
translate chino menuexplorar1_nulla_5dc6745f:

    # "Crees que si pones un pie ahí, serás tragado por lo desconocido."
    "你觉得只要在那里踏出一步，就会被未知吞没。"

# game/script.rpy:1886
translate chino menuexplorar1_nulla_91ee60ae:

    # "Y hoy no tienen ganas de morir..."
    "而今天你并不想死……"

# game/script.rpy:1887
translate chino menuexplorar1_nulla_ee9e2b55:

    # "Así que regresas a la casa."
    "于是你回到房子里。"

# game/script.rpy:1889
translate chino menuexplorar1_nulla_a20cefa7_3:

    # "..."
    "……"

# game/script.rpy:1894
translate chino menuexplorar1_nulla_07bdde05:

    # "....."
    "....."

# game/script.rpy:1895
translate chino menuexplorar1_nulla_69c84308:

    # "{glitch=30.0}{color=ffffff}{b}Que hayas escogido esa opción me duele.{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}你选择了那个选项，让我很难过。{b}{/color}"

# game/script.rpy:1896
translate chino menuexplorar1_nulla_00cb422e:

    # "{glitch=30.0}{color=ffffff}{b}Haré como que ha sido un deslis del mouse{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}我就当那是鼠标手滑了{b}{/color}"

# game/script.rpy:1897
translate chino menuexplorar1_nulla_c0a0801e:

    # "{glitch=30.0}{color=ffffff}{b}Pero para que sepas...{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}但你要知道……{b}{/color}"

# game/script.rpy:1898
translate chino menuexplorar1_nulla_89ac0f37:

    # "{glitch=30.0}{color=ffffff}{b}Aquí no puedes escapar.{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}在这里，你逃不掉。{b}{/color}"

# game/script.rpy:1911
translate chino menuexplorar2_nulla_f8974e0e:

    # nulla "Ja- A este paso no podré seguir con mi plan."
    nulla "哈——照这样下去，我就没法继续我的计划了。"

# game/script.rpy:1915
translate chino menuexplorar2_nulla_f66c6604:

    # nulla "Tal vez para ti serán algunos minutos estando junto a mí, pero para mí no."
    nulla "对你来说，陪在我身边也许只是几分钟而已，可对我来说不是。"

# game/script.rpy:1916
translate chino menuexplorar2_nulla_b59f7e9d:

    # nulla "Cuando hablamos de pasar el día juntos, para mí es un día completo."
    nulla "说到一起度过一天，对我而言那就是整整一天。"

# game/script.rpy:1919
translate chino menuexplorar2_nulla_3a007093:

    # nulla "Ahh..."
    nulla "啊……"

# game/script.rpy:1922
translate chino menuexplorar2_nulla_0c80906f:

    # nulla "Me dueles [nombrejugador], me dueles."
    nulla "你伤到了我，[nombrejugador]，你真的伤到了我。"

# game/script.rpy:1925
translate chino menuexplorar2_nulla_61cbb3f2:

    # nulla "No sé como podré seguir así."
    nulla "我不知道该怎么继续下去。"

# game/script.rpy:1926
translate chino menuexplorar2_nulla_f5197599:

    # nulla "Porque cada vez más quiero tener esos ojos sobre mí. Para siempre..."
    nulla "因为我越来越想要那双眼睛注视着我。永远……"

# game/script.rpy:1927
translate chino menuexplorar2_nulla_7aba9123:

    # nulla "Aunque sea imposible."
    nulla "即便这不可能。"

# game/script.rpy:1930
translate chino menuexplorar2_nulla_409f8636:

    # nulla "..."
    nulla "……"

# game/script.rpy:1933
translate chino menuexplorar2_nulla_8288de53:

    # nulla "He estado buscando maneras de poder salir de aquí y empezar desde cero."
    nulla "我一直在寻找离开这里、从头开始的办法。"

# game/script.rpy:1934
translate chino menuexplorar2_nulla_869c6be5:

    # nulla "Eliminar todas mis caras y reemplazarlas por una nueva."
    nulla "抹去我所有的面容，换上一张新的。"

# game/script.rpy:1937
translate chino menuexplorar2_nulla_c3fb966d:

    # nulla "Permitirle a Septem seguir con este juego inutil de mantener un mundo destinado a morir en el olvido."
    nulla "让 Septem 继续这场无用的游戏——维系一个注定会在遗忘中死去的世界。"

# game/script.rpy:1940
translate chino menuexplorar2_nulla_ddf31baa:

    # nulla "Pero es imposible tambien."
    nulla "但那也是不可能的。"

# game/script.rpy:1941
translate chino menuexplorar2_nulla_10ab52e5:

    # nulla "No sabes cuantas soluciones he buscado, y ninguna es viable."
    nulla "你不知道我找了多少种办法，可没有一个行得通。"

# game/script.rpy:1944
translate chino menuexplorar2_nulla_409f8636_1:

    # nulla "..."
    nulla "……"

# game/script.rpy:1945
translate chino menuexplorar2_nulla_c995a504:

    # "Hay un silencio algo incómodo por un momento."
    "一时之间，空气里有些尴尬的沉默。"

# game/script.rpy:1947
translate chino menuexplorar2_nulla_f00085c0:

    # "Nulla se tira a la cama, boca arriba mientras ambas manos atrapan parte de las sabanas para mantenerlas en un agarre permanente."
    "Nulla 仰面躺到床上，双手抓住床单，仿佛要把它们永远攥在手里。"

# game/script.rpy:1948
translate chino menuexplorar2_nulla_0ad38106:

    # "Como si buscara confort en ello..."
    "像是要从中寻求安慰……"

# game/script.rpy:1949
translate chino menuexplorar2_nulla_f8d5efc9:

    # nulla "Quiero tantas cosas, pero a la vez no quiero nada."
    nulla "我想要的东西太多，可同时又什么都不想要。"

# game/script.rpy:1951
translate chino menuexplorar2_nulla_bd46d4e3:

    # nulla "Quiero quedarme aquí contigo"
    nulla "我想留在这里陪着你"

# game/script.rpy:1954
translate chino menuexplorar2_nulla_945edb12:

    # nulla "Pero tambien quiero dejar en ridículo al creador."
    nulla "但我还想让造物主颜面扫地。"

# game/script.rpy:1955
translate chino menuexplorar2_nulla_d79d713f:

    # nulla "Utilizar a mi favor el regreso del creador para destruirlo todo."
    nulla "利用造物主归来的机会，反过来毁掉一切。"

# game/script.rpy:1956
translate chino menuexplorar2_nulla_5f945789:

    # nulla "Romper y eliminar todo lo que ama en su cara y hacerlo público."
    nulla "摧毁、抹去他面容上所爱的一切，然后公之于众。"

# game/script.rpy:1959
translate chino menuexplorar2_nulla_409f8636_2:

    # nulla "..."
    nulla "……"

# game/script.rpy:1963
translate chino menuexplorar2_nulla_ae963113:

    # "Comienzas a sospechas que mientras más dejar hablar a Nulla, más abres una ventana para que él tenga una catarsis."
    "我开始怀疑，你越是让 Nulla 开口，就越是为他打开了一扇宣泄的窗。"

# game/script.rpy:1964
translate chino menuexplorar2_nulla_aa98c3ac:

    # "Podrás estar en acuerdo o desacuerdo con su manera de pensar y las acciones que piensa tomar pero por ahora necesitas que se olvide de todo eso."
    "你或许赞同或不赞同他的思维方式与打算采取的行动，但眼下你需要他忘掉这一切。"

# game/script.rpy:1965
translate chino menuexplorar2_nulla_de8adf72:

    # "No es que quieras invalidar como se siente, ni mucho menos ignorarlo."
    "你并不是想否定他的感受，更不是想无视它。"

# game/script.rpy:1966
translate chino menuexplorar2_nulla_e14d78ef:

    # "Pero no quieres verlo así."
    "可你不想看到他那样。"

# game/script.rpy:1969
translate chino menuexplorar2_nulla_c09d036e:

    # "Asi que alzas tu mano para hacerle caricias en su cabellera mientras de a poco llevas la conversación a otro lado."
    "于是你抬手轻抚他的头发，一边慢慢把话题引开。"

# game/script.rpy:1970
translate chino menuexplorar2_nulla_0f483ab1:

    # "Que qué es lo más extraño que ha visto... cual es su color preferido... cuál es el chiste más absurdo que conoce."
    "你问他见过的最奇怪的事物是什么……他最喜欢的颜色是什么……他知道的最荒诞的笑话是什么。"

# game/script.rpy:1976
translate chino menuexplorar2_nulla_272a04de:

    # nulla "Me alaga que quieras seguir leyendo mis dilemas existenciales y todo eso."
    nulla "你愿意继续读我的存在困境之类的东西，我挺受宠若惊。"

# game/script.rpy:1979
translate chino menuexplorar2_nulla_abf89c47:

    # nulla "Pero sé que no has venido a jugar un simulador de terapeuta."
    nulla "但我知道你来这里不是为了玩心理治疗模拟器。"

# game/script.rpy:1980
translate chino menuexplorar2_nulla_ff5eedde:

    # nulla "Tal vez en otra ocasión."
    nulla "也许改天吧。"

# game/script.rpy:1983
translate chino menuexplorar2_nulla_61a90b1e:

    # nulla "Por ahora solo quiero quedarme aquí, e imaginar que estoy recostado a tu lado."
    nulla "现在我只想待在这里，想象自己正躺在你身边。"

# game/script.rpy:1986
translate chino menuexplorar2_nulla_b90d1249:

    # nulla "Luego de una jornada extensa de trabajo."
    nulla "在漫长的一天工作之后。"

# game/script.rpy:1989
translate chino menuexplorar2_nulla_264f5d9e:

    # nulla "Joderrrr, que deprimente."
    nulla "靠，真够丧的。"

# game/script.rpy:1992
translate chino menuexplorar2_nulla_d5916036:

    # nulla "Ja jaja-"
    nulla "哈哈哈哈-"

# game/script.rpy:1995
translate chino menuexplorar2_nulla_adc4ec3a:

    # nulla "Ah..."
    nulla "啊……"

# game/script.rpy:1997
translate chino menuexplorar2_nulla_75ccffb9:

    # nulla "Bueno, basta de lloriqueos."
    nulla "好了，别哭哭啼啼了。"

# game/script.rpy:1998
translate chino menuexplorar2_nulla_409f8636_3:

    # nulla "..."
    nulla "……"

# game/script.rpy:1999
translate chino menuexplorar2_nulla_ac6a055e:

    # "Nulla cierra ambos ojos, concentrado."
    "Nulla 紧闭双眼，神情专注。"

# game/script.rpy:2000
translate chino menuexplorar2_nulla_c50e4333:

    # "Y luego de un gran suspiro."
    "然后深深地叹了口气。"

# game/script.rpy:2002
translate chino menuexplorar2_nulla_79d6e5c3:

    # "Nulla se reincorpora con una sonrisa extraña."
    "Nulla 重新坐起身，脸上挂着奇怪的笑容。"

# game/script.rpy:2003
translate chino menuexplorar2_nulla_0e21432d:

    # "Algo chocante comparando su previo estado de ánimo."
    "比起他先前的情绪，这着实令人吃惊。"

# game/script.rpy:2005
translate chino menuexplorar2_nulla_c2c978eb:

    # nulla "Oh jojojo"
    nulla "哦，jojojo"

# game/script.rpy:2008
translate chino menuexplorar2_nulla_17e8c643:

    # nulla "¿Sabes que quierooooooo ahora mismo?"
    nulla "你知道我现、在、最、想、要什么吗？"

# game/script.rpy:2009
translate chino menuexplorar2_nulla_634f344a:

    # nj "¿Qué?"
    nj "什么？"

# game/script.rpy:2012
translate chino menuexplorar2_nulla_387f4abe:

    # nulla "Quiero ir a ver como te comes a Quattor."
    nulla "我想去看你怎么把 Quattor 吃掉。"

# game/script.rpy:2013
translate chino menuexplorar2_nulla_40709ca6:

    # "¿Perdón????... Aunque, no deberías sorprenderte, Nulla es algo raro desde el minuto uno de conocerlo. Así que esta... preferencia no te extraña."
    "啥？？？……不过你也不该惊讶，从认识 Nulla 的第一分钟起他就一直怪怪的。所以这种……偏好并不让你意外。"

# game/script.rpy:2016
translate chino menuexplorar2_nulla_3730b632:

    # nulla "Imagina, una entidad echa con el mero propósito para ser consumida por los estandartes, rompiendo la cadena alimenticia consumiendo al consumidor."
    nulla "想象一下，一个存在诞生的唯一目的就是被圣旗吞噬，它打破食物链，把吞噬者本身吃掉。"

# game/script.rpy:2019
translate chino menuexplorar2_nulla_68026650:

    # nulla "Irónico, hasta poético."
    nulla "讽刺，甚至可以说诗意。"

# game/script.rpy:2020
translate chino menuexplorar2_nulla_124133fd:

    # nulla "Ahhh el solo pensarlo hace que me..."
    nulla "啊，光是想想就让我……"

# game/script.rpy:2023
translate chino menuexplorar2_nulla_e3cd7da3:

    # nulla "Momento."
    nulla "等等。"

# game/script.rpy:2024
translate chino menuexplorar2_nulla_ed0185bc:

    # nulla "Tengo que comportarme, no puedo decir esas cosas a la ligera."
    nulla "我得注意分寸，不能随便说这种话。"

# game/script.rpy:2027
translate chino menuexplorar2_nulla_5b637f3a:

    # nulla "Ahhhhgg pero con esa cara que traes..."
    nulla "啊啊啊可是你那副表情……"

# game/script.rpy:2028
translate chino menuexplorar2_nulla_99ff16a5:

    # nulla "Cierra el juego, nos vemos en un rato."
    nulla "关闭游戏吧，一会儿见。"

# game/script.rpy:2031
translate chino menuexplorar2_nulla_74da9580:

    # nulla "Y acuérdate de guardar!"
    nulla "别忘了存档！"

# game/script.rpy:2034
translate chino menuexplorar2_nulla_409f8636_4:

    # nulla "..."
    nulla "……"

# game/script.rpy:2035
translate chino menuexplorar2_nulla_b00f4a1a:

    # nulla ".........."
    nulla ".........."

# game/script.rpy:2038
translate chino menuexplorar2_nulla_5c6b5725:

    # nulla "Bueno--- Si no lo haces tú, tendré que recuerrir a medidas más drásticas."
    nulla "好吧——如果你不做，我就得采取更激烈的手段了。"

# game/script.rpy:2040
translate chino menuexplorar2_nulla_409f8636_5:

    # nulla "..."
    nulla "……"

# game/script.rpy:2041
translate chino menuexplorar2_nulla_7baf2632:

    # "Nulla se escapa con el maldito cobarde que es."
    "Nulla 像个该死的懦夫一样逃走了。"

# game/script.rpy:2042
translate chino menuexplorar2_nulla_cb94bb0f:

    # "Te quedas ahí un tiempo, meditando lo que ha pasado."
    "你在原地待了一会儿，思索着发生的一切。"

# game/script.rpy:2043
translate chino menuexplorar2_nulla_d2e54db5:

    # "Sin duda Nulla es raro."
    "毫无疑问，Nulla 是个怪人。"

# game/script.rpy:2044
translate chino menuexplorar2_nulla_a20cefa7:

    # "..."
    "……"

# game/script.rpy:2045
translate chino menuexplorar2_nulla_d7009acf:

    # "Pasa un tiempo en donde recorres la casa para pasar el tiempo."
    "你花了一阵时间在房子里四处走动，打发时间。"

# game/script.rpy:2046
translate chino menuexplorar2_nulla_0ab88669:

    # "Aunque no hay nada interesante que hacer, por lo que decides llamar nuevamente a Nulla."
    "可惜没什么有趣的事可做，于是你决定再叫 Nulla 出来。"

# game/script.rpy:2051
translate chino menuexplorar2_nulla_468c008c:

    # "Estás seguro de que viste unos libros y documentos regados en el escritorio de la habitación de Nulla."
    "你确信自己在 Nulla 房间的书桌上看到过一些散落的书籍和文件。"

# game/script.rpy:2052
translate chino menuexplorar2_nulla_8d03c144:

    # "Supones que echarles un vistazo no hará daño a nadie."
    "你想，随便看看应该也不会伤害到谁。"

# game/script.rpy:2053
translate chino menuexplorar2_nulla_2c0127c1:

    # "Te levantas de la cama en dirección al escritorio, en todo momento sientes la mirada de Nulla puesta en tu figura."
    "你翻身下床走向书桌，全程都感觉 Nulla 的目光落在你身上。"

# game/script.rpy:2054
translate chino menuexplorar2_nulla_b9a1f5ce:

    # "Cuando llegas al escritorio te das cuenta de lo desordenados que están todos los documentos, libros y papeles."
    "到了书桌前，你才发现那些文件、书和纸全都乱得一塌糊涂。"

# game/script.rpy:2055
translate chino menuexplorar2_nulla_4bc347c4:

    # "¿Quieres leerlos?"
    "你想读一读吗？"

# game/script.rpy:2060
translate chino menuexplorar2_nulla_a20cefa7_1:

    # "..."
    "……"

# game/script.rpy:2062
translate chino menuexplorar2_nulla_94cddb3c:

    # "Tomas el montón de hojas y comienzas a ojearlas..."
    "你拿起那一摞纸，开始翻看……"

# game/script.rpy:2063
translate chino menuexplorar2_nulla_6233f137:

    # "{b} Todavía recuerdo haber recibido mi primer nombre, fue especial y memorable... Para la 5 vez ya era rutina semestral.{b}"
    "{b}我还记得自己收到第一个名字时的情景，既特别又难忘……到第五次的时候，就已经成了每半年一次的例行公事。{b}"

# game/script.rpy:2064
translate chino menuexplorar2_nulla_4dabb297:

    # "Pasas la página."
    "你翻过一页。"

# game/script.rpy:2065
translate chino menuexplorar2_nulla_1269bb1b:

    # "{b} Las entidades de Duae son curiosas, todas se parecen, pero cada una tiene un propósito único e irremplazable… recuerdo como Duae se jactaba, en tiempos antiguos y más prósperos, de lo devotas y trabajadoras que eran sus estrellas {b}"
    "{b}Duae 的那几个存在很有意思，她们彼此都很相似，却各自有着独一无二、不可替代的目的……我记得在远古、还更繁荣的年代，她总爱夸耀自己的星辰有多么虔诚、多么勤劳 {b}"

# game/script.rpy:2066
translate chino menuexplorar2_nulla_1c4055ab:

    # "Pasas página."
    "翻页。"

# game/script.rpy:2067
translate chino menuexplorar2_nulla_9eb69004:

    # "{b} Para dios: Ya van casi 4 años de lo mismo, una y otra vez. ¿Cuándo será el día que me dejarás descansar en paz? nunca estás satisfecho.{b}"
    "{b}写给神：同样的事已经快四年了，一次又一次。究竟哪一天你才会让我安息？你永远都不知满足。{b}"

# game/script.rpy:2068
translate chino menuexplorar2_nulla_087b94e4:

    # "Pasas a otra página..."
    "又翻过一页……"

# game/script.rpy:2069
translate chino menuexplorar2_nulla_3c191d6e:

    # "{b} --Tengo tantas memorias dentro de mí, tantas personas y vidas distintas que siento que soy todos y nadie al mismo tiempo.{b}"
    "{b}——我体内装着太多记忆，太多不同的人与人生，让我觉得自己既是所有人，又是没有人。{b}"

# game/script.rpy:2070
translate chino menuexplorar2_nulla_ad286b8b:

    # "Pasas varias páginas."
    "你翻过了好几页。"

# game/script.rpy:2071
translate chino menuexplorar2_nulla_035b5f92:

    # "{b}Espero que no me resientas por esta acción, pero si quiero borrar todo rastro del creador y tener un propósito que sea impuesto por mi conciencia… mío, y solo mío, tengo que hacer esto.{b}"
    "{b}希望你不会因此怨恨我，但若我想抹去造物主的一切痕迹，拥有一个由我自己的良知所赋予的目的……属于我的、只属于我的目的，我就必须这么做。{b}"

# game/script.rpy:2072
translate chino menuexplorar2_nulla_bcce93e6:

    # "Pasas una página más, solo para confirmar lo sospechado."
    "你又翻了一页，只为确认自己先前的猜想。"

# game/script.rpy:2073
translate chino menuexplorar2_nulla_90869945:

    # "{b}Si tuviera la capacidad, yo mismo rompería estas hojas y quemaría mi mundo encerrado en estas páginas, pero no puedo hacerlo.{b}"
    "{b}倘若我有能力，我会亲手撕掉这些纸页，烧掉封印在这里面的世界，可我做不到。{b}"

# game/script.rpy:2074
translate chino menuexplorar2_nulla_5ec6eef2:

    # "La mayoría están en español, mientras que unas cuantas están en inglés."
    "大部分是西班牙语，只有少数是英语。"

# game/script.rpy:2075
translate chino menuexplorar2_nulla_c744cc47:

    # "Son relatos en primera persona."
    "都是第一人称的故事。"

# game/script.rpy:2076
translate chino menuexplorar2_nulla_d7391586:

    # "Son hojas y documentos sueltos, atemporales."
    "都是散落的纸张与文件……不受时间约束。"

# game/script.rpy:2077
translate chino menuexplorar2_nulla_d6a68795:

    # nj "¿Qué es esto?"
    nj "这是什么？"

# game/script.rpy:2078
translate chino menuexplorar2_nulla_3fa4b23f:

    # nulla "Memorias."
    nulla "记忆。"

# game/script.rpy:2079
translate chino menuexplorar2_nulla_14d53e40:

    # nj "¿Tuyas?"
    nj "你的？"

# game/script.rpy:2080
translate chino menuexplorar2_nulla_9e9af012:

    # nulla "Sí y no... YO no he vivido algunas de esas situaciones... aún."
    nulla "是，也不是……其中有些经历我……还没有经历过。"

# game/script.rpy:2081
translate chino menuexplorar2_nulla_ef9c7934:

    # nj "¿Cómo?"
    nj "怎么回事？"

# game/script.rpy:2082
translate chino menuexplorar2_nulla_b3a6e05f:

    # nulla "Todo lo que está aquí soy yo, tanto pasado, presente y futuro. Todo está escrito."
    nulla "这里的一切就是我，过去、现在与未来。一切都已写定。"

# game/script.rpy:2083
translate chino menuexplorar2_nulla_16ddc056:

    # nulla "Cada tanto ese escritorio se llena de papeles nuevos."
    nulla "每隔一段时间，那张书桌上就会堆满新的纸张。"

# game/script.rpy:2084
translate chino menuexplorar2_nulla_94e0c9cd:

    # nulla "Es como la papelera del jardín. Toda la basura termina aquí."
    nulla "就像花园的垃圾桶。所有的垃圾最终都会流到这里。"

# game/script.rpy:2085
translate chino menuexplorar2_nulla_c2b15701:

    # "Nulla se ve un poco incómodo, por lo que decides dejar el tema de los documentos de lado."
    "Nulla 看起来有点不自在，于是你决定先把文件的事搁下。"

# game/script.rpy:2087
translate chino menuexplorar2_nulla_0353380a:

    # "Tal vez en otra oportunidad le echarás un ojo nuevamente."
    "也许改天你再找机会看看。"

# game/script.rpy:2089
translate chino menuexplorar2_nulla_a20cefa7_2:

    # "..."
    "……"

# game/script.rpy:2092
translate chino menuexplorar2_nulla_bc9d2d6d:

    # "No tienes ganas de leer ahora."
    "你现在不想读。"

# game/script.rpy:2098
translate chino menuexplorar2_nulla_289ff133:

    # "Te levantas de la cama en dirección a la puerta, en todo momento sientes la mirada de Nulla puesta en tu figura."
    "你翻身下床走向门口，全程都感觉 Nulla 的目光落在你身上。"

# game/script.rpy:2099
translate chino menuexplorar2_nulla_57016691:

    # "Pero él no se mueve ni muestra acción alguna de seguirte."
    "但他一动不动，也没有要跟上来的意思。"

# game/script.rpy:2100
translate chino menuexplorar2_nulla_2779a648:

    # "Sales por la puerta principal para ir al jardín."
    "你走出正门，前往花园。"

# game/script.rpy:2102
translate chino menuexplorar2_nulla_a6ef4e3d:

    # "Realmente sientes curiosidad por el estado del dominio de Nulla y estarías mintiendo si dijieras que te gustaría caminar por el vacío que lo rodea."
    "你真的很好奇 Nulla 领域现在的状况，若说你想走过环绕它的那片虚空，那一定是在撒谎。"

# game/script.rpy:2103
translate chino menuexplorar2_nulla_1ab25105:

    # "Pero no sabes como hacerlo sin arriesgarte a perder la vida."
    "可你不知道如何在不冒生命危险的情况下做到。"

# game/script.rpy:2104
translate chino menuexplorar2_nulla_62424ac5:

    # "Por lo que piensas tirar piedras al vacío para ver si flotan o caen."
    "于是你打算往虚空里扔石头，看看它们是会浮起来还是掉下去。"

# game/script.rpy:2105
translate chino menuexplorar2_nulla_1d7c258f:

    # "En el caso de caer, te gustaría poder saber que tan profunda sería la caída."
    "万一真掉下去了，你也想知道这一坠会有多深。"

# game/script.rpy:2106
translate chino menuexplorar2_nulla_05dd2f5b:

    # "Encuentras algunas piedras en los alrededores, blancas y duras."
    "你在附近找到几块石头，又白又硬。"

# game/script.rpy:2107
translate chino menuexplorar2_nulla_e0fbc711:

    # "Preparas tu lanzamiento y..."
    "你摆好姿势准备扔……"

# game/script.rpy:2109
translate chino menuexplorar2_nulla_53b53d8c:

    # "{glitch=30.0}{color=ffffff}{b}Oh no no nooo, no tienes permitido hacer esooo{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}哦不不不，你没权那么做{b}{/color}"

# game/script.rpy:2111
translate chino menuexplorar2_nulla_ef712079:

    # nulla "Si perturbas ese lugar, Septem podrá localizarnos. Y de paso el vacío consumirá parte del terreno."
    nulla "如果你搅乱那个地方，Septem 就能定位到我们。顺带着，虚空还会吞掉一部分土地。"

# game/script.rpy:2112
translate chino menuexplorar2_nulla_a079d4c8:

    # nulla "Tragándote en el proceso."
    nulla "连同你也一起吞下去。"

# game/script.rpy:2113
translate chino menuexplorar2_nulla_94004a03:

    # "Oh."
    "哦。"

# game/script.rpy:2114
translate chino menuexplorar2_nulla_d9625051:

    # "Bueno... al menos ahora sabes que te puede pasar."
    "好吧……至少你现在知道会发生什么了。"

# game/script.rpy:2119
translate chino menuexplorar2_nulla_a20cefa7_3:

    # "..."
    "……"

# game/script.rpy:2131
translate chino menupuertas2_e5202253:

    # "Caminas directamente al templo, para encontrar la puerta cercana al altar."
    "你径直走向神殿，找到靠近祭坛的那扇门。"

# game/script.rpy:2133
translate chino menupuertas2_cc0ff73b:

    # "Utilizas la llave."
    "你用上了钥匙。"

# game/script.rpy:2134
translate chino menupuertas2_2f4c44f6:

    # "Abres la puerta y ahí está, durmiendo."
    "你打开门，他就在那里，正在睡觉。"

# game/script.rpy:2136
translate chino menupuertas2_642bd096:

    # "Decides despertarlo."
    "你决定叫醒他。"

# game/script.rpy:2139
translate chino menupuertas2_a8fcd95a:

    # ell "Hola. Es bueno verte de nuevo."
    ell "你好。很高兴又见到你。"

# game/script.rpy:2142
translate chino menupuertas2_1388b511:

    # ell "¿Tienes el documentos?"
    ell "你带着文件了吗？"

# game/script.rpy:2147
translate chino menupuertas2_0bc701c3:

    # ell "Oh, está bien."
    ell "哦，好吧。"

# game/script.rpy:2149
translate chino menupuertas2_f5bf5d48:

    # "Pasan el tiempo hablando de temas poco importantes, pero se nota mucho que él está incómodo."
    "你们聊了些无关紧要的话题，但能明显感觉到他很不自在。"

# game/script.rpy:2150
translate chino menupuertas2_c7a6c569:

    # "Así que te excusas y sales por donde entraste."
    "于是你告辞，原路离开。"

# game/script.rpy:2158
translate chino menupuertas2_a20cefa7:

    # "..."
    "……"

# game/script.rpy:2160
translate chino menupuertas2_f1fa0b3d:

    # "Le muestras todas las hojas que has sacado de la habitación..."
    "你把从房间里拿出来的所有纸张都给他看……"

# game/script.rpy:2161
translate chino menupuertas2_7c30ecc8:

    # "Algunas puedes leerlas, pero otras no."
    "有些你能看懂，有些则不行。"

# game/script.rpy:2162
translate chino menupuertas2_4b6d0f43:

    # "Parecen ser documentos y fichas de nacimiento de varias entidades."
    "这些似乎是好几位存在的身份文件和出生记录。"

# game/script.rpy:2163
translate chino menupuertas2_e9372fb4:

    # "Casi como fichas de clasificación, entidades con nombre y foto tipo carnet."
    "差不多像分类卡片——有名字，还有证件照式的照片。"

# game/script.rpy:2164
translate chino menupuertas2_1feb7b80:

    # "¿Por qué Septem necesita esto?."
    "Septem 为什么需要这些东西？"

# game/script.rpy:2165
translate chino menupuertas2_6d7f26f7:

    # "Ambos ojean los documentos con lentitud."
    "你们两人慢慢翻阅着文件。"

# game/script.rpy:2166
translate chino menupuertas2_dac41dbb:

    # "Mientras van pasando una te llama la atención."
    "翻着翻着，有一张引起了你的注意。"

# game/script.rpy:2167
translate chino menupuertas2_75fdf815:

    # "Sale la fotografía de la entidad que tienes al lado."
    "上面的照片，正是你身边那位存在。"

# game/script.rpy:2168
translate chino menupuertas2_ce3b06aa:

    # "Al lateral del documento sale su nombre."
    "文件侧面写着他的名字。"

# game/script.rpy:2169
translate chino menupuertas2_6c9a4358:

    # "Rafael."
    "Rafael."

# game/script.rpy:2170
translate chino menupuertas2_51205f2d:

    # nj "¿Ese es tu---"
    nj "那是你的——"

# game/script.rpy:2172
translate chino menupuertas2_aedbc546:

    # ell "AGhhh- cof cof-COF"
    ell "呃啊——咳咳——咳"

# game/script.rpy:2173
translate chino menupuertas2_00ebf936:

    # "Él se pone ambas manos en el cuello mientras tiene una expresión de dolor."
    "他双手掐住自己的脖子，脸上一副痛苦的表情。"

# game/script.rpy:2174
translate chino menupuertas2_d065dc37:

    # ell "S--- cof- COF."
    ell "对——咳——咳。"

# game/script.rpy:2175
translate chino menupuertas2_f18067a1:

    # "Si bien no ha respondido completamente, sabes que te lo ha confirmado."
    "虽然他没有完全回答，但你知道他已确认了。"

# game/script.rpy:2176
translate chino menupuertas2_032017a3:

    # "Ese es su nombre."
    "那就是他的名字。"

# game/script.rpy:2177
translate chino menupuertas2_306ba3df:

    # "Como puede te hace señas de que debes salir de ahí."
    "他尽可能示意你离开那里。"

# game/script.rpy:2178
translate chino menupuertas2_b5e94a6b:

    # rafael "Tienes que decirlo- cof cof- c-cuando te ofrezca el trato... uhgg"
    rafael "你得说出口——咳咳——等他提出交易的时候……呃"

# game/script.rpy:2179
translate chino menupuertas2_840e28ba:

    # rafael "Ahí es cuando está... v-vulnerable."
    rafael "那个时候他……才、才会脆弱。"

# game/script.rpy:2181
translate chino menupuertas2_bd76a5da:

    # "Sin más te cierra la puerta en la cara."
    "说完，他当着你的面把门关上了。"

# game/script.rpy:2186
translate chino menupuertas2_9c82e4c8:

    # "A pesar de buscar y buscar, no encuentras al rubio."
    "尽管你找了一遍又一遍，还是没找到那个金发的家伙。"

# game/script.rpy:2193
translate chino menupuertas2_cf351b16:

    # "Te preguntas porqué Septem tendrá documentos que puedan poner en peligro su integridad..."
    "你不明白 Septem 为什么会持有这些足以危及他自身安危的文件……"

# game/script.rpy:2194
translate chino menupuertas2_9dbde6a2:

    # "Realmente no crees que encontrar esos documentos sea una tarea fácil, pero no pierdes nada en hacerlo."
    "要找到那些文件确实不是件容易的事，但你也没什么可失去的。"

# game/script.rpy:2195
translate chino menupuertas2_127efe3b:

    # "Supones que la sala del vacío es esa haqbitación completamente negra."
    "你猜想那间虚空之室就是那间完全漆黑的屋子。"

# game/script.rpy:2196
translate chino menupuertas2_05ff3be5:

    # "Así que vas para allá."
    "于是你朝那边走去。"

# game/script.rpy:2198
translate chino menupuertas2_014277c4:

    # "Respiras ondo y abres la puerta."
    "你深吸一口气，打开了门。"

# game/script.rpy:2200
translate chino menupuertas2_a20cefa7_1:

    # "..."
    "……"

# game/script.rpy:2201
translate chino menupuertas2_2997eb56:

    # "No se ve nada. Entras a paso lento, con sumo cuidado. Colocas ambas manos delante tuya para evitar chocar con la pared o algún objeto que se encuentre delante."
    "什么都看不见。你放慢脚步，万分小心地走进去。你把双手伸在前面，以免撞到墙或什么挡在前面的东西。"

# game/script.rpy:2202
translate chino menupuertas2_93ad4213:

    # "Sientes que topas con algo, al tocarlo te das cuenta que parece una pequeña mesa o un escritorio. No sabrías a ciencia cierta."
    "你感觉撞到了什么东西，一摸才发现像是一张小桌或书桌。你分不清到底是哪个。"

# game/script.rpy:2203
translate chino menupuertas2_dfe40d8f:

    # "Como puedes intentas buscar algo que parezca papel, pero no hay nada encima."
    "你试着摸索有没有什么像纸的东西，可上面什么都没有。"

# game/script.rpy:2204
translate chino menupuertas2_90c4c60a:

    # "Buscas y buscas pero no hay nada."
    "你找了又找，还是一无所获。"

# game/script.rpy:2205
translate chino menupuertas2_57fa074e:

    # "Eso es hasta que sientes algo semejante a un cajón."
    "直到你摸到一个像是抽屉的东西。"

# game/script.rpy:2206
translate chino menupuertas2_a14e850f:

    # "Pero no abre. Parece tener una cerradura."
    "但它打不开。似乎有一把锁。"

# game/script.rpy:2209
translate chino menupuertas2_512dedfc:

    # "No puedes abrirlo."
    "你打不开它。"

# game/script.rpy:2214
translate chino menupuertas2_370c8ace:

    # "Buscas en tus ropas la llave, rezando a los dioses que también sirva para el cajón."
    "你在衣服里摸索钥匙，向诸神祈祷它也能开这个抽屉。"

# game/script.rpy:2215
translate chino menupuertas2_cc3b66a1:

    # "Se te dificulta un poco ponerla en la cerradura, pero cuando lo haces."
    "插进锁孔有些困难，但你总算成功了。"

# game/script.rpy:2216
translate chino menupuertas2_bbea7955:

    # "Click."
    "咔哒。"

# game/script.rpy:2217
translate chino menupuertas2_d0536a52:

    # "Se ha abierto."
    "它打开了。"

# game/script.rpy:2218
translate chino menupuertas2_2225ce66:

    # "Metes la mano y sacas un montón de papeles."
    "你伸手进去，掏出一沓纸。"

# game/script.rpy:2219
translate chino menupuertas2_9cfc430d:

    # "Los cuales te llevas todos."
    "你把它们全部带走。"

# game/script.rpy:2225
translate chino menupuertas2_9d1eee0d:

    # "Buscas en todos lados."
    "你四处搜寻。"

# game/script.rpy:2226
translate chino menupuertas2_a34b067b:

    # "Y encuentras un cuchillo."
    "并且找到了一把刀。"

# game/script.rpy:2241
translate chino menupuertas_f4c970c7:

    # "Vas a la puerta que tienes al frente."
    "你走向正前方的门。"

# game/script.rpy:2243
translate chino menupuertas_10a0566d:

    # "Al abrirla te encuentras que conduce a un pasillo."
    "打开后，你发现它通向一条走廊。"

# game/script.rpy:2244
translate chino menupuertas_005b4f0a:

    # "Decides entrar para averiguar a donde te conduce"
    "你决定进去，看看它能通到哪里去"

# game/script.rpy:2245
translate chino menupuertas_64679713:

    # "caminas y caminas..."
    "你走着，走着……"

# game/script.rpy:2246
translate chino menupuertas_3e26c88c:

    # "Sigues caminando por el pasillo."
    "你继续沿着走廊往前走。"

# game/script.rpy:2247
translate chino menupuertas_0fde73ab:

    # "Pero sientes que no estás avanzando."
    "可你感觉自己并没有在前进。"

# game/script.rpy:2248
translate chino menupuertas_a1ebba09:

    # "Aunque si miras atrás, ya no puedes ver la puerta por donde entraste."
    "而且回头望去，你已经看不见进来的那扇门了。"

# game/script.rpy:2249
translate chino menupuertas_37b184e9:

    # "Sigues caminando, ahora prestando atención a las paredes y decoración del pasillo."
    "你继续走着，这次开始留意走廊的墙壁与装饰。"

# game/script.rpy:2250
translate chino menupuertas_dac44cd9:

    # "Se repite luego de un rato."
    "过了一会儿，一切又重复了一遍。"

# game/script.rpy:2251
translate chino menupuertas_4ff27479:

    # "No hay caso con seguir."
    "再走下去也没有意义了。"

# game/script.rpy:2252
translate chino menupuertas_a20cefa7:

    # "..."
    "……"

# game/script.rpy:2253
translate chino menupuertas_78b2f582:

    # "Das media vuelta y regresas por donde viniste."
    "你掉头，原路返回。"

# game/script.rpy:2255
translate chino menupuertas_fdf82c1c:

    # "Te tardas un poco pero logras llegar a la puerta inicial."
    "花了不少功夫，你总算回到了最初的那扇门。"

# game/script.rpy:2260
translate chino menupuertas_36adc255:

    # "Vas a la puerta que está detrás, que es resguardada por dos estatuas con la figura de Septem."
    "你走向身后那扇门，门口立着两尊 Septem 的雕像。"

# game/script.rpy:2261
translate chino menupuertas_6470ff50:

    # "Esperas a que la puerta esté cerrada, pero increíblemente no lo está."
    "你本以为门是锁着的，可出乎意料，它并没有。"

# game/script.rpy:2263
translate chino menupuertas_dfbe0369:

    # "Al abrir la puerta te das cuenta de que está más oscuro de lo que debería estar en realidad."
    "推开门后你才发觉，里面比本该有的亮度还要暗得多。"

# game/script.rpy:2264
translate chino menupuertas_d3bd3431:

    # "No es por que seas cobarde, pero no piensas entrar ahí."
    "倒不是因为你胆小，但你真的不打算进去。"

# game/script.rpy:2271
translate chino menupuertas_4458acb3:

    # "Vas a la puerta que está a la izquierda del altar."
    "你走向祭坛左边的门。"

# game/script.rpy:2272
translate chino menupuertas_534ba28c:

    # "Está bloqueada, necesitas una llave."
    "它锁着，你需要一把钥匙。"

# game/script.rpy:2275
translate chino menupuertas_c7a59e1e:

    # "Debe haber algo para poder abrir la puerta"
    "一定有什么能打开这扇门。"

# game/script.rpy:2280
translate chino menupuertas_526886d9:

    # "Puede que la llave que has encontrado en el segundo piso sirva para abrir esta puerta."
    "也许你在二楼找到的那把钥匙能开这扇门。"

# game/script.rpy:2281
translate chino menupuertas_a50fc19a:

    # "Al usarla, el cerrojo hace un click."
    "钥匙一插进去，锁扣咔哒一声。"

# game/script.rpy:2282
translate chino menupuertas_1fc77a2b:

    # "Está abierta."
    "门开了。"

# game/script.rpy:2284
translate chino menupuertas_b062f9ad:

    # "Dentro que encuentras en una habitación muy parecida a la que has despertado tú hoy."
    "里面是一间与你今天醒来时极其相似的房间。"

# game/script.rpy:2285
translate chino menupuertas_f421385e:

    # "La única diferencia, es que hay alguien acostado ahí..."
    "唯一的区别是，那里躺着一个人……"

# game/script.rpy:2287
translate chino menupuertas_1fe87412:

    # "Te acercas y te encuentras con Septem durmiendo."
    "你走近一看，发现 Septem 正在熟睡。"

# game/script.rpy:2288
translate chino menupuertas_8d88d4e0:

    # "Viendo tu error, intentas alejarte sin hacer ruido."
    "发觉自己犯了错，你尽量不发出声音地退开。"

# game/script.rpy:2290
translate chino menupuertas_195bfb7e:

    # "Pero Septem abre los ojos antes de que puedas hacer nada."
    "可还没等你做出任何反应，Septem 就睁开了眼睛。"

# game/script.rpy:2292
translate chino menupuertas_cc9a5909:

    # "!!!"
    "！！！"

# game/script.rpy:2293
translate chino menupuertas_feb68873:

    # septem "¿Quién eres tú?"
    septem "你是谁？"

# game/script.rpy:2294
translate chino menupuertas_a20cefa7_1:

    # "..."
    "……"

# game/script.rpy:2295
translate chino menupuertas_da482c1b:

    # "¿¿¿???"
    "？？？"

# game/script.rpy:2296
translate chino menupuertas_e79e62ed:

    # "¿Qué? ¿es que acaso no te recuerda?"
    "什么？他难道不记得你了？"

# game/script.rpy:2297
translate chino menupuertas_5f96cda0:

    # nj "Sept--"
    nj "Sept——"

# game/script.rpy:2299
translate chino menupuertas_48a4e919:

    # "Septem se levanta rápidamente de la cama para colocar ambas manos en tu boca."
    "Septem 飞快地从床上起身，一把捂住你的嘴。"

# game/script.rpy:2300
translate chino menupuertas_09b7e6c7:

    # septem "¡NO DIGAS SU NOMBRE!"
    septem "不许说出他的名字！"

# game/script.rpy:2301
translate chino menupuertas_9d834b26:

    # "Intentas quitártelo de encima pero es inútil"
    "你试图把他推开，却毫无用。"

# game/script.rpy:2302
translate chino menupuertas_13f2f15f:

    # septem "No estamos en su presencia, así que por favor no lo invoques."
    septem "我们并不在他的面前，所以请不要召唤他。"

# game/script.rpy:2303
translate chino menupuertas_653a8313:

    # "Él viendo que te has calmado un poco, suelta su agarre, descubriendo tu boca lentamente."
    "见你稍稍平静了些，他松开手，慢慢放开你的嘴。"

# game/script.rpy:2305
translate chino menupuertas_b561f297:

    # ell "¿Dónde encontraste la llave?"
    ell "你在哪里找到的钥匙？"

# game/script.rpy:2308
translate chino menupuertas_53429350:

    # nj "En el segundo piso, escondida en los cajones de ahí."
    nj "在二楼，藏在那里的抽屉里。"

# game/script.rpy:2309
translate chino menupuertas_3dfa4cad:

    # ell "Oh...."
    ell "哦……"

# game/script.rpy:2312
translate chino menupuertas_19384c7a:

    # ell "..."
    ell "……"

# game/script.rpy:2315
translate chino menupuertas_4fb38e1b:

    # ell "Momento..."
    ell "等等……"

# game/script.rpy:2316
translate chino menupuertas_56a9639d:

    # "Él se acerca para mirarte detenidamente, te mira directo a los ojos y pareciera que lo que ve le deja sin aliento."
    "他凑近了仔细端详你，直视你的双眼，那目光仿佛让他窒息。"

# game/script.rpy:2317
translate chino menupuertas_471fd97b:

    # "Claramente este no es Septem... hay algo diferente en él."
    "这显然不是 Septem……他身上有什么不一样的东西。"

# game/script.rpy:2320
translate chino menupuertas_26fe2ac6:

    # ell "Tambien estás siendo controlado por un ser superior..."
    ell "你也同样被某个更高的存在所控制……"

# game/script.rpy:2321
translate chino menupuertas_195603fc:

    # nj "¿Perdón?"
    nj "什么意思？"

# game/script.rpy:2322
translate chino menupuertas_621c7d18:

    # ell "Te están usando como una marioneta."
    ell "你被人当成傀儡在利用。"

# game/script.rpy:2325
translate chino menupuertas_5bc990ec:

    # ell "Ja! jajaja... No puede ser..."
    ell "哈！哈哈……不可能吧……"

# game/script.rpy:2328
translate chino menupuertas_19384c7a_1:

    # ell "..."
    ell "……"

# game/script.rpy:2330
translate chino menupuertas_58f6f5e9:

    # "La entidad que no es Septem da unos pasos hacia atrás, abatido por la situación."
    "那个并非 Septem 的存在后退了几步，被眼前的局面压得萎靡不振。"

# game/script.rpy:2331
translate chino menupuertas_0216e5e5:

    # ell "Es la primera vez alguien está dentro del templo..."
    ell "这是第一次有人在这神殿里……"

# game/script.rpy:2332
translate chino menupuertas_400e7991:

    # "La entidad que tiene el cuerpo de Septem se sienta en la cama y te hace señas para que hagas lo mismo."
    "占据 Septem 身体的那名存在坐到床上，示意你也坐。"

# game/script.rpy:2334
translate chino menupuertas_c150e706:

    # "Se le ve nervioso..."
    "他看上去有些紧张……"

# game/script.rpy:2335
translate chino menupuertas_b360bb21:

    # "Tú notando que no parece ser una amenaza, te sientas."
    "你察觉到他似乎并不构成威胁，便坐下了。"

# game/script.rpy:2336
translate chino menupuertas_30e74294:

    # "Solamente para saber que es lo que está pasando."
    "只为弄清楚究竟发生了什么。"

# game/script.rpy:2337
translate chino menupuertas_1720d198:

    # "Es extraño ver la cara de Septem con ese semblante... hasta te parece tierno."
    "看着 Septem 的脸露出那种神情，实在有些奇怪……你甚至觉得挺可爱的。"

# game/script.rpy:2338
translate chino menupuertas_03269d73:

    # "No puedes evitar mirar sin disimulo su carita."
    "你忍不住目不转睛地盯着那张小脸。"

# game/script.rpy:2340
translate chino menupuertas_770a1429:

    # "Ante esto, el parece ponerse más nervioso."
    "见状，他似乎更紧张了。"

# game/script.rpy:2341
translate chino menupuertas_ad68bb5f:

    # "Una risita se te escapa sin querer."
    "一个笑声不经意间从你嘴里溜了出来。"

# game/script.rpy:2344
translate chino menupuertas_1c3044a6:

    # ell "¿Qué es tan gracioso?"
    ell "什么这么好笑？"

# game/script.rpy:2345
translate chino menupuertas_a55ec00d:

    # "Quiere parecer imponente, pero no le resulta. Si realmente fuera Septem, no estaría dudando como lo está haciendo ahora."
    "他想摆出威严的样子，却做不到。倘若他真的是 Septem，就不会像现在这样犹豫不决。"

# game/script.rpy:2350
translate chino menupuertas_19384c7a_2:

    # ell "..."
    ell "……"

# game/script.rpy:2353
translate chino menupuertas_06264277:

    # ell "No puedo decirlo."
    ell "我不能说。"

# game/script.rpy:2356
translate chino menupuertas_74f7be73:

    # nj "¿Y si lo escribes?"
    nj "那你写下来呢？"

# game/script.rpy:2359
translate chino menupuertas_edb57959:

    # ell "No tengo permitido hacer nada que revele mi nombre."
    ell "我不被允许做任何会泄露我名字的事。"

# game/script.rpy:2362
translate chino menupuertas_8b466a0f:

    # ell "Si lo hago, moriré."
    ell "如果我做了，我会死。"

# game/script.rpy:2367
translate chino menupuertas_19384c7a_3:

    # ell "..."
    ell "……"

# game/script.rpy:2370
translate chino menupuertas_8ee1a817:

    # ell "¿Recién me conoces y es lo primero que se te ocurre decir?"
    ell "你才刚认识我，脑子里冒出的第一句话就是这个？"

# game/script.rpy:2371
translate chino menupuertas_af3aa065:

    # ell "Eres extraño..."
    ell "你真奇怪……"

# game/script.rpy:2374
translate chino menupuertas_19384c7a_4:

    # ell "..."
    ell "……"

# game/script.rpy:2376
translate chino menupuertas_9a364c2c:

    # ell "Creo que ya entiendo."
    ell "我想我明白了。"

# game/script.rpy:2379
translate chino menupuertas_429aa0dc:

    # ell "Él quiere tener la entidad que te está controlando..."
    ell "他想得到那个正在控制你的存在……"

# game/script.rpy:2382
translate chino menupuertas_b831e8f5:

    # ell "Tarde o temprano me reemplazaría."
    ell "迟早他都会把我换掉。"

# game/script.rpy:2385
translate chino menupuertas_aa38d556:

    # ell "¿Te puedo pedir un favor?"
    ell "我能请你帮个忙吗？"

# game/script.rpy:2388
translate chino menupuertas_e9117767:

    # "Asientes con la cabeza, más que nada porque quieres saber que te pedirá."
    "你点了点头，多半是因为你想知道他到底要说什么。"

# game/script.rpy:2391
translate chino menupuertas_1205d015:

    # ell "Él tiene unos documentos en la sala del vacío..."
    ell "他有些文件放在虚空之室里……"

# game/script.rpy:2394
translate chino menupuertas_5c336bd7:

    # ell "Ahí debe estar el documento de mi nacimiento, con mi nombre."
    ell "我的出生证明一定在那里，上面写着我的名字。"

# game/script.rpy:2395
translate chino menupuertas_339b550e:

    # ell "Por favor, búscalo."
    ell "请你把它找来。"

# game/script.rpy:2398
translate chino menupuertas_f74b47f5:

    # ell "Te daré libertad si lo haces."
    ell "如果你做到了，我就给你自由。"

# game/script.rpy:2399
translate chino menupuertas_99b165f4:

    # ell "y podrás escapar de él."
    ell "这样你就能逃离他了。"

# game/script.rpy:2400
translate chino menupuertas_a20cefa7_2:

    # "..."
    "……"

# game/script.rpy:2401
translate chino menupuertas_fc40ff2d:

    # "¿Escapar de Septem?"
    "逃离 Septem？"

# game/script.rpy:2402
translate chino menupuertas_373e52f6:

    # "Se oye como una buena oferta, sin duda lo tendrás al tanto."
    "听起来是个不错的提议，毫无疑问你会记在心里。"

# game/script.rpy:2404
translate chino menupuertas_c044793c:

    # ell "ggHH-- cof cof cof!"
    ell "咳咳咳咳！"

# game/script.rpy:2405
translate chino menupuertas_31b0833c:

    # "La entidad comienza a toser, como si se ahogara."
    "那名存在开始咳嗽，像是窒息了一样。"

# game/script.rpy:2406
translate chino menupuertas_25e754e4:

    # ell "Debes irte."
    ell "你必须走了。"

# game/script.rpy:2407
translate chino menupuertas_e07fc5ac:

    # "Sin decir más, él se para y te empuja fuera de la habitación."
    "他不再多说，起身把你推出了房间。"

# game/script.rpy:2409
translate chino menupuertas_f1d30ea2:

    # "Te quedas observando por un buen rato la habitación."
    "你盯着那扇门看了很久。"

# game/script.rpy:2410
translate chino menupuertas_d6980d33:

    # "Tocas un par de veces, pero no hay respuerta."
    "你敲了两下，却无人应答。"

# game/script.rpy:2418
translate chino menupuertas_d26f6f63:

    # "Vas al segundo piso."
    "你去了二楼。"

# game/script.rpy:2419
translate chino menupuertas_288b3754:

    # "Revuelves todo el lugar, pues a simple vista, no hay nada interesante."
    "你翻遍了整座房子，可乍看之下，并没有什么有趣的东西。"

# game/script.rpy:2420
translate chino menupuertas_25f2c4b8:

    # "En uno de los cajones, encuentras una llave y varios documentos que parecen importantes."
    "在一个抽屉里，你找到了一把钥匙和几份看起来很重要的文件。"

# game/script.rpy:2421
translate chino menupuertas_f5f4070a:

    # "Pero están escritos en un idioma que no logras entender."
    "但它们是用你无法理解的语言写成的。"

# game/script.rpy:2470
translate chino menunulla_loop1_26cff17f:

    # nulla "Para ti y tu marioneta, ella cortará la conexión contigo impidiendo que puedas seguir aquí."
    nulla "对你和你的傀儡而言，她会切断与你的联系，让你无法再留在这里。"

# game/script.rpy:2471
translate chino menunulla_loop1_106efdb0:

    # nulla "En el caso de Septem... el cuerpo dejaría de funcionar y sus ojos dejarían de protegerlo."
    nulla "至于 Septem……他的身体会停止运转，他的双眼也不再保护他。"

# game/script.rpy:2473
translate chino menunulla_loop1_e21d202a:

    # nj "¿Ojos?"
    nj "双眼？"

# game/script.rpy:2475
translate chino menunulla_loop1_dbe79b1f:

    # nulla "Aquí los ojos son una barrera de protección, Septem tiene 7 de esos en forma de halo."
    nulla "这里的双眼是一种保护屏障，Septem 有七只，呈光环状。"

# game/script.rpy:2476
translate chino menunulla_loop1_f15c2e62:

    # nulla "Unum tiene 3, uno originalmente suyo y dos más que le ha robado a Quattor."
    nulla "Unum 有三只——一只原本属于他，另外两只则是从 Quattor 那里偷来的。"

# game/script.rpy:2478
translate chino menunulla_loop1_8d4e851a:

    # nulla "Aunque el suyo permanece permanentemente cerrado a modo de protección, que paranoico..."
    nulla "不过属于他自己的那一只为了保护而永远闭合，真是多疑……"

# game/script.rpy:2482
translate chino menunulla_loop1_6eb8e295:

    # nj "¿Septem?"
    nj "Septem？"

# game/script.rpy:2484
translate chino menunulla_loop1_ee16d455:

    # nulla "Así es, Septem tiene la misma condición que tú y tu marioneta..."
    nulla "没错，Septem 和你以及你的傀儡患有同样的病症……"

# game/script.rpy:2485
translate chino menunulla_loop1_26e368c0:

    # nulla "Por lo que la unica manera de someterlo es pronunciando su nombre."
    nulla "所以唯一能制服他的办法，就是念出他傀儡的名字。"

# game/script.rpy:2487
translate chino menunulla_loop1_b917ac69:

    # nulla "Yo no puedo pronunciarlo por las reglas fundamentales del jardín, pero si tú llegas a saberlo..."
    nulla "我因为花园的根本法则而无法念出它，但如果你设法知道了……"

# game/script.rpy:2488
translate chino menunulla_loop1_9d7ffc2f:

    # nulla "Tal vez..."
    nulla "也许……"

# game/script.rpy:2492
translate chino menunulla_loop1_6a0ac365:

    # nj "¿La marioneta tiene otro nombre?"
    nj "傀儡还有别的名字？"

# game/script.rpy:2494
translate chino menunulla_loop1_43468f8b:

    # nulla "Sí, despues de todo, tú solo eres alguien que toma prestado un cuerpo."
    nulla "是的，说到底，你不过是借住在一个身体里的人。"

# game/script.rpy:2496
translate chino menunulla_loop1_fb6894f5:

    # nulla "Y aquí todos los cuerpos tienen alma. La única diferencia es que ahora tu marioneta casi ya no tiene una identidad propia, pues se la he quitado."
    nulla "而在这里，所有身体都有灵魂。唯一的不同是，你的傀儡如今几乎已经没有属于自己的身份了，因为那已被我夺走。"

# game/script.rpy:2497
translate chino menunulla_loop1_48c2f8dd:

    # nulla "Para poder dirigirme directamente a ti y evitar problemas..."
    nulla "这样我才能直接与你对话，避免麻烦……"

# game/script.rpy:2501
translate chino menunulla_loop1_354c9725:

    # nulla "Si te lo digo dejarás de tener la conexión para poder interactuar con este mundo."
    nulla "如果我说出来，你就会失去与这个世界交互的连接。"

# game/script.rpy:2503
translate chino menunulla_loop1_2251fb48:

    # nulla "Por lo que no te lo diré ;)"
    nulla "所以我不会说的 ;)"

# game/script.rpy:2508
translate chino menunulla_loop1_9a5176c5:

    # nulla "¿Haberle quitado la identidad al trozo de carne que controlas?"
    nulla "把你控制的那坨肉的身份夺走吗？"

# game/script.rpy:2510
translate chino menunulla_loop1_32d5e53d:

    # nulla "Creéme que es para mejor."
    nulla "相信我，这是为了你好。"

# game/script.rpy:2511
translate chino menunulla_loop1_a3176a04:

    # nulla "Además, no me gustaría compartirte con nadie más."
    nulla "而且，我也不想把你再分给别人。"

# game/script.rpy:2516
translate chino menunulla_loop1_5148ee1c:

    # nulla "Hah!"
    nulla "哈！"

# game/script.rpy:2517
translate chino menunulla_loop1_cfb6a41f:

    # nulla "De todas las respuestas posibles, jamás me esperé esta."
    nulla "在所有可能的回答里，我唯独没料到会是这个。"

# game/script.rpy:2533
translate chino menupreguntas_839baac0:

    # "Septem te mira con una pequeña sonrisa."
    "Septem 带着淡淡的笑容看着你。"

# game/script.rpy:2536
translate chino menupreguntas_c9d26286:

    # septem "Él está bien. Nada que no pueda soportar."
    septem "他没事。没有什么是他承受不了的。"

# game/script.rpy:2539
translate chino menupreguntas_241731b0:

    # nj "Le has atravezado el pecho..."
    nj "你刺穿了他的胸膛……"

# game/script.rpy:2542
translate chino menupreguntas_7a5103dc:

    # septem "Ajá, no fue nada grave."
    septem "嗯，没什么大不了的。"

# game/script.rpy:2543
translate chino menupreguntas_44e3dda9:

    # septem "Solo una pequeña advertencia."
    septem "只是一个小小的警告。"

# game/script.rpy:2544
translate chino menupreguntas_7f1ee879:

    # septem "Para matarlo tomaría más que simplemente eso."
    septem "要杀了他，光凭这点可不够。"

# game/script.rpy:2547
translate chino menupreguntas_beeb4e0f:

    # septem "Una lástima..."
    septem "真遗憾……"

# game/script.rpy:2553
translate chino menupreguntas_9f1a89bc:

    # "Septem te mira con un semblante serio."
    "Septem 神情严肃地看着你。"

# game/script.rpy:2556
translate chino menupreguntas_f02f643a:

    # septem "No seas tan ansioso..."
    septem "别这么心急……"

# game/script.rpy:2557
translate chino menupreguntas_b4e052d3:

    # septem "Luego hablaremos de eso."
    septem "我们之后再说这个。"

# game/script.rpy:2563
translate chino menupreguntas_147bb2fb:

    # "Septem suspira."
    "Septem 叹了口气。"

# game/script.rpy:2566
translate chino menupreguntas_e7849523:

    # septem "Madre es el jardín."
    septem "“母亲”就是花园本身。"

# game/script.rpy:2567
translate chino menupreguntas_7fb42c08:

    # septem "Ella es la encargada de sostener todo."
    septem "她负责维系一切。"

# game/script.rpy:2568
translate chino menupreguntas_9903d361:

    # septem "Y nosotros somos su fuente de energía."
    septem "而我们则是她的能量来源。"

# game/script.rpy:2574
translate chino menupreguntas_eaeb2867:

    # "Septem frunce las cejas antes de responder."
    "Septem 在回答之前皱起了眉头。"

# game/script.rpy:2575
translate chino menupreguntas_d826f19b:

    # septem "¿Yo y [nombrejugador]?"
    septem "我和 [nombrejugador]？"

# game/script.rpy:2576
translate chino menupreguntas_6f3d23e9:

    # septem "¿Quién es {sc=2}yo{/sc}?"
    septem "谁是 {sc=2}我{/sc}？"

# game/script.rpy:2577
translate chino menupreguntas_86c39ea8:

    # "{sc=3}...{/sc}"
    "{sc=3}……{/sc}"

# game/script.rpy:2580
translate chino menupreguntas_e0b0f54f:

    # septem "[nombrejugador], seré claro, la próxima vez que vea a la marioneta desligándose de ti."
    septem "[nombrejugador]，我把话说清楚。下一回我再看到那傀儡从你身上剥离……"

# game/script.rpy:2581
translate chino menupreguntas_632aa42f:

    # septem "No dudaré en romperla."
    septem "我会毫不犹豫地斩断它。"

# game/script.rpy:2582
translate chino menupreguntas_befe5772:

    # septem "No necesito otro más con una conciencia propia, suficiente tengo con Raf--"
    septem "我不需要另一个有自主意识的，光是 Raf——就够我受的了——"

# game/script.rpy:2583
translate chino menupreguntas_8b175cea:

    # septem "... no importa."
    septem "……算了。"

# game/script.rpy:2584
translate chino menupreguntas_360aea03:

    # septem "Despues de todo Madre puede hacer otro recipiente"
    septem "说到底，母亲还能再做一个容器。"

# game/script.rpy:2696
translate chino badendseptem1_03fac258:

    # "Sientes como te rompen el pecho, una mano urga dentro tuya en busca de algo en específico."
    "你感到胸膛被撕裂，一只手在你体内翻搅，寻找着某个特定的东西。"

# game/script.rpy:2747
translate chino badendseptem2_03fac258:

    # "Sientes como te rompen el pecho, una mano urga dentro tuya en busca de algo en específico."
    "你感到胸膛被撕裂，一只手在你体内翻搅，寻找着某个特定的东西。"

# game/script.rpy:2757
translate chino badend_septem3_9f5ad1d0:

    # "Inspeccionas la habitación con el objetivo de encontrar una salida, hay una puerta y ventanales."
    "你打量着房间，想找到出口，这里有一扇门和几扇大窗。"

# game/script.rpy:2758
translate chino badend_septem3_16e3bfd6:

    # "Te acercas a la puerta con la esperanza de encontrarla abierta."
    "你靠近那扇门，希望它是开着的。"

# game/script.rpy:2759
translate chino badend_septem3_a12bbac4:

    # "Al tocar el pomo de la puerta y girarlo, te das cuenta de que no está bloqueada. Por lo que puedes salir."
    "当你碰到门把并转动时，你发现它并没有锁。于是你可以离开。"

# game/script.rpy:2761
translate chino badend_septem3_498b51db:

    # "Sales con cautela, intentando hacer el menos ruido posible."
    "你小心翼翼地走出去，尽量不发出任何声音。"

# game/script.rpy:2762
translate chino badend_septem3_a0aacf4e:

    # "Al salir, te encuentras en un pasillo que al final se puede apreciar una sala..."
    "走出去后，你来到一条走廊，尽头隐约可见一间大厅……"

# game/script.rpy:2763
translate chino badend_septem3_500a8559:

    # "Caminas en dirección a esa sala."
    "你朝那个大厅走去。"

# game/script.rpy:2765
translate chino badend_septem3_0ca2eee9:

    # septem "¿Dónde vas?"
    septem "你要去哪儿？"

# game/script.rpy:2767
translate chino badend_septem3_cc9a5909:

    # "!!!"
    "！！！"

# game/script.rpy:2768
translate chino badend_septem3_3f125901:

    # septem "No puedo dejar que te vayas..."
    septem "我不能让你走……"

# game/script.rpy:2769
translate chino badend_septem3_1f01fe88:

    # septem "Si tanto quieres escapar de aquí, pues adelante. No tengo ganas de lidear con alguien que no tiene interés en mí."
    septem "你要是真想离开这里，那就去吧。我没兴致应付一个对我毫无兴趣的人。"

# game/script.rpy:2770
translate chino badend_septem3_ee38263d:

    # septem "Despues de todo, madre puede hacer otra marioneta."
    septem "说到底，母亲还能再做一具傀儡。"

# game/script.rpy:2771
translate chino badend_septem3_0c28488e:

    # septem "Te haré el favor de acabar rápido contigo."
    septem "我就大发慈悲，让你死个痛快。"

# game/script.rpy:2773
translate chino badend_septem3_e762b2f9:

    # "Septem te atraviesa el pecho sin titubear y rápidamente saca algo de ahí"
    "Septem 毫不犹豫地刺穿了你的胸膛，又迅速从里面掏出了什么。"

# game/script.rpy:2774
translate chino badend_septem3_ace9066a:

    # "Intentas identificar que es lo que ha sacado, pero tu visión se torna borrosa."
    "你试图辨认他掏出的是什么，但你的视线开始模糊。"

# game/script.rpy:2775
translate chino badend_septem3_70ff978d:

    # "BAD END: Sin interés las cosas no funcionan."
    "BAD END: 没有兴趣，一切就不会发生。"

# game/script.rpy:2782
translate chino badend_septem4_31924e0f:

    # septem "..."
    septem "……"

# game/script.rpy:2786
translate chino badend_septem4_662a12b4:

    # septem "Ah hahaha."
    septem "啊哈哈。"

# game/script.rpy:2787
translate chino badend_septem4_2c08f216:

    # septem "Estoy conciente de que eres un ser superior..."
    septem "我清楚你是一个更高的存在……"

# game/script.rpy:2790
translate chino badend_septem4_0231f013:

    # septem "Pero no estoy dispuesto a este tipo de tratos."
    septem "但我不想接受这种待遇。"

# game/script.rpy:2791
translate chino badend_septem4_8d8400b5:

    # septem "Menos de alguien que no tiene un control real sobre mi o mis acciones."
    septem "更不想接受一个无法真正控制我和我行动的人。"

# game/script.rpy:2794
translate chino badend_septem4_53db9bf9:

    # septem "Facilmente puedo quitarle la cabeza a tu marioneta y tú no podrás hacer nada."
    septem "我轻而易举就能砍下你傀儡的头，而你什么都做不了。"

# game/script.rpy:2795
translate chino badend_septem4_40fddbf4:

    # septem "Por culpa de tus opciones limitadas bajo acciones predeterminadas."
    septem "因为你在既定行动下的选择实在太有限了。"

# game/script.rpy:2798
translate chino badend_septem4_4ad4a338:

    # septem "Nos vemos luego..."
    septem "回头见……"

# game/script.rpy:2800
translate chino badend_septem4_760d2cba:

    # "Septem te corta la cabeza."
    "Septem 斩下了你的头颅。"

# game/script.rpy:2801
translate chino badend_septem4_c1deba85:

    # "BAD END: Midiendo tu rango."
    "BAD END: 掂量掂量你的位置。"

# game/script.rpy:2807
translate chino badend_septem5_7f6a9a3a:

    # "Mientras más le explicas la situación, la cual extrañamente el no parece recordar, la cara de Septem se torna roja y con un semblante serio."
    "你越是向他解释情况（奇怪的是他似乎完全不记得），Septem 的脸就涨得越红，神情也越来越严肃。"

# game/script.rpy:2809
translate chino badend_septem5_a149cae2:

    # "Parece estar aguantando la furia."
    "他像是在强忍着怒火。"

# game/script.rpy:2813
translate chino badend_septem5_a276217e:

    # septem "¿Cómo es que la has encontrado?"
    septem "你怎么找到它的？"

# game/script.rpy:2815
translate chino badend_septem5_055d96bf:

    # septem "¡Esa llave siempre permanece conmigo!"
    septem "那把钥匙一直都在我身上！"

# game/script.rpy:2818
translate chino badend_septem5_9913b937:

    # "De la nada, septem toma tu muñeca y la gira con tanta fuerza que rompe tus huesos."
    "猝不及防之间，Septem 抓住你的手腕猛地扭转，生生折断了你的骨头。"

# game/script.rpy:2819
translate chino badend_septem5_1c7e962f:

    # "El crujido de cada hueso, es horrible y el dolor es inaguantable. Pero tú no puedes hacer nada más que llorar."
    "每一块骨头碎裂的声音都令人毛骨悚然，疼痛无法忍受。可你除了哭泣，什么也做不了。"

# game/script.rpy:2820
translate chino badend_septem5_78799bb7:

    # "Pues el agarre de Septem no se afloja ante nada, ni los golpes o rasguños que le haces con tu otra mano."
    "因为无论怎样，Septem 的力道都不会松懈——哪怕你用另一只手捶打、抓挠他。"

# game/script.rpy:2821
translate chino badend_septem5_a16f49bd:

    # "Eres como un animal atrapado en una trampa para osos."
    "你就像一只落入捕熊夹的动物。"

# game/script.rpy:2822
translate chino badend_septem5_c11a6e01:

    # septem "Eres muy ruidoso..."
    septem "你太吵了……"

# game/script.rpy:2824
translate chino badend_septem5_dc0cdb81:

    # "Septem sonrie y te corta la cabeza."
    "Septem 微笑着，斩下了你的头颅。"

# game/script.rpy:2825
translate chino badend_septem5_a07939b0:

    # "BAD END: Mejor guarda silencio."
    "BAD END: 最好还是保持沉默。"

# game/script.rpy:2831
translate chino badend_septem6_d8df63b8:

    # "Te paseas por toda la extención del templo, mirando cada una de las puertas que son accesibles y cada uno de los ventanales..."
    "你走遍了整座神殿，查看每一扇可以通行的门和每一扇大窗……"

# game/script.rpy:2832
translate chino badend_septem6_cf7bf452:

    # "Varias puertas llevan al mismo jardín, pero aún no sientes tanta confianza como para salir."
    "有几扇门通向同一片花园，但你仍没有足够的把握走出去。"

# game/script.rpy:2834
translate chino badend_septem6_593662c0:

    # "Intentas probar de a poco... Caminas unos pasos luego de salir por la puerta, no pasa nada."
    "你打算一点点试探……迈出门走了几步，什么也没发生。"

# game/script.rpy:2835
translate chino badend_septem6_3c37d2e6:

    # "Luego, caminas hasta tocar el pasto con tus pies... Tampoco pasa nada."
    "然后你走到脚踩上草地……依然什么都没发生。"

# game/script.rpy:2837
translate chino badend_septem6_d955e871:

    # "Te devuelvres para no levantar sospechas."
    "你折返回去，以免引起怀疑。"

# game/script.rpy:2838
translate chino badend_septem6_a20cefa7:

    # "..."
    "……"

# game/script.rpy:2840
translate chino badend_septem6_192025a0:

    # "Te das otra vuelta por el templo, mirando por los ventanales."
    "你又绕着神殿走了一圈，透过大窗向外张望。"

# game/script.rpy:2841
translate chino badend_septem6_39c1657e:

    # "Despues de un tiempo prudente, vuelves a tu objetivo: Escapar."
    "待了一段合适的时间后，你重新回到目标上：逃走。"

# game/script.rpy:2843
translate chino badend_septem6_94b83f06:

    # "Sales por otra puerta que lleva al jardín, y esta vez corres en dirección hacia lo que parece ser un bosque."
    "你从另一扇通向花园的门走出去，这一次朝着那片像是森林的地方跑去。"

# game/script.rpy:2844
translate chino badend_septem6_0d03a698:

    # "Corres y corres."
    "你跑啊跑。"

# game/script.rpy:2845
translate chino badend_septem6_a799dbd8:

    # "Corres tanto que te está comenzando a faltar el aliento. Por lo que decides descansar en unos matorrales."
    "你跑得气喘吁吁，于是决定在一丛灌木里歇一歇。"

# game/script.rpy:2846
translate chino badend_septem6_7c620338:

    # "A lo lejos, vez como una sombra serpentea por el suelo."
    "远处，你看到一个影子在地上蜿蜒游动。"

# game/script.rpy:2847
translate chino badend_septem6_b1f48474:

    # "Parece ser una serpiente que se dirige a tu dirección."
    "那似乎是一条朝你这边爬来的蛇。"

# game/script.rpy:2848
translate chino badend_septem6_2d040ae3:

    # "Aguantando el grito, te quedas completamente inmóvil."
    "强忍着尖叫，你一动不动。"

# game/script.rpy:2851
translate chino badend_septem6_7c57a5dd:

    # "Y cierras los ojos."
    "然后，你闭上了双眼。"

# game/script.rpy:2853
translate chino badend_septem6_c74e95f5:

    # el "No deberías haber hecho eso."
    el "你不该那么做。"

# game/script.rpy:2854
translate chino badend_septem6_b6e15fb2:

    # "No reconoces esa voz... es una voz femenina y ronca."
    "你不认识那个声音……是个沙哑的女声。"

# game/script.rpy:2855
translate chino badend_septem6_24ec64e8:

    # "Al instante abres los ojos para poder ver de quien se trata."
    "你立刻睁开双眼，想看看是谁。"

# game/script.rpy:2857
translate chino badend_septem6_5277ec63:

    # "Y lo que te recibe es la figura de una entidad cubierta con un velo y ropas que se asemejan a una bata."
    "映入眼帘的是一个身披面纱、穿着长袍般衣物的存在。"

# game/script.rpy:2858
translate chino badend_septem6_a3b7c1dc:

    # "Lleva una guadaña que eleva en lo alto del cielo."
    "她高举着一把镰刀，直指天空。"

# game/script.rpy:2859
translate chino badend_septem6_7db58f58:

    # "Y es lo último que vez."
    "而这就是你看到的最后一样东西。"

# game/script.rpy:2860
translate chino badend_septem6_22c6f38a:

    # "BAD END: Conociendo a la segunda."
    "BAD END：结识了第二位。"

# game/script.rpy:2865
translate chino badend_septem7_88e69d3e:

    # "Buscas entre tus ropas el cuchillo que has encontrado y antes de siquera poder sacar el cuchillo, Septem te detiene con su mano mientras chasquea su lengua."
    "你在衣服里翻找刚才找到的那把刀，可还没等你把它抽出来，Septem 就伸手拦住了你，同时不满地咂了咂舌。"

# game/script.rpy:2868
translate chino badend_septem7_86ca3c38:

    # septem "tsk."
    septem "啧。"

# game/script.rpy:2869
translate chino badend_septem7_c4db07d4:

    # "Se le ve decepcionado."
    "他看起来有些失望。"

# game/script.rpy:2870
translate chino badend_septem7_cc22e356:

    # septem "No creí que fueras tan..."
    septem "没想到你竟然这么……"

# game/script.rpy:2872
translate chino badend_septem7_87081875:

    # septem "Ingenuo."
    septem "天真。"

# game/script.rpy:2875
translate chino badend_septem7_fc2af527:

    # "Lo último que sientes es como Septem te quita el cuchillo y te arrebata la vida con este."
    "你最后的感觉，是 Septem 从你手中夺过刀，用它夺走了你的生命。"

# game/script.rpy:2877
translate chino badend_septem7_2c950ba3:

    # "BAD END: No puedes matar a un dios con un cuchillo."
    "BAD END：你无法用一把刀杀死一位神明。"

# game/script.rpy:2882
translate chino badend_septem8_5c3cac98:

    # septem "Ja."
    septem "呵。"

# game/script.rpy:2884
translate chino badend_septem8_afd22679:

    # "Septem no duda ni un solo segundo de hacer explotar tu cabeza."
    "Septem 没有犹豫哪怕一秒，直接让你的脑袋炸开了花。"

# game/script.rpy:2886
translate chino badend_septem8_b8a3ffca:

    # "BAD END: ..."
    "BAD END：……"

# game/script.rpy:2932
translate chino badend_unum1_3f69b341:

    # unum "Supongo que no te explico nada de nadaaa"
    unum "我猜她什么也没跟你解释吧，一丁点都没有。"

# game/script.rpy:2966
translate chino badend_unum1_03fac258:

    # "Sientes como te rompen el pecho, una mano urga dentro tuya en busca de algo en específico."
    "你感到胸口被撕裂，一只手在你体内翻找着什么特定的东西。"

# game/script.rpy:3039
translate chino badendunum4_26af1524:

    # "Cuando lo sientes, dejas de respirar y agarras el mango del cuchillo y apuñalas a Unum en la cabeza con todas tus fuerzas."
    "感觉到的那一刻，你屏住呼吸，抓住刀柄，用尽全力朝 Unum 的脑袋刺了下去。"

# game/script.rpy:3119
translate chino goodend1_b6516c2b:

    # "Atacas a la esfera que sostiene Unum en su mano."
    "你朝 Unum 手中握着的那颗球体攻去。"

# game/script.rpy:3122
translate chino goodend1_b9fafe19:

    # "El cae al suelo y tú solo observas, no pudiendo creer que aquello haya funcionado."
    "他倒在地上，你只是呆呆地看着，不敢相信这竟然真的奏效了。"

# game/script.rpy:3123
translate chino goodend1_0c0599d8:

    # "Pasan unos segundos y Unum sigue sin moverse."
    "几秒过去，Unum 依旧一动不动。"

# game/script.rpy:3125
translate chino goodend1_d25ee7d4:

    # "{glitch=20.0}{color=ffffff}{b}JA eres el primero en rechazarlo, ni él se esperaba eso. {/glitch}"
