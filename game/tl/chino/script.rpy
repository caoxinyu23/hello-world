translate chino badend_rutanulla_8055460e:

    # "Y esperas."
    "然后，你等着。"

# game/script.rpy:3149
translate chino badend_rutanulla_6954799b:

    # "Y sigues esperando."
    "你继续等着。"

# game/script.rpy:3150
translate chino badend_rutanulla_b4703fb3:

    # "Pero no se escucha nada ni sientes que nada sucede allá."
    "可那边一点声音也没有，你也感觉不到任何动静。"

# game/script.rpy:3151
translate chino badend_rutanulla_28393663:

    # "Pero tú no mirarás."
    "但你不会去看。"

# game/script.rpy:3153
translate chino badend_rutanulla_a20cefa7:

    # "..."
    "……"

# game/script.rpy:3155
translate chino badend_rutanulla_0734769d:

    # el "¿Pero qué tenemos aquí?"
    el "瞧瞧，我们这儿有什么？"

