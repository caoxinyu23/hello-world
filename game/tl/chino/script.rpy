    # unum "JAJAJAJAJAJAJA-"
    unum "哈哈哈哈哈哈——"

# game/script.rpy:1004
translate chino rutaunum_f07b62f6:

    # unum "Prometo no romperte tan rápidooo."
    unum "我保证不会太快把你弄坏。"

# game/script.rpy:1005
translate chino rutaunum_1e678f60:

    # "De verdad no sabes donde mierda te has metido... tal vez Septem hubiera sido mejor opción."
    "你真的不知道自己到底惹上了什么……也许Septem本该是更好的选择。"

# game/script.rpy:1009
translate chino rutaunum_a1a12809:

    # nj "No quiero ir contigo."
    nj "我不想跟你走。"

# game/script.rpy:1010
translate chino rutaunum_3d21cae8:

    # unum "JAJAJAJA-"
    unum "哈哈——"

# game/script.rpy:1011
translate chino rutaunum_a3d1230c:

    # unum "Como quieras."
    unum "随你便。"

# game/script.rpy:1016
translate chino rutaunum_e141f9b0:

    # unum "Bien. Cuando Nulla saque el sello, debes quedarte inmóvil."
    unum "好。等Null解除封印时，你必须一动不动。"

# game/script.rpy:1017
translate chino rutaunum_9ab32b57:

    # "Asientes con la cabeza... No alcanzan a pasar ni 3 segundos cuando sientes una presión extraña en tu cuerpo... supones que debe ser Nulla."
    "你点了点头……还没过三秒，你就感到体内传来一股异样的压力……你猜想那一定是Nulla。"

# game/script.rpy:1021
translate chino rutaunum_4e193661:

    # "Nulla y Septem se materializan justo donde los viste la última vez, Nulla parado a un lado de la mesa y Septem sentado al lado de Unum."
    "Nulla和Septem就出现在你上次见到他们的地方，Nulla站在桌子一侧，Septem坐在Unum身旁。"

# game/script.rpy:1022
translate chino rutaunum_7509a23e:

    # "Como si hubieran estado siempre allí."
    "就像他们一直都在那里一样。"

# game/script.rpy:1025
translate chino rutaunum_50cc6b6f:

    # septem "{sc=2}Wow, no creí que el regalo saldría en una sola pieza. Te felici---{/sc}"
    septem "{sc=2}哇，我还以为这个礼物出来时不会是完整的。我要祝贺——{/sc}"

# game/script.rpy:1026
translate chino rutaunum_56c75a7b:

    # "Septem es interrumpido por Unum, quien se abalanza contra ti."
    "Septem的话被Unum打断了，后者向你扑了过来。"

# game/script.rpy:1028
translate chino rutaunum_e8a89d1a:

    # "Si no fuera por la rapidez con que Unum te ha alcanzado, de seguro te habrías movido para evitarlo. Pero como tus reflejos son lentos comparado con Unum, te quedas como una piedra."
    "若不是Unum动作够快，你肯定已经闪开了。但你的反射神经比Unum慢得多，于是你像块石头一样僵在原地。"

# game/script.rpy:1029
translate chino rutaunum_8f01e4a6:

    # "Los brazos de Unum te envuelven y te quitan el aire de lo fuerte que te está apretando."
    "Unum的双臂缠住你，勒得你喘不过气来。"

# game/script.rpy:1030
translate chino rutaunum_d3ccb2cd:

    # septem "{sc=4}Qué mier-{/sc}"
    septem "{sc=4}见鬼——{/sc}"

# game/script.rpy:1031
translate chino rutaunum_e907cff5:

    # "Repentinamente dejas de escuchar la voz de Septem y el sonido ambiental del comedor."
    "突然间，你再也听不见Septem的声音和餐厅里的环境音了。"

# game/script.rpy:1033
translate chino rutaunum_a20cefa7_5:

    # "..."
    "..."

# game/script.rpy:1035
translate chino rutaunum_ddfcac48:

    # "La sensación de unas manos acariciándote la cara, te invitan a dejar tu subconciente."
    "双手抚摸你脸庞的感觉，让你不由自主地卸下了潜意识的防备。"

# game/script.rpy:1037
translate chino rutaunum_c18fa391:

    # "Abres los ojos, pero la luz del lugar te lo impiden. Son molestas."
    "你睁开眼，但这里的光线让你睁不开。真碍事。"

# game/script.rpy:1039
translate chino rutaunum_47806f74:

    # "... No sabes cuanto tiempo has estado inconciente."
    "……你不知道自己昏迷了多久。"

# game/script.rpy:1040
translate chino rutaunum_8eb8ef34:

    # "Sientes como las mismas manos te dan palmaditas en las mejillas, cada vez más fuertes con el pasar de los segundos."
    "你感到同样那双手在轻拍你的脸颊，随着时间流逝，力道一次比一次重。"

# game/script.rpy:1042
translate chino rutaunum_b3e6701c:

    # "Una lo suficientemente fuerte como para doler te hace gritar."
    "一记重得发疼的拍打让你叫出了声。"

# game/script.rpy:1044
translate chino rutaunum_09479f2c:

    # "Abres los ojos de golpe y lo primero que vez es a Unum con su risa estúpida."
    "你猛地睁开眼，第一眼看到的就是Unum那愚蠢的笑容。"

# game/script.rpy:1045
translate chino rutaunum_ae03aafb:

    # nj "¡QUE PARES YA!"
    nj "快住手！"

# game/script.rpy:1047
translate chino rutaunum_6d2b2ea9:

    # "Gritas con tanto enojo que Unum para en seco y te mira con los ojos bien abiertos."
    "你怒不可遏地大喊，Unum一下子僵住，睁大眼睛看着你。"

# game/script.rpy:1049
translate chino rutaunum_fa787e95:

    # unum "JAJAJAAJAJAJAJAJAJA- Tienes receptores de dolor"
    unum "哈哈哈哈哈哈哈哈哈——你有痛觉感受器啊。"

# game/script.rpy:1050
translate chino rutaunum_b28ffe45:

    # unum "Excelente, parece ser que el olor que emanas está en lo correcto."
    unum "太好了，看来你散发的气味是对的。"

# game/script.rpy:1051
translate chino rutaunum_fa18006c:

    # unum "Perteneces a la raza humana."
    unum "你属于人类。"

# game/script.rpy:1053
translate chino rutaunum_2336ede8:

    # "La expresión de Umun demuestra lo exaltado que está, cosa que no te agrada mucho pues sabes por experiencia propia que eso no lleva a nada bueno."
    "Unum的神情显示出他有多亢奋，这让你很不舒服，因为你从亲身经验知道，那不会带来什么好结果。"

# game/script.rpy:1054
translate chino rutaunum_c19d12ec:

    # "Decides que es mejor no hacer que se exalte más de lo necesario, por lo que le ignoras para poder observar tu alrededor."
    "你决定不让他再过度兴奋，于是无视他，转而观察四周。"

# game/script.rpy:1055
translate chino rutaunum_c7c0ea00:

    # "Te encuentras en una cama lo suficientemente amplia como para dos personas, en una habitación, que siendo sinceros, podría ser la de un rey."
    "你躺在一张足够两人睡的床上，所在的房间说实话堪比国王的寝宫。"

# game/script.rpy:1056
translate chino rutaunum_c1161107:

    # "Está tan imnaculado el lugar que no se ve real."
    "这里整洁得一尘不染，简直不真实。"

# game/script.rpy:1058
translate chino rutaunum_5c4387ae:

    # unum "¿Te gusta?"
    unum "你喜欢吗？"

# game/script.rpy:1059
translate chino rutaunum_593611fd:

    # unum "Esta será tu propia habitación."
    unum "这将是你的房间。"

# game/script.rpy:1061
translate chino rutaunum_bdfd29e4:

    # unum "Lo estuve pensando, y supongo que sería imposible dejarte en la residencia de mis esposas."
    unum "我考虑了一下，想把你留在我妻子们的住所恐怕是不可能的。"

# game/script.rpy:1062
translate chino rutaunum_350a4c93:

    # unum "Te devorarían nada más pisar el lugar."
    unum "你一踏进那里，她们就会把你吞掉。"

# game/script.rpy:1063
translate chino rutaunum_a94cace7:

    # "¿Esposas? No solo una ¿¿¿¿¿sino que más????"
    "妻子？不只一个，而是更多？？？？"

# game/script.rpy:1064
translate chino rutaunum_3e6096f2:

    # "No puedes evitar sentir pena por las pobres mujeres que tienen de pareja a este niñato."
    "你不禁替那些可怜的女人感到惋惜，她们的伴侣竟是这个小屁孩。"

# game/script.rpy:1065
translate chino rutaunum_6efebb5b:

    # "Sientes que seguramente no les dedica el tiempo necesario a cada una de ellas."
    "你觉得他肯定没有在每个妻子身上花足够的时间。"

# game/script.rpy:1066
translate chino rutaunum_4094f22a:

    # unum "...Hablé con Septem, y Nulla le ha dicho que Madre hará otro regalo para que los demás puedan tener su parte."
    unum "……我跟Septem聊过，Nulla告诉他，母亲会再造一个礼物，好让其他人也能分到自己的那份。"

# game/script.rpy:1067
translate chino rutaunum_cab5ce80:

    # unum "Eso significa que eres de mi propiedad ahora..."
    unum "也就是说，你现在是我的所有物了……"

# game/script.rpy:1069
translate chino rutaunum_2645fcde:

    # unum "¡Primera vez que tengo a un humano vivo en mi dominio!"
    unum "这是我第一次有活着的人类在我的领地里！"

# game/script.rpy:1072
translate chino rutaunum_c0a3e0b2:

    # nj "¿Por qué no pueden haber humanos vivos en tu dominio?"
    nj "为什么你的领地里不能有活着的人类？"

# game/script.rpy:1074
translate chino rutaunum_4444fef7:

    # "Unum analiza tu cara por un momento antes de contestar, como si meditara el tipo de información que te revelará."
    "Unum在回答前端详了你的脸一会儿，仿佛在斟酌该向你透露哪种信息。"

# game/script.rpy:1076
translate chino rutaunum_395874eb:

    # unum "Nulla y Madre dicen que solamente pueden haber humanos para nuestro consumo."
    unum "Nulla和母亲说，领地里只能有供我们食用的人类。"

# game/script.rpy:1077
translate chino rutaunum_f4ad71cd:

    # unum "Nulla se excusa con que no nos puede facilitar ninguno pues solamente podemos tener 6 humanos cada mes..."
    unum "Nulla推说一个也提供不了，因为我们每个月只能有六个人类……"

# game/script.rpy:1078
translate chino rutaunum_769e15f0:

    # unum "No más que eso."
    unum "就这么多。"

# game/script.rpy:1079
translate chino rutaunum_c082b2b6:

    # unum "Por eso Madre hace un regalo cada domingo... como placebo, ya que la carne humana es vital para nuestra forma física pero muy adictiva."
    unum "所以母亲每个星期天都会造一个礼物……当作安慰剂，因为人肉对我们的形体至关重要，却又极易上瘾。"

# game/script.rpy:1080
translate chino rutaunum_af08df17:

    # "Tú eres el placebo."
    "你就是这个安慰剂。"

# game/script.rpy:1082
translate chino rutaunum_1002a256:

    # unum "Aunque es la primera vez que un regalo huele como un humano real."
    unum "不过，这是第一次有礼物闻起来像真正的人类。"

# game/script.rpy:1086
translate chino rutaunum_7d4dc94c:

    # nj "¿Quién es Madre?"
    nj "母亲是谁？"

# game/script.rpy:1088
translate chino rutaunum_8ada403b:

    # unum "Ja... realmente madre no te ha hecho como a los demás."
    unum "哈……母亲确实没有把你造成和其他人一样的。"

# game/script.rpy:1090
translate chino rutaunum_315ba4ac:

    # unum "Hmmmmmm"
    unum "嗯……"

# game/script.rpy:1091
translate chino rutaunum_a8dd5307:

    # "Unum medita antes de contestar"
    "Unum在回答前沉思了一会儿"

# game/script.rpy:1093
translate chino rutaunum_7dcec3fb:

    # unum "Madre es la representación del jardín mismo, todo esto es Madre."
    unum "母亲就是花园本身的化身，这一切都是母亲。"

# game/script.rpy:1094
translate chino rutaunum_cb6a9675:

    # unum "Madre cuida de nosotros y nosotros la mantenemos a con vida."
    unum "母亲照料我们，我们也让她一直活着。"

# game/script.rpy:1095
translate chino rutaunum_0dc0ab0e:

    # "Supones que ahora entiendes algo más... es como una relación de mutualismo, ambas partes se benefician."
    "你猜想自己现在多少明白了一些……这是一种共生关系，双方都从中获益。"

# game/script.rpy:1100
translate chino rutaunum_71ae9ec0:

    # "Decides no preguntar nada más."
    "你决定不再多问。"
# game/script.rpy:1103
translate chino rutaunum_7d4dc94c_1:

    # nj "¿Quién es Madre?"
    nj "母亲是谁？"

# game/script.rpy:1105
translate chino rutaunum_4aec5633:

    # unum "Realmente Madre no te ha hecho como a los demás."
    unum "哈……母亲确实没有把你造成和其他人一样的。"

# game/script.rpy:1107
translate chino rutaunum_360934ba:

    # unum "Hmmmm"
    unum "嗯……"

# game/script.rpy:1108
translate chino rutaunum_a8dd5307_1:

    # "Unum medita antes de contestar"
    "Unum在回答前沉思了一会儿"

# game/script.rpy:1110
translate chino rutaunum_7dcec3fb_1:

    # unum "Madre es la representación del jardín mismo, todo esto es Madre."
    unum "母亲就是花园本身的化身，这一切都是母亲。"

