translate chino badend_unum1_69c6e6d6:

    # "Así que ese tal Unum puede meterse su fantasia extraña por donde le quepa."
    "让那个叫Unum的家伙把自己的奇怪幻想塞进屁股里去吧。"

# game/script.rpy:1337
translate chino badend_unum1_388fb7f2:

    # "Tú no estás para hacer de mono de circo."
    "你可不是来给他当马戏团里的猴子的。"

# game/script.rpy:1338
translate chino badend_unum1_123071d3:

    # "Punto final."
    "就这样。"

# game/script.rpy:1342
translate chino badend_unum1_d2a1ed40:

    # nj "Lo siento, pero yo no estoy para juegos de nadie."
    nj "抱歉，我没空玩任何人的游戏。"

# game/script.rpy:1345
translate chino badend_unum1_fe570012:

