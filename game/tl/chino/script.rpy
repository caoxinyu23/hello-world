    # unum "¿Te duele?"
    unum "疼吗？"

# game/script.rpy:3198
translate chino nogogogo_5537d5df:

    # "Pregunta asustado e intenta quitar su mano pero tu lo detienes."
    "他有些害怕地问道，想把手抽回去，但你拦住了他。"

# game/script.rpy:3199
translate chino nogogogo_7a1f4146:

    # nj "No, pero se siente extraño."
    nj "不疼，但感觉很奇怪。"

# game/script.rpy:3200
translate chino nogogogo_b04f89f9:

    # unum "Falta un poco, aguanta."
    unum "还有一点，坚持住。"

# game/script.rpy:3201
translate chino nogogogo_a52e9fa9:

    # "Ambos se quedan quietos por un largo tiempo, y te preguntas cuanto tiempo más tiene que pasar para que el intercambio de esencias termine. Mientras, Unum se dedica a observar tus facciones con fascinación."
    "你们俩长时间一动不动，你不禁想，本质的交换究竟还要多久才会结束。其间，Unum 只是着迷地注视着你的面容。"

# game/script.rpy:3202
translate chino nogogogo_a20cefa7:

    # "..."
    "……"

# game/script.rpy:3203
translate chino nogogogo_45a7c779:

    # "Hay un momento en que siente que tu pecho comienza a quemar, duele un poco pero te lo aguantas."
    "有那么一刻，你感觉胸口开始烧灼，隐隐作痛，但你咬牙忍了下来。"

# game/script.rpy:3204
translate chino nogogogo_56a542b5:

    # unum "¡Listo!"
    unum "好了！"

# game/script.rpy:3205
translate chino nogogogo_2b4bd6bd:

    # "Unum retira su mano de tu cuerpo con la esencia que previamente era de un color parecido al oro, ahora ha tomado otro color. Unum la examina antes de dedicarte una sonrisa que muestra todos sus dientes."
    "Unum 把手从你体内收回，那颗原本近似金色的本质，如今已变成另一种颜色。Unum 端详了它一番，然后冲你露出一个咧到耳根的笑容。"

# game/script.rpy:3206
translate chino nogogogo_3cb71e32:

    # "Con sumo cuidado él coloca la esencia en tus manos. En ese proceso extrae una gran parte de la esencia, formando dos. Una de color oro."
    "他万分小心地将本质放进你手中。过程中，他从本质里分出很大一部分，分成两份。一份是金色的。"

# game/script.rpy:3207
translate chino nogogogo_ebe12128:

    # "Y la que tienes en tus manos, de un bello color rojo."
    "而你手中那份，则是美丽的红色。"

# game/script.rpy:3208
translate chino nogogogo_74dcecde:

    # "La observas por un buen rato, y puedes notar como hay movimentos dentro de la esencia. Algo se está formando..."
    "你久久地注视着它，注意到本质之中有东西在涌动。某种事物正在成形……"

# game/script.rpy:3209
translate chino nogogogo_4d125d64:

    # "Unum por su parte, coloca su esencia en su pecho, guardándola."
    "Unum 则把自己的本质收回胸口，妥善保管。"

# game/script.rpy:3210
translate chino nogogogo_45d96069:

    # unum "Colocaré a la cría en un cuarto seguro."
    unum "我会把幼体安置在一个安全的房间。"

# game/script.rpy:3211
translate chino nogogogo_3b40215e:

    # "Te avisa antes de tomarla de tus manos y llevarla fuera de la habitación."
    "他从你手中接过它、将它带出房间之前，先这样告知了你。"

# game/script.rpy:3212
translate chino nogogogo_feda1863:

    # "... De cierta manera, sientes toda esta situación bizarra."
    "……某种意义上，你觉得这整件事都荒诞得离奇。"

translate chino strings:

    # game/script.rpy:3157
    old "Pero yo no puedo embarazarme"
    new "可我不能怀孕啊。"

    # game/script.rpy:3157
    old "Yo no... quiero embarazarme"
    new "我……不想怀孕。"

# TODO: Translation updated at 2024-09-22 00:30

# game/script.rpy:924
translate chino rutaunum_989646bc:

    # "Unum espera un buen rato antes de hablar, decide comenzar a cortar el pedazo de carne que haz traido anteriormente."
    "Unum 沉默了好一会儿才开口，决定开始切割你之前带来的那块肉。"

# game/script.rpy:987
translate chino rutaunum_3c476486:

    # "Unum espera un buen rato antes de comenzar a cortar el pedazo de carne que haz traido anteriormente, el cual seguramente ya ha de estar frío."
    "Unum 沉默了好一会儿，才开始切割你之前带来的那块肉——它想必已经凉透了。"

# game/script.rpy:1158
translate chino rutaunum_c498cdb0:

    # unum "Camina detrás de mí y no te separes, mis esposas les gusta venir a mi residencia para relajarse."
    unum "跟在我身后，别走散了。我的妻妾们喜欢来我的住处放松。"

# game/script.rpy:1577
translate chino rutaunum_4791df49:

    # "Algo te raspa la garganta."
    "有什么在刮擦着你的喉咙。"

# game/script.rpy:1688
translate chino menuexplorar1_nulla_6131593b:

    # "Recorres el lugar pero no hay nada."
    "你四处走动，却什么也没发现。"

# game/script.rpy:1895
translate chino menuexplorar1_nulla_b62fd4bb:

    # "Y hoy no tienes ganas de morir..."
    "而今天，你并不想死……"

# game/script.rpy:1905
translate chino menuexplorar1_nulla_7116b3a0:

    # "{glitch=30.0}{color=ffffff}{b}Haré como que ha sido un desliz del mouse{b}{/color}"
    "{glitch=30.0}{color=ffffff}{b}我就当这是鼠标手滑了吧{b}{/color}"

# game/script.rpy:2050
translate chino menuexplorar2_nulla_02e37a14:

    # "Nulla se escapa como el maldito cobarde que es."
    "Nulla 像他那个该死的懦夫一样逃之夭夭。"

# game/script.rpy:2203
translate chino menupuertas2_acdb7f6e:

    # "Supones que la sala del vacío es esa habitación completamente negra."
    "你猜想，虚空之室就是那间漆黑一片的房间。"

# game/script.rpy:3241
translate chino badend_rutanulla_7e04cb06:

    # "Hay una mujer que está parada detrás tuyo, mirando con disgusto tu figura."
    "一个女人站在你身后，用厌恶的目光打量着你的身影。"

# TODO: Translation updated at 2024-09-22 17:16

# game/script.rpy:1047
translate chino rutaunum_55f4557c:

    # "La sensación de unas manos acariciándote la cara, te invitan a dejar tu subconsciente."
    "有双手抚摸你脸颊的触感，引着你离开潜意识。"

# game/script.rpy:1051
translate chino rutaunum_d8bbff36:

    # "... No sabes cuanto tiempo has estado inconsciente."
    "……你不知道昏迷了多久。"

# game/script.rpy:1621
translate chino rutaunum_59b17607:

    # "El aire que entra a tus pulmones no es suficiente como para mantenerte consciente."
    "涌入肺里的空气不足以让你保持清醒。"

# game/script.rpy:1623
translate chino rutaunum_1c3bd392:

    # "... Caes inconsciente."
    "……你陷入了昏迷。"

# game/script.rpy:2799
translate chino badend_septem4_1350a197:

    # septem "Estoy consciente de que eres un ser superior..."
    septem "我知道，你是一种更高级的存在……"

# TODO: Translation updated at 2024-09-24 23:31

# game/script.rpy:188
translate chino start_dcef8919:

    # el "Después de lo que pasó con el último, realmente espero que tú dures más tiempo."
    el "上一个出了那种事之后，我真希望你能撑得久一点。"

# game/script.rpy:306
translate chino start_9ac8c5b2:

    # fames "La única diferencia es que apesta a humano. Tal vez eso les guste a los 7."
    fames "唯一的不同，就是它身上散发着一股人类的味道。也许那七位会喜欢。"

# game/script.rpy:336
translate chino start_41b1ac09:

    # "también Fames te ha instruido que la comida deberá estar puesta en la mesa antes de que ellos lleguen."
    "Fames 也吩咐过你，食物必须在他们到来之前摆上餐桌。"

# game/script.rpy:337
translate chino start_a84b98b1:

    # "Ahora te encuentras sin supervisión."
    "此刻，没有人在监视你。"

# game/script.rpy:578
translate chino start_8ceee29f:

    # "Nulla se ve descolocado por tu elección. Pero rápidamente se dispone a contestar."
    "Nulla 似乎对你的选择有些措手不及。但他很快便准备作答。"

# game/script.rpy:706
translate chino respuesta6_14ae300d:

    # "La mirada de Nulla se vuelve vacía por un segundo para ser reemplazada rápidamente por unos ojos llenos de asombro."
    "Nulla 的目光有一瞬变得空洞，随即又被满含惊奇的双眼取代。"

# game/script.rpy:856
translate chino rutaunum_56f2707a:

    # "{sc=2}Bien, lo has hecho bien...{/sc}"
    "{sc=2}嗯，你做得很好……{/sc}"

# game/script.rpy:871
translate chino rutaunum_91cbe79f:

    # "En cuestión de segundos dejas de ver a Septem y a Nulla, quedándote solamente con Unum en la mesa."
    "短短几秒内，Septem 和 Nulla 便从你眼前消失，桌边只剩下你和 Unum。"

# game/script.rpy:974
translate chino rutaunum_15e4e08b:

    # "Hablas hasta por los codos sin darte cuenta, piensas que es como si estuvieras hablando con un amigo que comparte tus extraños gustos."
    "你不知不觉间滔滔不绝，觉得这就像是在跟一个与自己趣味相投的朋友聊天。"

# game/script.rpy:976
translate chino rutaunum_86472204:

    # "Llega un punto en que parloteas tanto, que piensas que se te va a enredar la lengua."
    "到了某个地步，你实在说得太起劲，简直以为自己的舌头都要打结了。"

# game/script.rpy:983
translate chino rutaunum_b756e6fa:

    # "Si es que ya no lo has hecho."
    "如果你还没打结的话。"

# game/script.rpy:1068
translate chino rutaunum_b391b3e7:

    # "Está tan inmaculado el lugar que no se ve real."
    "这个地方洁净得一尘不染，简直不像真的。"

# game/script.rpy:1149
translate chino rutaunum_c7359941:

    # unum "Aunque Septem también lo hace todo el tiempo. Las veces que he estado en su dominio, él se sienta en la mesa en las mañanas, tardes y noches a comer."
    unum "不过 Septem 也总是这样。我待在他那片领域的时候，他早、午、晚都要坐在餐桌前吃东西。"

# game/script.rpy:1151
translate chino rutaunum_74831caa:

    # unum "Nulla también lo hace a veces... tal vez esa sea la razón por la que son tan fuertes los dos..."
    unum "Nulla 有时也会这样……也许这就是他们俩都那么强的原因……"

# game/script.rpy:1202
translate chino rutaunum_e6dff3dd:

    # "Okay, crees saber a lo que se refiere. Claramente son panqueques por la descripción dada."
    "好吧，你觉得你知道他指的是什么。按那番描述，显然是松饼。"

# game/script.rpy:1228
translate chino rutaunum_3626f2e0:

    # unum "Es fascinante..."
    unum "真让人着迷……"

# game/script.rpy:1259
translate chino rutaunum_61b7d2a7:

    # "Le dices tantas cosas de manera errática que ni siquiera procesas que tipo de información o datos del cuerpo humano le estás soltando."
    "你语无伦次地跟他说了太多东西，自己都没意识到扔给了他多少关于人体的信息和数据。"

# game/script.rpy:1269
translate chino rutaunum_71534866:

    # "Te preparas mentalmente para que te arranque la extremidad con sus propios dientes.."
    "你在脑海中做好了准备——他会亲自用牙齿撕下你的肢体……"

# game/script.rpy:1289
translate chino rutaunum_cde5e9c0:

    # "No tiene que decirlo explícitamente para saber que se refiere a que no te ha podido comer allá en el hotel. Y supones que tampoco pudo comer el remplazo que Madre les dio a los demás, seguramente por quedarse aquí contigo."
    "他不必明说，你也知道他的意思是：在那边的酒店里，他没法吃掉你。你也猜想，他也没能吃掉母亲分给其他人的替代品，大概是因为他留在这里陪你。"

# game/script.rpy:1308
translate chino rutaunum_ab48979e:

    # "Aunque te gustaría saber cual es tu verdadero propósito aquí."
    "尽管你很想知道，你在这里真正的目的究竟是什么。"

# game/script.rpy:1315
translate chino rutaunum_c1e4a1b5:

    # "En ese caso... realmente prefieres que te mate de una buena vez. Después de todo, puedes volver a intentar sobrevivir con Septem... {glitch=20.0}{color=ffffff}{b}o Nulla{/glitch}"
    "那样的话……你倒宁愿他干脆一了百了地杀了你。毕竟你还可以再试着和 Septem…… {glitch=20.0}{color=ffffff}{b}或者 Nulla{/glitch} 一起求生。"

# game/script.rpy:1365
translate chino rutaunum_bf6f87cf:

    # "Y lo encuentras sentado en la orilla de la cama. Mirándote con los ojos bien abiertos."
    "你发现他坐在床沿，睁着一双圆圆的眼睛盯着你。"

# game/script.rpy:1486
translate chino rutaunum_0e736271:

    # "...Probablemente Unum no esté pensando en lo que tu estabas pensando, después de todo, Unum no es humano..."
    "……Unum 大概并没有像你所想的那样想，毕竟，Unum 并不是人类……"

# game/script.rpy:1546
translate chino rutaunum_9f031e45:

    # "{sc=4}{b}Dentro de ti hay veneno que se está esparciendo de a poco.{b}{/sc}"
    "{sc=4}{b}你体内有某种毒，正一点一点地蔓延开来。{b}{/sc}"

# game/script.rpy:1553
translate chino rutaunum_96714744:

    # "Despiertas repentinamente, sintiendo una gota de sudor frío recorriendo tu cuello."
    "你猛地惊醒，感觉到一滴冷汗正顺着脖颈滑落。"

# game/script.rpy:1555
translate chino rutaunum_384981a8:

    # "Y lo primero que te encuentras es a Unum mirándote de cerca, casi que inspeccionándote."
    "而你首先看到的，是凑得很近的 Unum 正盯着你，几乎像在检查你。"

# game/script.rpy:1571
translate chino rutaunum_46c95e4f:

    # "Pero lo único que sale de tu boca son pétalos color rojo, mezlados con sangre."
    "可从你嘴里涌出的，只有红色的花瓣，混杂着鲜血。"

# game/script.rpy:1638
translate chino rutaunum_3f2aeed3:

    # "Abres los ojos y lo primero que ves es a una entidad desconocida, la cual te tiene con una mano agarrando de los hombros, mientras que con la otra mano toca cuidadosamente tu estómago."
    "你睁开双眼，首先看到的是一个陌生存在：它一只手按着你的肩膀，另一只手正小心翼翼地触碰你的腹部。"

# game/script.rpy:1641
translate chino rutaunum_cb395708:

    # "Tu estómago se revuelve nuevamente cuando la mano de la entidad aprieta con suavidad una zona en específico."
    "当那只手轻轻按住某个特定部位时，你的胃又一阵翻搅。"

# game/script.rpy:1709
translate chino menuexplorar1_nulla_0ad50b2c:

    # "Nulla aparece detrás tuyo, lo que provoca que te tome desprevenido y pegues un salto."
    "Nulla 出现在你身后，把你吓了个措手不及，惊得跳了起来。"

# game/script.rpy:1757
translate chino menuexplorar1_nulla_45e395ae:

    # "No pasan más de 5 segundos cuando sientes tus pies tocar nuevamente el suelo. Y mientras el vacío se disipa puedes apreciar como de apoco se van construyendo estruccturas y paisajes a tu alrededor."
    "不过五秒，你便感觉到双脚重新触地。随着虚空散去，你能看见周围的建筑与风景正一点点成形。"

# game/script.rpy:1804
translate chino menuexplorar1_nulla_c978a422:

    # nulla "Absolutamente nada, no habría consecuencias reales ni pérdida real."
    nulla "完全没有。不会有任何真正的后果，也不会有任何真正的损失。"

# game/script.rpy:1821
translate chino menuexplorar1_nulla_8d40d5e6:

    # nulla "Solo esas malditas opciones de diálogo."
    nulla "只有那些该死的对话选项。"

# game/script.rpy:1842
translate chino menuexplorar1_nulla_f0a5fdb9:

    # "Cuando ya estás por caer en una especie de hipnosis, sientes como Nulla coloca su mano sobre la tuya para llamar tu atención."
    "就在你快要陷入某种催眠状态时，你感觉到 Nulla 把手覆在你的手上，引起你的注意。"

# game/script.rpy:1843
translate chino menuexplorar1_nulla_3494a918:

    # "La aprieta con suma delicadeza antes de abre la boca."
    "他极轻柔地握了握，然后张开了嘴。"

# game/script.rpy:1886
translate chino menuexplorar1_nulla_09578e5d:

    # "Simplemente quieres mirar el lugar... conocer bien el lugar en donde te encuentras."
    "你只是想要环顾四周……好好弄清楚自己此刻身在何处。"

# game/script.rpy:1949
translate chino menuexplorar2_nulla_9580903f:

    # nulla "Pero es imposible también."
    nulla "但这同样不可能。"

# game/script.rpy:1956
translate chino menuexplorar2_nulla_286370bb:

    # "Nulla se tira a la cama, boca arriba mientras ambas manos atrapan parte de las sábanas para mantenerlas en un agarre permanente."
    "Nulla 仰面摔躺在床上，双手死死抓住床单，仿佛要把它们攥紧不放。"

# game/script.rpy:1963
translate chino menuexplorar2_nulla_2f7691a5:

    # nulla "Pero también quiero dejar en ridículo al creador."
    nulla "但我也想让造物主颜面扫地。"

# game/script.rpy:1964
translate chino menuexplorar2_nulla_edd7eafb:

    # nulla "Utilizar a mi favor su regreso para destruirlo todo."
    nulla "借他归来的时机为我所用，把一切彻底摧毁。"

# game/script.rpy:1972
translate chino menuexplorar2_nulla_4ab62bf2:

    # "Comienzas a sospechar que mientras más dejar hablar a Nulla, más abres una ventana para que él tenga una catarsis."
    "你开始怀疑，越是让 Nulla 说下去，就越是在为他打开一扇宣泄的窗口。"

# game/script.rpy:2047
translate chino menuexplorar2_nulla_9e2a39c3:

    # nulla "Bueno--- Si no lo haces tú, tendré que recurrir a medidas más drásticas."
    nulla "好吧——如果你不肯做，那我只好采取更激烈的手段了。"

# game/script.rpy:2054
translate chino menuexplorar2_nulla_2c371b7b:

    # "Pasa un tiempo en donde recorres la casa para pasar el rato."
    "一段时间里，你在房子里四处闲逛打发时间。"

# game/script.rpy:2111
translate chino menuexplorar2_nulla_42886d19:

    # "Realmente sientes curiosidad por el estado del dominio de Nulla y estarías mintiendo si dijieras que no te gustaría caminar por el vacío que lo rodea."
    "你真的很好奇 Nulla 的领域如今是什么模样，如果你说不想在那片环绕着他的虚空中走一走，那一定是在撒谎。"

# game/script.rpy:2151
translate chino menupuertas2_951256a2:

    # ell "¿Tienes los documentos?"
    ell "文件在你手上吗？"

# game/script.rpy:2329
translate chino menupuertas_24988fcc:

    # ell "también estás siendo controlado por un ser superior..."
    ell "你也是被某种更高级的存在操控着……"

# game/script.rpy:2465
translate chino menuexplorar_62207c52:

    # "Vuelves a la cocina y revuelves todo el lugar en busca de algún cuchillo."
    "你回到厨房，翻遍了整个地方，寻找可以当刀用的东西。"

# game/script.rpy:2496
translate chino menunulla_loop1_cbb21a3f:

    # nulla "Por lo que la única manera de someterlo es pronunciando su nombre."
    nulla "所以，降服他的唯一办法，就是念出他的名字。"

# game/script.rpy:2505
translate chino menunulla_loop1_c64d79de:

    # nulla "Sí, después de todo, tú solo eres alguien que toma prestado un cuerpo."
    nulla "是啊，毕竟，你不过是一个借住在身体里的人。"

# game/script.rpy:2595
translate chino menupreguntas_2bc74461:

    # septem "después de todo Madre puede hacer otro recipiente"
    septem "毕竟，母亲还能再造一个容器。"

# game/script.rpy:2629
translate chino badend_cena_e6e12dab:

    # "Y lo único que puedes hacer es escuchar y respirar con dificultad."
    "而你能做的，只有听着，艰难地喘息。"

# game/script.rpy:2632
translate chino badend_cena_5474c6ce:

    # "Al terminar, lo único que sientes es como Nulla toca tu alma destrozada..."
    "结束时，你唯一感觉到的，是 Nulla 触碰着你支离破碎的灵魂……"

# game/script.rpy:2675
translate chino badendseptem1_0b1f17e3:

    # septem "{sc=2}La única regla aquí es respetar a tus rangos mayores.{/sc}"
    septem "{sc=2}这里唯一的规则，就是尊敬你的长辈。{/sc}"

# game/script.rpy:2726
translate chino badendseptem2_0b1f17e3:

    # septem "{sc=2}La única regla aquí es respetar a tus rangos mayores.{/sc}"
    septem "{sc=2}这里唯一的规则，就是尊敬你的长辈。{/sc}"

# game/script.rpy:2781
translate chino badend_septem3_13c35509:

    # septem "Después de todo, madre puede hacer otra marioneta."
    septem "毕竟，母亲还能再造一个傀儡。"

# game/script.rpy:2854
translate chino badend_septem6_6d2a5adf:

    # "después de un tiempo prudente, vuelves a tu objetivo: Escapar."
    "过了一段足够长的时间后，你重新回到了你的目标上：逃走。"

# game/script.rpy:2993
translate chino badendunum2_248a2aeb:

    # "Pero no puede ser tan fácil, seguro debe tener algún modo de detectar lo que estás haciendo..."
    "但事情不可能这么容易，他肯定有什么办法能察觉你在做什么……"

# game/script.rpy:3007
translate chino badendunum2_60adbddb:

    # "4 zancadas alcanzas a dar después de cruzar la puerta cuando caes sintiendo un dolor punzante debajo de tus rodillas."
    "你跨出门后又往前冲了四大步，接着便摔倒在地，双膝下方传来一阵尖锐的剧痛。"

# game/script.rpy:3026
translate chino badendunum3_6781792b:

    # "Lágrimas se acumulan en tus ojos por el pánico que se empieza a formar en tu cuerpo."
    "恐慌在你体内滋生，泪水涌上了你的眼眶。"

# game/script.rpy:3117
translate chino badendunum5_f792e45a:

    # "Aproximadamente alcanzas a dar 10 pasos después de cruzar la puerta cuando caes sintiendo un dolor punzante debajo de tus rodillas."
    "你跨出门后大约跑了十步，便摔倒在地，双膝下方传来一阵尖锐的剧痛。"

# game/script.rpy:3239
translate chino badend_rutanulla_f1a47234:

    # "Miras rápidamente arriba para ver de quien se trata."
    "你猛地抬头看去，想弄清是谁。"

translate chino strings:

    # game/script.rpy:1249
    old "Entrar en pánico y suplicar por tu vida"
    new "惊慌失措，乞求活命。"

    # game/script.rpy:2136
    old "Buscar a la marioneta de Septem."
    new "寻找 Septem 的傀儡。"

    # game/script.rpy:2540
    old "¿Cómo sabes del vínculo que tenemos {sc=3}yo{/sc} y [nombrejugador]?"
    new "你是怎么知道{sc=3}我{/sc}和[nombrejugador]之间的羁绊的？"

