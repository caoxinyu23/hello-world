# game/script.rpy:2521
translate chino menunulla_loop1_0f48a2ce:

    # nulla "créeme que es para mejor."
    nulla "相信我，这样更好。"

# TODO: Translation updated at 2025-02-27 00:00

# game/script.rpy:95
translate chino start_a8c0b9c1:

    # "... Nadie nace el día 7. El domingo, el domingo es un día sacro."
    "……没有人会出生在第 7 天。星期日，星期日是神圣之日。"

# game/script.rpy:106
translate chino start_1681a563:

    # "... algo que ya estás acostumbrado supongo."
    "……某种你大概已经习惯了的事吧。"

# game/script.rpy:2074
translate chino menuexplorar2_nulla_214f320c:

    # "{b} Las entidades de Duae son curiosas, todas se parecen, pero cada una tiene un propósito único e irremplazable... recuerdo como Duae se jactaba, en tiempos antiguos y más prósperos, de lo devotas y trabajadoras que eran sus estrellas {b}"
    "{b} Duae 的存在们很奇妙，她们彼此相似，却各有独一无二、不可替代的目的……我记得，在古老而更为繁荣的时代，Duae 总爱夸耀她的星辰们是何等虔诚、何等勤勉 {b}"

# game/script.rpy:2080
translate chino menuexplorar2_nulla_ca0604c5:

    # "{b}Espero que no me resientas por esta acción, pero si quiero borrar todo rastro del creador y tener un propósito que sea impuesto por mi conciencia... mío, y solo mío, tengo que hacer esto.{b}"
    "{b}希望你不要因此怨恨我，但若我想抹去造物主的一切痕迹，拥有一个由我良知——且只属于我一人——所赋予的目的，我就必须这么做。{b}"

# TODO: Translation updated at 2025-02-27 00:07

translate chino strings:

    # game/script.rpy:582
    old "Septem."
    new "Septem。"

