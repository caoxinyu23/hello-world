translate chino nogogogo_cb1b4694:

    # unum "Seas capaz o incapaz biologicamente de llevar a una cría en tu cuerpo, no quiero tomar el riesgo de perderte."
    unum "无论你生理上能不能在体内孕育幼体，我都不想冒失去你的风险。"

# game/script.rpy:3181
translate chino nogogogo_11b7c89c:

    # unum "Ni menos hacerte pasar por ese proceso."
    unum "更不会让你去经历那种过程。"

# game/script.rpy:3185
translate chino nogogogo_296bf63e:

    # unum "Sextam me lo ha explicado, y..."
    unum "Sextam 已经跟我解释过了，而且……"

# game/script.rpy:3186
translate chino nogogogo_b08527b5:

    # unum "Demora mucho..."
    unum "那要花很长时间……"

# game/script.rpy:3189
translate chino nogogogo_05a7797d:

    # unum "La cría será cultivada dentro de la nueva escencia que se formará."
    unum "幼体会在将要形成的新本质中被培育出来。"

# game/script.rpy:3190
translate chino nogogogo_410d2477:

    # unum "No afectará ni tu cuerpo ni el mío."
    unum "既不会影响你的身体，也不会影响我的。"

# game/script.rpy:3192
translate chino nogogogo_2fd60b8b:

    # "Luego de decir aquello Unum pregunta una vez más, y tú más tranquilo, aceptas nuevamente."
    "说完这些，Unum 又问了你一次，而你平静了些，再次答应了。"

# game/script.rpy:3193
translate chino nogogogo_d66ff265:

    # "Con la misma delicadeza, Unum coloca la mano que tiene su esencia en tu pecho y ejerce presión."
    "Unum 以同样的温柔，将那只盛着他本质的手按在你胸口，施加压力。"

# game/script.rpy:3194
translate chino nogogogo_0800ec04:

    # "El lugar donde te está presionando comienza a sentirse caliente, no al punto de quemar ni doler, pero caliente de todos modos."
    "他按压的地方开始发热，既没有到灼烧的程度，也没有痛感，但确实是热的。"

# game/script.rpy:3195
translate chino nogogogo_7b40e4e0:

    # "Hasta que algo dentro de ti se abre, permitiendo a Unum atravesar tu pecho."
    "直到你体内某个东西敞开，让 Unum 穿过你的胸膛。"

# game/script.rpy:3196
translate chino nogogogo_baf324ce:

    # nj "Uhg..."
    nj "呃……"

# game/script.rpy:3197
