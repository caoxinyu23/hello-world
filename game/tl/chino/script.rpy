# game/script.rpy:3161
translate chino badend_rutanulla_a24f74d3:

    # "Y eso es lo último que tus ojos ven antes de que te rompan en pecho"
    "而在那个女人撕碎你胸膛之前，这就是你双眼所见的最后景象。"

# game/script.rpy:3163
